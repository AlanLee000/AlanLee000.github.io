\\text{-}top\\text{-}cluster\\text{-}point} \\vdash\n\\mathrm{ZfcTopClusterPoint}_S(x,A,X,\\tau)\\leftrightarrow\n\\left(\n\\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land\nA\\subseteq X\\land x\\in X\\land\n\\forall U\\in\\tau\\;\n\\bigl(x\\in U\\to A\\cap(U\\setminus\\{x\\})\\neq\\varnothing\\bigr)\n\\right)","display":true}],"bytes":935,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3515","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-zfc-top-cluster-point.md|58-df-zfc-top-cluster-point]]（batch02）"}],"outgoing":["74086485fba8d86f"]}