athrm{FiniteVectorSumValue}_{58}\\subseteq V^6","display":false},{"tex":"\\mathrm{BochnerIntegral}_S\\subseteq V^{11}","display":false},{"tex":"\\mathrm{Finite}","display":false},{"tex":"\\mathrm{Banach}","display":false},{"tex":"\\mathrm{Measurable}","display":false},{"tex":"\\mathrm{MeasureSpace}","display":false},{"tex":"\\mathrm{Bijective}","display":false},{"tex":"\\begin{aligned}\n\\mathrm{FiniteVectorSumValue}_{58}(J,B,w,E,+,0_E)\\leftrightarrow{}&\n0_E\\in E\\land\\mathrm{Function}(+,E\\times E,E)\\land\\mathrm{Function}(w,B,E)\\\\\n&\\land\\exists m\\in\\omega\\;\\exists b,u\\;\\Bigl(\n\\mathrm{Bijective}(b,m,B)\\land u\\in E^{m+1}\\land u(0)=0_E\\\\\n&\\hspace{22mm}\\land\\forall i\\in m\\;u(i+1)=+(u(i),w(b(i)))\\land J=u(m)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}bochner\\text{-}integral}\\vdash{}&\n\\mathrm{BochnerIntegral}_S(L,f,X,\\mathcal F,\\mu,E,\\mathcal E,K,+,\\cdot,\\|\\cdot\\|)\\\\\n\\leftrightarrow{}&\\mathrm{MeasureSpace}_S(X,\\mathcal F,\\mu)\n\\land\\mathrm{Banach}_S(E,K,+,\\cdot,\\|\\cdot\\|)\n\\land\\mathrm{Measurable}_S(f;(X,\\mathcal F),(E,\\mathcal E))\\land L\\in E\\\\\n&\\land\\exists0_E\\in E\\;\\exists s_\\bullet\\in(E^X)^\\omega\\;\n\\exists d_\\bullet\\in(\\mathbb R_{\\geq0}^X)^\\omega\\;\n\\exists r_\\bullet\\in[0,\\infty]^\\omega\\;\\exists J_\\bullet\\in E^\\omega\\;\\Bigl[\\\\\n&\\quad\\forall a\\in E\\;(+(0_E,a)=a\\land+(a,0_E)=a)\\\\\n&\\quad\\land\\forall n\\in\\omega\\;\\Bigl(\n\\mathrm{Measurable}_S(s_n;(X,\\mathcal F),(E,\\mathcal E))\n\\land\\mathrm{Finite}(\\operatorname{ran}(s_n))\\\\\n&\\qquad\\land\\forall a\\in\\operatorname{ran}(s_n)\\;\n\\bigl(s_n^{-1}[\\{a\\}]\\in\\mathcal F\\land(a\\neq0_E\\to\\mu(s_n^{-1}[\\{a\\}])<\\infty)\\bigr)\\\\\n&\\qquad\\land\\forall x\\in X\\;d_n(x)=\\|f(x)-s_n(x)\\|\n\\land\\mathrm{Measurable}_S(d_n;(X,\\mathcal F),([0,\\infty],\\mathcal B_+))\n\\land r_n=\\int_Xd_n\\,d\\mu\\\\\n&\\qquad\\land\\mathrm{FiniteVectorSumValue}_{58}\\Bigl(\nJ_n,\\operatorname{ran}(s_n)\\setminus\\{0_E\\},\\\\\n&\\hspace{35mm}\\{\\langle a,\\cdot(\\mu(s_n^{-1}[\\{a\\}]),a)\\rangle:\na\\in\\operatorname{ran}(s_n)\\setminus\\{0_E\\}\\},E,+,0_E\\Bigr)\\Bigr)\\\\\n&\\quad\\land\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;\n\\bigl(n\\geq N\\to r_n<\\varepsilon\\land\\|J_n-L\\|<\\varepsilon\\bigr)\\Bigr].\n\\end{aligned}","display":true},{"tex":"|f_n| \\leq g","display":false},{"tex":"f_n \\to f","display":false},{"tex":"\\int f_n \\to \\int f","display":false}],"bytes":4122,"backlinks":[{"id":"03ca577eb4c1b05e","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{BochnerIntegral}_S\\subseteq V^{11}$ (signed scalar integral predicate, see [[../batch05/58-df-bochner-integral.md]])"},{"id":"a1f6d4733dbaf832","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"c24c7e81186cbc4b","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{BochnerIntegral}_S$ (complex-valued integral predicate, see [[58-df-bochner-integral]])"},{"id":"084076b1e347ab30","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{BochnerIntegral}_S(L,f,X,\\mathcal F,\\mu,E,\\mathcal E,K,+,\\cdot,\\|\\cdot\\|)$ (exact complex-valued integral signature, see [[58-df-bochner-integral]])"},{"id":"84daad544872cc71","anchor":"ref-189","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-bochner-integral.md|58-df-bochner-integral]]（batch05）"}],"outgoing":["3b5b3d48ff1ff369","d583890235faf0d5","36d7463d215be751","bbbec05fde1d3b01","ef59807ad934771f","83a15c7e9b3817dc","d9a25b0ac94a3598","4884f45058a56aac"]}