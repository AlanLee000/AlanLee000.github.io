b3fbc9\" href=\"?note=835b897a70b3fbc9\" title=\"58-df-zfc-measure2-measurable-partition\">58-df-zfc-measure2-measurable-partition</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"h,T,X,\\Sigma,\\mu,\\Pi,\\Lambda,n,u,r,q,\\vec T\\in V\">\\(h,T,X,\\Sigma,\\mu,\\Pi,\\Lambda,n,u,r,q,\\vec T\\in V\\)</span> (entropy, system, partitions, finite iterates, and rate data)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure9KolmogorovSinaiEntropy}_S\">\\(\\mathrm{ZfcMeasure9KolmogorovSinaiEntropy}_S\\)</span> (operator defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{FinitePartitionJoin}_S,\\mathrm{PartitionEntropy}_S,\\mathrm{EntropyRate}_S\">\\(\\mathrm{FinitePartitionJoin}_S,\\mathrm{PartitionEntropy}_S,\\mathrm{EntropyRate}_S\\)</span> (predicates defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{ProbabilityMeasure}\">\\(\\operatorname{ProbabilityMeasure}\\)</span> (probability-measure predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"5e0db065132180df\" href=\"?note=5e0db065132180df\" title=\"../batch08/58-df-probability.md\">../batch08/58-df-probability.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Finite}\">\\(\\mathrm{Finite}\\)</span> (finite-set predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"d9a25b0ac94a3598\" href=\"?note=d9a25b0ac94a3598\" title=\"../batch04/58-df-finite.md\">../batch04/58-df-finite.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure2MeasurablePartition}_S\">\\(\\mathrm{ZfcMeasure2MeasurablePartition}_S\\)</span> (measurable-partition predicate, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"835b897a70b3fbc9\" href=\"?note=835b897a70b3fbc9\" title=\"58-df-zfc-measure2-measurable-partition\">58-df-zfc-measure2-measurable-partition</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (set-function predicate, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}finite\\text{-}partition\\text{-}join}\\vdash\n\\mathrm{FinitePartitionJoin}_S(\\Lambda,n,\\Pi,T,X,\\Sigma)\\\\\n&amp;\\quad\\leftrightarrow\n\\Bigl(\nn\\in\\omega\\setminus\\{0\\}\n\\land\\mathrm{Function}(T,X,X)\n\\land\\mathrm{ZfcMeasure2MeasurablePartition}_S(\\Pi,X,\\Sigma)\\\\\n&amp;\\qquad\\land\\exists\\vec T\\in V\\;\\Bigl[\n\\mathrm{Function}(\\vec T,n,\\mathcal P(X\\times X))\\land\n\\vec T(0)=\\operatorname{id}_X\\land\n\\forall i\\in n\\;\\mathrm{Function}(\\vec T(i),X,X)\\land\n\\forall i\\in n\\;\\bigl(i+1\\in n\\to\\vec T(i+1)=T\\circ\\vec T(i)\\bigr)\\\\\n&amp;\\hspace{28mm}\\land\\Lambda=\\Bigl\\{B\\subseteq X\\Bigm|\nB\\neq\\varnothing\\land\n\\exists a\\in V\\;\\bigl(\\mathrm{Function}(a,n,\\Pi)\\land\nB=\\bigcap_{i\\in n}\\{x\\in X:\\vec T(i)(x)\\in a(i)\\}\\bigr)\n\\Bigr\\}\\Bigr]\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}finite\\text{-}partition\\text{-}join}\\vdash\n\\mathrm{FinitePartitionJoin}_S(\\Lambda,n,\\Pi,T,X,\\Sigma)\\\\\n&amp;\\quad\\leftrightarrow\n\\Bigl(\nn\\in\\omega\\setminus\\{0\\}\n\\land\\mathrm{Function}(T,X,X)\n\\land\\mathrm{ZfcMeasure2MeasurablePartition}_S(\\Pi,X,\\Sigma)\\\\\n&amp;\\qquad\\land\\exists\\vec T\\in V\\;\\Bigl[\n\\mathrm{Function}(\\vec T,n,\\mathcal P(X\\times X))\\land\n\\vec T(0)=\\operatorname{id}_X\\land\n\\forall i\\in n\\;\\mathrm{Function}(\\vec T(i),X,X)\\land\n\\forall i\\in n\\;\\bigl(i+1\\in n\\to\\vec T(i+1)=T\\circ\\vec T(i)\\bigr)\\\\\n&amp;\\hspace{28mm}\\land\\Lambda=\\Bigl\\{B\\subseteq X\\Bigm|\nB\\neq\\varnothing\\land\n\\exists a\\in V\\;\\bigl(\\mathrm{Function}(a,n,\\Pi)\\land\nB=\\bigcap_{i\\in n}\\{x\\in X:\\vec T(i)(x)\\in a(i)\\}\\bigr)\n\\Bigr\\}\\Bigr]\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}partition\\text{-}entropy}\\vdash\n\\mathrm{PartitionEntropy}_S(u,\\Lambda,\\mu)\n\\leftrightarrow\n\\Bigl(\n\\mathrm{Finite}(\\Lambda)\\land\\mathrm{Function}(\\mu,\\operatorname{dom}(\\mu),\\operatorname{ran}(\\mu))\\land\\Lambda\\subseteq\\operatorname{dom}(\\mu)\\land\\forall A\\in\\Lambda\\;\\mu(A)\\in\\mathbb R_{\\geq0}\\land u\\in\\mathbb R\\land\nu=-\\sum_{A\\in\\Lambda}\\mu(A)\\log\\mu(A)\n\\Bigr),\n\\qquad 0\\log0:=0.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}partition\\text{-}entropy}\\vdash\n\\mathrm{PartitionEntropy}_S(u,\\Lambda,\\mu)\n\\leftrightarrow\n\\Bigl(\n\\mathrm{Finite}(\\Lambda)\\land\\mathrm{Function}(\\mu,\\operatorname{dom}(\\mu),\\operatorname{ran}(\\mu))\\land\\Lambda\\subseteq\\operatorname{dom}(\\mu)\\land\\forall A\\in\\Lambda\\;\\mu(A)\\in\\mathbb R_{\\geq0}\\land u\\in\\mathbb R\\land\nu=-\\sum_{A\\in\\Lambda}\\mu(A)\\log\\mu(A)\n\\Bigr),\n\\qquad 0\\log0:=0.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}entropy\\text{-}rate}\\vdash\n\\mathrm{EntropyRate}_S(r,\\Pi,T,X,\\Sigma,\\mu)\\\\\n&amp;\\quad\\leftrightarrow\n\\Bigl(\n\\mathrm{Finite}(\\Pi)\n\\land\\mathrm{ZfcMeasure2MeasurablePartition}_S(\\Pi,X,\\Sigma)\n\\land r\\in\\mathbb R_{\\geq0}\\\\\n&amp;\\qquad\\land\\exists q\\in V\\;\\Bigl(\n\\mathrm{Function}(q,\\omega\\setminus\\{0\\},\\mathbb R_{\\geq0})\n\\land\\forall n\\in\\omega\\setminus\\{0\\}\\;\\exists\\Lambda,u\\;\\bigl(\n\\mathrm{FinitePartitionJoin}_S(\\Lambda,n,\\Pi,T,X,\\Sigma)\\\\\n&amp;\\hspace{52mm}\\land\\mathrm{PartitionEntropy}_S(u,\\Lambda,\\mu)\n\\land q(n)=u/n\n\\bigr)\\\\\n&amp;\\hspace{25mm}\\land\\forall\\varepsilon\\in\\mathbb R_{&gt;0}\\;\\exists N\\in\\omega\\;\\forall n\\in\\omega\\setminus\\{0\\}\\;\n\\bigl(N\\leq n\\to|q(n)-r|&lt;\\varepsilon\\bigr)\n\\Bigr)\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}entropy\\text{-}rate}\\vdash\n\\mathrm{EntropyRate}_S(r,\\Pi,T,X,\\Sigma,\\mu)\\\\\n&amp;\\quad\\leftrightarrow\n\\Bigl(\n\\mathrm{Finite}(\\Pi)\n\\land\\mathrm{ZfcMeasure2MeasurablePartition}_S(\\Pi,X,\\Sigma)\n\\land r\\in\\mathbb R_{\\geq0}\\\\\n&amp;\\qquad\\land\\exists q\\in V\\;\\Bigl(\n\\mathrm{Function}(q,\\omega\\setminus\\{0\\},\\mathbb R_{\\geq0})\n\\land\\forall n\\in\\omega\\setminus\\{0\\}\\;\\exists\\Lambda,u\\;\\bigl(\n\\mathrm{FinitePartitionJoin}_S(\\Lambda,n,\\Pi,T,X,\\Sigma)\\\\\n&amp;\\hspace{52mm}\\land\\mathrm{PartitionEntropy}_S(u,\\Lambda,\\mu)\n\\land q(n)=u/n\n\\bigr)\\\\\n&amp;\\hspace{25mm}\\land\\forall\\varepsilon\\in\\mathbb R_{&gt;0}\\;\\exists N\\in\\omega\\;\\forall n\\in\\omega\\setminus\\{0\\}\\;\n\\bigl(N\\leq n\\to|q(n)-r|&lt;\\varepsilon\\bigr)\n\\Bigr)\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}kolmogorov\\text{-}sinai\\text{-}entropy} \\vdash\n\\mathrm{ZfcMeasure9KolmogorovSinaiEntropy}_S(h,T,X,\\Sigma,\\mu)\\leftrightarrow\n\\Bigl(\n\\operatorname{ProbabilityMeasure}(\\mu,X,\\Sigma)\\land\\mathrm{Function}(T,X,X)\\land\n\\forall A\\in\\Sigma\\;\\bigl(T^{-1}[A]\\in\\Sigma\\land\\mu(T^{-1}[A])=\\mu(A)\\bigr)\\land\nh\\in[0,\\infty]\\land\n\\forall\\Pi\\;\\forall r\\in\\mathbb R_{\\geq0}\\;\\bigl(\n\\mathrm{EntropyRate}_S(r,\\Pi,T,X,\\Sigma,\\mu)\\to r\\leq h\n\\bigr)\\land\n\\forall b\\in\\mathbb R_{\\geq0}\\;\\Bigl(\nb&lt;h\\to\\exists\\Pi\\;\\exists r\\in\\mathbb R_{\\geq0}\\;\\bigl(\n\\mathrm{EntropyRate}_S(r,\\Pi,T,X,\\Sigma,\\mu)\\land b&lt;r\n\\bigr)\n\\Bigr)\n\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure9\\text{-}kolmogorov\\text{-}sinai\\text{-}entropy} \\vdash\n\\mathrm{ZfcMeasure9KolmogorovSinaiEntropy}_S(h,T,X,\\Sigma,\\mu)\\leftrightarrow\n\\Bigl(\n\\operatorname{ProbabilityMeasure}(\\mu,X,\\Sigma)\\land\\mathrm{Function}(T,X,X)\\land\n\\forall A\\in\\Sigma\\;\\bigl(T^{-1}[A]\\in\\Sigma\\land\\mu(T^{-1}[A])=\\mu(A)\\bigr)\\land\nh\\in[0,\\infty]\\land\n\\forall\\Pi\\;\\forall r\\in\\mathbb R_{\\geq0}\\;\\bigl(\n\\mathrm{EntropyRate}_S(r,\\Pi,T,X,\\Sigma,\\mu)\\to r\\leq h\n\\bigr)\\land\n\\forall b\\in\\mathbb R_{\\geq0}\\;\\Bigl(\nb&lt;h\\to\\exists\\Pi\\;\\exists r\\in\\mathbb R_{\\geq0}\\;\\bigl(\n\\mathrm{EntropyRate}_S(r,\\Pi,T,X,\\Sigma,\\mu)\\land b&lt;r\n\\bigr)\n\\Bigr)\n\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The join partition, each finite-partition entropy, and the limiting entropy rate are explicit predicates. Finite iterates of <span class=\"math-inline\" data-tex=\"T\">\\(T\\)</span> are witnessed by a function sequence beginning at the identity and closed under composition, rather than by an undeclared exponent <span class=\"math-inline\" data-tex=\"T^{-i}\">\\(T^{-i}\\)</span>. The final two clauses characterize their supremum in <span class=\"math-inline\" data-tex=\"[0,\\infty]\">\\([0,\\infty]\\)</span> without an untyped <span class=\"math-inline\" data-tex=\"\\sup\">\\(\\sup\\)</span> operator.</li>\n<li>The entropy summand uses the convention <span class=\"math-inline\" data-tex=\"0\\log0=0\">\\(0\\log0=0\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch08/58-df-probability.md","status":"resolved","id":"5e0db065132180df","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-probability.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch04/58-df-finite.md","status":"resolved","id":"d9a25b0ac94a3598","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-finite.md]]","embed":false},{"target":"58-df-zfc-measure2-measurable-partition","status":"resolved","id":"835b897a70b3fbc9","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-measure2-measurable-partition]]","embed":false},{"target":"../batch08/58-df-probability.md","status":"resolved","id":"5e0db065132180df","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{ProbabilityMeasure}$ (probability-measure predicate, see [[../batch08/58-df-probability.md]])","embed":false},{"target":"../batch04/58-df-finite.md","status":"resolved","id":"d9a25b0ac94a3598","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Finite}$ (finite-set predicate, see [[../batch04/58-df-finite.md]])","embed":false},{"target":"58-df-zfc-measure2-measurable-partition","status":"resolved","id":"835b897a70b3fbc9","anchor":"ref-8","targetAnchor":"",