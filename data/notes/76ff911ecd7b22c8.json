athcal{S}'","display":false},{"tex":"L^p","display":false},{"tex":"\\mathcal{F}: \\mathcal{S}' \\to \\mathcal{S}'","display":false},{"tex":"H^s","display":false},{"tex":"\\mathcal{S}'","display":false}],"bytes":1930,"backlinks":[{"id":"d47484adcb88c697","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{ZfcAnaTemperedDistribution}$ 取 [[../batch02/58-df-tempered-distribution.md]] 的同名定义与参数次序。"},{"id":"a11585cba9c21cfd","anchor":"ref-344","locations":["正文"],"count":1,"excerpt":"[[58-df-tempered-distribution]]"},{"id":"84daad544872cc71","anchor":"ref-1286","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-tempered-distribution.md|58-df-tempered-distribution]]（batch02）"}],"outgoing":["fbec6c5b7a044255","a6c5654857edae16"]}