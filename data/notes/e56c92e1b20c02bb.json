df-limit-ordinal.md\">../batch18/58-df-limit-ordinal.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span> (infinite cardinal)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Cardinal}_S\">\\(\\mathrm{Cardinal}_S\\)</span> (cardinal predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"5fb1c2241d1943d1\" href=\"?note=5fb1c2241d1943d1\" title=\"58-df-cardinal\">58-df-cardinal</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Limit}\">\\(\\mathrm{Limit}\\)</span> (limit-ordinal predicate, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"81cabbac7fa4d75d\" href=\"?note=81cabbac7fa4d75d\" title=\"58-df-limitordinal\">58-df-limitordinal</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Club}\">\\(\\mathrm{Club}\\)</span> (club-subset predicate, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"04670bdc8b64b8dd\" href=\"?note=04670bdc8b64b8dd\" title=\"58-df-club\">58-df-club</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{otp}\">\\(\\operatorname{otp}\\)</span> (order type)</li>\n<li><span class=\"math-inline\" data-tex=\"\\vec C\">\\(\\vec C\\)</span> (square sequence, with <span class=\"math-inline\" data-tex=\"C_\\alpha=\\vec C(\\alpha)\">\\(C_\\alpha=\\vec C(\\alpha)\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\square_\\kappa\">\\(\\square_\\kappa\\)</span> (square principle predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}square\\text{-}principle} \\vdash \\square_\\kappa\\leftrightarrow \\mathrm{Cardinal}_S(\\kappa)\\land\\omega\\leq\\kappa\\land\\exists\\vec C\\;\\Bigl(\\operatorname{dom}(\\vec C)=\\{\\alpha&lt;\\kappa^+:\\mathrm{Limit}(\\alpha)\\}\\land\\forall\\alpha\\in\\operatorname{dom}(\\vec C)\\;(\\mathrm{Club}(C_\\alpha,\\alpha)\\land\\operatorname{otp}(C_\\alpha)\\leq\\kappa\\land\\forall\\beta\\in\\operatorname{dom}(\\vec C)\\cap\\alpha\\;(\\beta=\\sup(C_\\alpha\\cap\\beta)\\to C_\\beta=C_\\alpha\\cap\\beta))\\land\\neg\\exists D\\subseteq\\kappa^+\\;(\\mathrm{Club}(D,\\kappa^+)\\land\\forall\\alpha\\in\\operatorname{dom}(\\vec C)\\;(\\alpha=\\sup(D\\cap\\alpha)\\to D\\cap\\alpha=C_\\alpha))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}square\\text{-}principle} \\vdash \\square_\\kappa\\leftrightarrow \\mathrm{Cardinal}_S(\\kappa)\\land\\omega\\leq\\kappa\\land\\exists\\vec C\\;\\Bigl(\\operatorname{dom}(\\vec C)=\\{\\alpha&lt;\\kappa^+:\\mathrm{Limit}(\\alpha)\\}\\land\\forall\\alpha\\in\\operatorname{dom}(\\vec C)\\;(\\mathrm{Club}(C_\\alpha,\\alpha)\\land\\operatorname{otp}(C_\\alpha)\\leq\\kappa\\land\\forall\\beta\\in\\operatorname{dom}(\\vec C)\\cap\\alpha\\;(\\beta=\\sup(C_\\alpha\\cap\\beta)\\to C_\\beta=C_\\alpha\\cap\\beta))\\land\\neg\\exists D\\subseteq\\kappa^+\\;(\\mathrm{Club}(D,\\kappa^+)\\land\\forall\\alpha\\in\\operatorname{dom}(\\vec C)\\;(\\alpha=\\sup(D\\cap\\alpha)\\to D\\cap\\alpha=C_\\alpha))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\square_\\kappa\">\\(\\square_\\kappa\\)</span> holds in <span class=\"math-inline\" data-tex=\"L\">\\(L\\)</span> (Gödel's constructible universe).</li>\n<li><span class=\"math-inline\" data-tex=\"\\square_\\kappa\">\\(\\square_\\kappa\\)</span> implies failures of certain reflection principles.</li>\n<li><span class=\"math-inline\" data-tex=\"\\diamondsuit_\\kappa\">\\(\\diamondsuit_\\kappa\\)</span> implies <span class=\"math-inline\" data-tex=\"\\square_\\kappa\">\\(\\square_\\kappa\\)</span> for many <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span>.</li>\n<li>Used in constructing inconsistent combinatorial principles at singular cardinals.</li>\n<li><c