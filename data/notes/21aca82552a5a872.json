nd\\forall A\\subseteq\\mathrm{Univ}(\\mathfrak M)\\;\\forall f\\;\n\\left( |A|<\\kappa\\land\\mathrm{PartialElementary}_{\\mathcal L}(f,A,\\mathfrak M,\\mathfrak M)\n\\to\\exists g\\;\\bigl(\\mathrm{Aut}_S(g,\\mathfrak M,\\mathcal L)\n\\land g\\mathbin{\\upharpoonright}A=f\\bigr)\\right)\\right)","display":true},{"tex":"\\mathrm{df\\text{-}homogeneous\\text{-}model\\text{-}compatible}\\vdash\n\\mathrm{Homo}_\\kappa(\\mathfrak M)\\leftrightarrow\n\\exists\\mathcal L\\;\\mathrm{HomogeneousModel}_S(\\mathfrak M,\\mathcal L,\\kappa)","display":true},{"tex":"\\kappa","display":false},{"tex":"\\operatorname{tp}^{\\mathfrak M}","display":false},{"tex":"\\mathrm{Aut}(\\mathfrak M)","display":false}],"bytes":2102,"backlinks":[{"id":"b8a222a3f137d166","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{HomogeneousModel}_S$ (strong homogeneity predicate, see [[../batch06/58-df-homogeneous-model]])"},{"id":"84daad544872cc71","anchor":"ref-637","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-homogeneous-model.md|58-df-homogeneous-model]]（batch06）"}],"outgoing":["5fb1c2241d1943d1","2be08d4ee8aa1590","d9b8711cda3f31ca","66452054e74f936a","1eb2bd3bd0214732"]}