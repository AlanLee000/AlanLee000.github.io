}},\\mathsf{Thm}_{\\mathsf{CCG}},\\mathsf{Sent}_{\\mathsf{CCG}},\\mathsf{Delta}_{\\mathsf{CCG}}).","display":true}],"bytes":7335,"backlinks":[],"outgoing":[]}