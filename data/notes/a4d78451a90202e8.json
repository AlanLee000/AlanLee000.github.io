{"id":"a4d78451a90202e8","group":"58","path":"58/batch11/58-df-zfc-measure9-absolutely-continuous-measure.md","title":"ZFC Measure9 Absolutely Continuous Measure","display":"df-zfc-measure9-absolutely-continuous-measure — ZFC Measure9 Absolutely Continuous Measure","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-measure9-absolutely-continuous-measure","aliases":["58-df-zfc-measure9-absolutely-continuous-measure"],"display":"df-zfc-measure9-absolutely-continuous-measure — ZFC Measure9 Absolutely Continuous Measure","depends_on":["[[../batch13/58-df-measure]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-measure9-absolutely-continuous-measure"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-measure9-absolutely-continuous-measure</span></div>"},{"key":"display","html":"df-zfc-measure9-absolutely-continuous-measure — ZFC Measure9 Absolutely Continuous Measure"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"../batch13/58-df-measure\">../batch13/58-df-measure</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mu,\\nu,\\Sigma,X\\in V\">\\(\\mu,\\nu,\\Sigma,X\\in V\\)</span> (two measures on one measurable space)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Measure}_S\">\\(\\mathrm{Measure}_S\\)</span> (measure predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure9AbsolutelyContinuousMeasure}_S\">\\(\\mathrm{ZfcMeasure9AbsolutelyContinuousMeasure}_S\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure9\