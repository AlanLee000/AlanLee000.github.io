pha(n)\\land B_\\beta(n)<B_\\alpha(n)\\right).","display":true},{"tex":"n>0\\ \\longrightarrow\\ \\forall\\beta\\in\\alpha[n]\\ F_\\beta(n)<F_\\alpha(n).","display":true},{"tex":"F_\\alpha(0)=1.","display":true},{"tex":"F","display":false},{"tex":"n>0","display":false},{"tex":"F_\\alpha(0)","display":false},{"tex":"B,F","display":false},{"tex":"\\beta\\in\\alpha[n]","display":false},{"tex":"\\beta[n]\\subsetneq\\alpha[n]","display":false},{"tex":"G","display":false},{"tex":"G","display":false},{"tex":"\\alpha=\\mathsf L((\\alpha_i)_i)","display":false},{"tex":"\\alpha_n\\in\\alpha_{n+1}[n+1]","display":false},{"tex":"G_{\\alpha_n}(n)\\le G_{\\alpha_n}(n+1)<G_{\\alpha_{n+1}}(n+1)","display":false},{"tex":"G","display":false},{"tex":"H_\\gamma(x)\\ge x","display":false},{"tex":"B_\\gamma(x)>x","display":false},{"tex":"F_\\gamma(x)>x","display":false},{"tex":"F_\\gamma(0)=1","display":false},{"tex":"H","display":false},{"tex":"H_\\gamma(n+1)<H_\\gamma(n+2)","display":false},{"tex":"\\beta=\\gamma","display":false},{"tex":"\\beta\\in\\gamma[n]","display":false},{"tex":"B","display":false},{"tex":"B_\\gamma(B_\\gamma(n))>B_\\gamma(n)","display":false},{"tex":"F","display":false},{"tex":"n","display":false},{"tex":"n+1","display":false},{"tex":"F_\\gamma","display":false},{"tex":"n","display":false},{"tex":"n+1","display":false},{"tex":"n>0","display":false},{"tex":"F_{\\mathsf S\\gamma}(n)>F_\\gamma(n)","display":false},{"tex":"n","display":false},{"tex":"n+1","display":false},{"tex":"\\alpha_n\\in\\alpha_{n+1}[n+1]","display":false},{"tex":"\\alpha_n","display":false},{"tex":"\\alpha_{n+1}","display":false},{"tex":"F","display":false},{"tex":"n+1","display":false},{"tex":"\\alpha_n","display":false}],"bytes":3678,"backlinks":[{"id":"9a856779455ef3e1","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\Omega_s,\\Omega,\\prec,\\alpha[n]$ 及前驱穷尽见 [[72-thm-structured-predecessor-exhaustion]]；$G,H,B,F$ 及前驱严格比较见 [[72-thm-structured-hierarchy-monotonicity]]。"},{"id":"00439897fba390aa","anchor":"ref-141","locations":["正文"],"count":1,"excerpt":"[[72-thm-structured-hierarchy-monotonicity|thm-structured-hierarchy-monotonicity — 结构化层次的单调性]]"},{"id":"2e1cc33090ad6f68","anchor":"ref-47","locations":["正文"],"count":1,"excerpt":"[[72-thm-structured-hierarchy-monotonicity]]"},{"id":"4d85a6a31705a214","anchor":"ref-141","locations":["正文"],"count":1,"excerpt":"[[./72-thm-structured-hierarchy-monotonicity|thm-structured-hierarchy-monotonicity — 结构化层次的单调性]]"},{"id":"f6f38fb4ec14b41d","anchor":"ref-47","locations":["正文"],"count":1,"excerpt":"[[../72-thm-structured-hierarchy-monotonicity]]"}],"outgoing":["c2a9f766f12bca93","c9e7ac8b29af6dc7","fcd2431dc7fa995d","8e620b5020310301"]}