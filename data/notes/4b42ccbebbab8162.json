\n\\land\\mathrm{Compact}_S(\\Sigma,\\tau_\\Sigma)\\\\\n&\\land\\exists\\vec X,\\vec\\Phi\\in V\\;\\Bigl(\n\\mathrm{CWComplex}_S(\\Sigma,\\tau_\\Sigma,\\vec X,\\vec\\Phi)\n\\land\\forall n\\in\\omega\\;(n\\ge3\\to\\operatorname{dom}(\\vec\\Phi(n))=\\varnothing)\\\\\n&\\qquad\\land\\forall n\\in3\\;\\mathrm{Finite}(\\operatorname{dom}(\\vec\\Phi(n)))\n\\land\\chi=|\\operatorname{dom}(\\vec\\Phi(0))|-|\\operatorname{dom}(\\vec\\Phi(1))|+|\\operatorname{dom}(\\vec\\Phi(2))|\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}genus}\\vdash{}&\n\\mathrm{Genus}_S(\\Sigma,g)\\leftrightarrow\ng\\in\\omega\\land\\Sigma\\ne\\varnothing\n\\land\\mathrm{Boundaryless}_S(\\Sigma)\n\\land\\mathrm{Connected}_S(\\Sigma,\\tau_\\Sigma)\n\\land\\mathrm{Compact}_S(\\Sigma,\\tau_\\Sigma)\\\\\n&\\land\\exists o\\in V\\;\\mathrm{OrientedSurfaceAtlas}_S(\\Sigma,\\tau_\\Sigma,o)\n\\land\\exists\\chi\\in\\mathbb Z\\;\\bigl(\\mathrm{SurfaceEulerCharacteristic}_S(\\chi,\\Sigma)\\land\\chi=2-2g\\bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{Genus}_S","display":false},{"tex":"2-2g","display":false}],"bytes":3108,"backlinks":[{"id":"0d74e4cb72d4ed4c","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Genus}_S$ (genus function, see [[../batch17/58-df-genus.md]])"},{"id":"84daad544872cc71","anchor":"ref-587","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-genus.md|58-df-genus]]（batch17）"}],"outgoing":["07a09ca243e6c6a3","050f6d05b2c94aea","71801f5b9407391a","9c7e703f871c9421","0e800aa519680c23","d9a25b0ac94a3598","815e63e5071e7b58"]}