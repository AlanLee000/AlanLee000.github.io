prox}_0(a,A)\\land\\forall x\\in\\omega\\\n|\\{s\\in\\omega:a(x,s+1)\\ne a(x,s)\\}|\\le n],\\\\\n\\operatorname{OmegaCE}(A)\\ :\\Longleftrightarrow\\exists a\\in2^{\\omega^2}\\ \\exists b\\in\\mathcal C_1^{\\mathrm{tot}}\\\n[\\operatorname{Approx}_0(a,A)\\land\\forall x\\in\\omega\\\n|\\{s\\in\\omega:a(x,s+1)\\ne a(x,s)\\}|\\le b(x)],\\\\\n\\operatorname{DCE}(A)\\ :\\Longleftrightarrow\\exists B,C\\in\\mathcal E\\ [A=B\\setminus C].\n\\end{gathered}","display":true}],"bytes":1932,"backlinks":[{"id":"eedc97021295284c","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-bounded-truth-table]]；see [[20-df-nce]]；see [[20-thm-K-one-complete]]；see [[20-thm-re-closure]]；see [[20-thm-rec-re]]；see [[20-df-finite-code]]。"},{"id":"c4847fa707cf73b8","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-nce]]；see [[20-df-stages]]。"},{"id":"825a5c734b53fa73","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-nce]]。"},{"id":"c209552a90f2623f","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-nce]]；see [[20-df-bounded-reducibility]]；see [[20-df-truth-table]]；see [[20-df-K]]；see [[20-df-change-set]]；see [[20-df-oracle-stage-evaluation]]；see [[20-thm-K-one-complete]]。"},{"id":"aed1d844fad5cccf","anchor":"ref-12","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-superlow]]；see [[20-df-closed-class]]；see [[20-df-nce]]；see [[20-df-oracle-stage-evaluation]]；see [[20-thm-cantor-compactness]]；see [[20-thm-omega-ce]]；see [[20-df-computable]]；see [[20-thm-jump]]。"},{"id":"005203b6707a19f4","anchor":"ref-96","locations":["正文"],"count":1,"excerpt":"[[20-df-nce]] — 章 3；直接提供者 3 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-96","locations":["正文"],"count":1,"excerpt":"[[20-df-nce]]"}],"outgoing":["ea4f6c0d21b23194","60af447f5d59a8dc","e343870c773cb68e","de14d8d6c42250de"]}