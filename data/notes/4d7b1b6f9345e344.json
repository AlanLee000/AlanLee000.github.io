eratorname{Hom}_{\\mathcal E_I}(X\\wedge_IY,X'\\wedge_IY').\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\Sigma_\\pi\\dashv\\pi^*\\dashv\\Pi_\\pi,\\\\\n&\\sqcup_I\\dashv\\Delta_I\\dashv\\sqcap_I,\\\\\n&\\mathsf{Eq}_I\\dashv\\delta_I^*,\\\\\n&T\\dashv_{\\epsilon}C.\n\\end{aligned}","display":true},{"tex":"X\\vee_IY\\le_I Z","display":false},{"tex":"X\\le_I Z","display":false},{"tex":"Y\\le_I Z","display":false},{"tex":"Z\\le_I X\\wedge_IY","display":false},{"tex":"Z\\le_I X","display":false},{"tex":"Z\\le_I Y","display":false},{"tex":"\\mathcal E_I","display":false},{"tex":"\\mathcal E_{I\\times I}","display":false},{"tex":"\\chi:\\mathcal E\\to\\mathcal B^{\\to}","display":false},{"tex":"\\mathrm{Comp}(p)","display":false},{"tex":"\\chi,T,\\epsilon","display":false}],"bytes":3169,"backlinks":[{"id":"1bdcb9b14f83cac1","anchor":"ref-432","locations":["正文"],"count":1,"excerpt":"[[16-thm-logic-as-adjoint|thm-logic-as-adjoints]]"}],"outgoing":["45918fba7ae3214d","7ef7c23f9a9f13d7","d70ce677a3070a45","ee7c0663947fd7d2","ae1a27a060629395","b662179811b5cc72","a88937ea87ff8530"]}