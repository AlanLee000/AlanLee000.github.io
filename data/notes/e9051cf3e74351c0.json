ch12/58-df-zfc-top2-subspace-topology.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,A,K,\\tau_K\\in V\">\\(X,\\tau,A,K,\\tau_K\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5ClosedSet}_S\\subseteq V^3\">\\(\\mathrm{ZfcTop5ClosedSet}_S\\subseteq V^3\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop2CompactSubset}_S\\subseteq V^3\">\\(\\mathrm{ZfcTop2CompactSubset}_S\\subseteq V^3\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop2SubspaceTopology}_S\\subseteq V^4\">\\(\\mathrm{ZfcTop2SubspaceTopology}_S\\subseteq V^4\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopo9KSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTopo9KSpace}_S\\subseteq V^2\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}topo9\\text{-}k\\text{-}space}\\vdash\n\\mathrm{ZfcTopo9KSpace}_S(X,\\tau)\\leftrightarrow\n\\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land\\forall A\\subseteq X\\;\\Bigl(\n\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,A)\\leftrightarrow{}\\\\\n&amp;\\qquad\\forall K\\;\\bigl(\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau)\\to\n\\exists\\tau_K\\;(\\mathrm{ZfcTop2SubspaceTopology}_S(\\tau_K,K,X,\\tau)\n\\land\\mathrm{ZfcTop5ClosedSet}_S(K,\\tau_K,A\\cap K))\\bigr)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}topo9\\text{-}k\\text{-}space}\\vdash\n\\mathrm{ZfcTopo9KSpace}_S(X,\\tau)\\leftrightarrow\n\\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land\\forall A\\subseteq X\\;\\Bigl(\n\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,A)\\leftrightarrow{}\\\\\n&amp;\\qquad\\forall K\\;\\bigl(\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau)\\to\n\\exists\\tau_K\\;(\\mathrm{ZfcTop2SubspaceTopology}_S(\\tau_K,K,X,\\tau)\n\\land\\mathrm{ZfcTop5ClosedSet}_S(K,\\tau_K,A\\cap K))\\bigr)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary topology definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch10/58-df-zfc-top5-topological-space.md","status":"resolved","id":"74086485fba8d86f","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch10/58-df-zfc-top5-topological-space.md]]","embed":false},{"target":"58-df-zfc-top2-compact-subset","status":"resolved","id":"67cf48a2f6e27861","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-top2-compact-subset]]","embed":false},{"target":"../batch12/58-df-zfc-top5-closed-set.md","status":"resolved","id":"4dc8b2d2e69010a2","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-zfc-top5-closed-set.md]]","embed":false},{"target":"../batch12/58-df-zfc-top2-subspace-topology.md","status":"resolved","id":"694a41b0cb75249b","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-zfc-top2-subspace-topology.md]]","embed":false}],"math":[{"tex":"X,\\tau,A,K,\\tau_K\\in V","display":false},{"tex":"\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcTop5ClosedSet}