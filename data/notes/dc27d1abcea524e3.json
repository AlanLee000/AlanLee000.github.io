se},{"tex":"\\Box^+(p\\leftrightarrow A)\\to(p\\leftrightarrow H)","display":false},{"tex":"H","display":false}],"bytes":1871,"backlinks":[{"id":"1cd2a39dee160249","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"9d2a6862fd2083e6","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e0c421a5b45aeb77","anchor":"ref-99","locations":["正文"],"count":2,"excerpt":"单字母构造：[[89-df-single-letter-fixed-trace]] → [[89-lem-single-letter-trace-stability]] → [[89-lem-single-letter-trace-semantics]] → [[89-df-single-letter-fixed-algorithm]] → [[89-thm-single-letter-fixed-point]]。"}],"outgoing":["94d543cad7d7ee3b","5200c72d06d4734b","8e21aff80559d65a","7a04766d8c28cddc","c45e0059ab7065e5","d41420ede99a3508","a0b83ca065132609","85e306b51d3267ec"]}