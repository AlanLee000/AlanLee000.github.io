splay":false},{"tex":"\\mathrm{cor\\text{-}incompleteness\\text{-}extensions}\\vdash\n\\forall A'\\subseteq\\mathrm{Fml}_G\\;\\forall G'\\;\\Bigl[\nG'=(\\Sigma_G,A',\\mathrm{MP}\\cup\\mathrm{Gen})\\land\n\\mathrm{Ax}(G)\\subseteq A'\\land\n\\mathrm{Elem}(G')\\land\\mathrm{Con}(G')\n\\Longrightarrow\n\\exists\\varphi\\in\\mathrm{Sent}_G\\;\n(G'\\nvdash\\varphi\\land G'\\nvdash\\neg\\varphi)\\Bigr]","display":true},{"tex":"G'","display":false},{"tex":"\\mathrm{Ax}(G)\\subseteq A'","display":false}],"bytes":1782,"backlinks":[],"outgoing":["e0eabee5d77258a7","38545b094b915076","c7befd96bd551ade","360e00ddf38f0f16","35c764f4e9f21f28","5a1bd470754681a7","d666a3e3ee6c8148","16613851c4bce386","906680bfce5f44c0"]}