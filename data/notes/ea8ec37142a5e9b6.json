\to\\mathbb N\">\\(\\mathrm{Head}_M:\\mathrm{Conf}_M\\to\\mathbb N\\)</span> (head-position projection, defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}conf\\text{-}proj}\\ \\vdash\\\nM\\in\\mathrm{TM}\\Longrightarrow\n\\left\\{\n\\begin{aligned}\n\\mathrm{State}_M((q,\\tau,i))&amp;\\coloneqq q,\\\\\n\\mathrm{Tape}_M((q,\\tau,i))&amp;\\coloneqq \\tau,\\\\\n\\mathrm{Head}_M((q,\\tau,i))&amp;\\coloneqq i\n\\end{aligned}\n\\right.\n\\qquad((q,\\tau,i)\\in\\mathrm{Conf}_M).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}conf\\text{-}proj}\\ \\vdash\\\nM\\in\\mathrm{TM}\\Longrightarrow\n\\left\\{\n\\begin{aligned}\n\\mathrm{State}_M((q,\\tau,i))&amp;\\coloneqq q,\\\\\n\\mathrm{Tape}_M((q,\\tau,i))&amp;\\coloneqq \\tau,\\\\\n\\mathrm{Head}_M((q,\\tau,i))&amp;\\coloneqq i\n\\end{aligned}\n\\right.\n\\qquad((q,\\tau,i)\\in\\mathrm{Conf}_M).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<h3 id=\"函数定义\">函数定义</h3>\n<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"表格\"><table><thead>\n<tr>\n<th>函数</th>\n<th>定义</th>\n<th>含义</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span class=\"math-inline\" data-tex=\"\\mathrm{State}_M(c)\">\\(\\mathrm{State}_M(c)\\)</span></td>\n<td><span class=\"math-inline\" data-tex=\"q\">\\(q\\)</span></td>\n<td>当前状态 <span class=\"math-inline\" data-tex=\"q\\in Q_M\">\\(q\\in Q_M\\)</span></td>\n</tr>\n<tr>\n<td><span class=\"math-inline\" data-tex=\"\\mathrm{Tape}_M(c)\">\\(\\mathrm{Tape}_M(c)\\)</span></td>\n<td><span class=\"math-inline\" data-tex=\"\\tau\">\\(\\tau\\)</span></td>\n<td>磁带函数 <span class=\"math-inline\" data-tex=\"\\tau\\in\\mathcal T_M\">\\(\\tau\\in\\mathcal T_M\\)</span></td>\n</tr>\n<tr>\n<td><span class=\"math-inline\" data-tex=\"\\mathrm{Head}_M(c)\">\\(\\mathrm{Head}_M(c)\\)</span></td>\n<td><span class=\"math-inline\" data-tex=\"i\">\\(i\\)</span></td>\n<td>读写头位置 <span class=\"math-inline\" data-tex=\"i\\in\\mathbb N\">\\(i\\in\\mathbb N\\)</span></td>\n</tr>\n</tbody>\n</table></div><p>三个投影均以一个配置三元组为单一输入；这与下游对 <span class=\"math-inline\" data-tex=\"\\mathrm{State}_M((y)_i)\">\\(\\mathrm{State}_M((y)_i)\\)</span> 的调用元数一致。</p>\n<h3 id=\"用途\">用途</h3>\n<p>这些投影函数用于：</p>\n<ul>\n<li><a class=\"wiki-link\" id=\"ref-3\" data-note=\"61f71a91e63627ba\" href=\"?note=61f71a91e63627ba\" title=\"90-df-compcode\">90-df-compcode</a>: 检查计算历史中的配置</li>\n<li><a class=\"wiki-link\" id=\"ref-4\" data-note=\"4a2564848c03103c\" href=\"?note=4a2564848c03103c\" title=\"90-df-haltseq\">90-df-haltseq</a>: 检测停机状态</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2},{"id":"函数定义","text":"函数定义","level":3},{"id":"用途","text":"用途","level":3}],"links":[{"target":"90-df-configuration","status":"resolved","id":"3953b8fffc6e6551","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[90-df-configuration]]","embed":false},{"target":"90-df-configuration","status":"resolved","id":"3953b8fffc6e6551","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$M\\in\\mathrm{TM}$ and $(q,\\tau,i)\\in\\mathrm{Conf}_M$ (machine and configuration, see [[90-df-configuration]])","embed":false},{"target":"90-df-compcode","status":"resolved","id":"61f71a91e63627ba","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"用途","excerpt":"[[90-df-compcode]]: 检查计算历史中的配置","embed":false},{"target":"90-df-haltseq","status":"resolved","id":"4a2564848c03103c","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"用途","excerpt":"[[90-df-haltseq]]: 检测停机状态","embed":false}],"math":[{"tex":"M\\in\\mathrm{TM}","display":false},{"tex":"(q,\\tau,i)\\in\\mathrm{Conf}_M","display":false},{"tex":"\\mathrm{State}_M:\\mathrm{Co