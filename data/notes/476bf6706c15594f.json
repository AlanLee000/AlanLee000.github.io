[20-df-simple]]；see [[20-df-low-high]]；see [[20-lem-stage-jump-limit]]；see [[20-df-injury-elements]]；see [[20-lem-use-preservation]]；see [[20-df-stages]]。"},{"id":"005203b6707a19f4","anchor":"ref-306","locations":["正文"],"count":1,"excerpt":"[[20-lem-stage-jump-limit]] — 章 7；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-306","locations":["正文"],"count":1,"excerpt":"[[20-lem-stage-jump-limit]]"}],"outgoing":["01d522a0b0df3738","91065cedbdf2fc27","d81dfad676f32c4a","2ea8548c98f572c3"]}