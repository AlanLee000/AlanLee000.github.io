,T,\\mathcal B_S,\\mathcal B_T\\in V\\)</span>.</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProbRandomVariable}_S\">\\(\\mathrm{ZfcProbRandomVariable}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Measure}_S\">\\(\\mathrm{Measure}_S\\)</span> are as in <a class=\"wiki-link\" id=\"ref-4\" data-note=\"8902399f82dbe8a2\" href=\"?note=8902399f82dbe8a2\" title=\"../batch02/58-df-zfc-prob-random-variable.md\">../batch02/58-df-zfc-prob-random-variable.md</a> and <a class=\"wiki-link\" id=\"ref-5\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"../batch13/58-df-measure.md\">../batch13/58-df-measure.md</a>.</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProbIndependentRandomVariables}_S\\subseteq V^9\">\\(\\mathrm{ZfcProbIndependentRandomVariables}_S\\subseteq V^9\\)</span>.</p>\n</li>\n<li>\n<p>对函数图 <span class=\"math-inline\" data-tex=\"f\">\\(f\\)</span> 与集合 <span class=\"math-inline\" data-tex=\"B\">\\(B\\)</span>，<span class=\"math-inline\" data-tex=\"f^{-1}[B]\\coloneqq\\{x\\in\\operatorname{dom}(f):f(x)\\in B\\}\">\\(f^{-1}[B]\\coloneqq\\{x\\in\\operatorname{dom}(f):f(x)\\in B\\}\\)</span>；函数图及定义域使用 <a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}prob\\text{-}independent\\text{-}random\\text{-}variables} \\vdash\n\\mathrm{ZfcProbIndependentRandomVariables}_S(X,Y,\\Omega,\\mathcal F,\\mathbb P,S,\\mathcal B_S,T,\\mathcal B_T)\\leftrightarrow\n\\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land\n\\mathrm{ZfcProbRandomVariable}_S(X,\\Omega,\\mathcal F,S,\\mathcal B_S)\\land\n\\mathrm{ZfcProbRandomVariable}_S(Y,\\Omega,\\mathcal F,T,\\mathcal B_T)\\land\n\\forall A\\in\\mathcal B_S\\;\\forall B\\in\\mathcal B_T\\;\n\\mathbb P(X^{-1}[A]\\cap Y^{-1}[B])=\n\\mathbb P(X^{-1}[A])\\mathbb P(Y^{-1}[B])\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}prob\\text{-}independent\\text{-}random\\text{-}variables} \\vdash\n\\mathrm{ZfcProbIndependentRandomVariables}_S(X,Y,\\Omega,\\mathcal F,\\mathbb P,S,\\mathcal B_S,T,\\mathcal B_T)\\leftrightarrow\n\\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land\n\\mathrm{ZfcProbRandomVariable}_S(X,\\Omega,\\mathcal F,S,\\mathcal B_S)\\land\n\\mathrm{ZfcProbRandomVariable}_S(Y,\\Omega,\\mathcal F,T,\\mathcal B_T)\\land\n\\forall A\\in\\mathcal B_S\\;\\forall B\\in\\mathcal B_T\\;\n\\mathbb P(X^{-1}[A]\\cap Y^{-1}[B])=\n\\mathbb P(X^{-1}[A])\\mathbb P(Y^{-1}[B])\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-df-zfc-prob-random-variable.md","status":"resolved","id":"8902399f82dbe8a2","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-zfc-prob-random-variable.md]]","embed":false},{"target":"../batch13/58-df-measure.md","status":"resolved","id":"ca832ed6bc22f728","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-measure.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch02/58-df-zfc-prob-random-variable.md","status":"resolved","id":"8902399f82dbe8a2","anchor":"ref-4","targetAnchor":"","lo