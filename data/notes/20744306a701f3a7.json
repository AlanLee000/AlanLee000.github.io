mbda\\rangle,P,R)\\\\\n&\\qquad\\land\\forall\\mu\\in M\\;\\Bigl(\n\\mathrm{Ordinal}(\\mu)\\land\\lambda\\leq\\mu\\land\\mathrm{Cardinal}_S^M(\\mu)\\land\\mathrm{Name}(\\check\\mu,P)\n\\to\\mathrm{ZfcForcingRelation}_S(M,\\varnothing,\\varphi_{\\mathrm{card}},\\langle\\check\\mu\\rangle,P,R)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\lambda","display":false},{"tex":"\\kappa^+","display":false},{"tex":"\\lambda","display":false}],"bytes":2087,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4282","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-thm-levy-collapse.md|58-thm-levy-collapse]]（batch05）"}],"outgoing":["db7c5834b8f0957b","5fb1c2241d1943d1","0fbfc19800246e77","06ee5d7ff126e916","5582a281f15a33c2","66d43bb76d055059","ec28b62254928d73","46b2495f214783c3","65418b505fc53093"]}