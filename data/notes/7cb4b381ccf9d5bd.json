\nT\\vdash\\theta\\land\\mathrm{Proof}_{T+\\alpha}(q,g(\\theta))\\land\\ell_T(g(\\theta))>f(q).","display":true}],"bytes":2230,"backlinks":[{"id":"aceae1bb446510ab","anchor":"ref-162","locations":["正文"],"count":1,"excerpt":"[[../67-thm-proof-speedup]]"},{"id":"161ada0e6be38670","anchor":"ref-14","locations":["正文"],"count":1,"excerpt":"[[../67-thm-godel-first-incompleteness]]；[[../67-thm-godel-second-incompleteness]]；[[../67-thm-lob]]；[[../67-thm-complexity-lower-bound]]；[[../67-thm-proof-speedup]]；[[../67-thm-formalized-lob]]；[[../67-thm-formalized-second-incompleteness]]；[[../67-thm-consistency-numeration-variation]]"}],"outgoing":["be38aee184dd1b06","45046cfa53052599","5f966a5415552b4e","f76c99f69499336d"]}