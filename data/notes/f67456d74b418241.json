(\\langle\\beta,T(w)\\rangle)\n\\right\\rangle\\right)\\Bigr]\n\\end{aligned}\n\\right]","display":true},{"tex":"\\mathrm{df\\text{-}linear\\text{-}map\\text{-}compatible}\\vdash\n\\mathrm{Linear}_k(T;V,W)\\leftrightarrow\n\\mathrm{LinearMap}_S(T,V,W,k,+_V,\\odot_V,+_W,\\odot_W)","display":true},{"tex":"+_k,\\cdot_k,0_k,1_k","display":false},{"tex":"\\operatorname{VectorSpace}_k","display":false},{"tex":"k","display":false},{"tex":"T \\leftrightarrow A \\in M_{m\\times n}(k)","display":false}],"bytes":2180,"backlinks":[{"id":"cb69813e33c9d141","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{LinearMap}_S:V^8\\to\\{\\top,\\bot\\}$ (see [[../batch06/58-df-linear-map.md]])"},{"id":"b3b2004f979e0aad","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"498d9a7dee7a4d0a","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"261de7e0269cd7e2","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{LinearMap}_S(T,X,Y,K,+_X,\\odot_X,+_Y,\\odot_Y)$（see [[../batch06/58-df-linear-map.md]]）"},{"id":"004e048b3416923c","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"2ad9c248fe18df37","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{LinearMap}_S:V^8\\to\\{\\top,\\bot\\}$ and $\\mathrm{LinearMap}_S(T,X,Y,\\mathbb F,+_X,\\odot_X,+_Y,\\odot_Y)$ (see [[58-df-linear-map]])"},{"id":"9953d539a73350ec","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{LinearMap}_S:V^8\\to\\{\\top,\\bot\\}$ (see [[58-df-linear-map]])"},{"id":"fb6024478c28eefa","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{LinearMap}_S:V^8\\to\\{\\top,\\bot\\}$ (fully explicit linear-map predicate, see [[../batch06/58-df-linear-map.md]])"},{"id":"76305a7e4d824323","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Linear}_{\\m