,\\operatorname{neg}(A))=\\operatorname{neg}(\\operatorname{Sub}_{531}(\\sigma,A)),","display":true},{"tex":"\\operatorname{Sub}_{531}(\\sigma,\\operatorname{imp}(A,B))\n=\n\\operatorname{imp}(\\operatorname{Sub}_{531}(\\sigma,A),\\operatorname{Sub}_{531}(\\sigma,B)),","display":true},{"tex":"\\operatorname{Sub}_{531}(\\sigma,\\operatorname{box}(A))=\\operatorname{box}(\\operatorname{Sub}_{531}(\\sigma,A))","display":true},{"tex":"\\mathsf{Ax}_{C1}^{531}=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{531}\\},","display":true},{"tex":"\\mathsf{Ax}_{C2}^{531}\n=\n\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{531}\\},","display":true},{"tex":"\\mathsf{Ax}_{C3}^{531}\n=\n\\{((\\neg A\\to\\neg B)\\to(B\\to A)):A,B\\in\\mathsf{Frm}_{531}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\bot}^{531}=\\{\\neg\\bot\\}.","display":true},{"tex":"\\mathsf{Ax}_{K}^{531}\n=\n\\{\\Box(A\\to B)\\to(\\Box A\\to\\Box B):A,B\\in\\mathsf{Frm}_{531}\\}.","display":true},{"tex":"\\mathsf{Ax}_{T}^{531}=\\{\\Box A\\to A:A\\in\\mathsf{Frm}_{531}\\},","display":true},{"tex":"\\mathsf{Ax}_{B}^{531}=\\{A\\to\\Box\\Diamond A:A\\in\\mathsf{Frm}_{531}\\}.","display":true},{"tex":"\\mathsf{Ax}_{531}\n=\n\\mathsf{Ax}_{C1}^{531}\\cup\n\\mathsf{Ax}_{C2}^{531}\\cup\n\\mathsf{Ax}_{C3}^{531}\\cup\n\\mathsf{Ax}_{\\bot}^{531}\\cup\n\\mathsf{Ax}_{K}^{531}\\cup\n\\mathsf{Ax}_{T}^{531}\\cup\n\\mathsf{Ax}_{B}^{531}.","display":true},{"tex":"\\frac{A\\qquad A\\to B}{B},\n\\qquad\n\\frac{A}{\\Box A}.","display":true},{"tex":"\\mathsf{Rule}_{MP}^{531}=\\{((A,A\\to B),B):A,B\\in\\mathsf{Frm}_{531}\\},\n\\qquad\n\\mathsf{Rule}_{Nec}^{531}=\\{((A),\\Box A):A\\in\\mathsf{Frm}_{531}\\}.","display":true},{"tex":"\\Gamma\\subseteq\\mathsf{Frm}_{531}","display":false},{"tex":"\\mathsf{Proof}_{531}(\\Gamma)","display":false},{"tex":"((\\Delta_0,A_0),\\ldots,(\\Delta_{m-1},A_{m-1}))","display":true},{"tex":"m>0","display":false},{"tex":"\\Delta_i\\in\\mathcal P_{\\mathrm{fin}}(\\Gamma)","display":false},{"tex