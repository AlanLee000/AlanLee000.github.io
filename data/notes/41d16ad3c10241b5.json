{"id":"41d16ad3c10241b5","group":"28","path":"28/28-df-elementary-equivalence.md","title":"初等等价","display":"df-elementary-equivalence — 初等等价","type":"definition","metadata":{"type":"definition","source_status":"local-support-definition","book":"Computational Complexity: A Modern Approach","book_abbrev":"28","label":"28-df-elementary-equivalence","aliases":["28-df-elementary-equivalence"],"display":"df-elementary-equivalence — 初等等价","depends_on":["[[28-df-structure]]","[[28-df-satisfaction]]","[[28-df-sentence]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"source_status","html":"local-support-definition"},{"key":"book","html":"Computational Complexity: A Modern Approach"},{"key":"book_abbrev","html":"28"},{"key":"label","html":"28-df-elementary-equivalence"},{"key":"aliases","html":"<div class=\"property-array\"><span>28-df-elementary-equivalence</span></div>"},{"key":"display","html":"df-elementary-equivalence — 初等等价"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"7046e83df52059de\" href=\"?note=7046e83df52059de\" title=\"28-df-structure\">28-df-structure</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"d82c10f45e77e524\" href=\"?note=d82c10f45e77e524\" title=\"28-df-satisfaction\">28-df-satisfaction</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"410d75338bdb9bb0\" href=\"?note=410d75338bdb9bb0\" title=\"28-df-sentence\">28-df-sentence</a></span></div>"}],"html":"<h1 id=\"df-elementary-equivalence-—-初等等价-$\\equiv$\">df-elementary-equivalence — 初等等价 <span class=\"math-inline\" data-tex=\"\\equiv\">\\(\\equiv\\)</span></h1>\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Struct}_S(\\mathfrak{A}),\\mathrm{Struct}_S(\\mathfrak{B})\">\\(\\mathrm{Struct}_S(\\mathfrak{A}),\\mathrm{Struct}_S(\\mathfrak{B})\\)</span> (<span class=\"math-inline\" data-tex=\"S\">\\(S\\)</spa