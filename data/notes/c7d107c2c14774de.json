j\\in\\{1,\\ldots,n\\}\\;(i\\ne j\\Longrightarrow z_i\\ne z_j)\\bigr)\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{HRS}(F,\\tau_F,R)\\Longleftrightarrow\nF\\ne\\varnothing\\land\\tau_F\\in\\mathrm{Typ}^{F}\\land R\\subseteq\\mathrm{HRule}.","display":true},{"tex":"\\begin{aligned}\nI_R\\coloneqq\\{(s,t)\\in H^2:{}&\n\\exists n\\in\\mathbb N\\;\\exists b\\in\\mathcal B\\;\n\\exists(A_1,\\ldots,A_n)\\in\\mathrm{Typ}^n\\;\\\\\n&\\exists(L,U)\\in R\\cap H_{A_1\\Rightarrow\\cdots\\Rightarrow A_n\\Rightarrow b}^{2}\\;\n\\exists(s_1,\\ldots,s_n)\\in\\prod_{i=1}^{n}H_{A_i}\\;\\\\\n&\\bigl(s=\\nu_b(Ls_1\\cdots s_n)\\land t=\\nu_b(Us_1\\cdots s_n)\\bigr)\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{HCompat}(Q)\\Longleftrightarrow{}&Q\\subseteq\\bigcup_{A\\in\\mathrm{Typ}}H_A^2\\\\\n&\\land\\Bigl(\\forall A,B\\in\\mathrm{Typ}\\;\\forall(s,t)\\in Q\\cap H_B^2\\;\n\\forall x\\in V_A\\;((\\lambda x.s,\\lambda x.t)\\in Q)\\Bigr)\\\\\n&\\land\\Bigl(\\forall k\\in\\mathbb N\\;\\forall j\\in\\{1,\\ldots,k\\}\\;\n\\forall\\vec u,\\vec v\\in H^k\\;\\forall h\\in V\\cup F\\;\\forall b\\in\\mathcal B\\;\\Bigl(\\\\\n&\\bigl(\\bar h u_1\\cdots u_k\\in H_b\\land\\bar h v_1\\cdots v_k\\in H_b\n\\land(u_j,v_j)\\in Q\\land\n\\forall i\\in\\{1,\\ldots,k\\}\\setminus\\{j\\}\\;(u_i=v_i)\\bigr)\\\\\n&\\Longrightarrow(\\bar h u_1\\cdots u_k,\\bar h v_1\\cdots v_k)\\in Q\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\to_H\\coloneqq\n\\bigcap\\{Q\\subseteq\\bigcup_{A\\in\\mathrm{Typ}}H_A^2:\n\\mathrm{HCompat}(Q)\\land I_R\\subseteq Q\\}.","display":true},{"tex":"I_R","display":false},{"tex":"\\to_H","display":false}],"bytes":4877,"backlinks":[{"id":"864a35781ae3b23f","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"取基本类型集 $\\mathcal B=\\{o\\}$。$\\mathsf{abs},\\mathsf{app}$ 为两个互异常元，$F=\\{\\mathsf{abs},\\mathsf{app}\\}$；$z\\in V_{o\\Rightarrow o}$、$w,x\\in V_o$。常元类型图由下式给出，原始语法取 [[56-df-lambda-term]]。$H,\\nu_o,\\bar w$、合法规则与 $\\to