"\\alpha\\succeq\\tau","display":false},{"tex":"\\eta","display":false},{"tex":"T","display":false},{"tex":"\\rho\\succeq\\tau","display":false},{"tex":"\\alpha,\\beta\\succeq\\rho","display":false},{"tex":"\\eta,\\nu","display":false},{"tex":"\\Phi_e^\\alpha\\succeq\\eta","display":false},{"tex":"\\Phi_e^\\beta\\succeq\\nu","display":false},{"tex":"\\operatorname{PerfectEmbed}","display":false},{"tex":"\\mathrm{lem\\text{-}functional-perfect-embedding}\\vdash\n\\exists g:2^{<\\omega}\\to T\\ [\\operatorname{PerfectEmbed}(g,T)].","display":true},{"tex":"h","display":false},{"tex":"g","display":false},{"tex":"h(\\varnothing)=\\tau","display":false},{"tex":"g(\\varnothing)=\\varnothing","display":false},{"tex":"\\varnothing\\in T","display":false},{"tex":"h(\\sigma),g(\\sigma)","display":false},{"tex":"\\Phi_e^{h(\\sigma)}\\succeq g(\\sigma)","display":false},{"tex":"h(\\sigma)","display":false},{"tex":"g(\\sigma)","display":false},{"tex":"g(\\sigma)","display":false},{"tex":"h(\\sigma^\\frown0),h(\\sigma^\\frown1)","display":false},{"tex":"g(\\sigma^\\frown0),g(\\sigma^\\frown1)","display":false},{"tex":"T","display":false},{"tex":"\\sigma\\preceq\\rho\\iff g(\\sigma)\\preceq g(\\rho)","display":false},{"tex":"g","display":false},{"tex":"h(\\sigma)","display":false},{"tex":"\\Phi_e^{h(\\sigma)}","display":false}],"bytes":2887,"backlinks":[{"id":"d467a7b6bbdb1c63","anchor":"ref-15","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-basis]]；see [[20-df-low-high]]；see [[20-df-oracle-numbering]]；see [[20-df-use]]；see [[20-thm-K-one-complete]]；see [[20-thm-jump]]；see [[20-lem-functional-perfect-embedding]]；see [[20-thm-perfect-embedding-degrees]]。"}],"outgoing":["140cce30ee9c16d1","4b1f1864d7fb1f2e","93a810534b87b0f9","ecb9f43e837dcf35"]}