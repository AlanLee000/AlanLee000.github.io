pha,\\eta\\in2^{<\\omega}\\\n[(\\tau\\preceq\\alpha\\land\\Phi_e^\\alpha\\succeq\\eta)\\Rightarrow\\eta\\in T],\\\\\n\\forall\\rho\\in2^{<\\omega}\\ [\\tau\\preceq\\rho\\Rightarrow\n\\exists\\alpha,\\beta,\\eta,\\nu\\in2^{<\\omega}\\\n(\\rho\\preceq\\alpha\\land\\rho\\preceq\\beta\\land\\eta\\perp\\nu\n\\land\\Phi_e^\\alpha\\succeq\\eta\\land\\Phi_e^\\beta\\succeq\\nu)].\n\\end{gathered}","display":true},{"tex":"\\mathrm{lem\\text{-}functional-perfect-embedding}\\vdash\n\\exists g:2^{<\\omega}\\to T\\ [\\operatorname{PerfectEmbed}(g,T)].","display":true},{"tex":"h","display":false},{"tex":"g","display":false},{"tex":"h(\\varnothing)=\\tau","display":false},{"tex":"g(\\varnothing)=\\varnothing","display":false},{"tex":"\\varnothing\\in T","display":false},{"tex":"h(\\sigma),g(\\sigma)","display":false},{"tex":"\\Phi_e^{h(\\sigma)}\\succeq g(\\sigma)","display":false},{"tex":"h(\\sigma)","display":false},{"tex":"g(\\sigma)","display":false},{"tex":"g(\\sigma)","display":false},{"tex":"h(\\sigma^\\frown0),h(\\sigma^\\frown1)","display":false},{"tex":"g(\\sigma^\\frown0),g(\\sigma^\\frown1)","display":false},{"tex":"T","display":false},{"tex":"\\sigma\\preceq\\rho\\iff g(\\sigma)\\preceq g(\\rho)","display":false},{"tex":"g","display":false},{"tex":"h(\\sigma)","display":false},{"tex":"\\Phi_e^{h(\\sigma)}","display":false}],"bytes":2690,"backlinks":[{"id":"d467a7b6bbdb1c63","anchor":"ref-15","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-basis]]；see [[20-df-low-high]]；see [[20-df-oracle-numbering]]；see [[20-df-use]]；see [[20-thm-K-one-complete]]；see [[20-thm-jump]]；see [[20-lem-functional-perfect-embedding]]；see [[20-thm-perfect-embedding-degrees]]。"},{"id":"005203b6707a19f4","anchor":"ref-326","locations":["正文"],"count":1,"excerpt":"[[20-lem-functional-perfect-embedding]] — 章 9；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-326","locations":["正文"],"count":1,"excerpt":"[[20-lem-functional-perfect-embedding]]"}],"outgoing":["140cce30ee9