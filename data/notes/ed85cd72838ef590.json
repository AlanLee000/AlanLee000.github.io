)\\coloneqq\\operatorname{out}(T_r),\\qquad w_{O,g,C}\\coloneqq\\operatorname{bin}(g(\\operatorname{qry}_O(C))).","display":true},{"tex":"T^{O,g,C}_j\\coloneqq\\begin{cases}\\operatorname{tape}(w_{O,g,C})&j=a,\\\\T_j&j\\ne a,\\end{cases}\\qquad i^{O,g,C}_j\\coloneqq\\begin{cases}0&j=a,\\\\i_j&j\\ne a\\end{cases}\\qquad(0\\le j\\le k_M).","display":true},{"tex":"\\operatorname{reply}_{O,g}(C)\\coloneqq\\left\\langle q_{\\mathrm{reply}},(T^{O,g,C}_j)_{j=0}^{k_M},(i^{O,g,C}_j)_{j=0}^{k_M}\\right\\rangle.","display":true},{"tex":"\\operatorname{Step}_{O^g}(C,C')\\Longleftrightarrow(q\\ne q_{\\mathrm{query}}\\land\\operatorname{Step}_M(C,C'))\\lor(q=q_{\\mathrm{query}}\\land C'=\\operatorname{reply}_{O,g}(C))\\qquad(O\\in\\mathrm{FOTM}).","display":true},{"tex":"\\operatorname{Comp}_{O^g}(x)\\coloneqq\\bigcup_{m\\in\\mathbb N}\\left\\{(C_0,\\ldots,C_m)\\in\\operatorname{Conf}(M,x)^{m+1}:C_0=C^0_{M,x},\\ \\forall j<m\\;\\operatorname{Step}_{O^g}(C_j,C_{j+1})\\right\\}.","display":true},{"tex":"\\operatorname{time}_{O^g}(x)\\coloneqq\\sup\\{m\\in\\mathbb N:\\exists(C_0,\\ldots,C_m)\\in\\operatorname{Comp}_{O^g}(x)\\}.","display":true},{"tex":"O^g(x)\\coloneqq\\iota y\\in\\Sigma^*\\cup\\{\\uparrow\\}\\;\\left[(y=\\uparrow\\land\\operatorname{time}_{O^g}(x)=\\infty)\\lor\\exists m\\in\\mathbb N\\;\\exists(C_0,\\ldots,C_m)\\in\\operatorname{Comp}_{O^g}(x)\\;\\exists q,T,\\boldsymbol i\\;\\left(C_m=\\langle q,T,\\boldsymbol i\\rangle\\land q\\in\\{q_{\\mathrm{acc}},q_{\\mathrm{rej}}\\}\\land y=\\operatorname{out}(T_1)\\right)\\right].","display":true},{"tex":"\\chi_L:\\Sigma^*\\to\\{0,1\\},\\qquad\\chi_L(x)\\coloneqq\\begin{cases}1&x\\in L,\\\\0&x\\notin L.\\end{cases}","display":true},{"tex":"f\\le_T^{\\mathbf P}g\\ \\Longleftrightarrow\\ \\exists O\\in\\mathrm{FOTM}\\;\\exists b,c\\in\\mathbb N_{\\ge1}\\;\\forall x\\in\\Sigma^*\\;\\bigl(O^g(x)=\\operatorname{bin}(f(x))\\land\\operatorname{time}_{O^g}(x)\\le c(|x|+1)^b\\bigr).","display":true},{"tex":"\\#\\mathbf P\\mathrm{Complete}_T\\coloneqq\\{g\\in\\#\\mathbf P:\\forall f\\in\\#\\mathbf P\\;f\\le_T^{\\mathbf P}g\\}.","display":true},{"tex":"\\mathbf P^g\\coloneqq\\left\\{L\\subseteq\\Sigma^*\\ \\middle|\\ \\exists O\\in\\mathrm{FOTM}\\;\\exists b,c\\in\\mathbb N_{\\ge1}\\;\\forall x\\in\\Sigma^*\\;\\bigl(O^g(x)=\\operatorname{bin}(\\chi_L(x))\\land\\operatorname{time}_{O^g}(x)\\le c(|x|+1)^b\\bigr)\\right\\}.","display":true},{"tex":"\\mathbf P^{\\#\\mathbf P}\\coloneqq\\bigcup_{g\\in\\#\\mathbf P}\\mathbf P^g.","display":true},{"tex":"g","display":false}],"bytes":5487,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-127","locations":["正文"],"count":1,"excerpt":"计数复杂性：[[28-df-sharp-p]]、[[28-df-sharp-p-oracle]]、[[28-thm-toda]]。"},{"id":"575c8521e7d1dd42","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathbf P^{\\#\\mathbf P},\\mathbf P^g$ 使用 [[28-df-sharp-p-oracle]] 的二进制函数oracle接口，$\\#\\mathrm{SAT}$ 及其完全性见 [[28-thm-sharp-sat-complete]]。"},{"id":"533a7b5c79de3204","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\#\\mathrm{SAT}$ 见 [[28-df-sharp-sat]]；$\\#\\mathbf P\\mathrm{Complete}_{\\mathrm{par}}$ 与 $\\le_{\\mathrm{par}}^{\\mathbf P}$ 见 [[28-df-counting-reduction]]；图灵完全性见 [[28-df-sharp-p-oracle]]。\n采用 [[28-thm-cook-levin]] 的确定型验证计算编码；所有证书长度固定为 [[28-df-sharp-p]] 的 $p(|x|)$，不同证书不按计算前缀重复计数。"},{"id":"d7ec083aeafd5af7","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathbf{PH}$ 见 [[28-df-ph]]；$\\mathbf P^{\\#\\mathbf P}$ 是 [[28-df-sharp-p-oracle]] 的确定型多项式时间函数 oracle 语言类，oracle 整数答复按二进制编码。"},{"id":"7d917c014b32a7f2","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\Sigma=\\{0,1\\}$；$\\#\\mathbf P$、$\\#\\mathbf P\\mathrm{Complete}_T$ 见 [[28-df-sharp-p]]、[[28-df-sharp-p-oracle]]。\n$n\\in\\mathbb N$，$A=(a_{ij})_{i,j\\in[n]}\\in\\Sigma^{n\\times n}$；$S_n$ 是 $[n]$ 上的置换群，数值空乘积为 $1$；$\\langle b\\rangle$ 为比特 $b$ 的单字符字串。$\\operatorname{enc}_{\\mathrm{mat}}$ 将一元维数与逐行矩阵位拼接，编码式中的