[\\tau]\\coloneqq\\{S\\in\\mathrm{BoolQuery}[\\tau]\\mid\\exists M\\in\\mathrm{ATM}\\;\\exists p\\in\\mathbb N[X]\\;(\\operatorname{Decides}_\\tau(M,S)\\land q_0^M\\in Q_\\forall\\land\\forall A\\in\\mathrm{STRUC}[\\tau]\\;\\forall<\\in\\operatorname{LinOrd}(|A|)\\;(\\operatorname{Time}_M(x_{A,<})\\leq p(n_A)\\land\\operatorname{Alt}_M(x_{A,<})\\leq k-1))\\}.","display":true},{"tex":"\\mathrm{PH}[\\tau]\\coloneqq\\bigcup_{k\\geq1}(\\Sigma_k^p[\\tau]\\cup\\Pi_k^p[\\tau]).","display":true}],"bytes":2800,"backlinks":[{"id":"d76c8b012650fb73","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\tau$ (词汇表, see [[29-df-ph]])"},{"id":"38909ffa6d1e85ce","anchor":"ref-34","locations":["正文"],"count":1,"excerpt":"[[29-df-ph]]、[[29-thm-ph-equivalence]] — 多项式层次"},{"id":"2e9f1ba8e2364241","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm L^{<}[\\tau],\\mathrm{NL}^{<}[\\tau],\\mathrm P^{<}[\\tau],\\mathrm{NP}^{<}[\\tau],\\mathrm{PSPACE}^{<}[\\tau]$ 见 [[29-df-complexity-classes]]；$\\mathrm{PH}[\\tau\\cup\\{<\\}]$ 见 [[29-df-ph]]，其有序输入限制在下式给出。"},{"id":"e052662a4a07aa17","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\tau$ (词汇表, see [[29-df-ph]])"},{"id":"805a7de3b1249a36","anchor":"ref-48","locations":["正文"],"count":1,"excerpt":"[[29-df-ph]]"},{"id":"ecc0dd131d213345","anchor":"ref-109","locations":["正文"],"count":1,"excerpt":"[[../29-df-ph]]"}],"outgoing":["4f651c8d1bdc9a58","2aab8d6d79a93409","77e57ed488a01e39","8a781a879eb2b5bf","92256ad8556a5baf"]}