,"display":false},{"tex":"\\sigma","display":false},{"tex":"\\tau(x)=\\Theta(\\sigma(x))","display":false},{"tex":"\\Theta(t\\sigma)=\\Theta(t)\\tau","display":false},{"tex":"\\tau","display":false},{"tex":"\\Theta(l)","display":false},{"tex":"l","display":false},{"tex":"l","display":false},{"tex":"x\\in\\mathcal V_q","display":false},{"tex":"v_x\\in T_q","display":false},{"tex":"\\Theta","display":false},{"tex":"v_x","display":false},{"tex":"\\sigma(x)=v_x","display":false},{"tex":"\\operatorname{Var}(l)","display":false},{"tex":"\\operatorname{Var}(r)\\subseteq\\operatorname{Var}(l)","display":false},{"tex":"u","display":false},{"tex":"\\Theta","display":false},{"tex":"T'\\setminus T'_{\\mathrm{wt}}","display":false}],"bytes":3420,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-332","locations":["正文"],"count":2,"excerpt":"[[56-prop-many-sorted-forgetting-step-correspondence.md]]"}],"outgoing":["1e959f58a71a7a2f","629f88abafad3e3c","a3b60e1e9cdeef27","a0c9e286170288bf"]}