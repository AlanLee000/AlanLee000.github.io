=\"3cd1834de4f2efb2\" href=\"?note=3cd1834de4f2efb2\" title=\"../batch19/58-df-continuous-map.md\">../batch19/58-df-continuous-map.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"E,\\tau,\\mathcal P,\\mathbb F,+_E,\\cdot_E,0_E,K,f,\\tau_K,x\\in V\">\\(E,\\tau,\\mathcal P,\\mathbb F,+_E,\\cdot_E,0_E,K,f,\\tau_K,x\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcAnalysis2LocallyConvexSpace}_S,\\mathrm{ZfcTop2HausdorffSpace}_S,\\mathrm{ZfcTop2CompactSubset}_S,\\mathrm{Convex}_S,\\mathrm{Continuous}_S\">\\(\\mathrm{ZfcAnalysis2LocallyConvexSpace}_S,\\mathrm{ZfcTop2HausdorffSpace}_S,\\mathrm{ZfcTop2CompactSubset}_S,\\mathrm{Convex}_S,\\mathrm{Continuous}_S\\)</span> (typed predicates)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}kuratowski}\\vdash\n\\mathrm{ZfcAnalysis2LocallyConvexSpace}_S(E,\\tau,\\mathcal P,\\mathbb F,+_E,\\cdot_E,0_E)\n\\land\\mathrm{ZfcTop2HausdorffSpace}_S(E,\\tau)\n\\land\\varnothing\\neq K\\subseteq E\n\\land\\mathrm{ZfcTop2CompactSubset}_S(K,E,\\tau)\n\\land\\mathrm{Convex}_S(K,E)\n\\land\\exists\\tau_K\\;\\bigl(\\tau_K=\\{U\\cap K\\mid U\\in\\tau\\}\\land\\mathrm{Continuous}_S(f,K,\\tau_K,K,\\tau_K)\\bigr)\n\\to\\exists x\\in K\\;(f(x)=x).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}kuratowski}\\vdash\n\\mathrm{ZfcAnalysis2LocallyConvexSpace}_S(E,\\tau,\\mathcal P,\\mathbb F,+_E,\\cdot_E,0_E)\n\\land\\mathrm{ZfcTop2HausdorffSpace}_S(E,\\tau)\n\\land\\varnothing\\neq K\\subseteq E\n\\land\\mathrm{ZfcTop2CompactSubset}_S(K,E,\\tau)\n\\land\\mathrm{Convex}_S(K,E)\n\\land\\exists\\tau_K\\;\\bigl(\\tau_K=\\{U\\cap K\\mid U\\in\\tau\\}\\land\\mathrm{Continuous}_S(f,K,\\tau_K,K,\\tau_K)\\bigr)\n\\to\\exists x\\in K\\;(f(x)=x).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The subspace topology is an existentially bound set in the assertion rather than a prose-only abbreviation.</li>\n<li>The legacy filename is retained for link stability; no distinct standard “Kuratowski fixed-point theorem” is asserted here.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch19/58-df-zfc-analysis2-locally-convex-space.md","status":"resolved","id":"7d71608bc30daeda","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch19/58-df-zfc-analysis2-locally-convex-space.md]]","embed":false},{"target":"../batch04/58-df-zfc-top2-hausdorff-space.md","status":"resolved","id":"0e251de61cf71058","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-zfc-top2-hausdorff-space.md]]","embed":false},{"target":"../batch18/58-df-zfc-top2-compact-subset.md","status":"resolved","id":"67cf48a2f6e27861","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-zfc-top2-compact-subset.md]]","embed":false},{"target":"../batch08/58-df-convex-set.md","status":"resolved","id":"341b5a5ae2ec5b04","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-convex-set.md]]","embed":false},{"target":"../batch19/58-df-continuous-map.md","status":"resolved","id":"3cd1834de4f2efb2","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch19/58-df-continuous-map.md]]","embed":false}],"math":[{"tex":"E,\\tau,\\mathcal P,\\mathbb F,+_E,\\cdot_E,0_E,K,f,\\tau_K,x\\in V","display":false},{"tex":"\\mathrm{ZfcAnalysis2LocallyConvexSpace}_S,\\mathrm{ZfcTop2HausdorffSpace}_S,\\mathrm{ZfcTop2CompactSubset}_S,\\mathrm{Convex}_S,\\mathrm{Continuous}_S","display":false},{"tex":"\\mathrm{thm\\text{-}kuratowski}\\vdash\n\\mathrm{ZfcAnalysis2LocallyConvexSpace}_S(E,\\tau,\\mathcal P,\\mathbb F,+_E,\\cdot_E,0_E)\n\\land\\mathrm{ZfcTop2HausdorffSpace}_S(E,\\tau)\n\\land\\varnothing\\neq K\\subseteq E\n\\land\\mathrm{ZfcTop2CompactSubset}_S(K,E,\\tau)\n\\land\\mathrm{Convex}_S(K,E)\n\\land\\exists\\tau_K\\;\\bigl(\\tau_K=\\{U\\cap K\\mid U\\in\\tau\\}\\land\\mathrm{Continuous}_S(f,K,\\tau_K,K,\\tau_K)\\bigr)\n\\to\\exists x\\in K\\;(f(x)=x).","display":true}],"bytes":1466,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4263","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-thm-kuratowski.md|58-thm-kuratowski]]（batch07）"}],"outgoing":["7d71608bc30daeda","0e251de61cf71058","67cf48a2f6e27861","341b5a5ae2ec5b04","3cd1834de4f2efb2"]}