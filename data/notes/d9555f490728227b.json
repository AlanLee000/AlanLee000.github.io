\\omega\\;\\bigl(\\Omega(k)=\\{\\eta\\in V\\mid\\mathrm{DifferentialKForm}_S(\\eta,M,n,k)\\}\\land\\mathrm{Function}(d(k),\\Omega(k),\\Omega(k+1))\\bigr)\\land\\forall k\\in\\omega\\;\\forall\\eta\\in\\Omega(k)\\;\\bigl(d(k+1)(d(k)(\\eta))=0_{\\Omega(k+2)}\\bigr)\\Bigr)","display":true},{"tex":"k","display":false},{"tex":"n","display":false},{"tex":"d^{k+1}\\circ d^k=0","display":false},{"tex":"0","display":false}],"bytes":1717,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1436","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-ana-de-rham-complex.md|58-df-zfc-ana-de-rham-complex]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","5045d216c83e75cb","36d7463d215be751","71fe0dc4c8613e69","db62358c2ba471b0"]}