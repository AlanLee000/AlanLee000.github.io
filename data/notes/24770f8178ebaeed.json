{"id":"24770f8178ebaeed","group":"28","path":"28/28-df-conp.md","title":"coNP","display":"df-conp — coNP","type":"definition","metadata":{"book":"Computational Complexity: A Modern Approach","book_abbrev":"28","depends_on":["[[28-df-np]]"],"display":"df-conp — coNP","label":"28-df-conp","aliases":["28-df-conp"],"type":"definition"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"book","html":"Computational Complexity: A Modern Approach"},{"key":"book_abbrev","html":"28"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"0cb5248561455df8\" href=\"?note=0cb5248561455df8\" title=\"28-df-np\">28-df-np</a></span></div>"},{"key":"display","html":"df-conp — coNP"},{"key":"label","html":"28-df-conp"},{"key":"aliases","html":"<div class=\"property-array\"><span>28-df-conp</span></div>"},{"key":"type","html":"definition"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"L \\subseteq \\{0,1\\}^*\">\\(L \\subseteq \\{0,1\\}^*\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\overline{L}=\\{0,1\\}^*\\setminus L\">\\(\\overline{L}=\\{0,1\\}^*\\setminus L\\)</span> (补语言)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathbf{NP}\">\\(\\mathbf{NP}\\)</span> (NP 类, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"0cb5248561455df8\" href=\"?note=0cb5248561455df8\" title=\"28-df-np\">28-df-np</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathbf{coNP}\\subseteq\\mathcal{P}(\\{0,1\\}^*)\">\\(\\mathbf{coNP}\\subseteq\\mathcal{P}(\\{0,1\\}^*)\\)</span> (coNP 类)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathbf{coNP}\\coloneqq\\{L\\subseteq\\{0,1\\}^*\\mid\\{0,1\\}^*\\setminus L\\in\\mathbf{NP}\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathbf{coNP}\\coloneqq\\{L\\subseteq\\{0,1\\}^*\\mid\\{0,1\\}^*\\setminus L\\in\\mathbf{NP}\\}\\]</div><butt