tex":"\\operatorname{Pr}_T","display":false},{"tex":"T","display":false},{"tex":"\\begin{aligned}\nR_{T,\\mathcal C,e,s}(a,p)&:\\Longleftrightarrow\\exists A\\in\\operatorname{Sent}_A\\ \\exists\\pi\\in\\mathcal A_a^{<\\omega}\\ [a=e(A)\\land p=s(\\pi)\\land\\mathrm{Proof}_{\\mathcal C}(T,\\pi,A)],\\\\\n\\operatorname{RepPrf}_{T,\\mathcal C,e,s}(P)&:\\Longleftrightarrow P\\in\\mathcal A_a\\land\\operatorname{fv}_a(P)\\subseteq\\{0,1\\}\\\\\n&\\quad\\land\\forall\\eta\\in\\omega^\\omega\\ [\\mathsf{AT}(P,\\eta)\\leftrightarrow R_{T,\\mathcal C,e,s}(\\eta(0),\\eta(1))].\n\\end{aligned}","display":true},{"tex":"\\operatorname{ProvForm}_T:=\\exists_a x_1\\mathsf{Prf}_T,\\qquad\n\\operatorname{Pr}_T(\\overline n):=\\operatorname{SubNum}_a(\\operatorname{ProvForm}_T,0,n).","display":true},{"tex":"\\rho_{T,f}(p_i)\\coloneqq f(i),\\qquad\n\\rho_{T,f}(\\bot_m)\\coloneqq(\\mathbf0=_a\\mathsf S(\\mathbf0)),\\qquad\n\\rho_{T,f}(A\\to_m B)\\coloneqq\\rho_{T,f}(A)\\to_a\\rho_{T,f}(B),","display":true},{"tex":"\\rho_{T,f}(\\Box_m A)\\coloneqq\n\\operatorname{Pr}_T\\!\\left(\\overline{\\ulcorner\\rho_{T,f}(A)\\urcorner}\\right).","display":true}],"bytes":3852,"backlinks":[{"id":"4d85a6a31705a214","anchor":"ref-358","locations":["正文"],"count":1,"excerpt":"[[./72-df-arithmetic-realization|df-arithmetic-realization — Arithmetic realization of modal formulas]]"}],"outgoing":["2ce276183c963d6c","f5f45b7be0b2d491","94fb82dfe6146007","b0118b1d3360ec7d"]}