frak B}(\\varphi,s))\n\\bigr)\n\\Bigr)\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}logic\\text{-}elementary\\text{-}submodel\\text{-}selected}\\vdash\\\\\n&amp;\\mathrm{ZfcLogicElementarySubmodelSelected}_S(\\mathfrak A,\\mathfrak B,L;\n\\operatorname{Val}_{\\mathfrak A},\\operatorname{Sat}_{\\mathfrak A},\n\\operatorname{Val}_{\\mathfrak B},\\operatorname{Sat}_{\\mathfrak B})\\\\\n&amp;\\quad\\leftrightarrow\n\\Bigl(\n\\mathrm{Substructure}_S(\\mathfrak A,\\mathfrak B,L)\n\\land\\mathrm{Satisfaction}_S(\\mathfrak A,L,\\operatorname{Val}_{\\mathfrak A},\\operatorname{Sat}_{\\mathfrak A})\n\\land\\mathrm{Satisfaction}_S(\\mathfrak B,L,\\operatorname{Val}_{\\mathfrak B},\\operatorname{Sat}_{\\mathfrak B})\\\\\n&amp;\\qquad\\land\\forall s\\;\\Bigl(\n\\mathrm{Assign}(\\mathfrak A,s)\\to\n\\bigl(\n\\mathrm{Assign}(\\mathfrak B,s)\n\\land\\forall\\varphi\\in\\mathrm{Fml}_S(L)\\;\n(\\operatorname{Sat}_{\\mathfrak A}(\\varphi,s)\\leftrightarrow\n\\operatorname{Sat}_{\\mathfrak B}(\\varphi,s))\n\\bigr)\n\\Bigr)\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}logic\\text{-}elementary\\text{-}submodel}\\vdash\n\\mathrm{ZfcLogicElementarySubmodel}_S(\\mathfrak A,\\mathfrak B,L)\n\\leftrightarrow\n\\exists\\operatorname{Val}_{\\mathfrak A},\\operatorname{Sat}_{\\mathfrak A},\n\\operatorname{Val}_{\\mathfrak B},\\operatorname{Sat}_{\\mathfrak B}\\;\n\\mathrm{ZfcLogicElementarySubmodelSelected}_S(\\mathfrak A,\\mathfrak B,L;\n\\operatorname{Val}_{\\mathfrak A},\\operatorname{Sat}_{\\mathfrak A},\n\\operatorname{Val}_{\\mathfrak B},\\operatorname{Sat}_{\\mathfrak B}).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}logic\\text{-}elementary\\tex