^{\\mathbf R}a=a\\\\\n&\\qquad\\land\\bigl(\na\\cdot^{\\mathbf R}b\\leq_{\\mathbf R^-}c\n\\leftrightarrow b\\leq_{\\mathbf R^-}a\\backslash^{\\mathbf R}c\\bigr)\n\\land\\bigl(a\\cdot^{\\mathbf R}b\\leq_{\\mathbf R^-}c\n\\leftrightarrow a\\leq_{\\mathbf R^-}c/^{\\mathbf R}b\\bigr)\\Bigr].\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}residuated}\\vdash\n\\mathrm{SimilarityType}(S_{\\mathsf{RL}},\\alpha_{\\mathsf{RL}})","display":true},{"tex":"\\tau_{\\mathsf{RL}}","display":false}],"bytes":2628,"backlinks":[{"id":"f58c99f46583f2b7","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"073446c7e27f1cce","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"57abb955e28f83aa","anchor":"ref-67","locations":["正文"],"count":1,"excerpt":"[[93-df-residuated]]"}],"outgoing":["3b5f38bd115ed203","ee84ed8b0fae5bc3","6730349967b8ffce"]}