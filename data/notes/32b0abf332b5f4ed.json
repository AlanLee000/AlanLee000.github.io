\times B\\land R=\\operatorname{ran}(f)\\bigr).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}map\\text{-}range}\\vdash\n\\mathrm{ZfcMapRange}_S(R,f)\\leftrightarrow\n\\exists A,B\\in V\\;\\bigl(f\\subseteq A\\times B\\land R=\\operatorname{ran}(f)\\bigr).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The bounded-product clause types <span class=\"math-inline\" data-tex=\"f\">\\(f\\)</span> as a set-coded binary relation before applying the canonical range operator.</li>\n<li>For a function graph this is the usual function range; the predicate also remains valid for arbitrary binary relations, as required by its existing downstream use.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch09/58-df-range.md","status":"resolved","id":"44d32dc8fecf5e62","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch09/58-df-range.md]]","embed":false},{"target":"../batch09/58-df-range.md","status":"resolved","id":"44d32dc8fecf5e62","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{ran}$ (range operator, see [[../batch09/58-df-range.md]])","embed":false}],"math":[{"tex":"R,f,A,B\\in V","display":false},{"tex":"\\operatorname{ran}","display":false},{"tex":"\\mathrm{ZfcMapRange}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}map\\text{-}range}\\vdash\n\\mathrm{ZfcMapRange}_S(R,f)\\leftrightarrow\n\\exists A,B\\in V\\;\\bigl(f\\subseteq A\\times B\\land R=\\operatorname{ran}(f)\\bigr).","display":true},{"tex":"f","display":false}],"bytes":945,"backlinks":[{"id":"bbc24bcdd1e5f249","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-2518","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-map-range.md|58-df-zfc-map-range]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","44d32dc8fecf5e62"]}