appa)\\land\\forall\\alpha\\in\\lambda\\;\\bigl(\\{x\\subseteq\\lambda\\mid |x|<\\kappa\\land\\alpha\\in x\\}\\in F\\bigr)\\land F\\subseteq U\\land\\mathrm{Ultrafilter}_S(U,\\{x\\subseteq\\lambda\\mid |x|<\\kappa\\})\\land\\mathrm{KappaCompleteFilter}_S(U,\\{x\\subseteq\\lambda\\mid |x|<\\kappa\\},\\kappa)","display":true},{"tex":"F","display":false},{"tex":"\\kappa","display":false},{"tex":"P_\\kappa(\\lambda)","display":false},{"tex":"U","display":false},{"tex":"\\kappa","display":false},{"tex":"P_\\kappa(\\lambda)","display":false},{"tex":"\\operatorname{Fine}","display":false}],"bytes":1722,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2457","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-lc-strong-compactness-filter.md|58-df-zfc-lc-strong-compactness-filter]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","56914510091eed27","5e8b8d97b21dd8e8","5fb1c2241d1943d1"]}