}_G\\cap\\Sigma_1^G\\;\n\\mathrm{HenkinSent}_G(H)\n\\right]","display":true},{"tex":"\\Sigma_1^G","display":false},{"tex":"\\mathrm{Prov}_G(v_0)","display":false},{"tex":"\\exists v_1\\,\\dot{\\mathrm{Prf}}_G","display":false},{"tex":"\\mathrm{Prf}_G\\subseteq\\mathbb N^2","display":false},{"tex":"G","display":false},{"tex":"y","display":false},{"tex":"y","display":false},{"tex":"G","display":false},{"tex":"H=\\exists v_0(v_0=v_0)","display":false},{"tex":"\\Sigma_1^G\\cap\\mathrm{Sent}_G","display":false},{"tex":"G\\vdash H","display":false},{"tex":"G\\vdash\\mathrm{Prov}_G(\\overline{\\ulcorner H\\urcorner})","display":false},{"tex":"\\mathrm{HenkinSent}_G(H)","display":false}],"bytes":2796,"backlinks":[{"id":"823a52c75bbad9bd","anchor":"ref-369","locations":["正文"],"count":1,"excerpt":"[[92-fact-henkin-sigma1]]"}],"outgoing":["67317965f7ebd660","8fd1dce21b2c65db","e9cc91aaee998c7b","466c532d80d46a83","e948c25f4a467fa1","468d35690d25ee42","975b3aa9a1e08797"]}