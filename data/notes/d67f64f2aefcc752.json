leq u(\\mathbf x))\\}\n\\end{aligned}\\right]","display":true},{"tex":"\\mathrm{df\\text{-}demand\\text{-}compatible}\\vdash\nD_u(\\mathbf p,m)=D\\leftrightarrow\\mathrm{Demand}_S(D,u,\\mathbf p,m,n)","display":true},{"tex":"(\\mathbf{p}, \\bar{u})","display":false},{"tex":"\\mathbf x^*(\\mathbf p,m)","display":false},{"tex":"D_u(\\mathbf p,m)","display":false},{"tex":"\\mathbf{p} \\cdot \\mathbf{z}(\\mathbf{p}, m) = 0","display":false},{"tex":"\\mathbf{z}","display":false}],"bytes":2237,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-406","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-demand.md|58-df-demand]]（batch06）"}],"outgoing":["0597127ba0cc6437","e825d53bd327fe88"]}