{"id":"fd4053586826de5e","group":"58","path":"58/batch13/58-df-zfc-surjective-function.md","title":"ZFC Surjective Function","display":"df-zfc-surjective-function — ZFC Surjective Function","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-surjective-function","aliases":["58-df-zfc-surjective-function","58-df-zfc-fun-surjective-function"],"display":"df-zfc-surjective-function — ZFC Surjective Function","depends_on":["[[../batch05/58-df-surjective.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-surjective-function"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-surjective-function</span><span>58-df-zfc-fun-surjective-function</span></div>"},{"key":"display","html":"df-zfc-surjective-function — ZFC Surjective Function"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"9f8cb046321ba311\" href=\"?note=9f8cb046321ba311\" title=\"../batch05/58-df-surjective.md\">../batch05/58-df-surjective.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"f,A,B\\in V\">\\(f,A,B\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Surjective}\\subseteq V^3\">\\(\\mathrm{Surjective}\\subseteq V^3\\)</span> (canonical surjection predicate, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"9f8cb046321ba311\" href=\"?note=9f8cb046321ba311\" title=\"../batch05/58-df-surjective.md\">../batch05/58-df-surjective.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{SurjectiveFunction}_S\\subseteq V^3\">\\(\\mathrm{SurjectiveFunction}_S\\subseteq V^3\\)</span> (compatibility predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}surjective\\text{-}function} \\vdash \\mathrm{SurjectiveFunction}_S(f,A,B)\\leftrightarrow\\mathrm{Surjective}(f,A,B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}surjective\\text{-}function} \\vdash \\mathrm{SurjectiveFunction}_S(f,A,B)\\leftrightarrow\\mathrm{Surjective}(f,A,B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n<li><code>58-df-zfc-fun-surjective-function</code> is an alias of this same predicate.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch05/58-df-surjective.md","status":"resolved","id":"9f8cb046321ba311","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-surjective.md]]","embed":false},{"target":"../batch05/58-df-surjective.md","status":"resolved","id":"9f8cb046321ba311","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Surjective}\\subseteq V^3$ (canonical surjection predicate, see [[../batch05/58-df-surjective.md]])","embed":false}],"math":[{"tex":"f,A,B\\in V","display":false},{"tex":"\\mathrm{Surjective}\\subseteq V^3","display":false},{"tex":"\\mathrm{SurjectiveFunction}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}surjective\\text{-}function} \\vdash \\mathrm{SurjectiveFunction}_S(f,A,B)\\leftrightarrow\\mathrm{Surjective}(f,A,B)","display":true}],"bytes":866,"backlinks":[{"id":"98f5e620225bc0fb","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{SurjectiveFunction}_S\\subseteq V^3$ (surjective-function predicate, see [[58-df-zfc-surjective-function]])"},{"id":"84daad544872cc71","anchor":"ref-3506","lo