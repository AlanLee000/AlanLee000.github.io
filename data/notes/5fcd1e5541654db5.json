\n(\\vec{\\dot{\\mathbb R}}(\\beta),\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}},\\beta,\\delta).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}reversed\\text{-}iteration}\\vdash{}&\n\\delta\\in\\mathrm{Ord}\n\\land\\mathrm{ReverseEastonIteration}_S\n(\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}},\\delta)\\\\\n\\to{}&\n\\exists\\vec{\\dot{\\mathbb R}}\\in V\\;\\Bigl(\n\\mathrm{ReverseEastonTailFamily}_S\n(\\vec{\\dot{\\mathbb R}};\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}},\\delta)\\\\\n&\\qquad\\land\\forall\\beta\\in\\delta+1\\;\n\\mathrm{ZfcForcing10ForcingEquivalence}_S\n\\bigl(\\vec{\\mathbb P}(\\delta),\n\\vec{\\mathbb P}(\\beta)*\\vec{\\dot{\\mathbb R}}(\\beta)\\bigr)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\beta","display":false},{"tex":"\\delta+1","display":false}],"bytes":2862,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4395","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-thm-reversed-iteration.md|58-thm-reversed-iteration]]（batch17）"},{"id":"7334957c6d59eacc","anchor":"ref-251","locations":["正文"],"count":1,"excerpt":"[[58-thm-0-sharp.md]]\n[[58-thm-L-condensation.md]]\n[[58-thm-L-definability.md]]\n[[58-thm-L-generic-extension.md]]\n[[58-thm-L-is-transitive.md]]\n[[58-thm-L-satisfies-GCH.md]]\n[[58-thm-L-satisfies-ZFC.md]]\n[[58-thm-MM.md]]\n[[58-thm-V-equal-L.md]]\n[[58-thm-V-equals-L.md]]\n[[58-thm-absoluteness-calculation.md]]\n[[58-thm-ac-wellorder-equivalent.md]]\n[[58-thm-aleph-properties.md]]\n[[58-thm-analytic-completeness.md]]\n[[58-thm-analytic-set-properties.md]]\n[[58-thm-baire-category-theory.md]]\n[[58-thm-baire-category.md]]\n[[58-thm-banach-tarski.md]]\n[[58-thm-beth-function-properties.md]]\n[[58-thm-boolean-valued-model.md]]\n[[58-thm-borel-cardinality.md]]\n[[58-thm-borel-determinacy-proof.md]]\n[[58-thm-bounded-forcing-axioms.md]]\n[[58-thm-cantor.md]]\n[[58-thm-cardinal-multiplication.md]]\n[[58-thm-club-filter-properties.md]]\n[[58-thm-club-guessing.md]]\n[[58-thm-club-intersec