":false},{"tex":"|\\operatorname{InjElem}(A_\\bullet,r_*,e)|<\\omega","display":false},{"tex":"\\mathrm{lem\\text{-}delta2\\text{-}preservation}\\vdash\n\\Phi_e^A\\ne\\chi_C.","display":true},{"tex":"v","display":false},{"tex":"\\Phi_e^A=\\chi_C","display":false},{"tex":"\\ell(e,s)\\to\\infty","display":false},{"tex":"m(e,s)\\to\\infty","display":false},{"tex":"p","display":false},{"tex":"s>v","display":false},{"tex":"m(e,s)>p","display":false},{"tex":"\\Phi_{e,s}^{A_s}(p)","display":false},{"tex":"m(e,t)\\ge m(e,s)>p","display":false},{"tex":"r_*(e,t)","display":false},{"tex":"\\Phi_e^A(p)=\\chi_C(p)","display":false},{"tex":"v","display":false},{"tex":"C","display":false}],"bytes":2317,"backlinks":[{"id":"38ffff953003d9fb","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-uniform-delta2-sequence]]；see [[20-df-maximal-agreement]]；see [[20-lem-delta2-preservation]]；see [[20-lem-delta2-restraint-limit]]；see [[20-thm-single-event-enumeration]]；see [[20-df-re]]。"},{"id":"11bbbd83a4b964cf","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-maximal-agreement]]；see [[20-lem-delta2-preservation]]；see [[20-lem-delta2-restraint-limit]]；see [[20-df-simple]]；see [[20-df-stages]]。"}],"outgoing":["02f37a11ca2f55ac","18e11f4651f28406","fec296dc8eb84564","d6dc5974baa6f8a5"]}