in M\\;(f(p)=y\\land\\mathrm{CriticalPointData}_{58}(p,f,S_M,S_N))\\}.","display":true},{"tex":"\\operatorname{ChartwiseNull}_{\\mathrm{meta}}(A,N)\\leftrightarrow\n\\mathrm{SmoothManifoldRecord}_{58}(S_N)\\land A\\subseteq N\n\\land\\forall\\langle U,W,\\psi\\rangle\\in\\mathcal A_N\\;\n\\lambda_n^*(\\psi[A\\cap U])=0.","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}sard}\\vdash{}\n\\mathrm{SmoothMapStructure}_S(f,M,\\tau_M,\\mathcal A_M,m,N,\\tau_N,\\mathcal A_N,n)\n\\to\n\\operatorname{ChartwiseNull}_{\\mathrm{meta}}(\\operatorname{CritVal}_{\\mathrm{meta}}(f;M,N,n),N).\n\\end{aligned}","display":true}],"bytes":2279,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4401","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-thm-sard.md|58-thm-sard]]（batch03）"}],"outgoing":["71fe0dc4c8613e69","d87c5d842ade903d","68427bc628af9b8d","efe8e2f202483a88","5111035a66b30703","c5f44e08576c6b2e"]}