ass=\"math-inline\" data-tex=\"T,x\\in V\">\\(T,x\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRecursion3ComputableTree}_S\">\\(\\mathrm{ZfcRecursion3ComputableTree}_S\\)</span> (computable-tree predicate, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"ed54c2a57cccfa28\" href=\"?note=ed54c2a57cccfa28\" title=\"../batch11/58-df-zfc-recursion3-computable-tree.md\">../batch11/58-df-zfc-recursion3-computable-tree.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRecursion2PathThroughTree}_S\">\\(\\mathrm{ZfcRecursion2PathThroughTree}_S\\)</span> (path-through-tree predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"1e462022b17b959e\" href=\"?note=1e462022b17b959e\" title=\"../batch05/58-df-zfc-recursion2-path-through-tree.md\">../batch05/58-df-zfc-recursion2-path-through-tree.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRecursion3PathThroughComputableTree}_S\\subseteq V^2\">\\(\\mathrm{ZfcRecursion3PathThroughComputableTree}_S\\subseteq V^2\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}path\\text{-}through\\text{-}computable\\text{-}tree} \\vdash \\mathrm{ZfcRecursion3PathThroughComputableTree}_S(T,x)\\leftrightarrow \\mathrm{ZfcRecursion3ComputableTree}_S(T)\\land\\mathrm{ZfcRecursion2PathThroughTree}_S(x,T)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}path\\text{-}through\\text{-}computable\\text{-}tree} \\vdash \\mathrm{ZfcRecursion3PathThroughComputableTree}_S(T,x)\\leftrightarrow \\mathrm{ZfcRecursion3ComputableTree}_S(T)\\land\\mathrm{ZfcRecursion2PathThroughTree}_S(x,T)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The first conjunct supplies decidable membership and prefix closure; the second supplies the typed Baire-space branch condition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch11/58-df-zfc-recursion3-computable-tree.md","status":"resolved","id":"ed54c2a57cccfa28","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-zfc-recursion3-computable-tree.md]]","embed":false},{"target":"../batch05/58-df-zfc-recursion2-path-through-tree.md","status":"resolved","id":"1e462022b17b959e","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-zfc-recursion2-path-through-tree.md]]","embed":false},{"target":"../batch11/58-df-zfc-recursion3-computable-tree.md","status":"resolved","id":"ed54c2a57cccfa28","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcRecursion3ComputableTree}_S$ (computable-tree predicate, see [[../batch11/58-df-zfc-recursion3-computable-tree.md]])","embed":false},{"target":"../batch05/58-df-zfc-recursion2-path-through-tree.md","status":"resolved","id":"1e462022b17b959e","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcRecursion2PathThroughTree}_S$ (path-through-tree predicate, see [[../batch05/58-df-zfc-recursion2-path-through-tree.md]])","embed":false}],"math":[{"tex":"T,x\\in V","display":false},{"tex":"\\mathrm{ZfcRecursion3ComputableTree}_S","display":false},{"tex":"\\mathrm{ZfcRecursion2PathThroughTree}_S","display":false},{"tex":"\\mathrm{ZfcRecursion3PathThroughComputableTree}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{df\\te