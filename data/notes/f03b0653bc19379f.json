S}}:\n\\mathsf{Frm}_{\\mathsf{FS}}\\times\\mathsf{Prop}\\times\\mathsf{Frm}_{\\mathsf{FS}}\n\\to\\mathsf{Frm}_{\\mathsf{FS}}","display":true},{"tex":"\\operatorname{var}(q)[p:=B]=\n\\begin{cases}\nB,&q=p,\\\\\n\\operatorname{var}(q),&q\\ne p,\n\\end{cases}","display":true},{"tex":"\\bot[p:=B]=\\bot,","display":true},{"tex":"(A\\to C)[p:=B]=A[p:=B]\\to C[p:=B],","display":true},{"tex":"(A\\land C)[p:=B]=A[p:=B]\\land C[p:=B],","display":true},{"tex":"(A\\lor C)[p:=B]=A[p:=B]\\lor C[p:=B],","display":true},{"tex":"(\\Box A)[p:=B]=\\Box(A[p:=B]),\n\\qquad\n(\\Diamond A)[p:=B]=\\Diamond(A[p:=B]).","display":true},{"tex":"\\equiv_{\\alpha,\\mathsf{FS}}\n\\subseteq\n\\mathsf{Frm}_{\\mathsf{FS}}\\times\\mathsf{Frm}_{\\mathsf{FS}},\n\\qquad\nA\\equiv_{\\alpha,\\mathsf{FS}}B\\Longleftrightarrow A=B.","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{IPC}}^{\\mathsf{FS}}","display":false},{"tex":"\\mathsf{Frm}_{\\mathsf{FS}}","display":false},{"tex":"\\{A\\to(B\\to A)\\},\n\\quad\n\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C))\\},","display":true},{"tex":"\\{A\\land B\\to A\\},\n\\quad\n\\{A\\land B\\to B\\},\n\\quad\n\\{A\\to(B\\to A\\land B)\\},","display":true},{"tex":"\\{A\\to A\\lor B\\},\n\\quad\n\\{B\\to A\\lor B\\},\n\\quad\n\\{(A\\to C)\\to((B\\to C)\\to(A\\lor B\\to C))\\},","display":true},{"tex":"\\{\\bot\\to A\\},","display":true},{"tex":"A,B,C","display":false},{"tex":"\\mathsf{Frm}_{\\mathsf{FS}}","display":false},{"tex":"\\begin{aligned}\n\\mathsf{Ax}_{\\mathsf{IPC},1}^{\\mathsf{FS}}&=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{\\mathsf{FS}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},2}^{\\mathsf{FS}}&=\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{\\mathsf{FS}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},3}^{\\mathsf{FS}}&=\\{A\\land B\\to A:A,B\\in\\mathsf{Frm}_{\\mathsf{FS}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},4}^{\\mathsf{FS}}&=\\{A\\land B\\to B:A,B\\in\\mathsf{Frm}_{\\mathsf{FS}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},5}^{\\mathsf{FS}}&=\\{A\\to(B\\to A\\