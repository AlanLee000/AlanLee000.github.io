bf T,\\mathbf h)\\bigr)\\Bigr]","display":true},{"tex":"\\mathrm{df\\text{-}polynomial\\text{-}time\\text{-}oracle\\text{-}machine}\\vdash\n\\operatorname{otime}_O^B\\coloneqq\n\\left\\{(w,m)\\in\\mathbf2^*\\times\\mathbb N:\n\\left(\\{r\\in\\mathbb N:\\exists\\rho\\;\\operatorname{ORun}_O^B(w,r,\\rho)\\},m\\right)\\in\\operatorname{pmin}\\right\\},\\qquad\n\\operatorname{otime}_O^B:\\mathbf2^*\\rightharpoonup\\mathbb N","display":true},{"tex":"\\mathrm{df\\text{-}polynomial\\text{-}time\\text{-}oracle\\text{-}machine}\\vdash\n\\operatorname{PolyOTM}_B(O)\\leftrightarrow\n\\Bigl[\\operatorname{OTM}_B(O)\\land\\operatorname{dom}(\\operatorname{otime}_O^B)=\\mathbf2^*\n\\land\\bigl(\\exists k,c\\in\\mathbb N_{>0}\\;\\exists n_0\\in\\mathbb N\\;\\forall w\\in\\mathbf2^*\\;\n(|w|\\ge n_0\\to\\exists r\\in\\mathbb N\\;((w,r)\\in\\operatorname{otime}_O^B\\land r\\le c|w|^k))\\bigr)\\Bigr]","display":true}],"bytes":2620,"backlinks":[{"id":"15e91bb15396bbe1","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{PolyOTM}_B$ and $L^B(O)$ (polynomial-time oracle machine and accepted language, see [[73-df-polynomial-oracle-runtime]])"},{"id":"8cd0bb12bb71a086","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$A,B\\subseteq\\mathbf2^*$；神谕程序及语言见 [[73-df-oracle-program-semantics]]，$\\operatorname{PolyOTM}_B$ 见 [[73-df-polynomial-oracle-runtime]]。"}],"outgoing":["ab6c7ca255afa826","773cae915e5165f3"]}