ight B).","display":true},{"tex":"ILM","display":false},{"tex":"ILW","display":false},{"tex":"\\mathcal{ILP}_{551}\n=\n\\bigl(\n\\mathsf{Prop}_{551},\n\\mathsf{Frm}_{551},\n\\operatorname{PV}_{551},\n\\operatorname{BV}_{551},\n\\equiv_{\\alpha,551},\n\\mathsf{Subst}_{551},\n\\operatorname{Sub}_{551},\n\\mathsf{Ax}_{551},\n\\mathsf{Rule}_{MP}^{551},\n\\mathsf{Rule}_{Nec}^{551},\n\\mathsf{Rule}_{551},\n\\mathsf{Proof}_{551},\n\\vdash_{551},\n\\mathsf{Thm}_{551}\n\\bigr).","display":true}],"bytes":6505,"backlinks":[],"outgoing":[]}