\\varphi)\\to\n\\exists b\\,\\forall x\\in a\\,\\exists y\\in b\\,\\varphi)\\urcorner\\bigr)\\Bigr).","display":true},{"tex":"\\mathrm{df\\text{-}kp\\text{-}induction}\\vdash\n\\mathrm{Ind}^{\\mathrm{KP}}_S(\\psi)\\leftrightarrow\n\\exists\\varphi\\in\\mathrm{Fml}_S(\\mathcal L_{\\in})\\;\\exists x,y\\in\\mathrm{Var}_S\\;\n\\Bigl(x\\ne y\\land y\\notin\\mathrm{FV}_{\\mathcal L_{\\in}}(\\varphi)\\land\\mathrm{FreeFor}_{\\mathcal L_\\in}(y,x,\\varphi)\\land\n\\mathrm{UC}_S\\bigl(\\psi,\\ulcorner\n(\\forall x\\,((\\forall y\\in x\\,\\varphi[y/x])\\to\\varphi))\n\\to\\forall x\\,\\varphi\\urcorner\\bigr)\\Bigr).","display":true},{"tex":"\\mathrm{df\\text{-}kripke\\text{-}platek}\\vdash\n\\begin{aligned}\n\\operatorname{KP}={}&\\bigl\\{\n\\ulcorner\\forall x\\,\\forall y\\,((\\forall z\\,(z\\dot\\in x\\leftrightarrow z\\dot\\in y))\\to x\\doteq y)\\urcorner,\\\\\n&\\ulcorner\\exists x\\,\\forall y\\,\\neg(y\\dot\\in x)\\urcorner,\\\\\n&\\ulcorner\\forall x\\,\\forall y\\,\\exists z\\,\\forall a\\,(a\\dot\\in z\\leftrightarrow(a\\doteq x\\lor a\\doteq y))\\urcorner,\\\\\n&\\ulcorner\\forall x\\,\\exists y\\,\\forall z\\,(z\\dot\\in y\\leftrightarrow\\exists a\\,(a\\dot\\in x\\land z\\dot\\in a))\\urcorner\n\\bigr\\}\\\\\n&\\cup\\{\\psi\\in\\mathrm{Sent}_{\\{\\in\\}}:\n\\mathrm{Sep}^{\\mathrm{KP}}_S(\\psi)\\lor\\mathrm{Coll}^{\\mathrm{KP}}_S(\\psi)\\lor\\mathrm{Ind}^{\\mathrm{KP}}_S(\\psi)\\}.\n\\end{aligned}","display":true},{"tex":"L_\\omega","display":false},{"tex":"\\omega","display":false}],"bytes":5245,"backlinks":[{"id":"a3348ed9eb6fb4e3","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\ulcorner\\cdot\\urcorner$、派生联结词、受限量词及 $\\mathrm{UC}_S$ 使用 [[58-df-kripke-platek]] 中的有限公式编码与全称闭包关系；这里只复用语法，不把 KP 公理并入 ZF。"},{"id":"a1e68a0f54b805bf","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{KP}$ 及 $\\mathrm{KP}_{\\mathrm{meta}}$ 使用 [[58-df-kripke-platek]] 的同一公理集合与解码模式。"},{"id":"4cbfb5925afe7f86","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{KP}$、$\\mathrm{Sent}_{\\{\\in\\}}$ 及无穷公理的取舍固定为 [[58-df-kripke-platek]] 中的显式编码；不再把 $\\operatorname{KP}$ 当作可自由选择的理论参数。"},{"id":"4a7daf0e05186250","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{KP}$、$\\mathrm{Sent}_{\\{\\in\\}}$ 及无穷公理的取舍固定为 [[58-df-kripke-platek]] 中的显式编码；不再把 $\\operatorname{KP}$ 当作可自由选择的理论参数。"},{"id":"84daad544872cc71","anchor":"ref-745","locations":["正文"],"count":1,"excerpt":"[[../batch13/58-df-kripke-platek.md|58-df-kripke-platek]]（batch13）"}],"outgoing":["65418b505fc53093","715a32e91161b34f","60d957ce43061cb6"]}