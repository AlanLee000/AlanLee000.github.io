y":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa","display":false},{"tex":"\\operatorname{bad}_{\\mathrm{col}}(\\kappa)=\\kappa","display":false},{"tex":"\\mu=1","display":false},{"tex":"1","display":false},{"tex":"\\mathrm{bad}(\\kappa,\\lambda)","display":false},{"tex":"\\mathrm{bad}_{\\mathrm{fib}}(\\kappa,\\lambda)","display":false}],"bytes":1740,"backlinks":[{"id":"a11585cba9c21cfd","anchor":"ref-299","locations":["正文"],"count":1,"excerpt":"[[58-df-badness-number]]"},{"id":"84daad544872cc71","anchor":"ref-161","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-badness-number.md|58-df-badness-number]]（batch17）"}],"outgoing":["5fb1c2241d1943d1","0fbfc19800246e77","36d7463d215be751","5045d216c83e75cb"]}