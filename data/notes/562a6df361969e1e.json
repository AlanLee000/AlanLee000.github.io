{"id":"562a6df361969e1e","group":"58","path":"58/batch14/58-df-zfc-meas-carath-property.md","title":"ZFC Meas Carath Property","display":"df-zfc-meas-carath-property — ZFC Meas Carath Property","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-meas-carath-property","aliases":["58-df-zfc-meas-carath-property"],"display":"df-zfc-meas-carath-property — ZFC Meas Carath Property","depends_on":["[[../batch05/58-df-outer-measure.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-meas-carath-property"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-meas-carath-property</span></div>"},{"key":"display","html":"df-zfc-meas-carath-property — ZFC Meas Carath Property"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4937f229fe78bb22\" href=\"?note=4937f229fe78bb22\" title=\"../batch05/58-df-outer-measure.md\">../batch05/58-df-outer-measure.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"A,\\mu,X\\in V\">\\(A,\\mu,X\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{OuterMeasure}_S\\subseteq V^2\">\\(\\mathrm{OuterMeasure}_S\\subseteq V^2\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"4937f229fe78bb22\" href=\"?note=4937f229fe78bb22\" title=\"../batch05/58-df-outer-measure.md\">../batch05/58-df-outer-measure.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasCarathProperty}_S\\subseteq V^3\">\\(\\mathrm{ZfcMeasCarathProperty}_S\\subseteq V^3\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}meas\\text{-}carath\\text{-}property} \\vdash\n\\mathrm{ZfcMeasCarathProperty}_S(A,\\mu,X)\\leftrightarrow\n\\mathrm{OuterMeasure}_S(\\mu,X)\\land A\\subseteq X\\land\n\\forall E\\subseteq X\\;(\\mu(E)=\\mu(E\\cap A)+\\mu(E\\setminus A))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}meas\\text{-}carath\\text{-}property} \\vdash\n\\mathrm{ZfcMeasCarathProperty}_S(A,\\mu,X)\\leftrightarrow\n\\mathrm{OuterMeasure}_S(\\mu,X)\\land A\\subseteq X\\land\n\\forall E\\subseteq X\\;(\\mu(E)=\\mu(E\\cap A)+\\mu(E\\setminus A))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch05/58-df-outer-measure.md","status":"resolved","id":"4937f229fe78bb22","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-outer-measure.md]]","embed":false},{"target":"../batch05/58-df-outer-measure.md","status":"resolved","id":"4937f229fe78bb22","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{OuterMeasure}_S\\subseteq V^2$ (see [[../batch05/58-df-outer-measure.md]]).","embed":false}],"math":[{"tex":"A,\\mu,X\\in V","display":false},{"tex":"\\mathrm{OuterMeasure}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcMeasCarathProperty}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}meas\\text{-}carath\\text{-}property} \\vdash\n\\mathrm{ZfcMeasCarathProperty}_S(A,\\mu,X)\\leftrightarrow\n\\mathrm{OuterMeasure}_S(\\mu,X)\\land A\\subseteq X\\land\n\\forall E\\subseteq X\\;(\\mu(E)=\\mu(E\\cap A)+\\mu(E\\setminus A))","display":true}],"bytes":806,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2526","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-meas