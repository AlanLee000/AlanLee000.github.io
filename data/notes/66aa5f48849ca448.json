{"id":"66aa5f48849ca448","group":"58","path":"58/batch01/58-df-zfc-cat2-arrow-category.md","title":"ZFC Cat2 Arrow Category","display":"df-zfc-cat2-arrow-category — ZFC Cat2 Arrow Category","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-cat2-arrow-category","aliases":["58-df-zfc-cat2-arrow-category"],"display":"df-zfc-cat2-arrow-category — ZFC Cat2 Arrow Category","depends_on":["[[../batch02/58-ax-zfc.md]]","[[../batch04/58-df-category.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-cat2-arrow-category"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-cat2-arrow-category</span></div>"},{"key":"display","html":"df-zfc-cat2-arrow-category — ZFC Cat2 Arrow Category"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"a87b7e1119b63b2c\" href=\"?note=a87b7e1119b63b2c\" title=\"../batch04/58-df-category.md\">../batch04/58-df-category.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal C,\\mathcal A\\in V\">\\(\\mathcal C,\\mathcal A\\in V\\)</span> (base category and candidate arrow category)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal C=\\langle O,M,s,t,c,e\\rangle\">\\(\\mathcal C=\\langle O,M,s,t,c,e\\rangle\\)</span> (the category datum used by <a class=\"wiki-link\" id=\"ref-3\" data-note=\"a87b7e1119b63b2c\" href=\"?note=a87b7e1119b63b2c\" title=\"../batch04/58-df-category.md\">../batch04/58-df-category.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"S\">\\(S\\)</span> (set of coded commutative squares)</li>\n<li><span class=\"math-inline\" data-tex=\"s_{\\to},t_{\\to},c_{\\to},e_{\\to}\">\\(s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\)</span> (source, target, composition, and identity graphs constructed below)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Category}_S\">\\(\\mathrm{Category}_S\\)</span> (category predicate, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"a87b7e1119b63b2c\" href=\"?note=a87b7e1119b63b2c\" title=\"../batch04/58-df-category.md\">../batch04/58-df-category.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCat2ArrowCategory}_S\\subseteq V^2\">\\(\\mathrm{ZfcCat2ArrowCategory}_S\\subseteq V^2\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}arrow\\text{-}category}\\vdash\n\\mathrm{ZfcCat2ArrowCategory}_S(\\mathcal A,\\mathcal C)\\\\\n\\leftrightarrow{}&amp;\n\\exists O,M,s,t,c,e,S,s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\in V\\;\\Biggl[\n\\mathcal C=\\langle O,M,s,t,c,e\\rangle\n\\land\\mathrm{Category}_S(\\mathcal C)\\\\\n&amp;\\quad\\land S=\n\\Bigl\\{q\\in(M\\times M)\\times(M\\times M):\n\\exists f,g,u,v\\in M\\;\\bigl(\nq=\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\\\\n&amp;\\hspace{42mm}\\land s(u)=s(f)\\land t(u)=s(g)\n\\land s(v)=t(f)\\land t(v)=t(g)\\\\\n&amp;\\hspace{42mm}\\land c(\\langle v,f\\rangle)=c(\\langle g,u\\rangle)\n\\bigr)\\Bigr\\}\\\\\n&amp;\\quad\\land s_{\\to}=\n\\{\\langle\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle,f\\rangle:\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\\}\\\\\n&amp;\\quad\\land t_{\\to}=\n\\{\\langle\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle,g\\rangle:\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\\}\\\\\n&amp;\\quad\\land e_{\\to}=\n\\Bigl\\{\\bigl\\langle f,\n\\langle\\langle f,f\\rangle,\\langle e(s(f)),e(t(f))\\rangle\\rangle\n\\bigr\\rangle:f\\in M\\Bigr\\}\\\\\n&amp;\\quad\\land c_{\\to}=\n\\Bigl\\{\\Bigl\\langle\n\\bigl\\langle\n\\langle\\langle g,h\\rangle,\\langle u&#39;,v&#39;\\rangle\\rangle,\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\n\\bigr\\rangle,\\\\\n&amp;\\hspace{37mm}\n\\langle\\langle f,h\\rangle,\n\\langle c(\\langle u&#39;,u\\rangle),c(\\langle v&#39;,v\\rangle)\\rangle\\rangle\n\\Bigr\\rangle:\\\\\n&amp;\\hspace{19mm}\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\n\\land\n\\langle\\langle g,h\\rangle,\\langle u&#39;,v&#39;\\rangle\\rangle\\in S\n\\Bigr\\}\\\\\n&amp;\\quad\\land\\mathcal A=\n\\langle M,S,s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\rangle\n\\Biggr].\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}arrow\\text{-}category}\\vdash\n\\mathrm{ZfcCat2ArrowCategory}_S(\\mathcal A,\\mathcal C)\\\\\n\\leftrightarrow{}&amp;\n\\exists O,M,s,t,c,e,S,s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\in V\\;\\Biggl[\n\\mathcal C=\\langle O,M,s,t,c,e\\rangle\n\\land\\mathrm{Category}_S(\\mathcal C)\\\\\n&amp;\\quad\\land S=\n\\Bigl\\{q\\in(M\\times M)\\times(M\\times M):\n\\exists f,g,u,v\\in M\\;\\bigl(\nq=\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\\\\n&amp;\\hspace{42mm}\\land s(u)=s(f)\\land t(u)=s(g)\n\\land s(v)=t(f)\\land t(v)=t(g)\\\\\n&amp;\\hspace{42mm}\\land c(\\langle v,f\\rangle)=c(\\langle g,u\\rangle)\n\\bigr)\\Bigr\\}\\\\\n&amp;\\quad\\land s_{\\to}=\n\\{\\langle\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle,f\\rangle:\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\\}\\\\\n&amp;\\quad\\land t_{\\to}=\n\\{\\langle\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle,g\\rangle:\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\\}\\\\\n&amp;\\quad\\land e_{\\to}=\n\\Bigl\\{\\bigl\\langle f,\n\\langle\\langle f,f\\rangle,\\langle e(s(f)),e(t(f))\\rangle\\rangle\n\\bigr\\rangle:f\\in M\\Bigr\\}\\\\\n&amp;\\quad\\land c_{\\to}=\n\\Bigl\\{\\Bigl\\langle\n\\bigl\\langle\n\\langle\\langle g,h\\rangle,\\langle u&#39;,v&#39;\\rangle\\rangle,\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\n\\bigr\\rangle,\\\\\n&amp;\\hspace{37mm}\n\\langle\\langle f,h\\rangle,\n\\langle c(\\langle u&#39;,u\\rangle),c(\\langle v&#39;,v\\rangle)\\rangle\\rangle\n\\Bigr\\rangle:\\\\\n&amp;\\hspace{19mm}\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\n\\land\n\\langle\\langle g,h\\rangle,\\langle u&#39;,v&#39;\\rangle\\rangle\\in S\n\\Bigr\\}\\\\\n&amp;\\quad\\land\\mathcal A=\n\\langle M,S,s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\rangle\n\\Biggr].\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>An object of <span class=\"math-inline\" data-tex=\"\\mathcal A\">\\(\\mathcal A\\)</span> is an arrow <span class=\"math-inline\" data-tex=\"f\">\\(f\\)</span> of <span class=\"math-inline\" data-tex=\"\\mathcal C\">\\(\\mathcal C\\)</span>; a morphism is coded together with its source and target arrows, so parallel commutative squares are not collapsed.</li>\n<li>All six components of the arrow category are set graphs constructed from the six components of <span class=\"math-inline\" data-tex=\"\\mathcal C\">\\(\\mathcal C\\)</span>; no hidden <span class=\"math-inline\" data-tex=\"\\operatorname{Ob}\">\\(\\operatorname{Ob}\\)</span>, <span class=\"math-inline\" data-tex=\"\\operatorname{Mor}\">\\(\\operatorname{Mor}\\)</span>, or <span class=\"math-inline\" data-tex=\"\\operatorname{Hom}\">\\(\\operatorname{Hom}\\)</span> accessor is used.</li>\n<li>The category laws for the constructed tuple follow componentwise from those of <span class=\"math-inline\" data-tex=\"\\mathcal C\">\\(\\mathcal C\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch04/58-df-category.md","status":"resolved","id":"a87b7e1119b63b2c","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-category.md]]","embed":false},{"target":"../batch04/58-df-category.md","status":"resolved","id":"a87b7e1119b63b2c","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathcal C=\\langle O,M,s,t,c,e\\rangle$ (the category datum used by [[../batch04/58-df-category.md]])","embed":false},{"target":"../batch04/58-df-category.md","status":"resolved","id":"a87b7e1119b63b2c","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Category}_S$ (category predicate, see [[../batch04/58-df-category.md]])","embed":false}],"math":[{"tex":"\\mathcal C,\\mathcal A\\in V","display":false},{"tex":"\\mathcal C=\\langle O,M,s,t,c,e\\rangle","display":false},{"tex":"S","display":false},{"tex":"s_{\\to},t_{\\to},c_{\\to},e_{\\to}","display":false},{"tex":"\\mathrm{Category}_S","display":false},{"tex":"\\mathrm{ZfcCat2ArrowCategory}_S\\subseteq V^2","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}arrow\\text{-}category}\\vdash\n\\mathrm{ZfcCat2ArrowCategory}_S(\\mathcal A,\\mathcal C)\\\\\n\\leftrightarrow{}&\n\\exists O,M,s,t,c,e,S,s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\in V\\;\\Biggl[\n\\mathcal C=\\langle O,M,s,t,c,e\\rangle\n\\land\\mathrm{Category}_S(\\mathcal C)\\\\\n&\\quad\\land S=\n\\Bigl\\{q\\in(M\\times M)\\times(M\\times M):\n\\exists f,g,u,v\\in M\\;\\bigl(\nq=\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\\\\n&\\hspace{42mm}\\land s(u)=s(f)\\land t(u)=s(g)\n\\land s(v)=t(f)\\land t(v)=t(g)\\\\\n&\\hspace{42mm}\\land c(\\langle v,f\\rangle)=c(\\langle g,u\\rangle)\n\\bigr)\\Bigr\\}\\\\\n&\\quad\\land s_{\\to}=\n\\{\\langle\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle,f\\rangle:\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\\}\\\\\n&\\quad\\land t_{\\to}=\n\\{\\langle\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle,g\\rangle:\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\\}\\\\\n&\\quad\\land e_{\\to}=\n\\Bigl\\{\\bigl\\langle f,\n\\langle\\langle f,f\\rangle,\\langle e(s(f)),e(t(f))\\rangle\\rangle\n\\bigr\\rangle:f\\in M\\Bigr\\}\\\\\n&\\quad\\land c_{\\to}=\n\\Bigl\\{\\Bigl\\langle\n\\bigl\\langle\n\\langle\\langle g,h\\rangle,\\langle u',v'\\rangle\\rangle,\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\n\\bigr\\rangle,\\\\\n&\\hspace{37mm}\n\\langle\\langle f,h\\rangle,\n\\langle c(\\langle u',u\\rangle),c(\\langle v',v\\rangle)\\rangle\\rangle\n\\Bigr\\rangle:\\\\\n&\\hspace{19mm}\n\\langle\\langle f,g\\rangle,\\langle u,v\\rangle\\rangle\\in S\n\\land\n\\langle\\langle g,h\\rangle,\\langle u',v'\\rangle\\rangle\\in S\n\\Bigr\\}\\\\\n&\\quad\\land\\mathcal A=\n\\langle M,S,s_{\\to},t_{\\to},c_{\\to},e_{\\to}\\rangle\n\\Biggr].\n\\end{aligned}","display":true},{"tex":"\\mathcal A","display":false},{"tex":"f","display":false},{"tex":"\\mathcal C","display":false},{"tex":"\\mathcal C","display":false},{"tex":"\\operatorname{Ob}","display":false},{"tex":"\\operatorname{Mor}","display":false},{"tex":"\\operatorname{Hom}","display":false},{"tex":"\\mathcal C","display":false}],"bytes":2963,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1572","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-cat2-arrow-category.md|58-df-zfc-cat2-arrow-category]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","a87b7e1119b63b2c"]}