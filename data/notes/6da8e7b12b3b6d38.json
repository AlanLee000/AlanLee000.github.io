and\\operatorname{ev}\\bigl(a_x,(j_f)^\\#_{\\sigma_n,\\sigma_C,n}z_n\\bigr)=1\\\\\n&\\land\\operatorname{ev}\\bigl(a_y,b_f-(j_f)^\\#_{\\sigma_n,\\sigma_C,2n}c\\bigr)=1].\n\\end{aligned}","display":true},{"tex":"b_f","display":false}],"bytes":3913,"backlinks":[{"id":"503d015c67c34259","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$f,n,h,C_f,x,y,\\tau_C\\in V$；$S^k,\\tau_k$、整数系数空间码 $\\sigma(A,\\tau)$ 使用 [[58-df-oriented-cone-generators.md]]。"},{"id":"84daad544872cc71","anchor":"ref-926","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-oriented-cone-generators.md|58-df-oriented-cone-generators]]（batch17）"}],"outgoing":["d2d4ae7a9b4ff171","78ee5e5ffa2f4a64","ca7fc3ab38a11801"]}