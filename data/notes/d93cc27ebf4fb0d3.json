nd\\in^{\\mathfrak A}=\\{\\langle x,y\\rangle\\in A\\times A:x\\in y\\}\\\\\n&\\hspace{42mm}\\land\\forall F\\in\\mathrm{KP}_\\omega\\;(\\mathfrak A\\models F)\\Bigr].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\forall\\alpha\\in\\mathrm{Ord}\\quad\n\\mathrm{AdmOrd}(\\alpha)&\\longleftrightarrow\\mathrm{Adm}(L_\\alpha),\\\\\n\\forall\\alpha\\in\\mathrm{Ord}\\quad\n\\mathrm{AdmOrd}_\\omega(\\alpha)&\\longleftrightarrow\\mathrm{Adm}_\\omega(L_\\alpha).\n\\end{aligned}","display":true},{"tex":"L_\\alpha","display":false}],"bytes":3123,"backlinks":[{"id":"e40f6292323bbb0b","anchor":"ref-130","locations":["正文"],"count":1,"excerpt":"[[./18-df-admissible-set]]"},{"id":"600896e1acca6ba7","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$A$ 是 [[./18-df-admissible-set]] 意义下的可容许集合，$a,b,c\\in A$，$c\\ne\\varnothing$。"},{"id":"100d7af02276fe1b","anchor":"ref-86","locations":["正文"],"count":1,"excerpt":"[[../18-df-admissible-set]]"},{"id":"e29d1100705cdb23","anchor":"ref-6","locations":["正文"],"count":1,"excerpt":"[[../18-df-admissible-set]]"},{"id":"bf01645e59119446","anchor":"ref-3","locations":["正文"],"count":1,"excerpt":"[[../18-df-admissible-set|18-df-admissible-set]]"}],"outgoing":["b63d92760bb408d3","cf95026e035bcb2b","635d9c2a8b21701e","e391b202f09e2f43","9ac3a6265513490d","23419e8036fb68bd"]}