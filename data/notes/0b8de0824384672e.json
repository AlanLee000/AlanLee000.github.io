inline\" data-tex=\"\\varphi\">\\(\\varphi\\)</span>&quot;.</p>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}emptyset} \\vdash \\emptyset \\coloneqq \\iota x\\;(\\forall y\\;(y \\notin x))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}emptyset} \\vdash \\emptyset \\coloneqq \\iota x\\;(\\forall y\\;(y \\notin x))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Remark","text":"[Remark]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"58-ax-ext","status":"resolved","id":"7dd3434f494dba6e","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-ext]]","embed":false},{"target":"58-ax-sep","status":"resolved","id":"d34cdb12ee59812c","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-sep]]","embed":false},{"target":"58-df-iota","status":"resolved","id":"5a745902a8dccfec","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-iota]]","embed":false},{"target":"58-df-iota","status":"resolved","id":"5a745902a8dccfec","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\iota$ (definite-description operator, see [[58-df-iota]])","embed":false}],"math":[{"tex":"\\iota","display":false},{"tex":"\\emptyset","display":false},{"tex":"\\iota","display":false},{"tex":"\\iota x\\,\\varphi","display":false},{"tex":"x","display":false},{"tex":"\\varphi","display":false},{"tex":"\\mathrm{df\\text{-}emptyset} \\vdash \\emptyset \\coloneqq \\iota x\\;(\\forall y\\;(y \\notin x))","display":true}],"bytes":628,"backlinks":[{"id":"b3dac4cf78c440c7","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"aabdf3005231e9dc","anchor":"ref-