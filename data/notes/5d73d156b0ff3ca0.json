{"id":"5d73d156b0ff3ca0","group":"58","path":"58/batch09/58-df-zfc-comb-free-set.md","title":"ZFC Comb Free Set","display":"df-zfc-comb-free-set — ZFC Comb Free Set","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-comb-free-set","aliases":["58-df-zfc-comb-free-set"],"display":"df-zfc-comb-free-set — ZFC Comb Free Set","depends_on":["[[../batch16/58-df-function.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-comb-free-set"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-comb-free-set</span></div>"},{"key":"display","html":"df-zfc-comb-free-set — ZFC Comb Free Set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"H,F \\in V\">\\(H,F \\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCombFreeSet}_S \\subseteq V^2\">\\(\\mathrm{ZfcCombFreeSet}_S \\subseteq V^2\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comb\\text{-}free\\text{-}set} \\vdash \\mathrm{ZfcCombFreeSet}_S(H,F)\\leftrightarrow \\mathrm{Function}(F,\\operatorname{dom}(F),\\operatorname{ran}(F))\\land H\\subseteq\\operatorname{dom}(F)\\land\\forall x\\in H\\;(F(x)\\cap H\\subseteq\\{x\\})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}comb\\text{-}free\\text{-}set} \\vdash \\mathrm{ZfcCombFreeSet}_S(H,F)\\leftrightarrow \\mathrm{Function}(F,\\operatorname{dom}(F),\\operatorname{ran}(F))\\land H\\subseteq\\operatorname{dom}(F)\\land\\forall x\\in H\\;(F(x)\\cap H\\subseteq\\{x\\})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The domain condition ensures that every value <span class=\"math-inline\" data-tex=\"F(x)\">\\(F(x)\\)</span> appearing in the freeness clause is defined.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false}],"math":[{"tex":"H,F \\in V","display":false},{"tex":"\\mathrm{Function}\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcCombFreeSet}_S \\subseteq V^2","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}comb\\text{-}free\\text{-}set} \\vdash \\mathrm{ZfcCombFreeSet}_S(H,F)\\leftrightarrow \\mathrm{Function}(F,\\operatorname{dom}(F),\\operatorname{ran}(F))\\land H\\subseteq\\operatorname{dom}(F)\\land\\forall x\\in H\\;(F(x)\\cap H\\subseteq\\{x\\})","display":true},{"tex":"F(x)","display":false}],"bytes":789,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1640","locations":["正文"],"count":1,"excerpt":"[[../batch09/58-df-zfc-comb-free-set.md|58-df-zfc-comb-free-set]]（batch09）"}],"outgoing":["36d7463d215be751"]}