se},{"tex":"\\Sigma\\subseteq\\mathbb R^3","display":false},{"tex":"\\operatorname{SmoothManifoldStructure}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ImmersionData}_S:V^6\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Homeo}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Injective}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{SmoothEmbedding}_S:V^3\\to\\{\\top,\\bot\\}\\land\\mathrm{MinimalSurface}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\operatorname{PullbackMetric},\\operatorname{LaplaceBeltrami}:V^2\\to V","display":false},{"tex":"\\mathrm{df\\text{-}minimal\\text{-}surface\\text{-}embedding} \\vdash\n\\mathrm{SmoothEmbedding}_S(F,M,\\mathbb R^3)\n\\leftrightarrow\n\\exists\\tau_M,\\mathcal A,D,T_M,T_{\\mathbb R^3}\\in V\\;\\Bigl(\\operatorname{SmoothManifoldStructure}_S(M,\\tau_M,\\mathcal A,2)\\land\\mathrm{ImmersionData}_S(F,M,\\mathbb R^3,D,T_M,T_{\\mathbb R^3})\\land\\mathrm{Injective}(F,M,\\mathbb R^3)\\land\\mathrm{Homeo}_S(F,M,\\tau_M,F[M],\\{U\\cap F[M]:U\\in\\tau_{\\mathrm{Euc}}\\})\\Bigr).","display":true},{"tex":"\\mathrm{df\\text{-}minimal\\text{-}surface\\text{-}metric} \\vdash g_F\\coloneqq\\operatorname{PullbackMetric}(F,g_{\\mathrm{Euc}})","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}minimal\\text{-}surface\\text{-}predicate}\\vdash\n\\mathrm{MinimalSurface}_S(\\Sigma)\\leftrightarrow\n\\exists M,F,g_F\\in V\\;\\Bigl(&\n\\mathrm{SmoothEmbedding}_S(F,M,\\mathbb R^3)\\\\\n&\\land\\Sigma=F[M]\n\\land g_F=\\operatorname{PullbackMetric}(F,g_{\\mathrm{Euc}})\n\\land\\operatorname{LaplaceBeltrami}(g_F,F)=0\n\\Bigr).\n\\end{aligned}","display":true}],"bytes":2875,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-847","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-minimal-surface.md|58-df-minimal-surface]]（batch03）"}],"outgoing":["71fe0dc4c8613e69","7056a4392f2b25e2","c4b4a825f2ea608d","8317eefb4572709e"]}