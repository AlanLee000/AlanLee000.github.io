{"id":"65b5a378dcf758ab","group":"58","path":"58/batch10/58-df-zfc-metric-closed-ball.md","title":"ZFC Metric Closed Ball","display":"df-zfc-metric-closed-ball — ZFC Metric Closed Ball","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-metric-closed-ball","aliases":["58-df-zfc-metric-closed-ball"],"display":"df-zfc-metric-closed-ball — ZFC Metric Closed Ball","depends_on":["[[../batch02/58-ax-zfc.md]]","[[../batch18/58-df-metric.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-metric-closed-ball"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-metric-closed-ball</span></div>"},{"key":"display","html":"df-zfc-metric-closed-ball — ZFC Metric Closed Ball"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"267957a097ff75bf\" href=\"?note=267957a097ff75bf\" title=\"../batch18/58-df-metric.md\">../batch18/58-df-metric.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"B,x,r,X,d\\in V\">\\(B,x,r,X,d\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Metric}_S(d,X)\">\\(\\mathrm{Metric}_S(d,X)\\)</span> is the metric predicate (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"267957a097ff75bf\" href=\"?note=267957a097ff75bf\" title=\"../batch18/58-df-metric.md\">../batch18/58-df-metric.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMetricClosedBall}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcMetricClosedBall}_S:V^5\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}metric\\text{-}closed\\text{-}ball} \\vdash \\mathrm{ZfcMetricClosedBall}_S(B,x,r,X,d)\\leftrightarrow \\mathrm{Metric}_S(d,X)\\land x\\in X\\land r\\in\\mathbb R_{\\geq0}\\land B=\\{y\\in X:d(x,y)\\leq r\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}metric\\text{-}closed\\text{-}ball} \\vdash \\mathrm{ZfcMetricClosedBall}_S(B,x,r,X,d)\\leftrightarrow \\mathrm{Metric}_S(d,X)\\land x\\in X\\land r\\in\\mathbb R_{\\geq0}\\land B=\\{y\\in X:d(x,y)\\leq r\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch18/58-df-metric.md","status":"resolved","id":"267957a097ff75bf","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-metric.md]]","embed":false},{"target":"../batch18/58-df-metric.md","status":"resolved","id":"267957a097ff75bf","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Metric}_S(d,X)$ is the metric predicate (see [[../batch18/58-df-metric.md]])","embed":false}],"math":[{"tex":"B,x,r,X,d\\in V","display":false},{"tex":"\\mathrm{Metric}_S(d,X)","display":false},{"tex":"\\mathrm{ZfcMetricClosedBall}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}metric\\text{-}closed\\text{-}ball} \\vdash \\mathrm{ZfcMetricClosedBall}_S(B,x,r,X,d)\\leftrightarrow \\mathrm{Metric}_S(d,X)\\land x\\in X\\land r\\in\\mathbb R_{\\geq0}\\land B=\\{y\\in X:d(x,y)\\leq r\\}","display":true}],"bytes":802,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2682","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-zfc-metric-closed-ball.md|58-df-zfc-metric-closed-ball]]（batch10）"}],"outgoing":["a3348ed9eb6fb4e3","267957a097ff75bf"]}