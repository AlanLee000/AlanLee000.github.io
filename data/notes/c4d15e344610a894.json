{"id":"c4d15e344610a894","group":"58","path":"58/batch14/58-df-zfc-topo10-open-map.md","title":"ZFC Topo10 Open Map","display":"df-zfc-topo10-open-map — ZFC Topo10 Open Map","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-topo10-open-map","aliases":["58-df-zfc-topo10-open-map"],"display":"df-zfc-topo10-open-map — ZFC Topo10 Open Map","depends_on":["[[58-ax-zfc]]","[[../batch08/58-df-zfc-top2-open-map]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-topo10-open-map"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-topo10-open-map</span></div>"},{"key":"display","html":"df-zfc-topo10-open-map — ZFC Topo10 Open Map"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"1d2e460c633590b1\" href=\"?note=1d2e460c633590b1\" title=\"../batch08/58-df-zfc-top2-open-map\">../batch08/58-df-zfc-top2-open-map</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"f,X,Y,\\tau,\\sigma\\in V\">\\(f,X,Y,\\tau,\\sigma\\in V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop2OpenMap}_S\\subseteq V^5\">\\(\\mathrm{ZfcTop2OpenMap}_S\\subseteq V^5\\)</span> is from <a class=\"wiki-link\" id=\"ref-3\" data-note=\"1d2e460c633590b1\" href=\"?note=1d2e460c633590b1\" title=\"../batch08/58-df-zfc-top2-open-map\">../batch08/58-df-zfc-top2-open-map</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopo10OpenMap}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTopo10OpenMap}_S:V^5\\to\\{\\top,\\bot\\}\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figur