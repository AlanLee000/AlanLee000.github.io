17/58-df-ordinal.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"81cabbac7fa4d75d\" href=\"?note=81cabbac7fa4d75d\" title=\"../batch01/58-df-limitordinal.md\">../batch01/58-df-limitordinal.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,A,\\rho\\in V\">\\(X,\\tau,A,\\rho\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{TopologicalSpace}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\operatorname{TopologicalSpace}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"815e63e5071e7b58\" href=\"?note=815e63e5071e7b58\" title=\"../batch12/58-df-topological-space.md\">../batch12/58-df-topological-space.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopDerivedSet}_S:V^4\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTopDerivedSet}_S:V^4\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"2fe01ef74fdbff59\" href=\"?note=2fe01ef74fdbff59\" title=\"../batch06/58-df-zfc-top-derived-set.md\">../batch06/58-df-zfc-top-derived-set.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ordinal},\\mathrm{LimitOrdinal}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Ordinal},\\mathrm{LimitOrdinal}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"../batch17/58-df-ordinal.md\">../batch17/58-df-ordinal.md</a> and <a class=\"wiki-link\" id=\"ref-10\" data-note=\"81cabbac7fa4d75d\" href=\"?note=81cabbac7fa4d75d\" title=\"../batch01/58-df-limitordinal.md\">../batch01/58-df-limitordinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcDescriptive2CantorBendixsonRank}_S:V^4\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcDescriptive2CantorBendixsonRank}_S:V^4\\to\\{\\top,\\bot\\}\\)</span> (本文件定义)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}cantor\\text{-}bendixson\\text{-}rank} \\vdash \\mathrm{ZfcDescriptive2CantorBendixsonRank}_S(\\rho,A,X,\\tau)\\leftrightarrow \\operatorname{TopologicalSpace}_S(X,\\tau)\\land A\\subseteq X\\land\\mathrm{Ordinal}(\\rho)\\land\\exists D\\in V\\;\\Bigl(\\mathrm{Function}(D,\\rho+2,\\mathcal P(X))\\land D(0)=A\\land\\forall\\beta\\in\\rho+1\\;\\mathrm{ZfcTopDerivedSet}_S(D(\\beta+1),D(\\beta),X,\\tau)\\land\\forall\\lambda\\in\\rho+2\\;(\\mathrm{LimitOrdinal}_S(\\lambda)\\to D(\\lambda)=\\bigcap_{\\beta\\in\\lambda}D(\\beta))\\land D(\\rho)=D(\\rho+1)\\land\\forall\\beta\\in\\rho\\;(D(\\beta)\\neq D(\\beta+1))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}cantor\\text{-}bendixson\\text{-}rank} \\vdash \\mathrm{ZfcDescriptive2CantorBendixsonRank}_S(\\rho,A,X,\\tau)\\leftrightarrow \\operatorname{TopologicalSpace}_S(X,\\tau)\\land A\\subseteq X\\land\\mathrm{Ordinal}(\\rho)\\land\\exists D\\in V\\;\\Bigl(\\mathrm{Function}(D,\\rho+2,\\mathcal P(X))\\land D(0)=A\\land\\forall\\beta\\in\\rho+1\\;\\mathrm{ZfcTopDerivedSet}_S(D(\\beta+1),D(\\beta),X,\\tau)\\land\\forall\\lambda\\in\\rho+2\\;(\\mathrm{LimitOrdinal}_S(\\lambda)\\to D(\\lambda)=\\bigcap_{\\beta\\in\\lambda}D(\\beta))\\land D(\\rho)=D(\\rho+1)\\land\\forall\\beta\\in\\rho\\;(D(\\beta)\\neq D(\\beta+1))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n<li>导数迭代现为集合函数，极限阶段调用上游极限序数谓词；不再用未证明等价的 <span class=\"math-inline\" data-tex=\"\\sup\\lambda=\\lambda\">\\(\\sup\\lambda=\\lambda\\)</span> 充当类型判断。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch12/58-df-topological-space.md","status":"resolved","id":"815e63e5071e7b58","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-topological-space.md]]","embed":false},{"target":"../batch06/58-df-zfc-top-derived-set.md","status":"resolved","id":"2fe01ef74fdbff59","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch06/58-df-zfc-top-derived-set.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch01/58-df-limitordinal.md","status":"resolved","id":"81cabbac7fa4d75d","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch01/58-df-limitordinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch12/58-df-topological-space.md","status":"resolved","id":"815e63e5071e7b58","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operator