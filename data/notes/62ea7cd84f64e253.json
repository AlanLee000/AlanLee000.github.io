-space predicate; see [[58-df-zfc-analysis2-uniform-space]])"},{"id":"84daad544872cc71","anchor":"ref-1456","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-analysis2-uniform-space.md|58-df-zfc-analysis2-uniform-space]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","f96ea0698fd88ab2","33d499f681d88614","f153d56390f34389","1331244a5201bb99"]}