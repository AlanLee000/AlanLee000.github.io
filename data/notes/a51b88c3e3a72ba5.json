f-12","locations":["正文"],"count":1,"excerpt":"[[./18-df-term]]"},{"id":"01ff954c42fa05a6","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Term}_S$ 为 [[18-df-term]] 的有限项树，变量集与 [[18-df-variable]] 相同。"},{"id":"e29d1100705cdb23","anchor":"ref-104","locations":["正文"],"count":1,"excerpt":"[[../18-df-term]]"}],"outgoing":["ca728af2af9b9d11","adee8e90809320b8"]}