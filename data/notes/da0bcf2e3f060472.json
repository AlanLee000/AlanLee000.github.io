\mathrm{PartialFunction}(h,\\omega^{n+1},\\omega)\\\\\n&\\land f=\\left\\{\\langle\\vec x^\\frown\\langle t\\rangle,y\\rangle:\\vec x\\in\\omega^{n-1}\\land t,y\\in\\omega\\land\n\\exists s\\in\\omega^{t+1}\\;\\left(\\langle\\vec x,s(0)\\rangle\\in g\\land s(t)=y\\land\n\\forall j\\in t\\;\\langle\\vec x^\\frown\\langle j,s(j)\\rangle,s(j+1)\\rangle\\in h\\right)\\right\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{PRecClosed}_{58}(C)\\leftrightarrow{}&\nC\\subseteq\\{f\\in\\bigcup_{n\\in\\omega}\\mathcal P(\\omega^n\\times\\omega):\\exists n\\in\\omega\\;\\mathrm{PartialFunction}(f,\\omega^n,\\omega)\\}\\\\\n&\\land\\forall n\\in\\omega\\;\\forall f\\in\\omega^{\\omega^n}\\;(\\mathrm{PrimitiveRecursive}_S(f,n)\\to f\\in C)\\\\\n&\\land\\forall n,m\\in\\omega\\;\\forall h\\in C\\;\\forall\\vec g\\in C^m\\;\\Bigl(\n\\mathrm{PartialFunction}(h,\\omega^m,\\omega)\\land\\forall i\\in m\\;\\mathrm{PartialFunction}(\\vec g(i),\\omega^n,\\omega)\\\\\n&\\qquad\\to\\{\\langle\\vec x,y\\rangle\\in\\omega^n\\times\\omega:\\exists\\vec z\\in\\omega^m\\;\n(\\forall i\\in m\\;\\langle\\vec x,\\vec z(i)\\rangle\\in\\vec g(i))\\land\\langle\\vec z,y\\rangle\\in h\\}\\in C\\Bigr)\\\\\n&\\land\\forall n\\in\\omega\\setminus\\{0\\}\\;\\forall g,h\\in C\\;\\forall f\\in V\\;\n(\\mathrm{PartialPrimitiveRecursion}_{58}(f,g,h,n)\\to f\\in C)\\\\\n&\\land\\forall k\\in\\omega\\;\\forall g\\in C\\;\\forall f\\in V\\;\n(\\mathrm{PartialMinimization}_S(f,g,k)\\to f\\in C).\n\\end{aligned}","display":true},{"tex":"\\mathrm{SeqPRec}_{58}\\coloneqq\n\\bigcap\\{C\\subseteq\\bigcup_{n\\in\\omega}\\mathcal P(\\omega^n\\times\\omega):\\mathrm{PRecClosed}_{58}(C)\\}.","display":true},{"tex":"\\mathrm{pRec}\\coloneqq\\mathrm{SeqPRec}_{58}\\cup\n\\{\\mathrm{UnaryGraph}_{58}(f):f\\in\\mathrm{SeqPRec}_{58}\\land\\mathrm{PartialFunction}(f,\\omega^1,\\omega)\\}.","display":true},{"tex":"\\mathrm{Rec}\\coloneqq\n\\{f\\in\\mathrm{pRec}:\\mathrm{Function}(f,\\omega,\\omega)\\lor\\ex