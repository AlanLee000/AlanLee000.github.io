:"\\mathbb{R}^{2n}","display":false},{"tex":"\\omega = \\sum dp_i \\wedge dq_i","display":false},{"tex":"\\dot{x} = H_H(x)","display":false},{"tex":"\\omega","display":false},{"tex":"H","display":false},{"tex":"\\geq","display":false}],"bytes":2515,"backlinks":[{"id":"2f16ebe8bfe4558f","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{Symplectic}_S$ (symplectic predicate, see [[../batch16/58-df-symplectic.md]])"},{"id":"84daad544872cc71","anchor":"ref-1280","locations":["正文"],"count":1,"excerpt":"[[../batch16/58-df-symplectic.md|58-df-symplectic]]（batch16）"}],"outgoing":["71fe0dc4c8613e69","db62358c2ba471b0","cd9981d8428c2629"]}