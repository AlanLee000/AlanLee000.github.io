).\n\\end{aligned}","display":true}],"bytes":2186,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-343","locations":["正文"],"count":2,"excerpt":"[[56-thm-disjoint-union-termination-criterion.md]]"}],"outgoing":["73130ab4ebcdfb39","8133fc32a2cf7026","a0c9e286170288bf"]}