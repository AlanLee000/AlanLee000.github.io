2-forcing-poset.md</a> and <a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ProjectionMap}_S\\subseteq V^7\">\\(\\mathrm{ProjectionMap}_S\\subseteq V^7\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}projection\\text{-}map} \\vdash\n\\mathrm{ProjectionMap}_S(\\pi,\\mathbb P,\\leq_P,1_P,\\mathbb Q,\\leq_Q,1_Q)\\leftrightarrow\n\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb P,\\leq_P,1_P)\\land\n\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb Q,\\leq_Q,1_Q)\\land\n\\mathrm{Function}(\\pi,\\mathbb P,\\mathbb Q)\\land\\pi(1_P)=1_Q\\land\n\\forall p&#39;,p\\in\\mathbb P\\;\\bigl(\\langle p&#39;,p\\rangle\\in\\leq_P\\to\n\\langle\\pi(p&#39;),\\pi(p)\\rangle\\in\\leq_Q\\bigr)\\land\n\\forall p\\in\\mathbb P\\;\\forall q\\in\\mathbb Q\\;\\bigl(\n\\langle q,\\pi(p)\\rangle\\in\\leq_Q\\to\\exists p&#39;\\in\\mathbb P\\;\\bigl(\n\\langle p&#39;,p\\rangle\\in\\leq_P\\land\\langle\\pi(p&#39;),q\\rangle\\in\\leq_Q\\bigr)\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}projection\\text{-}map} \\vdash\n\\mathrm{ProjectionMap}_S(\\pi,\\mathbb P,\\leq_P,1_P,\\mathbb Q,\\leq_Q,1_Q)\\leftrightarrow\n\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb P,\\leq_P,1_P)\\land\n\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb Q,\\leq_Q,1_Q)\\land\n\\mathrm{Function}(\\pi,\\mathbb P,\\mathbb Q)\\land\\pi(1_P)=1_Q\\land\n\\forall p&#39;,p\\in\\mathbb P\\;\\bigl(\\langle p&#39;,p\\rangle\\in\\leq_P\\to\n\\langle\\pi(p&#39;),\\pi(p)\\rangle\\in\\leq_Q\\bigr)\\land\n\\forall p\\in\\mathbb P\\;\\forall q\\in\\mathbb Q\\;\\bigl(\n\\langle q,\\pi(p)\\rangle\\in\\leq_Q\\to\\exists p&#39;\\in\\mathbb P\\;\\bigl(\n\\langle p&#39;,p\\rangle\\in\\leq_P\\land\\langle\\pi(p&#39;),q\\rang