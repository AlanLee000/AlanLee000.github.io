ons":["元数据 · depends_on","正文"],"count":2,"excerpt":"$k\\in\\mathbb N_{\\ge1}$，$t_a:\\mathbb N\\to\\mathbb N_{\\ge1}$，$t_a(n)=(n+2)^a$，$a\\in\\mathbb N_{\\ge1}$；$\\mathbf{ATIME}_\\exists(t,k)$、$\\mathbf{ATIME}_\\forall(t,k)$ 见 [[28-df-atm]]，$k$ 计非停机状态的交替块数。"}],"outgoing":["e6357334ccd3589d","599727eea07e91d7","6b648ff230619ba2","256220eba4eba968","b5d4fc2d291ce98b"]}