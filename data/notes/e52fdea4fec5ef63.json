.","display":true},{"tex":"\\mathsf f=\\{\\mathsf F\\},\\quad\n\\mathsf t=\\{\\mathsf T\\},\\quad\n\\bot=\\varnothing,\\quad\n\\top=\\{\\mathsf T,\\mathsf F\\}.","display":true},{"tex":"a\\le_t b","display":true},{"tex":"(\\mathsf T\\in a\\Rightarrow \\mathsf T\\in b)\n\\quad\\text{且}\\quad\n(\\mathsf F\\in b\\Rightarrow \\mathsf F\\in a).","display":true},{"tex":"a\\le_k b","display":true},{"tex":"a\\subseteq b.","display":true},{"tex":"a\\wedge_t b=\n((a\\cap b)\\cap\\{\\mathsf T\\})\n\\cup((a\\cup b)\\cap\\{\\mathsf F\\}),","display":true},{"tex":"a\\vee_t b=\n((a\\cup b)\\cap\\{\\mathsf T\\})\n\\cup((a\\cap b)\\cap\\{\\mathsf F\\}),","display":true},{"tex":"a\\wedge_k b=a\\cap b,\n\\qquad\na\\vee_k b=a\\cup b.","display":true},{"tex":"\\neg a=\\{\\mathsf T:\\mathsf F\\in a\\}\\cup\\{\\mathsf F:\\mathsf T\\in a\\}.","display":true},{"tex":"D_{\\mathsf{Gin}}=\\{a\\in\\mathsf{G4}:\\mathsf T\\in a\\}.","display":true},{"tex":"v:\\mathsf{Prop}\\to\\mathsf{G4}","display":false},{"tex":"⟦\\operatorname{atom}(p)⟧_v^{\\mathsf{Gin}}=v(p),","display":true},{"tex":"⟦\\operatorname{false}⟧_v^{\\mathsf{Gin}}=\\mathsf f,\n\\quad\n⟦\\operatorname{true}⟧_v^{\\mathsf{Gin}}=\\mathsf t,","display":true},{"tex":"⟦\\operatorname{neg}(A)⟧_v^{\\mathsf{Gin}}\n=\\neg⟦ A⟧_v^{\\mathsf{Gin}},","display":true},{"tex":"⟦\\operatorname{tmeet}(A,B)⟧_v^{\\mathsf{Gin}}\n=⟦ A⟧_v^{\\mathsf{Gin}}\\wedge_t\n⟦ B⟧_v^{\\mathsf{Gin}},","display":true},{"tex":"⟦\\operatorname{tjoin}(A,B)⟧_v^{\\mathsf{Gin}}\n=⟦ A⟧_v^{\\mathsf{Gin}}\\vee_t\n⟦ B⟧_v^{\\mathsf{Gin}},","display":true},{"tex":"⟦\\operatorname{kmeet}(A,B)⟧_v^{\\mathsf{Gin}}\n=⟦ A⟧_v^{\\mathsf{Gin}}\\wedge_k\n⟦ B⟧_v^{\\mathsf{Gin}},","display":true},{"tex":"⟦\\operatorname{kjoin}(A,B)⟧_v^{\\mathsf{Gin}}\n=⟦ A⟧_v^{\\mathsf{Gin}}\\vee_k\n⟦ B⟧_v^{\\mathsf{Gin}}.","display":true},{"tex":"\\mathsf{Valid}_{\\mathsf{Gin}}\n=\n\\{A\\in\\mathsf{Fm}_{\\mathsf{Gin}}:\n\\forall v:\\mathsf{Prop}\\to\\mathsf{G4}\\,\n⟦ A⟧_v^{\\mathsf{Gin}}\\in D_{\\mathsf{Gin}}\