peratorname{app}(\\operatorname{app}(\\operatorname{comb}(C),X),Y),Z),\n\\operatorname{app}(\\operatorname{app}(X,Z),Y)):X,Y,Z\\in\\mathsf{Tm}_{CL}\\},","display":true},{"tex":"\\mathsf{Red}_{CL,W}\n=\n\\{(\\operatorname{app}(\\operatorname{app}(\\operatorname{comb}(W),X),Y),\n\\operatorname{app}(\\operatorname{app}(X,Y),Y)):X,Y\\in\\mathsf{Tm}_{CL}\\}.","display":true},{"tex":"\\to^0_{CL}\n=\n\\mathsf{Red}_{CL,K}\\cup\\mathsf{Red}_{CL,S}\\cup\\mathsf{Red}_{CL,I}\n\\cup\\mathsf{Red}_{CL,B}\\cup\\mathsf{Red}_{CL,C}\\cup\\mathsf{Red}_{CL,W}.","display":true},{"tex":"\\mathsf{RedCtx}_{CL}","display":false},{"tex":"\\operatorname{hole}_{CL}\\in\\mathsf{RedCtx}_{CL}","display":false},{"tex":"C\\in\\mathsf{RedCtx}_{CL}","display":false},{"tex":"P\\in\\mathsf{Tm}_{CL}","display":false},{"tex":"\\operatorname{appL}_{CL}(C,P)\\in\\mathsf{RedCtx}_{CL}","display":false},{"tex":"P\\in\\mathsf{Tm}_{CL}","display":false},{"tex":"C\\in\\mathsf{RedCtx}_{CL}","display":false},{"tex":"\\operatorname{appR}_{CL}(P,C)\\in\\mathsf{RedCtx}_{CL}","display":false},{"tex":"\\operatorname{plug}_{CL}:\\mathsf{RedCtx}_{CL}\\times\\mathsf{Tm}_{CL}\\to\\mathsf{Tm}_{CL}","display":true},{"tex":"\\operatorname{plug}_{CL}(\\operatorname{hole}_{CL},M)=M,","display":true},{"tex":"\\operatorname{plug}_{CL}(\\operatorname{appL}_{CL}(C,P),M)\n=\\operatorname{app}(\\operatorname{plug}_{CL}(C,M),P),","display":true},{"tex":"\\operatorname{plug}_{CL}(\\operatorname{appR}_{CL}(P,C),M)\n=\\operatorname{app}(P,\\operatorname{plug}_{CL}(C,M)).","display":true},{"tex":"\\to_{CL}\n=\n\\{(\\operatorname{plug}_{CL}(C,M),\\operatorname{plug}_{CL}(C,N)):\nC\\in\\mathsf{RedCtx}_{CL},\\ M\\to^0_{CL}N\\}.","display":true},{"tex":"\\mathsf{Rule}_{CL}\n=\n\\{(\\langle M\\rangle,N):M\\to_{CL}N\\}\n\\cup\n\\{(\\langle M\\rangle,N):N\\to_{CL}M\\}\n\\cup\n\\{(\\langle M\\rangle,N):M\\equiv_\\alpha N\\}.","display":true},{"tex":"\\mathsf{AxJdg}_{CL}=\\{\\operatorname{var}(x):x\\in\\mathsf{Var}_{CL}\\}\\cup\\{\\operatorname{comb}(c):c\\in\\mathsf{Comb}_{CL}\\}.","display":true},{"tex":"\\mathsf{Der}_{CL}\n=\n\\{(M_0,\\ldots,M_{n-1}):n>0,\\forall i<n\\ M_i\\in\\mathsf{Tm}_{CL},\n\\forall i+1<n\\ ((\\langle M_i\\rangle,M_{i+1})\\in\\mathsf{Rule}_{CL})\\}.","display":true},{"tex":"\\mathsf{Delta}_{CL}=(\\operatorname{comb}(S),\\operatorname{comb}(K),\\operatorname{comb}(I),\\operatorname{comb}(B),\\operatorname{comb}(C),\\operatorname{comb}(W),\\to^0_{CL}).","display":true},{"tex":"M\\Rightarrow^*_{CL}N","display":true},{"tex":"n>0","display":false},{"tex":"(M_0,\\ldots,M_{n-1})\\in\\mathsf{Tm}_{CL}^{n}","display":false},{"tex":"M_0=M,\\qquad M_{n-1}=N,","display":true},{"tex":"M_i\\to_{CL}M_{i+1}","display":false},{"tex":"i+1<n","display":false},{"tex":"M=_{CL}N","display":true},{"tex":"\\pi\\in\\mathsf{Der}_{CL}","display":false},{"tex":"M","display":false},{"tex":"N","display":false},{"tex":"\\to^0_{CL}\\subseteq\\mathsf{Tm}_{CL}\\times\\mathsf{Tm}_{CL},\n\\quad\n\\to_{CL}\\subseteq\\mathsf{Tm}_{CL}\\times\\mathsf{Tm}_{CL},\n\\quad\n\\mathsf{Der}_{CL}\\subseteq\\mathsf{Tm}_{CL}^{<\\omega}.","display":true},{"tex":"\\pi\\in\\mathsf{Der}_{CL}","display":false},{"tex":"i","display":false},{"tex":"M=_{CL}N","display":false},{"tex":"\\alpha","display":false},{"tex":"\\equiv_\\alpha^{CL}\n=\n\\{(M,M):M\\in\\mathsf{Tm}_{CL}\\},\n\\qquad\n\\equiv_\\alpha=\\equiv_\\alpha^{CL}.","display":true},{"tex":"\\operatorname{src}_{CL}(M_0,\\ldots,M_{n-1})=M_0,\n\\qquad\n\\operatorname{tgt}_{CL}(M_0,\\ldots,M_{n-1})=M_{n-1}.","display":true},{"tex":"M=_{CL}N\n\\iff\n\\exists\\pi\\in\\mathsf{Der}_{CL}\\ \n(\\operatorname{src}_{CL}(\\pi)=M\\land\\operatorname{tgt}_{CL}(\\pi)=N),","display":true},{"tex":"\\mathcal{CL}=(\\mathsf{Var}_{CL},\\mathsf{Comb}_{CL},\\mathsf{Tm}_{CL},\\operatorname{FV}_{CL},\\operatorname{BV}_{CL},\\operatorname{Sub}_{CL},\\equiv_\\alpha^{CL},\\mathsf{AxJdg}_{CL},\\mathsf{Delta}_{CL},\\mathsf{RedCtx}_{CL},\\operatorname{plug}_{CL},\\mathsf{Red}_{CL,K},\\mathsf{Red}_{CL,S},\\mathsf{Red}_{CL,I},\\mathsf{Red}_{CL,B},\\mathsf{Red}_{CL,C},\\mathsf{Red}_{CL,W},\\to^0_{CL},\\to_{CL},\\mathsf{Rule}_{CL},\\Rightarrow^*_{CL},\\mathsf{Der}_{CL},\\operatorname{src}_{CL},\\operatorname{tgt}_{CL},=_{CL}).","display":true},{"tex":"S,K,I,B,C,W","display":false},{"tex":"\\lambda","display":false}],"bytes":7263,"backlinks":[],"outgoing":[]}