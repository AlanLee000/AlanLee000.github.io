n,x_n)\\rangle,\\psi)","display":false},{"tex":"\\mathrm{QFree}(\\psi)","display":false},{"tex":"x_1,\\ldots,x_n","display":false},{"tex":"Q_i\\in\\{\\forall,\\exists\\}","display":false},{"tex":"\\vec z","display":false},{"tex":"\\mathrm{free}(\\varphi)","display":false},{"tex":"\\vec y_i=\\langle x_j:1\\le j<i\\land Q_j=\\forall\\rangle","display":false},{"tex":"\\vec y=\\langle x_j:1\\le j\\le n\\land Q_j=\\forall\\rangle","display":false},{"tex":"\\vec e=\\langle i:1\\le i\\le n\\land Q_i=\\exists\\rangle","display":false},{"tex":"i\\in\\operatorname{ran}(\\vec e)","display":false},{"tex":"F_{\\varphi,i}\\notin S","display":false},{"tex":"r_i=|\\vec z|+|\\vec y_i|","display":false},{"tex":"r_i=0","display":false},{"tex":"\\mathrm{All}(\\vec y,\\psi)","display":false},{"tex":"\\mathrm{ExVar}(\\varphi)","display":false},{"tex":"\\mathrm{Sk}(\\varphi)","display":false},{"tex":"\\varphi^{\\mathrm{Sk}}","display":false},{"tex":"S_\\varphi^{\\mathrm{Sk}}","display":false},{"tex":"\\begin{aligned}\nS_\\varphi^{\\mathrm{Sk}}&\\coloneqq S\\cup\\{F_{\\varphi,i}:i\\in\\operatorname{ran}(\\vec e)\\},\\\\\n\\mathrm{Const}_{S_\\varphi^{\\mathrm{Sk}}}&\\coloneqq\\mathrm{Const}_S\\cup\\{F_{\\varphi,i}:i\\in\\operatorname{ran}(\\vec e)\\land r_i=0\\},\\\\\n\\mathrm{Func}_k(S_\\varphi^{\\mathrm{Sk}})&\\coloneqq\\mathrm{Func}_k(S)\\cup\\{F_{\\varphi,i}:i\\in\\operatorname{ran}(\\vec e)\\land r_i=k\\}\\quad(k\\ge1),\\\\\n\\mathrm{Rel}_k(S_\\varphi^{\\mathrm{Sk}})&\\coloneqq\\mathrm{Rel}_k(S)\\quad(k\\in\\mathbb N),\\\\\nt_i&\\coloneqq\\begin{cases}F_{\\varphi,i},&r_i=0,\\\\F_{\\varphi,i}(\\vec z,\\vec y_i),&r_i\\ge1,\\end{cases}\\\\\n\\varphi^{\\mathrm{Sk}}&\\coloneqq\n\\mathrm{All}(\\vec y,\\psi[t_{e_1}/x_{e_1},\\ldots,t_{e_p}/x_{e_p}])\\quad(p=|\\vec e|),\\\\\n\\mathrm{Sk}(\\varphi)&\\coloneqq\\varphi^{\\mathrm{Sk}},\\qquad\n\\mathrm{ExVar}(\\varphi)=\\{x_i:1\\le i\\le n\\land Q_i=\\exists\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{Func}_0(S_\\varphi^{\\mathrm{Sk}})\\c