y":false},{"tex":"\\operatorname{Ordinal}\\subseteq V^{1}","display":false},{"tex":"\\mathrm{ZfcForcing2ForcingPoset}_S\\subseteq V^{3}","display":false},{"tex":"\\mathrm{ZfcForcing4DistributiveForcing}_S\\subseteq V^{4}","display":false},{"tex":"\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P},\\kappa\\in V","display":false},{"tex":"\\operatorname{Ordinal}:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcForcing2ForcingPoset}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{DenseOpenFamily}_S","display":false},{"tex":"\\mathrm{OpenDenseSubset}_S","display":false},{"tex":"\\operatorname{Function}","display":false},{"tex":"\\mathrm{ZfcForcing4DistributiveForcing}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}forcing4\\text{-}distributive\\text{-}forcing}\\vdash\n\\mathrm{ZfcForcing4DistributiveForcing}_S(\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P},\\kappa)\n\\leftrightarrow{}&\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P})\\land\\operatorname{Ordinal}(\\kappa)\\\\\n&\\land\\forall\\lambda\\in\\kappa\\;\\forall D\\in V\\;\\Bigl(\n\\operatorname{Function}(D,\\lambda,\\mathcal P(\\mathbb P))\n\\land\\mathrm{DenseOpenFamily}_S(\\operatorname{ran}(D),\\mathbb P,\\leq_{\\mathbb P})\\\\\n&\\hspace{105pt}\\to\\mathrm{OpenDenseSubset}_S\\!\\left(\\{p\\in\\mathbb P:\\forall\\alpha\\in\\lambda\\;(p\\in D(\\alpha))\\},\\mathbb P,\\leq_{\\mathbb P}\\right)\n\\Bigr).\n\\end{aligned}","display":true}],"bytes":2350,"backlinks":[{"id":"ba0eba9b7a6d29a1","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcForcing4DistributiveForcing}_S:V^4\\to\\{\\top,\\bot\\}$ (see [[58-df-zfc-forcing4-distributive-forcing]])"},{"id":"84daad544872cc71","anchor":"ref-2090","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-zfc-forcing4-distributive-forcing.md|58-df-zfc-forcing4-distributive-forcing]]（batch19）"}],"outgoing":["a3348ed9eb6fb4e3","55