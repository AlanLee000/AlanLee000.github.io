{"id":"1cced22492f9b3a4","group":"58","path":"58/batch18/58-df-zfc-prob4-conditional-probability.md","title":"ZFC Prob4 Conditional Probability","display":"df-zfc-prob4-conditional-probability — ZFC Prob4 Conditional Probability","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-prob4-conditional-probability","aliases":["58-df-zfc-prob4-conditional-probability"],"display":"df-zfc-prob4-conditional-probability — ZFC Prob4 Conditional Probability","depends_on":["[[58-ax-zfc]]","[[../batch13/58-df-measure.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-prob4-conditional-probability"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-prob4-conditional-probability</span></div>"},{"key":"display","html":"df-zfc-prob4-conditional-probability — ZFC Prob4 Conditional Probability"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"../batch13/58-df-measure.md\">../batch13/58-df-measure.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\Omega,\\mathcal F,\\mathbb P,A,B,p\\in V\">\\(\\Omega,\\mathcal F,\\mathbb P,A,B,p\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Measure}_S\">\\(\\mathrm{Measure}_S\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"../batch13/58-df-measure.md\">../batch13/58-df-measure.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProb4ConditionalProbability}_S\\subseteq V^6\">\\(\\mathrm{ZfcProb4ConditionalProbability}_S\\subseteq V^6\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}prob4\\text{-}conditional\\text{-}probability} \\vdash \\mathrm{ZfcProb4ConditionalProbability}_S(\\Omega,\\mathcal F,\\mathbb P,A,B,p)\\leftrightarrow \\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land A,B\\in\\mathcal F\\land\\mathbb P(B)&gt;0\\land p\\in[0,1]\\land p=\\mathbb P(A\\cap B)/\\mathbb P(B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}prob4\\text{-}conditional\\text{-}probability} \\vdash \\mathrm{ZfcProb4ConditionalProbability}_S(\\Omega,\\mathcal F,\\mathbb P,A,B,p)\\leftrightarrow \\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land A,B\\in\\mathcal F\\land\\mathbb P(B)&gt;0\\land p\\in[0,1]\\land p=\\mathbb P(A\\cap B)/\\mathbb P(B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch13/58-df-measure.md","status":"resolved","id":"ca832ed6bc22f728","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-measure.md]]","embed":false},{"target":"../batch13/58-df-measure.md","status":"resolved","id":"ca832ed6bc22f728","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Measure}_S$ (see [[../batch13/58-df-measure.md]])","embed":false}],"math":[{"tex":"\\Omega,\\mathcal F,\\mathbb P,A,B,p\\in V","display":false},{"tex":"\\mathrm{Measure}_S","display":false},{"tex":"\\mathrm{ZfcProb4ConditionalProbability}_S\\subseteq V^6","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}prob4\\text{-}conditional\\text{-}probability} \\vdash \\mathrm{ZfcProb4ConditionalProbability}_S(\\Omega,\\mathcal F,\\mathbb P,A,B,p)\\leftrightarrow \\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land A,B\\in\\mathcal F\\land\\mathbb P(B)>0\\land p\\in[0,1]\\land p=\\mathbb P(A\\cap B)/\\mathbb P(B)","display":true}],"bytes":1004,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3190","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-prob4-conditional-probability.md|58-df-zfc-prob4-conditional-probability]]（batch18）"}],"outgoing":["a3348ed9eb6fb4e3","ca832ed6bc22f728"]}