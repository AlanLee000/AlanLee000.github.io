orner\\varphi\\urcorner})\\}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\Delta\\vdash^{S}_{\\rm Int}\\varphi\\quad\\coloneqq\\quad\nS\\vdash\\left[\\bigwedge_{\\delta\\in\\Delta}T(\\overline{\\ulcorner\\delta\\urcorner})\\to T(\\overline{\\ulcorner\\varphi\\urcorner})\\right].\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\Delta\\vdash^{S}_{\\rm Int}\\varphi\\quad\\coloneqq\\quad\nS\\vdash\\left[\\bigwedge_{\\delta\\in\\Delta}T(\\overline{\\ulcorner\\delta\\urcorner})\\to T(\\overline{\\ulcorner\\varphi\\urcorner})\\right].\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>第一式是原书使用的 internal logic：被理论证明为真的句子集。第二式是本目录保留的有限后承扩展。\n内部逻辑与对象理论的普通定理集不同；KF 的外部演绎是经典的，真理内部不证明所有经典有效句。</p>\n<p>来源：§20.2，印刷页 281–285，PDF 页 292–296。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"91-df-coded-syntax","status":"resolved","id":"38c875c58a0bf84c","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[91-df-coded-syntax]]","embed":false}],"math":[{"tex":"S","display":false},{"tex":"T","display":false},{"tex":"\\Delta\\subseteq_{\\rm fin}\\mathrm{Sent}_{\\mathcal L_T}","display":false},{"tex":"\\top","display":false},{"tex":"\\mathrm{df\\text{-}internal\\text{-}logic}\\vdash\\quad\n\\operatorname{Log}_{\\rm Int}(S)\\coloneqq\\{\\varphi\\in\\mathrm{Sent}_{\\mathcal L_T}:S\\vdash T(\\overline{\\ulcorner\\varphi\\urcorner})\\}.","display":true},{"tex":"\\Delta\\vdash^{S}_{\\rm Int}\\varphi\\quad\\coloneqq\\quad\nS\\vdash\\left[\\bigwedge_{\\delta\\in\\Delta}T(\\overline{\\ulcorner\\delta\\urcorner})\\to T(\\overline{\\ulcorner\\varphi\\urcorner})\\right].","display":true}],"bytes":1211,"bac