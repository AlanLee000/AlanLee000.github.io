subseteq\\omega","display":false},{"tex":"\\mathrm{df\\text{-}cylinder}\\vdash\n\\operatorname{Cylinder}(A)\\Longleftrightarrow\\forall B\\subseteq\\omega\\ [B\\le_m A\\Rightarrow B\\le_1 A].","display":true}],"bytes":967,"backlinks":[{"id":"4c42b7b0a71a7e77","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-index-set]]；see [[20-df-cylinder]]；see [[20-lem-padding]]。"},{"id":"b1a3c18aaa9b0194","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-cylinder]]；see [[20-df-m-one-degrees]]；see [[20-df-pairing]]。"}],"outgoing":["d5dada982b721c80","1f15de2c66c6318e"]}