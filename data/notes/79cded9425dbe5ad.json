{"id":"79cded9425dbe5ad","group":"58","path":"58/batch14/58-df-zfc-fun-bijective-function.md","title":"ZFC Fun Bijective Function","display":"df-zfc-fun-bijective-function — ZFC Fun Bijective Function","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-fun-bijective-function","aliases":["58-df-zfc-fun-bijective-function"],"display":"df-zfc-fun-bijective-function — ZFC Fun Bijective Function","depends_on":["[[../batch18/58-df-bijective.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-fun-bijective-function"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-fun-bijective-function</span></div>"},{"key":"display","html":"df-zfc-fun-bijective-function — ZFC Fun Bijective Function"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"d583890235faf0d5\" href=\"?note=d583890235faf0d5\" title=\"../batch18/58-df-bijective.md\">../batch18/58-df-bijective.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"f,X,Y\\in V\">\\(f,X,Y\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Bijective}\\subseteq V^3\">\\(\\mathrm{Bijective}\\subseteq V^3\\)</span> is the bijection predicate (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"d583890235faf0d5\" href=\"?note=d583890235faf0d5\" title=\"../batch18/58-df-bijective.md\">../batch18/58-df-bijective.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcFunBijectiveFunction}_S\\subseteq V^3\">\\(\\mathrm{ZfcFunBijectiveFunction}_S\\subseteq V^3\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}fun\\text{-}bijective\\text{-}function} \\vdash\n\\mathrm{ZfcFunBijectiveFunction}_S(f,X,Y)\\leftrightarrow\\mathrm{Bijective}(f,X,Y)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}fun\\text{-}bijective\\text{-}function} \\vdash\n\\mathrm{ZfcFunBijectiveFunction}_S(f,X,Y)\\leftrightarrow\\mathrm{Bijective}(f,X,Y)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Compatibility alias for the canonical bijection predicate.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch18/58-df-bijective.md","status":"resolved","id":"d583890235faf0d5","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-bijective.md]]","embed":false},{"target":"../batch18/58-df-bijective.md","status":"resolved","id":"d583890235faf0d5","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Bijective}\\subseteq V^3$ is the bijection predicate (see [[../batch18/58-df-bijective.md]]).","embed":false}],"math":[{"tex":"f,X,Y\\in V","display":false},{"tex":"\\mathrm{Bijective}\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcFunBijectiveFunction}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}fun\\text{-}bijective\\text{-}function} \\vdash\n\\mathrm{ZfcFunBijectiveFunction}_S(f,X,Y)\\leftrightarrow\\mathrm{Bijective}(f,X,Y)","display":true}],"bytes":776,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2125","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-fun-bijective-function.md|58-df-zfc-fun-bijective-function]]（batch14）"}],"outgoing":["d583890235faf0d5"]}