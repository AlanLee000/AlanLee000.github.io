f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Poset}(P,\\leq_P)\">\\(\\mathrm{Poset}(P,\\leq_P)\\)</span>（poset predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>）</li>\n<li><span class=\"math-inline\" data-tex=\"G\\subseteq P\">\\(G\\subseteq P\\)</span> (filter or generic set parameter)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal D\\subseteq\\mathcal P(P)\">\\(\\mathcal D\\subseteq\\mathcal P(P)\\)</span> (family of subsets of <span class=\"math-inline\" data-tex=\"P\">\\(P\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Dense}(D,P,\\leq_P)\">\\(\\mathrm{Dense}(D,P,\\leq_P)\\)</span> (order-density predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"681e6314e26cdd0b\" href=\"?note=681e6314e26cdd0b\" title=\"../batch10/58-df-dense.md\">../batch10/58-df-dense.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{DenseMeetingFamily}_S\\subseteq V^4\">\\(\\mathrm{DenseMeetingFamily}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}dense\\text{-}meeting\\text{-}family} \\vdash \\mathrm{DenseMeetingFamily}_S(G,\\mathcal D,P,\\leq_P) \\leftrightarrow \\mathrm{Poset}(P,\\leq_P)\\land G\\subseteq P\\land\\mathcal D\\subseteq\\mathcal P(P)\\land\\forall D\\in\\mathcal D\\;(\\mathrm{Dense}(D,P,\\leq_P)\\land G\\cap D\\neq\\emptyset)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}dense\\text{-}meeting\\text{-}family} \\vdash \\mathrm{DenseMeetingFamily}_S(G,\\mathcal D,P,\\leq_P) \\leftrightarrow \\mathrm{Poset}(P,\\leq_P)\\land G\\subseteq P\\land\\mathcal D\\subseteq\\mathcal P(P)\\land\\forall D\\in\\mathcal D\\;(\\mathrm{Dense}(D,P,\\leq_P)\\land G\\cap D\\neq\\emptyset)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch10/58-df-dense.md","status":"resolved","id":"681e6314e26cdd0b","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch10/58-df-dense.md]]","embed":false},{"target":"../batch08/58-df-family.md","status":"resolved","id":"545b51e7aa011030","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-family.md]]","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-poset.md]]","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$(P,\\leq_P)$ (forcing poset, see [[../batch02/58-df-poset.md]])","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Poset}(P,\\leq_P)$（poset predicate, see [[../batch02/58-df-poset.md]]）","embed":false},{"target":"../batch10/58-df-dense.md","status":"resolved","id":"681e6314e26cdd0b","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Dense}(D,P,\