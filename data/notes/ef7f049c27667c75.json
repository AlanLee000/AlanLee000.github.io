oolFunc}_n\\mid\\exists x\\in\\mathbb B^n\\;(f(x)=1)\\}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Equivalently, <span class=\"math-inline\" data-tex=\"T(f)\\neq\\emptyset\">\\(T(f)\\neq\\emptyset\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"27-df-boolfunc","status":"resolved","id":"5d10aed668d85817","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[27-df-boolfunc]]","embed":false},{"target":"27-df-boolfunc","status":"resolved","id":"5d10aed668d85817","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$n\\in\\mathbb N$；$\\mathrm{BoolFunc}_n$ 见 [[27-df-boolfunc]]。$\\mathrm{SAT}$ 是在此固定元数下定义的函数子集。","embed":false}],"attachments":[],"math":[{"tex":"n\\in\\mathbb N","display":false},{"tex":"\\mathrm{BoolFunc}_n","display":false},{"tex":"\\mathrm{SAT}","display":false},{"tex":"\\mathrm{SAT}\\coloneqq\\{f\\in\\mathrm{BoolFunc}_n\\mid\\exists x\\in\\mathbb B^n\\;(f(x)=1)\\}.","display":true},{"tex":"T(f)\\neq\\emptyset","display":false}],"bytes":668,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-329","locations":["正文"],"count":1,"excerpt":"[[27-df-sat|df-sat — Satisfiable Boolean function]]"},{"id":"0ee1778d4ef5367b","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{SAT}$ (satisfiable Boolean functions, see [[27-df-sat]])"}],"outgoing":["5d10aed668d85817"]}