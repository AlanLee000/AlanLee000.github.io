abel=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>注册项与四个实际完全性入口统一，继承其完整证明未逐式核验的限制。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"29-df-standard-inputs","status":"resolved","id":"4563061cac782dab","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-df-standard-inputs]]","embed":false},{"target":"29-df-first-order-reduction","status":"resolved","id":"65b448b4269ca18e","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-df-first-order-reduction]]","embed":false},{"target":"29-thm-reach-d-l-complete","status":"resolved","id":"e33d8f1b508c3705","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-thm-reach-d-l-complete]]","embed":false},{"target":"29-thm-reach-nl-complete","status":"resolved","id":"b2a4804023516b8f","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-thm-reach-nl-complete]]","embed":false},{"target":"29-thm-reach-a-p-complete","status":"resolved","id":"240580939d1fd13a","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-thm-reach-a-p-complete]]","embed":false},{"target":"29-thm-qsat-pspace-complete","status":"resolved","id":"3c678e2ee71047b3","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-thm-qsat-pspace-complete]]","embed":false},{"target":"29-df-first-order-reduction","status":"resolved","id":"65b448b4269ca18e","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\leq_{\\mathrm{fo,std}}$ 及 $\\mathrm L_{\\mathrm{std}},\\mathrm{NL}_{\\mathrm{std}},\\mathrm P_{\\mathrm{std}},\\mathrm{PSPACE}_{\\mathrm{std}}$ 见 [[29-df-first-order-reduction]]、[[29-df-standard-inputs]]。","embed":false},{"target":"29-df-st