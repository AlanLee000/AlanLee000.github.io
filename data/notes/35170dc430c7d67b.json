\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}full\\text{-}subcategory} \\vdash \\mathrm{ZfcCat2FullSubcategory}_S(\\mathcal D,\\mathcal C)\\leftrightarrow \\mathrm{Category}_S(\\mathcal D)\\land\\mathrm{Category}_S(\\mathcal C)\\land\\exists O_C,M_C,s_C,t_C,\\star_C,\\iota_C,O_D,M_D,s_D,t_D,\\star_D,\\iota_D\\in V\\;\\Bigl(\\mathcal C=(O_C,M_C,s_C,t_C,\\star_C,\\iota_C)\\land\\mathcal D=(O_D,M_D,s_D,t_D,\\star_D,\\iota_D)\\land O_D\\subseteq O_C\\land M_D=\\{f\\in M_C:s_C(f)\\in O_D\\land t_C(f)\\in O_D\\}\\land s_D=s_C\\upharpoonright M_D\\land t_D=t_C\\upharpoonright M_D\\land\\forall A\\in O_D\\;(\\iota_D(A)=\\iota_C(A))\\land\\forall f,g\\in M_D\\;(s_D(g)=t_D(f)\\to\\star_D(g,f)=\\star_C(g,f))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}full\\text{-}subcategory} \\vdash \\mathrm{ZfcCat2FullSubcategory}_S(\\mathcal D,\\mathcal C)\\leftrightarrow \\mathrm{Category}_S(\\mathcal D)\\land\\mathrm{Category}_S(\\mathcal C)\\land\\exists O_C,M_C,s_C,t_C,\\star_C,\\iota_C,O_D,M_D,s_D,t_D,\\star_D,\\iota_D\\in V\\;\\Bigl(\\mathcal C=(O_C,M_C,s_C,t_C,\\star_C,\\iota_C)\\land\\mathcal D=(O_D,M_D,s_D,t_D,\\star_D,\\iota_D)\\land O_D\\subseteq O_C\\land M_D=\\{f\\in M_C:s_C(f)\\in O_D\\land t_C(f)\\in O_D\\}\\land s_D=s_C\\upharpoonright M_D\\land t_D=t_C\\upharpoonright M_D\\land\\forall A\\in O_D\\;(\\iota_D(A)=\\iota_C(A))\\land\\forall f,g\\in M_D\\;(s_D(g)=t_D(f)\\to\\star_D(g,f)=\\star_C(g,f))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-a