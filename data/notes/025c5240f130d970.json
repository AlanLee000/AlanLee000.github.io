\\{a(\\langle x,b\\rangle):b\\in B\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}betti\\text{-}numbers\\text{-}rational\\text{-}complex}\\vdash{}&\n\\mathrm{RationalChainComplex}_S(C,+,d,\\odot)\\\\\n\\leftrightarrow{}&\n\\mathrm{ChainComplex}_S(C,+,d)\\\\\n&\\land\\forall q\\in\\mathbb Z\\;\n\\mathrm{VectorSpace}_S(C(q),\\mathbb Q,+(q),\\odot(q),\n+_{\\mathbb Q},\\cdot_{\\mathbb Q},0_{\\mathbb Q},1_{\\mathbb Q})\\\\\n&\\land\\forall q\\in\\mathbb Z\\;\\forall r\\in\\mathbb Q\\;\\forall x\\in C(q)\\;\nd(q)\\bigl(\\odot(q)(\\langle r,x\\rangle)\\bigr)\n=\\odot(q-1)(\\langle r,d(q)(x)\\rangle).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}betti\\text{-}numbers\\text{-}homology\\text{-}structure}\\vdash{}&\n\\mathrm{HomologyVectorStructure}_S(\\mathcal H,n,C,+,d,\\odot)\\\\\n\\leftrightarrow{}&\n\\mathrm{RationalChainComplex}_S(C,+,d,\\odot)\\land n\\in\\mathbb Z\\\\\n&\\land\\exists Z,B,H,+_H,\\odot_H,0_H,z\\in V\\;\\Bigl[\nZ=\\mathrm{CycleGroup}_S(n;C,+,d)\n\\land B=\\mathrm{BoundaryGroup}_S(n;C,d)\n\\land H=\\{\\mathrm{BettiCoset}_{58}(x,B,+(n)):x\\in Z\\}\\\\\n&\\qquad\\land\\mathrm{ZeroElement}_S(z,C(n),+(n))\n\\land0_H=\\mathrm{BettiCoset}_{58}(z,B,+(n))\\\\\n&\\qquad\\land+_H=\n\\{\\langle\\langle\\mathrm{BettiCoset}_{58}(x,B,+(n)),\\mathrm{BettiCoset}_{58}(y,B,+(n))\\rangle,\\mathrm{BettiCoset}_{58}(+(n)(\\langle x,y\\rangle),B,+(n))\\rangle:x,y\\in Z\\}\\\\\n&\\qquad\\land\\odot_H=\n\\{\\langle\\langle r,\\mathrm{BettiCoset}_{58}(x,B,+(n))\\rangle,\\mathrm{BettiCoset}_{58}(\\odot(n)(\\langle r,x\\rangle),B,+(n))\\rangle:r\\in\\mathbb Q,\\ x\\in Z\\}\\\\\n&\\qquad\\land\\mathrm{VectorSpace}_S(H,\\mathbb Q,+_H,\\odot_H,\n+_{\\mathbb Q},\\cdot_{\\mathbb Q},0_{\\mathbb Q},1_{\\mathbb Q})\\\\\n&\\qquad\\land\\mathcal H=\n\\langle H,\\mathbb Q,+_H,\\odot_H,+_{\\mathbb Q},\\cdot_{\\mathbb Q},\n0_{\\mathbb Q},1_{\\mathbb Q},0_H\\rangle\\Bigr].\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\t