orcingPoset}_S(\\mathbb P,R,1_{\\mathbb P})\\\\\n&\\quad\\land\\varphi_{\\mathrm{stat}}\\in\\mathrm{Fml}_S(\\mathcal L_\\in)\n\\land\\operatorname{FV}_{\\mathcal L_\\in}(\\varphi_{\\mathrm{stat}})\\subseteq\\{v_0,v_1\\}\\\\\n&\\quad\\land\\exists\\mathcal M,\\operatorname{Val},\\operatorname{Sat},s,\n\\widehat A,\\widehat\\kappa,\\vec\\tau\\in V\\;\\Bigl(\n\\mathrm{Univ}(\\mathcal M)=M\n\\land I^{\\mathcal M}_{\\mathrm{rel},2}(\\dot\\in)\n=\\{a\\in M^2:a(0)\\in a(1)\\}\\\\\n&\\qquad\\land\\mathrm{Satisfaction}_S(\\mathcal M,\\mathcal L_\\in,\\operatorname{Val},\\operatorname{Sat})\n\\land\\mathrm{Assign}(\\mathcal M,s)\n\\land s(v_0)=A\\land s(v_1)=\\kappa\n\\land\\operatorname{Sat}(\\varphi_{\\mathrm{stat}},s)\\\\\n&\\qquad\\land\\widehat A,\\widehat\\kappa\\in M\n\\land\\mathrm{ZfcForcingCanonicalCheckName}_S\n(\\widehat A,A,\\mathbb P,R,1_{\\mathbb P})\n\\land\\mathrm{ZfcForcingCanonicalCheckName}_S\n(\\widehat\\kappa,\\kappa,\\mathbb P,R,1_{\\mathbb P})\\\\\n&\\qquad\\land\\mathrm{Function}(\\vec\\tau,2,M)\n\\land\\vec\\tau(0)=\\widehat A\\land\\vec\\tau(1)=\\widehat\\kappa\n\\land\\mathrm{ZfcForcingRelation}_S\n(M,1_{\\mathbb P},\\varphi_{\\mathrm{stat}},\\vec\\tau,\\mathbb P,R)\n\\Bigr).\n\\end{aligned}","display":true}],"bytes":3802,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3135","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-preserves-stationary.md|58-df-zfc-preserves-stationary]]（batch03）"}],"outgoing":["b802c3dd76418d95","a3348ed9eb6fb4e3","66d43bb76d055059","d3f859dbdd37f018","36d7463d215be751","65418b505fc53093","715a32e91161b34f","64f35ba2e87964e0","8b6a90316aad78a4","d9b8711cda3f31ca","911508dbd8495663","b5833df5ef175153","fb43b1e2c83c0e1a"]}