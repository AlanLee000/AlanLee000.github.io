\operatorname{Disc}_\\mu(f)}\\right\\rceil.","display":true}],"bytes":1985,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-344","locations":["正文"],"count":1,"excerpt":"[[28-df-communication-matrix]]、[[28-lem-protocol-leaf-rectangle]]、[[28-thm-communication-rank-lower-bound]]、[[28-df-discrepancy]]、[[28-thm-discrepancy-communication-bound]]、[[28-df-number-on-forehead]]。"}],"outgoing":["e0da4f753f223026","05ae51253c88d36f","fec568b8ee2173ba","58c74e9d605c12da"]}