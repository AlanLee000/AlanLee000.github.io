5DenseSet}_S(e[X],\\tau_e,e[X]\\cap\\Sigma(\\Gamma))\\Bigr)","display":true},{"tex":"e[X]","display":false}],"bytes":2930,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3744","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-zfc-topo9-valdivia-compactum.md|58-df-zfc-topo9-valdivia-compactum]]（batch11）"}],"outgoing":["a3348ed9eb6fb4e3","3639c3f839b6c954","890a8458fc69d8c7","694a41b0cb75249b","855dfa27460aa1ec","5260a5349d0b732f","36d7463d215be751","3b5b3d48ff1ff369","2be08d4ee8aa1590"]}