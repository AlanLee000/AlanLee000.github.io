 a\\in\\vec s:P(a)\\rangle$ 保留原列次序和满足 $P$ 的各次出现。$\\mathrm{And},\\mathrm{Or}$ 见 [[57-df-universal-closure]]，下式只对非空列使用它们。","embed":false}],"math":[{"tex":"\\varphi\\in\\mathrm{PropFml}_S","display":false},{"tex":"v^*","display":false},{"tex":"\\mathrm{Lit}_S","display":false},{"tex":"\\frown","display":false},{"tex":"\\langle a\\in\\vec s:P(a)\\rangle","display":false},{"tex":"P","display":false},{"tex":"\\mathrm{And},\\mathrm{Or}","display":false},{"tex":"U","display":false},{"tex":"A","display":false},{"tex":"\\vec p=A(\\varphi)","display":false},{"tex":"k=|\\vec p|\\ge1","display":false},{"tex":"r","display":false},{"tex":"0,\\ldots,2^k-1","display":false},{"tex":"i<k","display":false},{"tex":"\\langle E_r:r<2^k\\land P(r)\\rangle","display":false},{"tex":"r","display":false},{"tex":"\\mathrm{CNF}(\\varphi)","display":false},{"tex":"\\psi\\in\\mathrm{CNF}","display":false},{"tex":"\\begin{aligned}\nU(\\langle\\rangle)&\\coloneqq\\langle\\rangle,\\\\\nU(\\langle a\\rangle\\frown\\vec s)&\\coloneqq\\langle a\\rangle\\frown U(\\langle b\\in\\vec s:b\\ne a\\rangle),\\\\\nA(P)&\\coloneqq\\langle P\\rangle\\quad(P\\in\\mathrm{AtFml}_S),\\\\\nA(\\neg\\psi)&\\coloneqq A(\\psi),\\\\\nA(\\psi\\circ\\theta)&\\coloneqq U(A(\\psi)\\frown A(\\theta))\n\\quad(\\circ\\in\\{\\land,\\lor,\\to,\\leftrightarrow\\}).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\nb_{k,r}(i)&\\coloneqq\\left\\lfloor r/2^{k-1-i}\\right\\rfloor\\bmod2,\\\\\nv_{\\varphi,r}(P)&\\coloneqq\n\\begin{cases}b_{k,r}(i),&P=p_i\\ (i<k),\\\\0,&P\\notin\\{p_i:i<k\\},\\end{cases}\\\\\nC_{\\varphi,r}&\\coloneqq\\mathrm{Or}(\\langle L_i:i<k\\rangle),\\qquad\nL_i\\coloneqq\\begin{cases}p_i,&b_{k,r}(i)=0,\\\\\\neg p_i,&b_{k,r}(i)=1,\\end{cases}\\\\\n\\vec C_\\varphi&\\coloneqq\\langle C_{\\varphi,r}:r<2^k\\land v_{\\varphi,r}^*(\\varphi)=0\\rangle,\\\\\n\\mathrm{CNF}(\\varphi)&\\coloneqq\n\\begin{cases}\\mathrm{And}(\\vec C_\\varphi),&|\\vec C_\\varphi|>0,\\\\p_0\\lor\\neg p_0,&|\\vec C_\\varphi|=0.\\end{cases