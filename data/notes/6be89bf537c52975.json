html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\Omega,\\mathcal F,\\mathbb P,\\mathcal A,\\mathcal B,\\mathcal C\\in V\">\\(\\Omega,\\mathcal F,\\mathbb P,\\mathcal A,\\mathcal B,\\mathcal C\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{MeasureSpace}_S(\\Omega,\\mathcal F,\\mathbb P)\">\\(\\mathrm{MeasureSpace}_S(\\Omega,\\mathcal F,\\mathbb P)\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathbb P(\\Omega)=1\">\\(\\mathbb P(\\Omega)=1\\)</span> (probability-space condition, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"83a15c7e9b3817dc\" href=\"?note=83a15c7e9b3817dc\" title=\"../batch12/58-df-measure-space.md\">../batch12/58-df-measure-space.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{SigmaAlgebra}(\\mathcal A,\\Omega)\">\\(\\operatorname{SigmaAlgebra}(\\mathcal A,\\Omega)\\)</span>, <span class=\"math-inline\" data-tex=\"\\operatorname{SigmaAlgebra}(\\mathcal B,\\Omega)\">\\(\\operatorname{SigmaAlgebra}(\\mathcal B,\\Omega)\\)</span>, and <span class=\"math-inline\" data-tex=\"\\operatorname{SigmaAlgebra}(\\mathcal C,\\Omega)\">\\(\\operatorname{SigmaAlgebra}(\\mathcal C,\\Omega)\\)</span> (sigma-algebra predicates, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"../batch07/58-df-sigma-algebra.md\">../batch07/58-df-sigma-algebra.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProbConditionalExpectation}_S\\subseteq V^4\">\\(\\mathrm{ZfcProbConditionalExpectation}_S\\subseteq V^4\\)</span> (conditional-expectation predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"d139c8e88761c759\" href=\"?note=d139c8e88761c759\" title=\"../batch09/58-df-zfc-prob-conditional-expectation.md\">../batch09/58-df-zfc-prob-conditional-expectation.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure8ConditionalIndependence}_S\\subseteq V^6\">\\(\\mathrm{ZfcMeasure8ConditionalIndependence}_S\\subseteq V^6\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure8\\text{-}conditional\\text{-}independence} \\vdash \\mathrm{ZfcMeasure8ConditionalIndependence}_S(\\Omega,\\mathcal F,\\mathbb P,\\mathcal A,\\mathcal B,\\mathcal C)\\leftrightarrow \\mathrm{MeasureSpace}_S(\\Omega,\\mathcal F,\\mathbb P)\\land \\mathbb P(\\Omega)=1\\land \\mathcal A\\subseteq\\mathcal F\\land \\mathcal B\\subseteq\\mathcal F\\land \\mathcal C\\subseteq\\mathcal F\\land \\operatorname{SigmaAlgebra}(\\mathcal A,\\Omega)\\land \\operatorname{SigmaAlgebra}(\\mathcal B,\\Omega)\\land \\operatorname{SigmaAlgebra}(\\mathcal C,\\Omega)\\land \\forall A\\in\\mathcal A\\;\\forall B\\in\\mathcal B\\;\\exists u\\exists v\\exists w\\;(\\mathrm{ZfcProbConditionalExpectation}_S(w,1_{A\\cap B},\\mathcal C,\\mathbb P)\\land \\mathrm{ZfcProbConditionalExpectation}_S(u,1_A,\\mathcal C,\\mathbb P)\\land \\mathrm{ZfcProbConditionalExpectation}_S(v,1_B,\\mathcal C,\\mathbb P)\\land \\mathbb P(\\{x\\in\\Omega:w(x)\\ne u(x)v(x)\\})=0)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure8\\text{-}conditional\\text{-}independence} \\vdash \\mathrm{ZfcMeasure8ConditionalIndependence}_S(\\Omega,\\mathcal F,\\mathbb P,\\mathcal A,\\mathcal B,\\mathcal C)\\leftrightarrow \\mathrm{MeasureSpace}_S(\\Omega,\\mathcal F,\\mathbb P)\\land \\mathbb P(\\Omega)=1\\land \\mathcal A\\subseteq\\mathcal F\\land \\mathcal B\\subseteq\\mathcal F\\land \\mathcal C\\subseteq\\mathcal F\\land \\operatorname{SigmaAlgebra}(\\mathcal A,\\Omega)\\land \\operatorname{SigmaAlgebra}(\\mathcal B,\\Omega)\\land \\operatorname{SigmaAlgebra}(\\mathcal C,\\Omega)\\land \\forall A\\in\\mathcal A\\;\\forall B\\in\\mathcal B\\;\\exists u\\exists v\\exists w\\;(\\mathrm{ZfcProbConditionalExpectation}_S(w,1_{A\\cap B},\\mathcal C,\\mathbb P)\\land \\mathrm{ZfcProbConditionalExpectation}_S(u,1_A,\\mathcal C,\\mathbb P)\\land \\mathrm{ZfcProbConditionalExpectation}_S(v,1_B,\\mathcal C,\\mathbb P)\\land \\mathbb P(\\{x\\in\\Omega:w(x)\\ne u(x)v(x)\\})=0)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary probability definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-sigma-algebra.md]]","embed":false},{"target":"../batch12/58-df-measure-space.md","status":"resolved","id":"83a15c7e9b3817dc","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-measure-space.md]]","embed":false},{"target":"../batch09/58-df-zfc-prob-conditional-expectation.md","status":"resolved","id":"d139c8e88761c759","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch09/58-df-zfc-prob-conditional-expectation.md]]","embed":false},{"target":"../batch12/58-df-measure-space.md","status":"resolved","id":"83a15c7e9b3817dc","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{MeasureSpace}_S(\\Omega,\\mathcal F,\\mathbb P)$ and $\\mathbb P(\\Omega)=1$ (probability-space condition, see [[../batch12/58-df-measure-space.md]])","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-6","targetAnchor":"","location":"正文","heading"