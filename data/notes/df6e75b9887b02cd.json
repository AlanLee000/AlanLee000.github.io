splay":false},{"tex":"(E, \\phi)","display":false},{"tex":"\\phi: E \\to E \\otimes K","display":false},{"tex":"\\mu","display":false},{"tex":"\\deg(E)","display":false},{"tex":"M(r, d)","display":false},{"tex":"\\mu","display":false}],"bytes":4207,"backlinks":[{"id":"76afa90dfcbc1c79","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Semistable}_{\\mu,S}:V^4\\to\\{\\top,\\bot\\}$ (slope-semistability predicate, see [[../batch11/58-df-slope.md]])"},{"id":"84daad544872cc71","anchor":"ref-1189","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-slope.md|58-df-slope]]（batch11）"}],"outgoing":["71c5426cce937ee1","13f5e356bc6a9655","8ee356c2b76fa7ec"]}