cal F}(i)\\;\\left(\n\\vec\\pi(i)^{-1}[A]\\in\\mathcal F\\land\\mu(\\vec\\pi(i)^{-1}[A])=\\vec\\mu(i)(A)\\right).\n\\end{aligned}","display":true}],"bytes":2973,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2657","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-zfc-measure8-projective-limit-measure.md|58-df-zfc-measure8-projective-limit-measure]]（batch05）"}],"outgoing":["a3348ed9eb6fb4e3","ca832ed6bc22f728","a740bdad87b97ac6","36d7463d215be751","e61c089fc5e610a6"]}