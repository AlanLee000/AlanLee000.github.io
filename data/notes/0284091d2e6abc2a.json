{Term}_{HST}\\to\\mathsf{Term}_{HST},","display":true},{"tex":"\\operatorname{SubTerm}_{HST}(\\operatorname{var}(y),x,t)=\n\\begin{cases}t,&y=x,\\\\ \\operatorname{var}(y),&y\\ne x.\n\\end{cases}","display":true},{"tex":"\\operatorname{Sub}_{HST}:\\mathsf{Frm}_{HST}\\times\\mathsf{Var}_{HST}\\times\\mathsf{Term}_{HST}\\to\\mathsf{Frm}_{HST},","display":true},{"tex":"(u\\doteq v)[x:=t]=(u[x:=t]\\doteq v[x:=t]),\\quad\n(u\\in v)[x:=t]=(u[x:=t]\\in v[x:=t]),","display":true},{"tex":"S(u)[x:=t]=S(u[x:=t]),\\quad I(u)[x:=t]=I(u[x:=t]),\\quad F(u)[x:=t]=F(u[x:=t]),","display":true},{"tex":"\\bot[x:=t]=\\bot,\\quad(\\neg A)[x:=t]=\\neg(A[x:=t]),\\quad(A\\to C)[x:=t]=(A[x:=t]\\to C[x:=t]).","display":true},{"tex":"(\\forall y\\,A)[x:=t]=\n\\begin{cases}\n\\forall y\\,A,&y=x,\\\\\n\\forall y\\,(A[x:=t]),&y\\ne x\\ \\text{且}\\ y\\notin\\operatorname{FVTerm}_{HST}(t),\\\\\n\\forall z\\,((A[y:=z])[x:=t]),&y\\ne x\\ \\text{且}\\ y\\in\\operatorname{FVTerm}_{HST}(t),\n\\end{cases}","display":true},{"tex":"z=\\operatorname{fresh}(\\operatorname{FV}_{HST}(A)\\cup\\operatorname{FVTerm}_{HST}(t)\\cup\\{x,y\\})","display":false},{"tex":"\\equiv_{\\alpha}^{HST}","display":false},{"tex":"E","display":false},{"tex":"E","display":false},{"tex":"S,I,F","display":false},{"tex":"\\bot,\\neg,\\to,\\forall","display":false},{"tex":"\\operatorname{fresh}","display":false},{"tex":"\\operatorname{fresh}_{HST}","display":false},{"tex":"\\bot","display":false},{"tex":"\\operatorname{BV}_{HST}(\\neg A)=\\operatorname{BV}_{HST}(A),\n\\quad\n\\operatorname{BV}_{HST}(A\\to C)=\\operatorname{BV}_{HST}(A)\\cup\\operatorname{BV}_{HST}(C),","display":true},{"tex":"\\operatorname{BV}_{HST}(\\forall x\\,A)=\\operatorname{BV}_{HST}(A)\\cup\\{x\\}.","display":true},{"tex":"\\mathsf{Ax}_{Log}^{HST}","display":false},{"tex":"\\{A\\to(C\\to A):A,C\\in\\mathsf{Frm}_{HST}\\},","display":true},{"tex":"\\{(A\\to(C\\to D))\\to((A\\to C)\\to(A\\to D)):A,C,D\\in\\mathsf{Frm}_{HST}\\},","display":true},{"tex":"\\{((\\neg 