,+_D\\in V^{\\mathbb Z}\\;\\Bigl(\n\\mathrm{ZfcAlgebra2ChainMap}_S(f,C,+_C,d_C,D,+_D,d_D)\\\\\n&\\qquad\\land\\forall n\\in\\mathbb Z\\;\\exists h\\in V\\;\\bigl(\n\\mathrm{InducedHomologyMap}_S(h,f,n,C,+_C,d_C,D,+_D,d_D)\\\\\n&\\qquad\\qquad\\land\\mathrm{Bijective}\\bigl(h,\\mathsf H_n(C,+_C,d_C),\\mathsf H_n(D,+_D,d_D)\\bigr)\\bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"H_n(f)","display":false}],"bytes":2712,"backlinks":[{"id":"ddf55dc38efa1e78","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{HomologyIso}_S:V^5\\to\\{\\top,\\bot\\}$ (see [[../batch14/58-df-isomorphism-inhomology.md]])"},{"id":"84daad544872cc71","anchor":"ref-707","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-isomorphism-inhomology.md|58-df-isomorphism-inhomology]]（batch14）"}],"outgoing":["c3537edf2017d84e","76a17cf51da75e1a","d583890235faf0d5","36d7463d215be751"]}