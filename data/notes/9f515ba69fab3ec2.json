on)\\quad(n\\in\\mathbb N),\\qquad\n\\operatorname d_{R_0}(c_n)=n\\quad(n\\in\\mathbb N),","display":true},{"tex":"\\operatorname{LStep}_{R_0}(c_n,(\\epsilon,a,a))=c_{n+1},\\qquad\n\\operatorname{Deg}_{R_0}(c_n,(\\epsilon,a,a))=(\\nu,c_n),\\qquad\n\\operatorname{PatternDeg}_{R_0}(c_n,(\\epsilon,a,a))=\\{(\\epsilon,c_n)\\},\\qquad\n\\left|\\{\\{(\\epsilon,c_n)\\}\\mid n\\in\\mathbb N\\}\\right|=\\aleph_0.","display":true}],"bytes":2798,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-162","locations":["正文"],"count":2,"excerpt":"[[56-ex-levy-family-duplication.md]]"}],"outgoing":["866869e983c8003f","3cc19c9ea2cdfd7f"]}