 V\">\\(M,H,\\theta,\\delta\\in V\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathfrak M_\\in,\\mathfrak H_\\in\">\\(\\mathfrak M_\\in,\\mathfrak H_\\in\\)</span> are their pure membership structures.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{HereditarySizeClass}_S\">\\(\\mathrm{HereditarySizeClass}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\prec_{\\mathcal L_\\in}\">\\(\\prec_{\\mathcal L_\\in}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Cardinal}_S\">\\(\\mathrm{Cardinal}_S\\)</span>, and <span class=\"math-inline\" data-tex=\"\\approx\">\\(\\approx\\)</span> are as in <a class=\"wiki-link\" id=\"ref-5\" data-note=\"b4c8e863bb75986f\" href=\"?note=b4c8e863bb75986f\" title=\"./58-df-zfc-hereditary-size-class.md\">58-df-zfc-hereditary-size-class.md</a>, <a class=\"wiki-link\" id=\"ref-6\" data-note=\"faf104362ffe13b3\" href=\"?note=faf104362ffe13b3\" title=\"../batch08/58-df-elementary-substructure.md\">../batch08/58-df-elementary-substructure.md</a>, <a class=\"wiki-link\" id=\"ref-7\" data-note=\"5fb1c2241d1943d1\" href=\"?note=5fb1c2241d1943d1\" title=\"../batch11/58-df-cardinal.md\">../batch11/58-df-cardinal.md</a>, and <a class=\"wiki-link\" id=\"ref-8\" data-note=\"28c79fde9f892bfe\" href=\"?note=28c79fde9f892bfe\" title=\"../batch01/58-df-equinumerous.md\">../batch01/58-df-equinumerous.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{DeltaApproximatedBy}_S\\subseteq V^3\">\\(\\mathrm{DeltaApproximatedBy}_S\\subseteq V^3\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{GuessedBy}_S\\subseteq V^2\">\\(\\mathrm{GuessedBy}_S\\subseteq V^2\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcModelGuessingModel}_S\\subseteq V^3\">\\(\\mathrm{ZfcModelGuessingModel}_S\\subseteq V^3\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}model\\text{-}delta\\text{-}approximation}\\vdash\n\\mathrm{DeltaApproximatedBy}_S(X,M,\\delta)\\leftrightarrow\nX\\subseteq M\\land\\forall a\\in M\\;\\Bigl(\n\\exists\\alpha\\in\\delta\\;(a\\approx\\alpha)\\to X\\cap a\\in M\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}model\\text{-}delta\\text{-}approximation}\\vdash\n\\mathrm{DeltaApproximatedBy}_S(X,M,\\delta)\\leftrightarrow\nX\\subseteq M\\land\\forall a\\in M\\;\\Bigl(\n\\exists\\alpha\\in\\delta\\;(a\\approx\\alpha)\\to X\\cap a\\in M\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}model\\text{-}guess}\\vdash\n\\mathrm{GuessedBy}_S(X,M)\\leftrightarrow\nX\\subseteq M\\land\\exists Y\\in M\\;(X=Y\\cap M)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}model\\text{-}guess}\\vdash\n\\mathrm{GuessedBy}_S(X,M)\\leftrightarrow\nX\\subseteq M\\land\\exists Y\\in M\\;(X=Y\\cap M)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}model\\text{-}guessing\\text{-}model} \\vdash\n\\mathrm{ZfcModelGuessingModel}_S(M,\\theta,\\delta)\\leftrightarrow\n\\mathrm{Cardinal}_S(\\theta)\\land\\mathrm{Cardinal}_S(\\delta)\\land\n\\exists H\\in V\\;\\bigl(\n\\mathrm{HereditarySizeClass}_S(H,\\theta)\\land\nM\\subseteq H\\land\n\\mathfrak M_\\in=\\langle M,\\in\\cap M^2\\rangle\\land\n\\mathfrak H_\\in=\\langle H,\\in\\cap H^2\\rangle\\land\n\\mathfrak M_\\in\\prec_{\\mathcal L_\\in}\\mathfrak H_\\in\\bigr)\\land\n\\forall X\\subseteq M\\;\\bigl(\n\\mathrm{DeltaApproximatedBy}_S(X,M,\\delta)\\to\\mathrm{GuessedBy}_S(X,M)\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}model\\text{-}guessing\\text{-}model} \\vdash\n\\math