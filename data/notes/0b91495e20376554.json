{-}cfg\\text{-}useless\\text{-}symbol\\text{-}elimination}\\vdash\nV_1\\coloneqq\\operatorname{Generating}(G),\\quad P_1\\coloneqq P\\cap(V_1\\times(V_1\\cup\\Sigma)^*),\\quad G_1\\coloneqq(V_1,\\Sigma,P_1,S)","display":true},{"tex":"\\mathrm{thm\\text{-}cfg\\text{-}useless\\text{-}symbol\\text{-}elimination}\\vdash\nV_2\\coloneqq\\operatorname{ReachVar}(G_1),\\quad P_2\\coloneqq P_1\\cap(V_2\\times(V_2\\cup\\Sigma)^*),\\quad G_2\\coloneqq(V_2,\\Sigma,P_2,S)","display":true},{"tex":"\\mathrm{thm\\text{-}cfg\\text{-}useless\\text{-}symbol\\text{-}elimination}\\vdash\nG_1,G_2\\in\\mathsf{CFG}_{\\Sigma}\\land L(G_2)=L(G)\\land\\operatorname{Generating}(G_2)=V_2\\land\\operatorname{ReachVar}(G_2)=V_2","display":true}],"bytes":2546,"backlinks":[{"id":"6af52783a9bce985","anchor":"ref-139","locations":["正文"],"count":1,"excerpt":"[[73-thm-cfg-useless-symbol-elimination|先生成性、后可达性的约简]]"},{"id":"6c59b8611811cc62","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""}],"outgoing":["52e38b01446c4422","8bb21416dea99a4c","97562bc4aa1d6014","a01cd76e5cbb0051","8fdba87feab50061"]}