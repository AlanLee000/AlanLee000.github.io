ngrightarrow\\operatorname{Fool}_m(\\operatorname{NW}_{\\mathcal I,f}(U_\\ell);s,\\epsilon).\n\\end{aligned}","display":true},{"tex":"i","display":false},{"tex":"s+3","display":false},{"tex":"1/2+\\epsilon/m","display":false},{"tex":"I_i","display":false},{"tex":"f(\\operatorname{res}_{I_j}(z))","display":false},{"tex":"I_i\\cap I_j","display":false},{"tex":"d","display":false},{"tex":"t\\le d","display":false},{"tex":"t","display":false},{"tex":"2^t","display":false},{"tex":"4(d+1)2^d","display":false},{"tex":"m-1","display":false},{"tex":"n","display":false},{"tex":"f","display":false},{"tex":"B","display":false},{"tex":"s+n+4m(d+1)2^d+4=T","display":false},{"tex":"1/2+\\epsilon/m","display":false},{"tex":"H_{\\mathrm{avg}}/10","display":false},{"tex":"d=0","display":false}],"bytes":2527,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-257","locations":["正文"],"count":1,"excerpt":"第20章：去随机化与NW构造：[[28-df-circuit-pseudorandomness]]、[[28-df-derandomization-prg]]、[[28-prop-prg-seed-enumeration]]、[[28-cor-log-seed-derandomization]]、[[28-df-nw-design]]、[[28-df-nw-generator]]、[[28-lem-circuit-hybrid-next-bit]]、[[28-lem-nw-design-existence]]、[[28-lem-nw-pseudorandomness]]、[[28-thm-hardness-derandomization]]。"}],"outgoing":["a21d838aabbea854","7d58f8e24dbfba2e","d42ba324c0358975","6058569a5f2311c9"]}