"tex":"x,y,z,u","display":false},{"tex":"\\varphi,\\psi","display":false},{"tex":"\\nu:\\mathrm{Fml}_{L_A}\\to N_A","display":false},{"tex":"\\mathrm{Norm}_A(\\nu)","display":false},{"tex":"N_A","display":false},{"tex":"\\nu|_{N_A}=\\mathrm{id}","display":false},{"tex":"\\operatorname{free}(\\nu\\varphi)=\\operatorname{free}(\\varphi)","display":false},{"tex":"\\vdash\\operatorname{ucl}_{L_A}(\\varphi\\leftrightarrow\\nu\\varphi)","display":false},{"tex":"\\neg,\\land,\\forall x","display":false},{"tex":"\\operatorname{free}=\\mathrm{free}_{L_A}","display":false},{"tex":"\\tau","display":false},{"tex":"\\mu\\in\\mathrm{Fml}_{L_A}[v_0]","display":false},{"tex":"\\eta_0\\in\\mathrm{Fml}_{L_A}[v_0]","display":false},{"tex":"\\eta_S\\in\\mathrm{Fml}_{L_A}[v_0,v_1]","display":false},{"tex":"\\eta_+,\\eta_\\times\\in\\mathrm{Fml}_{L_A}[v_0,v_1,v_2]","display":false},{"tex":"\\mu(x),\\eta_S(x,y)","display":false},{"tex":"D=(\\mu,\\eta_0,\\eta_S,\\eta_+,\\eta_\\times)","display":false},{"tex":"\\mathrm{TD}(\\tau,D)","display":false},{"tex":"\\mathrm{Trans}_{L_A,L_A}(\\tau)","display":false},{"tex":"g=c_{L_A}","display":false},{"tex":"e_\\nu\\in\\mathrm{PRProg}_1","display":false},{"tex":"⟦ e_\\nu⟧(g(\\varphi))=g(\\nu\\varphi)","display":false},{"tex":"\\varphi\\in\\mathrm{Fml}_{L_A}","display":false},{"tex":"0","display":false},{"tex":"\\mathrm{Norm}_A(\\nu)","display":false},{"tex":"\\vdash_{\\mathrm{PL}}","display":false},{"tex":"\\begin{aligned}\nA_A&\\coloneqq\\{x=y,x=0,Sx=y,x+y=z,x\\times y=z:x,y,z\\in\\mathrm{Var}_{L_A}\\},\\\\\nN_A&\\coloneqq\\bigcap\\{X\\subseteq\\mathrm{Fml}_{L_A}:A_A\\subseteq X\n\\land\\forall\\varphi,\\psi\\in X\\ (\\neg\\varphi\\in X\\land(\\varphi\\land\\psi)\\in X)\n\\land\\forall x\\in\\mathrm{Var}_{L_A}\\ \\forall\\varphi\\in X\\ (\\forall x\\varphi\\in X)\\},\\\\\n\\mathcal P_A&\\coloneqq\\mathrm{Fml}_{L_A}[v_0]\\times\\mathrm{Fml}_{L_A}[v_0]\\times\n\\mathrm{Fml}_{L_A}[v_0,v_1]\\times\\mathrm{Fml}_{L_A}[v_0,v_1,v_2]\\times\\mathrm{Fml}_{L_A}[v_0,v_1,v_2].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{Norm}_A(\\nu)\\Longleftrightarrow\\ &\n\\nu:\\mathrm{Fml}_{L_A}\\to N_A\\land\\nu\\upharpoonright N_A=\\mathrm{id}_{N_A}\\\\\n&\\land\\forall\\varphi\\in\\mathrm{Fml}_{L_A}\\\n(\\mathrm{free}_{L_A}(\\nu\\varphi)=\\mathrm{free}_{L_A}(\\varphi)\\land\n\\varnothing\\vdash_{\\mathrm{PL}}\\operatorname{ucl}_{L_A}(\\varphi\\leftrightarrow\\nu\\varphi))\\\\\n&\\land\\forall\\varphi,\\psi\\in\\mathrm{Fml}_{L_A}\\\n(\\nu(\\neg\\varphi)=\\neg\\nu(\\varphi)\\land\\nu(\\varphi\\land\\psi)=\\nu(\\varphi)\\land\\nu(\\psi))\\\\\n&\\land\\forall x\\in\\mathrm{Var}_{L_A}\\forall\\varphi\\in\\mathrm{Fml}_{L_A}\\\n\\nu(\\forall x\\varphi)=\\forall x\\nu(\\varphi),\\\\\n\\mathrm{TD}(\\tau,D)\\ \\Longleftrightarrow\\\n&D\\in\\mathcal P_A\\land\\tau:\\mathrm{Fml}_{L_A}\\to\\mathrm{Fml}_{L_A}\\\\\n&\\land\\forall\\varphi\\ (\\tau(\\varphi)=\\tau(\\nu\\varphi))\\\\\n&\\land\\forall x,y,z\\ \\bigl(\n\\tau(x=y)=(x=y)\\land\\tau(x=0)=\\eta_0(x)\\\\\n&\\hspace{5em}\\land\\tau(Sx=y)=\\eta_S(x,y)\n\\land\\tau(x+y=z)=\\eta_+(x,y,z)\n\\land\\tau(x\\times y=z)=\\eta_\\times(x,y,z)\\bigr)\\\\\n&\\land\\forall\\varphi,\\psi\\ \\bigl(\\tau(\\neg\\varphi)=\\neg\\tau(\\varphi)\n\\land\\tau(\\varphi\\land\\psi)=\\tau(\\varphi)\\land\\tau(\\psi)\\bigr)\\\\\n&\\land\\forall x\\ \\forall\\varphi\\\n\\bigl(\\tau(\\forall x\\varphi)=\\forall x(\\mu(x)\\to\\tau(\\varphi))\\bigr),\\\\\n\\mathrm{Trans}_{L_A,L_A}(\\tau)\\ \\Longleftrightarrow\\\n&\\exists D\\in\\mathcal P_A\\ \\mathrm{TD}(\\tau,D).\n\\end{aligned}","display":true},{"tex":"\\mu","display":false},{"tex":"\\forall","display":false},{"tex":"\\exists x\\varphi=\\neg\\forall x\\neg\\varphi","display":false},{"tex":"\\exists x(\\mu(x)\\land\\tau\\varphi)","display":false},{"tex":"N_A","display":false},{"tex":"D","display":false},{"tex":"\\nu","display":false},{"tex":"\\nu","display":false},{"tex":"x+0=y","display":false},{"tex":"\\exists z(z=0\\land x+z=y)","display":f