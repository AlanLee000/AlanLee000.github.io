eft(\n\\int_E\\max(\\operatorname{Im}\\circ f,0)\\,d\\mathbb P-\n\\int_E\\max(-\\operatorname{Im}\\circ f,0)\\,d\\mathbb P\n\\right)","display":true},{"tex":"\\mathrm{df\\text{-}expectation} \\vdash\n\\operatorname{ExpectedValue}_S(z,X;\\Omega,\\Sigma,\\mathbb P)\n\\leftrightarrow\n\\operatorname{ProbabilityMeasure}_S(\\mathbb P,\\Omega,\\Sigma)\\land\n\\operatorname{ComplexIntegral}_S(z,X,\\Omega;\\Omega,\\Sigma,\\mathbb P)","display":true},{"tex":"\\mathrm{df\\text{-}conditional\\text{-}expectation} \\vdash\n\\operatorname{CondExp}_S(Y,X,\\mathcal G,\\Omega,\\Sigma,\\mathbb P)\\leftrightarrow\n\\operatorname{ProbabilityMeasure}_S(\\mathbb P,\\Omega,\\Sigma)\\land\n\\operatorname{SigmaAlgebra}(\\mathcal G,\\Omega)\\land\\mathcal G\\subseteq\\Sigma\\land\n\\mathrm{IntegrableFunction}_S(X;\\Omega,\\Sigma,\\mathbb P)\\land\n\\mathrm{IntegrableFunction}_S(Y;\\Omega,\\Sigma,\\mathbb P)\\land\n\\mathrm{Measurable}_S(Y;(\\Omega,\\mathcal G),(\\mathbb C,\\mathcal B(\\mathbb C)))\\land\n\\forall A\\in\\mathcal G\\;\\exists z\\in\\mathbb C\\;\\Bigl(\n\\operatorname{ComplexIntegral}_S(z,Y,A;\\Omega,\\Sigma,\\mathbb P)\\land\n\\operatorname{ComplexIntegral}_S(z,X,A;\\Omega,\\Sigma,\\mathbb P)\n\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}conditional\\text{-}expectation\\text{-}compatibility} \\vdash \\operatorname{CondExp}(Y,X,\\mathcal G)\\leftrightarrow\\exists\\Omega,\\Sigma,\\mathbb P\\;\\operatorname{CondExp}_S(Y,X,\\mathcal G,\\Omega,\\Sigma,\\mathbb P)","display":true},{"tex":"\\mathcal G","display":false},{"tex":"\\mathcal G","display":false},{"tex":"L^p","display":false},{"tex":"\\mathbb{E}[|X|^p]^{1/p}","display":false},{"tex":"L^p","display":false},{"tex":"\\mathbb{E}[\\mathbb{E}[X \\mid \\mathcal{F}_1] \\mid \\mathcal{F}_2] = \\mathbb{E}[X \\mid \\mathcal{F}_2]","display":false},{"tex":"\\mathbb{E}[X] = \\mathbb{E}[\\mathbb{E}[X \\mid Y]]","display":false}],"bytes":3606,"backlinks":[{"id":"f0355544d1bb59cc","anchor":"ref-2","locations":["元数据 · depends_on"],