{"id":"06d18f40679c17c6","group":"58","path":"58/batch15/58-df-zfc-forcing-martin-maximum-instance.md","title":"ZFC Forcing Martin Maximum Instance","display":"df-zfc-forcing-martin-maximum-instance — ZFC Forcing Martin Maximum Instance","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-forcing-martin-maximum-instance","aliases":["58-df-zfc-forcing-martin-maximum-instance"],"display":"df-zfc-forcing-martin-maximum-instance — ZFC Forcing Martin Maximum Instance","depends_on":["[[58-ax-zfc]]","[[../batch01/58-df-zfc-forcing-stationary-set-preserving-poset]]","[[58-df-filter]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-forcing-martin-maximum-instance"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-forcing-martin-maximum-instance</span></div>"},{"key":"display","html":"df-zfc-forcing-martin-maximum-instance — ZFC Forcing Martin Maximum Instance"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"1cd156e08cdc8ce0\" href=\"?note=1cd156e08cdc8ce0\" title=\"../batch01/58-df-zfc-forcing-stationary-set-preserving-poset\">../batch01/58-df-zfc-forcing-stationary-set-preserving-poset</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"1331244a5201bb99\" href=\"?note=1331244a5201bb99\" title=\"58-df-filter\">58-df-filter</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathbb P\\in V\">\\(\\mathbb P\\in V\\)</span> and <span class=\"math-inline\" data-tex=\"\\leq_{\\mathbb P}\\subseteq\\mathbb P^2\">\\(\\leq_{\\mathbb P}\\subseteq\\mathbb P^2\\)</span> (forcing