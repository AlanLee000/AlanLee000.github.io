ad26\" href=\"?note=d83de8696e4dad26\" title=\"../batch16/58-df-regular.md\">../batch16/58-df-regular.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Poset}:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Poset}:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{CheckName}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{CheckName}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-12\" data-note=\"d29823616dbc5931\" href=\"?note=d29823616dbc5931\" title=\"../batch04/58-df-zfc-check-name.md\">../batch04/58-df-zfc-check-name.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcingRelation}_S:V^6\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcForcingRelation}_S:V^6\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-13\" data-note=\"911508dbd8495663\" href=\"?note=911508dbd8495663\" title=\"../batch14/58-df-zfc-forcing-relation.md\">../batch14/58-df-zfc-forcing-relation.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{TransitiveModel}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{TransitiveModel}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-14\" data-note=\"a9132c2c1a18acd1\" href=\"?note=a9132c2c1a18acd1\" title=\"../batch19/58-df-zfc-transitive-model.md\">../batch19/58-df-zfc-transitive-model.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcing12RevisedSupportCondition}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcForcing12RevisedSupportCondition}_S:V^5\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing12\\text{-}revised\\text{-}support\\text{-}condition} \\vdash\n\\begin{aligned}\n\\mathrm{ZfcForcing12RevisedSupportCondition}_S(p,\\vec{\\mathfrak P},\\delta,\\kappa,W)\\leftrightarrow\\;&amp;\n\\mathrm{TransitiveModel}_S(W)\\land p,\\vec{\\mathfrak P},\\delta,\\kappa\\in W\\land\n\\mathrm{Ordinal}(\\delta)\\land\\mathrm{Reg}(\\kappa)\\land\\omega&lt;\\kappa\\land\n\\mathrm{Function}(\\vec{\\mathfrak P},\\delta+1,W)\\land\n\\exists S\\in W\\;\\Bigl[\\mathrm{Function}(p,S,W)\\land S=\\operatorname{dom}(p)\\land\nS\\subseteq\\delta\\land|S|&lt;\\kappa\\land\\\\\n&amp;\\forall\\alpha\\leq\\delta\\;\\exists\\mathbb P_\\alpha,\\leq_\\alpha,\\check\\alpha,\\check\\kappa\\in W\\;\\Bigl(\n\\vec{\\mathfrak P}(\\alpha)=\\langle\\mathbb P_\\alpha,\\leq_\\alpha\\rangle\\land\n\\mathrm{Poset}(\\mathbb P_\\alpha,\\leq_\\alpha)\\land p{\\upharpoonright}\\alpha\\in\\mathbb P_\\alpha\\land\n\\mathrm{CheckName}_S(\\check\\alpha,\\alpha,\\mathbb P_\\alpha)\\land\n\\mathrm{CheckName}_S(\\check\\kappa,\\kappa,\\mathbb P_\\alpha)\\land\\\\\n&amp;\\qquad\\bigl(\\sup(S\\cap\\alpha)=\\alpha\\to\n\\mathrm{ZfcForcingRelation}_S\\!\\left(W,p{\\upharpoonright}\\alpha,\\varphi_{\\mathrm{cf}},\n\\langle\\check\\alpha,\\check\\kappa\\rangle,\\mathbb P_\\alpha,\\leq_\\alpha\\right)\\bigr)\n\\Bigr)\\Bigr].\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing12\\text{-}revised\\text{-}support\\text{-}condition} \\vdash\n\\begin{aligned}\n\\mathrm{ZfcForcing12RevisedSupportCondition}_S(p,\\vec{\\mathfrak P},\\delta,\\kappa,W)\\leftrightarrow\\;&amp;\n\\mathrm{TransitiveModel}_S(W)\\land p,\\vec{\\mathfrak P},\\delta,\\kappa\\in W\\land\n\\mathrm{Ordinal}(\\delta)\\land\\mathrm{Reg}(\\kappa)\\land\\omega&lt;\\kappa\\land\n\\mathrm{Function}(\\vec{\\mathfrak P},\\delta+1,W)\\land\n\\exists S\\in W\\;\\Bigl[\\mathrm{Function}(p,S,W)\\land S=\\operatorname{dom}(p)\\land\nS\\subseteq\\delta\\land|S|&lt;\\kappa\\land\\\\\n&amp;\\forall\\alpha\\leq\\delta\\;\\exists\\mathbb P_\\alpha,\\leq_\\alpha,\\check\\alpha,\\check\\kappa\\in W\\;\\Bigl(\n\\vec{\\mathfrak P}(\\alpha)=\\langle\\mathbb P_\\alpha,\\leq_\\alpha\\rangle\\land\n\\mathrm{Poset}(\\mathbb P_\\alpha,\\leq_\\alpha)\\land p{\\upharpoonright}\\alpha\\in\\mathbb P_\\alpha\\land\n\\mathrm{CheckName}_S(\\check\\alpha,\\alpha,\\mathbb P_\\alpha)\\land\n\\mathrm{CheckName}_S(\\check\\kappa,\\kappa,\\mathbb P_\\alpha)\\land\\\\\n&amp;\\qquad\\bigl(\\sup(S\\cap\\alpha)=\\alpha\\to\n\\mathrm{ZfcForcingRelation}_S\\!\\left(W,p{\\upharpoonright}\\alpha,\\varphi_{\\mathrm{cf}},\n\\langle\\check\\alpha,\\check\\kappa\\rangle,\\mathbb P_\\alpha,\\leq_\\alpha\\right)\\bigr)\n\\Bigr)\\Bigr].\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Conditions are partial functions, so the iteration support is their domain rather than the unrelated topological support of a function. The last clause uses the registered six-argument forcing relation at every cofinal-support stage.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch16/58-df-regular.md","status":"resolved","id":"d83de8696e4dad26","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-regular.md]]","embed":false},{"target":"../batch14/58-df-zfc-forcing-relation.md","status":"resolved","id":"911508dbd8495663","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","