\n\\mathsf{Ax}_{\\mathsf{IPC},3}^{\\mathsf{PLL}}&=\\{A\\land B\\to A:A,B\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},4}^{\\mathsf{PLL}}&=\\{A\\land B\\to B:A,B\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},5}^{\\mathsf{PLL}}&=\\{A\\to(B\\to A\\land B):A,B\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},6}^{\\mathsf{PLL}}&=\\{A\\to A\\lor B:A,B\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},7}^{\\mathsf{PLL}}&=\\{B\\to A\\lor B:A,B\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},8}^{\\mathsf{PLL}}&=\\{(A\\to C)\\to((B\\to C)\\to(A\\lor B\\to C)):A,B,C\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},9}^{\\mathsf{PLL}}&=\\{\\bot\\to A:A\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\}.\n\\end{aligned}","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{IPC}}^{\\mathsf{PLL}}=\\bigcup_{1\\le i\\le9}\\mathsf{Ax}_{\\mathsf{IPC},i}^{\\mathsf{PLL}}","display":false},{"tex":"\\mathsf{Ax}_{\\eta}^{\\mathsf{PLL}}\n=\n\\{A\\to\\bigcirc A:A\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\mu}^{\\mathsf{PLL}}\n=\n\\{\\bigcirc\\bigcirc A\\to\\bigcirc A:A\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{bind}}^{\\mathsf{PLL}}\n=\n\\{(A\\to\\bigcirc B)\\to(\\bigcirc A\\to\\bigcirc B):A,B\\in\\mathsf{Frm}_{\\mathsf{PLL}}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{PLL}}\n=\n\\mathsf{Ax}_{\\mathsf{IPC}}^{\\mathsf{PLL}}\n\\cup\\mathsf{Ax}_{\\eta}^{\\mathsf{PLL}}\n\\cup\\mathsf{Ax}_{\\mu}^{\\mathsf{PLL}}\n\\cup\\mathsf{Ax}_{\\mathsf{bind}}^{\\mathsf{PLL}}.","display":true},{"tex":"\\bigcirc","display":false},{"tex":"\\Box/\\Diamond","display":false},{"tex":"\\mathsf{Rule}_{\\mathsf{MP}}^{\\mathsf{PLL}}\\subseteq(\\mathsf{Frm}_{\\mathsf{PLL}}^2\\times\\mathsf{Frm}_{\\mathsf{PLL}}),\n\\qquad\n\\mathsf{Rule}_{\\mathsf{mon}}^{\\mathsf{PLL}}\\subseteq(\\mathsf{Frm}_{\\mathsf{PLL}}^1\\times\\mathsf{Frm}_{\\math