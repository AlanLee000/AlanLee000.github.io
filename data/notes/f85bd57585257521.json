false},{"tex":"\\mathrm{SuccessorCardinal}_S(\\lambda,\\mu)","display":false},{"tex":"\\lambda","display":false},{"tex":"\\mu","display":false},{"tex":"\\operatorname{OmegaSuccessor}(\\kappa,\\theta)","display":false},{"tex":"\\omega","display":false},{"tex":"\\operatorname{CummingsSequence}(C,\\kappa,\\delta)","display":false},{"tex":"\\mathrm{df\\text{-}cummings\\text{-}omega\\text{-}successor} \\vdash \\operatorname{OmegaSuccessor}(\\kappa,\\theta) \\leftrightarrow \\mathrm{Cardinal}_S(\\kappa)\\land\\mathrm{Cardinal}_S(\\theta)\\land\\exists s\\;\\bigl(\\operatorname{dom}(s)=\\omega\\land s(0)=\\kappa\\land\\forall n\\in\\omega\\;\\mathrm{Cardinal}_S(s(n))\\land\\forall n\\in\\omega\\;\\mathrm{SuccessorCardinal}_S(s(n+1),s(n))\\land\\theta=\\sup\\operatorname{ran}(s)\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}cummings} \\vdash \\operatorname{CummingsSequence}(C,\\kappa,\\delta) \\leftrightarrow \\mathrm{Cardinal}_S(\\kappa)\\land\\mathrm{Ordinal}_S(\\delta)\\land\\operatorname{dom}(C)=\\delta+1\\land C(0)=\\kappa\\land\\forall\\alpha\\leq\\delta\\;\\mathrm{Cardinal}_S(C(\\alpha))\\land\\forall\\alpha<\\delta\\;\\operatorname{OmegaSuccessor}(C(\\alpha),C(\\alpha+1))\\land\\forall\\lambda\\leq\\delta\\;(\\operatorname{LimitOrdinal}_S(\\lambda)\\to C(\\lambda)=\\sup_{\\alpha<\\lambda}C(\\alpha))","display":true},{"tex":"\\mathrm{Card}^{\\mathrm{Ord}}","display":false},{"tex":"C","display":false},{"tex":"V","display":false},{"tex":"\\omega","display":false},{"tex":"s","display":false},{"tex":"\\kappa^{+n}","display":false}],"bytes":2556,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-387","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-cummings.md|58-df-cummings]]（batch07）"}],"outgoing":["5fb1c2241d1943d1","5582a281f15a33c2","36d7463d215be751","b2079cb7dec7ca43","81cabbac7fa4d75d"]}