for that same order <span class=\"math-inline\" data-tex=\"r_B\">\\(r_B\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch13/58-df-zfc-poset-boolean-ultrafilter.md","status":"resolved","id":"7be50e9501572e41","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-zfc-poset-boolean-ultrafilter.md]]","embed":false},{"target":"../batch14/58-df-generic-filter.md","status":"resolved","id":"85bf4cca0e5f1662","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-df-generic-filter.md]]","embed":false},{"target":"../batch13/58-df-zfc-poset-boolean-ultrafilter.md","status":"resolved","id":"7be50e9501572e41","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcPosetBooleanUltrafilter}_S\\subseteq V^8$ (explicit Boolean-algebra ultrafilter predicate, see [[../batch13/58-df-zfc-poset-boolean-ultrafilter.md]])","embed":false},{"target":"../batch14/58-df-generic-filter.md","status":"resolved","id":"85bf4cca0e5f1662","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Generic}_S\\subseteq V^4$ (generic-filter predicate with explicit order, see [[../batch14/58-df-generic-filter.md]])","embed":false}],"math":[{"tex":"U,B,M,r_B,m_B,j_B,c_B,z_B,o_B\\in V","display":false},{"tex":"\\mathrm{ZfcPosetBooleanUltrafilter}_S\\subseteq V^8","display":false},{"tex":"\\mathrm{Generic}_S\\subseteq V^4","display":false},{"tex":"\\mathrm{UltrafilterGeneric}_S\\subseteq V^3","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}z