{\\mathbf{NC}}&\\coloneqq\\{B\\in\\mathbf P\\mid\\forall A\\in\\mathbf P\\;A\\le_m^{\\mathbf{NC}}B\\}.\n\\end{aligned}","display":true},{"tex":"\\mathbf{PComplete}","display":false}],"bytes":1462,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-43","locations":["正文"],"count":1,"excerpt":"归约：[[28-df-polynomial-time-function]]、[[28-df-poly-reduction]]、[[28-thm-poly-reduction-transitive]]、[[28-df-np-hard]]、[[28-df-np-complete]]、[[28-df-p-complete]]。"}],"outgoing":["dd9febae42d44280","a91903f455f49892","348985e8f68576a3"]}