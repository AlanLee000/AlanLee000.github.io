-df-zfc-skolem-hull]])"},{"id":"84daad544872cc71","anchor":"ref-3492","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-zfc-skolem-hull.md|58-df-zfc-skolem-hull]]（batch19）"}],"outgoing":["36d7463d215be751","d9b8711cda3f31ca","91b4c987294d365f"]}