"id":"793eef40929a34d4","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathcal T$、$\\mathcal T_{<\\Gamma_0}$ 与 $\\|T\\|$ 满足 [[18-df-ordinal-cutoff]] 的声明。"},{"id":"7f2f4fb15c3aaf36","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathcal T$、$\\mathcal T_{<\\Gamma_0}$ 与 $\\|T\\|$ 满足 [[18-df-ordinal-cutoff]] 的声明。"},{"id":"100d7af02276fe1b","anchor":"ref-68","locations":["正文"],"count":1,"excerpt":"[[../18-df-ordinal-cutoff]]"},{"id":"e29d1100705cdb23","anchor":"ref-68","locations":["正文"],"count":1,"excerpt":"[[../18-df-ordinal-cutoff]]"}],"outgoing":["2053b1b724a60f4e","3df370596a981512","c8f3a8371faa8691","4b4b62cab0a0c1b1"]}