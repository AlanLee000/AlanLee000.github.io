e},{"tex":"A>\\neg B","display":false},{"tex":"B\\to C","display":false},{"tex":"B\\leftrightarrow(B\\land C)","display":false},{"tex":"(A>B)\\to(A>C)","display":false},{"tex":"A\\leftrightarrow B","display":false},{"tex":"A>B","display":false},{"tex":"B>A","display":false},{"tex":">","display":false},{"tex":"\\square\\!\\!\\to","display":false},{"tex":"(B\\land(B\\to C))\\to C","display":false},{"tex":"\\mathcal{LewisVC}_{613}\n=\n(\\mathsf{Prop},\\mathsf{Frm}_{613},\\operatorname{FV}_{613},\\operatorname{BV}_{613},\n\\mathsf{Subst}_{613},\\operatorname{Sub}_{613},\\equiv_{\\alpha,613},\n\\mathsf{Ax}_{613},\\mathsf{Rule}_{613},\\mathsf{Proof}_{613},\\operatorname{last}_{613},\n\\vdash_{613},\\mathsf{Thm}_{613},\\mathsf{Cert}_{613},\n\\mathsf{LewisMod}_{613}^{C},⟦-⟧_{613},\\Vdash_{613},\\models_{613}).","display":true}],"bytes":11738,"backlinks":[],"outgoing":[]}