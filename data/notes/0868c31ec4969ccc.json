 B.","display":true},{"tex":"Alg_\\Omega,Mat_\\Omega","display":false},{"tex":"\\mathbb A=(A,D)","display":false},{"tex":"A_{\\mathbb A}=A,D_{\\mathbb A}=D","display":false},{"tex":"Val(A)","display":false},{"tex":"\\mathcal K","display":false},{"tex":"\\mathcal K\\subseteq Mat_\\Omega.","display":true},{"tex":"\\Gamma\\models_{\\mathcal K}A","display":true},{"tex":"\\forall\\mathbb A\\in\\mathcal K\\ \\forall\\nu\\in Val(A_{\\mathbb A})\n\\bigl(\n\\mathbb A,\\nu\\models_\\Omega\\Gamma\n\\Rightarrow\n\\mathbb A,\\nu\\models_\\Omega A\n\\bigr),","display":true},{"tex":"A_{\\mathbb A}","display":false},{"tex":"\\mathbb A=(A_{\\mathbb A},D_{\\mathbb A})","display":false},{"tex":"Cn_{\\mathcal K}(\\Gamma)\n=\n\\{A\\in Fm_\\Omega:\\Gamma\\models_{\\mathcal K}A\\}.","display":true},{"tex":"T\\subseteq Fm_\\Omega","display":false},{"tex":"\\mathcal K","display":false},{"tex":"Cn_{\\mathcal K}(T)=T.","display":true},{"tex":"SubInv(\\models_{\\mathcal K})\n\\Longleftrightarrow\n\\forall\\Gamma\\in\\mathcal P(Fm_\\Omega)\\ \\forall A\\in Fm_\\Omega\\ \\forall\\sigma\\in Sub_\\Omega\\,\n\\bigl(\n\\Gamma\\models_{\\mathcal K}A\n\\Rightarrow\n\\widehat\\sigma[\\Gamma]\\models_{\\mathcal K}\\widehat\\sigma(A)\n\\bigr).","display":true},{"tex":"Counter_{\\mathcal K}(\\Gamma,A,\\mathbb A,\\nu)\n\\Longleftrightarrow\n\\mathbb A,\\nu\\models_\\Omega\\Gamma\n\\land\n\\neg(\\mathbb A,\\nu\\models_\\Omega A).","display":true},{"tex":"Cert_{\\mathcal K}^{counter}(\\Gamma,A)\n=\n\\{(\\mathbb A,\\nu):\\mathbb A\\in\\mathcal K,\\ \\nu\\in Val(A_{\\mathbb A}),\\ Counter_{\\mathcal K}(\\Gamma,A,\\mathbb A,\\nu)\\}.","display":true},{"tex":"\\Gamma\\models_{\\mathcal K}A\n\\Longleftrightarrow\n\\neg\\exists\\mathbb A\\in\\mathcal K\\ \\exists\\nu\\in Val(A_{\\mathbb A})\\\nCounter_{\\mathcal K}(\\Gamma,A,\\mathbb A,\\nu).","display":true},{"tex":"Rule_{Cn}^{\\mathcal K}\n=\n\\{(\\Gamma,A):\\Gamma\\subseteq Fm_\\Omega,\\ A\\in Fm_\\Omega,\\ \\Gamma\\models_{\\mathcal K}A\\}.","display":true},{"