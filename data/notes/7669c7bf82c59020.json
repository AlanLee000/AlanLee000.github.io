\\;\\operatorname{PrimRec}_S(F,g,h,k)\\right\\},\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}primitive\\text{-}recursive\\text{-}function}\\vdash\n\\mathrm{ZfcRecursion3PrimitiveRecursiveFunction}_S(f)\\leftrightarrow\n\\exists k\\in\\omega\\;(f\\in\\omega^{\\omega^k}\\land f\\in\\mathsf{PR}).","display":true},{"tex":"\\operatorname{PrimRec}","display":false}],"bytes":3150,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3251","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-recursion3-primitive-recursive-function.md|58-df-zfc-recursion3-primitive-recursive-function]]（batch18）"}],"outgoing":["a3348ed9eb6fb4e3","1cf46a0ea13ab5dd","36d7463d215be751"]}