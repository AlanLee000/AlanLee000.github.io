83e75cb\" href=\"?note=5045d216c83e75cb\" title=\"../batch16/58-df-omega.md\">../batch16/58-df-omega.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathcal F\\subseteq[\\omega]^\\omega\">\\(\\mathcal F\\subseteq[\\omega]^\\omega\\)</span> and <span class=\"math-inline\" data-tex=\"A\\in[\\omega]^\\omega\">\\(A\\in[\\omega]^\\omega\\)</span></p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcComb7PseudointersectionFamily}_S\">\\(\\mathrm{ZfcComb7PseudointersectionFamily}_S\\)</span> (predicate defined here)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"|A|\">\\(|A|\\)</span> 为集合 <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> 的唯一基数，使用 <a class=\"wiki-link\" id=\"ref-6\" data-note=\"2be08d4ee8aa1590\" href=\"?note=2be08d4ee8aa1590\" title=\"../batch15/58-df-cardinality.md\">../batch15/58-df-cardinality.md</a> 的基数函数。 对集合 <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> 和序数 <span class=\"math-inline\" data-tex=\"\\lambda\">\\(\\lambda\\)</span>，<span class=\"math-inline\" data-tex=\"[A]^\\lambda\\coloneqq\\{B\\in\\mathcal P(A):|B|=\\lambda\\}\">\\([A]^\\lambda\\coloneqq\\{B\\in\\mathcal P(A):|B|=\\lambda\\}\\)</span>，<span class=\"math-inline\" data-tex=\"[A]^{&lt;\\lambda}\\coloneqq\\{B\\in\\mathcal P(A):|B|&lt;\\lambda\\}\">\\([A]^{&lt;\\lambda}\\coloneqq\\{B\\in\\mathcal P(A):|B|&lt;\\lambda\\}\\)</span>。 <span class=\"math-inline\" data-tex=\"\\aleph_0\\coloneqq\\omega\">\\(\\aleph_0\\coloneqq\\omega\\)</span>，见 <a class=\"wiki-link\" id=\"ref-7\" data-note=\"5045d216c83e75cb\" href=\"?note=5045d216c83e75cb\" title=\"../batch16/58-df-omega.md\">../batch16/58-df-omega.md</a>。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comb7\\text{-}pseudointersection\\text{-}family} \\vdash \\mathrm{ZfcComb7PseudointersectionFamily}_S(A,\\mathcal F)\\leftrightarrow\\mathcal F\\subseteq[\\omega]^\\omega\\land A\\in[\\omega]^\\omega\\land\\forall F\\in\\mathcal F\\;(|A\\setminus F|&lt;\\aleph_0)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}comb7\\text{-}pseudointersection\\text{-}family} \\vdash \\mathrm{ZfcComb7PseudointersectionFamily}_S(A,\\mathcal F)\\leftrightarrow\\mathcal F\\subseteq[\\omega]^\\omega\\land A\\in[\\omega]^\\omega\\land\\forall F\\in\\mathcal F\\;(|A\\setminus F|&lt;\\aleph_0)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary combinatorial definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch08/58-df-family.md","status":"resolved","id":"545b51e7aa011030","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-family.md]]","embed":false},{"target":"../batch15/58-df-cardinality.md","status":"resolved","id":"2be08d4ee8aa1590","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-cardinality.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch16/58-df-omega.md","status":"resolved","id":"5045d216c83e75cb","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-omega.md]]","embed":false},{"target":"../batch15/