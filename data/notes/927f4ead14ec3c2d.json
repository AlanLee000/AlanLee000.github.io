au\\in V\\cap2^n\\ \\exists\\rho\\in S_{e,s}\\ (\\rho\\preceq\\tau)]\\Bigr],\\\\\nn_s:=\\max(\\{|\\rho|:\\rho\\in S_s\\}\\cup\\{0\\}),\\\\\n2^\\omega=\\bigcup_{\\rho\\in S_s}[\\rho]\\Longleftrightarrow\n\\forall\\tau\\in2^{n_s}\\ \\exists\\rho\\in S_s\\ [\\rho\\preceq\\tau].\n\\end{gathered}","display":true},{"tex":"F\\subseteq S","display":false},{"tex":"[T]","display":false},{"tex":"s","display":false},{"tex":"F\\subseteq S_s","display":false},{"tex":"S_s","display":false},{"tex":"n","display":false},{"tex":"(s,n)","display":false},{"tex":"n","display":false},{"tex":"[T]=\\varnothing","display":false},{"tex":"S_s=\\varnothing","display":false},{"tex":"T","display":false},{"tex":"n_s=0","display":false}],"bytes":3051,"backlinks":[{"id":"364ab8ad1d9d7918","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-thm-effective-finite-cover]]。"},{"id":"d85c7ced66d7ccee","anchor":"ref-69","locations":["正文"],"count":1,"excerpt":"[[20-thm-effective-finite-cover]]"},{"id":"005203b6707a19f4","anchor":"ref-137","locations":["正文"],"count":1,"excerpt":"[[20-thm-effective-finite-cover]] — 章 8；直接提供者 7 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-137","locations":["正文"],"count":1,"excerpt":"[[20-thm-effective-finite-cover]]"}],"outgoing":["b73290a0af01d44f","59004ac6d23e86f8","84785d7ea3ad1a08","b4c1ab1358773e54","4ef1aee16db6b308","e343870c773cb68e","35073b74f84433b3"]}