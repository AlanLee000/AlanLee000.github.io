{DerivativeAt}_S(x\\mapsto u(x,y_0),x_0,a)\\land\\mathrm{DerivativeAt}_S(y\\mapsto v(x_0,y),y_0,a)\\land\\mathrm{DerivativeAt}_S(y\\mapsto u(x_0,y),y_0,b)\\land\\mathrm{DerivativeAt}_S(x\\mapsto v(x,y_0),x_0,-b)\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}cauchy\\text{-}riemann} \\vdash \\mathrm{CR}_S(u,v,z_0)\\leftrightarrow \\exists x_0,y_0,a,b\\in\\mathbb R\\;\\left(z_0=x_0+iy_0\\land\\mathrm{DerivativeAt}_S(x\\mapsto u(x,y_0),x_0,a)\\land\\mathrm{DerivativeAt}_S(y\\mapsto v(x_0,y),y_0,a)\\land\\mathrm{DerivativeAt}_S(y\\mapsto u(x_0,y),y_0,b)\\land\\mathrm{DerivativeAt}_S(x\\mapsto v(x,y_0),x_0,-b)\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>These equations characterize complex differentiability under regularity hypotheses.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch15/58-df-derivative.md","status":"resolved","id":"6ad876d2c15e685f","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-derivative.md]]","embed":false},{"target":"../batch15/58-df-derivative.md","status":"resolved","id":"6ad876d2c15e685f","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{DerivativeAt}_S:V^3\\to\\{\\top,\\bot\\}$ (see [[../batch15/58-df-derivative.md]])","embed":false}],"math":[{"tex":"u,v\\in\\mathbb R^{\\mathbb R^2}\\land z_0\\in\\mathbb C","display":false},{"tex":"\\mathrm{DerivativeAt}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{CR}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}cauchy\\text{-}riemann} \\vdash \\mathrm{CR}_S(u,v,z_0)\\leftrightarrow \\exists x_0,y_0,a,b\\in\\mathbb R\\;\\left(z_0=x_0+iy_0\\land\\mathrm{DerivativeAt}_S(x\\mapsto u(x,y_0),x_0,a)\\land\\mathrm{DerivativeAt}_S(y\\mapsto v(x_0,y),y_0,a)\\land\\mathrm{DerivativeAt}_S(y\\mapsto u(x_0,y),y_0,b)\\land\\mathrm{DerivativeAt}_S(x\\mapsto v(x,y_0),x_0,-b)\\right)","display":true}],"bytes":946,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-253","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-cauchy-riemann.md|58-df-cauchy-riemann]]（batch05）"}],"outgoing":["6ad876d2c15e685f"]}