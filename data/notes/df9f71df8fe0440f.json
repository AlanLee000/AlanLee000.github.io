)\\Rightarrow Z,\\ X\\Rightarrow lres(Y,Z))\\in Disp_D,","display":true},{"tex":"(X\\Rightarrow lres(Y,Z),\\ prod(X,Y)\\Rightarrow Z)\\in Disp_D,","display":true},{"tex":"(prod(X,Y)\\Rightarrow Z,\\ Y\\Rightarrow rres(X,Z))\\in Disp_D,","display":true},{"tex":"(Y\\Rightarrow rres(X,Z),\\ prod(X,Y)\\Rightarrow Z)\\in Disp_D,","display":true},{"tex":"X,Y,Z\\in Str_D","display":false},{"tex":"Disp_D","display":false},{"tex":"X,Y,Z\\in Str_D","display":false},{"tex":"\\begin{aligned}\nDisp_D=\\{&(prod(X,Y)\\Rightarrow Z,\\ X\\Rightarrow lres(Y,Z)),\\\\\n&(X\\Rightarrow lres(Y,Z),\\ prod(X,Y)\\Rightarrow Z),\\\\\n&(prod(X,Y)\\Rightarrow Z,\\ Y\\Rightarrow rres(X,Z)),\\\\\n&(Y\\Rightarrow rres(X,Z),\\ prod(X,Y)\\Rightarrow Z):\nX,Y,Z\\in Str_D\\}.\n\\end{aligned}","display":true},{"tex":"\\operatorname{DispCert}_{D}(S,T,c)\n\\Longleftrightarrow\n\\exists n\\in\\mathbb N\\,\n\\bigl(\nc:n+1\\to Seq_D\n\\land c(0)=S\n\\land c(n)=T\n\\land\\forall i<n\\ (c(i),c(i+1))\\in Disp_D\n\\bigr).","display":true},{"tex":"Disp_D^{*}\n=\n\\{(S,T):\\exists c\\ \\operatorname{DispCert}_{D}(S,T,c)\\}.","display":true},{"tex":"Init_D=\\{frm(A)\\Rightarrow frm(A):A\\in Frm_D\\}.","display":true},{"tex":"Seq_D^{<\\omega}\\times Seq_D","display":false},{"tex":"A,B\\in Frm_D","display":false},{"tex":"X,Y\\in Str_D","display":false},{"tex":"Rule_{\\wedge R}^D\n=\n\\{((X\\Rightarrow frm(A),X\\Rightarrow frm(B)),X\\Rightarrow frm(and(A,B)))\\},","display":true},{"tex":"Rule_{\\wedge L}^D\n=\n\\{((prod(frm(A),frm(B))\\Rightarrow X),\\ frm(and(A,B))\\Rightarrow X)\\},","display":true},{"tex":"Rule_{\\vee L}^D\n=\n\\{((frm(A)\\Rightarrow X,frm(B)\\Rightarrow X),frm(or(A,B))\\Rightarrow X)\\},","display":true},{"tex":"Rule_{\\vee R}^D\n=\n\\{((X\\Rightarrow prod(frm(A),frm(B))),X\\Rightarrow frm(or(A,B)))\\},","display":true},{"tex":"Rule_{\\to R}^D\n=\n\\{((prod(X,frm(A))\\Rightarrow frm(B)),X\\Rightarrow frm(imp(A,B)))\\},","display":true},{"tex":"Rule_{\\to L}^D\n=\n\\{((X\\Rightarrow frm(A),frm(B)