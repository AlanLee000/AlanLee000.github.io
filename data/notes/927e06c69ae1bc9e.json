ts x\\in X\\;(\\pi(x)=n)\\bigr)\\land\n\\bigl(\\forall n\\in N\\;\\forall y\\in n\\;(y\\in N)\\bigr)\\land\n\\forall x\\in X\\;\\Bigl(\n\\pi(x)=\\{\\pi(y):y\\in X\\land\\langle y,x\\rangle\\in R\\}\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}model10\\text{-}mostowski\\text{-}collapse\\text{-}target}\\vdash\n\\mathrm{ZfcModel10MostowskiCollapseTarget}_S(N,X,R,\\pi)\\leftrightarrow\n\\mathrm{ZfcRelWellFoundedRelation}_S(R,X)\\land\n\\mathrm{ZfcRelExtensionalRelation}_S(R,X)\\land\n\\mathrm{Function}(\\pi,X,N)\\land\n\\bigl(\\forall x,x&#39;\\in X\\;(\\pi(x)=\\pi(x&#39;)\\to x=x&#39;)\\bigr)\\land\n\\bigl(\\forall n\\in N\\;\\exists x\\in X\\;(\\pi(x)=n)\\bigr)\\land\n\\bigl(\\forall n\\in N\\;\\forall y\\in n\\;(y\\in N)\\bigr)\\land\n\\forall x\\in X\\;\\Bigl(\n\\pi(x)=\\{\\pi(y):y\\in X\\land\\langle y,x\\rangle\\in R\\}\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary collapse target definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch16/58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function]]","embed":false},{"target":"../batch13/58-df-zfc-rel-well-founded-relation","status":"resolved","id":"a6e2250a95e86cd5","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-zfc-rel-well-founded-relation]]","embed":false},{"target":"../batch16/58-df-zfc-rel-extensional-re