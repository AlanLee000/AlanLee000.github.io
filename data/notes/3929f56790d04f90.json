htarrow\\bigl(\\operatorname{Res}^{1}_R(a,u)=\\{u\\}\\land u\\in\\operatorname{ExternalRed}_R(t)\\bigr).","display":true},{"tex":"\\operatorname{Res}_R(\\rho,u)\\in\\{\\varnothing,\\{u\\}\\}.","display":true},{"tex":"\\operatorname{Res}_R(\\rho,u)\\ne\\varnothing\\Rightarrow u\\in\\operatorname{ExternalRed}_R(\\operatorname{tgt}(\\rho)).","display":true},{"tex":"u","display":false},{"tex":"u","display":false},{"tex":"u","display":false},{"tex":"\\{u\\}","display":false},{"tex":"t","display":false},{"tex":"u","display":false},{"tex":"t","display":false},{"tex":"u","display":false},{"tex":"u","display":false},{"tex":"u","display":false}],"bytes":2124,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-201","locations":["正文"],"count":2,"excerpt":"[[56-thm-external-redex-persistence.md]]"},{"id":"60cf9e66e1dc462c","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"采用 [[56-thm-external-redex-persistence]] 的正交系统及外部性、残余与最外位置接口；$s\\in T$、$u\\in\\operatorname{Red}_R(s)$，$\\operatorname{External}_R(s,u)$。$\\operatorname{Needed}_R(s,u)$ 见 [[56-df-needed-redex]]。"}],"outgoing":["11b60d6a0ba187b5","b2ca2cb031a137a3"]}