\overline{\\ulcorner\\varphi\\urcorner})\n\\land T(\\overline{\\ulcorner\\psi\\urcorner})\n\\bigr),\n\\end{aligned}","display":true},{"tex":"\\mathcal L_0","display":false}],"bytes":2559,"backlinks":[],"outgoing":["b0b2a8b496dd82c3","73ccb673e6681e3d"]}