omega_{>0}\\\\\n&\\land\\exists^{\\mathrm{class}}M,j\\;\\exists s\\in V\\;\\Bigl(\n\\mathrm{ClassElemEmb}_S(j,M)\\land\\mathrm{ClassCriticalPoint}_{58}(\\kappa,j)\\\\\n&\\qquad\\land\\mathrm{Function}(s,n+1,\\operatorname{ran}(s))\\land s(0)=\\kappa\n\\land\\forall m\\in n\\;(s(m+1)=j(s(m)))\n\\land\\mathrm{SeqClosedClass}_S(M,s(n))\\Bigr).\n\\end{aligned}","display":true},{"tex":"n=1","display":false},{"tex":"j(\\kappa)","display":false},{"tex":"n","display":false},{"tex":"s","display":false},{"tex":"j","display":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa","display":false},{"tex":"\\operatorname{crit}","display":false},{"tex":"s","display":false},{"tex":"\\exists^{\\mathrm{class}}","display":false}],"bytes":2940,"backlinks":[{"id":"1c58d8be3b47a5f9","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ClassElemEmb}_S(j,M)$ (class elementary embedding $j:V\\to M$ with transitive target, see [[../batch01/58-df-zfc-largecard4-n-huge-cardinal.md]])"},{"id":"a92f58a8fd5cca59","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ClassElemEmb}_S(j,M)$ (class elementary embedding $j:V\\to M$ with transitive target, see [[../batch01/58-df-zfc-largecard4-n-huge-cardinal.md]])"},{"id":"84daad544872cc71","anchor":"ref-2432","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-largecard4-n-huge-cardinal.md|58-df-zfc-largecard4-n-huge-cardinal]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","5fb1c2241d1943d1","36d7463d215be751","65418b505fc53093","8b6a90316aad78a4","5578254565969219"]}