^3","display":false},{"tex":"\\mathrm{SOTConv}_S\\subseteq V^3","display":false},{"tex":"S","display":false},{"tex":"\\mathrm{HilbertSpace}_S(H,B,k,+_H,\\odot_H)","display":false},{"tex":"k\\in\\{\\mathbb R,\\mathbb C\\}","display":false},{"tex":"\\|x\\|=\\sqrt{B(\\langle x,x\\rangle)}","display":false},{"tex":"x-y=+_H(\\langle x,\\odot_H(\\langle-1,y\\rangle)\\rangle)","display":false},{"tex":"\\mathrm{BoundedOperator}_S","display":false},{"tex":"\\mathrm{df\\text{-}strong\\text{-}operator} \\vdash\n\\mathrm{SOTConv}_S(T_\\bullet,T,H)\\leftrightarrow\n\\exists I,\\leq_I\\in V\\;\\Bigl(\\mathrm{Directed}_S(I,\\leq_I)\\land\n\\mathrm{Function}(T_\\bullet,I,H^H)\\land\\mathrm{BoundedOperator}_S(T,H,H)\\land\n\\forall i\\in I\\;\\mathrm{BoundedOperator}_S(T_\\bullet(i),H,H)\\land\n\\forall x\\in H\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists i_0\\in I\\;\\forall i\\in I\\;\n(\\langle i_0,i\\rangle\\in\\leq_I\\to\\|T_\\bullet(i)(x)-T(x)\\|<\\varepsilon)\\Bigr)","display":true},{"tex":"T_\\bullet","display":false}],"bytes":1813,"backlinks":[{"id":"ef593f4bf65d6fd1","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$A,M\\in V$；$\\mathrm{SOTConv}_S$ 使用 [[../batch14/58-df-strong-operator.md]]。该定义中的 $B,k,+_H,\\odot_H$ 分别指定为本条的 $B,\\mathbb C,+_{\\mathcal H},\\odot_{\\mathcal H}$。"},{"id":"84daad544872cc71","anchor":"ref-1238","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-strong-operator.md|58-df-strong-operator]]（batch14）"}],"outgoing":["2ad9c248fe18df37","1fc4c0c7a21cd8c1","36d7463d215be751","aa82947fba077a45","b70ce791d5b1a19b"]}