{"id":"6be36c599b3c1499","group":"58","path":"58/batch20/58-df-zfc-forcing3-complete-boolean-valued-model.md","title":"ZFC Forcing3 Complete Boolean Valued Model","display":"df-zfc-forcing3-complete-boolean-valued-model — ZFC Forcing3 Complete Boolean Valued Model","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-forcing3-complete-boolean-valued-model","aliases":["58-df-zfc-forcing3-complete-boolean-valued-model"],"display":"df-zfc-forcing3-complete-boolean-valued-model — ZFC Forcing3 Complete Boolean Valued Model","depends_on":["[[58-df-boolean-valued-model]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-forcing3-complete-boolean-valued-model"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-forcing3-complete-boolean-valued-model</span></div>"},{"key":"display","html":"df-zfc-forcing3-complete-boolean-valued-model — ZFC Forcing3 Complete Boolean Valued Model"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"87811b9038822859\" href=\"?note=87811b9038822859\" title=\"58-df-boolean-valued-model\">58-df-boolean-valued-model</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathbb B=(B,\\wedge,\\vee,\\neg,0,1)\">\\(\\mathbb B=(B,\\wedge,\\vee,\\neg,0,1)\\)</span> (complete Boolean-algebra datum).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal M\">\\(\\mathcal M\\)</span> (Boolean-valued universe class candidate).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{BooleanValuedModel}_S(\\mathcal M,\\mathbb B)\">\\(\\mathrm{BooleanValuedModel}_S(\\mathcal M,\\mathbb B)\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"87811b9038822859\" href=\"?note=87811b9038822859\" title=\"58