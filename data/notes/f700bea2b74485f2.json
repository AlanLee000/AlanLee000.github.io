tarrow\n\\mathrm{Subst}_G(\\theta_\\varphi,\n\\overline{\\ulcorner L_\\varphi\\urcorner},v_0)\n\\bigr)\n\\land\\mathrm{LobSent}_G(L_\\varphi,\\varphi)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"L_\\varphi","display":false},{"tex":"\\varphi","display":false},{"tex":"L_\\varphi","display":false},{"tex":"\\varphi","display":false},{"tex":"G\\vdash L_\\varphi\\leftrightarrow(\\mathrm{Prov}_G(\\overline{\\ulcorner L_\\varphi\\urcorner})\\to\\varphi)","display":false},{"tex":"d","display":false},{"tex":"L_\\varphi","display":false},{"tex":"G\\vdash L_\\varphi","display":false},{"tex":"G\\vdash\\varphi","display":false},{"tex":"Q\\subseteq\\mathrm{Th}(G)","display":false},{"tex":"Q","display":false},{"tex":"G","display":false},{"tex":"Q\\subseteq\\mathrm{Ax}(G)","display":false},{"tex":"G","display":false},{"tex":"\\mathrm{Prov}_G(v_0)","display":false},{"tex":"\\mathrm{Subst}_G","display":false},{"tex":"\\mathrm{Prov}_G(\\bar n)","display":false},{"tex":"\\alpha","display":false}],"bytes":3412,"backlinks":[{"id":"823a52c75bbad9bd","anchor":"ref-382","locations":["正文"],"count":1,"excerpt":"[[92-ex-lob-sentence-construction]]"}],"outgoing":["71758b63b2ee2736","e9cc91aaee998c7b","90f32e29c9d553ed","2413c1d0ca8a0ce6","5a1bd470754681a7","d666a3e3ee6c8148","b9e3d57e94ce36b7","725c1f1651ce9a00","b78092e29a02d697","468d35690d25ee42","f3fdd55235f4984e","975b3aa9a1e08797","8bd18c4d476f594a","e948c25f4a467fa1","0a1ba58f66cc8d4e"]}