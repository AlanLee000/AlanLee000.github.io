\nu_{B_H},K,\\nu_{B_K}):F\\in V\\\\\n&\\qquad\\land\\mathrm{BoundedOperatorStructure}_S(F;H,\\nu_{B_H},+_H,\\odot_H;K,\\nu_{B_K},+_K,\\odot_K;\\mathbb C)\\\\\n&\\qquad\\land\\exists m\\in n\\;\\exists W\\in V\\;\\Bigl(W=\\operatorname{Span}_{\\mathbb C}(F[H];K,+_K,\\odot_K,0_K)\\land\\mathrm{Dimension}_S\\!\\left(m,\\left\\langle W,\\mathbb C,+_K\\!\\upharpoonright W^2,\\odot_K\\!\\upharpoonright(\\mathbb C\\times W),+_{\\mathbb C},\\cdot_{\\mathbb C},0_{\\mathbb C},1_{\\mathbb C},0_K\\right\\rangle\\right)\\Bigr)\\Bigr\\}\\Bigr).\n\\end{aligned}","display":true},{"tex":"n","display":false},{"tex":"s_n(T)","display":false},{"tex":"T","display":false},{"tex":"|T|=(T^*T)^{1/2}","display":false},{"tex":"|T|","display":false},{"tex":"T-F","display":false}],"bytes":3778,"backlinks":[{"id":"cb6f3da63e39a685","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{SingularValue}_S(s,n,T,H,H)$ (see [[../batch03/58-df-singular-value.md]])"},{"id":"e824a8435bba9f97","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1180","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-singular-value.md|58-df-singular-value]]（batch03）"}],"outgoing":["28999e0c83253377","2ad9c248fe18df37","200eacd293b1282b","b70ce791d5b1a19b","522587a7fec6816a","1eb4a89b005d9cda"]}