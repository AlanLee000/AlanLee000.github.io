se},{"tex":"i<e","display":false},{"tex":"x>2e","display":false},{"tex":"A","display":false},{"tex":"W_e\\subseteq B","display":false},{"tex":"x>2e","display":false},{"tex":"x","display":false},{"tex":"W_e\\subseteq[0,2e]","display":false},{"tex":"2e+1","display":false},{"tex":"A","display":false}],"bytes":2301,"backlinks":[{"id":"cc21d215609a3083","anchor":"ref-15","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-closed-class]]；see [[20-df-basis]]；see [[20-df-re]]；see [[20-df-K]]；see [[20-thm-simple-exists]]；see [[20-df-effective-immune]]；see [[20-thm-hyperimmune-bound]]；see [[20-df-finite-array]]；see [[20-thm-closed-class-tree-equivalence]]；see [[20-thm-effective-immune-ce-upper]]。"},{"id":"0ec3e4391cca9764","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-lachlan-game]]；see [[20-df-simple]]；see [[20-thm-simple-exists]]；see [[20-df-computable]]。"},{"id":"005203b6707a19f4","anchor":"ref-120","locations":["正文"],"count":1,"excerpt":"[[20-thm-simple-exists]] — 章 5；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-120","locations":["正文"],"count":1,"excerpt":"[[20-thm-simple-exists]]"}],"outgoing":["428fc565e7338639","4ef1aee16db6b308","3ec173dab9734388","145fee39d6716fb8"]}