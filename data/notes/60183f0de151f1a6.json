esis]","excerpt":"$A,B,C\\subseteq\\Sigma^*$；$\\leq_m$ 使用 [[73-df-typed-many-one-reduction]] 的词载体实例。","embed":false}],"attachments":[],"math":[{"tex":"\\Sigma","display":false},{"tex":"\\operatorname{Alphabet}(\\Sigma)","display":false},{"tex":"A,B,C\\subseteq\\Sigma^*","display":false},{"tex":"\\leq_m","display":false},{"tex":"\\mathrm{thm\\text{-}6.1}\\vdash\nA\\leq_mB\\land B\\leq_mC\\to A\\leq_mC","display":true}],"bytes":1627,"backlinks":[{"id":"6af52783a9bce985","anchor":"ref-227","locations":["正文"],"count":1,"excerpt":"[[73-thm-many-one-transitivity-notation|many one transitivity notation]]"}],"outgoing":["192df17017774c0f","0a6da8c909717780","6530ee2fa245fe46"]}