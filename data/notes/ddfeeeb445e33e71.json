).","display":true},{"tex":"\\operatorname{FinLang}(\\Sigma)\\coloneqq\\{L\\subseteq\\Sigma^*\\mid\\operatorname{card}(L)<\\aleph_0\\}.","display":true},{"tex":"\\operatorname{StarFree}(\\Sigma)\\coloneqq\\bigcap\\{\\mathcal F\\subseteq\\mathcal P(\\Sigma^*)\\mid\\operatorname{FinLang}(\\Sigma)\\subseteq\\mathcal F\\land\\forall L,K\\in\\mathcal F\\;(L\\cup K,\\Sigma^*\\setminus L,LK)\\in\\mathcal F^3\\}.","display":true},{"tex":"\\bigl\\{\\{w\\in\\Sigma^+\\mid\\mathfrak W_w\\models\\phi\\}\\mid\\phi\\in\\mathrm{Sent}_{\\tau_\\Sigma}\\bigr\\}=\\{L\\cap\\Sigma^+\\mid L\\in\\operatorname{StarFree}(\\Sigma)\\}.","display":true},{"tex":"w\\mapsto\\mathfrak W_w","display":false},{"tex":"\\Sigma^+","display":false}],"bytes":2626,"backlinks":[{"id":"ecc0dd131d213345","anchor":"ref-196","locations":["正文"],"count":1,"excerpt":"[[../29-thm-fo-star-free]]"}],"outgoing":["28e86a5f0243a0ae","711217f22972ffc0","3ee556c64b16809b","0ac4b9a122d458e2","4de8e0c8085801f5"]}