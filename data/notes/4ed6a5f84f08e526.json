link\" id=\"ref-6\" data-note=\"d8eb5064b65f8a92\" href=\"?note=d8eb5064b65f8a92\" title=\"../batch08/58-df-sequence.md\">../batch08/58-df-sequence.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> (progressive set of regular cardinals)</li>\n<li><span class=\"math-inline\" data-tex=\"J\">\\(J\\)</span> (proper ideal on <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\lambda\">\\(\\lambda\\)</span> (cardinal scale length)</li>\n<li><span class=\"math-inline\" data-tex=\"\\vec f=\\langle f_\\xi:\\xi&lt;\\lambda\\rangle\">\\(\\vec f=\\langle f_\\xi:\\xi&lt;\\lambda\\rangle\\)</span> (sequence, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"d8eb5064b65f8a92\" href=\"?note=d8eb5064b65f8a92\" title=\"../batch08/58-df-sequence.md\">../batch08/58-df-sequence.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{RegularCardinal}_S\">\\(\\mathrm{RegularCardinal}_S\\)</span> (regular-cardinal predicate, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"0fbfc19800246e77\" href=\"?note=0fbfc19800246e77\" title=\"../batch13/58-df-regular-cardinal.md\">../batch13/58-df-regular-cardinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Cardinal}_S\">\\(\\mathrm{Cardinal}_S\\)</span> (cardinal predicate, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"5fb1c2241d1943d1\" href=\"?note=5fb1c2241d1943d1\" title=\"../batch11/58-df-cardinal.md\">../batch11/58-df-cardinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcIdeal6IdealOnSet}_S\">\\(\\mathrm{ZfcIdeal6IdealOnSet}_S\\)</span> (proper-ideal predicate, see <a class=\"wiki-link\" id=\"ref-10\" data-note=\"57e0cc0c038bbcc0\" href=\"?note=57e0cc0c038bbcc0\" title=\"58-df-zfc-ideal6-ideal-on-set\">58-df-zfc-ideal6-ideal-on-set</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcLargePcfScale}_S\\subseteq V^4\">\\(\\mathrm{ZfcLargePcfScale}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}large\\text{-}pcf\\text{-}scale} \\vdash \\mathrm{ZfcLargePcfScale}_S(\\vec f,A,\\lambda,J)\\leftrightarrow A\\neq\\varnothing\\land\\forall a\\in A\\;\\mathrm{RegularCardinal}_S(a)\\land|A|&lt;\\min A\\land\\mathrm{ZfcIdeal6IdealOnSet}_S(A,J)\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\vec f:\\lambda\\to\\prod A\\land\\forall\\xi&lt;\\eta&lt;\\lambda\\;\\bigl(\\{a\\in A\\mid f_\\xi(a)\\geq f_\\eta(a)\\}\\in J\\bigr)\\land\\forall g\\in\\prod A\\;\\exists\\xi&lt;\\lambda\\;\\bigl(\\{a\\in A\\mid g(a)\\geq f_\\xi(a)\\}\\in J\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}large\\text{-}pcf\\text{-}scale} \\vdash \\mathrm{ZfcLargePcfScale}_S(\\vec f,A,\\lambda,J)\\leftrightarrow A\\neq\\varnothing\\land\\forall a\\in A\\;\\mathrm{RegularCardinal}_S(a)\\land|A|&lt;\\min A\\land\\mathrm{ZfcIdeal6IdealOnSet}_S(A,J)\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\vec f:\\lambda\\to\\prod A\\land\\forall\\xi&lt;\\eta&lt;\\lambda\\;\\bigl(\\{a\\in A\\mid f_\\xi(a)\\geq f_\\eta(a)\\}\\in J\\bigr)\\land\\forall g\\in\\prod A\\;\\exists\\xi&lt;\\lambda\\;\\bigl(\\{a\\in A\\mid g(a)\\geq f_\\xi(a)\\}\\in J\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch11/58-df-cardinal.md"