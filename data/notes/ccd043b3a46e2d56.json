\vdash\n\\mathrm{ZfcOrder10StrictPartOfPreorder}_S(P,\\preceq,\\prec)\\leftrightarrow\n\\left(\n\\preceq\\;\\subseteq P\\times P\\land\n\\forall x\\in P\\;(x\\preceq x)\\land\n\\forall x,y,z\\in P\\;(x\\preceq y\\land y\\preceq z\\to x\\preceq z)\\land\n\\prec\\;=\\{\\langle x,y\\rangle\\in P\\times P\\mid x\\preceq y\\land\\neg(y\\preceq x)\\}\n\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}order10\\text{-}strict\\text{-}part\\text{-}of\\text{-}preorder} \\vdash\n\\mathrm{ZfcOrder10StrictPartOfPreorder}_S(P,\\preceq,\\prec)\\leftrightarrow\n\\left(\n\\preceq\\;\\subseteq P\\times P\\land\n\\forall x\\in P\\;(x\\preceq x)\\land\n\\forall x,y,z\\in P\\;(x\\preceq y\\land y\\preceq z\\to x\\preceq z)\\land\n\\prec\\;=\\{\\langle x,y\\rangle\\in P\\times P\\mid x\\preceq y\\land\\neg(y\\preceq x)\\}\n\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary preorder definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch18/58-df-relation.md","status":"resolved","id":"7ccfc8c88f29968a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-relation.md]]","embed":false}],"math":[{"tex":"P,\\preceq,\\prec\\in V","display":false},{"tex":"\\mathrm{ZfcOrder10StrictPartOfPreorder}_S","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}order10\\text{-}strict\\text{-}part\\text{-}of\\text{-}preorder} \\vdash\n\\mathrm{ZfcOrder10StrictPartOfPreorder}_S(P,\\preceq,\\prec)\\leftrightarrow\n\\left(\n\\p