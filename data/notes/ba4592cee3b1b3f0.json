nSubspaceTopology}_S(W,3))\\\\\n&\\land\\forall x\\in U\\;\\forall r\\in\\mathbb R_{>0}\\;\\bigl(\n\\{y\\in\\mathbb R^3:\\|y-x\\|\\leq r\\}\\subseteq U\\to\\\\\n&\\qquad\\mathrm{SingularHomologyPushforward}_S(\\mathrm{RadialDirection}_S(h,x,r),S^2,\\tau_{S^2},S^2,\\tau_{S^2},2)\n=\\operatorname{id}_{H_2(S^2,\\tau_{S^2})}\\bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\phi_+\\coloneqq\n\\left\\{\\left\\langle x,\\left\\langle\\frac{x(0)}{1-x(3)},\\frac{x(1)}{1-x(3)},\\frac{x(2)}{1-x(3)}\\right\\rangle_3\\right\\rangle:x\\in S^3\\setminus\\{N_+\\}\\right\\},\\\\\n\\phi_-\\coloneqq\n\\left\\{\\left\\langle x,\\left\\langle\\frac{-x(0)}{1+x(3)},\\frac{x(1)}{1+x(3)},\\frac{x(2)}{1+x(3)}\\right\\rangle_3\\right\\rangle:x\\in S^3\\setminus\\{N_-\\}\\right\\},\\\\\n\\mathcal A_3\\coloneqq\\{\\langle S^3\\setminus\\{N_+\\},\\phi_+\\rangle,\n\\langle S^3\\setminus\\{N_-\\},\\phi_-\\rangle\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\na,b\\in\\mathbb R\\land0<b-a<2\\pi\\to\nU_{a,b}\\coloneqq\\{\\langle\\langle\\cos\\theta,\\sin\\theta\\rangle_2,v\\rangle:\\theta\\in(a,b)\\land v\\in\\mathring D^2\\},\\\\\na,b\\in\\mathbb R\\land0<b-a<2\\pi\\to\n\\psi_{a,b}\\coloneqq\n\\{\\langle\\langle\\langle\\cos\\theta,\\sin\\theta\\rangle_2,v\\rangle,\n\\langle\\theta,v(0),v(1)\\rangle_3\\rangle:\\theta\\in(a,b)\\land v\\in\\mathring D^2\\},\\\\\n\\mathcal A_V\\coloneqq\\{\\langle U_{a,b},\\psi_{a,b}\\rangle:a,b\\in\\mathbb R\\land0<b-a<2\\pi\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{OrientedSolidTorusEmbedding}_S(e,N,K)\\leftrightarrow{}&\nK\\subseteq N\\subseteq S^3\\land\n\\mathrm{Homeo}_S(e,V_0,\\tau_{V_0},N,\\tau_N)\\\\\n&\\land e[S^1\\times\\{\\langle0,0\\rangle_2\\}]=K\n\\land e[V_0^\\circ]=\\operatorname{int}_3(N)\\\\\n&\\land\\forall\\langle U,\\alpha\\rangle\\in\\mathcal A_V\\;\n\\forall\\langle W,\\beta\\rangle\\in\\mathcal A_3\\;\n\\mathrm{ThreeDimensionalOrientationPreserving}_S\n\\left(\\beta\\circ(e\