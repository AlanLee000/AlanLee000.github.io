m{SplitFib}","display":false},{"tex":"\\mathrm{FibPre}","display":false},{"tex":"\\begin{aligned}\nP_I&\\coloneqq\\{m\\in M_{\\mathcal B}\\mid t_{\\mathcal B}(m)=I\\land\\mathrm{Mono}_{\\mathcal B}(m)\\},\\\\\nm\\sim_I n&\\Longleftrightarrow m,n\\in P_I\\land\n(\\exists h\\in\\mathcal B(s_{\\mathcal B}(m),s_{\\mathcal B}(n)))\n\\mathrm{Iso}_{\\mathcal B}(h)\\land nh=m,\\\\\n\\operatorname{Sub}_{\\mathcal B}(I)&\\coloneqq P_I/{\\sim_I},\\\\\n\\le_I&\\coloneqq\\{([m],[n])\\mid m,n\\in P_I\\land\n(\\exists h\\in\\mathcal B(s_{\\mathcal B}(m),s_{\\mathcal B}(n)))\\ nh=m\\}.\n\\end{aligned}","display":true},{"tex":"\\{u^*[n]\\}\\coloneqq\\{[m]\\mid m\\in P_I\\land\n(\\exists h\\in\\mathcal B(s_{\\mathcal B}(m),s_{\\mathcal B}(n)))\n\\mathrm{PbSq}_{\\mathcal B}(h,m;n,u)\\}\n\\quad(u\\in\\mathcal B(I,J),\\ n\\in P_J).","display":true},{"tex":"\\begin{aligned}\nO_{\\mathrm{Sub}}&\\coloneqq\\{(I,S)\\mid I\\in\\operatorname{Ob}\\mathcal B\\land S\\in\\operatorname{Sub}_{\\mathcal B}(I)\\},\\\\\nM_{\\mathrm{Sub}}&\\coloneqq\\{\\langle(I,S),(J,T),u\\rangle\\mid\n(I,S),(J,T)\\in O_{\\mathrm{Sub}}\\land u\\in\\mathcal B(I,J)\\land S\\le u^*T\\},\\\\\ns_{\\mathrm{Sub}}\\langle(I,S),(J,T),u\\rangle&\\coloneqq(I,S),\\\\\nt_{\\mathrm{Sub}}\\langle(I,S),(J,T),u\\rangle&\\coloneqq(J,T),\\\\\ne_{\\mathrm{Sub}}(I,S)&\\coloneqq\\langle(I,S),(I,S),\\operatorname{id}_I\\rangle,\\\\\nc_{\\mathrm{Sub}}(\\langle(J,T),(K,V),v\\rangle,\\langle(I,S),(J,T),u\\rangle)\n&\\coloneqq\\langle(I,S),(K,V),vu\\rangle,\\\\\n\\mathbf{Sub}(\\mathcal B)&\\coloneqq\\langle O_{\\mathrm{Sub}},M_{\\mathrm{Sub}},s_{\\mathrm{Sub}},t_{\\mathrm{Sub}},e_{\\mathrm{Sub}},c_{\\mathrm{Sub}}\\rangle,\\\\\np_0(I,S)&\\coloneqq I,\\\\\np_1\\langle(I,S),(J,T),u\\rangle&\\coloneqq u,\\\\\np&\\coloneqq\\langle p_0,p_1\\rangle,\\qquad p_{\\mathrm{Sub}}\\coloneqq p.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\kappa(u,(J,T))&\\coloneqq\\langle(I,u^*T),(J,T),u\\rangle\n\\quad(u\\in\\mathcal B(I,J)),\\\\\n\\mathrm{Ca