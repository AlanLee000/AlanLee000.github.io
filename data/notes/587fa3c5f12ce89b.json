uad\\operatorname{vars}(\\exists x\\,\\phi)\\coloneqq\\operatorname{vars}((\\exists^{\\geq m}x)\\phi)\\coloneqq\\operatorname{vars}(\\phi)\\cup\\{x\\}.","display":true},{"tex":"\\operatorname{fv}(\\neg\\phi)\\coloneqq\\operatorname{fv}(\\phi),\\quad\\operatorname{fv}(\\phi\\land\\psi)\\coloneqq\\operatorname{fv}(\\phi)\\cup\\operatorname{fv}(\\psi),\\quad\\operatorname{fv}(\\exists x\\,\\phi)\\coloneqq\\operatorname{fv}((\\exists^{\\geq m}x)\\phi)\\coloneqq\\operatorname{fv}(\\phi)\\setminus\\{x\\}.","display":true},{"tex":"C^k_\\tau\\coloneqq\\{\\phi\\in\\mathrm{Fml}_C[\\tau]\\mid\\operatorname{card}(\\operatorname{vars}(\\phi))\\leq k\\},\\qquad\\mathrm{Sent}_{C^k}[\\tau]\\coloneqq\\{\\phi\\in C^k_\\tau\\mid\\operatorname{fv}(\\phi)=\\varnothing\\}.","display":true},{"tex":"A\\models_C\\alpha[\\beta]\\ \\Longleftrightarrow\\ A\\models\\alpha[\\beta].","display":true},{"tex":"A\\models_C\\neg\\phi[\\beta]\\ \\Longleftrightarrow\\ \\neg(A\\models_C\\phi[\\beta]),\\qquad A\\models_C(\\phi\\land\\psi)[\\beta]\\ \\Longleftrightarrow\\ (A\\models_C\\phi[\\beta]\\land A\\models_C\\psi[\\beta]).","display":true},{"tex":"A\\models_C\\exists x\\,\\phi[\\beta]\\ \\Longleftrightarrow\\ \\exists a\\in|A|\\;(A\\models_C\\phi[\\beta[a/x]]).","display":true},{"tex":"A\\models_C(\\exists^{\\geq m}x)\\phi[\\beta]\\ \\Longleftrightarrow\\ \\operatorname{card}(\\{a\\in|A|\\mid A\\models_C\\phi[\\beta[a/x]]\\})\\geq m.","display":true},{"tex":"\\mathrm{qr}_C(\\alpha)\\coloneqq0,\\quad\\mathrm{qr}_C(\\neg\\phi)\\coloneqq\\mathrm{qr}_C(\\phi),\\quad\\mathrm{qr}_C(\\phi\\land\\psi)\\coloneqq\\max(\\mathrm{qr}_C(\\phi),\\mathrm{qr}_C(\\psi)),\\quad\\mathrm{qr}_C(\\exists x\\,\\phi)\\coloneqq\\mathrm{qr}_C((\\exists^{\\geq m}x)\\phi)\\coloneqq1+\\mathrm{qr}_C(\\phi),\\quad\\alpha\\in\\mathrm{AtFml}_\\tau.","display":true},{"tex":"\\operatorname{vars}(\\phi\\circ\\psi)\\coloneqq\\operatorname{vars}(\\phi)\\cup\\operatorname{vars}(\\psi),\\quad\\operatorname{fv}(\\phi\\circ\\psi)\\coloneqq\\