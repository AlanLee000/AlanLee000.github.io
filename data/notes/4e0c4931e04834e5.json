Card6CardinalLt}_S(\\mathcal B,c)).","display":true},{"tex":"\\mathrm{thm\\text{-}ideal\\text{-}completeness\\text{-}hierarchy}\\vdash \\mathrm{SetIdeal}_S(I,X)\\land\\mathrm{Cardinal}_S(\\kappa)\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\kappa\\leq\\lambda\\land\\mathrm{KappaCompleteIdeal}_S(I,X,\\lambda)\\to\\mathrm{KappaCompleteIdeal}_S(I,X,\\kappa).","display":true},{"tex":"\\mathrm{thm\\text{-}ideal\\text{-}completeness\\text{-}threshold}\\vdash \\mathrm{SetIdeal}_S(I,X)\\land\\mathrm{Cardinal}_S(\\kappa)\\to\\left(\\mathrm{KappaCompleteIdeal}_S(I,X,\\kappa)\\leftrightarrow\\exists c\\in V\\;(\\mathrm{IdealCompletenessNumber}_S(c,I,X)\\land\\kappa\\leq c)\\right).","display":true},{"tex":"\\kappa","display":false},{"tex":"\\mathrm{NS}_\\kappa","display":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa^+","display":false},{"tex":"\\operatorname{comp}(\\mathrm{NS}_\\kappa)=\\kappa","display":false}],"bytes":2611,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4215","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-thm-ideal-completeness-hierarchy.md|58-thm-ideal-completeness-hierarchy]]（batch20）"}],"outgoing":["5fb1c2241d1943d1","86c688a672128b44","28c79fde9f892bfe"]}