q[m]\\;\\left((\\mathrm{Pet}_{f,\\mathbf P}(\\chi_I)=1\\Longleftrightarrow\\forall a\\in T(f)\\;\\exists i\\in I\\;P_i(a)=1)\\land\n(\\mathrm{Pet}_{f,\\mathbf P}(\\chi_I)=1\\Longleftrightarrow\\mathrm{EvalDNF}_n(\\{P_i\\mid i\\in I\\})=f)\\right).","display":true}],"bytes":1826,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-507","locations":["正文"],"count":1,"excerpt":"[[27-thm-petrick|thm-petrick — Petrick covering expression]]"}],"outgoing":["3e2ce4e4d23a0ce2","98e5c19fe4a2b9e2","0b618255959ff4bc"]}