bot\\}\">\\(\\mathrm{Ordinal}:V\\to\\{\\top,\\bot\\}\\)</span> (ordinal predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"../batch17/58-df-ordinal.md\">../batch17/58-df-ordinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Tree}:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Tree}:V^2\\to\\{\\top,\\bot\\}\\)</span> (tree predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"f06e57c5c0b1354d\" href=\"?note=f06e57c5c0b1354d\" title=\"../batch18/58-df-tree.md\">../batch18/58-df-tree.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> (function predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcFunLevelOfTree}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcFunLevelOfTree}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}fun\\text{-}level\\text{-}of\\text{-}tree} \\vdash \\mathrm{ZfcFunLevelOfTree}_S(L,T,\\alpha)\\leftrightarrow \\mathrm{Ordinal}(\\alpha)\\land\\exists R\\in V\\;\\Bigl(R=\\{\\langle s,t\\rangle\\in T\\times T:s\\subseteq t\\}\\land\\mathrm{Tree}(T,R)\\land\\bigl(\\forall s\\in T\\;\\exists X_s\\in V\\;\\mathrm{Function}(s,\\operatorname{dom}(s),X_s)\\bigr)\\land L=\\{s\\in T:\\operatorname{dom}(s)=\\alpha\\}\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}fun\\text{-}level\\text{-}of\\text{-}tree} \\vdash \\mathrm{ZfcFunLevelOfTree}_S(L,T,\\alpha)\\leftrightarrow \\mathrm{Ordinal}(\\alpha)\\land\\exists R\\in V\\;\\Bigl(R=\\{\\langle s,t\\rangle\\in T\\times T:s\\subseteq t\\}\\land\\mathrm{Tree}(T,R)\\land\\bigl(\\forall s\\in T\\;\\exists X_s\\in V\\;\\mathrm{Function}(s,\\operatorname{dom}(s),X_s)\\bigr)\\land L=\\{s\\in T:\\operatorname{dom}(s)=\\alpha\\}\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch18/58-df-tree.md","status":"resolved","id":"f06e57c5c0b1354d","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-tree.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Ordinal}:V\\to\\{\\top,\\bot\\}$ (ordinal predicate, see [[../batch17/58-df-ordinal.md]])","embed":false},{"target":"../batch18/58-df-tree.md","status":"resolved","id":"f06e57c5c0b1354d","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Tree}:V^2\\to\\{\\top,\\bot\\}$ (tree predicate, see [[../batch18/58-df-tree.md]])","embed":false},{"target":"../batch16/58-df-function.md","status"