)\\\\\n&\\hspace{29mm}\\land F[S^1\\times\\{0\\}]=K[S^1]\\times\\{0\\}\n\\land F[S^1\\times\\{1\\}]=J[S^1]\\times\\{1\\}\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\sigma(K)","display":false}],"bytes":3606,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-734","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-knot-concordance.md|58-df-knot-concordance]]（batch01）"}],"outgoing":["ca7fc3ab38a11801","3b5b3d48ff1ff369","ccaaf599ec318a33","d87c5d842ade903d","890a8458fc69d8c7","050f6d05b2c94aea","5260a5349d0b732f"]}