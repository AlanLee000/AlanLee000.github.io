"ref-4\" data-note=\"8317eefb4572709e\" href=\"?note=8317eefb4572709e\" title=\"../batch15/58-df-injective.md\">../batch15/58-df-injective.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Bijective}\">\\(\\mathrm{Bijective}\\)</span> (bijection predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"d583890235faf0d5\" href=\"?note=d583890235faf0d5\" title=\"../batch18/58-df-bijective.md\">../batch18/58-df-bijective.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}schroeder} \\vdash\n\\bigl(\\mathrm{Injective}_S(f,A,B)\\land\\mathrm{Injective}_S(g,B,A)\\bigr)\n\\to\n\\exists h\\;\\mathrm{Bijective}(h,A,B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}schroeder} \\vdash\n\\bigl(\\mathrm{Injective}_S(f,A,B)\\land\\mathrm{Injective}_S(g,B,A)\\bigr)\n\\to\n\\exists h\\;\\mathrm{Bijective}(h,A,B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Equivalently, <span class=\"math-inline\" data-tex=\"|A|\\leq|B|\">\\(|A|\\leq|B|\\)</span> and <span class=\"math-inline\" data-tex=\"|B|\\leq|A|\">\\(|B|\\leq|A|\\)</span> imply <span class=\"math-inline\" data-tex=\"|A|=|B|\">\\(|A|=|B|\\)</span>.</li>\n<li>This theorem does not require the Axiom of Choice.</li>\n<li>It is also commonly called the Cantor-Bernstein theorem.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch15/58-df-injective.md","status":"resolved","id":"8317eefb4572709e","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-injective.md]]","embed":false},{"target":"../batch18/58-df-bijective.md","status":"resolved","id":"d583890235faf0d5","anchor":"ref-2","targe