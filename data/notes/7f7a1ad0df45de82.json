{"id":"7f7a1ad0df45de82","group":"93","path":"93/93-prop-variety-contained.md","title":"Variety Contained","display":"Variety Contained","type":"proposition","metadata":{"type":"proposition","book":"Algebraizable Logics","book_abbrev":"93","label":"93-prop-variety-contained","aliases":["93-prop-variety-contained"],"display":"Variety Contained","authors":"W. J. Blok, Don Pigozzi","book_title":"Algebraizable Logics","depends_on":["[[93-df-variety]]","[[93-df-closure-operators]]","[[93-thm-generated-variety]]","[[93-df-similarity-type]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"proposition"},{"key":"book","html":"Algebraizable Logics"},{"key":"book_abbrev","html":"93"},{"key":"label","html":"93-prop-variety-contained"},{"key":"aliases","html":"<div class=\"property-array\"><span>93-prop-variety-contained</span></div>"},{"key":"display","html":"Variety Contained"},{"key":"authors","html":"W. J. Blok, Don Pigozzi"},{"key":"book_title","html":"Algebraizable Logics"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"f0b0edbaa6696a1d\" href=\"?note=f0b0edbaa6696a1d\" title=\"93-df-variety\">93-df-variety</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"97b46a497e251f9f\" href=\"?note=97b46a497e251f9f\" title=\"93-df-closure-operators\">93-df-closure-operators</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"d8af34fe512640e2\" href=\"?note=d8af34fe512640e2\" title=\"93-thm-generated-variety\">93-thm-generated-variety</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"ee84ed8b0fae5bc3\" href=\"?note=ee84ed8b0fae5bc3\" title=\"93-df-similarity-type\">93-df-similarity-type</a></span></div>"}],"html":"<h1 id=\"prop-variety-contained-—-Variety-Contained\">prop-variety-contained — Variety Contained</h1>\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{SimType}_{93}(\\tau)\">\\(\\mathrm{SimType}_{93}(\\tau)\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathcal K,\\mathcal L\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\">\\(\\mathcal K,\\mathcal L\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{VGen}_{93,\\tau}\">\\(\\operatorname{VGen}_{93,\\tau}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{HSP}\">\\(\\mathrm{HSP}\\)</span> are the generated-variety and closure operators of <a class=\"wiki-link\" id=\"ref-5\" data-note=\"f0b0edbaa6696a1d\" href=\"?note=f0b0edbaa6696a1d\" title=\"93-df-variety\">93-df-variety</a> and <a class=\"wiki-link\" id=\"ref-6\" data-note=\"97b46a497e251f9f\" href=\"?note=97b46a497e251f9f\" title=\"93-df-closure-operators\">93-df-closure-operators</a>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{prop\\text{-}variety\\text{-}contained}\\vdash\n\\mathrm{SimType}_{93}(\\tau)\\land\\mathcal K\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\land\\mathcal L\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\to\\Bigl(\n\\operatorname{VGen}_{93,\\tau}(\\mathcal K)\\subseteq\n\\operatorname{VGen}_{93,\\tau}(\\mathcal L)\n\\leftrightarrow\\mathcal K\\subseteq\\mathrm{HSP}_{\\tau}(\\mathcal L)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{prop\\text{-}variety\\text{-}contained}\\vdash\n\\mathrm{SimType}_{93}(\\tau)\\land\\mathcal K\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\land\\mathcal L\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\to\\Bigl(\n\\operatorname{VGen}_{93,\\tau}(\\mathcal K)\\subseteq\n\\operatorname{VGen}_{93,\\tau}(\\mathcal L)\n\\leftrightarrow\\mathcal K\\subseteq\\mathrm{HSP}_{\\tau}(\\mathcal L)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]