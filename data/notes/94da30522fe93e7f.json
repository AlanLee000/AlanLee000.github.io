d\\eta=\\rho)\\lor(i=1\\land\\eta=\\tau))]\\},\\\\\n\\operatorname{Sp}(T,\\sigma,e):=\\bigcup_{n\\in\\omega}\\mathscr S_n,\\qquad\nS:=\\operatorname{Sp}(T,\\sigma,e),\\\\\nS(\\varnothing)\\downarrow=\\sigma,\\\\\nS(\\alpha^\\frown i)\\downarrow=\\eta\\ \\Longleftrightarrow\\\n\\exists\\nu,\\rho,\\tau\\in2^{<\\omega}\\\n[S(\\alpha)\\downarrow=\\nu\\land q_{j,e}(\\nu)\\downarrow=(\\rho,\\tau)\n\\land((i=0\\land\\eta=\\rho)\\lor(i=1\\land\\eta=\\tau))]\\quad(i\\in2),\\\\\n\\pi_0((\\rho,\\tau)):=\\rho,\\qquad\\pi_1((\\rho,\\tau)):=\\tau.\n\\end{gathered}","display":true}],"bytes":3881,"backlinks":[{"id":"210dad0d9d959bef","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"直接使用：see [[20-df-splitting-procedure]]。"},{"id":"2e72efb02984d69c","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-splitting-procedure]]；see [[20-lem-black-node-oracle-test]]；see [[20-lem-finite-tree-switches]]；see [[20-lem-minimality-tree]]。"},{"id":"cb6a5dd98b8b185b","anchor":"ref-13","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-splitting-procedure]]；see [[20-lem-black-restriction]]；see [[20-lem-splitting-totality]]；see [[20-lem-color-inheritance]]。"},{"id":"d85c7ced66d7ccee","anchor":"ref-42","locations":["正文"],"count":1,"excerpt":"[[20-df-splitting-procedure]]"},{"id":"005203b6707a19f4","anchor":"ref-351","locations":["正文"],"count":1,"excerpt":"[[20-df-splitting-procedure]] — 章 12；直接提供者 6 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-351","locations":["正文"],"count":1,"excerpt":"[[20-df-splitting-procedure]]"},{"id":"15cf85fd84eaf3f9","anchor":"ref-14","locations":["正文"],"count":1,"excerpt":"重点入口：编码与模型 [[20-df-strings]]、[[20-df-tmcomp]]、[[20-df-oracle-numbering]]；对象与接口 [[20-df-tred]]、[[20-df-characteristic]]、[[20-df-uniform-matrix]]；逻辑 [[20-df-formula]]、[[20-df-classical-proof-system]]、[[20-df-pa]]；树与构造 [[20-df-splitting-procedure]]、[[20-thm-closed-class-tree-equivalence]]；博弈 [[20-df-gale-stewart]]、[[2