}_L(\\mathfrak M,\\mathfrak M),\\\\\n\\operatorname{PartialElem}_{\\mathfrak M}(f)\\leftrightarrow{}&\n\\exists X\\subseteq|\\mathfrak M|\\;[f:X\\hookrightarrow|\\mathfrak M|\\\\\n&{}\\land\\forall n\\in\\omega\\;\\forall\\bar a\\in X^n\\;\\forall\\varphi\\in\\mathrm{Form}_{L,n}\\;\n(\\mathfrak M\\models\\varphi[\\bar a]\\leftrightarrow\\mathfrak M\\models\\varphi[f\\circ\\bar a])],\\\\\n\\operatorname{Homogeneous}_{\\kappa,L}(\\mathfrak M)\\leftrightarrow{}&\n\\mathrm{Cardinal}_S(\\kappa)\\land\\aleph_0\\leq\\kappa\\\\\n&{}\\land\\forall f\\;\\forall a\\in|\\mathfrak M|\\;\n\\left(\\operatorname{PartialElem}_{\\mathfrak M}(f)\\land|\\operatorname{dom}(f)|<\\kappa\\to\n\\exists g\\;(\\operatorname{PartialElem}_{\\mathfrak M}(g)\\land f\\subseteq g\\land a\\in\\operatorname{dom}(g))\\right),\\\\\n\\operatorname{Homogeneous}_L(\\mathfrak M)&\\leftrightarrow\n\\operatorname{Homogeneous}_{\\left|\\,|\\mathfrak M|\\,\\right|,L}(\\mathfrak M).\n\\end{aligned}","display":true},{"tex":"\\operatorname{Homogeneous}_{\\kappa,L}","display":false},{"tex":"\\aleph_0\\leq\\kappa","display":false},{"tex":"\\operatorname{Homogeneous}_L","display":false}],"bytes":3464,"backlinks":[{"id":"13c73c6f79ee78a7","anchor":"ref-64","locations":["正文"],"count":1,"excerpt":"[[17-df-homogeneous-model]]"},{"id":"2c98c9e634ff4b44","anchor":"ref-64","locations":["正文"],"count":1,"excerpt":"[[17-df-abstract-logic]]\n[[17-df-abstract-logic-compactness]]\n[[17-df-abstract-logic-lowenheim-skolem]]\n[[17-df-aleph-one-categoricity]]\n[[17-df-aleph-zero-categoricity]]\n[[17-df-algebraic-closure]]\n[[17-df-assignment]]\n[[17-df-assignment-predicate]]\n[[17-df-atomic-formula]]\n[[17-df-atomic-model]]\n[[17-df-atomic-model-notation]]\n[[17-df-bool-comb]]\n[[17-df-boolean-algebra]]\n[[17-df-boolean-valued-expansion]]\n[[17-df-boolean-valued-relation]]\n[[17-df-bound-variable]]\n[[17-df-cardinal-arithmetic]]\n[[17-df-cardinal-saturation]]\n[[17-df-categoricity]]\n[[17-df-chain-union]]\n[[17-df-chain-union-preser