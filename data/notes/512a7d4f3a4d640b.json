X,\\tau_X,\\mathbb K,\\tau_{\\mathbb K})\\leftrightarrow{}&\n\\mathrm{Top}(\\tau_X,X)\\land\\mathrm{Top}(\\tau_{\\mathbb K},\\mathbb K)\\\\\n&\\land\\exists +,\\odot\\in V\\;\\bigl(\\operatorname{VectorSpace}_{\\mathbb K}(X,+,\\odot)\\\\\n&\\quad\\land\\mathrm{Continuous}_S(+,X\\times X,\\operatorname{ProdTop}_S(X,\\tau_X,X,\\tau_X),X,\\tau_X)\\\\\n&\\quad\\land\\mathrm{Continuous}_S(\\odot,\\mathbb K\\times X,\\operatorname{ProdTop}_S(\\mathbb K,\\tau_{\\mathbb K},X,\\tau_X),X,\\tau_X)\\bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{TopologicalVectorSpace}_S(X,\\tau_X,\\mathbb K)\\leftrightarrow\n\\exists\\tau_{\\mathbb K}\\in V\\;\\mathrm{TopologicalVectorSpace}_S(X,\\tau_X,\\mathbb K,\\tau_{\\mathbb K}).","display":true},{"tex":"L^p","display":false},{"tex":"0<p<1","display":false},{"tex":"C(K)","display":false},{"tex":"\\text{Hilbert}\\subsetneq\\text{Banach}\\subsetneq\\text{normed}","display":false}],"bytes":2693,"backlinks":[{"id":"e7d979873300d8d4","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"60079d4c65597855","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1298","locations":["正文"],"count":1,"excerpt":"[[../batch13/58-df-topological-vector.md|58-df-topological-vector]]（batch13）"}],"outgoing":["592f9cfb66a507c2","e7514bc4cefba4f2","3cd1834de4f2efb2"]}