\rm ar}}","display":false},{"tex":"\\mathrm{AtFml}_{\\tau_{\\rm ar}}","display":false},{"tex":"\\mathrm{Fml}_{\\tau_{\\rm ar}}","display":false},{"tex":"\\mathrm{var}_{\\tau_{\\rm ar}}","display":false},{"tex":"\\mathrm{FV}","display":false},{"tex":"\\mathrm{Var}=\\{x_i:i\\in\\mathbb N\\}","display":false},{"tex":"\\bar x","display":false},{"tex":"\\operatorname{rng}","display":false},{"tex":"\\frown","display":false},{"tex":"\\mathsf B_Q","display":false},{"tex":"Q\\in\\{\\exists,\\forall\\}","display":false},{"tex":"\\mathfrak N_{\\rm ar}","display":false},{"tex":"\\mathrm{Assgn}","display":false},{"tex":"\\mathrm{AH}","display":false},{"tex":"\\operatorname{AHRel}_k","display":false},{"tex":"\\mathsf s,\\mathsf{add}_{\\rm ar},\\mathsf{mul}_{\\rm ar}\\in\\mathsf F","display":false},{"tex":"1,2,2","display":false},{"tex":"<\\in\\mathsf R","display":false},{"tex":"\\operatorname{ar}(<)=2","display":false},{"tex":"0\\in\\mathsf C","display":false},{"tex":"\\mathfrak N_{\\rm ar}","display":false},{"tex":"\\mathsf{add}_{\\rm ar},\\mathsf{mul}_{\\rm ar}","display":false},{"tex":"\\tau_{\\rm ar}\\coloneqq\\langle<^{(2)},0,\\mathsf s^{(1)},\\mathsf{add}_{\\rm ar}^{(2)},\\mathsf{mul}_{\\rm ar}^{(2)}\\rangle,\\qquad\\mathfrak N_{\\rm ar}\\coloneqq\\langle\\mathbb N,<,0,(u\\mapsto u+1),+,\\times\\rangle.","display":true},{"tex":"\\mathrm{ArithFml}\\coloneqq\\mathrm{Fml}_{\\tau_{\\rm ar}}.","display":true},{"tex":"\\Delta_0^0\\coloneqq\\bigcap\\left\\{D\\subseteq\\mathrm{ArithFml}\\ \\middle|\\ \\begin{aligned}&\\mathrm{AtFml}_{\\tau_{\\rm ar}}\\subseteq D,\\\\&\\forall\\phi,\\psi\\in D\\;(\\neg\\phi,\\phi\\land\\psi,\\phi\\lor\\psi)\\in D^3,\\\\&\\forall\\phi\\in D\\;\\forall x\\in\\mathrm{Var}\\;\\forall t\\in\\mathrm{Term}_{\\tau_{\\rm ar}}\\\\&\\quad\\left(x\\notin\\mathrm{var}_{\\tau_{\\rm ar}}(t)\\to(\\exists x(x<t\\land\\phi),\\forall x(x<t\\to\\phi))\\in D^2\\right)\\end{aligned}\\right\\}.","display":true},{"tex":"\\mathsf B_Q(\\langle\\rangle,\\phi)\\coloneqq\\phi,\