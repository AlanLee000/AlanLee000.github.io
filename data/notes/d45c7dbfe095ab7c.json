[x:=s]=s,\\quad y[x:=s]=y\\ (y\\ne x),\\quad c[x:=s]=c,\\quad\n\\mathsf{true}[x:=s]=\\mathsf{true},\\quad \\mathsf{false}[x:=s]=\\mathsf{false},","display":true},{"tex":"b[x:=s]=b,\\quad\n(A\\to B)[x:=s]=A[x:=s]\\to B[x:=s],","display":true},{"tex":"\\operatorname{rec}(\\ell_i:A_i)_{i<n}[x:=s]\n=\n\\operatorname{rec}(\\ell_i:A_i[x:=s])_{i<n},","display":true},{"tex":"(\\lambda y:A.t)[x:=s]=\n\\begin{cases}\n\\lambda y:A[x:=s].t,&y=x,\\\\\n\\lambda y:A[x:=s].t[x:=s],&y\\ne x,\\ y\\notin\\operatorname{FV}(s),\\\\\n\\lambda z:A[x:=s].(t[y:=z])[x:=s],&y\\ne x,\\ y\\in\\operatorname{FV}(s),\n\\end{cases}","display":true},{"tex":"z=\\operatorname{fresh}_{\\mathsf{PVS}}(\\operatorname{FV}(A)\\cup\\operatorname{BV}(A)\\cup\n\\operatorname{FV}(t)\\cup\\operatorname{BV}(t)\\cup\\operatorname{FV}(s)\\cup\\operatorname{BV}(s)\\cup\\{x,y\\})","display":false},{"tex":"(f\\,a)[x:=s]=f[x:=s]\\,a[x:=s],\n\\quad\n(t=u)[x:=s]=t[x:=s]=u[x:=s],","display":true},{"tex":"(P\\circ Q)[x:=s]=P[x:=s]\\circ Q[x:=s]\\quad(\\circ\\in\\{\\land,\\lor,\\Rightarrow\\}),\n\\quad\n(\\neg P)[x:=s]=\\neg(P[x:=s]),","display":true},{"tex":"(\\operatorname{record}(\\ell_i=r_i)_{i<n})[x:=s]=\\operatorname{record}(\\ell_i=r_i[x:=s])_{i<n},\n\\quad\n(r.\\ell)[x:=s]=(r[x:=s]).\\ell.","display":true},{"tex":"F(y,A,P)[x:=s]=\n\\begin{cases}\nF(y,A[x:=s],P),&y=x,\\\\\nF(y,A[x:=s],P[x:=s]),&y\\ne x,\\ y\\notin FV(s),\\\\\nF(z,A[x:=s],(P[y:=z])[x:=s]),&y\\ne x,\\ y\\in FV(s),\n\\end{cases}","display":true},{"tex":"\\mathsf{TreeDom}_{\\mathsf{PVS}}\\subseteq\\mathcal P_{\\mathrm{fin}}(\\mathbb N^{<\\omega})","display":false},{"tex":"D","display":false},{"tex":"D\\ne\\varnothing","display":false},{"tex":"\\forall p,q\\in\\mathbb N^{<\\omega}\\ (p^\\frown q\\in D\\Rightarrow p\\in D),\\qquad\n\\forall p\\in D\\ \\exists n\\in\\mathbb N\\ \\forall i\\in\\mathbb N\\\n(p^\\frown\\langle i\\rangle\\in D\\Longleftrightarrow i<n).","display":true},{"tex":"\\operatorname{root}(D)=\\langle\\rangle","display":false},{"tex":"\\operatorname{arity}_D(p)=|\\{i\\in\\mathbb N:p^\\frown\\langle i\\rangle\\in D\\}|","display":false},{"tex":"\\operatorname{edge}_D=\\{(p,i,p^\\frown\\langle i\\rangle):p\\in D,\\ i<\\operatorname{arity}_D(p)\\}.","display":true},{"tex":"\\mathsf{BaseDer}_{\\mathsf{PVS}}=\\left\\{(D,\\ell):D\\in\\mathsf{TreeDom}_{\\mathsf{PVS}},\\\n\\ell:D\\to\\mathsf{Jud}_{\\mathsf{PVS}},\\\n\\forall p\\in D\\\n\\left((\\ell(p^\\frown\\langle i\\rangle))_{i<\\operatorname{arity}_D(p)},\\ell(p)\\right)\\in\\mathsf{BaseRule}_{\\mathsf{PVS}}\n\\right\\}.","display":true},{"tex":"\\mathsf{FullDer}_{\\mathsf{PVS}}=\\{(D,\\ell):D\\in\\mathsf{TreeDom}_{\\mathsf{PVS}},\\ell:D\\to\\mathsf{Jud}_{\\mathsf{PVS}},\\\n\\forall p\\in D\\ (((\\ell(p^\\frown\\langle i\\rangle))_{i<\\operatorname{arity}_D(p)},\\ell(p))\\in\\mathsf{Rule}_{\\mathsf{PVS}})\\}.","display":true},{"tex":"\\mathsf{ProofObl}_{\\mathsf{PVS}}(K)=\\operatorname{ran}(\\mathsf{TCCGen}_{\\mathsf{PVS}}(K)),","display":true},{"tex":"\\mathsf{TCCDer}_{\\mathsf{PVS}}(K,\\Theta)\\Longleftrightarrow\n\\operatorname{dom}(\\Theta)=\\operatorname{dom}(\\mathsf{TCCGen}_{\\mathsf{PVS}}(K))\n\\land\\forall q\\in\\operatorname{dom}(\\Theta)\\\n\\Theta(q)\\in\\mathsf{FullDer}_{\\mathsf{PVS}}\\land\n\\operatorname{rootJdg}(\\Theta(q))=\\mathsf{TCCGen}_{\\mathsf{PVS}}(K)(q).","display":true},{"tex":"\\mathcal{PVS}\n=\n(\\mathsf{Ty}_{\\mathsf{PVS}},\n\\mathsf{Var}_{\\mathsf{PVS}},\n\\mathsf{Base},\n\\mathsf{Const}_{\\mathsf{PVS}},\n\\mathsf{Lab}_{\\mathsf{PVS}},\n\\Sigma_{\\mathsf{PVS}},\n\\mathsf{Tm}_{\\mathsf{PVS}},\n\\mathsf{Ctx}_{\\mathsf{PVS}},\n\\mathsf{Jud}_{\\mathsf{PVS}},\n\\operatorname{FV}_{\\mathsf{PVS}},\n\\operatorname{BV}_{\\mathsf{PVS}},\n\\operatorname{fresh}_{\\mathsf{PVS}},\n\\operatorname{Sub}_{\\mathsf{PVS}},\n\\equiv_\\alpha^{\\mathsf{PVS}},\n\\mathsf{AxJdg}_{\\mathsf{PVS}},\n\\operatorname{TCC}_{\\mathsf{PVS}},\n\\operatorname{PartialAppTCC}_{\\mathsf{PVS}},\n\\mathsf{Rule}_{PartialApp}^{PVS},\n\\mathsf{TreeDom}_{\\mathsf{PVS}},\\mathsf{BaseDer}_{\\mathsf{PVS}},\\mathsf{FullDer}_{\\mathsf{PVS}},\\mathsf{Plan}_{\\mathsf{PVS}},\\mathsf{SkelDer}_{\\mathsf{PVS}},\n\\mathsf{TCCGen}_{\\mathsf{PVS}},\n\\mathsf{ProofObl}_{\\mathsf{PVS}},\n\\mathsf{TypingRule}_{\\mathsf{PVS}},\n\\mathsf{ConvCert}_{\\mathsf{PVS}},\n\\mathsf{PredConvCert}_{\\mathsf{PVS}},\n\\mathsf{TCCDer}_{\\mathsf{PVS}},\n\\mathsf{Rule}_{\\mathsf{PVS}},\n\\mathsf{Der}_{\\mathsf{PVS}},\n\\vdash_{\\mathsf{PVS}},\n\\mathsf{Delta}_{\\mathsf{PVS}}).","display":true}],"bytes":21360,"backlinks":[],"outgoing":[]}