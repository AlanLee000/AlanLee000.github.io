ton\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Brun's theorem asserts that this twin-prime reciprocal series converges.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-prime-number","status":"resolved","id":"dad686059f3ca152","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-prime-number]]","embed":false},{"target":"58-df-sieve","status":"resolved","id":"03087ea1802e2ea2","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-sieve]]","embed":false},{"target":"58-df-prime-number","status":"resolved","id":"dad686059f3ca152","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathbb{P}$ (prime set, see [[58-df-prime-number]])","embed":false}],"math":[{"tex":"\\mathbb{P}","display":false},{"tex":"B_2","display":false},{"tex":"\\mathrm{df\\text{-}brun} \\vdash B_2 \\coloneqq \\sum_{\\substack{p\\in\\mathbb{P}\\\\ p+2\\in\\mathbb{P}}}\\left(\\frac{1}{p}+\\frac{1}{p+2}\\right)","display":true}],"bytes":575,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-220","locations":["正文"],"count":1,"excerpt":"[[../batch16/58-df-brun.md|58-df-brun]]（batch16）"}],"outgoing":["dad686059f3ca152","03087ea1802e2ea2"]}