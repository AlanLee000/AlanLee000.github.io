a_{j,i}\\coloneqq P_j(x,\\epsilon,h_{j,i-1}^{\\frown}\\langle q_{j,i}\\rangle),\\quad h_{j,i}\\coloneqq h_{j,i-1}^{\\frown}\\langle q_{j,i},a_{j,i}\\rangle\\quad(1\\le i\\le t(|x|),\\ 1\\le j\\le k).","display":true},{"tex":"\\operatorname{Acc}_{P_1,\\ldots,P_k;V}(x)\\coloneqq\\Pr_{r\\leftarrow U_{p(|x|)}}[D(x,r,H_{t(|x|)})=1].","display":true},{"tex":"\\begin{aligned}\n\\mathbf{MIP}\\coloneqq\\{L\\subseteq\\Sigma^*:\\exists k\\in\\mathbb N_{\\ge2}\\ \\exists V=(t,b,p,Q_1,\\ldots,Q_k,D)\\in\\mathsf{MIV}_k\\ \\exists P_1,\\ldots,P_k\\in\\mathsf{Strat}_b\\ [\\;&\\forall x\\in L\\ \\operatorname{Acc}_{P_1,\\ldots,P_k;V}(x)\\ge2/3\\\\\n&\\land\\forall x\\in\\Sigma^*\\setminus L\\ \\forall P_1^*,\\ldots,P_k^*\\in\\mathsf{Strat}_b\\ \\operatorname{Acc}_{P_1^*,\\ldots,P_k^*;V}(x)\\le1/3]\\}.\n\\end{aligned}","display":true}],"bytes":3742,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-134","locations":["正文"],"count":1,"excerpt":"交互协议：[[28-df-interactive-transcript]]、[[28-df-completeness-soundness]]、[[28-df-ip]]、[[28-df-am]]、[[28-df-ma]]、[[28-df-mip]]。"},{"id":"8ce4101309cb3ce8","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""}],"outgoing":["adb92775ec020a0b","3e270c20bc5033b3"]}