&\nn\\in\\omega\\land\\bar x:n\\hookrightarrow\\mathrm{Var}_{93}\n\\land X=\\operatorname{ran}(\\bar x)\n\\land\\mathrm{Alg}_{\\tau}(\\mathbf A)\n\\land\\mathrm{Term}_{93}(t;\\tau,X)\\\\\n&\\to\\exists!f\\;\\Bigl(f:|\\mathbf A|^n\\to|\\mathbf A|\\land\n\\forall\\bar a\\in|\\mathbf A|^n\\;\nf(\\bar a)=\\operatorname{Eval}^{\\mathbf A,\\tau}_{\n\\operatorname{TupleVal}_{93}(\\bar a;\\bar x,n)}(t)\\Bigr).\n\\end{aligned}","display":true}],"bytes":1665,"backlinks":[{"id":"004b454b6cf02e89","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""}],"outgoing":["ca7404158049be33","6730349967b8ffce","096eaa05407a0ec3","11b62d0ad578fa42"]}