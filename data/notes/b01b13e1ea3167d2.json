b R))","display":false},{"tex":"(X(n))_{n\\geq1}","display":false},{"tex":"\\nu","display":false},{"tex":"\\operatorname{ExpectedValue}_S(z,Y;\\Omega,\\mathcal F,\\mathbb P)","display":false},{"tex":"\\mathrm{ZfcProb3ConvergenceInDistribution}_S\\subseteq V^8","display":false},{"tex":"\\mathrm{Polish}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcProbProbabilitySpace}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{Function}","display":false},{"tex":"\\tau_{\\mathbb R}","display":false},{"tex":"\\mathcal B(\\mathbb R)=\\sigma(\\tau_{\\mathbb R})","display":false},{"tex":"m","display":false},{"tex":"s>0","display":false},{"tex":"s^2","display":false},{"tex":"\\mathrm{StandardRealTopology}_S(\\tau_{\\mathbb R})","display":false},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}clt}\\vdash{}&\\Bigl[\n\\mathrm{ZfcProbProbabilitySpace}_S(\\Omega,\\mathcal F,\\mathbb P)\n\\land\\mathrm{StandardRealTopology}_S(\\tau_{\\mathbb R})\\land\\mathrm{Polish}_S(\\mathbb R,\\tau_{\\mathbb R})\n\\land\\mathcal B(\\mathbb R)=\\sigma(\\tau_{\\mathbb R})\\\\\n&\\land\\mathrm{IID}_S(X,\\mathbb N_{>0},\\nu;\\Omega,\\mathcal F,\\mathbb P,\\mathbb R,\\mathcal B(\\mathbb R))\n\\land m\\in\\mathbb R\\land s\\in\\mathbb R_{>0}\\\\\n&\\land\\operatorname{ExpectedValue}_S(m,X(1);\\Omega,\\mathcal F,\\mathbb P)\\\\\n&\\land\\exists W\\in V\\;\\Bigl(\n\\mathrm{Function}(W,\\Omega,\\mathbb R_{\\geq0})\n\\land\\forall u\\in\\Omega\\;\\bigl(W(u)=(X(1)(u)-m)^2\\bigr)\n\\land\\operatorname{ExpectedValue}_S(s^2,W;\\Omega,\\mathcal F,\\mathbb P)\n\\Bigr)\\\\\n&\\land\\operatorname{Gaussian}_S(Z;0,1;\\Omega,\\mathcal F,\\mathbb P)\n\\Bigr]\\\\\n&\\to\\exists S,\\vec Y\\in V\\;\\Bigl[\n\\mathrm{Function}(S,\\omega,\\mathbb R^\\Omega)\n\\land S(0)=\\{\\langle u,0\\rangle:u\\in\\Omega\\}\\\\\n&\\qquad\\land\\forall n\\in\\omega\\;\\forall u\\in\\Omega\\;\\bigl(S(n+1)(u)=S(n)(u)+X(n+1)(u)\\bigr)\\\\\n&\\qquad\\land\\mathrm{Function}(\\vec Y,\\omega,\\mathbb R^\\Omega)\n\\land\\vec Y(0)=Z\\\\\n&\\qquad\\land\\forall n\\in\\omega\\setminus\\{0\\}\\;\\forall u\\in\\Omega\\;\n\\left(\\vec Y(n)(u)=\\frac{S(n)(u)-n\\cdot m}{s\\sqrt n}\\right)\\\\\n&\\qquad\\land\\mathrm{ZfcProb3ConvergenceInDistribution}_S\n(\\Omega,\\mathcal F,\\mathbb P,\\mathbb R,\\tau_{\\mathbb R},\\mathcal B(\\mathbb R),\\vec Y,Z)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"S","display":false},{"tex":"\\vec Y(0)=Z","display":false},{"tex":"\\omega","display":false},{"tex":"n\\geq1","display":false},{"tex":"\\vec Y(n)","display":false},{"tex":"\\mathbb E","display":false},{"tex":"\\operatorname{Var}","display":false}],"bytes":3658,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4076","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-thm-clt.md|58-thm-clt]]（batch02）"}],"outgoing":["3b5b3d48ff1ff369","c96eb70b5fd08810","64b5bf078722d744","2e4ee9615831113b","b961383f1e02dd7e","36d7463d215be751","4b3a8629f6a6f868","d4d304b0bbb11c1a"]}