M,R)\n\\end{array}\n\\to\n\\exists g\\in V\\;\n\\bigl(\n\\mathrm{ZfcAlgebra2ModuleHomomorphism}_S(g,P,M,R)\n\\land g\\circ i=f\n\\bigr)\n\\right].","display":true}],"bytes":1808,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1017","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-pure-injective.md|58-df-pure-injective]]（batch10）"}],"outgoing":["ef3a5dd6825f0373","25e593b1b8714c23","8317eefb4572709e","9bf75150bce95ccc"]}