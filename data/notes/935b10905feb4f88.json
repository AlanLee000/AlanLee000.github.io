del6TermAlgebra}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcLogicTermAlgebra}_S,\\mathrm{ZfcModel6TermAlgebra}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}logic\\text{-}term\\text{-}algebra} \\vdash \\mathrm{ZfcLogicTermAlgebra}_S(T,L)\\leftrightarrow \\exists V_0,C,F,\\operatorname{ar}\\in V\\;\\Bigl(L=\\langle V_0,C,F,\\operatorname{ar}\\rangle\\land\\mathrm{Function}(\\operatorname{ar},F,\\omega)\\land\\{\\langle0,v\\rangle\\mid v\\in V_0\\}\\cup\\{\\langle1,c\\rangle\\mid c\\in C\\}\\subseteq T\\land\\forall f\\in F\\;\\forall\\bar t\\in T^{\\operatorname{ar}(f)}\\;(\\langle2,f,\\bar t\\rangle\\in T)\\land\\forall A\\in V\\;\\Bigl((\\{\\langle0,v\\rangle\\mid v\\in V_0\\}\\cup\\{\\langle1,c\\rangle\\mid c\\in C\\}\\subseteq A\\land\\forall f\\in F\\;\\forall\\bar t\\in A^{\\operatorname{ar}(f)}\\;(\\langle2,f,\\bar t\\rangle\\in A))\\to T\\subseteq A\\Bigr)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}logic\\text{-}term\\text{-}algebra} \\vdash \\mathrm{ZfcLogicTermAlgebra}_S(T,L)\\leftrightarrow \\exists V_0,C,F,\\operatorname{ar}\\in V\\;\\Bigl(L=\\langle V_0,C,F,\\operatorname{ar}\\rangle\\land\\mathrm{Function}(\\operatorname{ar},F,\\omega)\\land\\{\\langle0,v\\rangle\\mid v\\in V_0\\}\\cup\\{\\langle1,c\\rangle\\mid c\\in C\\}\\subseteq T\\land\\forall f\\in F\\;\\forall\\bar t\\in T^{\\operatorname{ar}(f)}\\;(\\langle2,f,\\bar t\\rangle\\in T)\\land\\forall A\\in V\\;\\Bigl((\\{\\langle0,v\\rangle\\mid v\\in V_0\\}\\cup\\{\\langle1,c\\rangle\\mid c\\in C\\}\\subseteq A\\land\\forall f\\in F\\;\\forall\\bar t\\in A^{\\operatorname{ar}(f)}\\;(\\langle2,f,\\bar t\\rangle\\in A))\\to T\\subseteq A\\Bigr)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\