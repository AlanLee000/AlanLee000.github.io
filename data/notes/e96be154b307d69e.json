resolved","id":"a4894b7383014259","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\alpha,\\gamma\\in\\mathcal L$；$\\mathcal L$ 与 $<_S$ 采用 [[43-df-solovay-degree]]。","embed":false}],"attachments":[],"math":[{"tex":"\\alpha,\\gamma\\in\\mathcal L","display":false},{"tex":"\\mathcal L","display":false},{"tex":"<_S","display":false},{"tex":"\\gamma<_S\\alpha\\implies\\exists\\beta\\in\\mathcal L\\;\\bigl(\\gamma<_S\\beta\\land\\beta<_S\\alpha\\bigr).","display":true}],"bytes":1579,"backlinks":[{"id":"f5b5175508d7a1c1","anchor":"ref-322","locations":["正文"],"count":1,"excerpt":"[[43-thm-solovay-density]] — Density of the Left-c.e. Solovay Degrees"}],"outgoing":["a4894b7383014259"]}