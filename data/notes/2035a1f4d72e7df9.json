m{free}_L(t=u)&\\coloneqq\\mathrm{free}_L(t)\\cup\\mathrm{free}_L(u),&\n\\mathrm{free}_L(R(\\vec t))&\\coloneqq\\bigcup_{i<|\\vec t|}\\mathrm{free}_L(t_i),\\\\\n\\mathrm{free}_L(\\neg\\varphi)&\\coloneqq\\mathrm{free}_L(\\varphi),&\n\\mathrm{free}_L(\\varphi\\land\\psi)&\\coloneqq\\mathrm{free}_L(\\varphi)\\cup\\mathrm{free}_L(\\psi),\\\\\n\\mathrm{free}_L(\\forall x\\varphi)&\\coloneqq\\mathrm{free}_L(\\varphi)\\setminus\\{x\\},\\\\\n\\operatorname{var}(x)&\\coloneqq\\{x\\},&\\operatorname{var}(f(\\vec t))&\\coloneqq\\bigcup_i\\operatorname{var}(t_i),\\\\\n\\operatorname{var}(t=u)&\\coloneqq\\operatorname{var}(t)\\cup\\operatorname{var}(u),&\\operatorname{var}(R(\\vec t))&\\coloneqq\\bigcup_i\\operatorname{var}(t_i),\\\\\n\\operatorname{var}(\\neg\\varphi)&\\coloneqq\\operatorname{var}(\\varphi),&\\operatorname{var}(\\varphi\\land\\psi)&\\coloneqq\\operatorname{var}(\\varphi)\\cup\\operatorname{var}(\\psi),\\\\\n\\operatorname{var}(\\forall x\\varphi)&\\coloneqq\\{x\\}\\cup\\operatorname{var}(\\varphi),\\\\\n\\operatorname{fresh}(A)&\\coloneqq v_{\\min\\{i:v_i\\notin A\\}},&\n\\mathrm{Distinct}_L(\\vec x)&\\Longleftrightarrow\\forall i<j<|\\vec x|\\ (x_i\\ne x_j),\\\\\n\\operatorname{FreshSeq}_L(A,0)&\\coloneqq\\epsilon,\\\\\n\\operatorname{FreshSeq}_L(A,m+1)&\\coloneqq\\operatorname{FreshSeq}_L(A,m){}^\\frown\n\\left\\langle\\operatorname{fresh}\\!\\bigl(A\\cup\\{(\\operatorname{FreshSeq}_L(A,m))_i:i<m\\}\\bigr)\\right\\rangle,\\\\\n\\mathrm{Subst}_L&\\coloneqq\\left\\{\\sigma\\in\\mathrm{Term}_L^{\\mathrm{Var}_L}:\n\\bigl|\\{x\\in\\mathrm{Var}_L:\\sigma(x)\\ne x\\}\\bigr|<\\aleph_0\\right\\},\\\\\n(\\sigma\\setminus x)(y)&\\coloneqq\\begin{cases}x,&y=x,\\\\\\sigma(y),&y\\ne x,\\end{cases}\n\\quad(\\sigma\\in\\mathrm{Subst}_L),\\\\\n\\sigma_{\\vec x,\\vec t}(y)&\\coloneqq\\begin{cases}\nt_{\\iota i<|\\vec x|\\ (x_i=y)},&y\\in\\{x_i:i<|\\vec x|\\},\\\\\ny,&y\\notin\\{x_i:i<|\\vec x|\\},\n\\end{cases}\\\\\n\\mathrm{Fml}_L[x_0,\\ldots,x_{m-1}]&\\coloneqq\\mathrm{Fml}_L[\\langle x_0,\\ldots,x_{m-1}\\rangle],\\\\\n\\mathrm{Fml}_L[\\vec x]&\\coloneqq\\{\\varphi\\in\\mathrm{Fml}_L:\\mathrm{free}_L(\\varphi)\\subseteq\\{x_i:i<|\\vec x|\\}\\},\\\\\n\\operatorname{VList}(A)&\\coloneqq\\iota\\vec x\\bigl[\\mathrm{Distinct}_L(\\vec x)\\land\\{x_i:i<|\\vec x|\\}=A\\land\\forall i<j<|\\vec x|\\ \\operatorname{ind}(x_i)<\\operatorname{ind}(x_j)\\bigr],&\\operatorname{ind}(v_i)&\\coloneqq i.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\operatorname{Sub}_L(a,\\sigma)&\\coloneqq a[\\sigma]\n\\quad(a\\in\\mathrm{Term}_L\\cup\\mathrm{Fml}_L\\land\\sigma\\in\\mathrm{Subst}_L),\\\\\na[\\vec t/\\vec x]&\\coloneqq a[\\sigma_{\\vec x,\\vec t}],\\\\\nr_{x,z}(y)&\\coloneqq\\begin{cases}z,&y=x,\\\\y,&y\\ne x,\\end{cases}&\nr_{x,z}(f(\\vec t))&\\coloneqq f((r_{x,z}(t_i))_i),\\\\\nr_{x,z}(t=u)&\\coloneqq(r_{x,z}(t)=r_{x,z}(u)),&\nr_{x,z}(R(\\vec t))&\\coloneqq R((r_{x,z}(t_i))_i),\\\\\nr_{x,z}(\\neg\\varphi)&\\coloneqq\\neg r_{x,z}(\\varphi),&\nr_{x,z}(\\varphi\\land\\psi)&\\coloneqq r_{x,z}(\\varphi)\\land r_{x,z}(\\psi),\\\\\nr_{x,z}(\\forall y\\varphi)&\\coloneqq\\begin{cases}\\forall y\\varphi,&y=x,\\\\\\forall y\\,r_{x,z}(\\varphi),&y\\ne x,\\end{cases}\\\\\nx[\\sigma]&\\coloneqq\\sigma(x),&f(\\vec t)[\\sigma]&\\coloneqq f((t_i[\\sigma])_i),\\\\\n(t=u)[\\sigma]&\\coloneqq(t[\\sigma]=u[\\sigma]),&R(\\vec t)[\\sigma]&\\coloneqq R((t_i[\\sigma])_i),\\\\\n(\\neg\\varphi)[\\sigma]&\\coloneqq\\neg(\\varphi[\\sigma]),&\n(\\varphi\\land\\psi)[\\sigma]&\\coloneqq\\varphi[\\sigma]\\land\\psi[\\sigma],\\\\\nB_{x,\\varphi,\\sigma}&\\coloneqq\\bigcup_{y\\in\\mathrm{free}_L(\\varphi)\\setminus\\{x\\}}\\mathrm{free}_L(\\sigma(y)),\\\\\nz_{x,\\varphi,\\sigma}&\\coloneqq\\operatorname{fresh}(\\operatorname{var}(\\varphi)\\cup B_{x,\\varphi,\\sigma}\\cup\\{x\\}),\\\\\n(\\forall x\\varphi)[\\sigma]&\\coloneqq\n\\begin{cases}\n\\forall x(\\varphi[\\sigma\\setminus x]),&x\\notin B_{x,\\varphi,\\sigma},\\\\\n\\forall z\\bigl(r_{x,z}(\\varphi)[\\sigma\\setminus x\\setminus z]\\bigr),&x\\in B_{x,\\varphi,\\sigma},\\ z=z_{x,\\varphi,\\sigma}.\n\\end{cases}\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\varphi\\lor\\psi&\\coloneqq\\neg(\\neg\\varphi\\land\\neg\\psi),&\n\\varphi\\to\\psi&\\coloneqq\\neg(\\varphi\\land\\neg\\psi),\\\\\n\\varphi\\leftrightarrow\\psi&\\coloneqq(\\varphi\\to\\psi)\\land(\\psi\\to\\varphi),&\n\\exists x\\varphi&\\coloneqq\\neg\\forall x\\neg\\varphi,\\\\\n\\top_L&\\coloneqq\\forall v_0(v_0=v_0),&\\bot_L&\\coloneqq\\neg\\top_L,\\\\\n\\forall\\epsilon\\,\\varphi&\\coloneqq\\varphi,&\\forall(\\langle x\\rangle{}^\\frown\\vec y)\\varphi&\\coloneqq\\forall x(\\forall\\vec y\\,\\varphi),\\\\\n\\exists\\epsilon\\,\\varphi&\\coloneqq\\varphi,&\\exists(\\langle x\\rangle{}^\\frown\\vec y)\\varphi&\\coloneqq\\exists x(\\exists\\vec y\\,\\varphi),\\\\\n\\bigwedge\\epsilon&\\coloneqq\\top_L,&\\bigwedge(\\langle\\varphi\\rangle{}^\\frown s)&\\coloneqq\\varphi\\land\\bigwedge s,\\\\\n\\bigvee\\epsilon&\\coloneqq\\bot_L,&\\bigvee(\\langle\\varphi\\rangle{}^\\frown s)&\\coloneqq\\varphi\\lor\\bigvee s,\\\\\n\\exists!x\\varphi&\\coloneqq\\exists x\\bigl(\\varphi\\land\\forall z(\\varphi[z/x]\\to z=x)\\bigr)\\quad(z=\\operatorname{fresh}(\\operatorname{var}(\\varphi)\\cup\\{x\\})),\\\\\n\\operatorname{ucl}_L(\\varphi)&\\coloneqq\\forall\\operatorname{VList}(\\mathrm{free}_L(\\varphi))\\,\\varphi.\n\\end{aligned}","display":true},{"tex":"\\iota","display":false}],"bytes":7726,"backlinks":[{"id":"97e929795d778cd6","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"5fa3acf328238c71","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"851cd80e64893935","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$L_A=L_{\\mathrm{arith}}$；公式、自由变量、无捕获代入、变量表的 $\\mathrm{Distinct}_{L_A}$、$\\operatorname{ucl}_{L_A}$ 和 $\\bar m$ 取 [[67-df-formula]] 的算术实例及标准数词。$\\mathrm{PR}_k$ 取 [[67-df-primitive-recursive]]，$k\\ge1$。"},{"id":"d404f437