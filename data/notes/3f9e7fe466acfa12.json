{"id":"3f9e7fe466acfa12","group":"58","path":"58/batch01/58-df-chart.md","title":"Chart","display":"df-chart — Chart","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-chart","aliases":["58-df-chart"],"display":"df-chart — Chart","depends_on":["[[../batch03/58-df-euclidean-topological-data.md]]","[[../batch12/58-df-topological-space.md]]","[[../batch04/58-df-homeomorphism.md]]","[[../batch16/58-df-function.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-chart"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-chart</span></div>"},{"key":"display","html":"df-chart — Chart"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"ca7fc3ab38a11801\" href=\"?note=ca7fc3ab38a11801\" title=\"../batch03/58-df-euclidean-topological-data.md\">../batch03/58-df-euclidean-topological-data.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"815e63e5071e7b58\" href=\"?note=815e63e5071e7b58\" title=\"../batch12/58-df-topological-space.md\">../batch12/58-df-topological-space.md</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"c4b4a825f2ea608d\" href=\"?note=c4b4a825f2ea608d\" title=\"../batch04/58-df-homeomorphism.md\">../batch04/58-df-homeomorphism.md</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"M,\\mathcal T,U,W,n\\in V,\\ n\\in\\mathbb N\">\\(M,\\mathcal T,U,W,n\\in V,\\ n\\in\\mathbb N\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"U\\subseteq M,\\ W\\subseteq\\mathbb R^n\">\\(U\\subseteq M,\\ W\\subseteq\\mathbb R^n\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\tau_{\\mathbb R^n}\\coloneqq\\mathrm{EuclideanSubspaceTopology}_S(\\mathbb R^n,n)\">\\(\\tau_{\\mathbb R^n}\\coloneqq\\mathrm{EuclideanSubspaceTopology}_S(\\mathbb R^n,n)\\)</span>，使用 <a class=\"wiki-link\" id=\"ref-5\" data-note=\"ca7fc3ab38a11801\" href=\"?note=ca7fc3ab38a11801\" title=\"../batch03/58-df-euclidean-topological-data.md\">../batch03/58-df-euclidean-topological-data.md</a>。</li>\n<li><span class=\"math-inline\" data-tex=\"\\varphi\\subseteq U\\times W\">\\(\\varphi\\subseteq U\\times W\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{TopologicalSpace}_S\">\\(\\operatorname{TopologicalSpace}_S\\)</span> (topological-space predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"815e63e5071e7b58\" href=\"?note=815e63e5071e7b58\" title=\"../batch12/58-df-topological-space.md\">../batch12/58-df-topological-space.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (function predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Homeo}_S\">\\(\\mathrm{Homeo}_S\\)</span> (homeomorphism predicate, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"c4b4a825f2ea608d\" href=\"?note=c4b4a825f2ea608d\" title=\"../batch04/58-df-homeomorphism.md\">../batch04/58-df-homeomorphism.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Chart}_S\">\\(\\mathrm{Chart}_S\\)</span> (chart predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}chart} \\vdash \\mathrm{Chart}_S(U,W,\\varphi,M,\\mathcal T,n)\\leftrightarrow n\\in\\mathbb N\\land\\operatorname{TopologicalSpace}_S(M,\\mathcal T)\\land U\\in\\mathcal T\\land W\\in\\tau_{\\mathbb R^n}\\