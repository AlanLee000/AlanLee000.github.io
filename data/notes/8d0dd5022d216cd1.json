omic}_\\Sigma(\\varphi)\\land\\psi=\\neg\\varphi)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}atomic\\text{-}literal}\\vdash\n\\mathrm{AtomicLiteral}_\\Sigma(\\psi)\\leftrightarrow\n\\mathrm{Atomic}_\\Sigma(\\psi)\\lor\n\\exists\\varphi\\in V\\;(\\mathrm{Atomic}_\\Sigma(\\varphi)\\land\\psi=\\neg\\varphi)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}atomic\\text{-}diagram} \\vdash\n\\mathrm{Struct}_S(M,\\Sigma)\n\\to\\mathrm{ZfcLogic9AtomicDiagram}_S(M,\\Sigma)\\coloneqq\n\\{\\langle\\psi,\\vec a\\rangle:\\psi\\in\\mathrm{Fml}_S(\\Sigma)\\land\n\\mathrm{AtomicLiteral}_\\Sigma(\\psi)\\land\n\\vec a\\in\\mathrm{Univ}(M)^{&lt;\\omega}\\land\n\\mathrm{TupleTruth}_S(M,\\Sigma,\\psi,\\vec a,\\varnothing)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}atomic\\text{-}diagram} \\vdash\n\\mathrm{Struct}_S(M,\\Sigma)\n\\to\\mathrm{ZfcLogic9AtomicDiagram}_S(M,\\Sigma)\\coloneqq\n\\{\\langle\\psi,\\vec a\\rangle:\\psi\\in\\mathrm{Fml}_S(\\Sigma)\\land\n\\mathrm{AtomicLiteral}_\\Sigma(\\psi)\\land\n\\vec a\\in\\mathrm{Univ}(M)^{&lt;\\omega}\\land\n\\mathrm{TupleTruth}_S(M,\\Sigma,\\psi,\\vec a,\\varnothing)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Parameters are represented canonically by pairs <span class=\"math-inline\" data-tex=\"\\langle\\psi,\\vec a\\rangle\">\\(\\langle\\psi,\\vec a\\rangle\\)</span> rather than by an undeclared expanded signature <span class=\"math-inline\" data-tex=\"\\Sigma(M)\">\\(\\Sigma(M)\\)</span>. Tuple truth supplies the assignment and the selected satisfaction recursion.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":