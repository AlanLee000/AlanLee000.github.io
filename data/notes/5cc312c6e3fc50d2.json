,t\\in\\{0,1\\}^{<\\omega}","display":false},{"tex":"m,i,j\\in\\mathbb N","display":false},{"tex":"|w|","display":false},{"tex":"w_i","display":false},{"tex":"\\frown","display":false},{"tex":"<_{\\mathrm{lex}}","display":false},{"tex":"<_{\\mathrm{sl}}","display":false},{"tex":"b","display":false},{"tex":"w","display":false},{"tex":"\\ell_m","display":false},{"tex":"\\operatorname{bin}","display":false},{"tex":"\\mathrm{BinRep}","display":false},{"tex":"\\begin{aligned}\ns<_{\\mathrm{lex}}t\\ \\Longleftrightarrow\\;&\n(|s|<|t|\\land\\forall j<|s|\\ s_j=t_j)\\\\\n&\\lor\\exists i<\\min\\{|s|,|t|\\}\\ [(\\forall j<i\\ s_j=t_j)\\land s_i=0\\land t_i=1],\\\\\ns<_{\\mathrm{sl}}t&\\ \\Longleftrightarrow\\ |s|<|t|\\lor(|s|=|t|\\land s<_{\\mathrm{lex}}t),\\\\\nB(m,s)&\\ \\Longleftrightarrow\\ K_U(s)>m\\land\n\\forall t\\in\\{0,1\\}^{<\\omega}\\ (t<_{\\mathrm{sl}}s\\Longrightarrow K_U(t)\\le m),\\\\\n&\\forall m\\in\\mathbb N\\ \\exists!s\\in\\{0,1\\}^{<\\omega}\\ B(m,s),\\\\\nb&\\coloneqq\\{(m,s)\\in\\mathbb N\\times\\{0,1\\}^{<\\omega}:B(m,s)\\},\\\\\nb&:\\mathbb N\\to\\{0,1\\}^{<\\omega}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{BinRep}(m,s)&\\ \\Longleftrightarrow\\ |s|>0\\land s_0=1\n\\land m+1=\\sum_{i<|s|}s_i2^{|s|-1-i},\\\\\n&\\forall m\\in\\mathbb N\\ \\exists!s\\in\\{0,1\\}^{<\\omega}\\ \\mathrm{BinRep}(m,s),\\\\\nw&\\coloneqq\\{(m,s)\\in\\mathbb N\\times\\{0,1\\}^{<\\omega}:\\mathrm{BinRep}(m,s)\\},\\\\\nw&:\\mathbb N\\to\\{0,1\\}^{<\\omega},\\\\\n\\ell_m&\\coloneqq|w(m)|,\\\\\n\\operatorname{bin}(m)&\\coloneqq(1)_{i<\\ell_m}\\,{}^\\frown(0)_{i<1}\\,{}^\\frown w(m).\n\\end{aligned}","display":true},{"tex":"\\mathrm{Effective}(K_U)\\Longrightarrow\\exists c,m_0\\in\\mathbb N\\ \\forall m\\ge m_0\\quad\nm<K_U(b(m))\\le K_U(\\operatorname{bin}(m))+c<m.","display":true},{"tex":"\\neg\\mathrm{Effective}(K_U).","display":true},{"tex":"K_U","display":false},{"tex":"b","display":false},{"tex":"V","display":false},{"tex":"p","display":false},{"tex":"U(p)","display":false},{"tex":"\\operatorname{bin}(m)","display":false},{"tex":"b(m)","display":false},{"tex":"\\operatorname{dom}(U)","display":false},{"tex":"c","display":false},{"tex":"K_U(b(m))\\le K_U(\\operatorname{bin}(m))+c","display":false},{"tex":"\\operatorname{bin}","display":false},{"tex":"c_0","display":false},{"tex":"K_U(\\operatorname{bin}(m))\\le2\\ell_m+1+c_0","display":false},{"tex":"m_0","display":false},{"tex":"2\\ell_m+1+c_0+c<m","display":false},{"tex":"m\\ge m_0","display":false},{"tex":"b","display":false},{"tex":"\\operatorname{bin}","display":false},{"tex":"c","display":false}],"bytes":3361,"backlinks":[{"id":"da1a6647840ffca5","anchor":"ref-92","locations":["正文"],"count":1,"excerpt":"[[90-ex-berry-paradox-formal]]"},{"id":"32c1f47762a7f658","anchor":"ref-153","locations":["正文"],"count":1,"excerpt":"[[90-ex-berry-paradox-formal.md]]\n[[90-ex-cantor-diagonal.md]]\n[[90-ex-diagonalization-method.md]]\n[[90-ex-godel-sentence-construction.md]]\n[[90-ex-quine-construction.md]]\n[[90-ex-quine-sentence.md]]\n[[90-ex-rosser-sentence-construction.md]]\n[[90-ex-russell-paradox-set.md]]\n[[90-ex-self-reference-program.md]]"}],"outgoing":["777baa75a4312c8e","8959cc2a17246321","1f8fee89a8d4aa2f","7d83e22f672cfb25","4de0ebda11529dc6"]}