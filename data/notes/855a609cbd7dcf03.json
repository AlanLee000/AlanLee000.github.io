\\subseteq\\mathrm{Sent}_S","display":false},{"tex":"\\varphi\\in\\mathrm{Sent}_S","display":false},{"tex":"R","display":false},{"tex":"\\mathrm{Struct}_S(\\mathfrak M)","display":false},{"tex":"S","display":false},{"tex":"\\mathrm{ClassicalCalc}_{S}(R)","display":false},{"tex":"\\mathrm{Rule}","display":false},{"tex":"\\mathrm{EffRule}","display":false},{"tex":"\\mathrm{ex\\text{-}completeness\\text{-}proof} \\vdash\n\\Bigl(\n\\Phi\\subseteq\\mathrm{Sent}_S\n\\land\\varphi\\in\\mathrm{Sent}_S\n\\land\\mathrm{ClassicalCalc}_S(R)\n\\land\\Phi\\nvdash_R\\varphi\n\\Bigr)\n\\to\n\\exists\\mathfrak M\\;\n\\Bigl(\n\\mathrm{Struct}_S(\\mathfrak M)\n\\land\\mathfrak M\\models\\Phi\n\\land\\mathfrak M\\not\\models\\varphi\n\\Bigr)","display":true},{"tex":"\\Phi\\cup\\{\\neg\\varphi\\}","display":false}],"bytes":1639,"backlinks":[],"outgoing":["2f3ef5718562a673","19f597e8b5469bbc","b7bcf1e41c4a9fc9","b906e83ff9b25155","3a560d130315ebdc","7d0aefc635fe57fc","13ac48daafe6d04f","0aa80b611d62ec1b","95213b573c0bce18"]}