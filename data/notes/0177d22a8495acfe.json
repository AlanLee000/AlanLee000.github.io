\\\\\n\\forall v_{\\iota(0)}\\cdots\\forall v_{\\iota(m-1)}\\;\n(\\rho(\\varphi)(v_{\\iota(0)},\\ldots,v_{\\iota(m-1)})\\leftrightarrow\\varphi),&0<m\n\\end{cases}\n\\Bigr)\\Bigr\\}\\Bigr).\n\\end{aligned}","display":true},{"tex":"T","display":false}],"bytes":3045,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2497","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-zfc-logic9-morleyization.md|58-df-zfc-logic9-morleyization]]（batch05）"}],"outgoing":["a3348ed9eb6fb4e3","65418b505fc53093","715a32e91161b34f","3888033a846b1cd5","36d7463d215be751"]}