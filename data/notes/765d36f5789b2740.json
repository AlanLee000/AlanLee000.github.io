}\\to\\mathsf{Frm}_{549}","display":true},{"tex":"\\operatorname{Sub}_{549}(\\sigma,\\operatorname{atm}(p))=\\sigma(p),\n\\quad\n\\operatorname{Sub}_{549}(\\sigma,\\operatorname{bot})=\\operatorname{bot},","display":true},{"tex":"\\operatorname{Sub}_{549}(\\sigma,\\operatorname{imp}(A,B))\n=\n\\operatorname{imp}(\\operatorname{Sub}_{549}(\\sigma,A),\\operatorname{Sub}_{549}(\\sigma,B)),","display":true},{"tex":"\\operatorname{Sub}_{549}(\\sigma,\\operatorname{int}(A,B))\n=\n\\operatorname{int}(\\operatorname{Sub}_{549}(\\sigma,A),\\operatorname{Sub}_{549}(\\sigma,B)).","display":true},{"tex":"\\mathsf{Ax}_{C1}^{549}=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{C2}^{549}\n=\n\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{C3}^{549}\n=\n\\{((\\neg A\\to\\neg B)\\to(B\\to A)):A,B\\in\\mathsf{Frm}_{549}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\bot}^{549}=\\{\\bot\\to A:A\\in\\mathsf{Frm}_{549}\\}.","display":true},{"tex":"\\mathsf{Ax}_{K}^{549}\n=\n\\{\\Box(A\\to B)\\to(\\Box A\\to\\Box B):A,B\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{4}^{549}\n=\\{\\Box A\\to\\Box\\Box A:A\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{L}^{549}\n=\n\\{\\Box(\\Box A\\to A)\\to\\Box A:A\\in\\mathsf{Frm}_{549}\\}.","display":true},{"tex":"\\mathsf{Ax}_{J1}^{549}\n=\n\\{\\Box(A\\to B)\\to(A\\triangleright B):A,B\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{J2}^{549}\n=\n\\{((A\\triangleright B)\\land(B\\triangleright C))\\to(A\\triangleright C):A,B,C\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{J3}^{549}\n=\n\\{((A\\triangleright C)\\land(B\\triangleright C))\\to((A\\lor B)\\triangleright C):A,B,C\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\mathsf{Ax}_{J4}^{549}\n=\n\\{(A\\triangleright B)\\to(\\Diamond A\\to\\Diamond B):A,B\\in\\mathsf{Frm}_{549}\\},","display":true},{"tex":"\\m