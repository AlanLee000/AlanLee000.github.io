-df-compact.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"9edade6bb0a410c1\" href=\"?note=9edade6bb0a410c1\" title=\"../batch18/58-df-complex-structure.md\">../batch18/58-df-complex-structure.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"04b9f5c6479b7ecd\" href=\"?note=04b9f5c6479b7ecd\" title=\"../batch07/58-df-riemannian-manifold.md\">../batch07/58-df-riemannian-manifold.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"db62358c2ba471b0\" href=\"?note=db62358c2ba471b0\" title=\"../batch05/58-df-differential-form.md\">../batch05/58-df-differential-form.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"eaa26a086cb6c5af\" href=\"?note=eaa26a086cb6c5af\" title=\"../batch03/58-df-line-bundle.md\">../batch03/58-df-line-bundle.md</a></span><span><a class=\"wiki-link\" id=\"ref-9\" data-note=\"297834c6f058cefe\" href=\"?note=297834c6f058cefe\" title=\"../batch14/58-df-symplectic-form.md\">../batch14/58-df-symplectic-form.md</a></span><span><a class=\"wiki-link\" id=\"ref-10\" data-note=\"2363c198fdd8009b\" href=\"?note=2363c198fdd8009b\" title=\"../batch02/58-df-zfc-topo8-topological-product.md\">../batch02/58-df-zfc-topo8-topological-product.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"X,n,\\omega_X\\in V,\\ n\\in\\mathbb N\">\\(X,n,\\omega_X\\in V,\\ n\\in\\mathbb N\\)</span></p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ComplexManifold}_S\">\\(\\mathrm{ComplexManifold}_S\\)</span> (complex-manifold predicate, see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"0ab38aca0c5161bb\" href=\"?note=0ab38aca0c5161bb\" title=\"../batch15/58-df-complex-manifold.md\">../batch15/58-df-complex-manifold.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ComplexStructure}_S\">\\(\\mathrm{ComplexStructure}_S\\)</span> (maximal complex-atlas predicate, see <a class=\"wiki-link\" id=\"ref-12\" data-note=\"9edade6bb0a410c1\" href=\"?note=9edade6bb0a410c1\" title=\"../batch18/58-df-complex-structure.md\">../batch18/58-df-complex-structure.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\operatorname{RiemannianManifold}_S\">\\(\\operatorname{RiemannianManifold}_S\\)</span> (Riemannian-manifold predicate, see <a class=\"wiki-link\" id=\"ref-13\" data-note=\"04b9f5c6479b7ecd\" href=\"?note=04b9f5c6479b7ecd\" title=\"../batch07/58-df-riemannian-manifold.md\">../batch07/58-df-riemannian-manifold.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{DifferentialKForm}_S\">\\(\\mathrm{DifferentialKForm}_S\\)</span> (differential-form predicate, see <a class=\"wiki-link\" id=\"ref-14\" data-note=\"db62358c2ba471b0\" href=\"?note=db62358c2ba471b0\" title=\"../batch05/58-df-differential-form.md\">../batch05/58-df-differential-form.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{LineBundle}_S\">\\(\\mathrm{LineBundle}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{LineBundleIso}_S\">\\(\\mathrm{LineBundleIso}_S\\)</span> (line-bundle predicates, see <a class=\"wiki-link\" id=\"ref-15\" data-note=\"eaa26a086cb6c5af\" href=\"?note=eaa26a086cb6c5af\" title=\"../batch03/58-df-line-bundle.md\">../batch03/58-df-line-bundle.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{SymplecticForm}_S\">\\(\\mathrm{SymplecticForm}_S\\)</span> (closed nondegenerate two-form predicate, see <a class=\"wiki-link\" id=\"ref-16\" data-note=\"297834c6f058cefe\" href=\"?note=297834c6f058cefe\" title=\"../batch14/58-df-symplectic-form.md\">../batch14/58-df-symplectic-form.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopo8TopologicalProduct}_S\">\\(\\mathrm{ZfcTopo8TopologicalProduct}_S\\)</span> (product-topology predicate, see <a class=\"wiki-link\" id=\"ref-17\" data-note=\"2363c198fdd8009b\" href=\"?note=2363c198fdd8009b\" title=\"../batch02/58-df-zfc-topo8-topological-product.md\">../batch02/58-df-zfc-topo8-topological-product.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\omega_X\">\\(\\omega_X\\)</span> (canonical bundle of <span class=\"math-inline\" data-tex=\"X\">\\(X\\)</span>, see <a class=\"wiki-link\" id=\"ref-18\" data-note=\"369c9ce912d7ccb6\" href=\"?note=369c9ce912d7ccb6\" title=\"../batch02/58-df-canonical-bundle.md\">../batch02/58-df-canonical-bundle.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Compact}_S\">\\(\\mathrm{Compact}_S\\)</span> (compactness predicate, see <a class=\"wiki-link\" id=\"ref-19\" data-note=\"050f6d05b2c94aea\" href=\"?note=050f6d05b2c94aea\" title=\"../batch05/58-df-compact.md\">../batch05/58-df-compact.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{KahlerDatum}_S\">\\(\\mathrm{KahlerDatum}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{TrivialComplexLineBundle}_S\">\\(\\mathrm{TrivialComplexLineBundle}_S\\)</span> (predicates defined below)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{CalabiYau}_S\">\\(\\mathrm{CalabiYau}_S\\)</span> (Calabi–Yau predicate defined here)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\tau_{\\mathbb C}=\\{U\\subseteq\\mathbb C:\\forall z\\in U\\;\\exists r\\in\\mathbb R_{&gt;0}\\;\\forall w\\in\\mathbb C\\;(|w-z|&lt;r\\to w\\in U)\\}\">\\(\\tau_{\\mathbb C}=\\{U\\subseteq\\mathbb C:\\forall z\\in U\\;\\exists r\\in\\mathbb R_{&gt;0}\\;\\forall w\\in\\mathbb C\\;(|w-z|&lt;r\\to w\\in U)\\}\\)</span>。<span class=\"math-inline\" data-tex=\"X\\times\\mathbb C\">\\(X\\times\\mathbb C\\)</span> 按有序对编码，拓扑由正文的二元积算子给出。</p>\n</li>\n<li>\n<p>外部接口 <span class=\"math-inline\" data-tex=\"\\mathrm{BinaryProductTopology}\">\\(\\mathrm{BinaryProductTopology}\\)</span> 取 <a class=\"wiki-link\" id=\"ref-20\" data-note=\"ca7fc3ab38a11801\" href=\"?note=ca7fc3ab38a11801\" title=\"../batch03/58-df-euclidean-topological-data.md\">../batch03/58-df-euclidean-topological-data.md</a> 的同名定义与参数次序。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}kahler\\text{-}datum}\\vdash\n\\mathrm{KahlerDatum}_S(\\mathcal A,\\tau,g,J,\\eta,X,n)\n\\leftrightarrow\n\\mathrm{ComplexStructure}_S(\\mathcal A,X,\\tau,n)\n\\land\\operatorname{RiemannianManifold}_S(X,g)\\\\\n&amp;\\quad\\land\\mathrm{DifferentialKForm}_S(\\eta,X,2n,2)\n\\land\\mathrm{SymplecticForm}_S(\\eta,X)\n\\land J\\in\\prod_{p\\in X}(T_pX)^{T_pX}\n\\land\\forall p\\in X\\;\\forall u,v\\in T_pX\\;\\Bigl(\nJ_p(J_p(u))=-u\\\\\n&amp;\\hspace{38mm}\\land g_p(J_pu,J_pv)=g_p(u,v)\n\\land\\eta_p(u,v)=g_p(J_pu,v)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}kahler\\text{-}datum}\\vdash\n\\mathrm{KahlerDatum}_S(\\mathcal A,\\tau,g,J,\\eta,X,n)\n\\leftrightarrow\n\\mathrm{ComplexStructure}_S(\\mathcal A,X,\\tau,n)\n\\land\\operatorname{RiemannianManifold}_S(X,g)\\\\\n&amp;\\quad\\land\\mathrm{DifferentialKForm}_S(\\eta,X,2n,2)\n\\land\\mathrm{SymplecticForm}_S(\\eta,X)\n\\land J\\in\\prod_{p\\in X}(T_pX)^{T_pX}\n\\land\\forall p\\in X\\;\\forall u,v\\in T_pX\\;\\Bigl(\nJ_p(J_p(u))=-u\\\\\n&amp;\\hspace{38mm}\\land g_p(J_pu,J_pv)=g_p(u,v)\n\\land\\eta_p(u,v)=g_p(J_pu,v)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}trivial\\text{-}complex\\text{-}line\\text{-}bundle}\\vdash\n\\mathrm{TrivialComplexLineBundle}_S(\\omega_X,X,\\tau)\n\\leftrightarrow\n\\exists p,L,\\tau_L,F,p_\\times,\\tau_\\times\\in V\\;\\Bigl(\n\\omega_X=\\langle p,L,\\tau_L,X,\\tau,\\mathbb C\\rangle\\\\\n&amp;\\quad\\land\\mathrm{LineBundle}_S(p,L,\\tau_L,X,\\tau,\\mathbb C)\n\\land p_\\times=\n\\{\\langle\\langle x,z\\rangle,x\\rangle\\mid\nx\\in X\\land z\\in\\mathbb C\\}\\\\\n&amp;\\quad\\land\\tau_\\times=\\mathrm{BinaryProductTopology}_S(X,\\tau,\\mathbb C,\\tau_{\\mathbb C})\n\\land\\mathrm{LineBundleIso}_S\\!\\left(\nF,\\omega_X,\n\\langle p_\\times,X\\times\\mathbb C,\\tau_\\times,\nX,\\tau,\\mathbb C\\rangle\n\\right)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}trivial\\text{-}complex\\text{-}line\\text{-}bundle}\\vdash\n\\mathrm{TrivialComplexLineBundle}_S(\\omega_X,X,\\tau)\n\\leftrightarrow\n\\exists p,L,\\tau_L,F,p_\\times,\\tau_\\times\\in V\\;\\Bigl(\n\\omega_X=\\langle p,L,\\tau_L,X,\\tau,\\mathbb C\\rangle\\\\\n&amp;\\quad\\land\\mathrm{LineBundle}_S(p,L,\\tau_L,X,\\tau,\\mathbb C)\n\\land p_\\times=\n\\{\\langle\\langle x,z\\rangle,x\\rangle\\mid\nx\\in X\\land z\\in\\mathbb C\\}\\\\\n&amp;\\quad\\land\\tau_\\times=\\mathrm{BinaryProductTopology}_S(X,\\tau,\\mathbb C,\\tau_{\\mathbb C})\n\\land\\mathrm{LineBundleIso}_S\\!\\left(\nF,\\omega_X,\n\\langle p_\\times,X\\times\\mathbb C,\\tau_\\times,\nX,\\tau,\\mathbb C\\rangle\n\\right)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}calabi\\text{-}yau}\\vdash\n\\mathrm{CalabiYau}_S(X,n,\\omega_X)\n\\leftrightarrow n\\in\\mathbb N\\land\\exists\\tau,\\mathcal A,g,J,\\eta\\in V\\;\\Bigl(\n\\mathrm{ComplexManifold}_S(X,\\tau,n)\n\\land\\mathrm{Compact}_S(X,\\tau)\\\\\n&amp;\\hspace{25mm}\\land\\mathrm{KahlerDatum}_S(\\mathcal A,\\tau,g,J,\\eta,X,n)\n\\land\\mathrm{TrivialComplexLineBundle}_S(\\omega_X,X,\\tau)\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}calabi\\text{-}yau}\\vdash\n\\mathrm{CalabiYau}_S(X,n,\\omega_X)\n\\leftrightarrow n\\in\\mathbb N\\land\\exists\\tau,\\mathcal A,g,J,\\eta\\in V\\;\\Bigl(\n\\mathrm{ComplexManifold}_S(X,\\tau,n)\n\\land\\mathrm{Compact}_S(X,\\tau)\\\\\n&amp;\\hspace{25mm}\\land\\mathrm{KahlerDatum}_S(\\mathcal A,\\tau,g,J,\\eta,X,n)\n\\land\\mathrm{TrivialComplexLineBundle}_S(\\omega_X,X,\\tau)\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The topology, complex structure, Kähler tensor data, and a bundle isomorphism with the trivial complex line bundle are now explicit witnesses.</li>\n<li>Closedness of the Kähler form is imported from the symplectic-form predicate; the former free equation <span class=\"math-inline\" data-tex=\"d\\eta=0\">\\(d\\eta=0\\)</span> had no selected exterior derivative. The trivial bundle now uses a constructed projection graph and a certified product topology.</li>\n<li>Yau's theorem (1978): every compact Kähler manifold with vanishing first real Chern class admits a Ricci-flat Kähler metric.</li>\n<li>Compact Calabi–Yau manifolds have <span class=\"math-inline\" data-tex=\"SU(n)\">\\(SU(n)\\)</span>-holonomy for <span class=\"math-inline\" data-tex=\"\\dim_\\mathbb{C} = n\">\\(\\dim_\\mathbb{C} = n\\)</span>.</li>\n<li>Examples: K3 surfaces (<span class=\"math-inline\" data-tex=\"\\mathrm{SU}(2)\">\\(\\mathrm{SU}(2)\\)</span>-holonomy), quintic threefolds in <span class=\"math-inline\" data-tex=\"\\mathbb{P}^4\">\\(\\mathbb{P}^4\\)</span>.</li>\n<li>Mirror symmetry relates pairs of Calabi–Yau threefolds.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch03/58-df-euclidean-topological-data.md","status":"resolved","id":"ca7fc3ab38a11801","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch03/58-df-euclidean-topological-data.md]]","embed":false},{"target":"../batch15/58-df-complex-manifold.md","status":"resolved","id":"0ab38aca0c5161bb","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-complex-manifold.md]]","embed":false},{"target":"../batch02/58-df-canonical-bundle.md","status":"resolved","id":"369c9ce912d7ccb6","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-canonical-bundle.md]]","embed":false},{"target":"../batch05/58-df-compact.md","status":"resolved","id":"050f6d05b2c94aea","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-compact.md]]","embed":false},{"target":"../batch18/58-df-complex-structure.md","status":"resolved","id":"9edade6bb0a410c1","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-complex-structure.md]]","embed":false},{"target":"../batch07/58-df-riemannian-manifold.md","status":"resolved","id":"04b9f5c6479b7ecd","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-riemannian-manifold.md]]","embed":false},{"target":"../batch05/58-df-differential-form.md","status":"resolved","id":"db62358c2ba471b0","anchor":"ref-7","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-differential-form.md]]","embed":false},{"target":"../batch03/58-df-line-bundle.md","status":"resolved","id":"eaa26a086cb6c5af","anchor":"ref-8","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch03/58-df-line-bundle.md]]","embed":false},{"target":"../batch14/58-df-symplectic-form.md","status":"resolved","id":"297834c6f058cefe","anchor":"ref-9","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-df-symplectic-form.md]]","embed":false},{"target":"../batch02/58-df-zfc-topo8-topological-product.md","status":"resolv