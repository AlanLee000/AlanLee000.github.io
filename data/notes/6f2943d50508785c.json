8-df-function.md\">../batch16/58-df-function.md</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"5045d216c83e75cb\" href=\"?note=5045d216c83e75cb\" title=\"../batch16/58-df-omega.md\">../batch16/58-df-omega.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"74086485fba8d86f\" href=\"?note=74086485fba8d86f\" title=\"../batch10/58-df-zfc-top5-topological-space.md\">../batch10/58-df-zfc-top5-topological-space.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"682d2801cf83c784\" href=\"?note=682d2801cf83c784\" title=\"../batch16/58-df-zfc-top5-continuous-map.md\">../batch16/58-df-zfc-top5-continuous-map.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"550b3a6a7be23842\" href=\"?note=550b3a6a7be23842\" title=\"../batch20/58-df-zfc-top5-locally-compact-space.md\">../batch20/58-df-zfc-top5-locally-compact-space.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"69f8a4b0afb36176\" href=\"?note=69f8a4b0afb36176\" title=\"../batch18/58-df-zfc-top5-hausdorff-space.md\">../batch18/58-df-zfc-top5-hausdorff-space.md</a></span><span><a class=\"wiki-link\" id=\"ref-9\" data-note=\"67cf48a2f6e27861\" href=\"?note=67cf48a2f6e27861\" title=\"../batch18/58-df-zfc-top2-compact-subset.md\">../batch18/58-df-zfc-top2-compact-subset.md</a></span><span><a class=\"wiki-link\" id=\"ref-10\" data-note=\"edc520f758b19264\" href=\"?note=edc520f758b19264\" title=\"../batch01/58-df-support.md\">../batch01/58-df-support.md</a></span><span><a class=\"wiki-link\" id=\"ref-11\" data-note=\"88bd8690da417bbc\" href=\"?note=88bd8690da417bbc\" title=\"../batch16/58-df-real-line.md\">../batch16/58-df-real-line.md</a></span><span><a class=\"wiki-link\" id=\"ref-12\" data-note=\"5113df68bb408cd8\" href=\"?note=5113df68bb408cd8\" title=\"../batch07/58-df-zfc-measure4-radon-measure.md\">../batch07/58-df-zfc-measure4-radon-measure.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,\\mathcal B_\\tau,\\vec\\mu,\\mu,f,K\\in V\">\\(X,\\tau,\\mathcal B_\\tau,\\vec\\mu,\\mu,f,K\\in V\\)</span> (space, Borel algebra, measures, and test-function data)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal B_\\tau=\\sigma_X(\\tau)\">\\(\\mathcal B_\\tau=\\sigma_X(\\tau)\\)</span> (Borel <span class=\"math-inline\" data-tex=\"\\sigma\">\\(\\sigma\\)</span>-algebra, see <a class=\"wiki-link\" id=\"ref-13\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"../batch07/58-df-sigma-algebra.md\">../batch07/58-df-sigma-algebra.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}(\\vec\\mu,\\omega,\\operatorname{ran}(\\vec\\mu))\">\\(\\mathrm{Function}(\\vec\\mu,\\omega,\\operatorname{ran}(\\vec\\mu))\\)</span> (measure sequence, see <a class=\"wiki-link\" id=\"ref-14\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5TopologicalSpace}_S,\\mathrm{ZfcTop5LocallyCompactSpace}_S,\\mathrm{ZfcTop5HausdorffSpace}_S\">\\(\\mathrm{ZfcTop5TopologicalSpace}_S,\\mathrm{ZfcTop5LocallyCompactSpace}_S,\\mathrm{ZfcTop5HausdorffSpace}_S\\)</span> (space predicates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{RadonMeasure}\">\\(\\operatorname{RadonMeasure}\\)</span> (Radon-measure predicate, see <a class=\"wiki-link\" id=\"ref-15\" data-note=\"5113df68bb408cd8\" href=\"?note=5113df68bb408cd8\" title=\"../batch07/58-df-zfc-measure4-radon-measure.md\">../batch07/58-df-zfc-measure4-radon-measure.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5ContinuousMap}_S\">\\(\\mathrm{ZfcTop5ContinuousMap}_S\\)</span> (continuous-map predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Support}_S,\\mathrm{ZfcTop2CompactSubset}_S\">\\(\\mathrm{Support}_S,\\mathrm{ZfcTop2CompactSubset}_S\\)</span> (support and compact-subset predicates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure4VagueConvergence}_S\\subseteq V^5\">\\(\\mathrm{ZfcMeasure4VagueConvergence}_S\\subseteq V^5\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}vague\\text{-}convergence}\\vdash\n\\mathrm{ZfcMeasure4VagueConvergence}_S(X,\\tau,\\mathcal B_\\tau,\\vec\\mu,\\mu)\n\\leftrightarrow{}\\\\\n&amp;\\quad \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\n\\land\\mathrm{ZfcTop5LocallyCompactSpace}_S(X,\\tau)\n\\land\\mathrm{ZfcTop5HausdorffSpace}_S(X,\\tau)\n\\land\\mathcal B_\\tau=\\sigma_X(\\tau)\\\\\n&amp;\\quad \\land\\operatorname{RadonMeasure}(\\mu,X,\\tau)\n\\land\\mathrm{Function}(\\vec\\mu,\\omega,\\operatorname{ran}(\\vec\\mu))\n\\land\\forall n\\in\\omega\\;\\operatorname{RadonMeasure}(\\vec\\mu(n),X,\\tau)\\\\\n&amp;\\quad \\land\\forall f\\;\\Biggl(\n\\Bigl(\n\\mathrm{ZfcTop5ContinuousMap}_S(X,\\tau,\\mathbb R,\\tau_{\\mathbb R},f)\n\\land\\exists K\\;\\bigl(\n\\mathrm{Support}_S(K,f,X,\\tau,\\mathbb R,0)\n\\land\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau)\n\\bigr)\n\\Bigr)\\\\\n&amp;\\hspace{33mm}\\to\n\\forall\\varepsilon\\in\\mathbb R_{&gt;0}\\;\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;\n\\left(N\\leq n\\to\n\\left|\\int_X f\\,d\\vec\\mu(n)-\\int_X f\\,d\\mu\\right|&lt;\\varepsilon\\right)\n\\Biggr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}vague\\text{-}convergence}\\vdash\n\\mathrm{ZfcMeasure4VagueConvergence}_S(X,\\tau,\\mathcal B_\\tau,\\vec\\mu,\\mu)\n\\leftrightarrow{}\\\\\n&amp;\\quad \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\n\\land\\mathrm{ZfcTop5LocallyCompactSpace}_S(X,\\tau)\n\\land\\mathrm{ZfcTop5HausdorffSpace}_S(X,\\tau)\n\\land\\mathcal B_\\tau=\\sigma_X(\\tau)\\\\\n&amp;\\quad \\land\\operatorname{RadonMeasure}(\\mu,X,\\tau)\n\\land\\mathrm{Function}(\\vec\\mu,\\omega,\\operatorname{ran}(\\vec\\mu))\n\\land\\forall n\\in\\omega\\;\\operatorname{RadonMeasure}(\\vec\\mu(n),X,\\tau)\\\\\n&amp;\\quad \\land\\forall f\\;\\Biggl(\n\\Bigl(\n\\mathrm{ZfcTop5ContinuousMap}_S(X,\\tau,\\mathbb R,\\tau_{\\mathbb R},f)\n\\land\\exists K\\;\\bigl(\n\\mathrm{Support}_S(K,f,X,\\tau,\\mathbb R,0)\n\\land\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau)\n\\bigr)\n\\Bigr)\\\\\n&amp;\\hspace{33mm}\\to\n\\forall\\varepsilon\\in\\mathbb R_{&gt;0}\\;\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;\n\\left(N\\leq n\\to\n\\left|\\int_X f\\,d\\vec\\mu(n)-\\int_X f\\,d\\mu\\right|&lt;\\varepsilon\\right)\n\\Biggr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This is convergence against every real-valued compactly supported continuous test function on a locally compact Hausdorff space, for a sequence of Radon measures.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-sigma-algebra.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch16/58-df-omega.md","status":"resolved","id":"5045d216c83e75cb","anchor":"ref