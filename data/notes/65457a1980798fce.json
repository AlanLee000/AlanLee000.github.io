harpoonright(K\\setminus\\{0_K\\})=v\\Bigr).\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}ramification\\text{-}index} \\vdash e(w/v)\\coloneqq[\\operatorname{ran}(w):\\operatorname{ran}(v)]","display":true},{"tex":"\\mathrm{df\\text{-}ramification\\text{-}predicate} \\vdash \\mathrm{Ramified}_S(w,v,L,K,\\Gamma)\\leftrightarrow\\mathrm{ExtendsValuation}_S(w,v,L,K,\\Gamma)\\land e(w/v)>1","display":true},{"tex":"\\Gamma","display":false},{"tex":"w","display":false},{"tex":"v","display":false}],"bytes":1996,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1031","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-ramification.md|58-df-ramification]]（batch03）"}],"outgoing":["0fb569bc36cce327","699918fd54cc2a8e"]}