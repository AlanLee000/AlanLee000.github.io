\\in V\">\\(R,+_R,\\cdot_R,0_R,1_R,M,+_M,0_M,\\odot_M,N,+_N,0_N,\\odot_N,T,+_T,0_T,\\odot_T,b\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcAlgebra2TensorBilinearMap}_S\">\\(\\mathrm{ZfcAlgebra2TensorBilinearMap}_S\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{CommutativeRing}_S\">\\(\\operatorname{CommutativeRing}_S\\)</span> (commutative-ring predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"1c30d21ea7b443f6\" href=\"?note=1c30d21ea7b443f6\" title=\"../batch11/58-df-ring.md\">../batch11/58-df-ring.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Module}_S\">\\(\\mathrm{Module}_S\\)</span> (module predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"ef3a5dd6825f0373\" href=\"?note=ef3a5dd6825f0373\" title=\"../batch13/58-df-module.md\">../batch13/58-df-module.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}algebra2\\text{-}tensor\\text{-}bilinear\\text{-}map} \\vdash\n\\mathrm{ZfcAlgebra2TensorBilinearMap}_S(b;R,+_R,\\cdot_R,0_R,1_R;M,+_M,0_M,\\odot_M;N,+_N,0_N,\\odot_N;T,+_T,0_T,\\odot_T)\\leftrightarrow\\left(\n\\operatorname{CommutativeRing}_S(R,+_R,\\cdot_R,0_R,1_R)\\land\n\\mathrm{Module}_S(M,R,+_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot_M)\\land\n\\mathrm{Module}_S(N,R,+_N,0_N,+_R,\\cdot_R,0_R,1_R,\\odot_N)\\land\n\\mathrm{Module}_S(T,R,+_T,0_T,+_R,\\cdot_R,0_R,1_R,\\odot_T)\\land\n\\mathrm{Function}(b,M\\times N,T)\\land\n\\forall m_0,m_1\\in M\\;\\forall n_0,n_1\\in N\\;\\forall r\\in R\\;\\bigl(\nb(m_0+_M m_1,n_0)=b(m_0,n_0)+_T b(m_1,n_0)\\land\nb(m_0,n_0+_N n_1)=b(m_0,n_0)+_T b(m_0,n_1)\\land\nb(r\\odot_M m_0,n_0)=r\\odot_T b(m_0,n_0)\\land\nb(m_0,r\\odot_N n_0)=r\\odot_T b(m_0,n_0)\\bigr)\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}algebra2\\text{-}tensor\\text{-}bilinear\\text{-}map} \\vdash\n\\mathrm{ZfcAlgebra2TensorBilinearMap}_S(b;R,+_R,\\cdot_R,0_R,1_R;M,+_M,0_M,\\odot_M;N,+_N,0_N,\\odot_N;T,+_T,0_T,\\odot_T)\\leftrightarrow\\left(\n\\operatorname{CommutativeRing}_S(R,+_R,\\cdot_R,0_R,1_R)\\land\n\\mathrm{Module}_S(M,R,+_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot_M)\\land\n\\mathrm{Module}_S(N,R,+_N,0_N,+_R,\\cdot_R,0_R,1_R,\\odot_N)\\land\n\\mathrm{Module}_S(T,R,+_T,0_T,+_R,\\cdot_R,0_R,1_R,\\odot_T)\\land\n\\mathrm{Function}(b,M\\times N,T)\\land\n\\forall m_0,m_1\\in M\\;\\forall n_0,n_1\\in N\\;\\forall r\\in R\\;\\bigl(\nb(m_0+_M m_1,n_0)=b(m_0,n_0)+_T b(m_1,n_0)\\land\nb(m_0,n_0+_N n_1)=b(m_0,n_0)+_T b(m_0,n_1)\\land\nb(r\\odot_M m_0,n_0)=r\\odot_T b(m_0,n_0)\\land\nb(m_0,r\\odot_N n_0)=r\\odot_T b(m_0,n_0)\\bigr)\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>环运算、三个模结构及其标量作用均为显式参数，避免把不同载体上的加法和作用混成同一未绑定符号。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch11/58-df-ring.md","status":"resolved","id":"1c30d21ea7b443f6","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-ring.md]]","embed":false},{"target":"../batch13/58-df-module.md","status":"resolved","id":"ef3a5dd6825f0373","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-module.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch1