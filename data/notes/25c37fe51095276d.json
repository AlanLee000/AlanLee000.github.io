{\\mathrm{FS}}\\bigr),","display":true},{"tex":"\\mathrm{FS}","display":false},{"tex":"\\mathrm{Comp}_{\\mathrm{FS}}","display":false},{"tex":"\\mathcal R_{\\mathrm{FS}}","display":false},{"tex":"T(\\neg\\varphi)\\leftrightarrow\\neg T(\\varphi)","display":false},{"tex":"\\omega","display":false},{"tex":"\\omega","display":false},{"tex":"\\omega","display":false},{"tex":"\\omega","display":false}],"bytes":3226,"backlinks":[{"id":"aa2ad816ed17d60f","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"fd9d450264433858","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{FS}$ (Friedman-Sheard理论, see [[91-df-FS]])"},{"id":"f744fc361db0ee96","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"d0dc2670ffdd2806","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"fa7a47e0464f94a4","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"f23e822ba5d24954","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"8f32f747a261016d","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"ccf84662da3832c0","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"9cac5018c941051e","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathcal R_{\\mathrm{FS}}$ (FS 的 capture 与 release 规则集,\nsee [[91-df-FS]])"},{"id":"cda20fabbaa06580","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e17f40587f032600","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"8556c1ac7447fbfa","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"4278731e7fc892de","anchor":"ref-95","locations":["正文"],"count":1,"excerpt":"[[91-df-FS]]"},{"id":"e93fc3e2f8fd50d4","anchor":"ref-5","locations":["正文"],"count":1,"excerpt":"[[91-df-CT.md]]\n[[91-df-FS-n.md]]\n[[91-df-FS.md]]\n[[91-df-KF-plu