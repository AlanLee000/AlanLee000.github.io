{"id":"5e1b548bf29939ce","group":"58","path":"58/batch01/58-df-zfc-condensation-map.md","title":"ZFC Condensation Map","display":"df-zfc-condensation-map — ZFC Condensation Map","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-condensation-map","aliases":["58-df-zfc-condensation-map"],"display":"df-zfc-condensation-map — ZFC Condensation Map","depends_on":["[[../batch02/58-ax-zfc.md]]","[[58-df-mostowski]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-condensation-map"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-condensation-map</span></div>"},{"key":"display","html":"df-zfc-condensation-map — ZFC Condensation Map"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"b6ec5105268243bd\" href=\"?note=b6ec5105268243bd\" title=\"58-df-mostowski\">58-df-mostowski</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"M,N,\\pi\\in V\">\\(M,N,\\pi\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{CondensationMap}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{CondensationMap}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{MostowskiCollapse}_S:V^4\\to\\{\\top,\\bot\\}\">\\(\\mathrm{MostowskiCollapse}_S:V^4\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"b6ec5105268243bd\" href=\"?note=b6ec5105268243bd\" title=\"58-df-mostowski\">58-df-mostowski</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equatio