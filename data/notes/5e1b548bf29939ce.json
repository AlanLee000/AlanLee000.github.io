onMap}_S(\\pi,M,N)\\leftrightarrow \\mathrm{MostowskiCollapse}_S\\!\\left(M,\\{\\langle x,y\\rangle\\in M\\times M:x\\in y\\},N,\\pi\\right)","display":true}],"bytes":899,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1772","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-condensation-map.md|58-df-zfc-condensation-map]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","b6ec5105268243bd"]}