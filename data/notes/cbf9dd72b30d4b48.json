inks":[{"id":"005203b6707a19f4","anchor":"ref-294","locations":["正文"],"count":1,"excerpt":"[[20-thm-shoenfield-inv]] — 章 6；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-294","locations":["正文"],"count":1,"excerpt":"[[20-thm-shoenfield-inv]]"}],"outgoing":["6330178076c4520f","e890b3c29e4a70a3","2c15e9656c322806","e888141c21b61ce5"]}