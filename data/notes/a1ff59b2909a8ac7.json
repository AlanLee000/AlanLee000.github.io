hcal R,\\mathcal A,U\\;\\mathrm{ProjectiveResolutionData}_{58}(P,d,\\varepsilon,A,R,\\mathcal R,\\mathcal A,U).","display":true}],"bytes":3696,"backlinks":[{"id":"d6024046101f0472","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ProjectiveResolution}_S\\subseteq V^5$ (see [[../batch18/58-df-projective-resolution.md]])."},{"id":"626a376aca69b0c2","anchor":"ref-12","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{ModuleRecord}$、$\\mathrm{ProjectiveResolutionData}$ 取 [[58-df-projective-resolution]] 的同名定义与参数次序。"},{"id":"7c0eb208441d0c3e","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ProjectiveResolution}_S(P,d,\\varepsilon,A,R)$ (see [[58-df-projective-resolution]])."},{"id":"a11585cba9c21cfd","anchor":"ref-355","locations":["正文"],"count":1,"excerpt":"[[58-df-projective-resolution]]"},{"id":"84daad544872cc71","anchor":"ref-1004","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-projective-resolution.md|58-df-projective-resolution]]（batch18）"}],"outgoing":["427dbff531db1052","25e593b1b8714c23","9f8cb046321ba311","82508b70140c7533","ef3a5dd6825f0373","36d7463d215be751"]}