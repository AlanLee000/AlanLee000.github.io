tion}(d,C,C)\n\\land\\forall x,y\\in C\\;\\forall r\\in R\\;\\Bigl(\nd(x+_Cy)=d(x)+_Cd(y)\\\\\n&\\hspace{43mm}\\land\nd(r\\odot_Cx)=r\\odot_Cd(x)\\Bigr)\n\\land\\forall x\\in C\\;(d(d(x))=0_C).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}chain\\text{-}complex\\text{-}over}\\vdash\n\\mathrm{ChainComplexOver}_S(C,d,R)\\\\\n\\leftrightarrow{}&\n\\exists +_C,0_C,+_R,\\cdot_R,0_R,1_R,\\odot_C\\in V\\;\n\\mathrm{ComplexDatum}_S\n(C,d,R,+_C,0_C,+_R,\\cdot_R,0_R,1_R,\\odot_C).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}homology\\text{-}module}\\vdash\n\\mathrm{HomologyModule}_S(H,C,d,R)\\\\\n\\leftrightarrow{}&\n\\exists +_C,0_C,+_R,\\cdot_R,0_R,1_R,\\odot_C,Z,B,E\\in V\\;\\Bigl(\n\\mathrm{ComplexDatum}_S\n(C,d,R,+_C,0_C,+_R,\\cdot_R,0_R,1_R,\\odot_C)\\\\\n&\\quad\\land Z=\\{x\\in C\\mid d(x)=0_C\\}\n\\land B=d[C]\\\\\n&\\quad\\land E=\\{\\langle x,y\\rangle\\in Z\\times Z\\mid\n\\exists b\\in B\\;(x=y+_Cb)\\}\n\\land\\mathrm{QuotientSet}_S(H,Z,E)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}heegaard\\text{-}floer}\\vdash\n\\mathrm{HFModule}_S(Y,C^-,d^-,C^+,d^+,C^\\infty,d^\\infty,H^-,H^+,H^\\infty)\n\\leftrightarrow\n\\mathrm{ClosedOrientedThreeManifold}_S(Y)\\\\\n&\\quad\\land\\bigwedge_{\\circ\\in\\{-,+,\\infty\\}}\n\\Bigl(\n\\mathrm{ChainComplexOver}_S(C^\\circ,d^\\circ,\\mathbb Z[U])\n\\land\\mathrm{HomologyModule}_S\n(H^\\circ,C^\\circ,d^\\circ,\\mathbb Z[U])\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathbb Z[U]","display":false},{"tex":"\\ker","display":false},{"tex":"\\operatorname{im}","display":false},{"tex":"\\widehat{HF}(Y)","display":false},{"tex":"Y","display":false},{"tex":"\\widehat{HFK}(Y,K)","display":false}],"bytes":4117,"backlinks":[{"id":"ec62883b7b82f77c","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-611","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-heegaard-floer.md|58-df-heegaard-floer]]（batch01）"}],"outgoing":["ef3a5dd6825f0373","0e800aa519680c23","050f6d05b2c94aea","fb3df47c91e4a261","36d7463d215be751","9ced46394294c1a6"]}