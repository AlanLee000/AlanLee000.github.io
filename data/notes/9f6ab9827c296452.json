{"id":"9f6ab9827c296452","group":"58","path":"58/batch13/58-df-zfc-rel-directed-set.md","title":"ZFC Rel Directed Set","display":"df-zfc-rel-directed-set — ZFC Rel Directed Set","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-rel-directed-set","aliases":["58-df-zfc-rel-directed-set"],"display":"df-zfc-rel-directed-set — ZFC Rel Directed Set","depends_on":["[[../batch02/58-ax-zfc.md]]","[[58-df-zfc-order6-preorder]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-rel-directed-set"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-rel-directed-set</span></div>"},{"key":"display","html":"df-zfc-rel-directed-set — ZFC Rel Directed Set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"e0308c920cba2bdd\" href=\"?note=e0308c920cba2bdd\" title=\"58-df-zfc-order6-preorder\">58-df-zfc-order6-preorder</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"D,\\leq\\,\\in V\">\\(D,\\leq\\,\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRelDirectedSet}_S\\subseteq V^2\">\\(\\mathrm{ZfcRelDirectedSet}_S\\subseteq V^2\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcOrder6Preorder}_S\\subseteq V^2\">\\(\\mathrm{ZfcOrder6Preorder}_S\\subseteq V^2\\)</span> (preorder predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"e0308c920cba2bdd\" href=\"?note=e0308c920cba2bdd\" title=\"58-df-zfc-order6-preorder\">58-df-zfc-order6-preorder</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=