857074b912e\" href=\"?note=a5e10857074b912e\" title=\"../batch07/58-df-boolean-algebra.md\">../batch07/58-df-boolean-algebra.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{CompleteBooleanAlgebra}_S\\subseteq V^6\">\\(\\mathrm{CompleteBooleanAlgebra}_S\\subseteq V^6\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}complete\\text{-}boolean\\text{-}algebra} \\vdash \\mathrm{CompleteBooleanAlgebra}_S(B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B) \\leftrightarrow \\mathrm{Boolean}(B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B)\\land\\forall X\\subseteq B\\;\\exists b\\in B\\;\\left(\\forall x\\in X\\;(x\\wedge_B b=x)\\land\\forall c\\in B\\;\\left((\\forall x\\in X\\;(x\\wedge_B c=x))\\to b\\wedge_B c=b\\right)\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}complete\\text{-}boolean\\text{-}algebra} \\vdash \\mathrm{CompleteBooleanAlgebra}_S(B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B) \\leftrightarrow \\mathrm{Boolean}(B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B)\\land\\forall X\\subseteq B\\;\\exists b\\in B\\;\\left(\\forall x\\in X\\;(x\\wedge_B b=x)\\land\\forall c\\in B\\;\\left((\\forall x\\in X\\;(x\\wedge_B c=x))\\to b\\wedge_B c=b\\right)\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch07/58-df-boolean-algebra.md","status":"resolved","id":"a5e10857074b912e"