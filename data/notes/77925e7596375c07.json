athrm{ZfcTop5Neighborhood}_S(X,\\tau,x,N).\n\\end{aligned}","display":true}],"bytes":1011,"backlinks":[{"id":"796cdc660bbc6e8a","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcTop3NeighborhoodOfPoint}_S\\subseteq V^4$ (see [[../batch04/58-df-zfc-top3-neighborhood-of-point.md]])"},{"id":"371a894be391c738","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcTop3NeighborhoodOfPoint}_S\\subseteq V^4$ (neighborhood predicate, see [[../batch04/58-df-zfc-top3-neighborhood-of-point.md]])"},{"id":"84daad544872cc71","anchor":"ref-3557","locations":["正文"],"count":1,"excerpt":"[[../batch04/58-df-zfc-top3-neighborhood-of-point.md|58-df-zfc-top3-neighborhood-of-point]]（batch04）"}],"outgoing":["a3348ed9eb6fb4e3","d0ebf4991f4c6dec"]}