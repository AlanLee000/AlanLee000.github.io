{"id":"9f29a2487393d5b9","group":"29","path":"29/29-df-bit.md","title":"位谓词 BIT","display":"df-bit — 位谓词 BIT","type":"definition","metadata":{"type":"definition","book":"Descriptive Complexity (Neil Immerman)","book_abbrev":"29","label":"29-df-bit","aliases":["29-df-bit"],"display":"df-bit — 位谓词 BIT","depends_on":["[[29-df-variable]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Descriptive Complexity (Neil Immerman)"},{"key":"book_abbrev","html":"29"},{"key":"label","html":"29-df-bit"},{"key":"aliases","html":"<div class=\"property-array\"><span>29-df-bit</span></div>"},{"key":"display","html":"df-bit — 位谓词 BIT"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"ad08b66c5e54a436\" href=\"?note=ad08b66c5e54a436\" title=\"29-df-variable\">29-df-variable</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"i, n \\in \\mathbb{N}\">\\(i, n \\in \\mathbb{N}\\)</span> (位索引和数, primitive)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}bit}\\vdash\\mathrm{BIT}(i,n)\\leftrightarrow\\left\\lfloor\\frac{n}{2^i}\\right\\rfloor\\bmod 2=1\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}bit}\\vdash\\mathrm{BIT}(i,n)\\leftrightarrow\\left\\lfloor\\frac{n}{2^i}\\right\\rfloor\\bmod 2=1\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"29-df-variable","status":"resolved","id":"ad08b66c5e54a436","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-df-variable]]","embed":false}],"math":[{"tex":"i, n \\in \\mathbb{N}","display":false},{"tex":"\\ma