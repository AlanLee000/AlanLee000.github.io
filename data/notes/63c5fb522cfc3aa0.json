da(m_1)),\\lambda(n))\\in Rule_{G3i}).","display":true},{"tex":"\\operatorname{Der}_{G3i}(N,r,\\prec,\\lambda)\n\\Longleftrightarrow\n\\operatorname{Tree}_{G3i}(N,r,\\prec,\\lambda)\\land\n\\forall n\\in N\\ \\operatorname{NodeOK}_{G3i}(N,\\prec,\\lambda,n).","display":true},{"tex":"\\vdash_{G3i}\\Gamma\\Rightarrow S\n\\Longleftrightarrow\n\\exists N\\,\\exists r\\,\\exists\\prec\\,\\exists\\lambda\\,\n\\bigl(\\operatorname{Der}_{G3i}(N,r,\\prec,\\lambda)\\land\n\\operatorname{RootLab}_{G3i}(N,r,\\prec,\\lambda)=\\Gamma\\Rightarrow S\\bigr).","display":true},{"tex":"\\operatorname{RootLab}_{G3i}(N,r,\\prec,\\lambda)=\\lambda(r),\n\\qquad\n\\mathsf{Cn}_{G3i}=\\{\\Gamma\\Rightarrow S\\in Seq_{G3i}:\\vdash_{G3i}\\Gamma\\Rightarrow S\\}.","display":true},{"tex":"\\Delta_{G3i}=(Succ_{G3i},Seq_{G3i},Rule_{G3i},\\operatorname{Der}_{G3i},\\mathsf{Cn}_{G3i}).","display":true},{"tex":"\\mathcal{G3i}\n=\n\\bigl(\nProp,\nFrm_{G3i},\nPV,\nSub_{G3i},\n\\widehat\\sigma,\nCtx_{G3i},\nSucc_{G3i},\nSeq_{G3i},\nInit_{G3i},\nAx_{G3i},\nRule_{\\bot L}^{G3i},\nRule_{\\wedge L}^{G3i},\nRule_{\\wedge R}^{G3i},\nRule_{\\vee L}^{G3i},\nRule_{\\vee R1}^{G3i},\nRule_{\\vee R2}^{G3i},\nRule_{\\to L}^{G3i},\nRule_{\\to R}^{G3i},\nRule_{G3i},\n\\operatorname{Path}_{\\prec},\n\\operatorname{RootedTree},\n\\operatorname{ch}_{\\prec},\n\\operatorname{leaf}_{\\prec},\n\\operatorname{Tree}_{G3i},\n\\operatorname{NodeOK}_{G3i},\n\\operatorname{Der}_{G3i},\n\\operatorname{RootLab}_{G3i},\n\\vdash_{G3i},\n\\mathsf{Cn}_{G3i},\n\\Delta_{G3i}\n\\bigr).","display":true}],"bytes":6251,"backlinks":[],"outgoing":[]}