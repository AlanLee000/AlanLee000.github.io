;X,\\|\\cdot\\|_X,+_X,\\odot_X;X,\\|\\cdot\\|_X,+_X,\\odot_X;K)\\}^{\\mathbb R_{\\geq0}}\\land\\forall x\\in X\\;(T(0)(x)=x)\\land\\forall s,t\\in\\mathbb R_{\\geq0}\\;(T(t+s)=T(t)\\circ T(s))\\land\\forall x\\in X\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists\\delta\\in\\mathbb R_{>0}\\;\\forall t\\in\\mathbb R_{\\geq0}\\;\\bigl(t<\\delta\\to\\|T(t)(x)+_X((-1_K)\\odot_Xx)\\|_X<\\varepsilon\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}c0\\text{-}semigroup\\text{-}explicit} \\vdash \\mathrm{C0Semigroup}_S(T,X,\\|\\cdot\\|_X)\\leftrightarrow\\exists K,+_X,\\odot_X\\in V\\;\\mathrm{C0SemigroupStructure}_S(T,X,K,+_X,\\odot_X,\\|\\cdot\\|_X)","display":true},{"tex":"\\mathrm{df\\text{-}c0\\text{-}semigroup\\text{-}compatibility} \\vdash \\mathrm{C0Semigroup}_S(T,X)\\leftrightarrow\\exists\\|\\cdot\\|_X\\in\\mathbb R_{\\geq0}^{X}\\;\\mathrm{C0Semigroup}_S(T,X,\\|\\cdot\\|_X)","display":true},{"tex":"\\mathrm{df\\text{-}c0\\text{-}generator\\text{-}structure} \\vdash \\mathrm{C0GeneratorStructure}_S(A,T,X,K,+_X,\\odot_X,\\|\\cdot\\|_X) \\leftrightarrow \\mathrm{C0SemigroupStructure}_S(T,X,K,+_X,\\odot_X,\\|\\cdot\\|_X)\\land\\exists D\\subseteq X\\;\\Bigl(D=\\{x\\in X\\mid\\exists y\\in X\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists\\delta\\in\\mathbb R_{>0}\\;\\forall t\\in\\mathbb R_{>0}\\;(t<\\delta\\to\\|(t^{-1}_K\\odot_X(T(t)(x)+_X((-1_K)\\odot_Xx)))+_X((-1_K)\\odot_Xy)\\|_X<\\varepsilon)\\}\\land A\\in X^D\\land\\forall x\\in D\\;\\forall y\\in X\\;\\bigl(A(x)=y\\leftrightarrow\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists\\delta\\in\\mathbb R_{>0}\\;\\forall t\\in\\mathbb R_{>0}\\;(t<\\delta\\to\\|(t^{-1}_K\\odot_X(T(t)(x)+_X((-1_K)\\odot_Xx)))+_X((-1_K)\\odot_Xy)\\|_X<\\varepsilon)\\bigr)\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}c0\\text{-}generator\\text{-}explicit} \\vdash \\mathrm{Generator}_S(A,T,X,\\|\\cdot\\|_X)\\leftrightarrow\\exists K,+_X,\\odot_X\\in V\\;\\mathrm{C0GeneratorStructure}_S(A,T,X,K,+_X,\\odot_X,\\|\\cdot\\|_X)","display":true},{"tex":"\\mathrm{df\\text{-}c0\\text{-}generator\\text{-}compatibility} \\vdash \\mathrm{Generator}_S(A,T,X)\\leftrightarrow\\exists\\|\\cdot\\|_X\\in\\mathbb R_{\\geq0}^{X}\\;\\mathrm{Generator}_S(A,T,X,\\|\\cdot\\|_X)","display":true},{"tex":"M\\geq1","display":false},{"tex":"\\omega\\in\\mathbb R","display":false},{"tex":"\\|T(t)\\|\\leq Me^{\\omega t}","display":false},{"tex":"T(t)=e^{tA}","display":false}],"bytes":4182,"backlinks":[{"id":"0cea4f34bf35cc6f","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-224","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-c0-semigroup.md|58-df-c0-semigroup]]（batch19）"}],"outgoing":["5e8c7b8a7c03e2ed","ef59807ad934771f","2ad9c248fe18df37"]}