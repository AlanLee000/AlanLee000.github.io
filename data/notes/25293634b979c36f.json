&\\coloneqq\n\\{\\mathrm{UInst}_{T,\\operatorname{VList}(\\mathrm{free}_{L_A}(\\varphi))}(\\varphi):\n\\varphi\\in\\mathcal C\\}.\n\\end{aligned}","display":true},{"tex":"\\forall\\vec x(\\mathrm{Prov}_T(\\ulcorner\\varphi(\\dot{\\vec x})\\urcorner)\\to\\varphi(\\vec x))","display":false}],"bytes":3260,"backlinks":[{"id":"62d61040ca5b337c","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$T\\subseteq\\mathrm{Sent}_{L_A}$ 使用 [[67-df-reflection-principle]] 的固定编码、数词代入图与公式参数反思构造。"},{"id":"38502195e450dd58","anchor":"ref-48","locations":["正文"],"count":1,"excerpt":"[[../67-df-reflection-principle]]"},{"id":"aceae1bb446510ab","anchor":"ref-81","locations":["正文"],"count":1,"excerpt":"[[../67-df-reflection-principle]]"}],"outgoing":["6a4c234306a0ec0c","854772391cef4007","2035a1f4d72e7df9","5fa3acf328238c71","3fa0d0f598b791bc","4837cec0530b35f0"]}