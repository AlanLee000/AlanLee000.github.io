O(A\\land B\\mid C)):A,B,C\\in\\mathsf{Frm}_{606}\\}.","display":true},{"tex":"\\mathsf{Ax}_{606}\n=\n\\mathsf{Ax}_{\\to,1}^{606}\n\\cup\\mathsf{Ax}_{\\to,2}^{606}\n\\cup\\mathsf{Ax}_{\\to,3}^{606}\n\\cup\\mathsf{Ax}_{CO_K}^{606}\n\\cup\\mathsf{Ax}_{CO_D}^{606}\n\\cup\\mathsf{Ax}_{Detach}^{606}\n\\cup\\mathsf{Ax}_{CAnd}^{606}.","display":true},{"tex":"\\mathsf{Rule}_{MP}^{606}=\\{((A,A\\to B),B):A,B\\in\\mathsf{Frm}_{606}\\}.","display":true},{"tex":"\\mathsf{Rule}_{CO}^{606}\n=\n\\{((A\\to B),\\,O(A\\mid C)\\to O(B\\mid C)):A,B,C\\in\\mathsf{Frm}_{606}\\}.","display":true},{"tex":"\\mathsf{Rule}_{CE}^{606}\n=\n\\{((B\\leftrightarrow C),\\,O(A\\mid B)\\leftrightarrow O(A\\mid C)):A,B,C\\in\\mathsf{Frm}_{606}\\}.","display":true},{"tex":"\\mathsf{Rule}_{606}=\\mathsf{Rule}_{MP}^{606}\\cup\\mathsf{Rule}_{CO}^{606}\\cup\\mathsf{Rule}_{CE}^{606}.","display":true},{"tex":"\\Gamma\\subseteq\\mathsf{Frm}_{606}","display":false},{"tex":"\\mathsf{Proof}_{606}(\\Gamma)","display":false},{"tex":"((\\Delta_i,A_i))_{i<m}","display":false},{"tex":"m>0","display":false},{"tex":"\\Delta_i\\in\\mathcal P_{\\mathrm{fin}}(\\Gamma)","display":false},{"tex":"A_i\\in\\mathsf{Frm}_{606}","display":false},{"tex":"A_i\\in\\Gamma","display":false},{"tex":"\\Delta_i=\\{A_i\\}","display":false},{"tex":"A_i\\in\\mathsf{Ax}_{606}","display":false},{"tex":"\\Delta_i=\\varnothing","display":false},{"tex":"j,k<i","display":false},{"tex":"A_k=A_j\\to A_i","display":false},{"tex":"\\Delta_i=\\Delta_j\\cup\\Delta_k","display":false},{"tex":"j<i","display":false},{"tex":"A_j=A\\to B","display":false},{"tex":"A_i=O(A\\mid C)\\to O(B\\mid C)","display":false},{"tex":"\\Delta_j=\\Delta_i=\\varnothing","display":false},{"tex":"j<i","display":false},{"tex":"A_j=B\\leftrightarrow C","display":false},{"tex":"A_i=O(A\\mid B)\\leftrightarrow O(A\\mid C)","display":false},{"tex":"\\Delta_j=\\Delta_i=\\varnothing","display":false},{"tex":"\\Gamma\\vdash_{606}A","display":true},{"tex":"\\pi=((\\Delta_i,A_i))_{i<m}