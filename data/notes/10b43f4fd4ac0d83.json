cy\\text{-}definition}\\vdash\n\\mathrm{PD}\\coloneqq\\forall n\\in\\omega\\setminus\\{0\\}\\;\\forall A\\in\\Sigma_n^1(\\mathcal N)\\;\n\\mathrm{Det}(\\omega^{<\\omega},A,\\omega)","display":true},{"tex":"\\mathrm{thm\\text{-}projective\\text{-}determinacy\\text{-}finite\\text{-}woodins}\\vdash\n\\vartheta_n\\coloneqq\n\\ulcorner\\exists\\delta_0\\cdots\\exists\\delta_{n-1}\\;(\n\\delta_0<\\cdots<\\delta_{n-1}\\land\\bigwedge_{i<n}\\mathrm{Woodin}(\\delta_i))\\urcorner,\n\\qquad\nT_{<\\omega\\mathrm W}\\coloneqq\\mathrm{ZFC}\\cup\\{\\vartheta_n:n\\in\\omega\\}","display":true},{"tex":"\\mathrm{thm\\text{-}projective\\text{-}determinacy\\text{-}strength}\\vdash\n\\mathrm{Con}_S(\\mathrm{ZFC}\\cup\\{\\ulcorner\\mathrm{PD}\\urcorner\\})\n\\leftrightarrow\n\\mathrm{Con}_S(T_{<\\omega\\mathrm W})","display":true},{"tex":"n","display":false},{"tex":"n","display":false}],"bytes":2652,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4373","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-thm-projective-determinacy-strength.md|58-thm-projective-determinacy-strength]]（batch15）"},{"id":"7334957c6d59eacc","anchor":"ref-239","locations":["正文"],"count":1,"excerpt":"[[58-thm-0-sharp.md]]\n[[58-thm-L-condensation.md]]\n[[58-thm-L-definability.md]]\n[[58-thm-L-generic-extension.md]]\n[[58-thm-L-is-transitive.md]]\n[[58-thm-L-satisfies-GCH.md]]\n[[58-thm-L-satisfies-ZFC.md]]\n[[58-thm-MM.md]]\n[[58-thm-V-equal-L.md]]\n[[58-thm-V-equals-L.md]]\n[[58-thm-absoluteness-calculation.md]]\n[[58-thm-ac-wellorder-equivalent.md]]\n[[58-thm-aleph-properties.md]]\n[[58-thm-analytic-completeness.md]]\n[[58-thm-analytic-set-properties.md]]\n[[58-thm-baire-category-theory.md]]\n[[58-thm-baire-category.md]]\n[[58-thm-banach-tarski.md]]\n[[58-thm-beth-function-properties.md]]\n[[58-thm-boolean-valued-model.md]]\n[[58-thm-borel-cardinality.md]]\n[[58-thm-borel-determinacy-proof.md]]\n[[58-thm-bounded-forcing-axioms.md]]\n[[58-thm-cantor.md]]\n[[58-thm-cardinal-multiplication.md]]\n[[58-thm-c