{"id":"adc91f1a41e1970e","group":"58","path":"58/batch18/58-df-zfc-order11-linear-extension.md","title":"ZFC Order11 Linear Extension","display":"df-zfc-order11-linear-extension — ZFC Order11 Linear Extension","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-order11-linear-extension","aliases":["58-df-zfc-order11-linear-extension"],"display":"df-zfc-order11-linear-extension — ZFC Order11 Linear Extension","depends_on":["[[58-ax-zfc]]","[[../batch02/58-df-poset.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-order11-linear-extension"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-order11-linear-extension</span></div>"},{"key":"display","html":"df-zfc-order11-linear-extension — ZFC Order11 Linear Extension"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"L,R,X\\in V\">\\(L,R,X\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Poset}\">\\(\\mathrm{Poset}\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcOrder11LinearExtension}_S\\subseteq V^3\">\\(\\mathrm{ZfcOrder11LinearExtension}_S\\subseteq V^3\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}order11\\text{-}linear\\text{-}extension}\\vdash\n\\mathrm{ZfcOrder11LinearExtension}_S(L,R,X)\\leftrightarrow\n\\mathrm{Poset}(X,R)\\land\\mathrm{Poset}(X,L)\\land R\\subseteq L\n\\land\\forall x,y\\in X\\;\n\\bigl(\\langle x,y\\rangle\\in L\\lor\\langle y,x\\rangle\\in L\\bigr).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}order11\\text{-}linear\\text{-}extension}\\vdash\n\\mathrm{ZfcOrder11LinearExtension}_S(L,R,X)\\leftrightarrow\n\\mathrm{Poset}(X,R)\\land\\mathrm{Poset}(X,L)\\land R\\subseteq L\n\\land\\forall x,y\\in X\\;\n\\bigl(\\langle x,y\\rangle\\in L\\lor\\langle y,x\\rangle\\in L\\bigr).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary linear extension definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-poset.md]]","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Poset}$ (see [[../batch02/58-df-poset.md]])","embed":false}],"math":[{"tex":"L,R,X\\in V","display":false},{"tex":"\\mathrm{Poset}","display":false},{"tex":"\\mathrm{ZfcOrder11LinearExtension}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}order11\\text{-}linear\\text{-}extension}\\vdash\n\\mathrm{ZfcOrder11LinearExtension}_S(L,R,X)\\leftrightarrow\n\\mathrm{Poset}(X,R)\\land\\mathrm{Poset}(X,L)\\land R\\subseteq L\n\\land\\forall x,y\\in X\\;\n\\bigl(\\langle x,y\\rangle\\in L\\lor\\langle y,x\\rangle\\in L\\bigr).","display":true}],"bytes":890,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2890","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-order11-linear-extension.md|58-df-zfc-order11-linear-extension]]（batch18）"}],"outgoing":["a3348ed9eb6fb4e3","d3f859dbdd37f018"]}