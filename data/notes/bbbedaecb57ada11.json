\\operatorname{Hom}_R(R^n,F)\\;\\bigl(\\mathrm{Surjective}(q,R^n,F)\\land\\ker(q)=\\operatorname{ran}(A)\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}pure\\text{-}projective\\text{-}epimorphism} \\vdash \\operatorname{PureEpimorphism}_S(\\pi,P,N,R)\\leftrightarrow \\operatorname{Module}(P,R)\\land\\operatorname{Module}(N,R)\\land\\pi\\in\\operatorname{Hom}_R(P,N)\\land\\mathrm{Surjective}(\\pi,P,N)\\land\\forall F\\;\\left(\\operatorname{FinitelyPresentedModule}_S(F,R)\\to\\forall h\\in\\operatorname{Hom}_R(F,N)\\;\\exists\\widetilde h\\in\\operatorname{Hom}_R(F,P)\\;(\\pi\\circ\\widetilde h=h)\\right)","display":true},{"tex":"\\mathrm{df\\text{-}pure\\text{-}projective} \\vdash \\operatorname{PureProjective}_S(M,R)\\leftrightarrow \\operatorname{Module}(M,R)\\land\\forall P,N,\\pi\\;\\left(\\operatorname{PureEpimorphism}_S(\\pi,P,N,R)\\to\\forall h\\in\\operatorname{Hom}_R(M,N)\\;\\exists\\widetilde h\\in\\operatorname{Hom}_R(M,P)\\;(\\pi\\circ\\widetilde h=h)\\right)","display":true}],"bytes":2848,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1018","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-pure-projective.md|58-df-pure-projective]]（batch11）"}],"outgoing":["ef3a5dd6825f0373","9f8cb046321ba311","25e593b1b8714c23"]}