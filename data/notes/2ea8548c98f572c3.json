":"B\\le_TA","display":false},{"tex":"A,B","display":false},{"tex":"B'\\le_TA'","display":false},{"tex":"B\\le_TA","display":false}],"bytes":2317,"backlinks":[{"id":"331efd41ed572fd4","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-thm-dnc2-special-class]]；see [[20-thm-low-basis]]；see [[20-thm-dnc-fpf-degrees]]；see [[20-thm-arslanov]]；see [[20-thm-jump]]。"},{"id":"6330178076c4520f","anchor":"ref-14","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-partial-compatibility]]；see [[20-df-strings]]；see [[20-df-relative-ce]]；see [[20-df-jump]]；see [[20-thm-relative-limit]]；see [[20-df-pairing]]；see [[20-thm-jump]]。"},{"id":"476bf6706c15594f","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-oracle-stage-evaluation]]；see [[20-df-low-high]]；see [[20-thm-shoenfield-limit]]；see [[20-thm-jump]]。"},{"id":"bc7d5064491f1d37","anchor":"ref-14","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-1gen]]；see [[20-df-gl1]]；see [[20-df-low-high]]；see [[20-df-functional-graph]]；see [[20-df-join]]；see [[20-thm-K-one-complete]]；see [[20-thm-jump]]。"},{"id":"7e4e35763e70ecc9","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-thm-post]]；see [[20-thm-jump]]；see [[20-thm-hierarchy-closure]]。"},{"id":"8372f8b6f584a62e","anchor":"ref-12","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-gale-stewart]]；see [[20-lem-open-winning-certificate]]；see [[20-df-closed-winning-strategies]]；see [[20-thm-low-basis]]；see [[20-df-low-high]]；see [[20-thm-jump]]。"},{"id":"e9b28c9ef17c93bd","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-thm-low-ce-generate]]；see [[20-thm-jump]]；see [[20-df-low-high]]；see [[20-df-redeg]]。"},{"id":"d467a7b6bbdb1c63","anchor":"ref-14","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-basis]]；see [[20-df-low-high]]；