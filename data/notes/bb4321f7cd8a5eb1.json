":false},{"tex":"\\mathrm{df\\text{-}encoding\\text{-}completeness} \\vdash \\begin{aligned}\n&C_G\\coloneqq\\mathrm{Code}_G(\\mathrm{Expr}(\\Sigma_G)),\\\\\n&\\mathrm{Dec}_G:C_G\\to\\mathrm{Expr}(\\Sigma_G),\\qquad\n\\forall k\\in\\mathbb N\\;\\forall(q_0,\\ldots,q_{k-1})\\in\\mathbb N^k\\;\n\\forall n\\in C_G\\;\\Bigl(\n\\mathrm{SeqDec}(n)=\\langle q_0,\\ldots,q_{k-1}\\rangle\\Longrightarrow\n\\mathrm{Dec}_G(n)\\coloneqq\n\\langle c^{-1}(q_0),\\ldots,c^{-1}(q_{k-1})\\rangle\\Bigr),\\\\\n&\\mathrm{EncComplete}_G(X)\\leftrightarrow X\\subseteq\\mathrm{Expr}(\\Sigma_G)\n\\land\\forall E\\in X\\;\\bigl(\\mathrm{Dec}_G(\\ulcorner E\\urcorner)=E\\bigr)\n\\land\\forall n\\in\\mathrm{Code}_G(X)\\;\\bigl(\\mathrm{Dec}_G(n)\\in X\\land\\ulcorner\\mathrm{Dec}_G(n)\\urcorner=n\\bigr).\n\\end{aligned}","display":true},{"tex":"X","display":false},{"tex":"X","display":false}],"bytes":2263,"backlinks":[{"id":"d8d33d47202e6d60","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Dec}_G$ (decoder on legal expression codes, see [[92-df-encoding-completeness]])"},{"id":"31cbbeaa392f6458","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"9252d4105cc5f189","anchor":"ref-8","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"d8d7d3ba56a05b13","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Dec}_G$ (decoder on legal codes, see [[92-df-encoding-completeness]])"},{"id":"067a36526639087d","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Dec}_G$ (inverse decoder on legal expression codes, see [[92-df-encoding-completeness]])"},{"id":"6c4d7648de3418cf","anchor":"ref-12","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$C_G\\subseteq\\mathbb N$ (valid expression-code set, see [[92-df-encoding-completeness]])"},{"id":"911d25a82b6a7593","anchor":"ref-69","locations":["正文"],"count":1,"excerpt":"[[92-df-encoding-completeness]]"},{"id":"8