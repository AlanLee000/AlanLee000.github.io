\\langle q_0,\\ldots,q_{k-1}\\rangle\\Longrightarrow\n\\mathrm{Dec}_G(n)\\coloneqq\n\\langle c^{-1}(q_0),\\ldots,c^{-1}(q_{k-1})\\rangle\\Bigr),\\\\\n&\\mathrm{EncComplete}_G(X)\\leftrightarrow X\\subseteq\\mathrm{Expr}(\\Sigma_G)\n\\land\\forall E\\in X\\;\\bigl(\\mathrm{Dec}_G(\\ulcorner E\\urcorner)=E\\bigr)\n\\land\\forall n\\in\\mathrm{Code}_G(X)\\;\\bigl(\\mathrm{Dec}_G(n)\\in X\\land\\ulcorner\\mathrm{Dec}_G(n)\\urcorner=n\\bigr).\n\\end{aligned}","display":true},{"tex":"X","display":false},{"tex":"X","display":false}],"bytes":1943,"backlinks":[{"id":"d8d33d47202e6d60","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Dec}_G$ (decoder on legal expression codes, see [[92-df-encoding-completeness]])"},{"id":"d8d7d3ba56a05b13","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Dec}_G$ (decoder on legal codes, see [[92-df-encoding-completeness]])"},{"id":"067a36526639087d","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Dec}_G$ (inverse decoder on legal expression codes, see [[92-df-encoding-completeness]])"},{"id":"6c4d7648de3418cf","anchor":"ref-12","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$C_G\\subseteq\\mathbb N$ (valid expression-code set, see [[92-df-encoding-completeness]])"},{"id":"911d25a82b6a7593","anchor":"ref-69","locations":["正文"],"count":1,"excerpt":"[[92-df-encoding-completeness]]"},{"id":"823a52c75bbad9bd","anchor":"ref-39","locations":["正文"],"count":1,"excerpt":"[[92-df-1-consistency.md]]\n[[92-df-analytical-hierarchy.md]]\n[[92-df-arithmetic-hierarchy.md]]\n[[92-df-arithmetic-truth.md]]\n[[92-df-arithmetical-formula.md]]\n[[92-df-arithmetical-truth.md]]\n[[92-df-arithmetization-formula.md]]\n[[92-df-arithmetization-property.md]]\n[[92-df-arithmetization-steps.md]]\n[[92-df-arithmetization.md]]\n[[92-df-assignment.md]]\n[[92-df-atomic-formula.md]]\n[[92-df-axiom-check.md]]\n[[92-df-axiom-set.md]]\n[[92-df-axiomatization.