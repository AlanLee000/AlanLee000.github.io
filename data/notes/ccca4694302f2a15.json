me{meet}(\\widehat\\sigma(A),\\widehat\\sigma(B)).","display":true},{"tex":"\\operatorname{BV}_{P_n}:\\mathsf{Fm}_{P_n}\\to\\mathcal P(\\mathsf{Prop}_{P_n}),\n\\qquad\n\\equiv_{\\alpha,P_n}\\ \\subseteq\\ \\mathsf{Fm}_{P_n}\\times\\mathsf{Fm}_{P_n}.","display":true},{"tex":"\\operatorname{BV}_{P_n}(A)=\\varnothing,\n\\qquad\nA\\equiv_{\\alpha,P_n}B\\Longleftrightarrow A=B.","display":true},{"tex":"\\mathsf V_{P_n}=\\{k\\in\\mathbb N:k<n\\},\n\\qquad\n\\mathsf D_{P_n}=\\{n-1\\}.","display":true},{"tex":"\\mathbf0_{P_n}=0,\\qquad \\mathbf1_{P_n}=n-1.","display":true},{"tex":"N_{P_n}:\\mathsf V_{P_n}\\to\\mathsf V_{P_n},\n\\qquad\n\\vee_{P_n},\\wedge_{P_n}:\\mathsf V_{P_n}^2\\to\\mathsf V_{P_n}.","display":true},{"tex":"N_{P_n}(a)=\n\\begin{cases}\na+1,&a<n-1,\\\\\n0,&a=n-1.\n\\end{cases}","display":true},{"tex":"a\\vee_{P_n}b=\\max(a,b),\n\\qquad\na\\wedge_{P_n}b=\\min(a,b).","display":true},{"tex":"\\mathsf{Val}_{P_n}=\\{v:\\mathsf{Prop}_{P_n}\\to\\mathsf V_{P_n}\\}.","display":true},{"tex":"v","display":false},{"tex":"\\overline v:\\mathsf{Fm}_{P_n}\\to\\mathsf V_{P_n}","display":false},{"tex":"\\overline v(\\operatorname{atom}(p))=v(p),\n\\qquad\n\\overline v(\\operatorname{zero})=\\mathbf0_{P_n},\n\\qquad\n\\overline v(\\operatorname{one})=\\mathbf1_{P_n},","display":true},{"tex":"\\overline v(\\operatorname{cyc}(A))=N_{P_n}(\\overline v(A)),","display":true},{"tex":"\\overline v(\\operatorname{join}(A,B))=\\overline v(A)\\vee_{P_n}\\overline v(B),","display":true},{"tex":"\\overline v(\\operatorname{meet}(A,B))=\\overline v(A)\\wedge_{P_n}\\overline v(B).","display":true},{"tex":"\\mathsf{Fail}_{P_n}:\\mathcal P(\\mathsf{Fm}_{P_n})\\times\\mathsf{Fm}_{P_n}\n\\to\\mathcal P(\\mathsf{Val}_{P_n}).","display":true},{"tex":"\\mathsf{Fail}_{P_n}(\\Gamma,A)\n=\n\\{v\\in\\mathsf{Val}_{P_n}:\n(\\forall G\\in\\Gamma\\ \\overline v(G)\\in\\mathsf D_{P_n})\n\\text{ 且 }\n\\overline v(A)\\notin\\mathsf D_{P_n}\\}.","display":true},{"tex":"\\Gamma\\Vdash_{P_n}A\n\\quad\\Longlef