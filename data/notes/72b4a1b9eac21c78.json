{"id":"72b4a1b9eac21c78","group":"68","path":"68/68-thm-solution-to-posts-problem.md","title":"Solution to Post's Problem","display":"thm-solution-to-posts-problem — Solution to Post's Problem","type":"theorem","metadata":{"type":"theorem","book":"Recursion Theory (Shoenfield)","book_abbrev":"68","label":"68-thm-solution-to-posts-problem","aliases":["68-thm-solution-to-posts-problem"],"display":"thm-solution-to-posts-problem — Solution to Post's Problem","depends_on":["[[68-df-post-problem]]","[[68-df-intermediate-degree]]","[[68-thm-friedberg-muchnik-theorem]]","[[68-thm-jump-theorem]]","[[68-df-recursively-enumerable-set]]","[[68-df-recursive-set]]","[[68-df-halting-set]]","[[68-df-turing-reducibility]]"],"source_edition":"1993 original; 2016 Cambridge reissue, supplied PDF","source_location":"§15 pp.56-58 / PDF 65-67; consequence of proposition 15.5","verification_status":"proved-in-note","source_proof_status":"local-proof-reviewed"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"theorem"},{"key":"book","html":"Recursion Theory (Shoenfield)"},{"key":"book_abbrev","html":"68"},{"key":"label","html":"68-thm-solution-to-posts-problem"},{"key":"aliases","html":"<div class=\"property-array\"><span>68-thm-solution-to-posts-problem</span></div>"},{"key":"display","html":"thm-solution-to-posts-problem — Solution to Post's Problem"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"223508772f8e35c5\" href=\"?note=223508772f8e35c5\" title=\"68-df-post-problem\">68-df-post-problem</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"3f4822140bfc0f9e\" href=\"?note=3f4822140bfc0f9e\" title=\"68-df-intermediate-degree\">68-df-intermediate-degree</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"0cca9651cac638c4\" href=\"?note=0cca9651cac638c4\" title=\"68-thm-friedberg-muchnik-theorem\">68-thm-friedberg-muchnik-theorem</a></span><span><a class=\"wiki-link\" id=