\\leq_P)\\leftrightarrow\n\\left(\n\\mathrm{Poset}(P,\\leq_P)\\land I\\subseteq P\\land\n\\forall x\\in I\\;\\forall y\\in P\\;(y\\leq_Px\\to y\\in I)\n\\right)","display":true}],"bytes":928,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2934","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-zfc-order2-initial-segment.md|58-df-zfc-order2-initial-segment]]（batch02）"}],"outgoing":["a3348ed9eb6fb4e3","d3f859dbdd37f018"]}