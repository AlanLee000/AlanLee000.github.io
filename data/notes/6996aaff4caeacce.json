"tex":"\\mathfrak C","display":false},{"tex":"\\forall\\varphi\\in\\mathrm{Sent}_L\\;\\neg(T\\vdash\\varphi\\land\\neg\\varphi)","display":false},{"tex":"\\mathcal M","display":false},{"tex":"\\mathcal M\\models T","display":false},{"tex":"\\mathrm{Con}_S(T)\\to\\mathrm{Con}_S(T+\\varphi)","display":false},{"tex":"+\\mathrm{CH}","display":false},{"tex":"+\\neg\\mathrm{CH}","display":false}],"bytes":2738,"backlinks":[{"id":"7cadc4ab36b41124","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"8e3443388df2630d","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Con}_S$ (syntactic-consistency predicate, see [[../batch13/58-df-consistency]])"},{"id":"a4d3c71685246c85","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Con}_S\\subseteq V$ (see [[../batch13/58-df-consistency.md]])"},{"id":"3ec71b553c025f0a","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZFC}$ and $\\mathrm{Con}_S:V\\to\\{\\top,\\bot\\}$ (see [[../batch13/58-df-consistency.md]])"},{"id":"57ef15d90618ea60","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"57389b11bb1e9431","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"c8dfa3853919882a","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"5369b8541007a261","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Con}_S(T)$ is syntactic consistency (see [[../batch13/58-df-consistency.md]])"},{"id":"5410a5b39300442c","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"121ea2e24c75ec11","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{ConsistentTheory}_S$ (explicit syntactic consistency predicate, see [[../batch13/58-df-consistency]])"},{"id":"74518fe8da772d53","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""}