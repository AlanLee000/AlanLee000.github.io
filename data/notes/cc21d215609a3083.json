nd\\mathcal C\\ne\\varnothing,\\\\\n\\forall D\\in\\mathcal E\\ (D<_TK\\Rightarrow\\forall X\\in\\mathcal C\\ X\\not\\le_TD)\n\\end{gathered}\\right].","display":true},{"tex":"A","display":false},{"tex":"B=\\omega\\setminus A","display":false},{"tex":"B","display":false},{"tex":"b(e)=2e+1","display":false},{"tex":"p_B(n)\\le2n","display":false},{"tex":"F","display":false},{"tex":"B","display":false},{"tex":"\\mathcal C=\\{X\\subseteq\\omega:X\\cap A=\\varnothing\\land\\forall n\\ X\\cap F_n\\ne\\varnothing\\}.","display":true},{"tex":"y\\in A","display":false},{"tex":"X(y)=1","display":false},{"tex":"F_n","display":false},{"tex":"B","display":false},{"tex":"\\mathcal C","display":false},{"tex":"F_n","display":false},{"tex":"X","display":false},{"tex":"X\\in\\mathcal C","display":false},{"tex":"B","display":false},{"tex":"D","display":false},{"tex":"X","display":false},{"tex":"D\\equiv_TK","display":false},{"tex":"\\mathcal C","display":false},{"tex":"A,B","display":false}],"bytes":2827,"backlinks":[],"outgoing":["b73290a0af01d44f","a03c2828834ee687","60af447f5d59a8dc","0e6b2238da5572e4","0ddc2f4aa380ea29","b5b64991d8dc3e7d","680f7bcce5dddc10","352368d98a9342b6","b222e27484042250","5fb6eea724c1b5f2"]}