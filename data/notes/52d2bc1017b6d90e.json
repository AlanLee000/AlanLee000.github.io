{"id":"52d2bc1017b6d90e","group":"58","path":"58/batch18/58-df-zfc-measure5-measurable-set.md","title":"ZFC Measure5 Measurable Set","display":"df-zfc-measure5-measurable-set — ZFC Measure5 Measurable Set","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-measure5-measurable-set","aliases":["58-df-zfc-measure5-measurable-set","58-df-zfc-measure6-measurable-set"],"display":"df-zfc-measure5-measurable-set — ZFC Measure5 Measurable Set","depends_on":["[[../batch09/58-df-measurable-space.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-measure5-measurable-set"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-measure5-measurable-set</span><span>58-df-zfc-measure6-measurable-set</span></div>"},{"key":"display","html":"df-zfc-measure5-measurable-set — ZFC Measure5 Measurable Set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"7f96c502a4a99a46\" href=\"?note=7f96c502a4a99a46\" title=\"../batch09/58-df-measurable-space.md\">../batch09/58-df-measurable-space.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\mathcal A,E\\in V\">\\(X,\\mathcal A,E\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{MeasurableSpace}_S\\subseteq V^2\">\\(\\mathrm{MeasurableSpace}_S\\subseteq V^2\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"7f96c502a4a99a46\" href=\"?note=7f96c502a4a99a46\" title=\"../batch09/58-df-measurable-space.md\">../batch09/58-df-measurable-space.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure5MeasurableSet}_S\\subseteq V^3\">\\(\\mathrm{ZfcMeasure5MeasurableSet}_S\\subseteq V^3\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure5\\text{-}measurable\\text{-}set} \\vdash \\mathrm{ZfcMeasure5MeasurableSet}_S(X,\\mathcal A,E)\\leftrightarrow \\mathrm{MeasurableSpace}_S(X,\\mathcal A)\\land E\\in\\mathcal A\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure5\\text{-}measurable\\text{-}set} \\vdash \\mathrm{ZfcMeasure5MeasurableSet}_S(X,\\mathcal A,E)\\leftrightarrow \\mathrm{MeasurableSpace}_S(X,\\mathcal A)\\land E\\in\\mathcal A\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Measurable sets are members of the sigma-algebra.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch09/58-df-measurable-space.md","status":"resolved","id":"7f96c502a4a99a46","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch09/58-df-measurable-space.md]]","embed":false},{"target":"../batch09/58-df-measurable-space.md","status":"resolved","id":"7f96c502a4a99a46","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{MeasurableSpace}_S\\subseteq V^2$ (see [[../batch09/58-df-measurable-space.md]])","embed":false}],"math":[{"tex":"X,\\mathcal A,E\\in V","display":false},{"tex":"\\mathrm{MeasurableSpace}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcMeasure5MeasurableSet}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}measure5\\text{-}measurable\\text{-}set} \\vdash \\mathrm{ZfcMeasure5MeasurableSet}_S(X,\\mathcal A,E)\\leftrightarrow \\mathrm{MeasurableSpace}_S(X,\\mathcal A)\\land E\\in\\mathcal A","display":true}],"bytes":886,"backlinks":[{"id":"84daad544872cc71","anchor":"re