htarrow{}&\n\\operatorname{TopologicalSpace}_S(X,\\tau)\n\\land\\exists\\mathcal A\\in V\\;\\Bigl(\n\\mathrm{Measure}_S(\\mu,X,\\mathcal A)\n\\land\\tau\\subseteq\\mathcal A\\land\\mu(X)<\\infty\\\\\n&{}\\land\\forall A\\in\\mathcal A\\;\\forall\\epsilon\\in\\mathbb R_{>0}\\;\n\\exists K,U,\\tau_K\\in V\\;\\Bigl(K\\subseteq A\\subseteq U\n\\land K\\in\\mathcal A\\land U\\in\\tau\\\\\n&\\hspace{27mm}{}\\land\\tau_K=\\{O\\cap K:O\\in\\tau\\}\n\\land\\mathrm{Compact}_S(K,\\tau_K)\n\\land\\mu(U\\setminus K)<\\epsilon\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\operatorname{dom}(\\mu)","display":false}],"bytes":1850,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2550","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-measure10-regular-measure-witness.md|58-df-zfc-measure10-regular-measure-witness]]（batch18）"}],"outgoing":["a3348ed9eb6fb4e3","815e63e5071e7b58","050f6d05b2c94aea","ca832ed6bc22f728"]}