cal B_\\Omega,\\mu_\\Omega,\n\\mathbb R,\\mathcal B_{\\mathbb R},\\mathbb R,+_{\\mathbb R},\\cdot_{\\mathbb R},|\\cdot|)\\\\\n&\\hspace{12em}\\land\n\\mathrm{BochnerIntegral}_S(I_u,x\\mapsto u(x)D^\\alpha\\phi(x),\\Omega,\\mathcal B_\\Omega,\\mu_\\Omega,\n\\mathbb R,\\mathcal B_{\\mathbb R},\\mathbb R,+_{\\mathbb R},\\cdot_{\\mathbb R},|\\cdot|)\\\\\n&\\hspace{12em}\\land I_v=(-1)^{|\\alpha|}I_u\n\\Bigr)\\Bigr]\\lor\\Bigl[n=0\\land\\Omega\\subseteq\\mathbb R^0\\land\\alpha=\\varnothing\\land u,v\\in\\mathbb R^\\Omega\\land u=v\\Bigr].\n\\end{aligned}","display":true},{"tex":"W^{k,1}(\\Omega)","display":false},{"tex":"L^p","display":false}],"bytes":3235,"backlinks":[{"id":"70d7a97bd7315c54","anchor":"ref-6","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"c87f6cb3f8b7760d","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{WeakDerivative}_S:V^5\\to\\{\\top,\\bot\\}$ (see [[../batch08/58-df-weak-derivative.md]])"},{"id":"a1f6d4733dbaf832","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"38c58fda0da62833","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{WeakDerivative}_S:V^5\\to\\{\\top,\\bot\\}$ (see [[../batch08/58-df-weak-derivative.md]])"},{"id":"84daad544872cc71","anchor":"ref-1376","locations":["正文"],"count":1,"excerpt":"[[../batch08/58-df-weak-derivative.md|58-df-weak-derivative]]（batch08）"}],"outgoing":["9e0348ed2298c600","458fd0dccec3665f","83e0b1063552231c"]}