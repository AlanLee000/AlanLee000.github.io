s}&\n\\mathrm{sn}_L(n)&\\coloneqq\\begin{cases}1,&n\\in g_L[\\mathrm{Sent}_L],\\\\0,&n\\notin g_L[\\mathrm{Sent}_L],\\end{cases}\\\\\n\\mathrm{la}_L(n)&\\coloneqq\\begin{cases}1,&n\\in g_L[\\mathrm{LogAx}_L],\\\\0,&n\\notin g_L[\\mathrm{LogAx}_L],\\end{cases}\\\\\n\\mathrm{imp}_L(n,m)&\\coloneqq\\operatorname{enc}\\!\\left(\\left\\langle4,\n\\operatorname{enc}\\!\\left(\\left\\langle5,n,\\operatorname{enc}(\\langle4,m\\rangle)\\right\\rangle\\right)\\right\\rangle\\right),\\\\\n\\mathrm{all}_L(i,n)&\\coloneqq\\operatorname{enc}(\\langle6,i,n\\rangle),\\\\\n\\lambda_L(p,i)&\\coloneqq E_D\\!\\Bigl(i<\\operatorname{Len}(p)\n\\land\\forall j<\\operatorname{Len}(p)\\ (\\mathrm{fm}_L((p)_j)=1)\\\\\n&\\quad\\land\\bigl[\\mathrm{la}_L((p)_i)=1\n\\lor\\exists j<i\\exists h<i\\ ((p)_h=\\mathrm{imp}_L((p)_j,(p)_i))\\\\\n&\\hspace{7em}\\lor\\exists j<i\\ ((p)_i=\\mathrm{all}_L(((p)_i)_1,(p)_j))\\bigr]\\Bigr),\\\\\n\\mathrm{Prf}^{L}_{\\sigma}(u,v)&\\coloneqq E_D\\!\\Bigl(\n\\operatorname{Len}(u)>0\\land\\mathrm{fm}_L(v)=1\\\\\n&\\quad\\land\\exists j<\\operatorname{Len}(u)\\ (j+1=\\operatorname{Len}(u)\\land(u)_j=v)\\\\\n&\\quad\\land\\forall i<\\operatorname{Len}(u)\\\n\\bigl[\\lambda_L(u,i)\\lor(\\mathrm{sn}_L((u)_i)=1\\land\\sigma[(u)_i/z])\\bigr]\\Bigr),\\\\\n\\mathrm{Pr}^{L}_{\\sigma}(v)&\\coloneqq\\exists u\\,\\mathrm{Prf}^{L}_{\\sigma}(u,v),\\\\\n\\mathrm{Con}^{L}_{\\sigma}&\\coloneqq\\neg\\mathrm{Pr}^{L}_{\\sigma}(\\overline{g_L(\\bot_L)}).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\vec\\varphi_F&\\coloneqq\\iota\\vec\\varphi\\in\\mathrm{Sent}_L^{|F|}\\\n\\left[\\{\\varphi_i:i<|F|\\}=F\\land\\forall i<j<|F|\\ (g_L(\\varphi_i)<g_L(\\varphi_j))\\right],\\\\\na_{L,A}&\\coloneqq(\\pi_L(A))_0,&e_{L,A}&\\coloneqq(\\pi_L(A))_1,\\\\\n\\sigma^L_A(z)&\\coloneqq\\begin{cases}\n\\displaystyle\\bigvee\\langle z=\\overline{g_L((\\vec\\varphi_A)_i)}\\rangle_{i<|A|},&|A|<\\aleph_0,\\\\\nD_{a_{L,A}}(z,1),&|A|\\ge\\aleph_0,\n\\end{cases}\\\\\n\\mathrm{PrfRel}_{L,A}(p,n)&\\Longleftrightarrow\n\\operatorname{Seq}(p)\\land\\operatorname{Len}(p)>0\\\\\n&\\quad\\land\\exists\\vec\\varphi\\in\\mathrm{Fml}_L^{\\operatorname{Len}(p)}\\ \\bigl[\n\\forall j<\\operatorname{Len}(p)\\ ((p)_j=g_L(\\varphi_j))\\\\\n&\\qquad\\land\\forall i<\\operatorname{Len}(p)\\\n(\\operatorname{LocalLine}_{\\varnothing,L}(\\vec\\varphi,i)\\lor\\varphi_i\\in A)\\\\\n&\\qquad\\land\\exists j<\\operatorname{Len}(p)\\ (j+1=\\operatorname{Len}(p)\\land(p)_j=n)\\bigr],\\\\\nh_{L,A}(p,n)&\\coloneqq\\begin{cases}0,&\\mathrm{PrfRel}_{L,A}(p,n),\\\\1,&\\neg\\mathrm{PrfRel}_{L,A}(p,n),\\end{cases}\\\\\n\\mathrm{StdGPrf}_{L,A}(P,e)&\\Longleftrightarrow\ne\\in\\mathrm{PRProg}_2\\land P\\in\\mathrm{Fml}_{L_A}[u,v]\\\\\n&\\quad\\land\\forall p,n\\in\\mathbb N\\ (⟦ e⟧(p,n)=h_{L,A}(p,n))\\\\\n&\\quad\\land P=D_e(u,v,0)\\\\\n&\\quad\\land\\left(\\mathrm{PA}\\vdash\\forall u\\forall v\\\n(P(u,v)\\leftrightarrow\\mathrm{Prf}^{L}_{\\sigma^L_A}(u,v))\\right),\\\\\n\\mathrm{GPrfSystem}_L(\\pi_L)&\\Longleftrightarrow\n\\pi_L:\\mathcal A_L\\to\\mathrm{PRProg}_1\\times\\mathrm{PRProg}_2\\\\\n&\\quad\\land\\forall A\\in\\mathcal A_L\\ \\bigl[\n\\forall n\\in\\mathbb N\\ (⟦ a_{L,A}⟧(n)\\in\\{0,1\\}\n\\land(⟦ a_{L,A}⟧(n)=1\\leftrightarrow n\\in g_L[A]))\\\\\n&\\qquad\\land\\mathrm{StdGPrf}_{L,A}(D_{e_{L,A}}(u,v,0),e_{L,A})\\bigr],\\\\\n\\delta_{h_{L,A}}&\\coloneqq D_{e_{L,A}},\\\\\n\\mathrm{Prf}^{L}_{A}(u,v)&\\coloneqq D_{e_{L,A}}(u,v,0),\\\\\n\\mathrm{Pr}^{L}_{A}(v)&\\coloneqq\\exists u\\,\\mathrm{Prf}^{L}_{A}(u,v),\\\\\n\\mathrm{Con}^{L}_{A}&\\coloneqq\\neg\\mathrm{Pr}^{L}_{A}(\\overline{g_L(\\bot_L)}),\\\\\n&\\mathrm{PA}\\vdash\\left(\\mathrm{Con}^{L}_{A}\\leftrightarrow\\mathrm{Con}^{L}_{\\sigma^L_A}\\right),\\\\\nA\\upharpoonright_{g_L}k&\\coloneqq\\{\\varphi\\in A:g_L(\\varphi)\\le k\\},\\\\\n\\mathrm{Con}^{\\mathrm{meta}}_L(A)&\\Longleftrightarrow\n\\neg\\exists p\\in\\mathbb N\\ \\mathrm{PrfRel}_{L,A}(p,g_L(\\bot_L)).\n\\end{aligned}","display":true},{"tex":"\\pi_L","display":fals