gle\\in v_1),\\\\\n&\\theta_\\in(v_0,v_1)\\leftrightarrow v_0\\in v_1,\\\\\n&\\theta_{\\leq}(v_0,v_1,v_2)\\leftrightarrow\\langle v_0,v_1\\rangle\\in v_2.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}two\\text{-}step\\text{-}iteration}\\vdash\n\\mathrm{TwoStepIteration}_S(\\mathbb R,M,\\mathbb P,\\dot{\\mathbb Q})\\\\\n&\\quad\\leftrightarrow\n\\exists P,\\preccurlyeq_P,1_P,C,\\preccurlyeq_R,1_R,\n\\dot Q,\\dot{\\preccurlyeq}_Q,\\dot 1_Q\\;\n\\Bigl[\n\\mathrm{TransitiveModel}_S(M)\n\\land\\mathbb P,\\dot{\\mathbb Q}\\in M\n\\land\n\\mathbb P=\\langle P,\\preccurlyeq_P,1_P\\rangle\n\\land\n\\mathrm{ForcingNotion}_S(\\mathbb P)\\\\\n&\\qquad\\land\n\\dot{\\mathbb Q}\n=\\langle\\dot Q,\\dot{\\preccurlyeq}_Q,\\dot 1_Q\\rangle\n\\land\n\\forall\\sigma\\in\\{\\dot Q,\\dot{\\preccurlyeq}_Q,\\dot1_Q\\}\\;\n(\\sigma\\in M\\land\\mathrm{Name}(\\sigma,P))\n\\land\n\\mathrm{ZfcForcingRelation}_S\n(M,1_P,\\ulcorner\\theta_{\\mathrm{fn}}\\urcorner,\n\\langle\\dot Q,\\dot{\\preccurlyeq}_Q,\\dot1_Q\\rangle,P,\\preccurlyeq_P)\\\\\n&\\qquad\\land\n\\mathbb R=\\langle C,\\preccurlyeq_R,1_R\\rangle\n\\land\nC=\n\\left\\{\n\\langle p,\\dot q\\rangle:\np\\in P\n\\land\\dot q\\in M\n\\land\\mathrm{Name}(\\dot q,P)\n\\land\\mathrm{ZfcForcingRelation}_S\n(M,p,\\ulcorner\\theta_\\in\\urcorner,\\langle\\dot q,\\dot Q\\rangle,P,\\preccurlyeq_P)\n\\right\\}\\\\\n&\\qquad\\land\n\\forall\\langle p,\\dot q\\rangle,\n\\langle p',\\dot q'\\rangle\\in C\\;\n\\Bigl(\n\\langle p,\\dot q\\rangle\n\\preccurlyeq_R\n\\langle p',\\dot q'\\rangle\\\\\n&\\qquad\\qquad\\leftrightarrow\np\\preccurlyeq_P p'\n\\land\n\\mathrm{ZfcForcingRelation}_S\n(M,p,\\ulcorner\\theta_{\\leq}\\urcorner,\n\\langle\\dot q,\\dot q',\\dot{\\preccurlyeq}_Q\\rangle,P,\\preccurlyeq_P)\n\\Bigr)\n\\land\n1_R=\\langle1_P,\\dot1_Q\\rangle\n\\land\\mathrm{ForcingNotion}_S(\\mathbb R)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"P","display":false}],"bytes":4260,"backlinks":[{"id":"f572