\n\\mathrm{DifferentialBetween}_S(L_\\iota,\\iota_S,f(x),S,N)\\land\nT_N=\\Bigl\\{u\\in T_N:\\exists v\\in L_f[T_M]\\;\\exists w\\in L_\\iota[T_S]\\;\n\\forall h\\in V\\;\\bigl(\\mathrm{SmoothMap}_S(h,N,\\mathbb R)\\to u(h)=v(h)+w(h)\\bigr)\\Bigr\\}\\Bigr]","display":true},{"tex":"S","display":false},{"tex":"T_{f(x)}N","display":false},{"tex":"j^k f \\pitchfork S","display":false},{"tex":"f","display":false}],"bytes":2421,"backlinks":[{"id":"05d6770f9ac38c68","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{Transverse}_S\\subseteq V^4$ (transversality predicate, see [[../batch14/58-df-transverse.md]])"},{"id":"b6060c5d1003e78e","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1321","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-transverse.md|58-df-transverse]]（batch14）"}],"outgoing":["432be048cd519891","cd9981d8428c2629","becb68cbe0f3a15e","d87c5d842ade903d"]}