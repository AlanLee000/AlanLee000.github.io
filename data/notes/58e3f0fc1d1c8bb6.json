)).","display":true},{"tex":"\\operatorname{FV}_{\\mathsf G}=\\operatorname{PV}_{\\mathsf G},","display":true},{"tex":"\\operatorname{Sub}_{\\mathsf G}(A,\\sigma)=\\widehat\\sigma(A)","display":true},{"tex":"\\sigma:\\mathsf{Prop}\\to\\mathsf{Fm}_{\\mathsf G}","display":false},{"tex":"\\operatorname{BV}_{\\mathsf G}(A)=\\varnothing\n\\quad(A\\in\\mathsf{Fm}_{\\mathsf G}),","display":true},{"tex":"A\\equiv_{\\alpha,\\mathsf G}B\n\\quad\\Longleftrightarrow\\quad\nA=B.","display":true},{"tex":"\\widehat\\sigma","display":false},{"tex":"T_{\\mathsf G},I_{\\mathsf G},M_{\\mathsf G},J_{\\mathsf G}:\\mathsf V_{\\mathsf G}^2\\to\\mathsf V_{\\mathsf G},\n\\qquad N_{\\mathsf G}:\\mathsf V_{\\mathsf G}\\to\\mathsf V_{\\mathsf G}.","display":true},{"tex":"T_{\\mathsf G}(a,b)=\\min(a,b),","display":true},{"tex":"I_{\\mathsf G}(a,b)=\n\\begin{cases}\n1,&a\\le b,\\\\\nb,&a>b,\n\\end{cases}","display":true},{"tex":"M_{\\mathsf G}(a,b)=\\min(a,b),\n\\quad\nJ_{\\mathsf G}(a,b)=\\max(a,b).","display":true},{"tex":"N_{\\mathsf G}(a)=I_{\\mathsf G}(a,0)=\n\\begin{cases}1,&a=0,\\\\0,&a>0.\\end{cases}","display":true},{"tex":"\\mathsf{Val}_{\\mathsf G}=\\{v:\\mathsf{Prop}\\to\\mathsf V_{\\mathsf G}\\}","display":false},{"tex":"v\\in\\mathsf{Val}_{\\mathsf G}","display":false},{"tex":"\\llbracket\\operatorname{atom}(p)\\rrbracket_v^{\\mathsf G}=v(p),\n\\quad\n\\llbracket\\operatorname{bot}\\rrbracket_v^{\\mathsf G}=0,","display":true},{"tex":"\\llbracket\\operatorname{fus}(A,B)\\rrbracket_v^{\\mathsf G}\n=T_{\\mathsf G}(\\llbracket A\\rrbracket_v^{\\mathsf G},\\llbracket B\\rrbracket_v^{\\mathsf G}),","display":true},{"tex":"\\llbracket\\operatorname{imp}(A,B)\\rrbracket_v^{\\mathsf G}\n=I_{\\mathsf G}(\\llbracket A\\rrbracket_v^{\\mathsf G},\\llbracket B\\rrbracket_v^{\\mathsf G}),","display":true},{"tex":"\\llbracket\\operatorname{meet}(A,B)\\rrbracket_v^{\\mathsf G}\n=M_{\\mathsf G}(\\llbracket A\\rrbracket_v^{\\mathsf G},\\llbracket B\\rrbracket_v^{\\mathsf G}),","display":true},{"tex"