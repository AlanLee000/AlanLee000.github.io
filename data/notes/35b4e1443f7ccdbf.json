rc K,F)\\land\\forall M\\;(\\mathrm{IsFunctor}(M,\\mathcal D,\\mathcal E)\\to\\forall\\alpha\\;(\\mathrm{IsNatural}(\\alpha,M\\circ K,F)\\to\\exists!\\beta\\;(\\mathrm{IsNatural}(\\beta,M,R)\\land\\varepsilon\\circ(\\beta K)=\\alpha)))\\Bigr)","display":true},{"tex":"\\beta K","display":false}],"bytes":1971,"backlinks":[{"id":"c53146be63465990","anchor":"ref-25","locations":["正文"],"count":1,"excerpt":"[[14-df-kan-extensions|Definition — Kan Extensions (supplement)]]"},{"id":"4741fef73eb1a614","anchor":"ref-19","locations":["正文"],"count":1,"excerpt":"[[14-df-kan-extensions]]"},{"id":"ffda0c0482667c45","anchor":"ref-19","locations":["正文"],"count":1,"excerpt":"[[14-df-kan-extensions]]"},{"id":"c60ad289d123497b","anchor":"ref-26","locations":["正文"],"count":1,"excerpt":"[[14-df-kan-extensions|Definition — Kan Extensions (supplement)]]"}],"outgoing":["1f1269584b34ad4b","1bdaf4a293143165","dad26c5de724390a","f012515fd4cf0061"]}