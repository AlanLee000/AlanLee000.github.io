torname{OracleProgramCoding}(\\mathcal E_{\\mathsf O})\\leftrightarrow\n\\left[\n\\begin{array}{l}\n\\mathcal E_{\\mathsf O}=(\\operatorname{wordenc},\\operatorname{ocode},\n\\operatorname{odecode})\n\\land\\operatorname{WordCoding}(\\operatorname{wordenc})\\\\\n{}\\land \\operatorname{ocode}:\\mathcal D_{\\mathsf{OTM}}\\hookrightarrow\\mathbf 2^*\n\\land\\forall O\\in\\mathcal D_{\\mathsf{OTM}}\\;\n\\operatorname{ocode}(O)=\\operatorname{wordenc}(\\operatorname{otab}(O))\\\\\n{}\\land \\operatorname{ran}(\\operatorname{ocode})\\in\\mathsf{DEC}_{\\mathbf 2}\n\\land\\operatorname{odecode}:\\operatorname{ran}(\\operatorname{ocode})\n\\to\\mathcal D_{\\mathsf{OTM}}\\\\\n{}\\land \\operatorname{odecode}\\circ\\operatorname{ocode}\n=\\operatorname{id}_{\\mathcal D_{\\mathsf{OTM}}}\n\\end{array}\n\\right],\\qquad\n\\ulcorner O\\urcorner_{\\mathcal E_{\\mathsf O}}\\coloneqq\\operatorname{ocode}(O)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OracleProgramCoding}(\\mathcal E_{\\mathsf O})\\leftrightarrow\n\\left[\n\\begin{array}{l}\n\\mathcal E_{\\mathsf O}=(\\operatorname{wordenc},\\operatorname{ocode},\n\\operatorname{odecode})\n\\land\\operatorname{WordCoding}(\\operatorname{wordenc})\\\\\n{}\\land \\operatorname{ocode}:\\mathcal D_{\\mathsf{OTM}}\\hookrightarrow\\mathbf 2^*\n\\land\\forall O\\in\\mathcal D_{\\mathsf{OTM}}\\;\n\\operatorname{ocode}(O)=\\operatorname{wordenc}(\\operatorname{otab}(O))\\\\\n{}\\land \\operatorname{ran}(\\operatorname{ocode})\\in\\mathsf{DEC}_{\\mathbf 2}\n\\land\\operatorname{odecode}:\\operatorname{ran}(\\operatorname{ocode})\n\\to\\mathcal D_{\\mathsf{OTM}}\\\\\n{}\\land \\operatorname{odecode}\\circ\\operatorname{ocode}\n=\\operatorname{id}_{\\mathcal D_{\\mathsf{OTM}}}\n\\end{array}\n\\right],\\qquad\n\\ulcorner O\\urcorner_{\\mathcal E_{\\mathsf O}}\\coloneqq\\operatorname{ocode}(O)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OConf}_O\\coloneqq\n\\{(q,\\mathbf T,\\mathbf h):q\\in Q\\land\\mathbf T\\in(\\Gamma^{\\mathbb Z})^k\n\\land\\mathbf h\\in\\mathbb Z^k\n\\land\\forall j\\;(1\\leq j\\leq k\\to\n|\\{i\\in\\mathbb Z:T_j(i)\\neq\\mathrm{blank}\\}|&lt;\\aleph_0)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OConf}_O\\coloneqq\n\\{(q,\\mathbf T,\\mathbf h):q\\in Q\\land\\mathbf T\\in(\\Gamma^{\\mathbb Z})^k\n\\land\\mathbf h\\in\\mathbb Z^k\n\\land\\forall j\\;(1\\leq j\\leq k\\to\n|\\{i\\in\\mathbb Z:T_j(i)\\neq\\mathrm{blank}\\}|&lt;\\aleph_0)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{QueryWord}_O((q,\\mathbf T,\\mathbf h),x)\\leftrightarrow\n(q,\\mathbf T,\\mathbf h)\\in\\operatorname{OConf}_O\n\\land q=q_{\\mathsf{qry}}\\land x\\in\\mathbf 2^*\n\\land\\forall i&lt;|x|\\;(T_k(i)=x(i))\n\\land\\forall i\\in\\mathbb Z\\setminus\\{0,\\ldots,|x|-1\\}\\;(T_k(i)=\\mathrm{blank})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{QueryWord}_O((q,\\mathbf T,\\mathbf h),x)\\leftrightarrow\n(q,\\mathbf T,\\mathbf h)\\in\\operatorname{OConf}_O\n\\land q=q_{\\mathsf{qry}}\\land x\\in\\mathbf 2^*\n\\land\\forall i&lt;|x|\\;(T_k(i)=x(i))\n\\land\\forall i\\in\\mathbb Z\\setminus\\{0,\\ldots,|x|-1\\}\\;(T_k(i)=\\mathrm{blank})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OrdinaryStep}_O(C,C&#39;)\\leftrightarrow\nC,C&#39;\\in\\operatorname{OConf}_O\n\\land\n\\exists q,q&#39;\\in Q\\,\\exists\\mathbf T,\\mathbf T&#39;\\in(\\Gamma^{\\mathbb Z})^k\\,\n\\exists\\mathbf h,\\mathbf h&#39;\\in\\mathbb Z^k\\,\n\\exists\\mathbf a\\in\\Gamma^k\\,\\exists\\mathbf D\\in\\{\\mathsf L,\\mathsf R\\}^k\\;\n\\Bigl(\nC=(q,\\mathbf T,\\mathbf h)\\land C&#39;=(q&#39;,\\mathbf T&#39;,\\mathbf h&#39;)\n\\land q\\notin\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}}\\}\n\\land\\delta(q,(T_j(h_j))_{j=1}^k)=(q&#39;,\\mathbf a,\\mathbf D)\n\\land\\forall j\\;(1\\leq j\\leq k\\to\n(T&#39;_j=T_j[h_j\\mapsto a_j]\\land h&#39;_j=h_j+d(D_j)))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OrdinaryStep}_O(C,C&#39;)\\leftrightarrow\nC,C&#39;\\in\\operatorname{OConf}_O\n\\land\n\\exists q,q&#39;\\in Q\\,\\exists\\mathbf T,\\mathbf T&#39;\\in(\\Gamma^{\\mathbb Z})^k\\,\n\\exists\\mathbf h,\\mathbf h&#39;\\in\\mathbb Z^k\\,\n\\exists\\mathbf a\\in\\Gamma^k\\,\\exists\\mathbf D\\in\\{\\mathsf L,\\mathsf R\\}^k\\;\n\\Bigl(\nC=(q,\\mathbf T,\\mathbf h)\\land C&#39;=(q&#39;,\\mathbf T&#39;,\\mathbf h&#39;)\n\\land q\\notin\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}}\\}\n\\land\\delta(q,(T_j(h_j))_{j=1}^k)=(q&#39;,\\mathbf a,\\mathbf D)\n\\land\\forall j\\;(1\\leq j\\leq k\\to\n(T&#39;_j=T_j[h_j\\mapsto a_j]\\land h&#39;_j=h_j+d(D_j)))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nC\\to_O^B C&#39;\\leftrightarrow\nC,C&#39;\\in\\operatorname{OConf}_O\n\\land\\Biggl(\n\\operatorname{OrdinaryStep}_{O}(C,C&#39;)\n\\lor\\exists x\\in\\mathbf 2^*\\,\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n\\left[\nC=(q_{\\mathsf{qry}},\\mathbf T,\\mathbf h)\n\\land\\operatorname{QueryWord}_O(C,x)\n\\land C&#39;=\n\\begin{cases}\n(q_{\\mathsf{yes}},\\mathbf T,\\mathbf h),&amp;x\\in B,\\\\\n(q_{\\mathsf{no}},\\mathbf T,\\mathbf h),&amp;x\\notin B\n\\end{cases}\n\\right]\\Biggr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nC\\to_O^B C&#39;\\leftrightarrow\nC,C&#39;\\in\\operatorname{OConf}_O\n\\land\\Biggl(\n\\operatorname{OrdinaryStep}_{O}(C,C&#39;)\n\\lor\\exists x\\in\\mathbf 2^*\\,\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n\\left[\nC=(q_{\\mathsf{qry}},\\mathbf T,\\mathbf h)\n\\land\\operatorname{QueryWord}_O(C,x)\n\\land C&#39;=\n\\begin{cases}\n(q_{\\mathsf{yes}},\\mathbf T,\\mathbf h),&amp;x\\in B,\\\\\n(q_{\\mathsf{no}},\\mathbf T,\\mathbf h),&amp;x\\notin B\n\\end{cases}\n\\right]\\Biggr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nT_w(i)\\coloneqq\n\\begin{cases}w(i),&amp;0\\leq i&lt;|w|,\\\\ \\mathrm{blank},&amp;i&lt;0\\lor |w|\\le i,\\end{cases}\n\\quad T_{\\mathrm{blank}}(i)\\coloneqq\\mathrm{blank},\\quad\nC_O^{\\mathsf{in}}(w)\\coloneqq\n\\bigl(q_0,(T_w,T_{\\mathrm{blank}},\\ldots,T_{\\mathrm{blank}}),(0,\\ldots,0)\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nT_w(i)\\coloneqq\n\\begin{cases}w(i),&amp;0\\leq i&lt;|w|,\\\\ \\mathrm{blank},&amp;i&lt;0\\lor |w|\\le i,\\end{cases}\n\\quad T_{\\mathrm{blank}}(i)\\coloneqq\\mathrm{blank},\\quad\nC_O^{\\mathsf{in}}(w)\\coloneqq\n\\bigl(q_0,(T_w,T_{\\mathrm{blank}},\\ldots,T_{\\mathrm{blank}}),(0,\\ldots,0)\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nL^B(O)\\coloneqq\n\\{w\\in\\mathbf 2^*:\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n(C_O^{\\mathsf{in}}(w),(q_{\\mathsf{acc}},\\mathbf T,\\mathbf h))\n\\in\\operatorname{RTC}_{\\operatorname{OConf}_O}(\\to_O^B)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nL^B(O)\\coloneqq\n\\{w\\in\\mathbf 2^*:\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n(C_O^{\\mathsf{in}}(w),(q_{\\mathsf{acc}},\\mathbf T,\\mathbf h))\n\\in\\operatorname{RTC}_{\\operatorname{OConf}_O}(\\to_O^B)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OHalts}_O^B(w)\\leftrightarrow\n\\exists q\\in\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}}\\}\\,\n\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n(C_O^{\\mathsf{in}}(w),(q,\\mathbf T,\\mathbf h))\n\\in\\operatorname{RTC}_{\\operatorname{OConf}_O}(\\to_O^B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OHalts}_O^B(w)\\leftrightarrow\n\\exists q\\in\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}}\\}\\,\n\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n(C_O^{\\mathsf{in}}(w),(q,\\mathbf T,\\mathbf h))\n\\in\\operatorname{RTC}_{\\operatorname{OConf}_O}(\\to_O^B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\forall O\\;\\Bigl(\\operatorname{OTM}_{B}(O)\\to\n\\exists O&#39;\\in\\mathcal D_{\\mathsf{OTM}}\\;\\forall w\\in\\mathbf 2^*\\;\n\\Bigl[\n\\bigl(\nw\\in L^B(O)\\leftrightarrow w\\in L^B(O&#39;)\n\\bigr)\\land\n\\bigl(\n\\operatorname{OHalts}_O^B(w)\\leftrightarrow\n\\operatorname{OHalts}_{O&#39;}^B(w)\n\\bigr)\\Bigr]\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\forall O\\;\\Bigl(\\operatorname{OTM}_{B}(O)\\to\n\\exists O&#39;\\in\\mathcal D_{\\mathsf{OTM}}\\;\\forall w\\in\\mathbf 2^*\\;\n\\Bigl[\n\\bigl(\nw\\in L^B(O)\\leftrightarrow w\\in L^B(O&#39;)\n\\bigr)\\land\n\\bigl(\n\\operatorname{OHalts}_O^B(w)\\leftrightarrow\n\\operatorname{OHalts}_{O&#39;}^B(w)\n\\bigr)\\Bigr]\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{otab}\\coloneqq\\{(M,\\tau)\\in \\mathcal D_{\\mathsf{OTM}}\\times\\mathbb N^{&lt;\\omega}:\\operatorname{OTableCode}(M,\\tau)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{otab}\\coloneqq\\{(M,\\tau)\\in \\mathcal D_{\\mathsf{OTM}}\\times\\mathbb N^{&lt;\\omega}:\\operatorname{OTableCode}(M,\\tau)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{OrdinaryStep}_O\">\\(\\operatorname{OrdinaryStep}_O\\)</span> is the displayed multitape update from <span class=\"math-inline\" data-tex=\"\\delta\">\\(\\delta\\)</span> used away from <span class=\"math-inline\" data-tex=\"q_{\\mathsf{qry}}\">\\(q_{\\mathsf{qry}}\\)</span>; <span class=\"math-inline\" data-tex=\"C_O^{\\mathsf{in}}\">\\(C_O^{\\mathsf{in}}\\)</span> follows the input convention in <a class=\"wiki-link\" id=\"ref-10\" data-note=\"9fa7db79fea5f29a\" href=\"?note=9fa7db79fea5f29a\" title=\"73-df-multitape-dtm-semantics\">73-df-multitape-dtm-semantics</a>.</li>\n<li>The dedicated last tape contains the complete binary query in normalized form. One oracle step branches only on membership in the fixed language <span class=\"math-inline\" data-tex=\"B\">\\(B\\)</span>.</li>\n<li>Canonical state and symbol renaming preserves every oracle computation. The complete lexicographic transition table is serialized by the same fixed tuple code as ordinary machines, so valid program codes are decidable and effectively parseable.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"73-df-finite-words-and-languages","status":"resolved","id":"0a6da8c909717780","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-finite-words-and-languages]]","embed":false},{"target":"73-df-multitape-dtm-semantics","status":"resolved","id":"9fa7db79fea5f29a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-multitape-dtm-semantics]]","embed":false},{"target":"73-df-finite-path-closure","status":"resolved","id":"25902d0bd75ea963","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-finite-path-closure]]","embed":false},{"target":"73-df-dtm-local-transition","status":"resolved","id":"51696a3513b66fda","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-dtm-local-transition]]","embed":false},{"target":"73-df-binary-program-coding","status":"resolved","id":"db96cabedd089e5f","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-binary-program-coding]]","embed":false},{"target":"73-df-dtm-language-decision","status":"resolved","id":"004d4e2ba3fdd14e","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-dtm-language-decision]]","embed":false},{"target":"73-df-dtm-local-tran