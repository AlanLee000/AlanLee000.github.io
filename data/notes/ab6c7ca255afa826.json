k},k,\\delta,q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}})","display":false},{"tex":"\\operatorname{OTM}_B(O)","display":false},{"tex":"w\\in\\mathbf2^*","display":false},{"tex":"i\\in\\mathbb Z","display":false},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OTM}_{B}(O)\\leftrightarrow\n\\exists Q\\,\\exists\\Gamma\\,\\exists\\mathrm{blank}\\,\\exists k\\in\\mathbb N_{\\geq2}\\,\\exists\\delta\\,\n\\exists q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}\\;\\Bigl(\nO=(Q,\\mathbf 2,\\Gamma,\\mathrm{blank},k,\\delta,q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},\nq_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}})\n\\land 0<|Q|<\\aleph_0\\land\\operatorname{Alphabet}(\\Gamma)\n\\land\\mathrm{blank}\\in\\Gamma\\land\\mathbf 2\\subseteq\\Gamma\\setminus\\{\\mathrm{blank}\\}\n\\land\\delta:(Q\\setminus\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}}\\})\\times\\Gamma^k\n\\to Q\\times\\Gamma^k\\times\\{\\mathsf L,\\mathsf R\\}^k\n\\land\\{q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}\\}\\subseteq Q\n\\land|\\{q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}\\}|=6\n\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{CanonOTM}(O)\\leftrightarrow\n\\exists r,g,k\\in\\mathbb N\\,\\exists Q\\,\\exists\\Gamma\\,\\exists\\mathrm{blank}\\,\n\\exists\\delta\\,\\exists q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},\nq_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}\\;\\Bigl[\nr\\geq6\\land g\\geq3\\land k\\geq2\n\\land O=(Q,\\mathbf 2,\\Gamma,\\mathrm{blank},k,\\delta,q_0,q_{\\mathsf{acc}},\nq_{\\mathsf{rej}},q_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}})\n\\land\\operatorname{OTM}_{B}(O)\n\\land Q=\\{0,\\ldots,r-1\\}\n\\land\\Gamma=\\{0,\\ldots,g-1\\}\n\\Bigr]","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\mathcal D_{\\mathsf{OTM}}\\coloneqq\n\\{O:\\operatorname{CanonOTM}(O)\\}","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OTableCode}(O,\\tau)\\leftrightarrow\n\\exists r,g,k\\in\\mathbb N\\,\\exists Q\\,\\exists\\Gamma\\,\\exists\\mathrm{blank}\\,\n\\exists\\delta\\,\\exists q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},\nq_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}\\,\n\\exists\\bigl((q_i,\\mathbf a_i)\\bigr)_{i=1}^{(r-3)g^k}\\;\\Biggl[\n\\begin{array}{l}\nO\\in\\mathcal D_{\\mathsf{OTM}}\n\\land O=(Q,\\mathbf 2,\\Gamma,\\mathrm{blank},k,\\delta,q_0,q_{\\mathsf{acc}},\nq_{\\mathsf{rej}},q_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}),\\\\\nQ=\\{0,\\ldots,r-1\\}\\land\\Gamma=\\{0,\\ldots,g-1\\},\\\\\n\\bigl((q_i,\\mathbf a_i)\\bigr)_{i=1}^{(r-3)g^k}\n=\\bigl\\langle(q,\\mathbf a):(q,\\mathbf a)\\in\n(Q\\setminus\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}}\\})\n\\times\\Gamma^k\\bigr\\rangle_{\\mathrm{lex}},\\\\\n\\tau=\\langle r,g,k,\\mathrm{blank},q_0,q_{\\mathsf{acc}},q_{\\mathsf{rej}},\nq_{\\mathsf{qry}},q_{\\mathsf{yes}},q_{\\mathsf{no}}\\rangle\n\\mathbin{\\frown}\n\\mathop{\\mathbin{\\frown}}\\limits_{i=1}^{(r-3)g^k}\n\\left(\n\\langle\\pi_1\\delta(q_i,\\mathbf a_i)\\rangle\n\\mathbin{\\frown}\n\\langle\\pi_j(\\pi_2(\\delta(q_i,\\mathbf a_i))):1\\leq j\\leq k\\rangle\n\\mathbin{\\frown}\n\\langle\\iota(\\pi_j(\\pi_3(\\delta(q_i,\\mathbf a_i)))):1\\leq j\\leq k\\rangle\n\\right)\n\\end{array}\n\\Biggr]","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\forall O\\in\\mathcal D_{\\mathsf{OTM}}\\;\n\\exists!\\tau\\in\\mathbb N^{<\\omega}\\;\\operatorname{OTableCode}(O,\\tau),\n\\qquad\n\\operatorname{otab}:\\mathcal D_{\\mathsf{OTM}}\\to\\mathbb N^{<\\omega},\n\\qquad\n\\forall O\\in\\mathcal D_{\\mathsf{OTM}}\\;\n\\operatorname{OTableCode}(O,\\operatorname{otab}(O))","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OracleProgramCoding}(\\mathcal E_{\\mathsf O})\\leftrightarrow\n\\left[\n\\begin{array}{l}\n\\mathcal E_{\\mathsf O}=(\\operatorname{wordenc},\\operatorname{ocode},\n\\operatorname{odecode})\n\\land\\operatorname{WordCoding}(\\operatorname{wordenc})\\\\\n{}\\land \\operatorname{ocode}:\\mathcal D_{\\mathsf{OTM}}\\hookrightarrow\\mathbf 2^*\n\\land\\forall O\\in\\mathcal D_{\\mathsf{OTM}}\\;\n\\operatorname{ocode}(O)=\\operatorname{wordenc}(\\operatorname{otab}(O))\\\\\n{}\\land \\operatorname{ran}(\\operatorname{ocode})\\in\\mathsf{DEC}_{\\mathbf 2}\n\\land\\operatorname{odecode}:\\operatorname{ran}(\\operatorname{ocode})\n\\to\\mathcal D_{\\mathsf{OTM}}\\\\\n{}\\land \\operatorname{odecode}\\circ\\operatorname{ocode}\n=\\operatorname{id}_{\\mathcal D_{\\mathsf{OTM}}}\n\\end{array}\n\\right],\\qquad\n\\ulcorner O\\urcorner_{\\mathcal E_{\\mathsf O}}\\coloneqq\\operatorname{ocode}(O)","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OConf}_O\\coloneqq\n\\{(q,\\mathbf T,\\mathbf h):q\\in Q\\land\\mathbf T\\in(\\Gamma^{\\mathbb Z})^k\n\\land\\mathbf h\\in\\mathbb Z^k\n\\land\\forall j\\;(1\\leq j\\leq k\\to\n|\\{i\\in\\mathbb Z:T_j(i)\\neq\\mathrm{blank}\\}|<\\aleph_0)\\}","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{QueryWord}_O((q,\\mathbf T,\\mathbf h),x)\\leftrightarrow\n(q,\\mathbf T,\\mathbf h)\\in\\operatorname{OConf}_O\n\\land q=q_{\\mathsf{qry}}\\land x\\in\\mathbf 2^*\n\\land\\forall i<|x|\\;(T_k(i)=x(i))\n\\land\\forall i\\in\\mathbb Z\\setminus\\{0,\\ldots,|x|-1\\}\\;(T_k(i)=\\mathrm{blank})","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OrdinaryStep}_O(C,C')\\leftrightarrow\nC,C'\\in\\operatorname{OConf}_O\n\\land\n\\exists q,q'\\in Q\\,\\exists\\mathbf T,\\mathbf T'\\in(\\Gamma^{\\mathbb Z})^k\\,\n\\exists\\mathbf h,\\mathbf h'\\in\\mathbb Z^k\\,\n\\exists\\mathbf a\\in\\Gamma^k\\,\\exists\\mathbf D\\in\\{\\mathsf L,\\mathsf R\\}^k\\;\n\\Bigl(\nC=(q,\\mathbf T,\\mathbf h)\\land C'=(q',\\mathbf T',\\mathbf h')\n\\land q\\notin\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}},q_{\\mathsf{qry}}\\}\n\\land\\delta(q,(T_j(h_j))_{j=1}^k)=(q',\\mathbf a,\\mathbf D)\n\\land\\forall j\\;(1\\leq j\\leq k\\to\n(T'_j=T_j[h_j\\mapsto a_j]\\land h'_j=h_j+d(D_j)))\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nC\\to_O^B C'\\leftrightarrow\nC,C'\\in\\operatorname{OConf}_O\n\\land\\Biggl(\n\\operatorname{OrdinaryStep}_{O}(C,C')\n\\lor\\exists x\\in\\mathbf 2^*\\,\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n\\left[\nC=(q_{\\mathsf{qry}},\\mathbf T,\\mathbf h)\n\\land\\operatorname{QueryWord}_O(C,x)\n\\land C'=\n\\begin{cases}\n(q_{\\mathsf{yes}},\\mathbf T,\\mathbf h),&x\\in B,\\\\\n(q_{\\mathsf{no}},\\mathbf T,\\mathbf h),&x\\notin B\n\\end{cases}\n\\right]\\Biggr)","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nT_w(i)\\coloneqq\n\\begin{cases}w(i),&0\\leq i<|w|,\\\\ \\mathrm{blank},&i<0\\lor |w|\\le i,\\end{cases}\n\\quad T_{\\mathrm{blank}}(i)\\coloneqq\\mathrm{blank},\\quad\nC_O^{\\mathsf{in}}(w)\\coloneqq\n\\bigl(q_0,(T_w,T_{\\mathrm{blank}},\\ldots,T_{\\mathrm{blank}}),(0,\\ldots,0)\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\nL^B(O)\\coloneqq\n\\{w\\in\\mathbf 2^*:\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n(C_O^{\\mathsf{in}}(w),(q_{\\mathsf{acc}},\\mathbf T,\\mathbf h))\n\\in\\operatorname{RTC}_{\\operatorname{OConf}_O}(\\to_O^B)\\}","display":true},{"tex":"\\mathrm{df\\text{-}oracle\\text{-}turing\\text{-}machine}\\vdash\n\\operatorname{OHalts}_O^B(w)\\leftrightarrow\n\\exists q\\in\\{q_{\\mathsf{acc}},q_{\\mathsf{rej}}\\}\\,\n\\exists\\mathbf T\\,\\exists\\mathbf h\\;\n(C_O^{\\mathsf{in}}(w),(q,\\mathbf T,\\mathbf h))\n\