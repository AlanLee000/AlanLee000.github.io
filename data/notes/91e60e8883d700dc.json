}(A)\\cup\\operatorname{FV}_{C1}(B),","display":true},{"tex":"\\operatorname{FV}_{C1}(\\operatorname{imp}(A,B))\n=\n\\operatorname{FV}_{C1}(A)\\cup\\operatorname{FV}_{C1}(B).","display":true},{"tex":"\\operatorname{BV}_{C1}:\\mathsf{Fm}_{C1}\\to\\mathcal P(\\mathsf{Prop}_{C1}),\n\\qquad\n\\operatorname{BV}_{C1}(A)=\\varnothing,","display":true},{"tex":"\\equiv_{\\alpha,C1}\\ \\subseteq\\ \\mathsf{Fm}_{C1}\\times\\mathsf{Fm}_{C1}","display":true},{"tex":"A\\equiv_{\\alpha,C1}B\n\\quad\\Longleftrightarrow\\quad\nA=B.","display":true},{"tex":"\\mathsf{Subst}_{C1}\n=\n\\{\\sigma:\\mathsf{Prop}_{C1}\\to\\mathsf{Fm}_{C1}\\}.","display":true},{"tex":"\\operatorname{Ext}_{C1}:\\mathsf{Subst}_{C1}\\to\n\\mathsf{Fm}_{C1}^{\\mathsf{Fm}_{C1}}.","display":true},{"tex":"\\sigma\\in\\mathsf{Subst}_{C1}","display":false},{"tex":"\\widehat\\sigma:=\\operatorname{Ext}_{C1}(\\sigma)","display":false},{"tex":"\\widehat\\sigma(\\operatorname{atom}(p))=\\sigma(p),","display":true},{"tex":"\\widehat\\sigma(\\operatorname{neg}(A))\n=\n\\operatorname{neg}(\\widehat\\sigma(A)),","display":true},{"tex":"\\widehat\\sigma(\\operatorname{and}(A,B))\n=\n\\operatorname{and}(\\widehat\\sigma(A),\\widehat\\sigma(B)),","display":true},{"tex":"\\widehat\\sigma(\\operatorname{or}(A,B))\n=\n\\operatorname{or}(\\widehat\\sigma(A),\\widehat\\sigma(B)),","display":true},{"tex":"\\widehat\\sigma(\\operatorname{imp}(A,B))\n=\n\\operatorname{imp}(\\widehat\\sigma(A),\\widehat\\sigma(B)).","display":true},{"tex":"\\widehat\\sigma(A^\\circ)=(\\widehat\\sigma(A))^\\circ.","display":true},{"tex":"\\mathsf{Ax}_{C1}\\subseteq\\mathsf{Fm}_{C1}","display":true},{"tex":"\\mathsf{Ax}_{C1}\n=\n\\bigcup_{1\\le i\\le14}\\mathsf{Ax}_{C1,i}.","display":true},{"tex":"\\mathsf{Ax}_{C1,1}\n=\n\\{A\\to(B\\to A):A,B\\in\\mathsf{Fm}_{C1}\\}.","display":true},{"tex":"\\mathsf{Ax}_{C1,2}\n=\n\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):\nA,B,C\\in\\mathsf{Fm}_{C1}\\}.","display":true},{"tex":"\\mathsf{Ax}_{C1,3}\n=\n\\{A\\to(B\\