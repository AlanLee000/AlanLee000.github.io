text{-}constructible\\text{-}successor\\text{-}stage} \\vdash \\forall\\beta\\in\\mathrm{Ord}\\;\\bigl(L_{\\beta+1}\\coloneqq\\operatorname{Def}_\\in(L_\\beta)\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}constructible\\text{-}limit\\text{-}stage} \\vdash \\forall\\lambda\\in\\mathrm{Ord}\\;\\left(\\mathrm{LimitOrdinal}_S(\\lambda)\\to L_\\lambda\\coloneqq\\bigcup_{\\beta<\\lambda}L_\\beta\\right)","display":true},{"tex":"\\mathrm{df\\text{-}constructible\\text{-}universe} \\vdash \\mathrm{ConstructibleUniverse}_S(L)\\leftrightarrow\\mathrm{Class}_S(L)\\land\\forall x\\in V\\;\\bigl(x\\in L\\leftrightarrow\\exists\\alpha\\in\\mathrm{Ord}\\;(x\\in L_\\alpha)\\bigr)","display":true},{"tex":"L","display":false},{"tex":"L \\subseteq V","display":false},{"tex":"L \\models \\mathrm{GCH}","display":false},{"tex":"V = L","display":false},{"tex":"\\mathrm{Con}(\\mathrm{ZFC}) \\to \\mathrm{Con}(\\mathrm{ZFC} + V = L)","display":false}],"bytes":2209,"backlinks":[{"id":"b404eb64598c2615","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$L_\\alpha$（可构造层级的集合阶段，see [[../batch16/58-df-constructible.md]]）"},{"id":"6821b9e6e2120dca","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\forall\\beta\\in V\\;(\\mathrm{Ordinal}(\\beta)\\to L_\\beta\\in V)$ (constructible hierarchy, see [[58-df-constructible]])"},{"id":"7fffbf0fc82b6138","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"f7a81829f9ddf7c9","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$L$ (constructible class, see [[../batch16/58-df-constructible.md]])"},{"id":"9aaf86d4a85dccd7","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"2c66f328391735e2","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$L$ (constructible proper class, see [[../batch16/58-df-constructible.md]])"},{"id":"f807bc064a4947dd","anchor":"ref-1","locations":["元数据 · depends_on"],"cou