'","display":false},{"tex":"\\operatorname{pol}_P","display":false},{"tex":"D","display":false},{"tex":"P","display":false},{"tex":"E_0:=E_{\\rm PR},\\qquad\\mathsf{ID}_0:=\\mathsf{NT},\\qquad\\mathcal L^n:=\\mathcal L_2(E_n).","display":true},{"tex":"\\begin{aligned}\n\\operatorname{pol}_P(P(t))&:=(1,0),\\qquad\\operatorname{pol}_P(D):=(0,0),\\\\\n(p_C,n_C)&:=\\operatorname{pol}_P(C),\\\\\n\\operatorname{pol}_P(\\neg C)&:=(n_C,p_C),\\\\\n\\operatorname{pol}_P(C\\to D')&:=(\\max(n_C,p_{D'}),\\max(p_C,n_{D'})),\\\\\n\\operatorname{pol}_P(\\forall zC)&:=\\operatorname{pol}_P(C),\\\\\n\\operatorname{Pos}_n&:=\\{A\\in\\operatorname{Arith}_2(E_n\\cup\\{P\\}):\\operatorname{FV}(A)\\subseteq\\{x\\}\\land(\\operatorname{pol}_P(A))_1=0\\},\\\\\nE_{n+1}&:=E_n\\cup\\{I_{n,A}:A\\in\\operatorname{Pos}_n\\},\\\\\n\\kappa_{E_n\\cup\\{P\\}}(P)&:=1,\\quad\\operatorname{ar}(P):=1,\\quad\\kappa_{E_{n+1}}(I_{n,A}):=1,\\quad\\operatorname{ar}(I_{n,A}):=1.\n\\end{aligned}","display":true},{"tex":"\\operatorname{FreshRep}(C,B,z):=\\nu_z\\!\\left(\\min\\{i\\in\\omega:\\nu_z(i)\\notin\\operatorname{FV}(C)\\cup\\operatorname{QVar}(C)\\cup\\operatorname{FV}(B)\\cup\\operatorname{QVar}(B)\\cup\\{x,z\\}\\}\\right).","display":true},{"tex":"\\begin{aligned}\n\\operatorname{Rep}_P(P(t),B)&:=B[t/x],\\qquad\\operatorname{Rep}_P(D,B):=D,\\\\\n\\operatorname{Rep}_P(\\neg C,B)&:=\\neg\\operatorname{Rep}_P(C,B),\\\\\n\\operatorname{Rep}_P(C\\to D',B)&:=\\operatorname{Rep}_P(C,B)\\to\\operatorname{Rep}_P(D',B),\\\\\n\\operatorname{Rep}_P(\\forall zC,B)&:=\\begin{cases}\n\\forall z\\operatorname{Rep}_P(C,B),&z\\notin\\operatorname{FV}(B)\\setminus\\{x\\},\\\\\n\\forall w\\operatorname{Rep}_P(\\operatorname{Sub}(C,w,z),B),&z\\in\\operatorname{FV}(B)\\setminus\\{x\\},\\ w=\\operatorname{FreshRep}(C,B,z),\n\\end{cases}\\\\\nC[B/P]&:=\\operatorname{Rep}_P(C,B).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\operatorname{Cl}_{n,A}&:=\\operatorname{ucl}\\bigl(\\forall x(A[I_{n,A}(x)/P]\\to I_{n,A}(x))\\bigr),\\\\\n\\operatorname{Least}_{n,A}(B)&:=\\operatorname{ucl}\\bigl(\\forall x(A[B/P]\\to B)\\to\\forall x(I_{n,A}(x)\\to B)\\bigr),\\\\\n\\mathsf{ID}_{n+1}&:=\\mathsf{ID}_n\\cup\\{\\operatorname{Ind}_y(B):B\\in\\operatorname{Arith}_2(E_{n+1}),\\ y\\in V_N\\}\\\\\n&\\quad\\cup\\{\\operatorname{Cl}_{n,A}:A\\in\\operatorname{Pos}_n\\}\\cup\\{\\operatorname{Least}_{n,A}(B):A\\in\\operatorname{Pos}_n,\\ B\\in\\operatorname{Arith}_2(E_{n+1})\\},\\\\\n\\mathsf{ID}_{<\\omega}&:=\\bigcup_{n\\in\\omega}\\mathsf{ID}_n.\n\\end{aligned}","display":true}],"bytes":4894,"backlinks":[{"id":"00439897fba390aa","anchor":"ref-170","locations":["正文"],"count":1,"excerpt":"[[72-df-id-theory|df-id-theory — ID Theory]]"},{"id":"4d85a6a31705a214","anchor":"ref-170","locations":["正文"],"count":1,"excerpt":"[[./72-df-id-theory|df-id-theory — ID Theory]]"},{"id":"58974046a284c742","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathsf{ID}_n$ 是 [[72-df-id-theory]] 的全部正算子有限迭代版本，$|T|$ 为 [[72-df-proof-theoretic-ordinal]] 的约定。$\\Omega_\\nu,\\varepsilon_\\eta,\\psi_\\nu,\\mathrm{BH}$ 取 [[72-df-buchholz-psi]] 的具体定义；不是任意命名的ψ。"},{"id":"7db447da07adcf15","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathsf{ID}_n$ 是 [[72-df-id-theory]] 的全部正算子有限迭代版本，$|T|$ 为 [[72-df-proof-theoretic-ordinal]] 的约定。$\\Omega_\\nu,\\varepsilon_\\eta,\\psi_\\nu,\\mathrm{BH}$ 取 [[72-df-buchholz-psi]] 的具体定义；不是任意命名的ψ。"}],"outgoing":["5e5fb64772853785","bf103f8baf1db1b8","5ae195683ce3beb4","b63a805280ad1d8e"]}