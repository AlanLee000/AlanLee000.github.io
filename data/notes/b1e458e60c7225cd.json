\epsilon","display":false},{"tex":"(i_1,\\ldots,i_k)","display":false},{"tex":"\\mathrm{Orthogonal}(\\Sigma,V,R)","display":false},{"tex":"R\\coloneqq\\{(a,b),(b,c),(c,d),(F(x,y),G(y,y)),(G(x,H(y)),H(y))\\}.","display":true},{"tex":"\\mathrm{Orthogonal}(\\Sigma,V,R).","display":true},{"tex":"s\\coloneqq G(F(c,H(a)),H(b)),\\qquad t\\coloneqq G(G(H(a),H(a)),H(b)).","display":true},{"tex":"v\\coloneqq((1),F(x,y),G(y,y)),\\quad\\alpha\\coloneqq(s,v,t)\\in\\operatorname{Step}_R.","display":true},{"tex":"u_a\\coloneqq((1,2,1),a,b),\\quad u_b\\coloneqq((2,1),b,c),\\quad u_c\\coloneqq((1,1),c,d),\\quad u_G\\coloneqq(\\epsilon,G(x,H(y)),H(y)).","display":true},{"tex":"\\operatorname{Res}^{1}_R(\\alpha,u_a)=\\{((1,1,1),a,b),((1,2,1),a,b)\\}.","display":true},{"tex":"\\operatorname{Res}^{1}_R(\\alpha,u_b)=\\{u_b\\},\\qquad\\operatorname{Res}^{1}_R(\\alpha,u_c)=\\varnothing,\\qquad\\operatorname{Res}^{1}_R(\\alpha,v)=\\varnothing.","display":true},{"tex":"\\operatorname{Res}^{1}_R(\\alpha,u_G)=\\{u_G\\}.","display":true},{"tex":"\\operatorname{Created}_R(\\alpha)=\\{((1),G(x,H(y)),H(y))\\}.","display":true}],"bytes":2587,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-96","locations":["正文"],"count":2,"excerpt":"[[56-ex-residual-copy-erasure-creation.md]]"}],"outgoing":["a68d684938525240","4634b959eefaa45b","34fb9d07dfbad48c"]}