{"id":"d3b9adbd63f31929","group":"89","path":"89/89-df-kripke-model-full.md","title":"Kripke Model (Full Definition)","display":"df-kripke-model-full — Kripke Model (Full Definition)","type":"definition","metadata":{"type":"definition","book":"The Logic of Provability","book_abbrev":"89","label":"89-df-kripke-model-full","aliases":["89-df-kripke-model-full"],"display":"df-kripke-model-full — Kripke Model (Full Definition)","depends_on":["[[89-df-kripke-model]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"The Logic of Provability"},{"key":"book_abbrev","html":"89"},{"key":"label","html":"89-df-kripke-model-full"},{"key":"aliases","html":"<div class=\"property-array\"><span>89-df-kripke-model-full</span></div>"},{"key":"display","html":"df-kripke-model-full — Kripke Model (Full Definition)"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"ab746eb779e20ce0\" href=\"?note=ab746eb779e20ce0\" title=\"89-df-kripke-model\">89-df-kripke-model</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{KFrame}(W,R)\">\\(\\mathrm{KFrame}(W,R)\\)</span> is the well-formed-frame predicate inherited\nthrough <a class=\"wiki-link\" id=\"ref-2\" data-note=\"ab746eb779e20ce0\" href=\"?note=ab746eb779e20ce0\" title=\"89-df-kripke-model\">89-df-kripke-model</a>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}kripke\\text{-}model\\text{-}full}\\vdash\n\\mathrm{KMod}(W,R)\\coloneqq\n\\{(W,R,V)\\mid\n\\mathrm{KFrame}(W,R)\\land\nV:\\mathrm{Prop}\\to\\mathcal{P}(W)\\}.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}kripke\\text{-}model\\text{-}full}\\vdash\n\\mathrm{KMod}(W,R)\\coloneqq\n\\{(W,R,V)\\mid\n\\mathrm{KFrame}(W,R)\\land\nV:\\mathrm{Prop}\\to\\mathcal{P}(W)\\}.