49b\" title=\"../batch12/58-df-zfc-top2-subspace-topology.md\">../batch12/58-df-zfc-top2-subspace-topology.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"390faad2d7c5267a\" href=\"?note=390faad2d7c5267a\" title=\"../batch09/58-df-zfc-top2-path-connected-space.md\">../batch09/58-df-zfc-top2-path-connected-space.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau\\in V\">\\(X,\\tau\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5OpenSet}_S\\subseteq V^3\">\\(\\mathrm{ZfcTop5OpenSet}_S\\subseteq V^3\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop2SubspaceTopology}_S\\subseteq V^4\">\\(\\mathrm{ZfcTop2SubspaceTopology}_S\\subseteq V^4\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop2PathConnectedSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTop2PathConnectedSpace}_S\\subseteq V^2\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop4LocallyPathConnectedSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTop4LocallyPathConnectedSpace}_S\\subseteq V^2\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top4\\text{-}locally\\text{-}path\\text{-}connected\\text{-}space} \\vdash \\mathrm{ZfcTop4LocallyPathConnectedSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land \\forall x\\in X\\;\\forall U\\;(\\mathrm{ZfcTop5OpenSet}_S(X,\\tau,U)\\land x\\in U\\to \\exists V,\\tau_V\\;(\\mathrm{ZfcTop5OpenSet}_S(X,\\tau,V)\\land x\\in V\\land V\\subseteq U\\land \\mathrm{ZfcTop2SubspaceTopology}_S(\\tau_V,V,X,\\tau)\\land \\mathrm{ZfcTop2PathConnectedSpace}_S(V,\\tau_V)))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top4\\text{-}locally\\text{-}path\\text{-}connected\\text{-}space} \\vdash \\mathrm{ZfcTop4LocallyPathConnectedSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land \\forall x\\in X\\;\\forall U\\;(\\mathrm{ZfcTop5OpenSet}_S(X,\\tau,U)\\land x\\in U\\to \\exists V,\\tau_V\\;(\\mathrm{ZfcTop5OpenSet}_S(X,\\tau,V)\\land x\\in V\\land V\\subseteq U\\land \\mathrm{ZfcTop2SubspaceTopology}_S(\\tau_V,V,X,\\tau)\\land \\mathrm{ZfcTop2PathConnectedSpace}_S(V,\\tau_V)))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch10/58-df-zfc-top5-topological-space.md","status":"resolved","id":"74086485fba8d86f","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch10/58-df-zfc-top5-topological-space.md]]","embed":false},{"target":"../batch04/58-df-zfc-top5-open-set.md","status":"resolved","id":"473439958a92cf5b","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-zfc-top5-open-set.md]]","embed":false},{"target":"../batch12/58-df-zfc-top2-subspace-topology.md","status":"resolved","id":"694a41b0cb75249b","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-zfc-top2-subspace-topology.md]]","embed":false},{"target":"../batch09/58-df-zfc-top2-path-connected-space.md","status":"resolved","id":"390faad2d7c5267a","an