{93}","display":false},{"tex":"\\operatorname{VarSupp}_{93}(\\varphi;\\tau^{\\mathsf{CPL}}_{93})\\cap\\operatorname{VarSupp}_{93}(\\psi;\\tau^{\\mathsf{CPL}}_{93})\\neq\\varnothing","display":false},{"tex":"\\mathrm{Intp}_{93}","display":false},{"tex":"\\begin{aligned}\n{}&\\mathrm{CPLPres}_{93}(\\mathcal P,\\mathsf L,\\mathcal L)\n\\land\\varphi,\\psi\\in F^{\\mathsf{CPL}}_{93}\\\\\n&\\land\\operatorname{VarSupp}_{93}(\\varphi;\\tau^{\\mathsf{CPL}}_{93})\n\\cap\\operatorname{VarSupp}_{93}(\\psi;\\tau^{\\mathsf{CPL}}_{93})\\neq\\varnothing\n\\land\\{\\varphi\\}\\vdash^{\\mathsf{CPL}}_{93}\\psi\\\\\n&\\to\\exists\\theta\\in F^{\\mathsf{CPL}}_{93}\\;\n\\mathrm{Intp}_{93}(\\theta,\\varphi,\\psi;\\mathsf L,\\tau^{\\mathsf{CPL}}_{93}).\n\\end{aligned}","display":true}],"bytes":1770,"backlinks":[],"outgoing":["c2ca1af9af149e69","f7efc342a84d366e","e3c8f5c9e577b791","eda3df85f724c1ae"]}