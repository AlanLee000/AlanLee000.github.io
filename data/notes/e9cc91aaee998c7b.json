rue}_G","display":false},{"tex":"\\bar n","display":false},{"tex":"\\mathrm{PrfRep}_G,\\mathrm{ProvCode}_G,\\mathrm{Prov}_G","display":false},{"tex":"\\mathrm{df\\text{-}provability\\text{-}predicate} \\vdash\n\\begin{aligned}\n\\mathrm{PrfRep}_G(\\dot{\\mathrm{Prf}}_G)\\Longleftrightarrow{}&\n\\mathrm{FV}_G(\\dot{\\mathrm{Prf}}_G)\\subseteq\\{v_0,v_1\\}\\land\\\\\n&\\forall k,m\\in\\mathbb N\\;\\Bigl[\n\\mathrm{Prf}_G(k,m)\\Longleftrightarrow\n\\mathrm{ArithTrue}_G\\bigl(\n\\mathrm{Subst}_G(\\mathrm{Subst}_G(\\dot{\\mathrm{Prf}}_G,\\bar k,v_1),\\bar m,v_0)\n\\bigr)\\Bigr],\\\\\n&\\mathrm{PrfRep}_G(\\dot{\\mathrm{Prf}}_G),\\\\\n\\mathrm{ProvCode}_G(n)\\Longleftrightarrow{}&\n\\exists k\\in\\mathbb N\\;\\mathrm{Prf}_G(k,n),\\\\\n\\mathrm{Prov}_G:{}&\\mathrm{Term}_G\\to\\mathrm{Fml}_G,\\\\\n\\mathrm{Prov}_G(t)\\coloneqq{}&\n\\mathrm{Subst}_G\\bigl(\\exists v_1\\,\\dot{\\mathrm{Prf}}_G,t,v_0\\bigr)\n\\qquad(t\\in\\mathrm{Term}_G).\n\\end{aligned}","display":true},{"tex":"\\mathrm{Prf}_G(k,m)","display":false},{"tex":"\\dot{\\mathrm{Prf}}_G(v_1,v_0)","display":false},{"tex":"\\mathrm{ProvCode}_G(n)","display":false},{"tex":"n","display":false},{"tex":"\\mathrm{Prov}_G(t)","display":false},{"tex":"G","display":false},{"tex":"\\varphi","display":false},{"tex":"\\mathrm{Prov}_G(\\overline{\\ulcorner\\varphi\\urcorner})","display":false},{"tex":"\\dot{\\mathrm{Prf}}_G","display":false},{"tex":"\\mathrm{Prov}_G(v_0)","display":false},{"tex":"\\Sigma_1","display":false},{"tex":"\\dot{\\mathrm{Prf}}_G","display":false},{"tex":"\\mathrm{Prf}_G","display":false}],"bytes":2850,"backlinks":[{"id":"cd8dcab3ce41cbc6","anchor":"ref-15","locations":["正文"],"count":1,"excerpt":"[[92-df-provability-predicate]] - 可证性谓词"},{"id":"a5f0372880e1fccb","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"9d793ce06af6eaa6","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"68f172d58c15e75d","anchor":"ref-7","locations":["元数据 · depends_on",