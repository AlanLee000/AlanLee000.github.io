eg\\mathrm{Inst}_G^2(\\dot{\\mathrm{Prf}}_G;\\bar m,\\bar k)","display":false},{"tex":"\\mathrm{HBL}_{G}(\\exists v_1\\,\\dot{\\mathrm{Prf}}_G)","display":false},{"tex":"\\mathrm{PrfRep}_G,\\mathrm{ProvCode}_G,\\mathrm{Prov}_G,B_G","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}provability\\text{-}predicate}\\vdash\\quad\n\\mathrm{PrfRep}_G(F)&\\Longleftrightarrow\nF\\in\\mathrm{Fml}_G\\land\\mathrm{FV}_G(F)\\subseteq\\{v_0,v_1\\}\\\\\n&\\quad\\land\\forall k,m\\in\\mathbb N\\;(\n\\mathrm{Prf}_G(k,m)\\Longleftrightarrow\n\\mathrm{ArithTrue}_G(\\mathrm{Inst}_G^2(F;\\bar m,\\bar k))),\\\\\nB_G&\\coloneqq\\exists v_1\\,\\dot{\\mathrm{Prf}}_G,\\\\\n\\mathrm{ProvCode}_G(n)&\\Longleftrightarrow\\exists k\\in\\mathbb N\\;\\mathrm{Prf}_G(k,n),\\\\\n\\mathrm{Prov}_G&:\\mathrm{Term}_G\\to\\mathrm{Fml}_G,\\qquad\n\\mathrm{Prov}_G(t)\\coloneqq\\mathrm{Inst}_G^1(B_G;t).\n\\end{aligned}","display":true},{"tex":"\\Sigma_1","display":false},{"tex":"\\mathrm{PrfRep}_G(F)","display":false},{"tex":"\\mathrm{Prov}_G","display":false},{"tex":"\\mathrm{ProvCode}_G","display":false},{"tex":"\\mathrm{Prf}_G","display":false},{"tex":"B_G","display":false},{"tex":"\\mathrm{Prov}_G(t)","display":false},{"tex":"\\alpha","display":false},{"tex":"\\Delta_0","display":false},{"tex":"\\Sigma_1","display":false},{"tex":"\\Delta_0","display":false}],"bytes":3423,"backlinks":[{"id":"a5f0372880e1fccb","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"9d793ce06af6eaa6","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"68f172d58c15e75d","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prov}_G:\\mathrm{Term}_G\\to\\mathrm{Fml}_G$ (internal provability-formula constructor, see [[92-df-provability-predicate]])"},{"id":"b823f18a7fc28400","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prov}_G$ (provability predicate, see [[92-df-provability-predicate]])"},{