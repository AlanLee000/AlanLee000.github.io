{"id":"6ced3a4cc9f8e397","group":"58","path":"58/batch18/58-df-zfc-func-contraction-map.md","title":"ZFC Func Contraction Map","display":"df-zfc-func-contraction-map — ZFC Func Contraction Map","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-func-contraction-map","aliases":["58-df-zfc-func-contraction-map"],"display":"df-zfc-func-contraction-map — ZFC Func Contraction Map","depends_on":["[[58-ax-zfc]]","[[58-df-contraction]]","[[../batch16/58-df-function.md]]","[[58-df-metric]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-func-contraction-map"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-func-contraction-map</span></div>"},{"key":"display","html":"df-zfc-func-contraction-map — ZFC Func Contraction Map"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"2e6058d3f9166e91\" href=\"?note=2e6058d3f9166e91\" title=\"58-df-contraction\">58-df-contraction</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"267957a097ff75bf\" href=\"?note=267957a097ff75bf\" title=\"58-df-metric\">58-df-metric</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"f,X,d,c\\in V\">\\(f,X,d,c\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Metric}_S\\subseteq V^2\">\\(\\mathrm{Metric}_S\\subseteq V^2\\)</span> (metric predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"267957a097ff75bf\" href=\"?note=267957a097ff75bf\" title=\"58-df-metric\">58-df-metric</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span> (function predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcFuncContractionMap}_S\\subseteq V^4\">\\(\\mathrm{ZfcFuncContractionMap}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}func\\text{-}contraction\\text{-}map} \\vdash \\mathrm{ZfcFuncContractionMap}_S(f,X,d,c)\\leftrightarrow \\mathrm{Metric}_S(d,X)\\land\\mathrm{Function}(f,X,X)\\land c\\in\\mathbb R\\land 0\\leq c&lt;1\\land\\forall x,y\\in X\\;\\bigl(d(f(x),f(y))\\leq c\\,d(x,y)\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}func\\text{-}contraction\\text{-}map} \\vdash \\mathrm{ZfcFuncContractionMap}_S(f,X,d,c)\\leftrightarrow \\mathrm{Metric}_S(d,X)\\land\\mathrm{Function}(f,X,X)\\land c\\in\\mathbb R\\land 0\\leq c&lt;1\\land\\forall x,y\\in X\\;\\bigl(d(f(x),f(y))\\leq c\\,d(x,y)\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-contraction","status":"resolved","id":"2e6058d3f9166e91","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-contraction]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"58-df-metric","status":"resolved","id":"267957a097ff75bf","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-metric]]","embed":false},{"target":"58-df-metric","status":"resolved","id":"267957a097ff75bf","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Metric}_S\\subseteq V^2$ (metric predicate, see [[58-df-metric]])","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}\\subseteq V^3$ (function predicate, see [[../batch16/58-df-function.md]])","embed":false}],"math":[{"tex":"f,X,d,c\\in V","display":false},{"tex":"\\mathrm{Metric}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{Function}\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcFuncContractionMap}_S\\subseteq V^4","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}func\\text{-}contraction\\text{-}map} \\vdash \\mathrm{ZfcFuncContractionMap}_S(f,X,d,c)\\leftrightarrow \\mathrm{Metric}_S(d,X)\\land\\mathrm{Function}(f,X,X)\\land c\\in\\mathbb R\\land 0\\leq c<1\\land\\forall x,y\\in X\\;\\bigl(d(f(x),f(y))\\leq c\\,d(x,y)\\bigr)","display":true}],"bytes":1007,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2149","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-func-contraction-map.md|58-df-zfc-func-contraction-map]]（batch18）"}],"outgoing":["a3348ed9eb6fb4e3","2e6058d3f9166e91","36d7463d215be751","267957a097ff75bf"]}