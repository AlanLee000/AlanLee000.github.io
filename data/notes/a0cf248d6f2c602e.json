L}}\n\\subseteq\\mathsf{Fm}_{\\mathsf{IMTL}}^{<\\omega}\\times\\mathsf{Fm}_{\\mathsf{IMTL}},\n\\qquad \\mathsf{Rule}^{\\operatorname{proof}}_{\\mathsf{IMTL}}=\\varnothing.","display":true},{"tex":"\\mathcal S_{\\mathsf{IMTL}}\n=\n\\bigl(\n\\mathsf{Prop},\n\\mathsf{Fm}_{\\mathsf{IMTL}},\n\\operatorname{PV}_{\\mathsf{IMTL}},\n\\operatorname{FV}_{\\mathsf{IMTL}},\n\\operatorname{BV}_{\\mathsf{IMTL}},\n\\mathsf{Subst}_{\\mathsf{IMTL}},\n\\operatorname{Ext}_{\\mathsf{IMTL}},\n\\equiv_{\\alpha,\\mathsf{IMTL}},\n\\mathsf{Alg}_{\\mathsf{IMTL}},\n\\llbracket-\\rrbracket^{\\mathsf{IMTL}},\n\\mathsf{Valid}_{\\mathsf{IMTL}},\n\\models_{\\mathsf{IMTL}},\n\\mathsf{Cex}_{\\mathsf{IMTL}},\n\\mathsf{Fail}_{\\mathsf{IMTL}},\n\\mathsf{SemCert}_{\\mathsf{IMTL}},\n\\mathsf{Rule}^{\\operatorname{proof}}_{\\mathsf{IMTL}}\n\\bigr).","display":true},{"tex":"\\mathsf{Alg}_{\\mathsf{IMTL}}","display":false},{"tex":"\\models_{\\mathsf{IMTL}}","display":false}],"bytes":8312,"backlinks":[],"outgoing":[]}