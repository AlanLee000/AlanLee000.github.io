ershipStructure}_S(\\mathfrak M,M)\\land\\mathrm{MembershipStructure}_S(\\mathfrak H,H)\\land\\mathfrak M\\prec_{\\mathcal L_{\\in}}\\mathfrak H\n\\to{}\\\\\n&\\qquad\\forall p\\in M\\cap\\mathbb P\\;\\exists q\\in\\mathbb P\\;\\bigl(\nq\\leq_{\\mathbb P}p\\land\n\\forall D\\;\\bigl(\nD\\subseteq M\\cap\\mathbb P\\land\\forall a\\in M\\cap\\mathbb P\\;\\exists d\\in D\\;(d\\leq_{\\mathbb P}a)\n\\to{}\\\\\n&\\hspace{13em}\\forall r\\in\\mathbb P\\;(r\\leq_{\\mathbb P}q\\to\n\\exists d\\in D\\;\\mathrm{StrongCompatible}_S(r,d,\\mathbb P,\\leq_{\\mathbb P}))\n\\bigr)\\bigr)\n\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\theta","display":false},{"tex":"M\\prec H_\\theta","display":false},{"tex":"p\\in M\\cap\\mathbb P","display":false},{"tex":"q","display":false},{"tex":"M\\cap\\mathbb P","display":false},{"tex":"q","display":false}],"bytes":2844,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3502","locations":["正文"],"count":1,"excerpt":"[[../batch09/58-df-zfc-strongly-proper-poset.md|58-df-zfc-strongly-proper-poset]]（batch09）"}],"outgoing":["a3348ed9eb6fb4e3","f02ce1cb4d0ec8b0","b5833df5ef175153","8935dcac821c0104","faf104362ffe13b3","5582a281f15a33c2"]}