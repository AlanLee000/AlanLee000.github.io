T\\vdash\\bot$，与 $\\operatorname{Con}^{\\mathrm{meta}}(T)$ 矛盾。","embed":false}],"math":[{"tex":"S,g,d,T","display":false},{"tex":"\\mathrm{REAx},\\mathrm{Con}^{\\mathrm{meta}},\\mathrm{Con}_T,\\mathrm{Prov}_T","display":false},{"tex":"\\mathrm{HB}(T,P)","display":false},{"tex":"\\mathrm{HB}(T,P)\\Longleftrightarrow\\mathrm{HBL}_T(P)","display":false},{"tex":"\\mathrm{DiagAdeq}","display":false},{"tex":"\\mathrm{HB}(T,P)\\Longleftrightarrow\\mathrm{HBL}_T(P).","display":true},{"tex":"\\mathrm{REAx}_{S,g}(T)\\land\\mathrm{DiagAdeq}_{S,g,d}(T)\n\\land\\mathrm{HB}(T,\\mathrm{Prov}_T)\\land\\operatorname{Con}^{\\mathrm{meta}}(T)\n\\ \\Longrightarrow\\ T\\nvdash\\mathrm{Con}_T.","display":true},{"tex":"T\\vdash\\mathrm{Con}_T","display":false},{"tex":"T\\vdash\\neg\\mathrm{Prov}_T(\\overline{g(\\bot)})","display":false},{"tex":"T\\vdash\\mathrm{Prov}_T(\\overline{g(\\bot)})\\to\\bot","display":false},{"tex":"A=\\bot","display":false},{"tex":"T\\vdash\\bot","display":false},{"tex":"\\operatorname{Con}^{\\mathrm{meta}}(T)","display":false},{"tex":"\\mathrm{HB}(T,\\mathrm{Prov}_T)","display":false},{"tex":"\\mathrm{Con}_T","display":false},{"tex":"\\operatorname{Ax}(Q)\\subseteq T","display":false}],"bytes":2111,"backlinks":[{"id":"da1a6647840ffca5","anchor":"ref-67","locations":["正文"],"count":1,"excerpt":"[[90-df-hbl-conditions]]、[[90-thm-second-incompleteness]]"},{"id":"32c1f47762a7f658","anchor":"ref-129","locations":["正文"],"count":1,"excerpt":"[[90-thm-diagonal-closure.md]]\n[[90-thm-diagonal-lemma-formal.md]]\n[[90-thm-first-incompleteness.md]]\n[[90-thm-fixed-point-algorithm.md]]\n[[90-thm-kleene-second-recursion.md]]\n[[90-thm-min-closure-rec.md]]\n[[90-thm-myhill-operator.md]]\n[[90-thm-recursion-theorem.md]]\n[[90-thm-recursive-set-representation.md]]\n[[90-thm-second-incompleteness.md]]\n[[90-thm-smullyan-diagonal.md]]\n[[90-thm-tarski-undefinability.md]]"}],"outgoing":["b7bcf1e41c4a9fc9","4e89323a1592aeb9","8c071ce52fa72de0","002c574215686062","f57084ad3c1a7029","