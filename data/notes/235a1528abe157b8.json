}$ 代替代入函数，也不能把二元对角限制 $\\operatorname{diag}$ 与本书 $D$ 混成同一元数。","embed":false}],"math":[{"tex":"S\\supseteq S_{\\mathrm{arith}}","display":false},{"tex":"\\operatorname{Ax}(Q)\\subseteq T\\subseteq\\mathrm{Sent}_S","display":false},{"tex":"g","display":false},{"tex":"\\mathrm{Sub}_S","display":false},{"tex":"\\mathrm{PR}_2","display":false},{"tex":"\\mathrm{Represents}_T","display":false},{"tex":"x,y,z","display":false},{"tex":"\\operatorname{Graph}","display":false},{"tex":"[\\mathrm{Sub}_S\\in\\mathrm{PR}_2\\land \\operatorname{Ax}(Q)\\subseteq T]\\Longrightarrow\n\\exists\\vartheta_{\\mathrm{Sub}}\\in\\mathrm{Fml}_S^{(3)}\\quad\n\\mathrm{Represents}_T(\\operatorname{Graph}(\\mathrm{Sub}_S),\\vartheta_{\\mathrm{Sub}}).","display":true},{"tex":"x=x\\land y=y\\land z=z","display":false},{"tex":"T","display":false},{"tex":"\\forall x,y\\exists!z\\,\\vartheta_{\\mathrm{Sub}}","display":false},{"tex":"\\mathrm{Sub}_S(g(P(v)),0)=g(P[\\overline0/v])","display":false},{"tex":"\\mathrm{sub}","display":false},{"tex":"\\operatorname{diag}","display":false},{"tex":"D","display":false}],"bytes":1926,"backlinks":[{"id":"32c1f47762a7f658","anchor":"ref-101","locations":["正文"],"count":1,"excerpt":"[[90-df-1-consistency.md]]\n[[90-df-addition-function.md]]\n[[90-df-arithmetic-language.md]]\n[[90-df-arithmetization.md]]\n[[90-df-berry-paradox.md]]\n[[90-df-cantor-diagonal.md]]\n[[90-df-closure-operator.md]]\n[[90-df-comparison-function.md]]\n[[90-df-compcode.md]]\n[[90-df-composition-operator.md]]\n[[90-df-conditional-function.md]]\n[[90-df-conf-proj.md]]\n[[90-df-configuration.md]]\n[[90-df-consistency-statement.md]]\n[[90-df-creative-set.md]]\n[[90-df-decidable-theory.md]]\n[[90-df-diagonal-closure.md]]\n[[90-df-diagonal-function.md]]\n[[90-df-diagonal-lemma.md]]\n[[90-df-diagonalization.md]]\n[[90-df-divisibility.md]]\n[[90-df-divrem-function.md]]\n[[90-df-effective-procedure.md]]\n[[90-df-effectively-axiomatized-theory.md]]\n[[90-df-elementary-system-definition.md]]\n[[90-df-eleme