{"id":"140ca2f0eca0be55","group":"58","path":"58/batch19/58-df-zfc-ordinal8-indescribable-ordinal.md","title":"ZFC Ordinal8 Indescribable Ordinal","display":"df-zfc-ordinal8-indescribable-ordinal — ZFC Ordinal8 Indescribable Ordinal","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-ordinal8-indescribable-ordinal","aliases":["58-df-zfc-ordinal8-indescribable-ordinal"],"display":"df-zfc-ordinal8-indescribable-ordinal — ZFC Ordinal8 Indescribable Ordinal","depends_on":["[[58-df-indescribable]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-ordinal8-indescribable-ordinal"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-ordinal8-indescribable-ordinal</span></div>"},{"key":"display","html":"df-zfc-ordinal8-indescribable-ordinal — ZFC Ordinal8 Indescribable Ordinal"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"ed949cc2262231c7\" href=\"?note=ed949cc2262231c7\" title=\"58-df-indescribable\">58-df-indescribable</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\alpha,n,m\\in V\">\\(\\alpha,n,m\\in V\\)</span> with <span class=\"math-inline\" data-tex=\"n,m\\in\\omega\">\\(n,m\\in\\omega\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ind}_{\\Pi_n^m}:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Ind}_{\\Pi_n^m}:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"ed949cc2262231c7\" href=\"?note=ed949cc2262231c7\" title=\"58-df-indescribable\">58-df-indescribable</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcOrdinal8IndescribableOrdinal}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcOrdinal8IndescribableOrdinal}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></l