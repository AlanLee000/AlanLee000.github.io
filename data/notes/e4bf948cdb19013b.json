H^{2,+}(X;\\mathbb R)\\bigr)\\land g\\in\\operatorname{Met}(X)\\land\\eta\\in\\Omega^{2,+}(X;i\\mathbb R)\\land\\mathcal M=\\{[B,\\Psi]_{\\mathcal G_{\\mathfrak s}}:\\operatorname{SW}_{\\mathfrak s,g,\\eta}(B,\\Psi)=0\\}\\land|\\mathcal M|<\\omega\\land\\forall p\\in\\mathcal M\\;(\\operatorname{coker}D^{\\operatorname{SW}}_{p,g,\\eta}=\\{0\\})\\land\\mathrm{Function}(\\varepsilon,\\mathcal M,\\{-1,1\\})\\land\\forall p\\in\\mathcal M\\;\\bigl(\\varepsilon(p)=\\operatorname{or}_{\\mathfrak s,g,\\eta,h}(p)\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}seiberg\\text{-}witten\\text{-}count} \\vdash \\mathrm{SWCount}_S(n,X,\\tau_X,\\mathcal A_X,\\mathfrak s,h,g,\\eta,\\mathcal M,\\varepsilon)\\leftrightarrow \\mathrm{SeibergWittenExpectedDimension}_S(0,X,\\tau_X,\\mathcal A_X,\\mathfrak s)\\land\\mathrm{SWRegularZeroDatum}_S(\\mathcal M,\\varepsilon,X,\\tau_X,\\mathcal A_X,\\mathfrak s,h,g,\\eta)\\land n=\\sum_{p\\in\\mathcal M}\\varepsilon(p)\\in\\mathbb Z","display":true},{"tex":"\\mathrm{df\\text{-}seiberg\\text{-}witten} \\vdash \\mathrm{SeibergWittenInvariant}_S(n,X,\\tau_X,\\mathcal A_X,\\mathfrak s,h)\\leftrightarrow b_2^+(X)>1\\land\\exists g,\\eta,\\mathcal M,\\varepsilon\\;\\mathrm{SWCount}_S(n,X,\\tau_X,\\mathcal A_X,\\mathfrak s,h,g,\\eta,\\mathcal M,\\varepsilon)","display":true},{"tex":"b_2^+(X)>1","display":false}],"bytes":3643,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1123","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-seiberg-witten.md|58-df-seiberg-witten]]（batch11）"}],"outgoing":["ec1809e41ec24c81","8ee356c2b76fa7ec"]}