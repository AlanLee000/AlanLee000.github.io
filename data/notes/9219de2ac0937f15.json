-72","locations":["正文"],"count":1,"excerpt":"[[./18-thm-epsilon0]]"},{"id":"e29d1100705cdb23","anchor":"ref-122","locations":["正文"],"count":1,"excerpt":"[[../18-thm-epsilon0]]"},{"id":"bf01645e59119446","anchor":"ref-131","locations":["正文"],"count":1,"excerpt":"[[../18-thm-epsilon0|18-thm-epsilon0]]"}],"outgoing":["9fc246f88d0f85c8","40176d5c80238174","fdee91a683a5c7c3"]}