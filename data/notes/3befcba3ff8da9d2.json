:"\\mathrm{df\\text{-}divisor\\text{-}principal} \\vdash \\operatorname{PrincipalDivisor}_K(f,D) \\leftrightarrow f\\in K^\\times\\land\\operatorname{Divisor}_K(D)\\land D=\\sum_{\\mathfrak p\\in\\mathfrak P_K}v_{\\mathfrak p}(f)\\mathfrak p","display":true},{"tex":"\\mathrm{df\\text{-}divisor\\text{-}linear\\text{-}equivalence} \\vdash \\operatorname{LinearlyEquivalent}_K(D,D') \\leftrightarrow \\operatorname{Divisor}_K(D)\\land\\operatorname{Divisor}_K(D')\\land\\exists f\\in K^\\times\\;\\operatorname{PrincipalDivisor}_K(f,D-D')","display":true},{"tex":"\\mathrm{df\\text{-}divisor\\text{-}degree} \\vdash \\operatorname{Degree}_K(D,r) \\leftrightarrow r\\in\\mathbb R\\land\\operatorname{Divisor}_K(D)\\land\\exists n\\in\\mathbb Z^{\\mathfrak P_K}\\;\\bigl(\\mathrm{Finite}_S(\\{\\mathfrak p\\in\\mathfrak P_K:n(\\mathfrak p)\\neq0\\})\\land D=\\sum_{\\mathfrak p\\in\\mathfrak P_K}n(\\mathfrak p)\\mathfrak p\\land r=\\sum_{\\mathfrak p\\in\\mathfrak P_K}n(\\mathfrak p)\\log N(\\mathfrak p)\\bigr)","display":true},{"tex":"\\operatorname{Spec}\\mathcal O_K","display":false},{"tex":"\\operatorname{Spec}\\mathcal O_K","display":false},{"tex":"\\operatorname{Cl}(K) = \\operatorname{Div}(K) / \\operatorname{Princ}(K)","display":false}],"bytes":3250,"backlinks":[{"id":"313999e0230fc8e3","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{Divisor}_K(D)$ (finite-prime divisor, see [[58-df-divisor]])"},{"id":"a11585cba9c21cfd","anchor":"ref-228","locations":["正文"],"count":1,"excerpt":"[[58-df-divisor]]"},{"id":"84daad544872cc71","anchor":"ref-449","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-divisor.md|58-df-divisor]]（batch07）"}],"outgoing":["4e62b6beb4c1e82d","0fb569bc36cce327","d9a25b0ac94a3598"]}