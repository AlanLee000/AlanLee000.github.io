 \\mathrm{TreeLevel}_S(L,\\alpha,T,<_{T})\\leftrightarrow L=\\{t\\in T:\\mathrm{NodeHeight}_S(\\alpha,t,T,<_{T})\\}","display":true},{"tex":"\\mathrm{df\\text{-}tree\\text{-}prop} \\vdash \\mathrm{KappaTree}_S(T,<_{T},\\kappa)\\leftrightarrow\\mathrm{Tree}(T,<_{T})\\land\\mathrm{RegularCardinal}_S(\\kappa)\\land\\Bigl(\\forall t\\in T\\;\\exists\\alpha\\in\\kappa\\;\\mathrm{NodeHeight}_S(\\alpha,t,T,<_{T})\\Bigr)\\land\\Bigl(\\forall\\alpha\\in\\kappa\\;\\exists L\\in V\\;\\bigl(\\mathrm{TreeLevel}_S(L,\\alpha,T,<_{T})\\land0<|L|<\\kappa\\bigr)\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}tree\\text{-}prop\\text{-}cofinal\\text{-}branch} \\vdash \\mathrm{CofinalBranch}_S(b,T,<_{T},\\kappa)\\leftrightarrow b\\subseteq T\\land\\forall s,t\\in b\\;(s<_{T}t\\lor s=t\\lor t<_{T}s)\\land\\forall\\alpha\\in\\kappa\\;\\exists t\\in b\\;\\mathrm{NodeHeight}_S(\\alpha,t,T,<_{T})","display":true},{"tex":"\\mathrm{df\\text{-}tree\\text{-}property} \\vdash \\mathrm{TP}(\\kappa)\\leftrightarrow\\mathrm{RegularCardinal}_S(\\kappa)\\land\\omega<\\kappa\\land\\forall T,<_{T}\\in V\\;\\Bigl(\\mathrm{KappaTree}_S(T,<_{T},\\kappa)\\to\\exists b\\subseteq T\\;\\mathrm{CofinalBranch}_S(b,T,<_{T},\\kappa)\\Bigr)","display":true},{"tex":"\\aleph_1","display":false}],"bytes":2479,"backlinks":[{"id":"afc8261d138c3006","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\operatorname{Lev}_\\alpha(T)=\\{t\\in T:\\operatorname{ht}_T(t)=\\alpha\\}$ (see [[../batch16/58-df-tree-prop.md]])."},{"id":"3d82bb5b303fe2a0","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{KappaTree}_S$ ($\\kappa$-tree predicate, see [[58-df-tree-prop]])"},{"id":"bc0e6aeb4b9f63ca","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{KappaTree}_S$ ($\\kappa$-tree predicate, see [[58-df-tree-prop]])"},{"id":"84daad544872cc71","anchor":"ref-1323","locations":["正文"],"count":1,"excerpt":"[[../batch16/58-df-tree-prop.md|58-df-