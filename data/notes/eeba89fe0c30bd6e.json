 q)\\}.","display":true},{"tex":"\\begin{aligned}\n\\mathrm{AI}_{\\Sigma,V,R}:={}&\\{(t,t):t\\in T\\land\\mathrm{NF}(T,\\to_R,t)\\}\\\\\n&\\cup\\{(t,t[r\\sigma]_p):t\\in T,\\;(l,r)\\in R,\\;\\sigma\\in\\mathrm{Sub}(\\Sigma,V),\\;\np\\in\\mathrm{InnerPos}(\\Sigma,V,R,t),\\;t|_p=l\\sigma,\\\\\n&\\hspace{40mm}\\neg\\exists q\\in\\mathrm{InnerPos}(\\Sigma,V,R,t)\\;(q<_{\\mathrm{lex}}p)\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{AI}_{\\Sigma,V,R}:T\\to T.","display":true}],"bytes":1998,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-179","locations":["正文"],"count":2,"excerpt":"[[56-df-applicative-order.md]]"}],"outgoing":["2ebc9e1638fe6861","da02033e6d596cae","a3b60e1e9cdeef27","a6c29a8d098ef0ed","55c39f44acb2211c"]}