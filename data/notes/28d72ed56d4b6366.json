045d1\" href=\"?note=291650b9643045d1\" title=\"43-thm-lowfork-equiv\">43-thm-lowfork-equiv</a></span></div>"},{"key":"source_edition","html":"Downey–Hirschfeldt, Algorithmic Randomness and Complexity, draft 2007-07-28 (629 PDF pages)"},{"key":"source_locator","html":"Cor.15.1.30 + dimension formulas"},{"key":"verification_status","html":"proved-in-note"},{"key":"eligible_as_verified_dependency","html":"true"},{"key":"source_proof_checked","html":"false"},{"key":"local_proof_checked","html":"true"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p><span class=\"math-inline\" data-tex=\"A\\subseteq\\mathbb N\">\\(A\\subseteq\\mathbb N\\)</span>，<span class=\"math-inline\" data-tex=\"X\\in2^\\omega\">\\(X\\in2^\\omega\\)</span>；见 <a class=\"wiki-link\" id=\"ref-6\" data-note=\"ccd45302acc926e6\" href=\"?note=ccd45302acc926e6\" title=\"43-df-ktrivial\">43-df-ktrivial</a>、<a class=\"wiki-link\" id=\"ref-7\" data-note=\"bc5e1d2950e8a1f7\" href=\"?note=bc5e1d2950e8a1f7\" title=\"43-df-reldim\">43-df-reldim</a>、<a class=\"wiki-link\" id=\"ref-8\" data-note=\"2114b7d641739c3e\" href=\"?note=2114b7d641739c3e\" title=\"43-df-effhausdim\">43-df-effhausdim</a>、<a class=\"wiki-link\" id=\"ref-9\" data-note=\"28c411f76cbe3176\" href=\"?note=28c411f76cbe3176\" title=\"43-df-effpackdim\">43-df-effpackdim</a>、<a class=\"wiki-link\" id=\"ref-10\" data-note=\"291650b9643045d1\" href=\"?note=291650b9643045d1\" title=\"43-thm-lowfork-equiv\">43-thm-lowfork-equiv</a>。</p>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{KTrivial}(A)\\Rightarrow(\\dim_H^A(X)=\\dim_H(X)\\land\\mathrm{Dim}^A(X)=\\mathrm{Dim}(X)).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{KTrivial}(A)\\Rightarrow(\\dim_H^A(X)=\\dim_H(X)\\land\\mathrm{Dim}^A(X)=\\mathrm{Dim}(X)).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>K 平凡性等价 K 低性，使 K^A 与 K 仅相差统一常数；归一化后上下极限相同。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"43-df-ktrivial","status":"resolved","id":"ccd45302acc926e6","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[43-df-ktrivial]]","embed":false},{"target":"43-df-reldim","status":"resolved","id":"bc5e1d2950e8a1f7","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[43-df-reldim]]","embed":false},{"target":"43-df-effhausdim","status":"resolved","id":"2114b7d641739c3e","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[43-df-effhausdim]]","embed":false},{"target":"43-df-effpackdim","status":"resolved","id":"28c411f76cbe3176","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[43-df-effpackdim]]","embed":false},{"target":"43-thm-lowfork-equiv","status":"resolved","id":"291650b9643045d1","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[43-thm-lowfork-equiv]]","embed":false},{"target":"43-df-ktrivial","status":"resolved","id":"ccd45302acc926e6","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$A\\subseteq\\mathbb N$，$X\\in2^\\omega$；见 [[43-df-ktrivial]]、[[43-df-reldim]]、[[43-df-effhausdim]]、[[43-df-effpackdim]]、[[43-thm-lowfork-equiv]]。","embed":false},{"target":"43-df-reldim","status":"resolved","id":"bc5e1d2950e8a1f7","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$A\\subseteq\\mathbb N$，$X\\in2^\\omega$；见 [[43-df-ktrivial]]、[[43-df-reldim]]、[[43-df-effhausdim]]、[[43-df-effpackdim]]、[[43-thm-lowfork-equiv]]。","embed":false},{"target":"43-df-effhausdim","status":"resolved","id":"2114b7d641739c3e","anchor":"ref-8","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$A\\s