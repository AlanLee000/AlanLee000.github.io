{"id":"b0b0b390d490331f","group":"58","path":"58/batch07/58-df-zfc-top-first-countable-space.md","title":"ZFC Top First Countable Space","display":"df-zfc-top-first-countable-space — ZFC Top First Countable Space","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-top-first-countable-space","aliases":["58-df-zfc-top-first-countable-space","58-df-zfc-top5-first-countable-space"],"display":"df-zfc-top-first-countable-space — ZFC Top First Countable Space","depends_on":["[[../batch14/58-df-topology.md]]","[[../batch02/58-df-zfc-card6-countable-set.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-top-first-countable-space"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-top-first-countable-space</span><span>58-df-zfc-top5-first-countable-space</span></div>"},{"key":"display","html":"df-zfc-top-first-countable-space — ZFC Top First Countable Space"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"e7514bc4cefba4f2\" href=\"?note=e7514bc4cefba4f2\" title=\"../batch14/58-df-topology.md\">../batch14/58-df-topology.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"f02ce1cb4d0ec8b0\" href=\"?note=f02ce1cb4d0ec8b0\" title=\"../batch02/58-df-zfc-card6-countable-set.md\">../batch02/58-df-zfc-card6-countable-set.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,B,x,U,V\\in V\">\\(X,\\tau,B,x,U,V\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Top}(\\tau,X)\">\\(\\mathrm{Top}(\\tau,X)\\)</span> (topology predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCard6CountableSet}_S(B)\">\\(\\mathrm{ZfcCard6CountableSet}_S(B)\\)</span> (countability predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopFirstCountableSpace}_S\">\\(\\mathrm{ZfcTopFirstCountableSpace}_S\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5FirstCountableSpace}_S\">\\(\\mathrm{ZfcTop5FirstCountableSpace}_S\\)</span> (alias predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top\\text{-}first\\text{-}countable\\text{-}space} \\vdash \\mathrm{ZfcTopFirstCountableSpace}_S(X,\\tau)\\leftrightarrow\\mathrm{Top}(\\tau,X)\\land\\forall x\\in X\\;\\exists B\\;\\bigl(B\\subseteq\\tau\\land\\mathrm{ZfcCard6CountableSet}_S(B)\\land\\forall V\\in B\\;(x\\in V)\\land\\forall U\\in\\tau\\;(x\\in U\\to\\exists V\\in B\\;(V\\subseteq U))\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top\\text{-}first\\text{-}countable\\text{-}space} \\vdash \\mathrm{ZfcTopFirstCountableSpace}_S(X,\\tau)\\leftrightarrow\\mathrm{Top}(\\tau,X)\\land\\forall x\\in X\\;\\exists B\\;\\bigl(B\\subseteq\\tau\\land\\mathrm{ZfcCard6CountableSet}_S(B)\\land\\forall V\\in B\\;(x\\in V)\\land\\forall U\\in\\tau\\;(x\\in U\\to\\exists V\\in B\\;(V\\subseteq U))\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top5\\text{-}first\\text{-}countable\\text{-}space} \\vdash \\mathrm{ZfcTop5FirstCountableSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTopFirstCountableSpace}_S(X,\\tau)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top5\\text{-}first\\text{-}countable\\text{-}space} \\vdash \\mathrm{ZfcTop5FirstCountableSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTopFirstCountableSpace}_S(X,\\tau)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch14/58-df-topology.md","status":"resolved","id":"e7514bc4cefba4f2","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-df-topology.md]]","embed":false},{"target":"../batch02/58-df-zfc-card6-countable-set.md","status":"resolved","id":"f02ce1cb4d0ec8b0","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-zfc-card6-countable-set.md]]","embed":false}],"math":[{"tex":"X,\\tau,B,x,U,V\\in V","display":false},{"tex":"\\mathrm{Top}(\\tau,X)","display":false},{"tex":"\\mathrm{ZfcCard6CountableSet}_S(B)","display":false},{"tex":"\\mathrm{ZfcTopFirstCountableSpace}_S","display":false},{"tex":"\\mathrm{ZfcTop5FirstCountableSpace}_S","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}top\\text{-}first\\text{-}countable\\text{-}space} \\vdash \\mathrm{ZfcTopFirstCountableSpace}_S(X,\\tau)\\leftrightarrow\\mathrm{Top}(\\tau,X)\\land\\forall x\\in X\\;\\exists B\\;\\bigl(B\\subseteq\\tau\\land\\mathrm{ZfcCard6CountableSet}_S(B)\\land\\forall V\\in B\\;(x\\in V)\\land\\forall U\\in\\tau\\;(x\\in U\\to\\exists V\\in B\\;(V\\subseteq U))\\bigr)","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}top5\\text{-}first\\text{-}countable\\text{-}space} \\vdash \\mathrm{ZfcTop5FirstCountableSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTopFirstCountableSpace}_S(X,\\tau)","display":true}],"bytes":1351,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3520","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-zfc-top-first-countable-space.md|58-df-zfc-top-first-countable-space]]（batch07）"}],"outgoing":["e7514bc4cefba4f2","f02ce1cb4d0ec8b0"]}