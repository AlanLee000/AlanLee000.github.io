verline n])^*\\mid n<\\omega\\rangle),\\\\\n(\\exists x\\ G)^*&\\coloneqq\n\\mathsf D_\\omega(\\langle(G[x:=\\overline n])^*\\mid n<\\omega\\rangle).\n\\end{aligned}","display":true},{"tex":"\\forall F\\in\\mathcal L_\\kappa^{\\mathrm{op}}\\quad\n\\bigl(\\mathrm{Sat}_\\infty(\\sim_\\infty F,\\eta,\\Phi)\n\\leftrightarrow\\neg\\mathrm{Sat}_\\infty(F,\\eta,\\Phi)\\bigr).","display":true},{"tex":"\\forall G\\in\\mathcal F_{\\mathrm{NT}}\\quad\n\\bigl(G^*\\in\\mathcal L_{\\omega_1}^{\\mathrm{op}}\\land\n\\mathrm{FV}^{\\infty}_0(G^*)=\\mathrm{FV}_0(G)\\land\n\\mathrm{FV}^{\\infty}_1(G^*)=\\mathrm{FV}_1(G)\\land\n\\bigl(\\mathrm{Sat}_\\infty(G^*,\\eta,\\Phi)\\leftrightarrow\n\\mathrm{Sat}_{\\mathrm N}(G,\\eta,\\Phi)\\bigr)\\bigr).","display":true},{"tex":"G\\in\\Psi_{\\mathrm{NT}}\\ \\longrightarrow\\\n\\bigl(G^*\\in\\mathcal L_{\\omega_1}\\land\n(\\mathbb N\\models G[\\Phi]\\leftrightarrow\\mathbb N\\models_\\infty G^*[\\Phi])\\bigr).","display":true},{"tex":"\\mathrm{rk}_{\\mathrm N}","display":false},{"tex":"\\mathrm{rnk}_\\infty","display":false}],"bytes":3781,"backlinks":[{"id":"c8f3a8371faa8691","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\alpha<\\omega_1$。$\\mathcal L_{\\omega_1}^{\\mathrm{op}}$ 的数变量模板、代入、对偶和秩见 [[18-df-infinitary-operations]]；标准解释见 [[18-df-infinitary-semantics]]；$D_{\\infty,\\rho}^\\xi$ 见 [[18-df-infinitary-derivability]]。$u=x_0,v=x_1$ 是不同数变量，$X_0$ 是固定集变量，$\\eta_0$ 为全零数赋值，$\\Phi_0(X)=\\varnothing$ 为全空集赋值。"},{"id":"02bcc9140b83afbe","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$0\\leq\\kappa\\leq\\omega_1$，$\\Delta\\in[\\mathcal L_\\kappa]^{<\\omega}$；$\\alpha,\\rho$ 为序数。$\\mathcal L_\\kappa,\\mathsf a,\\mathrm{CType}_\\kappa,\\mathrm{DType}_\\kappa,\\mathrm{CS}_\\infty,\\sim_\\infty,\\mathrm{rnk}_\\infty$ 及 $\\mathbb N\\models_\\infty$ 见 [[18-df-infinitary-operations]]、[[18-df-infinitary-semantics]]。$[E]^{<\\omega}$ 为有穷子集族。$\\mathrm{CT}_{\\mathrm{NT}}$ 为闭项集，$\\operatorname{val}$ 为闭项求值，精确来源是 [[18-df-arithmetic-tait-language]]。"},{"id":"e40f6292323bbb0b","anchor":"ref-113","locations":["正文"],"count":1,"excerpt":"[[./18-df-infinitary-semantics]]"},{"id":"100d7af02276fe1b","anchor":"ref-79","locations":["正文"],"count":1,"excerpt":"[[../18-df-infinitary-semantics]]"},{"id":"e29d1100705cdb23","anchor":"ref-50","locations":["正文"],"count":1,"excerpt":"[[../18-df-infinitary-semantics]]"}],"outgoing":["392bd14777be34cd","7ddb1b71680edcd2"]}