rall x < \\check{y}","display":false},{"tex":"\\exists x < \\check{y}","display":false},{"tex":"y \\in \\omega","display":false},{"tex":"\\check{y}","display":false},{"tex":"\\mathrm{free}(\\varphi)","display":false},{"tex":"\\varphi","display":false},{"tex":"b","display":false},{"tex":"b={<}","display":false},{"tex":"\\forall x<_b t\\;\\varphi","display":false},{"tex":"\\forall x\\,(b(x,t)\\to\\varphi)","display":false},{"tex":"\\exists x<_b t\\;\\varphi","display":false},{"tex":"\\exists x\\,(b(x,t)\\land\\varphi)","display":false},{"tex":"\\Delta_0^0","display":false},{"tex":"\\check{y}","display":false},{"tex":"y","display":false},{"tex":"S(S(\\cdots S(0)\\cdots))","display":false},{"tex":"y","display":false}],"bytes":3119,"backlinks":[{"id":"e8d93d31f2068246","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"1d779f4a08a1f22e","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\Delta_0^0(\\Sigma)\\subseteq\\mathrm{Fml}_S(\\Sigma)$（有界量词公式类，见 [[../batch04/58-df-delta-0-formula.md]]）"},{"id":"84daad544872cc71","anchor":"ref-404","locations":["正文"],"count":1,"excerpt":"[[../batch04/58-df-delta-0-formula.md|58-df-delta-0-formula]]（batch04）"}],"outgoing":["65418b505fc53093","ca5c1762b574813b","db7ec154138d5972","621985f38a386342","715a32e91161b34f","5045d216c83e75cb","1d779f4a08a1f22e"]}