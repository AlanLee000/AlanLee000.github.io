dd056\" title=\"57-df-exists-left\">57-df-exists-left</a></span><span><a class=\"wiki-link\" id=\"ref-17\" data-note=\"f03b451ec807bbed\" href=\"?note=f03b451ec807bbed\" title=\"57-df-exists-right\">57-df-exists-right</a></span><span><a class=\"wiki-link\" id=\"ref-18\" data-note=\"cee19f3bbf639be5\" href=\"?note=cee19f3bbf639be5\" title=\"57-df-equality-left\">57-df-equality-left</a></span><span><a class=\"wiki-link\" id=\"ref-19\" data-note=\"962c1092f2b3a63e\" href=\"?note=962c1092f2b3a63e\" title=\"57-df-equality-right\">57-df-equality-right</a></span><span><a class=\"wiki-link\" id=\"ref-20\" data-note=\"274aa2023d8b62ce\" href=\"?note=274aa2023d8b62ce\" title=\"57-df-weak-left\">57-df-weak-left</a></span><span><a class=\"wiki-link\" id=\"ref-21\" data-note=\"7013c3e9bd9daa4e\" href=\"?note=7013c3e9bd9daa4e\" title=\"57-df-weak-right\">57-df-weak-right</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Seq}_S\">\\(\\mathrm{Seq}_S\\)</span>、规则关系和初始矢列见 <a class=\"wiki-link\" id=\"ref-22\" data-note=\"35a80f442c4e1ba6\" href=\"?note=35a80f442c4e1ba6\" title=\"57-df-sequent\">57-df-sequent</a>、<a class=\"wiki-link\" id=\"ref-23\" data-note=\"7e03b0a4a070eb4c\" href=\"?note=7e03b0a4a070eb4c\" title=\"57-df-sequent-rule\">57-df-sequent-rule</a>、<a class=\"wiki-link\" id=\"ref-24\" data-note=\"ffea087958da1750\" href=\"?note=ffea087958da1750\" title=\"57-df-axiom-rule\">57-df-axiom-rule</a>。</p>\n</li>\n<li>\n<p>命题规则见 <a class=\"wiki-link\" id=\"ref-25\" data-note=\"b03ce990952f9df8\" href=\"?note=b03ce990952f9df8\" title=\"57-df-negation-left\">57-df-negation-left</a>、<a class=\"wiki-link\" id=\"ref-26\" data-note=\"40189b586b86c8aa\" href=\"?note=40189b586b86c8aa\" title=\"57-df-negation-right\">57-df-negation-right</a>、<a class=\"wiki-link\" id=\"ref-27\" data-note=\"062cce96dd2bbc0b\" href=\"?note=062cce96dd2bbc0b\" title=\"57-df-implication-left\">57-df-implication-left</a>、<a class=\"wiki-link\" id=\"ref-28\" data-note=\"183700664ff6ef82\" href=\"?note=183700664ff6ef82\" title=\"57-df-implication-right\">57-df-implication-right</a>、<a class=\"wiki-link\" id=\"ref-29\" data-note=\"5f9098fbb6b7676e\" href=\"?note=5f9098fbb6b7676e\" title=\"57-df-conjunction-left\">57-df-conjunction-left</a>、<a class=\"wiki-link\" id=\"ref-30\" data-note=\"a95f4e403bfe14c8\" href=\"?note=a95f4e403bfe14c8\" title=\"57-df-conjunction-right\">57-df-conjunction-right</a>、<a class=\"wiki-link\" id=\"ref-31\" data-note=\"79caa8374cd19320\" href=\"?note=79caa8374cd19320\" title=\"57-df-disjunction-left\">57-df-disjunction-left</a>、<a class=\"wiki-link\" id=\"ref-32\" data-note=\"206f1a0a194a45b0\" href=\"?note=206f1a0a194a45b0\" title=\"57-df-disjunction-right\">57-df-disjunction-right</a>、<a class=\"wiki-link\" id=\"ref-33\" data-note=\"e691d2b8c2909e07\" href=\"?note=e691d2b8c2909e07\" title=\"57-df-equiv-left\">57-df-equiv-left</a>、<a class=\"wiki-link\" id=\"ref-34\" data-note=\"9d7a0cf3497592b2\" href=\"?note=9d7a0cf3497592b2\" title=\"57-df-equiv-right\">57-df-equiv-right</a>。</p>\n</li>\n<li>\n<p>量词与等号规则见 <a class=\"wiki-link\" id=\"ref-35\" data-note=\"b0fd90af076efa92\" href=\"?note=b0fd90af076efa92\" title=\"57-df-forall-left\">57-df-forall-left</a>、<a class=\"wiki-link\" id=\"ref-36\" data-note=\"1f550822d0e6a763\" href=\"?note=1f550822d0e6a763\" title=\"57-df-forall-right\">57-df-forall-right</a>、<a class=\"wiki-link\" id=\"ref-37\" data-note=\"368cff223b0dd056\" href=\"?note=368cff223b0dd056\" title=\"57-df-exists-left\">57-df-exists-left</a>、<a class=\"wiki-link\" id=\"ref-38\" data-note=\"f03b451ec807bbed\" href=\"?note=f03b451ec807bbed\" title=\"57-df-exists-right\">57-df-exists-right</a>、<a class=\"wiki-link\" id=\"ref-39\" data-note=\"cee19f3bbf639be5\" href=\"?note=cee19f3bbf639be5\" title=\"57-df-equality-left\">57-df-equality-left</a>、<a class=\"wiki-link\" id=\"ref-40\" data-note=\"962c1092f2b3a63e\" href=\"?note=962c1092f2b3a63e\" title=\"57-df-equality-right\">57-df-equality-right</a>；弱化函数见 <a class=\"wiki-link\" id=\"ref-41\" data-note=\"274aa2023d8b62ce\" href=\"?note=274aa2023d8b62ce\" title=\"57-df-weak-left\">57-df-weak-left</a>、<a class=\"wiki-link\" id=\"ref-42\" data-note=\"7013c3e9bd9daa4e\" href=\"?note=7013c3e9bd9daa4e\" title=\"57-df-weak-right\">57-df-weak-right</a>。</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{SC}\">\\(\\mathrm{SC}\\)</span> 保持有序对接口，<span class=\"math-inline\" data-tex=\"\\mathrm{Rules}_{SC}\">\\(\\mathrm{Rules}_{SC}\\)</span> 是规则集合；这是矢列关系演算，不错误地声称其规则是公式载体上的全函数。</p>\n</li>\n<li>\n<p>外部接口 <span class=\"math-inline\" data-tex=\"\\mathrm{WL}\">\\(\\mathrm{WL}\\)</span> 取 <a class=\"wiki-link\" id=\"ref-43\" data-note=\"274aa2023d8b62ce\" href=\"?note=274aa2023d8b62ce\" title=\"57-df-weak-left\">57-df-weak-left</a> 的同名定义与参数次序。</p>\n</li>\n<li>\n<p>外部接口 <span class=\"math-inline\" data-tex=\"\\mathrm{WR}\">\\(\\mathrm{WR}\\)</span> 取 <a class=\"wiki-link\" id=\"ref-44\" data-note=\"7013c3e9bd9daa4e\" href=\"?note=7013c3e9bd9daa4e\" title=\"57-df-weak-right\">57-df-weak-right</a> 的同名定义与参数次序。</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Weak}\">\\(\\mathrm{Weak}\\)</span> 为本原子在下式引入、量化绑定或仅作层级/排版标签的记号；其参数次序与适用域由相应公式固定，不作为额外的未声明外部对象。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{Weak}_L&amp;\\coloneqq\\{\\langle\\langle q\\rangle,\\mathrm{WL}(q,\\varphi)\\rangle:q\\in\\mathrm{Seq}_S\\land\\varphi\\in\\mathrm{Fml}_S\\},\\\\\n\\mathrm{Weak}_R&amp;\\coloneqq\\{\\langle\\langle q\\rangle,\\mathrm{WR}(q,\\varphi)\\rangle:q\\in\\mathrm{Seq}_S\\land\\varphi\\in\\mathrm{Fml}_S\\},\\\\\n\\mathrm{Rules}_{SC}&amp;\\coloneqq\\{\\neg L,\\neg R,\\to L,\\to R,\\land L,\\land R,\\lor L,\\lor R,\n\\leftrightarrow L,\\leftrightarrow R,\\forall L,\\forall R,\\exists L,\\exists R,\\equiv L,\\equiv R,\\mathrm{Weak}_L,\\mathrm{Weak}_R\\},\\\\\n\\mathrm{SC}&amp;\\coloneqq\\langle\\mathrm{Ax},\\mathrm{Rules}_{SC}\\rangle.\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{Weak}_L&amp;\\coloneqq\\{\\langle\\langle q\\rangle,\\mathrm{WL}(q,\\varphi)\\rangle:q\\in\\mathrm{Seq}_S\\land\\varphi\\in\\mathrm{Fml}_S\\},\\\\\n\\mathrm{Weak}_R&amp;\\coloneqq\\{\\langle\\langle q\\rangle,\\mathrm{WR}(q,\\varphi)\\rangle:q\\in\\mathrm{Seq}_S\\land\\varphi\\in\\mathrm{Fml}_S\\},\\\\\n\\mathrm{Rules}_{SC}&amp;\\coloneqq\\{\\neg L,\\neg R,\\to L,\\to R,\\land L,\\land R,\\lor L,\\lor R,\n\\leftrightarrow L,\\leftrightarrow R,\\forall L,\\forall R,\\exists L,\\exists R,\\equiv L,\\equiv R,\\mathrm{Weak}_L,\\mathrm{Weak}_R\\},\\\\\n\\mathrm{SC}&amp;\\coloneqq\\langle\\mathrm{Ax},\\mathrm{Rules}_{SC}\\rangle.\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>补齐原书声称的一阶等号逻辑所需的量词、等号及原始双条件规则；不把仅八条命题规则的系统继续用于一阶完备性。基本系统不含 CUT，切割消除命题因此有明确对象。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"57-df-sequent","status":"resolved","id":"35a80f442c4e1ba6","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-sequent]]","embed":false},{"target":"57-df-sequent-rule","status":"resolved","id":"7e03b0a4a070eb4c","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-sequent-rule]]","embed":false},{"target":"57-df-axiom-rule","status":"resolved","id":"ffea087958da1750","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-axiom-rule]]","embed":false},{"target":"57-df-negation-left","status":"resolved","id":"b03ce990952f9df8","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-negation-left]]","embed"