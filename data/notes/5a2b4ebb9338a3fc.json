{"id":"5a2b4ebb9338a3fc","group":"58","path":"58/batch15/58-df-weakly-wodoin.md","title":"Weakly Woodin","display":"df-weakly-wodoin — Weakly Woodin","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-weakly-wodoin","aliases":["58-df-weakly-wodoin","58-df-weakly-woodin","Weakly Woodin"],"display":"df-weakly-wodoin — Weakly Woodin","depends_on":["[[58-df-regular-cardinal]]","[[58-df-elementary-embedding]]","[[58-df-transitive-set]]","[[58-df-satisfaction]]","[[58-df-function]]","[[58-df-model]]","[[58-df-ordinal]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-weakly-wodoin"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-weakly-wodoin</span><span>58-df-weakly-woodin</span><span>Weakly Woodin</span></div>"},{"key":"display","html":"df-weakly-wodoin — Weakly Woodin"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"0fbfc19800246e77\" href=\"?note=0fbfc19800246e77\" title=\"58-df-regular-cardinal\">58-df-regular-cardinal</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"a25c0a66cf56c0f4\" href=\"?note=a25c0a66cf56c0f4\" title=\"58-df-elementary-embedding\">58-df-elementary-embedding</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"c14ba496c480dcd6\" href=\"?note=c14ba496c480dcd6\" title=\"58-df-transitive-set\">58-df-transitive-set</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"58-df-satisfaction\">58-df-satisfaction</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"923884eb8fe4e61d\" href=\"?note=923884eb8fe4e61d\" title=\"58-df-model\">58-df-model</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"58-df-ordinal\">58-df-ordinal</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\delta\">\\(\\delta\\)</span> is a regular uncountable cardinal.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal E\">\\(\\mathcal E\\)</span> is a set of triples <span class=\"math-inline\" data-tex=\"\\langle j,\\mathcal M,\\mathcal N\\rangle\">\\(\\langle j,\\mathcal M,\\mathcal N\\rangle\\)</span> coding small elementary embeddings between set-coded membership structures, and <span class=\"math-inline\" data-tex=\"\\nu\">\\(\\nu\\)</span> is an ordinal-valued strength map on <span class=\"math-inline\" data-tex=\"\\mathcal E\">\\(\\mathcal E\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZFC}^{-}\">\\(\\mathrm{ZFC}^{-}\\)</span> is the fixed first-order axiom set ZFC without Power Set.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{RegularCardinal}_S\">\\(\\mathrm{RegularCardinal}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ElementaryEmbedding}_S\">\\(\\mathrm{ElementaryEmbedding}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{TransitiveSet}_S\">\\(\\mathrm{TransitiveSet}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Model}_S\">\\(\\mathrm{Model}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Ordinal}\">\\(\\mathrm{Ordinal}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Univ}\">\\(\\mathrm{Univ}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> are supplied by the dependencies; <span class=\"math-inline\" data-tex=\"\\mathcal L_{\\in}\">\\(\\mathcal L_{\\in}\\)</span> is the standard membership language.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{WeakWoodinEmbeddingSystem}_S\">\\(\\mathrm{WeakWoodinEmbeddingSystem}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{WeaklyWoodinWitness}_S\">\\(\\mathrm{WeaklyWoodinWitness}_S\\)</span> are predicates defined here.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}embedding\\text{-}system}\\vdash\n\\mathrm{WeakWoodinEmbeddingSystem}_S(\\delta,\\mathcal E,\\nu)\\leftrightarrow\n\\left[\\begin{aligned}\n&amp;\\mathrm{RegularCardinal}_S(\\delta)\\land\\omega_1\\leq\\delta\\land\n\\mathrm{Function}(\\nu,\\mathcal E,\\operatorname{ran}(\\nu))\\land\\forall\\xi\\in\\operatorname{ran}(\\nu)\\;\\mathrm{Ordinal}(\\xi)\\\\\n&amp;{}\\land\\forall\\langle j,\\mathcal M,\\mathcal N\\rangle\\in\\mathcal E\\;\\left(\n\\mathrm{TransitiveSet}_S(\\mathrm{Univ}(\\mathcal M))\\land\\mathrm{TransitiveSet}_S(\\mathrm{Univ}(\\mathcal N))\\land |\\mathrm{Univ}(\\mathcal N)|&lt;\\delta\\right.\\\\\n&amp;\\qquad{}\\land\\mathrm{Model}_S(\\mathcal M,\\mathrm{ZFC}^{-},\\mathcal L_{\\in})\n\\land\\mathrm{ElementaryEmbedding}_S(j,\\mathcal M,\\mathcal N)\\\\\n&amp;\\qquad{}\\left.\\land\\operatorname{crit}(j)+1\\leq\\nu(\\langle j,\\mathcal M,\\mathcal N\\rangle)\\leq j(\\operatorname{crit}(j))\\right)\n\\end{aligned}\\right]\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}embedding\\text{-}system}\\vdash\n\\mathrm{WeakWoodinEmbeddingSystem}_S(\\delta,\\mathcal E,\\nu)\\leftrightarrow\n\\left[\\begin{aligned}\n&amp;\\mathrm{RegularCardinal}_S(\\delta)\\land\\omega_1\\leq\\delta\\land\n\\mathrm{Function}(\\nu,\\mathcal E,\\operatorname{ran}(\\nu))\\land\\forall\\xi\\in\\operatorname{ran}(\\nu)\\;\\mathrm{Ordinal}(\\xi)\\\\\n&amp;{}\\land\\forall\\langle j,\\mathcal M,\\mathcal N\\rangle\\in\\mathcal E\\;\\left(\n\\mathrm{TransitiveSet}_S(\\mathrm{Univ}(\\mathcal M))\\land\\mathrm{TransitiveSet}_S(\\mathrm{Univ}(\\mathcal N))\\land |\\mathrm{Univ}(\\mathcal N)|&lt;\\delta\\right.\\\\\n&amp;\\qquad{}\\land\\mathrm{Model}_S(\\mathcal M,\\mathrm{ZFC}^{-},\\mathcal L_{\\in})\n\\land\\mathrm{ElementaryEmbedding}_S(j,\\mathcal M,\\mathcal N)\\\\\n&amp;\\qquad{}\\left.\\land\\operatorname{crit}(j)+1\\leq\\nu(\\langle j,\\mathcal M,\\mathcal N\\rangle)\\leq j(\\operatorname{crit}(j))\\right)\n\\end{aligned}\\right]\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}witness}\\vdash\n\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E,\\nu)\\leftrightarrow\n\\mathrm{WeakWoodinEmbeddingSystem}_S(\\delta,\\mathcal E,\\nu)\\land\n\\forall A\\subseteq\\delta\\;\\exists\\kappa&lt;\\delta\\;\\forall\\alpha&lt;\\delta\\;\n\\exists\\langle j,\\mathcal M,\\mathcal N\\rangle\\in\\mathcal E\\;\\left[\n\\operatorname{crit}(j)=\\kappa\\land A\\cap\\kappa\\in\\mathrm{Univ}(\\mathcal M)\\land\nj(A\\cap\\kappa)\\cap\\alpha=A\\cap\\alpha\\right]\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}witness}\\vdash\n\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E,\\nu)\\leftrightarrow\n\\mathrm{WeakWoodinEmbeddingSystem}_S(\\delta,\\mathcal E,\\nu)\\land\n\\forall A\\subseteq\\delta\\;\\exists\\kappa&lt;\\delta\\;\\forall\\alpha&lt;\\delta\\;\n\\exists\\langle j,\\mathcal M,\\mathcal N\\rangle\\in\\mathcal E\\;\\left[\n\\operatorname{crit}(j)=\\kappa\\land A\\cap\\kappa\\in\\mathrm{Univ}(\\mathcal M)\\land\nj(A\\cap\\kappa)\\cap\\alpha=A\\cap\\alpha\\right]\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}existential\\text{-}strength\\text{-}map}\\vdash\n\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E)\\leftrightarrow\n\\exists\\nu\\;\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E,\\nu)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}existential\\text{-}strength\\text{-}map}\\vdash\n\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E)\\leftrightarrow\n\\exists\\nu\\;\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E,\\nu)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The target is an arbitrary transitive set <span class=\"math-inline\" data-tex=\"N\">\\(N\\)</span> of size below <span class=\"math-inline\" data-tex=\"\\delta\">\\(\\delta\\)</span>, not a rank segment <span class=\"math-inline\" data-tex=\"V_\\theta\">\\(V_\\theta\\)</span>.</li>\n<li>The strength map is a set function onto its set-sized range of ordinals, never a function into the proper class <span class=\"math-inline\" data-tex=\"\\operatorname{Ord}\">\\(\\operatorname{Ord}\\)</span>; embedding arguments are set-coded structures rather than bare carriers.</li>\n<li>The agreement clause and its quantifier order are exactly: for every <span class=\"math-inline\" data-tex=\"A\\subseteq\\delta\">\\(A\\subseteq\\delta\\)</span>, one critical point <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span> works for every <span class=\"math-inline\" data-tex=\"\\alpha&lt;\\delta\">\\(\\alpha&lt;\\delta\\)</span>, with the embedding allowed to depend on <span class=\"math-inline\" data-tex=\"\\alpha\">\\(\\alpha\\)</span>.</li>\n<li>By taking hulls, every regular <span class=\"math-inline\" data-tex=\"\\delta\\geq\\omega_1\">\\(\\delta\\geq\\omega_1\\)</span> has such a witness system; weak Woodinness in this sense is not a large-cardinal property.</li>\n</ul>\n<h2 id=\"Reference\">[Reference]</h2>\n<ul>\n<li>Castiblanco and Schindler, When is a real generic over L?, Mathematical Logic Quarterly 68 (2022), Definition 2.7</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2},{"id":"Reference","text":"[Reference]","level":2}],"links":[{"target":"58-df-regular-cardinal","status":"resolved","id":"0fbfc19800246e77","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-regular-cardinal]]","embed":false},{"target":"58-df-elementary-embedding","status":"resolved","id":"a25c0a66cf56c0f4","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-elementary-embedding]]","embed":false},{"target":"58-df-transitive-set","status":"resolved","id":"c14ba496c480dcd6","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-transitive-set]]","embed":false},{"target":"58-df-satisfaction","status":"resolved","id":"8b6a90316aad78a4","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-satisfaction]]","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-function]]","embed":false},{"target":"58-df-model","status":"resolved","id":"923884eb8fe4e61d","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-model]]","embed":false},{"target":"58-df-ordinal","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-7","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-ordinal]]","embed":false}],"math":[{"tex":"\\delta","display":false},{"tex":"\\mathcal E","display":false},{"tex":"\\langle j,\\mathcal M,\\mathcal N\\rangle","display":false},{"tex":"\\nu","display":false},{"tex":"\\mathcal E","display":false},{"tex":"\\mathrm{ZFC}^{-}","display":false},{"tex":"\\mathrm{RegularCardinal}_S","display":false},{"tex":"\\mathrm{ElementaryEmbedding}_S","display":false},{"tex":"\\mathrm{TransitiveSet}_S","display":false},{"tex":"\\mathrm{Model}_S","display":false},{"tex":"\\mathrm{Ordinal}","display":false},{"tex":"\\mathrm{Univ}","display":false},{"tex":"\\mathrm{Function}","display":false},{"tex":"\\mathcal L_{\\in}","display":false},{"tex":"\\mathrm{WeakWoodinEmbeddingSystem}_S","display":false},{"tex":"\\mathrm{WeaklyWoodinWitness}_S","display":false},{"tex":"\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}embedding\\text{-}system}\\vdash\n\\mathrm{WeakWoodinEmbeddingSystem}_S(\\delta,\\mathcal E,\\nu)\\leftrightarrow\n\\left[\\begin{aligned}\n&\\mathrm{RegularCardinal}_S(\\delta)\\land\\omega_1\\leq\\delta\\land\n\\mathrm{Function}(\\nu,\\mathcal E,\\operatorname{ran}(\\nu))\\land\\forall\\xi\\in\\operatorname{ran}(\\nu)\\;\\mathrm{Ordinal}(\\xi)\\\\\n&{}\\land\\forall\\langle j,\\mathcal M,\\mathcal N\\rangle\\in\\mathcal E\\;\\left(\n\\mathrm{TransitiveSet}_S(\\mathrm{Univ}(\\mathcal M))\\land\\mathrm{TransitiveSet}_S(\\mathrm{Univ}(\\mathcal N))\\land |\\mathrm{Univ}(\\mathcal N)|<\\delta\\right.\\\\\n&\\qquad{}\\land\\mathrm{Model}_S(\\mathcal M,\\mathrm{ZFC}^{-},\\mathcal L_{\\in})\n\\land\\mathrm{ElementaryEmbedding}_S(j,\\mathcal M,\\mathcal N)\\\\\n&\\qquad{}\\left.\\land\\operatorname{crit}(j)+1\\leq\\nu(\\langle j,\\mathcal M,\\mathcal N\\rangle)\\leq j(\\operatorname{crit}(j))\\right)\n\\end{aligned}\\right]","display":true},{"tex":"\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}witness}\\vdash\n\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E,\\nu)\\leftrightarrow\n\\mathrm{WeakWoodinEmbeddingSystem}_S(\\delta,\\mathcal E,\\nu)\\land\n\\forall A\\subseteq\\delta\\;\\exists\\kappa<\\delta\\;\\forall\\alpha<\\delta\\;\n\\exists\\langle j,\\mathcal M,\\mathcal N\\rangle\\in\\mathcal E\\;\\left[\n\\operatorname{crit}(j)=\\kappa\\land A\\cap\\kappa\\in\\mathrm{Univ}(\\mathcal M)\\land\nj(A\\cap\\kappa)\\cap\\alpha=A\\cap\\alpha\\right]","display":true},{"tex":"\\mathrm{df\\text{-}weakly\\text{-}woodin\\text{-}existential\\text{-}strength\\text{-}map}\\vdash\n\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E)\\leftrightarrow\n\\exists\\nu\\;\\mathrm{WeaklyWoodinWitness}_S(\\delta,\\mathcal E,\\nu)","display":true},{"tex":"N","display":false},{"tex":"\\delta","display":false},{"tex":"V_\\theta","display":false},{"tex":"\\operatorname{Ord}","display":false},{"tex":"A\\subseteq\\delta","display":false},{"tex":"\\kappa","display":false},{"tex":"\\alpha<\\delta","display":false},{"tex":"\\alpha","display":false},{"tex":"\\delta\\geq\\omega_1","display":false}],"bytes":3577,"backlinks":[{"id":"a11585cba9c21cfd","anchor":"ref-373","locations":["正文"],"count":1,"excerpt":"[[58-df-weakly-wodoin]]"},{"id":"84daad544872cc71","anchor":"ref-1383","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-weakly-wodoin.md|58-df-weakly-wodoin]]（batch15）"}],"outgoing":["0fbfc19800246e77","a25c0a66cf56c0f4","c14ba496c480dcd6","8b6a90316aad78a4","36d7463d215be751","923884eb8fe4e61d","5582a281f15a33c2"]}