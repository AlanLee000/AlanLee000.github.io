\rangle:n\\in\\omega\\},1)\\}.\n\\end{aligned}","display":true},{"tex":"T+\\alpha:=T\\cup\\{\\alpha\\},\\qquad T+\\neg\\alpha:=T\\cup\\{\\neg\\alpha\\}.","display":true},{"tex":"\\mu_U(\\varphi)=\n\\begin{cases}\n\\min\\{|\\pi|:\\operatorname{Proof}_{\\mathcal C}(U,\\pi,\\varphi)\\},&U\\vdash_{\\mathcal C}\\varphi,\\\\\n\\infty,&U\\nvdash_{\\mathcal C}\\varphi\n\\end{cases}\n\\quad(U\\in\\{T,T+\\alpha\\},\\ \\varphi\\in\\mathsf{Sent}).","display":true},{"tex":"\\neg\\exists f\\in\\mathrm{Rec}\\;\\forall\\varphi\\in\\mathsf{Sent}\\cap\\mathrm{Th}_{\\mathcal C}(T)\\;\n\\mu_T(\\varphi)\\leq f(\\mu_{T+\\alpha}(\\varphi)).","display":true},{"tex":"T+\\alpha\\vdash\\varphi","display":false},{"tex":"T","display":false},{"tex":"\\mu_T","display":false},{"tex":"T","display":false},{"tex":"\\psi","display":false},{"tex":"T+\\neg\\alpha\\vdash\\psi","display":false},{"tex":"T\\vdash\\alpha\\lor\\psi","display":false},{"tex":"T+\\alpha","display":false},{"tex":"T","display":false},{"tex":"T+\\neg\\alpha","display":false},{"tex":"S_1\\subseteq S_2","display":false}],"bytes":4648,"backlinks":[{"id":"4d85a6a31705a214","anchor":"ref-382","locations":["正文"],"count":1,"excerpt":"[[./72-thm-speed-up-theorem|thm-speed-up-theorem — Speed-up Theorem]]"}],"outgoing":["f5f45b7be0b2d491","d26f8820bf776b8c","f38fcd2964b78d6c"]}