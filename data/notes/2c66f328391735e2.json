\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"../batch17/58-df-ordinal.md\">../batch17/58-df-ordinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"L\">\\(L\\)</span> (constructible proper class, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"3743f726a3653802\" href=\"?note=3743f726a3653802\" title=\"../batch16/58-df-constructible.md\">../batch16/58-df-constructible.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{LCofinality}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{LCofinality}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}l\\text{-}cofinality} \\vdash \\mathrm{LCofinality}_S(\\kappa,\\lambda) \\leftrightarrow \\mathrm{Ordinal}(\\kappa)\\land\\mathrm{Ordinal}(\\lambda)\\land\\exists f\\in V\\;\\Bigl(f\\in L\\land\\mathrm{Function}(f,\\lambda,\\kappa)\\land\\forall\\alpha\\in\\kappa\\;\\exists\\xi\\in\\lambda\\;(\\alpha\\in f(\\xi)\\lor\\alpha=f(\\xi))\\Bigr)\\land\\forall\\mu\\in\\lambda\\;\\neg\\exists g\\in V\\;\\Bigl(g\\in L\\land\\mathrm{Function}(g,\\mu,\\kappa)\\land\\forall\\alpha\\in\\kappa\\;\\exists\\xi\\in\\mu\\;(\\alpha\\in g(\\xi)\\lor\\alpha=g(\\xi))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}l\\text{-}cofinality} \\vdash \\mathrm{LCofinality}_S(\\kappa,\\lambda) \\leftrightarrow \\mathrm{Ordinal}(\\kappa)\\land\\mathrm{Ordinal}(\\lambda)\\land\\exists f\\in V\\;\\Bigl(f\\in L\\land\\mathrm{Function}(f,\\lambda,\\kappa)\\land\\forall\\alpha\\in\\kappa\\;\\exists\\xi\\in\\lambda\\;(\\alpha\\in f(\\xi)\\lor\\alpha=f(\\xi))\\Bigr)\\land\\forall\\mu\\in\\lambda\\;\\neg\\exists g\\in V\\;\\Bigl(g\\in L\\land\\mathrm{Function}(g,\\mu,\\kappa)\\land\\forall\\alpha\\in\\kappa\\;\\exists\\xi\\in\\mu\\;(\\alpha\\in g(\\xi)\\lor\\alpha=g(\\xi))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The value is the least ordinal length of a constructible cofinal map into <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span>; no satisfaction relation is applied to the proper class <span class=\"math-inline\" data-tex=\"L\">\\(L\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch16/58-df-constructible.md","status":"resolved","id":"3743f726a3653802","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-constructible.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\