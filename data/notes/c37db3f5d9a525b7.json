{"id":"c37db3f5d9a525b7","group":"27","path":"27/27-df-partialorder.md","title":"Boolean-cube order","display":"df-partialorder — Boolean-cube order","type":"definition","metadata":{"type":"definition","book":"Boolean Functions: Theory, Algorithms, and Applications","book_abbrev":"27","label":"27-df-partialorder","aliases":["27-df-partialorder"],"display":"df-partialorder — Boolean-cube order","depends_on":["[[27-df-vardom]]"],"local_review_status":"2026-10-20-formalization-reviewed-source-text-not-rechecked"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Boolean Functions: Theory, Algorithms, and Applications"},{"key":"book_abbrev","html":"27"},{"key":"label","html":"27-df-partialorder"},{"key":"aliases","html":"<div class=\"property-array\"><span>27-df-partialorder</span></div>"},{"key":"display","html":"df-partialorder — Boolean-cube order"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4b84ee77aaf0c828\" href=\"?note=4b84ee77aaf0c828\" title=\"27-df-vardom\">27-df-vardom</a></span></div>"},{"key":"local_review_status","html":"2026-10-20-formalization-reviewed-source-text-not-rechecked"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"n\\in\\mathbb N\">\\(n\\in\\mathbb N\\)</span>。</li>\n<li><span class=\"math-inline\" data-tex=\"x,y\\in\\mathbb{B}^{n}\">\\(x,y\\in\\mathbb{B}^{n}\\)</span> (Boolean vectors, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"4b84ee77aaf0c828\" href=\"?note=4b84ee77aaf0c828\" title=\"27-df-vardom\">27-df-vardom</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"x\\preceq y\\leftrightarrow\\forall i\\in\\{1,\\ldots,n\\}\\,(x_i\\leq y_i)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[x\\preceq y\\leftrightarrow\\forall i\\in\\{1,\\ldots,n\\}\\,(x_i\\leq y_i)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"(\\mathbb{B}^{n},\\preceq)\">\\((\\mathbb{B}^{n},\\preceq)\\)</span> is the product order on the Boolean cube.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"27-df-vardom","status":"resolved","id":"4b84ee77aaf0c828","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[27-df-vardom]]","embed":false},{"target":"27-df-vardom","status":"resolved","id":"4b84ee77aaf0c828","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$x,y\\in\\mathbb{B}^{n}$ (Boolean vectors, see [[27-df-vardom]])","embed":false}],"attachments":[],"math":[{"tex":"n\\in\\mathbb N","display":false},{"tex":"x,y\\in\\mathbb{B}^{n}","display":false},{"tex":"x\\preceq y\\leftrightarrow\\forall i\\in\\{1,\\ldots,n\\}\\,(x_i\\leq y_i)","display":true},{"tex":"(\\mathbb{B}^{n},\\preceq)","display":false}],"bytes":653,"backlinks":[{"id":"640eb8f2fbffd9d9","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"5244dbb38da17b8a","anchor":"ref-277","locations":["正文"],"count":1,"excerpt":"[[27-df-partialorder|df-partialorder — Boolean-cube order]]"}],"outgoing":["4b84ee77aaf0c828"]}