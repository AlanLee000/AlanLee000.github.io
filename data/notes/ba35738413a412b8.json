ppa_0\\rangle.","display":true},{"tex":"d_2:=\\iota w\\in\\operatorname{Hom}_{\\mathcal E}(2,2\\times2)\\;\\left(w\\circ\\kappa_0=\\langle\\kappa_0,\\kappa_1\\rangle\\land w\\circ\\kappa_1=\\langle\\kappa_1,\\kappa_0\\rangle\\right),\\qquad D_2:=\\operatorname{Im}(d_2).","display":true},{"tex":"C_s:=\\langle t\\circ s\\circ q\\circ i_0,t\\circ s\\circ q\\circ i_1\\rangle^{-1}(D_2)\\in\\operatorname{Sub}_{\\mathcal E}(E).","display":true},{"tex":"\\operatorname{IsEpi}(q)\\land\\operatorname{IsEqualizer}_{\\mathcal E}(A,m,q\\circ i_0,q\\circ i_1).","display":true},{"tex":"\\forall s:Q\\to B\\quad\\bigl(q\\circ s=1_Q\\Rightarrow[m]\\wedge_E C_s=\\bot_E\\land[m]\\vee_E C_s=\\top_E\\bigr).","display":true},{"tex":"E+E","display":false},{"tex":"[\\top!_E,\\chi_m]:E+E\\to\\Omega","display":false},{"tex":"i_0m,i_1m","display":false},{"tex":"q","display":false},{"tex":"qi_0x=qi_1x","display":false},{"tex":"\\top! =\\chi_mx","display":false},{"tex":"x","display":false},{"tex":"m","display":false},{"tex":"qs=1","display":false},{"tex":"m","display":false},{"tex":"sqi_0,sqi_1","display":false},{"tex":"[1_E,1_E]:B\\to E","display":false},{"tex":"q","display":false},{"tex":"E","display":false},{"tex":"B\\cong E\\times2","display":false},{"tex":"t","display":false},{"tex":"2\\times2","display":false},{"tex":"D_2","display":false},{"tex":"[m]","display":false},{"tex":"C_s","display":false},{"tex":"m","display":false}],"bytes":3349,"backlinks":[{"id":"c53146be63465990","anchor":"ref-159","locations":["正文"],"count":1,"excerpt":"[[14-thm-double-copy-gluing-complement|thm-247 — 双拷贝胶合与子对象的补]]"},{"id":"af8af33cef1d96d9","anchor":"ref-109","locations":["正文"],"count":1,"excerpt":"[[14-thm-double-copy-gluing-complement]]"},{"id":"4741fef73eb1a614","anchor":"ref-266","locations":["正文"],"count":1,"excerpt":"[[14-thm-double-copy-gluing-complement]]"},{"id":"ffda0c0482667c45","anchor":"ref-188","locations":["正文"],"count":2,"excerpt":"[[14-thm-double-copy-gluing-complement]]"},{"id":"c60ad289d123497b","anchor":"ref-160","locations":["正文"],"count":1,"excerpt":"[[14-thm-double-copy-gluing-complement|thm-247 — 双拷贝胶合与子对象的补]]"},{"id":"1d4177d202e67eb5","anchor":"ref-12","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"固定任意 $m:A\\hookrightarrow X$，取[[14-thm-double-copy-gluing-complement]]的胶合满态射 $q:X+X\\twoheadrightarrow Q$。[[14-thm-internal-choice-local-sections]]给覆盖 $e:U\\twoheadrightarrow1$，使 $q\\times1_U$ 有截面。乘以 $U$ 是指数函子的左伴随，因而保持该余等化子及余积；故[[14-thm-double-copy-gluing-complement]]应用于 $m\\times1_U:A\\times U\\hookrightarrow X\\times U$，得到这个拉回子对象可补，即满足排中律。"}],"outgoing":["0f4ff76187675015","4e6c05c92e3b9bf9","4f584a450845e8d6","a0c7f4bf5e51d4b5","199dc3cf97e92fa1","1289398555ba3eed","4cd3b0d29b80beda","8e7f6de1ab6fc49f"]}