\\langle\\gamma,\\delta\\rangle),z\\rangle)\n=a(\\langle\\gamma,a(\\langle\\delta,z\\rangle)\\rangle)\n\\bigr)\\\\\n&{}\\land\\forall\\gamma\\in\\Gamma\\;\\forall z\\in\\mathbb H\\;\n\\bigl(a(\\langle\\gamma,z\\rangle)\\in\\mathbb H\\bigr)\\\\\n&{}\\land Y_\\Gamma=\n\\bigl\\{\\{a(\\langle\\gamma,z\\rangle):\\gamma\\in\\Gamma\\}:z\\in\\mathbb H\\bigr\\}\\\\\n&{}\\land X_\\Gamma=\n\\bigl\\{\\{a(\\langle\\gamma,z\\rangle):\\gamma\\in\\Gamma\\}:z\\in Z^\\ast\\bigr\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}modular\\text{-}curve\\text{-}cusps}\\vdash\n\\operatorname{Cusps}_a(\\Gamma)\n\\coloneqq\n\\bigl\\{\\{a(\\langle\\gamma,c\\rangle):\\gamma\\in\\Gamma\\}:c\\in\\mathbb P^1(\\mathbb Q)\\bigr\\}.","display":true},{"tex":"\\mathrm{FiniteIndex}_S","display":false},{"tex":"\\mathrm{FiniteIndexSubgroup}_S","display":false},{"tex":"a","display":false}],"bytes":2650,"backlinks":[{"id":"32927f4e222d9c70","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$X_0(N)$ denotes the modular curve supplied by the orbit presentation in [[58-df-modular-curve]]."},{"id":"ca5920196b4108bd","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-853","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-modular-curve.md|58-df-modular-curve]]（batch10）"}],"outgoing":["dbeb6e7ed5730d0f","c27bfe92f372d3ac","ed71f39f59370734","36d7463d215be751"]}