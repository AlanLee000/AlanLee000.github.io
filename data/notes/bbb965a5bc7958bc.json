0ec8b0\" href=\"?note=f02ce1cb4d0ec8b0\" title=\"../batch02/58-df-zfc-card6-countable-set.md\">../batch02/58-df-zfc-card6-countable-set.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcSetCountableSupport}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcSetCountableSupport}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}set\\text{-}countable\\text{-}support} \\vdash\n\\mathrm{ZfcSetCountableSupport}_S(f,0)\n\\leftrightarrow\n\\mathrm{Function}(f,\\operatorname{dom}(f),\\operatorname{ran}(f))\n\\land\\mathrm{ZfcCard6CountableSet}_S\n\\bigl(\\{x\\in\\operatorname{dom}(f):f(x)\\neq0\\}\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}set\\text{-}countable\\text{-}support} \\vdash\n\\mathrm{ZfcSetCountableSupport}_S(f,0)\n\\leftrightarrow\n\\mathrm{Function}(f,\\operatorname{dom}(f),\\operatorname{ran}(f))\n\\land\\mathrm{ZfcCard6CountableSet}_S\n\\bigl(\\{x\\in\\operatorname{dom}(f):f(x)\\neq0\\}\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Functionhood and countability now use the canonical predicates with explicit arguments.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor