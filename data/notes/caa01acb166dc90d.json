x\\in a\\}\\in U\\bigr)\\right]\\land\n\\left[\\forall f\\in V\\;\\Bigl(\\mathrm{Function}(f,P,X)\\land\n\\{a\\in P\\mid f(a)\\in a\\}\\in U\\to\n\\exists x\\in X\\;\\bigl(\\{a\\in P\\mid f(a)=x\\}\\in U\\bigr)\n\\Bigr)\\right]\\Bigr]\n\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}normal\\text{-}fine\\text{-}measure} \\vdash\n\\mathrm{ZfcLargecard4NormalFineMeasure}_S(X,\\kappa,U)\\leftrightarrow\n\\left(\n\\mathrm{Cardinal}_S(\\kappa)\\land\\omega&lt;\\kappa\\land\n\\exists P\\in V\\;\\Bigl[\nP=\\{a\\subseteq X\\mid |a|&lt;\\kappa\\}\\land\n\\mathrm{Ultrafilter}_S(U,P)\\land\n\\left[\\forall\\delta\\in\\kappa\\setminus\\{0\\}\\;\\forall A\\in V\\;\\left(\\mathrm{Function}(A,\\delta,U)\\to\\bigcap\\operatorname{ran}(A)\\in U\\right)\\right]\\land\n\\left[\\forall x\\in X\\;\\bigl(\\{a\\in P\\mid x\\in a\\}\\in U\\bigr)\\right]\\land\n\\left[\\forall f\\in V\\;\\Bigl(\\mathrm{Function}(f,P,X)\\land\n\\{a\\in P\\mid f(a)\\in a\\}\\in U\\to\n\\exists x\\in X\\;\\bigl(\\{a\\in P\\mid f(a)=x\\}\\in U\\bigr)\n\\Bigr)\\right]\\Bigr]\n\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The carrier <span class=\"math-inline\" data-tex=\"P=[X]^{&lt;\\kappa}\">\\(P=[X]^{&lt;\\kappa}\\)</span> is existentially bound, and every sequence or regressive map is a set function with an explicit domain and codomain.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch14/58-df-ultrafilter.md","status":"resolved","id":"5e8b8d97b21dd8e8","anchor":"ref-2","targ