\\vee_Iu^*T\\\\\n&\\quad\\land(\\exists 0\\in\\operatorname{Ob}\\mathcal B)\\bigl[\n(\\forall X\\in\\operatorname{Ob}\\mathcal B)(\\exists!h\\in\\mathcal B(0,X))\\ \\top\\\\\n&\\hspace{39mm}\\land(\\forall X\\in\\operatorname{Ob}\\mathcal B)\n(\\forall h\\in\\mathcal B(X,0))\\ \\mathrm{Iso}_{\\mathcal B}(h)\\bigr].\n\\end{aligned}","display":true},{"tex":"\\exists(S\\vee T)","display":false},{"tex":"0","display":false},{"tex":"0","display":false}],"bytes":2419,"backlinks":[{"id":"3c6838a8712c10ec","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathcal B$ 为范畴，$\\mathrm{CohCat}$ 见 [[16-df-coherent-category]]，$\\mathrm{CohCat}_{df}$ 为旧拼写。"},{"id":"8e14b2a12eb3841f","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"1bdcb9b14f83cac1","anchor":"ref-26","locations":["正文"],"count":2,"excerpt":"[[16-df-function]]、[[16-df-formula]]、[[16-df-provable]]、[[16-df-satisfaction]]、[[16-df-validity-fo]]、[[16-df-type-interpretation]]、[[16-df-general-quantifier]]、[[16-df-beck-chevalley]]、[[16-df-frobenius]]、[[16-df-regular-category]]、[[16-df-coherent-category]]、[[16-df-first-order-fibration]]、[[16-df-higher-order-fibration]]。"}],"outgoing":["8727007e6f227c84","6c23c06c4d297e8d","dacf0503b95c88a9"]}