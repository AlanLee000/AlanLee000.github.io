q0})\\land\n\\exists0_X\\in X\\;\\Bigl(\\forall x\\in X\\;(0_X+_Xx=x)\\land\n\\forall x,y\\in X\\;\\forall\\alpha\\in\\mathbb F\\;\\Bigl[(\\|x\\|=0\\leftrightarrow x=0_X)\\land\n\\|\\alpha\\odot x\\|=|\\alpha|\\,\\|x\\|\\land\\|x+_Xy\\|\\leq\\|x\\|+\\|y\\|\\bigr]\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}norm\\text{-}alias}\\vdash\n\\mathrm{NormedCarrier}_S(\\|\\cdot\\|,X)\\leftrightarrow\n\\exists\\mathbb F,+_X,\\odot\\in V\\;\\mathrm{Norm}_S(\\|\\cdot\\|,X,\\mathbb F,+_X,\\odot)","display":true},{"tex":"\\mathrm{df\\text{-}norm\\text{-}metric}\\vdash\n\\mathrm{NormMetric}_S(d,\\|\\cdot\\|,X,\\mathbb F,+_X,\\odot)\\leftrightarrow\n\\mathrm{Norm}_S(\\|\\cdot\\|,X,\\mathbb F,+_X,\\odot)\\land\\mathrm{MetricSpace}_S(X,d)\\land\n\\forall x,y\\in X\\;d(x,y)=\\|x+_X((-1_{\\mathbb F})\\odot y)\\|","display":true},{"tex":"\\mathrm{NormedCarrier}_S","display":false},{"tex":"\\mathrm{Norm}_S","display":false},{"tex":"L^p","display":false},{"tex":"\\|f\\|_p = (\\int |f|^p)^{1/p}","display":false},{"tex":"\\|A\\| = \\sup_{\\|x\\| \\leq 1} \\|Ax\\|","display":false}],"bytes":2443,"backlinks":[{"id":"2ad9c248fe18df37","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\mathrm{Norm}_S:V^5\\to\\{\\top,\\bot\\}$ and $\\mathrm{Norm}_S(\\|\\cdot\\|_X,X,\\mathbb F,+_X,\\odot_X)$ (see [[58-df-norm]])"},{"id":"84daad544872cc71","anchor":"ref-882","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-norm.md|58-df-norm]]（batch19）"}],"outgoing":["592f9cfb66a507c2","ce876585d129ce97","36d7463d215be751"]}