\\}&\\vdash\n\\bigl(\\neg\\mathrm{Prov}_T(\\overline{g(R)})\\land\n\\neg\\mathrm{Prov}_T(\\overline{g(\\neg R)})\\bigr),\\\\\n\\mathrm{PA}\\cup\\{\\mathrm{Con}_T\\}&\\vdash\n\\bigl(\\mathrm{Con}_{T+R}\\land\\mathrm{Con}_{T+\\neg R}\\bigr).\n\\end{aligned}","display":true},{"tex":"T\\supseteq Q","display":false},{"tex":"\\Sigma_1","display":false},{"tex":"\\mathrm{Prov}_T(R)\\to\\mathrm{Prov}_T(\\neg R)","display":false},{"tex":"\\mathrm{Con}_T","display":false}],"bytes":4048,"backlinks":[{"id":"aceae1bb446510ab","anchor":"ref-128","locations":["正文"],"count":1,"excerpt":"[[../67-thm-formalized-rosser]]"}],"outgoing":["cd051851df5d2aa2","a0cb59478595f5c6","d404f437f90ff5f6","8c48c66841a15eb9","1e05755479add015","a329235da6144513","189f5355af0e487c","3fa0d0f598b791bc","6a4c234306a0ec0c"]}