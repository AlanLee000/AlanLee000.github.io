bb Q}\\subseteq\\mathbb Q\\times\\mathbb Q\">\\(\\leq_{\\mathbb Q}\\subseteq\\mathbb Q\\times\\mathbb Q\\)</span> (order on <span class=\"math-inline\" data-tex=\"\\mathbb Q\">\\(\\mathbb Q\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcing3QuotientCondition}_S\">\\(\\mathrm{ZfcForcing3QuotientCondition}_S\\)</span> (quotient-condition predicate, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"22210d7f6452febc\" href=\"?note=22210d7f6452febc\" title=\"../batch12/58-df-zfc-forcing3-quotient-condition.md\">../batch12/58-df-zfc-forcing3-quotient-condition.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{PartialOrder}_S\">\\(\\operatorname{PartialOrder}_S\\)</span> (order predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"2aa29158e60b337f\" href=\"?note=2aa29158e60b337f\" title=\"../batch12/58-df-order.md\">../batch12/58-df-order.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcing3QuotientOrder}_S\\subseteq V^6\">\\(\\mathrm{ZfcForcing3QuotientOrder}_S\\subseteq V^6\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing3\\text{-}quotient\\text{-}order} \\vdash \\mathrm{ZfcForcing3QuotientOrder}_S(\\mathbb P,\\mathbb Q,M,G,\\leq_{\\mathbb Q},\\leq_{\\mathbb Q/G})\\leftrightarrow \\exists Q_G\\;(Q_G=\\{q\\in\\mathbb Q:\\mathrm{ZfcForcing3QuotientCondition}_S(\\mathbb P,\\leq_{\\mathbb Q}\\cap(\\mathbb P\\times\\mathbb P),\\mathbb Q,\\leq_{\\mathbb Q},M,G,q)\\}\\land \\leq_{\\mathbb Q/G}=\\leq_{\\mathbb Q}\\cap(Q_G\\times Q_G)\\land \\operatorname{PartialOrder}_S(\\leq_{\\mathbb Q/G},Q_G))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing3\\text{-}quotient\\text{-}order} \\vdash \\mathrm{ZfcForcing3QuotientOrder}_S(\\mathbb P,\\mathbb Q,M,G,\\leq_{\\mathbb Q},\\leq_{\\mathbb Q/G})\\leftrightarrow \\exists Q_G\\;(Q_G=\\{q\\in\\mathbb Q:\\mathrm{ZfcForcing3QuotientCondition}_S(\\mathbb P,\\leq_{\\mathbb Q}\\cap(\\mathbb P\\times\\mathbb P),\\mathbb Q,\\leq_{\\mathbb Q},M,G,q)\\}\\land \\leq_{\\mathbb Q/G}=\\leq_{\\mathbb Q}\\cap(Q_G\\times Q_G)\\land \\operatorname{PartialOrder}_S(\\leq_{\\mathbb Q/G},Q_G))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch12/58-df-zfc-forcing3-quotient-condition.md","status":"resolved","id":"22210d7f6452febc","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-zfc-forcing3-quotient-condition.md]]","embed":false},{"target":"../batch12/58-df-order.md","status":"resolved","id":"2aa29158e60b337f","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-order.md]]","embed":false},{"target":"../batch12/58-df-zfc-forcing3-quotient-condition.md","status":"resolved","id":"22210d7f6452febc","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcForcing3QuotientCondition}_S$ (quotient-condition predicate, see [[../batch12/58-df-zfc-forcing3-quotient-condition.md]])","embed":false},{"target":"../batch12/58-df-order.md","status":"resolved","id":"2aa29158e60b337f","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{PartialOrder}_S$ (order predicate, see [[../batch12/58-df-order.md]])","embed":false}],"math":[{"tex":"\\mathbb P,\\mathbb Q,M,G,