","display":false},{"tex":"\\mathcal C=\\langle Q,\\mathsf{Ax},\\mathsf R\\rangle","display":false},{"tex":"\\mathsf R","display":false},{"tex":"\\mathsf{cut}","display":false},{"tex":"\\mathrm{Logic}_\\Sigma:=\\operatorname{LeftRules}_{\\mathsf{LK}}\\cup\\operatorname{RightRules}_{\\mathsf{LK}},\\qquad\\widehat{\\mathrm{Logic}}_\\Sigma:=\\bigcup_{R\\in\\mathcal J}\\operatorname{Lift}_{t_R}(R)\\cup\\widehat{\\forall R}\\cup\\widehat{\\exists L}.","display":true},{"tex":"\\operatorname{Rules}(\\langle Q,\\mathsf{Ax},\\mathsf R\\rangle):=\\mathsf R,\\qquad\\operatorname{Ax}(\\langle Q,\\mathsf{Ax},\\mathsf R\\rangle):=\\mathsf{Ax}.","display":true},{"tex":"\\mathrm{LK}^{-}_\\Sigma:=\\langle\\mathrm{Seq}(\\Sigma),\\mathrm{Ax}_\\Sigma,\\widehat{\\mathrm{Struct}}_\\Sigma\\cup\\widehat{\\mathrm{Logic}}_\\Sigma\\rangle.","display":true},{"tex":"\\langle Q,\\mathsf{Ax},\\mathsf R\\rangle+\\mathcal U:=\\langle Q,\\mathsf{Ax},\\mathsf R\\cup\\{r\\in\\mathcal U:\\operatorname{Seqs}(r)\\subseteq Q\\}\\rangle,\\qquad\\mathrm{LK}_\\Sigma:=\\mathrm{LK}^{-}_\\Sigma+\\widehat{\\mathrm{Cut}}_\\Sigma.","display":true},{"tex":"Q_1:=\\{\\langle\\Gamma,\\Delta\\rangle\\in\\mathrm{Seq}(\\Sigma):|\\Delta|\\le1\\},\\qquad\\mathrm{Seq}_{\\le1}(\\Sigma):=Q_1.","display":true},{"tex":"\\begin{aligned}\n(\\lor R)_1&:=\\{\\operatorname{UInf}(\\Gamma\\Rightarrow_\\Sigma\\langle A\\rangle,\\Gamma\\Rightarrow_\\Sigma\\langle A\\lor B\\rangle):\\Gamma\\in\\operatorname{CtxSeq}_\\Sigma,A,B\\in X_\\Sigma\\},\\\\\n(\\lor R)_2&:=\\{\\operatorname{UInf}(\\Gamma\\Rightarrow_\\Sigma\\langle B\\rangle,\\Gamma\\Rightarrow_\\Sigma\\langle A\\lor B\\rangle):\\Gamma\\in\\operatorname{CtxSeq}_\\Sigma,A,B\\in X_\\Sigma\\},\\\\\n\\mathsf R_J&:=\\{r\\in\\widehat{\\mathrm{Struct}}_\\Sigma\\cup\\widehat{\\mathrm{Logic}}_\\Sigma:\\operatorname{Seqs}(r)\\subseteq Q_1\\}\\\\\n&\\quad\\cup\\operatorname{Lift}_{\\mathsf{\\lor R_1}}((\\lor R)_1)\\cup\\operatorname{Lift}_{\\mathsf{\\lor R_2}}((\\lor R)_2),\\\\\n\\mathrm{LJ}