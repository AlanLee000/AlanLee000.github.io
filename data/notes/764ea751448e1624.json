{"id":"764ea751448e1624","group":"58","path":"58/batch01/58-df-zfc-graph-bipartite-graph.md","title":"ZFC Graph Bipartite Graph","display":"df-zfc-graph-bipartite-graph — ZFC Graph Bipartite Graph","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-graph-bipartite-graph","aliases":["58-df-zfc-graph-bipartite-graph"],"display":"df-zfc-graph-bipartite-graph — ZFC Graph Bipartite Graph","depends_on":["[[../batch02/58-ax-zfc.md]]","[[../batch03/58-df-graph.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-graph-bipartite-graph"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-graph-bipartite-graph</span></div>"},{"key":"display","html":"df-zfc-graph-bipartite-graph — ZFC Graph Bipartite Graph"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"0dc79ccc1050ee64\" href=\"?note=0dc79ccc1050ee64\" title=\"../batch03/58-df-graph.md\">../batch03/58-df-graph.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"G,A,B,V_G,E_G\\in V\">\\(G,A,B,V_G,E_G\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcGraphBipartiteGraph}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcGraphBipartiteGraph}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Graph}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Graph}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"0dc79ccc1050ee64\" href=\"?note=0dc79ccc1050ee64\" title=\"../batch03/58-df-graph.md\">../batch03/58-df-graph.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}graph\\text{-}bipartite\\text{-}graph}\\vdash \\mathrm{ZfcGraphBipartiteGraph}_S(G,A,B)\\leftrightarrow \\exists V_G,E_G\\in V\\;\\left(G=\\langle V_G,E_G\\rangle\\land\\mathrm{Graph}_S(G)\\land V_G=A\\cup B\\land A\\cap B=\\varnothing\\land E_G\\subseteq\\{\\{a,b\\}\\mid a\\in A\\land b\\in B\\}\\right).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}graph\\text{-}bipartite\\text{-}graph}\\vdash \\mathrm{ZfcGraphBipartiteGraph}_S(G,A,B)\\leftrightarrow \\exists V_G,E_G\\in V\\;\\left(G=\\langle V_G,E_G\\rangle\\land\\mathrm{Graph}_S(G)\\land V_G=A\\cup B\\land A\\cap B=\\varnothing\\land E_G\\subseteq\\{\\{a,b\\}\\mid a\\in A\\land b\\in B\\}\\right).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch03/58-df-graph.md","status":"resolved","id":"0dc79ccc1050ee64","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch03/58-df-graph.md]]","embed":false},{"target":"../batch03/58-df-graph.md","status":"resolved","id":"0dc79ccc1050ee64","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Graph}_S:V\\to\\{\\top,\\bot\\}$ (see [[../batch03/58-df-graph.md]])","embed":false}],"math":[{"tex":"G,A,B,V_G,E_G\\in V","display":false},{"tex":"\\mathrm{ZfcGraphBipartiteGraph}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Graph}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}graph\\text{-}bipartite\\text{-}graph}\\vdash \\mathrm{ZfcGraphBipartiteGraph}_S(G,A,B)\\leftrightarrow \\exists V_G,E_G\\in V\\;\\left(G=\\langle V_G,E_G\\rangle\\land\\mathrm{Graph}_S(G)\\land V_G=A\\cup B\\land A\\cap B=\\varnothing\\land E_G\\subseteq\\{\\{a,b\\}\\mid a\\in A\\land b\\in B\\}\\right).","display":true}],"bytes":926,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2232","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-graph-bipartite-graph.md|58-df-zfc-graph-bipartite-graph]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","0dc79ccc1050ee64"]}