\\Gamma,\\mathrm{blank}","display":false},{"tex":"u,w\\in\\mathbf2^*","display":false},{"tex":"\\operatorname{out}(M(w))\\downarrow=u","display":false},{"tex":"U(\\langle M,w\\rangle)=M(w)","display":false},{"tex":"M\\in\\mathcal D_{\\mathsf{TM}}","display":false},{"tex":"U","display":false},{"tex":"M","display":false},{"tex":"\\mathrm{thm\\text{-}4.1}\\vdash\n\\langle M,w\\rangle\\coloneqq\\langle\\ulcorner M\\urcorner_{\\mathcal E},w\\rangle_{\\mathcal E}\\quad(M\\in\\mathcal D_{\\mathsf{TM}},\\ w\\in\\mathbf2^*)","display":true},{"tex":"\\mathrm{thm\\text{-}4.1}\\vdash\n\\operatorname{out}(M(w))\\downarrow=u\\leftrightarrow\n\\exists C\\in\\operatorname{Conf}_M\\;\n\\Bigl(C_M^{\\mathsf{init}}(w)\\to_M^*C\\land\\operatorname{Halting}_M(C)\n\\land\\bigl(\\forall i\\in\\{j\\in\\mathbb N:j<|u|\\}\\;(\\pi_2(C))(i)=u(i)\\bigr)\n\\land\\bigl(\\forall i\\in\\mathbb Z\\setminus\\{j\\in\\mathbb N:j<|u|\\}\\;(\\pi_2(C))(i)=\\mathrm{blank}\\bigr)\\Bigr)","display":true},{"tex":"\\mathrm{thm\\text{-}4.1}\\vdash\n\\exists U\\in\\mathcal D_{\\mathsf{TM}}\\;\\forall M\\in\\mathcal D_{\\mathsf{TM}}\\;\\forall w\\in\\mathbf2^*\\;\n\\bigl((\\operatorname{Accept}_U(\\langle M,w\\rangle)\\leftrightarrow\\operatorname{Accept}_M(w))\n\\land(\\operatorname{Reject}_U(\\langle M,w\\rangle)\\leftrightarrow\\operatorname{Reject}_M(w))\n\\land(\\operatorname{Halts}_U(\\langle M,w\\rangle)\\leftrightarrow\\operatorname{Halts}_M(w))\n\\land\\forall u\\in\\mathbf2^*\\;(\\operatorname{out}(U(\\langle M,w\\rangle))\\downarrow=u\n\\leftrightarrow\\operatorname{out}(M(w))\\downarrow=u)\\bigr)","display":true}],"bytes":4028,"backlinks":[{"id":"6af52783a9bce985","anchor":"ref-241","locations":["正文"],"count":1,"excerpt":"[[73-thm-universal-tm-simulation|universal tm simulation]]"}],"outgoing":["db96cabedd089e5f","8630ed136c8dde2d","17b3325184317072","888d8ab66ec7efca","b9e8acd6d8438a5d"]}