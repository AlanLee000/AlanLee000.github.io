","display":false},{"tex":"\\mathrm{Sent}_{L'}","display":false},{"tex":"\\mathrm{Form}_{L,n}","display":false},{"tex":"n","display":false},{"tex":"\\operatorname{Mod}(T')","display":false},{"tex":"\\mathrm{Assign}","display":false},{"tex":"\\operatorname{Sat}_L","display":false},{"tex":"\\begin{aligned}\n\\quad\n&L,L'\\in\\mathrm{FirstOrderLanguages}\n\\land\n\\mathrm{Const}_{L'}=\\mathrm{Const}_L\n\\land\\forall k\\in\\omega\\;(\\mathrm{Func}_{L',k}=\\mathrm{Func}_{L,k})\n\\\\\n&\\land R\\notin\\mathrm{Const}_L\\cup\\bigcup_{k\\in\\omega}(\\mathrm{Func}_{L,k}\\cup\\mathrm{Rel}_{L,k})\n\\land\\mathrm{Rel}_{L',n}=\\mathrm{Rel}_{L,n}\\cup\\{R\\}\n\\\\\n&\\land\\forall k\\in\\omega\\;(k\\neq n\\to\\mathrm{Rel}_{L',k}=\\mathrm{Rel}_{L,k})\n\\land\nT'\\subseteq\\mathrm{Sent}_{L'}\n\\\\\n&\\to\n\\Biggl[\n\\forall\\mathfrak A,\\mathfrak B\\in\\operatorname{Mod}(T')\\;\n\\Bigl(\n\\mathfrak A\\!\\upharpoonright L\n=\n\\mathfrak B\\!\\upharpoonright L\n\\to\nR^{\\mathfrak A}=R^{\\mathfrak B}\n\\Bigr)\n\\\\\n&\\quad\\leftrightarrow\n\\exists\\varphi\\in\\mathrm{Form}_{L,n}\\;\n\\forall\\mathfrak A\\in\\operatorname{Mod}(T')\\;\n\\forall\\bar a\\in|\\mathfrak A|^n\\;\n\\forall s\\in\\mathrm{Assign}(|\\mathfrak A|)\n\\\\\n&\\hspace{17mm}\n\\Bigl(\n\\forall i<n\\;(s(x_i)=\\bar a(i))\n\\to\n\\bigl[\n\\bar a\\in R^{\\mathfrak A}\n\\leftrightarrow\n\\operatorname{Sat}_L\n(\\mathfrak A\\!\\upharpoonright L,s,\\varphi)\n\\bigr]\n\\Bigr)\n\\Biggr].\n\\end{aligned}","display":true},{"tex":"R","display":false},{"tex":"L","display":false},{"tex":"L","display":false}],"bytes":3487,"backlinks":[{"id":"a56231382327ecde","anchor":"ref-9","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"2c98c9e634ff4b44","anchor":"ref-157","locations":["正文"],"count":1,"excerpt":"[[17-thm-aleph-one-categoricity-consequences]]\n[[17-thm-atomic-model-existence]]\n[[17-thm-beth-definability]]\n[[17-thm-beth-definability-satisfaction-form]]\n[[17-thm-chain-sentence-preservation]]\n[[17-thm-chain-the