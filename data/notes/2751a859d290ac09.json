forall i\\in\\mathbb Z\\;(y(i)=x(i+1))\\}\\\\\n&\\to\\mathrm{Ergodic}_S(\\sigma_A,\\mu_\\alpha,A^{\\mathbb Z},\\Sigma_A)\n\\land\\exists h\\;\\Bigl(\n\\mathrm{ZfcMeasure9KolmogorovSinaiEntropy}_S(h,\\sigma_A,A^{\\mathbb Z},\\Sigma_A,\\mu_\\alpha)\n\\land h=-\\sum_{a\\in A}\\alpha(a)\\log\\alpha(a)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathbb Z","display":false}],"bytes":2639,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3933","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-prop-bernoulli-shift.md|58-prop-bernoulli-shift]]（batch19）"}],"outgoing":["36d7463d215be751","18ad6e37d70b294d","8306a79d3c8e988a","11a66aa01f6e941d","8bad3810e4165411"]}