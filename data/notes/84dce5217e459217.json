C\\\\\n&\\qquad\\land\\int_{K\\setminus\\{0_K\\}}\n\\left|\\phi(x)\\chi(x)|k|^{-s\\,v(x)}\\right|\\,d\\mu^\\times(x)<\\infty\\\\\n&\\qquad\\land z=\\int_{K\\setminus\\{0_K\\}}\n\\phi(x)\\chi(x)|k|^{-s\\,v(x)}\\,d\\mu^\\times(x)\\Bigr].\n\\end{aligned}","display":true},{"tex":"\\phi","display":false},{"tex":"d^\\times x","display":false},{"tex":"\\mathfrak{f}(\\chi)","display":false},{"tex":"L_v(s, \\pi_v) = L_v(s, \\rho \\circ \\sigma_v)","display":false},{"tex":"\\rho","display":false}],"bytes":3293,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-795","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-local-zeta.md|58-df-local-zeta]]（batch14）"}],"outgoing":["9e19ee25a61be95f","36d7463d215be751","82cd211c4765302c"]}