arityType}(S,\\alpha)\n\\land\\mathrm{Variety}_{93}(\\mathcal V;\\tau)\n\\land\\forall f\\in S\\;\\bigl(\\alpha(f)\\in\\omega\\bigr)\n\\land\\Bigl(\\exists\\mathbf B\\in\\mathcal V\\;\\exists b_0,b_1\\in|\\mathbf B|\\;(b_0\\ne b_1)\\Bigr)\n\\land\\mathrm{InfCard}_{93}(\\kappa)\\land\\mathrm{CardLe}_{93}(S,\\kappa)\\\\\n&\\qquad\\to\\exists\\mathbf A\\in\\mathcal V\\;\\mathrm{CardEq}(|\\mathbf A|,\\kappa).\n\\end{aligned}","display":true},{"tex":"\\kappa","display":false},{"tex":"\\mathrm{CardLe}_{93}(S,\\kappa)","display":false},{"tex":"\\kappa","display":false},{"tex":"S","display":false},{"tex":"\\alpha","display":false}],"bytes":1677,"backlinks":[],"outgoing":["1734624324342672","f0b0edbaa6696a1d","64f6348f5d9119d6","259a663bdd529644","ee84ed8b0fae5bc3"]}