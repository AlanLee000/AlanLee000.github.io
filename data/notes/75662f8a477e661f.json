NR}(n,A,\\eta)\\right].","display":true},{"tex":"c_B","display":false},{"tex":"p(c_B,c_C)","display":false},{"tex":"m\\mapsto c_B(\\eta[i\\mapsto m])","display":false},{"tex":"s","display":false},{"tex":"m","display":false},{"tex":"n","display":false},{"tex":"B\\to_a C","display":false},{"tex":"c_C","display":false},{"tex":"c_C","display":false}],"bytes":3527,"backlinks":[{"id":"00439897fba390aa","anchor":"ref-228","locations":["正文"],"count":1,"excerpt":"[[72-thm-negative-formula-self-realizability|thm-negative-formula-self-realizability — Self-realizability of negative arithmetic formulas]]"},{"id":"4d85a6a31705a214","anchor":"ref-228","locations":["正文"],"count":1,"excerpt":"[[./72-thm-negative-formula-self-realizability|thm-negative-formula-self-realizability — Self-realizability of negative arithmetic formulas]]"}],"outgoing":["bb78d8a03236bc57","ac651a11b295edf3","2ce276183c963d6c","bf141a6daa8808bc"]}