ologicalSpace}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop5TopologicalSpace}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"74086485fba8d86f\" href=\"?note=74086485fba8d86f\" title=\"58-df-zfc-top5-topological-space\">58-df-zfc-top5-topological-space</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop4RefinementOfCover}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop4RefinementOfCover}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"7ccce769ac62de4b\" href=\"?note=7ccce769ac62de4b\" title=\"58-df-zfc-top4-refinement-of-cover\">58-df-zfc-top4-refinement-of-cover</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCard6FiniteSet}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcCard6FiniteSet}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"07554a796c3aa1f5\" href=\"?note=07554a796c3aa1f5\" title=\"58-df-zfc-card6-finite-set\">58-df-zfc-card6-finite-set</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop7MetacompactSpace}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop7MetacompactSpace}_S:V^2\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top7\\text{-}metacompact\\text{-}space} \\vdash \\mathrm{ZfcTop7MetacompactSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land \\forall\\mathcal U\\subseteq\\tau\\;(X\\subseteq\\bigcup\\mathcal U\\to\\exists\\mathcal V\\subseteq\\tau\\;(\\mathrm{ZfcTop4RefinementOfCover}_S(X,\\mathcal U,\\mathcal V)\\land\\forall x\\in X\\;\\mathrm{ZfcCard6FiniteSet}_S(\\{V\\in\\mathcal V:x\\in V\\})))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top7\\text{-}metacompact\\text{-}space} \\vdash \\mathrm{ZfcTop7MetacompactSpace}_S(X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5Topolo