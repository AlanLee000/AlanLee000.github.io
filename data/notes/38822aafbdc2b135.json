297576\" title=\"73-df-binary-np-completeness\">73-df-binary-np-completeness</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"d303539c48e08599\" href=\"?note=d303539c48e08599\" title=\"73-thm-binary-sat-completeness\">73-thm-binary-sat-completeness</a></span></div>"},{"key":"source_id","html":"HMU2007"},{"key":"source_ref","html":"§10.3, print pp. 448–458; PDF pp. 470–480; at-most-three local syntax variant"},{"key":"source_status","html":"third-edition-topic-mapped; inherited-local-review; not-a-line-by-line-source-proof-certificate"},{"key":"reviewed_on","html":"2026-10-24"},{"key":"legacy_source_id","html":"HU1979"},{"key":"legacy_source_ref","html":"Theorem 13.3, pp. 330–331; scans 338–339"},{"key":"legacy_source_status","html":"book-based-local-formalization"},{"key":"revision_round","html":"pdf-third-edition-20261024"},{"key":"edition_role","html":"third-edition-core"},{"key":"third_edition_chapter","html":"10"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p>固定满足 <span class=\"math-inline\" data-tex=\"\\operatorname{BoolCoding}(\\mathcal B)\">\\(\\operatorname{BoolCoding}(\\mathcal B)\\)</span> 的编码包。<span class=\"math-inline\" data-tex=\"\\mathsf{ThreeSAT}_{\\mathcal B}\">\\(\\mathsf{ThreeSAT}_{\\mathcal B}\\)</span> 见 <a class=\"wiki-link\" id=\"ref-4\" data-note=\"88dea30e48fadc7f\" href=\"?note=88dea30e48fadc7f\" title=\"73-df-bounded-clause-boolean-formulas\">73-df-bounded-clause-boolean-formulas</a>；<span class=\"math-inline\" data-tex=\"\\mathsf{NPC}\">\\(\\mathsf{NPC}\\)</span> 见 <a class=\"wiki-link\" id=\"ref-5\" data-note=\"41d5b79d11297576\" href=\"?note=41d5b79d11297576\" title=\"73-df-binary-np-completeness\">73-df-binary-np-completeness</a>，普通 SAT 完备性见 <a class=\"wiki-link\" id=\"ref-6\" data-note=\"d303539c48e08599\" href=\"?note=d303539c48e08599\" title=\"73-thm-binary-sat-completeness\">73-thm-binary-sat-completeness</a>。</p>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}three\\text{-}sat\\text{-}np\\text{-}completeness}\\vdash\n\\mathsf{ThreeSAT}_{\\mathcal B}\\in\\mathsf{NPC}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}three\\text{-}sat\\text{-}np\\text{-}completeness}\\vdash\n\\mathsf{ThreeSAT}_{\\mathcal B}\\in\\mathsf{NPC}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>为每个子项引入新变量，给出表达该变量等于对应布尔门输出的至多三文字子句，并要求根变量为真。局部门约束保证新公式可满足恰当原式可满足；常元可用单位子句表示。大小随项数多项式增长，固定的一元变量索引编码也只多项式增长。猜赋值即可验证成员资格。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"73-df-bounded-clause-boolean-formulas","status":"resolved","id":"88dea30e48fadc7f","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-bounded-clause-boolean-formulas]]","embed":false},{"target":"73-df-binary-np-completeness","status":"resolved","id":"41d5b79d11297576","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-binary-np-completeness]]","embed":false},{"target":"73-thm-binary-sat-completeness","status":"resolved","id":"d303539c48e08599","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-thm-binary-sat-completeness]]","embed":false},{"target":"73-df-bounded-clause-boolean-formulas","status":"resolved","id":"88dea30e48fadc7f","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"固定满足 $\\operatorname{BoolCoding}(\\mathcal B)$ 的编码包。$\\mathsf{ThreeSAT}_{\\mathcal B}$ 见 [[73-df-bounded-clause-boolean-formulas]]；$\\mathsf{NPC}$ 见 [[73-df-binary-np-completeness]]，普通 SAT 完备性见 [[73-thm-binary-sat-completeness]]。","embed":false},{"target":"73-df-binary-np-completeness","status":"resolved","id":"41d5b79d11297576","anchor":"ref-5","targetAnchor":""