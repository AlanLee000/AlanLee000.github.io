{[d]_E:d\\in D\\}\\land q=\\{\\langle d,[d]_E\\rangle:d\\in D\\}\\land\\mathrm{ZfcTop2QuotientTopology}_S(\\tau_Q,q,D,\\tau_D)\\Bigr).\\end{aligned}","display":true},{"tex":"\\langle1,a\\rangle","display":false},{"tex":"\\langle0,\\phi(a)\\rangle","display":false},{"tex":"Q","display":false},{"tex":"\\tau_Q","display":false},{"tex":"\\tau_A","display":false},{"tex":"\\tau_Y","display":false}],"bytes":2394,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-153","locations":["正文"],"count":1,"excerpt":"[[../batch09/58-df-attaching-space.md|58-df-attaching-space]]（batch09）"}],"outgoing":["6a42c12dd60b1f33","f719c6b47e823a62","fdeb0db348e01893","b2e63b755a37f1dc","815e63e5071e7b58"]}