\land\\mathrm{DoubleCover}_S(\\pi,M,\\tau_M,\\operatorname{Sp}_{2n}(\\mathbb R),\\tau_{\\mathrm{Sp}})\n\\end{aligned}\\right]","display":true},{"tex":"n","display":false},{"tex":"\\operatorname{Sp}_2","display":false},{"tex":"\\mathcal A_X,\\mathcal A_Y","display":false},{"tex":"\\dim Y","display":false}],"bytes":4344,"backlinks":[{"id":"37a91d4613e30b36","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{MetaplecticGroup}_S:V^9\\to\\{\\top,\\bot\\}$ (see [[../batch15/58-df-metaplectic-group.md]])"},{"id":"84daad544872cc71","anchor":"ref-839","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-metaplectic-group.md|58-df-metaplectic-group]]（batch15）"}],"outgoing":["08fb6fd463430f87","71fe0dc4c8613e69","ed71f39f59370734","f32a973b59a825e4","71801f5b9407391a","17de8347f6f91384","36d7463d215be751"]}