^{\\mathfrak A}\\in Y)\\\\\n&\\hspace{34mm}\\land\\forall n\\in\\omega\\;\\forall f\\in\\mathrm{Func}_{L,n}\\;(f^{\\mathfrak A}[Y^n]\\subseteq Y)\\},\\\\\n\\mathcal J_X&:=\\{(c,c^{\\mathfrak A}):c\\in\\mathrm{Const}_L\\}\\\\\n&\\quad\\cup\\{(f,f^{\\mathfrak A}\\!\\upharpoonright B_{\\mathfrak A}(X)^n):n\\in\\omega\\land f\\in\\mathrm{Func}_{L,n}\\}\\\\\n&\\quad\\cup\\{(R,R^{\\mathfrak A}\\cap B_{\\mathfrak A}(X)^n):n\\in\\omega\\land R\\in\\mathrm{Rel}_{L,n}\\},\\\\\n\\langle X\\rangle_{\\mathfrak A}&:=(B_{\\mathfrak A}(X),\\mathcal J_X).\n\\end{aligned}","display":true},{"tex":"A","display":false},{"tex":"X","display":false},{"tex":"X","display":false},{"tex":"X\\ne\\varnothing","display":false}],"bytes":2192,"backlinks":[{"id":"13c73c6f79ee78a7","anchor":"ref-29","locations":["正文"],"count":1,"excerpt":"[[17-df-generated-substructure]]"},{"id":"2c98c9e634ff4b44","anchor":"ref-63","locations":["正文"],"count":1,"excerpt":"[[17-df-abstract-logic]]\n[[17-df-abstract-logic-compactness]]\n[[17-df-abstract-logic-lowenheim-skolem]]\n[[17-df-aleph-one-categoricity]]\n[[17-df-aleph-zero-categoricity]]\n[[17-df-algebraic-closure]]\n[[17-df-assignment]]\n[[17-df-assignment-predicate]]\n[[17-df-atomic-formula]]\n[[17-df-atomic-model]]\n[[17-df-atomic-model-notation]]\n[[17-df-bool-comb]]\n[[17-df-boolean-algebra]]\n[[17-df-boolean-valued-expansion]]\n[[17-df-boolean-valued-relation]]\n[[17-df-bound-variable]]\n[[17-df-cardinal-arithmetic]]\n[[17-df-cardinal-saturation]]\n[[17-df-categoricity]]\n[[17-df-chain-union]]\n[[17-df-chain-union-preservation]]\n[[17-df-complete-formula]]\n[[17-df-deduction-system]]\n[[17-df-definable-closure]]\n[[17-df-definable-set]]\n[[17-df-dense-linear-order]]\n[[17-df-diagram]]\n[[17-df-elementary-amalgamation]]\n[[17-df-elementary-amalgamation-property]]\n[[17-df-elementary-chain]]\n[[17-df-elementary-diagram]]\n[[17-df-elementary-embedding]]\n[[17-df-elementary-equivalence]]\n[[17-df-elementary-extension]]\n[[17-df-elementary-substructure]]\n[[17-