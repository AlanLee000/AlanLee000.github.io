\mathrm{OmittedType}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{CountableSignature}_S\\subseteq V","display":false},{"tex":"\\mathrm{df\\text{-}omitting\\text{-}types\\text{-}countable\\text{-}signature}\\vdash\n\\mathrm{CountableSignature}_S(\\mathcal L)\\leftrightarrow\n\\exists L_c,L_f,a_f,L_r,a_r\\in V\\;\\Bigl(\n\\mathcal L=\\langle L_c,L_f,a_f,L_r,a_r\\rangle\n\\land\\mathrm{Function}(a_f,L_f,\\omega)\n\\land\\mathrm{Function}(a_r,L_r,\\omega)\n\\land|L_c\\cup L_f\\cup L_r|\\leq\\aleph_0\\Bigr)","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}omitting\\text{-}types}\\vdash{}&\n\\mathrm{CountableSignature}_S(\\mathcal L)\\land\\operatorname{Theory}(T,\\mathcal L)\n\\land|T|\\leq\\aleph_0\\\\\n&\\land\\mathrm{ConsistentTheory}_S(T,\\mathcal P,\\mathcal L,\\bot)\n\\land\\mathrm{CompleteType}_S(p,\\varnothing,T,\\mathcal L,n)\\\\\n&\\land\\neg\\mathrm{ZfcModel6IsolatedType}_S(\\mathcal L,T,\\varnothing,p,n,\\mathcal P,\\bot)\\\\\n\\to{}&\\exists\\mathfrak M\\in V\\;\\Bigl(\n\\mathrm{Model}(\\mathfrak M,T)\\land|\\mathrm{Univ}(\\mathfrak M)|\\leq\\aleph_0\n\\land\\mathrm{OmittedType}_S(p,\\mathfrak M,n)\\Bigr).\n\\end{aligned}","display":true}],"bytes":2460,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4332","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-thm-omitting-types.md|58-thm-omitting-types]]（batch14）"}],"outgoing":["1bd3906a14e9f667","c8dfa3853919882a","74518fe8da772d53","6996aaff4caeacce","90ce6acf0c65af45","8b6a90316aad78a4","36d7463d215be751"]}