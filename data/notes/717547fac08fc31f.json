i_P\\bigr).","display":true},{"tex":"\\forall Q\\in\\operatorname{Ob}(\\widehat{\\mathcal C})\\ \\forall\\kappa\\quad\\operatorname{IsColimit}_{\\widehat{\\mathcal C}}(Q,\\kappa,y\\circ\\pi_P)\\Longrightarrow P\\cong_{\\widehat{\\mathcal C}}Q.","display":true},{"tex":"\\widetilde u:(D,q)\\to(C,p)","display":false},{"tex":"u=\\pi_P(\\widetilde u)","display":false},{"tex":"q=P(u)p","display":false},{"tex":"\\lambda_{(C,p)}\\circ y(u)=\\lambda_{(D,q)}","display":false},{"tex":"Q","display":false},{"tex":"\\mu","display":false},{"tex":"h_C(p)=\\mu_{(C,p),C}(\\operatorname{id}_C)","display":false},{"tex":"h_D(P(u)p)=Q(u)h_C(p)","display":false},{"tex":"h:P\\to Q","display":false},{"tex":"h\\lambda=\\mu","display":false}],"bytes":2163,"backlinks":[{"id":"c53146be63465990","anchor":"ref-52","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-density|thm-196 — 每个预层是可表预层的规范余极限]]"},{"id":"af8af33cef1d96d9","anchor":"ref-90","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-density]]"},{"id":"4741fef73eb1a614","anchor":"ref-247","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-density]]"},{"id":"ffda0c0482667c45","anchor":"ref-169","locations":["正文"],"count":2,"excerpt":"[[14-thm-presheaf-density]]"},{"id":"c60ad289d123497b","anchor":"ref-53","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-density|thm-196 — 每个预层是可表预层的规范余极限]]"}],"outgoing":["99b72d10a7d872f5","1291f8efcdef81cf","d6de86836bb719f3","19ea095512403696","d5f547b903550705"]}