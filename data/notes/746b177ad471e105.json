\\mathbb P\n\\land D\\in\\mathcal P(\\mathbb P)^\\omega\\\\\n&\\qquad\\land\\forall n\\in\\omega\\;\\mathrm{DenseIn}_S(D(n),\\mathbb P,\\leq_{\\mathbb P})\\\\\n&\\quad\\to\n\\exists G\\subseteq\\mathbb P\\;\\Bigl(\n\\mathrm{ForcingFilter}_S(G,\\mathbb P,\\leq_{\\mathbb P})\n\\land p_0\\in G\n\\land\\forall n\\in\\omega\\;(G\\cap D(n)\\neq\\varnothing)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"p_0","display":false},{"tex":"D(n)","display":false},{"tex":"n","display":false},{"tex":"D","display":false}],"bytes":1940,"backlinks":[{"id":"9329f75331cb2511","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-4385","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-thm-rasiowa-sikorski.md|58-thm-rasiowa-sikorski]]（batch07）"}],"outgoing":["d3f859dbdd37f018","5e1000a4d0dd2b92"]}