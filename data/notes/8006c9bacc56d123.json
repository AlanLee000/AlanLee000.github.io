orall x,y\\in\\mathbb Q\\;(d(x,y)=a(x-y))\\\\\n&\\land\\operatorname{MetricCompletion}(\\mathbb Q,d;K_p,\\widehat d,i)\n\\land\\mathrm{Field}_S(K_p,+_p,\\cdot_p,0_p,1_p)\n\\land i(0)=0_p\\land i(1)=1_p\\\\\n&\\land\\forall x,y\\in\\mathbb Q\\;\\bigl(i(x+y)=i(x)+_pi(y)\\land i(xy)=i(x)\\cdot_pi(y)\\bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}p\\text{-}adic} \\vdash \\mathrm{PAdicField}_S(K_p,p) \\leftrightarrow \\exists v,a,d,\\widehat d,i,+_p,\\cdot_p,0_p,1_p\\;\\mathrm{PAdicPresentation}_S(K_p,p,v,a,d,\\widehat d,i,+_p,\\cdot_p,0_p,1_p)","display":true},{"tex":"\\mathrm{df\\text{-}p\\text{-}adic\\text{-}integers} \\vdash \\mathrm{PAdicIntegers}_S(\\mathcal O_p,K_p,p) \\leftrightarrow \\exists v,a,d,\\widehat d,i,+_p,\\cdot_p,0_p,1_p\\;\\bigl(\\mathrm{PAdicPresentation}_S(K_p,p,v,a,d,\\widehat d,i,+_p,\\cdot_p,0_p,1_p)\\land\\mathcal O_p=\\{x\\in K_p:\\widehat d(x,0_p)\\leq1\\}\\bigr)","display":true},{"tex":"p","display":false},{"tex":"a(x)=p^{-v(x)}","display":false},{"tex":"x","display":false},{"tex":"p","display":false},{"tex":"\\mathbb Q","display":false},{"tex":"\\mathbb Q_p","display":false},{"tex":"\\mathbb Z_p\\cong\\varprojlim_n\\mathbb Z/p^n\\mathbb Z","display":false},{"tex":"f(x) \\equiv 0 \\pmod{p} \\implies","display":false},{"tex":"p","display":false},{"tex":"f'(x) \\neq 0 \\pmod{p}","display":false},{"tex":"\\mathbb Q","display":false}],"bytes":4011,"backlinks":[{"id":"4d3551c550ac217a","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-931","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-p-adic.md|58-df-p-adic]]（batch07）"}],"outgoing":["0fb569bc36cce327","3322615e4eea05e9","1eb4a89b005d9cda","840ef0555c7aa179"]}