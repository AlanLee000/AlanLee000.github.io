Frob}","display":false},{"tex":"\\mathrm{HasEq}","display":false},{"tex":"\\mathrm{FibFinProd}","display":false},{"tex":"\\mathfrak e=(\\mathsf{Eq}_{I,J},\\Phi_{I,J})_{I,J\\in\\operatorname{Ob}\\mathcal B}","display":false},{"tex":"\\mathsf{Eq}_{I,J}:\\mathcal E_{I\\times J}\\to\\mathcal E_{(I\\times J)\\times J}","display":false},{"tex":"\\Phi_{I,J}","display":false},{"tex":"\\mathrm{EqAdjData}_p(\\mathfrak e)","display":false},{"tex":"\\mathrm{SimpleEqData}_p(\\mathfrak e)","display":false},{"tex":"\\mathrm{AdjHom}","display":false},{"tex":"\\mathrm{Frob}_p(u;L,\\Phi)","display":false},{"tex":"\\mathrm{EqFrob}(p)","display":false},{"tex":"\\mathrm{Frob}_p(u;L,\\Phi)","display":false},{"tex":"l_J=\\pi_2:1\\times J\\xrightarrow{\\sim}J","display":false},{"tex":"r_J=\\langle\\pi_2\\pi_1,\\pi_2\\rangle:(1\\times J)\\times J\\xrightarrow{\\sim}J\\times J","display":false},{"tex":"\\mathsf{Eq}_J","display":false},{"tex":"\\mathrm{HasEq}(p)","display":false},{"tex":"Y\\in\\operatorname{Ob}\\mathcal E_{I\\times J}","display":false},{"tex":"X\\in\\operatorname{Ob}\\mathcal E_{(I\\times J)\\times J}","display":false},{"tex":"\\mathsf{Eq}_J","display":false},{"tex":"\\delta_{I,J}\\coloneqq\\langle\\operatorname{id}_{I\\times J},\\pi_2^{I,J}\\rangle,\\qquad\nS_\\delta(u,J)\\coloneqq(u\\times\\operatorname{id}_J,\\delta_{K,J},\\delta_{I,J},(u\\times\\operatorname{id}_J)\\times\\operatorname{id}_J).","display":true},{"tex":"l_J\\coloneqq\\pi_2^{1,J},\\qquad\nr_J\\coloneqq\\langle\\pi_2^{1,J}\\pi_1^{1\\times J,J},\\pi_2^{1\\times J,J}\\rangle.","display":true},{"tex":"\\begin{aligned}\n\\mathrm{EqAdjData}_p(\\mathfrak e)&\\Longleftrightarrow\n(\\forall I,J\\in\\operatorname{Ob}\\mathcal B)\\ \\mathrm{AdjHom}(\\mathsf{Eq}_{I,J},\\delta_{I,J}^*,\\Phi_{I,J}),\\\\\n\\mathrm{SimpleEqData}_p(\\mathfrak e)&\\Longleftrightarrow\n\\begin{cases}\n\\begin{gathered}\n(\\forall I,J,K\\in\\operatorname{Ob}\\mathcal B)(\\forall u\\in\\mathcal B(K,I))\\\\\n\\mathrm{BC}_\\Sigma(p;S_\\delta(u,J);\\mathsf{Eq}_{K,J},\\Phi_{K,J},\\mathsf{Eq}_{I,J},\\Phi_{I,J})\n\\end{gathered}&\\mathrm{EqAdjData}_p(\\mathfrak e),\\\\\n\\bot&\\neg\\mathrm{EqAdjData}_p(\\mathfrak e),\n\\end{cases}\\\\\n\\mathrm{HasEq}(p)&\\Longleftrightarrow(\\exists\\mathfrak e)\\ \\mathrm{SimpleEqData}_p(\\mathfrak e),\\\\\n\\mathrm{EqFrob}(p)&\\Longleftrightarrow\n\\begin{cases}\n\\begin{gathered}\n(\\exists\\mathfrak e)\\Bigl[\\mathrm{SimpleEqData}_p(\\mathfrak e)\\\\\n\\land(\\forall I,J\\in\\operatorname{Ob}\\mathcal B)\\\n\\mathrm{Frob}_p(\\delta_{I,J};\\mathsf{Eq}_{I,J},\\Phi_{I,J})\\Bigr]\n\\end{gathered}&\\mathrm{FibFinProd}(p),\\\\\n\\bot&\\neg\\mathrm{FibFinProd}(p).\n\\end{cases}\n\\end{aligned}","display":true},{"tex":"\\mathcal E_{(I\\times J)\\times J}(\\mathsf{Eq}_{I,J}Y,X)\n\\cong\\mathcal E_{I\\times J}(Y,\\delta_{I,J}^*X).","display":true},{"tex":"\\mathsf{Eq}_J\\coloneqq(r_J^{-1})^*\\mathsf{Eq}_{1,J}l_J^*.","display":true},{"tex":"\\mathsf{Eq}_{K,J}(u\\times\\operatorname{id})^*\\cong((u\\times\\operatorname{id})\\times\\operatorname{id})^*\\mathsf{Eq}_{I,J}","display":false},{"tex":"u:I\\to J","display":false},{"tex":"(u\\times u)^*\\mathsf{Eq}_{J}\\cong\\mathsf{Eq}_{I}u^*","display":false},{"tex":"u","display":false},{"tex":"\\mathsf{Eq}_J","display":false},{"tex":"\\mathsf{Eq}_{1,J}:\\mathcal E_J\\to\\mathcal E_{J\\times J}","display":false}],"bytes":4493,"backlinks":[{"id":"478c99d853e13c93","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$p:\\mathcal E\\to\\mathcal B$ 为纤维化；预序、纤维有限积、简单等式分别见 [[16-df-fibred-preorder]]、[[16-df-fibred-finite-products]]、[[16-df-eq-functor]]。"},{"id":"15f24d16daf114fb","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\mathsf{Eq}_I:\\mathcal E_I\\to\\mathcal E_{I\\times I}$ 取 [[16-df-eq-functor]] 的无参数同构运输构造，基有限积及等式伴随族保持同一选择。"},{"id":"5bf8906d66a26c9e","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$p:\\mathcal E\\to\\mathcal B$ 为带有限积基范畴的纤维化，$\\mathrm{HasEq}$ 见