}_{\\Sigma}(\\varphi)\\subseteq\\{x,y,z\\}\\land\n\\mathrm{ZfcLogicSatisfactionRelation}_S(\\mathcal R,M,\\operatorname{Val}_M,\\Sigma)\\land\n\\mathrm{Assign}(M,s)\\land\nx,y,z\\in\\mathrm{Var}_S\\land x\\neq y\\land x\\neq z\\land y\\neq z\\land\nA,B,p\\in U\\land\n\\left[\\forall a\\in A\\;\\exists!b\\in U\\;\n\\langle\\varphi,s[z\\mapsto p][x\\mapsto a][y\\mapsto b]\\rangle\\in\\mathcal R\\right]\\land\nB=\\left\\{b\\in U:\\exists a\\in A\\;\n\\langle\\varphi,s[z\\mapsto p][x\\mapsto a][y\\mapsto b]\\rangle\\in\\mathcal R\\right\\}\n\\Bigr)\n\\right)","display":true},{"tex":"U","display":false}],"bytes":2834,"backlinks":[{"id":"dbe492384d312504","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcSet10BoundedReplacementInstance}_S$ has the explicit twelve-place interface from [[../batch02/58-df-zfc-set10-bounded-replacement-instance.md]]."},{"id":"7d02815fd0fdf489","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-3375","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-zfc-set10-bounded-replacement-instance.md|58-df-zfc-set10-bounded-replacement-instance]]（batch02）"}],"outgoing":["2678ecfefaa83e32","1cb489a34bc2433c","64f35ba2e87964e0","8935dcac821c0104","c14ba496c480dcd6","715a32e91161b34f"]}