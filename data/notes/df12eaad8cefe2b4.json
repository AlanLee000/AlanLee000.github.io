et <span class=\"math-inline\" data-tex=\"X\">\\(X\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-powerset","status":"resolved","id":"2b6b1d9eb78a2714","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-powerset]]","embed":false},{"target":"58-df-set","status":"resolved","id":"65d9a1e690c32aad","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-set]]","embed":false}],"math":[{"tex":"X\\in V","display":false},{"tex":"\\mathrm{thm\\text{-}power\\text{-}set} \\vdash \\exists!P\\;\\forall Y\\;\\left(Y\\in P\\leftrightarrow Y\\subseteq X\\right)","display":true},{"tex":"|\\mathcal P(X)|=2^{|X|}","display":false},{"tex":"X","display":false}],"bytes":573,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4363","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-thm-power-set.md|58-thm-power-set]]（batch05）"}],"outgoing":["2b6b1d9eb78a2714","65d9a1e690c32aad"]}