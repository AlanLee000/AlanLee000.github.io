n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}order2\\text{-}lower\\text{-}bound}\\vdash\\mathrm{ZfcOrder2LowerBound}_S(b,A,P,\\leq_P)\\leftrightarrow\\mathrm{PartialOrder}_S(P,\\leq_P)\\land b\\in P\\land A\\subseteq P\\land\\forall a\\in A\\;(b\\leq_P a)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}order2\\text{-}lower\\text{-}bound}\\vdash\\mathrm{ZfcOrder2LowerBound}_S(b,A,P,\\leq_P)\\leftrightarrow\\mathrm{PartialOrder}_S(P,\\leq_P)\\land b\\in P\\land A\\subseteq P\\land\\forall a\\in A\\;(b\\leq_P a)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The order relation is validated as part of the predicate.</li>\n<li>The order6 lower-bound variant is merged here.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch15/58-df-zfc-partial-order.md","status":"resolved","id":"9ee45afab4c00dd5","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-zfc-partial-order.md]]","embed":false}],"math":[{"tex":"P,\\leq_P,A,b\\in V,\\quad A\\subseteq P,\\quad b\\in P","display":false},{"tex":"\\mathrm{PartialOrder}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcOrder2LowerBound}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}order2\\text{-}lower\\text{-}bound}\\vdash\\mathrm{ZfcOrder2LowerBound}_S(b,A,P,\\leq_P)\\leftrightarrow\\mathrm{PartialOrder}_S(P,\\leq_P)\\land b\\in P\\land A\\subseteq P\\land\\forall a\\in A\\;(b\\leq_P a)","display":true}]