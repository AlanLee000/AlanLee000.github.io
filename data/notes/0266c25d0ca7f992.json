ymDerivative}_S(f,\\nu,\\mu,X,\\mathcal A)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure2\\text{-}radon\\text{-}nikodym\\text{-}derivative} \\vdash \\mathrm{ZfcMeasure11RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\\leftrightarrow\\mathrm{ZfcMeasure2RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure2\\text{-}radon\\text{-}nikodym\\text{-}derivative} \\vdash \\mathrm{ZfcMeasure11RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\\leftrightarrow\\mathrm{ZfcMeasure2RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure2\\text{-}radon\\text{-}nikodym\\text{-}derivative} \\vdash \\mathrm{ZfcMeasure9RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\\leftrightarrow\\mathrm{ZfcMeasure2RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure2\\text{-}radon\\text{-}nikodym\\text{-}derivative} \\vdash \\mathrm{ZfcMeasure9RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\\leftrightarrow\\mathrm{ZfcMeasure2RadonNikodymDerivative}_S(f,\\nu,\\mu,X,\\Sigma)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n<li>The measure6 and measure11 Radon-Nikodym derivative variants are merged here.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch15/58-df-zfc-measure3-sigm