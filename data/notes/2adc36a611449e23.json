\\mathrm{PA}\\vdash_{\\mathrm{ar}}\\neg(S_i\\land S_j),\\\\\n&\\mathrm{PA}\\vdash_{\\mathrm{ar}}\\bigvee_{\\mathrm{PA}}\\langle S_0,\\ldots,S_n\\rangle,\\\\\n&iR'j\\Longrightarrow\\mathrm{PA}\\vdash_{\\mathrm{ar}}S_i\\to\\neg\\mathrm{Bew}[\\neg S_j],\\\\\n&i\\in W\\Longrightarrow\\mathrm{PA}\\vdash_{\\mathrm{ar}}S_i\\to\\mathrm{Bew}[\\neg S_i],\\\\\n&i\\in W\\Longrightarrow\\mathrm{PA}\\vdash_{\\mathrm{ar}}S_i\\to\\mathrm{Bew}[D_i],\\\\\n&\\mathrm{ArSound}(\\mathrm{PA})\\Longrightarrow\\mathbb N\\models S_0.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{Bew}[B]&\\coloneqq\\mathrm{Prov}_{\\mathrm{PA}}(\\overline{\\ulcorner B\\urcorner})\n\\quad(B\\in\\mathrm{Sent}_{\\mathrm{PA}}),\\\\\nJ_i&\\coloneqq\\operatorname{inc}(\\{j\\in W'\\mid iR' j\\}),\\quad\nD_i\\coloneqq\\bigvee_{\\mathrm{PA}}\\langle S_{(J_i)_k}\\mid k<|J_i|\\rangle.\n\\end{aligned}","display":true},{"tex":"\\Sigma_1","display":false},{"tex":"\\mathbb N\\models H(\\bar a,\\bar b)\\leftrightarrow h(a)=b","display":false},{"tex":"j>0","display":false},{"tex":"j","display":false},{"tex":"\\neg S_j","display":false},{"tex":"\\neg S_j","display":false},{"tex":"S_j","display":false},{"tex":"\\mathrm{Cons}(\\mathrm{PA})","display":false}],"bytes":3091,"backlinks":[{"id":"1e36ef17b6856ad1","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e0c421a5b45aeb77","anchor":"ref-135","locations":["正文"],"count":2,"excerpt":"[[89-lem-solovay-self-reference]] → [[89-lem-solovay-limit-properties]] → [[89-lem-solovay-truth]] → [[89-lem-solovay-lem2]] → [[89-thm-solovay-theorem]] → [[89-df-reflection-companion]] → [[89-thm-gls-completeness]] → [[89-cor-gls-decidable]] → [[89-thm-uniform-solovay-realization]]"}],"outgoing":["3b78fd5923bcaa6c","76b37345e1a3ad95","0ce064881a79d6f7","97b68cd750e79cac"]}