-}hecke\\text{-}algebra}\\vdash\n\\mathrm{HeckeAlgebra}_S(\\mathbb T,T,M,k,\\Gamma)\\\\\n&\\quad\\leftrightarrow k\\in\\mathbb N_{\\geq1}\n\\land M=\\{f\\in\\mathbb C^{\\mathcal H}:\\mathrm{ModularForm}_S(f,k,\\Gamma)\\}\\\\\n&\\qquad\\land\\exists E,+_M,\\odot_M,0_M,+_E,\\cdot_E,0_E,1_E\\in V\\;\\Bigl(\n\\mathrm{ComplexEndomorphismRing}_S(E;M,+_M,\\odot_M,0_M,+_E,\\cdot_E,0_E,1_E)\\\\\n&\\hspace{50mm}\\land\\mathrm{Function}(T,\\mathbb N_{\\geq1},E)\n\\land\\mathrm{GeneratedUnitalSubring}_S\n(\\mathbb T,E,+_E,\\cdot_E,0_E,1_E,\\operatorname{ran}(T))\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"M_k(\\Gamma)","display":false},{"tex":"\\operatorname{End}_{\\mathbb C}(M)","display":false},{"tex":"\\operatorname{ZAlgGenerated}_S","display":false}],"bytes":2975,"backlinks":[{"id":"ca5920196b4108bd","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-610","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-df-hecke-algebra.md|58-df-hecke-algebra]]（batch20）"}],"outgoing":["a891b0f45131631a","36d7463d215be751","592f9cfb66a507c2","f67456d74b418241","1c30d21ea7b443f6","081edc5d75e10718"]}