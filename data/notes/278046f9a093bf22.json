:"\\Sigma","display":false},{"tex":"V","display":false},{"tex":"\\operatorname{View}_V^P(x,u)","display":false},{"tex":"\\mathbf{EPPT},\\mathbf{PPT}","display":false},{"tex":"\\mathrm{Negl}","display":false},{"tex":"x","display":false},{"tex":"\\operatorname{HVZK}(P,V,L,R)","display":false},{"tex":"\\operatorname{HVZK}(P,V,L,R)\\ \\Longleftrightarrow\\ \\exists S\\in\\mathbf{EPPT}\\;\\forall D\\in\\mathbf{PPT}\\;\\exists\\mu\\in\\mathrm{Negl}\\;\\forall x\\in L\\;\\forall u\\in\\Sigma^*\\;\\left[R(x,u)\\Rightarrow\\left|\\Pr[D(x,\\operatorname{View}_V^P(x,u))=1]-\\Pr[D(x,S(x))=1]\\right|\\le\\mu(|x|)\\right].","display":true}],"bytes":1791,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-149","locations":["正文"],"count":1,"excerpt":"零知识：[[28-df-honest-verifier-zero-knowledge]]、[[28-df-zero-knowledge]]。"}],"outgoing":["74e0b51f1b8e81e1","8e6a863785f69243","b75200f005282ddf","f3171800627deef3"]}