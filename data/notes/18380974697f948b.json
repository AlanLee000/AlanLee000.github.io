\\operatorname{UnaryLift}_{93}(\\operatorname{GammaNeg}_{93}(\\mathbf G,u);[0,u]_{\\mathbf G})\\rangle,\n\\langle0,\\operatorname{GammaZero}_{93}(\\mathbf G,u)\\rangle\n\\right\\}","display":true},{"tex":"\\mathrm{fact\\text{-}mv\\text{-}chain}\\vdash\n\\Gamma_{93}(\\mathbf G,u)\\coloneqq\n\\left\\langle[0,u]_{\\mathbf G},\n\\operatorname{GammaOpFam}_{93}(\\mathbf G,u)\\right\\rangle","display":true},{"tex":"\\mathrm{fact\\text{-}mv\\text{-}chain}\\vdash\n\\mathrm{LOAbGrpUnit}_{93}(\\mathbf G,u)\\to\n\\mathrm{MVAlg}_{93}(\\Gamma_{93}(\\mathbf G,u))","display":true},{"tex":"\\begin{aligned}\n\\mathrm{fact\\text{-}mv\\text{-}chain}\\vdash{}&\n\\mathrm{MVAlg}_{93}(\\mathbf M)\n\\land\\forall x,y\\in|\\mathbf M|\\;(x\\leq_{\\mathbf M}y\\lor y\\leq_{\\mathbf M}x)\\\\\n&\\to\\exists\\mathbf G,u,h\\;\\Bigl(\n\\mathrm{LOAbGrpUnit}_{93}(\\mathbf G,u)\n\\land\\mathrm{MVAlg}_{93}(\\Gamma_{93}(\\mathbf G,u))\n\\land\\mathrm{Iso}_{93}(h,\\mathbf M,\\Gamma_{93}(\\mathbf G,u))\\Bigr).\n\\end{aligned}","display":true}],"bytes":3314,"backlinks":[],"outgoing":["6730349967b8ffce","f267483f66bfb134","3a47eea6cc9e560d","fe06c83d404633c2"]}