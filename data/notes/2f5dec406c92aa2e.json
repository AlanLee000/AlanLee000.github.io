_{X}","display":false},{"tex":"X","display":false},{"tex":"\\operatorname{ProdCar}_{93}","display":false},{"tex":"\\operatorname{BondDom}_{93}","display":false},{"tex":"\\operatorname{InvCar}_{93}","display":false},{"tex":"\\mathrm{InvLim}_{93}","display":false},{"tex":"\\mathrm{Top}_{93}","display":false},{"tex":"\\mathrm{Haus}_{93}","display":false},{"tex":"\\mathrm{Cont}_{93}","display":false},{"tex":"\\mathrm{TopAlg}_{93,\\tau}","display":false},{"tex":"\\mathrm{TopIso}_{93,\\tau}","display":false},{"tex":"\\operatorname{Box}_{93}","display":false},{"tex":"\\mathcal B^{\\Pi}_{93}","display":false},{"tex":"\\mathcal T^{\\Pi}_{93}","display":false},{"tex":"\\mathcal T^{\\mathrm{lim}}_{93}","display":false},{"tex":"\\mathrm{Profinite}_{93}(-;\\tau)","display":false},{"tex":"\\mathrm{lim}","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}profinite}\\vdash\\mathrm{Top}_{93}(\\mathcal T,A)\\leftrightarrow{}&\\mathcal T\\subseteq\\mathcal P(A)\\land\\varnothing\\in\\mathcal T\\land A\\in\\mathcal T\\\\\n&\\land\\forall\\mathcal U\\subseteq\\mathcal T\\;(\\bigcup\\mathcal U\\in\\mathcal T)\\land\\forall U,V\\in\\mathcal T\\;(U\\cap V\\in\\mathcal T),\\\\\n\\mathrm{Haus}_{93}(\\mathcal T,A)\\leftrightarrow{}&\\mathrm{Top}_{93}(\\mathcal T,A)\n\\land\\forall a,b\\in A\\;(a\\neq b\\to\\exists U,V\\in\\mathcal T\\;(a\\in U\\land b\\in V\\land U\\cap V=\\varnothing)),\\\\\n\\mathrm{Cont}_{93}(g;A,\\mathcal T_A,B,\\mathcal T_B)\\leftrightarrow{}&\n\\mathrm{Top}_{93}(\\mathcal T_A,A)\\land\\mathrm{Top}_{93}(\\mathcal T_B,B)\n\\land g:A\\to B\\land\\forall U\\in\\mathcal T_B\\;(g^{-1}[U]\\in\\mathcal T_A).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}profinite}\\vdash\n\\mathcal B^{\\times m}_{93}(A,\\mathcal T)&\\coloneqq\n\\left\\{\\prod_{i<m}\\mathbf U(i):\\mathbf U\\in\\mathcal T^m\\right\\},\\\\\n\\mathcal T^{\\times m}_{93}(A,\\mathcal T)&\\coloneqq\n\\left\\{\\bigcup\\mathcal U:\\mathcal U\\subseteq\n\\mathcal B^{\\times m}_{93}(A,\\mathcal T)\\right\\},\\\\\n\\mathrm{Top}_{93}(\\mathcal T,A)\\land m\\in\\omega\n&\\to\\mathrm{Top}_{93}(\\mathcal T^{\\times m}_{93}(A,\\mathcal T),A^m).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}profinite}\\vdash\\mathrm{TopAlg}_{93,\\tau}(\\langle\\mathbf A,\\mathcal T_A\\rangle)\\leftrightarrow{}&\\mathrm{Alg}_{\\tau}(\\mathbf A)\\land\\mathrm{Top}_{93}(\\mathcal T_A,|\\mathbf A|)\\\\\n&\\land\\forall f\\in\\pi_1(\\tau)\\;\\mathrm{Cont}_{93}\n(f^{\\mathbf A};|\\mathbf A|^{\\pi_2(\\tau)(f)},\n\\mathcal T^{\\times\\pi_2(\\tau)(f)}_{93}(|\\mathbf A|,\\mathcal T_A),\n|\\mathbf A|,\\mathcal T_A),\\\\\n\\mathrm{TopIso}_{93,\\tau}(h;\\langle\\mathbf A,\\mathcal T_A\\rangle,\\langle\\mathbf B,\\mathcal T_B\\rangle)\\leftrightarrow{}&\\mathrm{TopAlg}_{93,\\tau}(\\langle\\mathbf A,\\mathcal T_A\\rangle)\\land\\mathrm{TopAlg}_{93,\\tau}(\\langle\\mathbf B,\\mathcal T_B\\rangle)\\\\\n&\\land\\mathrm{Iso}_{93}(h,\\mathbf A,\\mathbf B)\n\\land\\mathrm{Cont}_{93}(h;|\\mathbf A|,\\mathcal T_A,|\\mathbf B|,\\mathcal T_B)\\\\\n&\\land\\mathrm{Cont}_{93}(h^{-1};|\\mathbf B|,\\mathcal T_B,|\\mathbf A|,\\mathcal T_A).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}profinite}\\vdash\n\\operatorname{Box}_{93}(\\mathbf U;\\mathbf A,I)\\coloneqq{}&\n\\{a\\in\\operatorname{ProdCar}_{93}(\\mathbf A;I):\n\\forall i\\in I\\;(a(i)\\in\\mathbf U(i))\\},\\\\\n\\mathcal B^{\\Pi}_{93}(\\mathbf A,\\mathbf T;I)\\coloneqq{}&\n\\left\\{\\operatorname{Box}_{93}(\\mathbf U;\\mathbf A,I):\n\\mathbf U\\in\\prod_{i\\in I}\\mathbf T(i)\n\\land\\mathrm{Finite}_{93}\\bigl(\\{i\\in I:\\mathbf U(i)\\neq|\\mathbf A(i)|\\}\\bigr)\\right\\},\\\\\n\\mathcal T^{\\Pi}_{93}(\\mathbf A,\\mathbf T;I)\\coloneqq{}&\n\\left\\{\\bigcup\\mathcal U:\\mathcal U\\subseteq\n\\mathcal B^{\\Pi}_{93}(\\mathbf A,\\mathbf T;I)\\right\\},\\\\\n\\mathcal T^{\\mathrm{lim}}_{93}(\\mathbf A,\\mathbf T,\\mathbf p;I,R,\\tau)\\coloneqq{}&\n\\left\\{\\operatorname{InvCar}_{93}(\\mathbf A,\\mathbf p;I,R)\\cap U:\nU\\in\\mathcal T^{\\Pi}_{93}(\\mathbf A,\\mathbf T;I)\\right\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}profinite}\\vdash\\mathrm{Profinite}_{93}(\\langle\\mathbf A,\\mathcal T_A\\rangle;\\tau)\\leftrightarrow{}&\\mathrm{TopAlg}_{93,\\tau}(\\langle\\mathbf A,\\mathcal T_A\\rangle)\\land\\mathrm{Haus}_{93}(\\mathcal T_A,|\\mathbf A|)\\\\\n&\\land\\exists I\\;\\exists R\\;\\exists\\mathbf D\\;\\exists\\mathbf T\\;\\exists\\mathbf p\\;\\Bigl[\nI\\in V\\land I\\neq\\varnothing\\land R\\subseteq I^2\\\\\n&\\quad\\land\\forall i\\in I\\;(\\langle i,i\\rangle\\in R)\n\\land\\forall i,j,k\\in I\\;(\\langle i,j\\rangle\\in R\\land\\langle j,k\\rangle\\in R\\to\\langle i,k\\rangle\\in R)\\\\\n&\\quad\\land\\forall i,j\\in I\\;(\\langle i,j\\rangle\\in R\\land\\langle j,i\\rangle\\in R\\to i=j)\n\\land\\forall i,j\\in I\\;\\exists k\\in I\\;(\\langle i,k\\rangle\\in R\\land\\langle j,k\\rangle\\in R)\\\\\n&\\quad\\land\\mathbf D:I\\to V\\land\\mathbf T:I\\to V\n\\land\\mathbf p:\\operatorname{BondDom}_{93}(I,R)\\to V\\\\\n&\\quad\\land\\forall i\\in I\\;\\bigl(\n\\mathrm{Alg}_{\\tau}(\\mathbf D(i))\\land\\mathrm{FinAlg}_{93}(\\mathbf D(i))\n\\land\\mathbf T(i)=\\mathcal P(|\\mathbf D(i)|)\\bigr)\\\\\n&\\quad\\land\\forall i,j\\in I\\;\\bigl(\\langle i,j\\rangle\\in R\\to\n\\mathrm{Hom}_{93}(\\mathbf p(\\langle i,j\\rangle),\\mathbf D(j),\\mathbf D(i))\\bigr)\\\\\n&\\quad\\land\\forall i\\in I\\;\\bigl(\\mathbf p(\\langle i,i\\rangle)=\\mathrm{id}_{|\\mathbf D(i)|}\\bigr)\\\\\n&\\quad\\land\\forall i,j,k\\in I\\;\\bigl(\\langle i,j\\rangle\\in R\\land\\langle j,k\\rangle\\in R\\to\n\\mathbf p(\\langle i,k\\rangle)=\\mathbf p(\\langle i,j\\rangle)\\circ\\mathbf p(\\langle j,k\\rangle)\\bigr)\\\\\n&\\quad\\land\\operatorname{InvCar}_{93}(\\mathbf D,\\mathbf p;I,R)\\neq\\varnothing\\\\\n&\\quad\\land\\exists h\\;\\mathrm{TopIso}_{93,\\tau}\\Bigl(\nh;\\langle\\mathbf A,\\mathcal T_A\\rangle,\