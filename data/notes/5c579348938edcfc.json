eq_Ik\\land j\\leq_Ik)\\land\\mathrm{Function}(\\mathcal M,I,\\operatorname{ran}(\\mathcal M))\\land D_I=\\{\\langle j,i\\rangle\\in I\\times I\\mid i\\leq_Ij\\}\\land\\mathrm{Function}(\\Pi,D_I,\\operatorname{ran}(\\Pi))\\land\\mathcal I=\\langle L,\\mathcal M,\\Pi\\rangle\\land\\forall i\\in I\\;\\mathrm{Struct}_S(\\mathcal M(i),L)\\land\\forall\\langle j,i\\rangle\\in D_I\\;\\mathrm{StructureHom}_S(\\Pi(\\langle j,i\\rangle),\\mathcal M(j),\\mathcal M(i),L)\\land\\forall i\\in I\\;(\\Pi(\\langle i,i\\rangle)=\\mathrm{id}_{\\mathrm{Univ}(\\mathcal M(i))})\\land\\forall i,j,k\\in I\\;\\bigl((i\\leq_Ij\\land j\\leq_Ik)\\to\\Pi(\\langle k,i\\rangle)=\\Pi(\\langle j,i\\rangle)\\circ\\Pi(\\langle k,j\\rangle)\\bigr)\\Bigr)","display":true}],"bytes":3001,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2800","locations":["正文"],"count":1,"excerpt":"[[../batch08/58-df-zfc-model8-inverse-system-models.md|58-df-zfc-model8-inverse-system-models]]（batch08）"}],"outgoing":["a3348ed9eb6fb4e3","d3f859dbdd37f018","d9b8711cda3f31ca","36d7463d215be751"]}