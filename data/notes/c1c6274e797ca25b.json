eq\\{v_0\\}\n\\land\\operatorname{FV}_{\\mathcal L_\\in}(\\sigma_{<})\\subseteq\\{v_0,v_1\\}\\\\\n&\\qquad\\land\\forall\\theta\\in\\mathrm{ZFC}\\;\\forall s\\in V\\;\\Bigl(\n(\\mathrm{Assign}(\\mathcal M,s)\\to\\operatorname{Sat}_M(\\theta,s))\n\\land(\\mathrm{Assign}(\\mathcal N,s)\\to\\operatorname{Sat}_N(\\theta,s))\\Bigr)\\\\\n&\\qquad\\land\\exists s_\\kappa\\in V\\;\\Bigl(\n\\mathrm{Assign}(\\mathcal M,s_\\kappa)\\land s_\\kappa(v_0)=\\kappa\n\\land\\operatorname{Sat}_M(\\sigma_{\\mathrm{card}},s_\\kappa)\\Bigr)\\\\\n&\\qquad\\land\\forall A\\in N\\;\\Bigl(\nA\\subseteq M\\land\\exists s_N\\in V\\;\\bigl(\n\\mathrm{Assign}(\\mathcal N,s_N)\\land s_N(v_0)=A\\land s_N(v_1)=\\kappa\n\\land\\operatorname{Sat}_N(\\sigma_{<},s_N)\\bigr)\\\\\n&\\hspace{10em}\\to\\exists B\\in M\\;\\Bigl(\nA\\subseteq B\\land\\exists s_M\\in V\\;\\bigl(\n\\mathrm{Assign}(\\mathcal M,s_M)\\land s_M(v_0)=B\\land s_M(v_1)=\\kappa\n\\land\\operatorname{Sat}_M(\\sigma_{<},s_M)\\bigr)\\Bigr)\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}model8\\text{-}cover\\text{-}property} \\vdash \\mathrm{ZfcModel9CoverProperty}_S(M,N,\\kappa)\\leftrightarrow \\mathrm{ZfcModel8CoverProperty}_S(N,M,\\kappa)","display":true},{"tex":"|A|^N","display":false},{"tex":"|B|^M","display":false},{"tex":"\\mathrm{Cardinal}_S","display":false}],"bytes":4794,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2795","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-model8-cover-property.md|58-df-zfc-model8-cover-property]]（batch03）"}],"outgoing":["a3348ed9eb6fb4e3","5fb1c2241d1943d1","28c79fde9f892bfe","c14ba496c480dcd6","8b6a90316aad78a4","d9b8711cda3f31ca","64f35ba2e87964e0","65418b505fc53093","715a32e91161b34f"]}