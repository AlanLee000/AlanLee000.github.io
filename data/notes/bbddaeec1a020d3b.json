X=\\sigma_X(\\tau_X)","display":true},{"tex":"\\mathrm{df\\text{-}borel\\text{-}map} \\vdash \\mathrm{BorelMap}_S(f,X,\\tau_X,\\mathcal B_X,Y,\\tau_Y,\\mathcal B_Y)\\leftrightarrow\\mathrm{BorelSpace}_S(X,\\tau_X,\\mathcal B_X)\\land\\mathrm{BorelSpace}_S(Y,\\tau_Y,\\mathcal B_Y)\\land\\mathrm{Function}(f,X,Y)\\land\\forall B\\in\\mathcal B_Y\\;(f^{-1}[B]\\in\\mathcal B_X)","display":true},{"tex":"\\sigma","display":false},{"tex":"\\mathbb{R}","display":false},{"tex":"\\omega^{\\omega}","display":false}],"bytes":1654,"backlinks":[{"id":"81608826d1fc98bd","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{BorelSpace}_S$ (Borel-space predicate, see [[../batch15/58-df-borel-space.md]])"},{"id":"184cdde824ccf8f9","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{BorelMap}_S$ (Borel-map predicate, see [[../batch15/58-df-borel-space.md]])"},{"id":"c4a4d86afe645047","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-199","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-borel-space.md|58-df-borel-space]]（batch15）"}],"outgoing":["e7514bc4cefba4f2","9375de7089953a2b","a740bdad87b97ac6","36d7463d215be751"]}