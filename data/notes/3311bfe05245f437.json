op,\\bot\\}","display":false},{"tex":"\\mathrm{AbelianGroup}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{GroupHomomorphism}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Bijective}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{TorsionSubgroup}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}roitman\\text{-}torsion\\text{-}subgroup}\\vdash\n\\mathrm{TorsionSubgroup}_S(T,G,m,e)\\leftrightarrow{}&\n\\mathrm{AbelianGroup}_S(G,m)\\land e\\in G\n\\land\\forall g\\in G\\;\\bigl(m(\\langle e,g\\rangle)=g\\land m(\\langle g,e\\rangle)=g\\bigr)\\\\\n&\\land T=\\Bigl\\{g\\in G:\\exists n\\in\\omega\\setminus\\{0\\}\\;\\exists s\\in G^{n+1}\\;\\bigl(\ns(0)=e\\\\\n&\\hspace{103pt}\\land\\forall k\\in n\\;s(k+1)=m(\\langle s(k),g\\rangle)\n\\land s(n)=e\\bigr)\\Bigr\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}roitman}\\vdash\n\\Bigl[{}&\n\\mathrm{SmoothConnectedProjectiveVariety}_{\\mathbb C,S}(X)\n\\land\\mathrm{DegreeZeroChowGroupData}_S(A_0,m_0,e_0,X)\\\\\n&\\land\\mathrm{AlbanesePointGroupData}_S(A_{\\mathrm{Alb}},m_{\\mathrm{Alb}},e_{\\mathrm{Alb}},X)\n\\land\\mathrm{AlbaneseCycleMap}_S(\\alpha,A_0,m_0,A_{\\mathrm{Alb}},m_{\\mathrm{Alb}},X)\\\\\n&\\land\\mathrm{GroupHomomorphism}_S(\\alpha,A_0,m_0,A_{\\mathrm{Alb}},m_{\\mathrm{Alb}})\n\\land\\mathrm{TorsionSubgroup}_S(T_0,A_0,m_0,e_0)\\\\\n&\\land\\mathrm{TorsionSubgroup}_S(T_{\\mathrm{Alb}},A_{\\mathrm{Alb}},m_{\\mathrm{Alb}},e_{\\mathrm{Alb}})\n\\Bigr]\\\\\n&\\to\\mathrm{GroupHomomorphism}_S\n(\\alpha\\upharpoonright T_0,T_0,m_0\\upharpoonright(T_0\\times T_0),T_{\\mathrm{Alb}},m_{\\mathrm{Alb}}\\upharpoonright(T_{\\mathrm{Alb}}\\times T_{\\mathrm{Alb}}))\n\\land\\mathrm{Bijective}(\\alpha\\upharpoonright T_0,T_0,T_{\\mathrm{Alb}}).\n\\end{aligned}","display":true},{"tex":"CH_0(X)^0","display":false},{"tex":"\\mathbb C","display":false},{"tex":"A_0(X)=CH_0(X)^0","display":false},{"tex":"\\operatorname{Alb}(X)(\\mathbb C)","display":false},{"tex":"p_g=0","display":false},{"tex":"CH_0(X)\\otimes\\mathbb Q\\cong\\mathrm{Alb}(X)\\otimes\\mathbb Q","display":false},{"tex":"A_0(X)","display":false}],"bytes":3684,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4397","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-thm-roitman.md|58-thm-roitman]]（batch19）"}],"outgoing":["41289d25523036d5","53a60793a214598a","9554b584e6760909","bf0ad86f0f4cd75f","f32a973b59a825e4","d583890235faf0d5","9f54a13cf4872f4e"]}