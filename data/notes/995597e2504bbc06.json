=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This is equality in the function space <span class=\"math-inline\" data-tex=\"\\mathrm{BoolFunc}_n\">\\(\\mathrm{BoolFunc}_n\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"27-df-boolfunc","status":"resolved","id":"5d10aed668d85817","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[27-df-boolfunc]]","embed":false},{"target":"27-df-boolfunc","status":"resolved","id":"5d10aed668d85817","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$f,g\\in\\mathrm{BoolFunc}_n$ (Boolean functions, see [[27-df-boolfunc]])","embed":false}],"attachments":[],"math":[{"tex":"n\\in\\mathbb N","display":false},{"tex":"f,g\\in\\mathrm{BoolFunc}_n","display":false},{"tex":"f\\equiv g\\leftrightarrow\\forall a\\in\\mathbb{B}^{n}\\,(f(a)=g(a))","display":true},{"tex":"\\mathrm{BoolFunc}_n","display":false}],"bytes":675,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-215","locations":["正文"],"count":1,"excerpt":"[[27-df-equiv|df-equiv — Functional equivalence]]"}],"outgoing":["5d10aed668d85817"]}