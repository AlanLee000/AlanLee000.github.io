(\\alpha))\\land\\forall\\alpha+1&lt;\\kappa\\;(\\vec M\\upharpoonright(\\alpha+1)\\in\\vec M(\\alpha+1))\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The witnessing chain is small, increasing, continuous, and each initial segment is internal to the next stage.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch11/58-df-cardinal.md","status":"resolved","id":"5fb1c2241d1943d1","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-cardinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false}],"math":[{"tex":"M,\\kappa,\\vec M\\in V","display":false},{"tex":"\\mathrm{Cardinal}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcModel9InternalApproachability}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}model9\\text{-}internal\\text{-}approachability}\\vdash\\mathrm{ZfcModel9InternalApproachability}_S(M,\\kappa)\\leftrightarrow\\mathrm{Cardinal}_S(\\kappa)\\land\\omega\\leq\\kappa\\land\\operatorname{cf}(\\kappa)=\\kappa\\land\\exists\\vec M\\;\\left(\\mathrm{Function}(\\vec M,\\kappa,\\operatorname{ran}(\\vec M))\\land M=\\bigcup_{\\alpha<\\kappa}\\vec M(\\alpha)\\land\\forall\\alpha<\\kappa\\;(\\lvert\\vec M(\\alpha)\\rvert<\\kappa)\\land\\forall\\alpha<\\beta<\\kappa\\