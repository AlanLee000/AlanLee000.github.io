\}.","display":true},{"tex":"e,x","display":false},{"tex":"\\varphi_e(y)","display":false},{"tex":"y\\le x","display":false},{"tex":"\\varphi_e(x)=1","display":false},{"tex":"f","display":false},{"tex":"W_{f(e)}=R_e","display":false},{"tex":"\\varphi_e","display":false},{"tex":"y_0","display":false},{"tex":"R_e\\subseteq\\{x:x<y_0\\}","display":false},{"tex":"R_e","display":false},{"tex":"\\varphi_e","display":false},{"tex":"R_e=\\{x:\\varphi_e(x)=1\\}","display":false},{"tex":"B\\in\\mathcal R","display":false},{"tex":"\\varphi_e=\\chi_B","display":false},{"tex":"R_e=B","display":false},{"tex":"\\{W_{f(e)}:e\\in\\omega\\}=\\mathcal R","display":false},{"tex":"f","display":false},{"tex":"\\varphi_e","display":false}],"bytes":2449,"backlinks":[],"outgoing":["fc75264a5ecdc3fb","4ef1aee16db6b308","8ba6597a854c206f","d6dc5974baa6f8a5","e343870c773cb68e"]}