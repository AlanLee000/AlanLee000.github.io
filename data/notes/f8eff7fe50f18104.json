figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}rectifiable} \\vdash \\mathrm{Rect}(A) \\leftrightarrow A\\in V\\land \\exists \\alpha\\;(\\mathrm{Ordinal}(\\alpha)\\land \\exists f\\in A^\\alpha\\;\\mathrm{Bijective}(f,\\alpha,A))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}rectifiable} \\vdash \\mathrm{Rect}(A) \\leftrightarrow A\\in V\\land \\exists \\alpha\\;(\\mathrm{Ordinal}(\\alpha)\\land \\exists f\\in A^\\alpha\\;\\mathrm{Bijective}(f,\\alpha,A))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>A set is rectifiable iff it can be well-ordered by a bijection.</li>\n<li>Finite sets are rectifiable.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch18/58-df-bijective.md","status":"resolved","id":"d583890235faf0d5","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-bijective.md]]","embed":false}],"math":[{"tex":"A\\in V","display":false},{"tex":"\\mathrm{Ordinal}","display":false},{"tex":"\\mathrm{Bijective}","display":false},{"tex":"\\mathrm{Rect}\\subseteq V","display":false},{"tex":"\\mathrm{df\\text{-}rectifiable} \\vdash \\mathrm{Rect}(A) \\leftrightarrow A\\in V\\land \\exists \\alpha\\;(\\mathrm{Ordinal}(\\alpha)\\land \\exists f\\in A^\\alpha\\;\\mathrm{Bijective}(f,\\alpha,A))","display":true}],"bytes":838,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1052","locations":["正文"],"count":1,"excerpt":"[[../batch04/58-df-rectifiable.md|58-df-rectifiable]]（batch04）"}],"outgoing":["5582a281f15a33c2","36d7463d215be751","d583890235faf0d5"]}