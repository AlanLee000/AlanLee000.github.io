rm{ZfcCompComputablyEnumerableSet}_S","display":false},{"tex":"\\omega","display":false},{"tex":"\\mathrm{ZfcRecursion4ComputableMap}_S","display":false},{"tex":"\\mathrm{Function}","display":false},{"tex":"\\mathrm{ZfcMapBijectiveMap}_S","display":false},{"tex":"\\mathrm{ZfcRecursion4EffectivelyOpenMap}_S","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}recursion4\\text{-}effectively\\text{-}open\\text{-}map}\\vdash\n\\mathrm{ZfcRecursion4EffectivelyOpenMap}_S(X,d_X,\\alpha_X,Y,d_Y,\\alpha_Y,f,\\rho,p)\\leftrightarrow\n\\mathrm{ZfcRecursion4ComputableMap}_S(X,d_X,\\alpha_X,Y,d_Y,\\alpha_Y,f)\\land\n\\mathrm{Function}(\\rho,\\omega,\\mathbb Q_{>0})\\land\n\\bigl(\\forall q\\in\\mathbb Q_{>0}\\;\\exists n\\in\\omega\\;(\\rho(n)=q)\\bigr)\\land\n\\mathrm{ZfcMapBijectiveMap}_S(p,\\omega,\\omega\\times\\omega)\\land\n\\exists W\\subseteq\\omega\\;\\Bigl(\n\\mathrm{ZfcCompComputablyEnumerableSet}_S(W)\\land\n\\forall e\\in\\omega\\;\nf\\bigl[\\{x\\in X:\\exists m,n\\in\\omega\\;(p(e)=\\langle m,n\\rangle\\land d_X(x,\\alpha_X(m))<\\rho(n))\\}\\bigr]\n=\\bigcup_{\\substack{j\\in\\omega\\\\\\langle e,j\\rangle\\in W}}\n\\{y\\in Y:\\exists r,s\\in\\omega\\;(p(j)=\\langle r,s\\rangle\\land d_Y(y,\\alpha_Y(r))<\\rho(s))\\}\n\\Bigr)","display":true},{"tex":"\\rho","display":false},{"tex":"p","display":false},{"tex":"W","display":false}],"bytes":2543,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3268","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-zfc-recursion4-effectively-open-map.md|58-df-zfc-recursion4-effectively-open-map]]（batch15）"}],"outgoing":["a3348ed9eb6fb4e3","99f12f1125ed236a","7b1ff54ac76ee59d","36d7463d215be751","85d80d720d53045b"]}