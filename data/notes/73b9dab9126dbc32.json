Q\\in\\{\\exists,\\forall\\},\\  z\\in\\mathrm{Var}_{\\mathsf O}\\cup\\mathrm{Var}_{\\mathsf N},\\ \\phi\\in\\mathcal C^j_\\tau\\}\\cup\\{(\\exists^{\\geq u}x)\\phi\\mid u\\in\\mathrm{Term}_{\\mathsf N},\\ x\\in\\mathrm{Var}_{\\mathsf O},\\ \\phi\\in\\mathcal C^j_\\tau\\}.","display":true},{"tex":"\\mathrm{Fml}_{\\mathrm{FO(COUNT)}}[\\tau]\\coloneqq\\bigcup_j\\mathcal C^j_\\tau.","display":true},{"tex":"\\operatorname{fv}(\\neg\\phi)\\coloneqq\\operatorname{fv}(\\phi),\\quad\\operatorname{fv}(\\phi\\land\\psi)\\coloneqq\\operatorname{fv}(\\phi)\\cup\\operatorname{fv}(\\psi),\\quad\\operatorname{fv}(\\exists z\\,\\phi)\\coloneqq\\operatorname{fv}(\\phi)\\setminus\\{z\\},\\quad\\operatorname{fv}((\\exists^{\\geq u}x)\\phi)\\coloneqq(\\operatorname{fv}(\\phi)\\setminus\\{x\\})\\cup\\mathsf v(u).","display":true},{"tex":"\\mathrm{Sent}_{\\mathrm{FO(COUNT)}}[\\tau]\\coloneqq\\{\\phi\\in\\mathrm{Fml}_{\\mathrm{FO(COUNT)}}[\\tau]\\mid\\operatorname{fv}(\\phi)=\\varnothing\\}.","display":true},{"tex":"⟦(\\exists^{\\geq u}x)\\phi⟧_{A^\\#,\\beta}\\coloneqq\\mathbf1_{\\operatorname{card}(\\{a\\in|A|\\mid⟦\\phi⟧_{A^\\#,\\beta[a/x]}=1\\})\\geq u^{A^\\#}[\\beta_{\\mathsf N}]}.","display":true},{"tex":"A^\\#,\\beta\\models_{\\mathrm{COUNT}}\\phi\\ \\Longleftrightarrow\\ ⟦\\phi⟧_{A^\\#,\\beta}=1,\\qquad\\phi\\in\\mathrm{Fml}_{\\mathrm{FO(COUNT)}}[\\tau].","display":true},{"tex":"A\\models_{\\mathrm{COUNT}}\\phi\\ \\Longleftrightarrow\\ \\forall\\beta\\in|A|^{\\mathrm{Var}_{\\mathsf O}}\\times N_A^{\\mathrm{Var}_{\\mathsf N}}\\;(A^\\#,\\beta\\models_{\\mathrm{COUNT}}\\phi),\\qquad\\phi\\in\\mathrm{Sent}_{\\mathrm{FO(COUNT)}}[\\tau].","display":true},{"tex":"\\mathsf v(i_j)\\coloneqq\\{i_j\\},\\qquad\\mathsf v(0_{\\mathsf N})\\coloneqq\\mathsf v(1_{\\mathsf N})\\coloneqq\\mathsf v(\\max_{\\mathsf N})\\coloneqq\\varnothing.","display":true},{"tex":"\\operatorname{fv}(s=t)\\coloneqq\\mathsf v(s)\\cup\\mathsf v(t),\\quad\\operatorname{fv}(R(\\bar t))\\coloneqq\\bigcup_i\\mathsf v(t_i),\\quad\\operatorname{fv}(u<v)\\coloneqq\\operatorname{fv}(\\mathrm{BIT}(u,v))\\coloneqq\\mathsf v(u)\\cup\\mathsf v(v).","display":true},{"tex":"\\operatorname{fv}(\\phi\\circ\\psi)\\coloneqq\\operatorname{fv}(\\phi)\\cup\\operatorname{fv}(\\psi),\\quad\\circ\\in\\{\\lor,\\to,\\leftrightarrow\\},\\qquad\\operatorname{fv}(\\forall z\\,\\phi)\\coloneqq\\operatorname{fv}(\\phi)\\setminus\\{z\\}.","display":true},{"tex":"⟦ s=t⟧_{A^\\#,\\beta}\\coloneqq\\mathbf1_{\\operatorname{val}_{A^\\#,\\beta}(s)=\\operatorname{val}_{A^\\#,\\beta}(t)},\\quad⟦ R(\\bar t)⟧_{A^\\#,\\beta}\\coloneqq\\mathbf1_{\\bar t^A[\\beta_{\\mathsf O}]\\in R^A},\\quad⟦ u<v⟧_{A^\\#,\\beta}\\coloneqq\\mathbf1_{u^{A^\\#}[\\beta_{\\mathsf N}]<v^{A^\\#}[\\beta_{\\mathsf N}]},\\quad⟦\\mathrm{BIT}(u,v)⟧_{A^\\#,\\beta}\\coloneqq\\mathbf1_{\\mathrm{BIT}(u^{A^\\#}[\\beta_{\\mathsf N}],v^{A^\\#}[\\beta_{\\mathsf N}])}.","display":true},{"tex":"⟦\\neg\\phi⟧_{A^\\#,\\beta}\\coloneqq1-⟦\\phi⟧_{A^\\#,\\beta},\\quad⟦\\phi\\land\\psi⟧_{A^\\#,\\beta}\\coloneqq\\min(⟦\\phi⟧_{A^\\#,\\beta},⟦\\psi⟧_{A^\\#,\\beta}),\\quad⟦\\exists z\\,\\phi⟧_{A^\\#,\\beta}\\coloneqq\\max_{a\\in D_z^A}⟦\\phi⟧_{A^\\#,\\beta[a/z]},\\quad D_z^A\\coloneqq\\begin{cases}|A|,&z\\in\\mathrm{Var}_{\\mathsf O},\\\\N_A,&z\\in\\mathrm{Var}_{\\mathsf N}.\\end{cases}","display":true},{"tex":"⟦\\phi\\lor\\psi⟧_{A^\\#,\\beta}\\coloneqq\\max(⟦\\phi⟧_{A^\\#,\\beta},⟦\\psi⟧_{A^\\#,\\beta}),\\quad⟦\\phi\\to\\psi⟧_{A^\\#,\\beta}\\coloneqq\\max(1-⟦\\phi⟧_{A^\\#,\\beta},⟦\\psi⟧_{A^\\#,\\beta}),\\quad⟦\\phi\\leftrightarrow\\psi⟧_{A^\\#,\\beta}\\coloneqq1-|⟦\\phi⟧_{A^\\#,\\beta}-⟦\\psi⟧_{A^\\#,\\beta}|.","display":true},{"tex":"⟦\\forall z\\,\\phi⟧_{A^\\#,\\beta}\\coloneqq\\min_{a\\in D_z^A}⟦\\phi⟧_{A^\\#,\\beta[a/z]}.","display":true},{"tex":"\\operatorname{fv}(\\top)\\coloneqq\\operatorname{fv}(\\bot)\\coloneqq\\varnothing,\\qquad⟦\\top⟧_{A^\\#,\\beta}\\coloneqq1,\\qquad⟦\\bot⟧_{A^\\#,\\beta}\\coloneqq0.","display":true},{"tex":"u","display":false},{"tex":"\\operatorname{COUNT}_x\\phi=t^A","display":false},{"tex":"n","display":false},{"tex":"0,\\ldots,n-1","display":false}],"bytes":6134,"backlinks":[{"id":"587fa3c5f12ce89b","anchor":"ref-9","locations":["正文"],"count":1,"excerpt":"原书印刷页187、扫描页202将 $C^k$ 引为附加数值常量的有限变量计数片段；这里采用其在普通有限结构比较中使用的标准单排序计数量词接口，整数阈值作为语法常量。它与 [[29-df-fo-count]] 的双排序可变量阈值逻辑分别命名，不能直接把FO的FV/BV作用于未知计数语法。固定阈值量词在无变量限制时可展开为FO，但展开一般增加变量数，故有限变量 $C^k$ 不坍缩为 $L^k$。本轮将原子基例和全部满足递归子句写入 Assertion；有限公式树递归保证各函数及真值唯一，阈值零时计数式恒真。原书页187已视觉核对，花体 $L^k$ 与 $C^k$ 不依赖 OCR 字形判别。"},{"id":"edcb3c1ba71c78c8","anchor":"ref-10","locations":["正文"],"count":1,"excerpt":"原书 Definition 12.11，印刷页186、扫描页201。数值域与对象域仅基数相同，不按元素相等识别；因此计数值不与任意对象域中的元素比较。$n=1$ 时将数值常量1解释为0是本地退化情形约定；$n\\geq2$ 时完全遵循原书。这里先给出NUMBER语法与语义，计数绑定器由 [[29-df-fo-count]] 增加。$\\lor,\\to,\\leftrightarrow,\\forall$ 是本条具有独立求值子句的实际语法构造子。"},{"id":"38909ffa6d1e85ce","anchor":"ref-99","locations":["正文"],"count":1,"excerpt":"[[29-df-fo-number]]、[[29-df-fo-count]]、[[29-df-ck]] — 双排序数值扩张与有限变量计数的不同接口"},{"id":"7be47cc899abd763","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Sent}_{\\mathrm{FO(COUNT)}}[\\tau\\cup\\{<\\}]$、$\\models_{\\mathrm{COUNT}}$ 使用 [[29-df-fo-count]] 的双排序计数逻辑；数值排序及其标准算术解释见 [[29-df-fo-number]]。"},{"id":"805a7de3b1249a36","anchor":"ref-41","locations":["正文"],"count":1,"excerpt":"[[29-df-fo-count]]"},{"id":"ecc0dd131d213345","anchor":"ref-60","locations":["正文"],"count":1,"excerpt":"[[../29-df-fo-count]]"},{"id":"bfe1be5f707cc63a","anchor":"ref-15","locations":["正文"],"count":1,"excerpt":"[[../29-df-fo-count|29-df-fo-count]]"}],"outgoing":["db2b32546860e623","edcb3c1ba71c78c8"]}