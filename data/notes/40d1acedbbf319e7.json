atus":"resolved","id":"1f6f3fb73df6e11c","anchor":"ref-13","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"外部接口 $\\mathrm{Lit}$ 取 [[57-df-literal]] 的同名定义与参数次序。","embed":false},{"target":"57-df-max-function","status":"resolved","id":"6e90892ab288d53f","anchor":"ref-14","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\{0,1\\}$ 上的二元 $\\max$ 取 [[57-df-max-function]]；两个递归返回值均为自然数。","embed":false}],"math":[{"tex":"N\\subseteq\\mathrm{Clause}_S","display":false},{"tex":"\\mathrm{Finite}(N)","display":false},{"tex":"\\mathrm{atom}","display":false},{"tex":"\\mathrm{pol}","display":false},{"tex":"\\overline L","display":false},{"tex":"v","display":false},{"tex":"\\mathrm{Atoms}(N)","display":false},{"tex":"\\mathrm{PropVar}_S\\rightharpoonup\\{0,1\\}","display":false},{"tex":"c:\\mathrm{PropVar}_S\\to\\mathbb N","display":false},{"tex":"\\ell","display":false},{"tex":"\\min_\\ell","display":false},{"tex":"\\mathrm{True}_v,\\mathrm{False}_v,\\mathrm{red},\\mathrm{Units},\\mathrm{Pure},v\\langle L\\rangle","display":false},{"tex":"R=\\mathrm{red}(N,v)","display":false},{"tex":"U=\\mathrm{Units}(R)","display":false},{"tex":"E=\\mathrm{Pure}(R)","display":false},{"tex":"L=\\min_\\ell(\\bigcup R)","display":false},{"tex":"\\mathrm{DPLL\\text{-}search}","display":false},{"tex":"\\{0,1\\}","display":false},{"tex":"|\\mathrm{Atoms}(N)\\setminus\\operatorname{dom}(v)|","display":false},{"tex":"\\mathcal P_{\\mathrm{fin}}","display":false},{"tex":"\\mathrm{Lit}","display":false},{"tex":"\\{0,1\\}","display":false},{"tex":"\\max","display":false},{"tex":"\\forall L\\in\\mathrm{Lit}_S\\quad\\ell(L)\\coloneqq2c(\\mathrm{atom}(L))+\\mathrm{pol}(L).","display":true},{"tex":"\\begin{aligned}\n\\mathrm{Atoms}(N)&\\coloneqq\\{\\mathrm{atom}(L):L\\in\\bigcup N\\},\\\\\n\\mathrm{True}_v&\\coloneqq\\{L\\in\\mathrm{Lit}_S:\\mathrm{atom}(L)\\in\\operatorname{dom}(v)\\land v(\\mathrm{atom}(L))=\\mathrm{pol}(L)\\},\\\\\n\\mathrm{False}_v&\\coloneqq\\{L\\in\\mathrm{Lit}_S:\\mathrm{atom}(L)\\in\\operatorname{dom}(v)\\land v(\\mathrm{atom}(L))\\neq\\mathrm{pol}(L)\\},\\\\\n\\mathrm{red}(N,v)&\\coloneqq\\{C\\setminus\\mathrm{False}_v:C\\in N\\land C\\cap\\mathrm{True}_v=\\emptyset\\},\\\\\n\\mathrm{Units}(R)&\\coloneqq\\{L\\in\\mathrm{Lit}_S:\\{L\\}\\in R\\},\\\\\n\\mathrm{Pure}(R)&\\coloneqq\\{L\\in\\bigcup R:\\overline L\\notin\\bigcup R\\},\\\\\nv\\langle L\\rangle&\\coloneqq v\\cup\\{\\langle\\mathrm{atom}(L),\\mathrm{pol}(L)\\rangle\\}.\n\\end{aligned}","display":true},{"tex":"\\forall E\\in\\mathcal P_{\\mathrm{fin}}(\\mathrm{Lit}_S)\\setminus\\{\\emptyset\\}\\quad\n\\min_\\ell(E)=L\\leftrightarrow L\\in E\\land\\forall M\\in E\\;(\\ell(L)\\leq\\ell(M)).","display":true},{"tex":"\\mathrm{DPLL\\text{-}search}(N,v)\\coloneqq\n\\begin{cases}\n1,&R=\\emptyset,\\\\\n0,&\\emptyset\\in R,\\\\\n\\mathrm{DPLL\\text{-}search}(N,v\\langle\\min_\\ell(U)\\rangle),&R\\neq\\emptyset\\land\\emptyset\\notin R\\land U\\neq\\emptyset,\\\\\n\\mathrm{DPLL\\text{-}search}(N,v\\langle\\min_\\ell(E)\\rangle),&R\\neq\\emptyset\\land\\emptyset\\notin R\\land U=\\emptyset\\land E\\neq\\emptyset,\\\\\n\\max\\{\\mathrm{DPLL\\text{-}search}(N,v\\langle L\\rangle),\\mathrm{DPLL\\text{-}search}(N,v\\langle\\overline L\\rangle)\\},&R\\neq\\emptyset\\land\\emptyset\\notin R\\land U=E=\\emptyset.\n\\end{cases}","display":true},{"tex":"\\mathrm{DPLL}(N)\\coloneqq\\mathrm{DPLL\\text{-}search}(N,\\emptyset).","display":true}],"bytes":3568,"backlinks":[{"id":"ca4dd8b012648fba","anchor":"ref-47","locations":["正文"],"count":1,"excerpt":"[[57-df-Lomega1omega]]\n[[57-df-S-ar]]\n[[57-df-SequentCalculus]]\n[[57-df-W-e]]\n[[57-df-abstract-logic]]\n[[57-df-acf]]\n[[57-df-arith0]]\n[[57-df-arithmetic-hierarchy]]\n[[57-df-arithmetical-hierarchy]]\n[[57-df-arity]]\n[[57-df-assignment]]\n[[57-df-atomic-formula]]\n[[57-df-axiom-rule]]\n[[57-df-axiom-sequent]]\n[[57-df-back-and-forth]]\n[[57-df-beta-function]]\n[[57-df-boolean-algebra]]\n[[57-df-bound-variable]]\n[[