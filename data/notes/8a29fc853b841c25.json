\\tau,\\mathcal A,n)\\land f\\in C^\\infty_{\\mathcal A}(M)\\to\nX[f]\\coloneqq\\{\\langle p,X(p)(f)\\rangle:p\\in M\\},\\\\\nX,Y\\in\\mathfrak X(M,\\tau,\\mathcal A,n)\\to\n[X,Y]\\coloneqq\\left\\{\\left\\langle p,\n\\{\\langle f,X(p)(Y[f])-Y(p)(X[f])\\rangle:f\\in C^\\infty_{\\mathcal A}(M)\\}\\right\\rangle:p\\in M\\right\\}.\n\\end{gathered}","display":true}],"bytes":2185,"backlinks":[{"id":"b80ea50ccf56b0ca","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"c5f44e08576c6b2e","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1366","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-vector-field.md|58-df-vector-field]]（batch18）"}],"outgoing":["71fe0dc4c8613e69","4aec613831b7dd67","36d7463d215be751","d87c5d842ade903d"]}