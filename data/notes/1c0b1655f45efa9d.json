i-link\" id=\"ref-5\" data-note=\"296e574c4ef84f16\" href=\"?note=296e574c4ef84f16\" title=\"../batch02/58-df-wellorder.md\">../batch02/58-df-wellorder.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\alpha\\in V\">\\(\\alpha\\in V\\)</span></p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Ordinal}\">\\(\\mathrm{Ordinal}\\)</span> is the ordinal predicate (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"../batch17/58-df-ordinal.md\">../batch17/58-df-ordinal.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCompComputableRelation}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcCompComputableRelation}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"d46cc386592a0ac3\" href=\"?note=d46cc386592a0ac3\" title=\"../batch18/58-df-zfc-comp-computable-relation.md\">../batch18/58-df-zfc-comp-computable-relation.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{WellOrder}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{WellOrder}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"296e574c4ef84f16\" href=\"?note=296e574c4ef84f16\" title=\"../batch02/58-df-wellorder.md\">../batch02/58-df-wellorder.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{OrderType}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{OrderType}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"5d2cd56a38a81b7a\" href=\"?note=5d2cd56a38a81b7a\" title=\"../batch11/58-df-order-type.md\">../batch11/58-df-order-type.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRecursion4ComputableOrdinal}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcRecursion4ComputableOrdinal}_S:V\\to\\{\\top,\\bot\\}\\)</span></p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{WellOrder}_S(R,X)\">\\(\\mathrm{WellOrder}_S(R,X)\\)</span> 为严格良序，参数顺序为关系、载体；不调用自反良序接口。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}recursion4\\text{-}computable\\text{-}ordinal} \\vdash \\mathrm{ZfcRecursion4ComputableOrdinal}_S(\\alpha)\\leftrightarrow \\mathrm{Ordinal}(\\alpha)\\land\\exists R\\subseteq\\omega^2\\;\\bigl(\\mathrm{ZfcCompComputableRelation}_S(R)\\land\\mathrm{WellOrder}_S(R,\\omega)\\land\\mathrm{OrderType}_S(\\alpha,\\omega,R)\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}recursion4\\text{-}computable\\text{-}ordinal} \\vdash \\mathrm{ZfcRecursion4ComputableOrdinal}_S(\\alpha)\\leftrightarrow \\mathrm{Ordinal}(\\alpha)\\land\\exists R\\subseteq\\omega^2\\;\\bigl(\\mathrm{ZfcCompComputableRelation}_S(R)\\land\\mathrm{WellOrder}_S(R,\\omega)\\land\\mathrm{OrderType}_S(\\alpha,\\omega,R)\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch11/58-df-order-type.md","status":"resolved","id":"5d2cd56a38a81b7a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-order-type.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordi