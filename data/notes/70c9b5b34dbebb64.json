开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\omega_1^{\\mathrm{CK}}\">\\(\\omega_1^{\\mathrm{CK}}\\)</span> 是递归序数的上限</li>\n<li><span class=\"math-inline\" data-tex=\"\\omega_1^{\\mathrm{CK}}\">\\(\\omega_1^{\\mathrm{CK}}\\)</span> 是第一个非递归序数</li>\n<li><span class=\"math-inline\" data-tex=\"\\omega_1^{\\mathrm{CK}}\">\\(\\omega_1^{\\mathrm{CK}}\\)</span> 是递归理论的重要界</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"88-df-recursive-ordinal","status":"resolved","id":"8235ab063b382f0f","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[88-df-recursive-ordinal]]","embed":false},{"target":"88-df-recursive-ordinal","status":"resolved","id":"8235ab063b382f0f","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{RecOrd}(\\alpha)$ (recursive-ordinal predicate, see [[88-df-recursive-ordinal]])","embed":false}],"math":[{"tex":"\\omega_1^{\\mathrm{CK}}","display":false},{"tex":"\\mathrm{RecOrd}(\\alpha)","display":false},{"tex":"\\mathrm{df\\text{-}omega\\text{-}ck\\text{-}1} \\vdash \\omega_1^{\\mathrm{CK}} \\coloneqq \\sup\\{\\alpha:\\mathrm{RecOrd}(\\alpha)\\}","display":true},{"tex":"\\omega_1^{\\mathrm{CK}}","display":false},{"tex":"\\omega_1^{\\mathrm{CK}}","display":false},{"tex":"\\omega_1^{\\mathrm{CK}}","display":false}],"bytes":728,"backlinks":[{"id":"17e23d087321028e","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{RecOrd}$ 见 [[88-df-recursive-ordinal]]；$\\omega_1^{\\mathrm{CK}}$ 见 [[88-df-omega-ck-1]]。"},{"id":"0d1300ef33ffd8df","anchor":"ref-126","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"[[88-df-omega-ck-1]]；[[88-df-recursive-ordinal]]"},{"id":"27b8db839bec5892","anchor":"ref-79","locations":["正文"],"count":1,"excerpt":