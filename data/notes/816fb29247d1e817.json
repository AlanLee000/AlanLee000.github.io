{"id":"816fb29247d1e817","group":"58","path":"58/batch10/58-df-zfc-forcing-from-ideal.md","title":"ZFC Forcing From Ideal","display":"df-zfc-forcing-from-ideal — ZFC Forcing From Ideal","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-forcing-from-ideal","aliases":["58-df-zfc-forcing-from-ideal"],"display":"df-zfc-forcing-from-ideal — ZFC Forcing From Ideal","depends_on":["[[58-ax-zfc]]","[[../batch05/58-df-ideal.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-forcing-from-ideal"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-forcing-from-ideal</span></div>"},{"key":"display","html":"df-zfc-forcing-from-ideal — ZFC Forcing From Ideal"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"6e4f95381faac4f9\" href=\"?note=6e4f95381faac4f9\" title=\"../batch05/58-df-ideal.md\">../batch05/58-df-ideal.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathbb{P},I,X\\in V\">\\(\\mathbb{P},I,X\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ideal}:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Ideal}:V^2\\to\\{\\top,\\bot\\}\\)</span> (ideal predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"6e4f95381faac4f9\" href=\"?note=6e4f95381faac4f9\" title=\"../batch05/58-df-ideal.md\">../batch05/58-df-ideal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ForcingFromIdeal}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ForcingFromIdeal}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure cla