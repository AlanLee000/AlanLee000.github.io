ame{Val},\\operatorname{Sat})\n\\land\\forall x,y\\in X\\;\\forall s\\;\\Bigl(\n\\mathrm{Assign}(\\mathcal M,s)\\land s(v_0)=x\\land s(v_1)=y\\land s(v_2)=p\\\\\n&\\hspace{8em}\\to\n\\bigl(\\langle x,y\\rangle\\in R\\leftrightarrow\\operatorname{Sat}(\\varphi,s)\\bigr)\n\\Bigr)\\Bigr)\n\\end{aligned}\\right].","display":true}],"bytes":2399,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1786","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-zfc-definable-wellorder.md|58-df-zfc-definable-wellorder]]（batch15）"}],"outgoing":["a3348ed9eb6fb4e3","1d0b2b70d1c22cc7","65418b505fc53093","8b6a90316aad78a4","64f35ba2e87964e0","715a32e91161b34f","d9b8711cda3f31ca"]}