\\omega\\land A\\subseteq\\omega).","display":true},{"tex":"\\varphi_e\\coloneqq\\Phi_e^\\varnothing,\\qquad\\Phi_e\\coloneqq\\varphi_e,\\qquad W_e\\coloneqq\\operatorname{dom}(\\varphi_e)\\qquad(e\\in\\omega).","display":true},{"tex":"\\bigl(\\varphi_e(x)\\simeq y\\bigr)\\leftrightarrow\\langle x,y\\rangle\\in\\varphi_e,\\qquad\n\\bigl(\\Phi_e^A(x)\\downarrow=y\\bigr)\\leftrightarrow\\langle x,y\\rangle\\in\\Phi_e^A.","display":true},{"tex":"\\bigl(\\Phi_e^A(x)\\downarrow\\bigr)\\leftrightarrow\\exists y\\in\\omega\\;\\langle x,y\\rangle\\in\\Phi_e^A,\n\\qquad\\bigl(\\varphi_e(x)\\downarrow\\bigr)\\leftrightarrow x\\in\\operatorname{dom}(\\varphi_e).","display":true},{"tex":"\\forall c\\in\\omega\\;\\exists!\\langle a,b\\rangle\\in\\omega\\times\\omega\\;\n\\bigl(\\operatorname{NatPair}_{58}(a,b)=c\\bigr).","display":true},{"tex":"\\operatorname{PairLeft}_{58}(c)\\coloneqq\n\\iota a\\in\\omega\\;\\exists b\\in\\omega\\;\\bigl(\\operatorname{NatPair}_{58}(a,b)=c\\bigr).","display":true},{"tex":"\\operatorname{PairRight}_{58}(c)\\coloneqq\n\\iota b\\in\\omega\\;\\exists a\\in\\omega\\;\\bigl(\\operatorname{NatPair}_{58}(a,b)=c\\bigr).","display":true},{"tex":"\\forall e\\in\\omega\\;\\forall A\\subseteq\\omega\\;\n\\mathrm{PartialFunction}(\\Phi_e^A,\\omega,\\omega).","display":true},{"tex":"\\operatorname{BaireOracleCode}_{58}(p)\\coloneqq\n\\{\\operatorname{NatPair}_{58}(n,p(n)):n\\in\\omega\\}\n\\qquad(p\\in\\omega^\\omega).","display":true},{"tex":"\\varphi_e^p\\coloneqq\\Phi_e^{\\operatorname{BaireOracleCode}_{58}(p)}\n\\qquad(e\\in\\omega\\land p\\in\\omega^\\omega).","display":true},{"tex":"\\bigl(\\varphi_e^p(n)\\downarrow=y\\bigr)\\leftrightarrow\n\\langle n,y\\rangle\\in\\varphi_e^p.","display":true}],"bytes":6110,"backlinks":[{"id":"9f2b96b6284f9981","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{RegisterEvaluation}_{58}$ 由 [[../batch08/58-df-effective-program-coding.md]] 给出。"},{"id":"f032216255883436","anchor":"ref-8