tarrow\\operatorname{TopologicalSpace}_S(X,\\tau_X)\\land\\operatorname{TopologicalSpace}_S(Y,\\tau_Y)\\land\\exists\\mathcal C,S\\in V\\;\\Bigl[\\mathcal C=\\{f\\in\\mathcal P(X\\times Y):\\mathrm{Function}(f,X,Y)\\land\\operatorname{Continuous}_S(f,X,\\tau_X,Y,\\tau_Y)\\}\\land\\mathrm{ZfcTop3CompactOpenSubbasis}_S(X,\\tau_X,Y,\\tau_Y,S)\\land\\mathrm{ZfcTopSubbase}_S(S,\\mathcal C,\\sigma)\\Bigr]","display":true},{"tex":"\\sigma","display":false}],"bytes":1857,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3553","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-df-zfc-top3-compact-open-topology.md|58-df-zfc-top3-compact-open-topology]]（batch20）"}],"outgoing":["a3348ed9eb6fb4e3","4abdb0543c46f591","d6956c8a704f51c7","815e63e5071e7b58","3cd1834de4f2efb2","36d7463d215be751"]}