,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2592","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-df-zfc-measure4-essential-infimum.md|58-df-zfc-measure4-essential-infimum]]（batch20）"}],"outgoing":["a3348ed9eb6fb4e3","ca832ed6bc22f728","2aa29158e60b337f","83a15c7e9b3817dc","bbbec05fde1d3b01"]}