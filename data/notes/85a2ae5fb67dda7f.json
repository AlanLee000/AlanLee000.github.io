","display":false},{"tex":"\\mathrm{StructuredInjectiveModule}_S,\\mathrm{BaerExtensionCondition}_S\\subseteq V^9","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}baer\\text{-}structured\\text{-}injective}\\vdash\n\\mathrm{StructuredInjectiveModule}_S(E,R,+_E,0_E,\\odot_E,+_R,\\cdot_R,0_R,1_R)\\\\\n&\\quad\\leftrightarrow\n\\mathrm{Module}_S(E,R,+_E,0_E,+_R,\\cdot_R,0_R,1_R,\\odot_E)\\land\n\\forall M,N,+_M,0_M,\\odot_M,+_N,0_N,\\odot_N,i,f\\in V\\;\\Bigl(\\\\\n&\\qquad\\mathrm{Module}_S(M,R,+_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot_M)\n\\land\\mathrm{Module}_S(N,R,+_N,0_N,+_R,\\cdot_R,0_R,1_R,\\odot_N)\\\\\n&\\qquad\\land\\mathrm{Function}(i,M,N)\n\\land\\forall x,y\\in M\\;\\bigl(i(x+_My)=i(x)+_Ni(y)\\bigr)\n\\land\\forall r\\in R\\;\\forall x\\in M\\;\\bigl(i(r\\odot_Mx)=r\\odot_Ni(x)\\bigr)\\\\\n&\\qquad\\land\\forall x,y\\in M\\;\\bigl(i(x)=i(y)\\to x=y\\bigr)\n\\land\\mathrm{Function}(f,M,E)\n\\land\\forall x,y\\in M\\;\\bigl(f(x+_My)=f(x)+_Ef(y)\\bigr)\\\\\n&\\qquad\\land\\forall r\\in R\\;\\forall x\\in M\\;\\bigl(f(r\\odot_Mx)=r\\odot_Ef(x)\\bigr)\\\\\n&\\qquad\\to\\exists g\\in V\\;\\Bigl(\n\\mathrm{Function}(g,N,E)\n\\land\\forall x,y\\in N\\;\\bigl(g(x+_Ny)=g(x)+_Eg(y)\\bigr)\\\\\n&\\hspace{54mm}\\land\\forall r\\in R\\;\\forall x\\in N\\;\\bigl(g(r\\odot_Nx)=r\\odot_Eg(x)\\bigr)\n\\land\\forall x\\in M\\;\\bigl(g(i(x))=f(x)\\bigr)\n\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}baer\\text{-}extension\\text{-}condition}\\vdash\n\\mathrm{BaerExtensionCondition}_S(E,R,+_E,0_E,\\odot_E,+_R,\\cdot_R,0_R,1_R)\\\\\n&\\quad\\leftrightarrow\n\\mathrm{Module}_S(E,R,+_E,0_E,+_R,\\cdot_R,0_R,1_R,\\odot_E)\\land\n\\forall I,f\\in V\\;\\Bigl(\\\\\n&\\qquad\\operatorname{LeftIdeal}_S(I;R,+_R,\\cdot_R,0_R,1_R)\n\\land\\mathrm{Function}(f,I,E)\n\\land\\forall x,y\\in I\\;\\bigl(f(x+_Ry)=f(x)+_Ef(y)\\bigr)\\\\\n&\\qquad\\land\\forall r\\in R\\;\\forall x\\in I\\;\\bigl(f(r\\cdot_Rx)=r\\odot_Ef(x)\\bigr)\\\\\n&\\qquad\\to\\exists g\\in V\\;\\Bigl(\n\\mathrm{Function}(g,R,E)\n\\land\\forall x,y\\in R\\;\\bigl(g(x+_Ry)=g(x)+_Eg(y)\\bigr)\\\\\n&\\hspace{54mm}\\land\\forall r,x\\in R\\;\\bigl(g(r\\cdot_Rx)=r\\odot_Eg(x)\\bigr)\n\\land\\forall x\\in I\\;\\bigl(g(x)=f(x)\\bigr)\n\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{thm\\text{-}baer\\text{-}criterion}\\vdash\n\\mathrm{StructuredInjectiveModule}_S(E,R,+_E,0_E,\\odot_E,+_R,\\cdot_R,0_R,1_R)\n\\leftrightarrow\n\\mathrm{BaerExtensionCondition}_S(E,R,+_E,0_E,\\odot_E,+_R,\\cdot_R,0_R,1_R)","display":true},{"tex":"R","display":false},{"tex":"R","display":false},{"tex":"R=\\mathbb Z","display":false},{"tex":"E","display":false},{"tex":"\\operatorname{Module}(E,R)","display":false},{"tex":"I\\leq{}_RR","display":false},{"tex":"\\operatorname{Hom}_R(-,-)","display":false},{"tex":"g|_I","display":false}],"bytes":3802,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4036","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-thm-baer-criterion.md|58-thm-baer-criterion]]（batch02）"}],"outgoing":["ef3a5dd6825f0373","1c30d21ea7b443f6","e6a1ed8511f909f2","36d7463d215be751"]}