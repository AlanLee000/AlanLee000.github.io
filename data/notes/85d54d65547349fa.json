\mathcal T","display":false},{"tex":"\\iota,\\mathfrak k","display":false},{"tex":"\\langle T_1,\\kappa_1\\rangle\\preceq_{\\operatorname{Con}}^{B,\\iota}\\langle T_2,\\kappa_2\\rangle\\ :\\Longleftrightarrow\\ B\\vdash_2^{(\\iota)}\\bigl[\\operatorname{Con}_{\\kappa_2}(T_2)\\to\\operatorname{Con}_{\\kappa_1}(T_1)\\bigr].","display":true},{"tex":"U\\le_{\\operatorname{Con}}^{B,\\iota,\\mathfrak k}V\\ :\\Longleftrightarrow\\ \\langle U,\\mathfrak k(U)\\rangle\\preceq_{\\operatorname{Con}}^{B,\\iota}\\langle V,\\mathfrak k(V)\\rangle.","display":true},{"tex":"U\\le_{\\operatorname{Con}}^B V\\ :\\Longleftrightarrow\\ U\\le_{\\operatorname{Con}}^{B,\\iota,\\mathfrak k}V.","display":true},{"tex":"U\\equiv_{\\operatorname{Con}}^B V\\ :\\Longleftrightarrow\\ U\\le_{\\operatorname{Con}}^B V\\land V\\le_{\\operatorname{Con}}^B U.","display":true},{"tex":"\\forall U\\in\\mathcal T\\quad U\\le_{\\operatorname{Con}}^B U.","display":true},{"tex":"\\forall U,V,W\\in\\mathcal T\\quad\nU\\le_{\\operatorname{Con}}^B V\\land V\\le_{\\operatorname{Con}}^B W\\Rightarrow U\\le_{\\operatorname{Con}}^B W.","display":true}],"bytes":3079,"backlinks":[{"id":"4d85a6a31705a214","anchor":"ref-286","locations":["正文"],"count":1,"excerpt":"[[./72-df-consistency-strength|df-consistency-strength — Consistency Strength]]"}],"outgoing":["4c14656043bc77c1","b63a805280ad1d8e"]}