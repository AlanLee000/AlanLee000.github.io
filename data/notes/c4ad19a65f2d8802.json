)\\land\\mathrm{PresFinProd}(p).","display":true},{"tex":"1","display":false},{"tex":"T_1","display":false},{"tex":"X","display":false},{"tex":"pX\\to1","display":false},{"tex":"T_1","display":false},{"tex":"X\\in\\mathcal E_I,Y\\in\\mathcal E_J","display":false},{"tex":"I\\times J","display":false},{"tex":"P=\\pi_1^*X\\times\\pi_2^*Y","display":false},{"tex":"P\\to X,Y","display":false},{"tex":"P","display":false},{"tex":"p","display":false}],"bytes":1847,"backlinks":[{"id":"1bdcb9b14f83cac1","anchor":"ref-394","locations":["正文"],"count":1,"excerpt":"[[16-prop-fibre-global|prop-fibrewise-to-total-products]]"}],"outgoing":["eb3d8d8bfc151af6","b75e7c168ac56b22","8b663a0efd45aead","ee7c0663947fd7d2"]}