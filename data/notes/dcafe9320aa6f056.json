{"id":"dcafe9320aa6f056","group":"58","path":"58/batch05/58-df-homflypt-polynomial.md","title":"HOMFLYPT Polynomial","display":"df-homflypt-polynomial — HOMFLYPT Polynomial","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-homflypt-polynomial","aliases":["58-df-homflypt-polynomial"],"display":"df-homflypt-polynomial — HOMFLYPT Polynomial","depends_on":["[[58-df-skein-relation]]","[[../batch19/58-df-laurent-polynomial.md]]","[[../batch16/58-df-function.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-homflypt-polynomial"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-homflypt-polynomial</span></div>"},{"key":"display","html":"df-homflypt-polynomial — HOMFLYPT Polynomial"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4396538a738cd422\" href=\"?note=4396538a738cd422\" title=\"58-df-skein-relation\">58-df-skein-relation</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"646322422ec21b3d\" href=\"?note=646322422ec21b3d\" title=\"../batch19/58-df-laurent-polynomial.md\">../batch19/58-df-laurent-polynomial.md</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal L,\\mathcal S,O,\\Phi\\in V\">\\(\\mathcal L,\\mathcal S,O,\\Phi\\in V\\)</span> with <span class=\"math-inline\" data-tex=\"\\mathcal S\\subseteq\\mathcal L^3\">\\(\\mathcal S\\subseteq\\mathcal L^3\\)</span> and <span class=\"math-inline\" data-tex=\"O\\in\\mathcal L\">\\(O\\in\\mathcal L\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{LaurentPolynomialRingStructure}_S\\subseteq V^{11}\">\\(\\mathrm{LaurentPolynomialRingStructure}_S\\subseteq V^{11}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{LaurentMonomial}_S\\subseteq V^9\">\\(\\mathrm{LaurentMonomial}_S\\subseteq V^9\\)</span> (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"646322422ec21b3d\" href=\"?note=646322422ec21b3d\" title=\"../batch19/58-df-laurent-polynomial.md\">../batch19/58-df-laurent-polynomial.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{HOMFLYPTSkein}_S\\subseteq V^{13}\">\\(\\mathrm{HOMFLYPTSkein}_S\\subseteq V^{13}\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"4396538a738cd422\" href=\"?note=4396538a738cd422\" title=\"58-df-skein-relation\">58-df-skein-relation</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{HOMFLYPTPolynomial}_S\\subseteq V^4\">\\(\\mathrm{HOMFLYPTPolynomial}_S\\subseteq V^4\\)</span> (normalized candidate invariant defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}homflypt\\text{-}polynomial}\\vdash\n\\mathrm{HOMFLYPTPolynomial}_S(\\Phi,\\mathcal L,\\mathcal S,O)\\\\\n\\leftrightarrow{}&amp;\n\\mathcal S\\subseteq\\mathcal L^3\\land O\\in\\mathcal L\\\\\n&amp;\\land\\exists P,+_P,\\cdot_P,0_P,1_P,a_+,a_-,z\\in V\\;\\Bigl(\n\\mathrm{LaurentPolynomialRingStructure}_S\n(P,+_P,\\cdot_P,0_P,1_P,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{LaurentMonomial}_S\n(a_+,1_{\\mathbb Z},\\langle1,0\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{LaurentMonomial}_S\n(a_-,1_{\\mathbb Z},\\langle-1,0\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{LaurentMonomial}_S\n(z,1_{\\mathbb Z},\\langle0,1\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{Function}(\\Phi,\\mathcal L,P)\n\\land\\Phi(O)=1_P\\\\\n&amp;\\quad\\land\\forall\\langle L_+,L_-,L_0\\rangle\\in\\mathcal S\\;\n\\mathrm{HOMFLYPTSkein}_S\n(\\Phi,\\mathcal L,L_+,L_-,L_0;P,+_P,\\cdot_P,0_P,1_P,a_+,a_-,z)\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}homflypt\\text{-}polynomial}\\vdash\n\\mathrm{HOMFLYPTPolynomial}_S(\\Phi,\\mathcal L,\\mathcal S,O)\\\\\n\\leftrightarrow{}&amp;\n\\mathcal S\\subseteq\\mathcal L^3\\land O\\in\\mathcal L\\\\\n&amp;\\land\\exists P,+_P,\\cdot_P,0_P,1_P,a_+,a_-,z\\in V\\;\\Bigl(\n\\mathrm{LaurentPolynomialRingStructure}_S\n(P,+_P,\\cdot_P,0_P,1_P,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{LaurentMonomial}_S\n(a_+,1_{\\mathbb Z},\\langle1,0\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{LaurentMonomial}_S\n(a_-,1_{\\mathbb Z},\\langle-1,0\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{LaurentMonomial}_S\n(z,1_{\\mathbb Z},\\langle0,1\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&amp;\\quad\\land\\mathrm{Function}(\\Phi,\\mathcal L,P)\n\\land\\Phi(O)=1_P\\\\\n&amp;\\quad\\land\\forall\\langle L_+,L_-,L_0\\rangle\\in\\mathcal S\\;\n\\mathrm{HOMFLYPTSkein}_S\n(\\Phi,\\mathcal L,L_+,L_-,L_0;P,+_P,\\cdot_P,0_P,1_P,a_+,a_-,z)\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The HOMFLYPT invariant takes values in the two-variable Laurent-polynomial ring <span class=\"math-inline\" data-tex=\"\\mathbb Z[a^{\\pm1},z^{\\pm1}]\">\\(\\mathbb Z[a^{\\pm1},z^{\\pm1}]\\)</span>, not in the ordinary polynomial carrier.</li>\n<li>The relation characterizes normalized candidates relative to the supplied link set and skein-triple set; existence, uniqueness, and Reidemeister invariance require separate theorems.</li>\n<li>Specialization of <span class=\"math-inline\" data-tex=\"\\Phi(L)\">\\(\\Phi(L)\\)</span> at suitable Laurent variables produces multiple known invariants.</li>\n<li>Skein relation encodes Reidemeister moves.</li>\n<li>Volume conjecture relates to hyperbolic geometry.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-skein-relation","status":"resolved","id":"4396538a738cd422","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-skein-relation]]","embed":false},{"target":"../batch19/58-df-laurent-polynomial.md","status":"resolved","id":"646322422ec21b3d","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch19/58-df-laurent-polynomial.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch19/58-df-laurent-polynomial.md","status":"resolved","id":"646322422ec21b3d","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{LaurentPolynomialRingStructure}_S\\subseteq V^{11}$ and $\\mathrm{LaurentMonomial}_S\\subseteq V^9$ (see [[../batch19/58-df-laurent-polynomial.md]])","embed":false},{"target":"58-df-skein-relation","status":"resolved","id":"4396538a738cd422","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{HOMFLYPTSkein}_S\\subseteq V^{13}$ (see [[58-df-skein-relation]])","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}\\subseteq V^3$ (see [[../batch16/58-df-function.md]])","embed":false}],"math":[{"tex":"\\mathcal L,\\mathcal S,O,\\Phi\\in V","display":false},{"tex":"\\mathcal S\\subseteq\\mathcal L^3","display":false},{"tex":"O\\in\\mathcal L","display":false},{"tex":"\\mathrm{LaurentPolynomialRingStructure}_S\\subseteq V^{11}","display":false},{"tex":"\\mathrm{LaurentMonomial}_S\\subseteq V^9","display":false},{"tex":"\\mathrm{HOMFLYPTSkein}_S\\subseteq V^{13}","display":false},{"tex":"\\mathrm{Function}\\subseteq V^3","display":false},{"tex":"\\mathrm{HOMFLYPTPolynomial}_S\\subseteq V^4","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}homflypt\\text{-}polynomial}\\vdash\n\\mathrm{HOMFLYPTPolynomial}_S(\\Phi,\\mathcal L,\\mathcal S,O)\\\\\n\\leftrightarrow{}&\n\\mathcal S\\subseteq\\mathcal L^3\\land O\\in\\mathcal L\\\\\n&\\land\\exists P,+_P,\\cdot_P,0_P,1_P,a_+,a_-,z\\in V\\;\\Bigl(\n\\mathrm{LaurentPolynomialRingStructure}_S\n(P,+_P,\\cdot_P,0_P,1_P,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&\\quad\\land\\mathrm{LaurentMonomial}_S\n(a_+,1_{\\mathbb Z},\\langle1,0\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&\\quad\\land\\mathrm{LaurentMonomial}_S\n(a_-,1_{\\mathbb Z},\\langle-1,0\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&\\quad\\land\\mathrm{LaurentMonomial}_S\n(z,1_{\\mathbb Z},\\langle0,1\\rangle,\\mathbb Z,+_{\\mathbb Z},\\cdot_{\\mathbb Z},0_{\\mathbb Z},1_{\\mathbb Z},2)\\\\\n&\\quad\\land\\mathrm{Function}(\\Phi,\\mathcal L,P)\n\\land\\Phi(O)=1_P\\\\\n&\\quad\\land\\forall\\langle L_+,L_-,L_0\\rangle\\in\\mathcal S\\;\n\\mathrm{HOMFLYPTSkein}_S\n(\\Phi,\\mathcal L,L_+,L_-,L_0;P,+_P,\\cdot_P,0_P,1_P,a_+,a_-,z)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathbb Z[a^{\\pm1},z^{\\pm1}]","display":false},{"tex":"\\Phi(L)","display":false}],"bytes":2546,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-636","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-homflypt-polynomial.md|58-df-homflypt-polynomial]]（batch05）"}],"outgoing":["4396538a738cd422","646322422ec21b3d","36d7463d215be751"]}