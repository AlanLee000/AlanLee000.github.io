\alpha,\\mathbb P)\n\\land\\mathrm{CheckName}_S(\\check\\beta,\\beta,\\mathbb P)\\\\\n&\\hspace{185pt}\\land\n\\mathrm{Function}(\\vec\\sigma,2,M)\n\\land\\vec\\sigma(0)=\\check\\alpha\n\\land\\vec\\sigma(1)=\\check\\beta\n\\land\\forall p\\in\\mathbb P\\;\n\\mathrm{ZfcForcingRelation}_S\n(M,p,\\varphi_{\\mathrm{cf}},\\vec\\sigma,\\mathbb P,\\leq_{\\mathbb P})\n\\Bigr)\\Bigr)\n\\Biggr].\n\\end{aligned}","display":true},{"tex":"M","display":false},{"tex":"M","display":false},{"tex":"\\mathrm{CCC}(\\mathbb P,\\leq_{\\mathbb P})","display":false},{"tex":"M","display":false},{"tex":"V","display":false}],"bytes":3437,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-36","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-cor-ccc-pres.md|58-cor-ccc-pres]]（batch14）"}],"outgoing":["937fc0dd4cc72948","5fb1c2241d1943d1","315ad00b8744fdfc","5582a281f15a33c2","911508dbd8495663","66d43bb76d055059","d29823616dbc5931","65418b505fc53093","715a32e91161b34f"]}