\\mathrm{Rel}_2\n\\land I^{\\mathfrak X}_{\\mathrm{rel},2}(\\dot\\in)\n=\\{a\\in X^2:a(0)\\in a(1)\\}\\\\\n&\\hspace{6em}\\land\\dot A\\in\\mathcal L_{\\in,\\dot A}.\\mathrm{Rel}_1\n\\land I^{\\mathfrak X}_{\\mathrm{rel},1}(\\dot A)=\\{a\\in X^1:a(0)\\in P\\cap X\\}\n\\land\\mathrm{DefinableSubset}_S(D,\\mathfrak X,\\mathcal L_{\\in,\\dot A})\n\\bigr)\\Bigr\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}inner3\\text{-}relative\\text{-}constructible\\text{-}zero} \\vdash\n\\bigl(\\forall a\\in A\\;\\mathrm{Ordinal}(a)\\bigr)\\to L_0[A]=\\varnothing","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}inner3\\text{-}relative\\text{-}constructible\\text{-}successor} \\vdash\n\\bigl(\\forall a\\in A\\;\\mathrm{Ordinal}(a)\\bigr)\\land\\mathrm{Ordinal}(\\alpha)\n\\to L_{\\alpha+1}[A]=\\operatorname{Def}_{\\in,\\dot A}(L_\\alpha[A];A\\cap L_\\alpha[A])","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}inner3\\text{-}relative\\text{-}constructible\\text{-}limit} \\vdash\n\\bigl(\\forall a\\in A\\;\\mathrm{Ordinal}(a)\\bigr)\\land\\mathrm{Limit}(\\lambda)\n\\to L_\\lambda[A]=\\bigcup_{\\beta\\in\\lambda}L_\\beta[A]","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}inner3\\text{-}relative\\text{-}constructible\\text{-}universe} \\vdash\n\\mathrm{ZfcInner3RelativeConstructibleUniverse}_S(x,A)\n\\leftrightarrow\n\\bigl(\\forall a\\in A\\;\\mathrm{Ordinal}(a)\\bigr)\n\\land\\exists\\alpha\\in V\\;\\bigl(\\mathrm{Ordinal}(\\alpha)\\land x\\in L_\\alpha[A]\\bigr)","display":true},{"tex":"L_\\alpha[A]","display":false},{"tex":"\\alpha","display":false},{"tex":"L[A]","display":false},{"tex":"V","display":false},{"tex":"A","display":false},{"tex":"\\varnothing","display":false},{"tex":"A\\cap L_\\alpha[A]","display":false},{"tex":"\\alpha","display":false},{"tex":"A","display":false},{"tex":"\\operatorname{Def}_{\\in,\\dot A}","display":false},{"tex":"\\operatorname{Def}(X;P)","display":false}],"bytes":4212,"backlinks":[{"id":"62983ac7