{"id":"58005c7991d3483d","group":"58","path":"58/batch05/58-prop-subset-definition.md","title":"Subset Definition","display":"prop-subset-definition — Subset Definition","type":"proposition","metadata":{"type":"proposition","book":"Set Theory","book_abbrev":"58","label":"58-prop-subset-definition","aliases":["58-prop-subset-definition"],"display":"prop-subset-definition — Subset Definition","depends_on":["[[58-df-subset]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"proposition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-prop-subset-definition"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-prop-subset-definition</span></div>"},{"key":"display","html":"prop-subset-definition — Subset Definition"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"d35b78cf8312c12b\" href=\"?note=d35b78cf8312c12b\" title=\"58-df-subset\">58-df-subset</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"A,B\\in V\">\\(A,B\\in V\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{prop\\text{-}subset\\text{-}definition} \\vdash A\\subseteq B\\leftrightarrow\\forall x\\in V\\;(x\\in A\\to x\\in B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{prop\\text{-}subset\\text{-}definition} \\vdash A\\subseteq B\\leftrightarrow\\forall x\\in V\\;(x\\in A\\to x\\in B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"A \\subseteq B\">\\(A \\subseteq B\\)</span> means every element of <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> is also an element of <span class=\"math-inline\" data-tex=\"B\">\\(B\\)</span>.</li>\n<li>This is the reflexive and transitive inclusion relation.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-subset","status":"resolved","id":"d35b78cf8312c12b","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-subset]]","embed":false}],"math":[{"tex":"A,B\\in V","display":false},{"tex":"\\mathrm{prop\\text{-}subset\\text{-}definition} \\vdash A\\subseteq B\\leftrightarrow\\forall x\\in V\\;(x\\in A\\to x\\in B)","display":true},{"tex":"A \\subseteq B","display":false},{"tex":"A","display":false},{"tex":"B","display":false}],"bytes":612,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3999","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-prop-subset-definition.md|58-prop-subset-definition]]（batch05）"}],"outgoing":["d35b78cf8312c12b"]}