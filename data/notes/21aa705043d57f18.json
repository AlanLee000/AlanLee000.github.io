ngle b,X,t,\\omega\\rangle)\n+J(\\langle\\sigma,X,B,t,\\omega\\rangle)\\right\\}\\right)=1.\n\\end{aligned}","display":true},{"tex":"L(\\langle b,X,t,\\omega\\rangle)","display":false},{"tex":"J(\\langle\\sigma,X,B,t,\\omega\\rangle)","display":false},{"tex":"\\int_0^t \\sigma\\,dB","display":false}],"bytes":2597,"backlinks":[{"id":"ab4b1709840d87d4","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{SDESolution}_S\\subseteq V^9$ (see [[58-df-sde]])"},{"id":"84daad544872cc71","anchor":"ref-1120","locations":["正文"],"count":1,"excerpt":"[[../batch09/58-df-sde.md|58-df-sde]]（batch09）"}],"outgoing":["948f8f3178040b74","6493b2eeaa7f968f","0578a357a86e9d8f","20d69bde348c5967","36d7463d215be751"]}