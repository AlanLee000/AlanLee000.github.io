{BC}(\\{h_\\alpha\\mid\\alpha\\in\\mathcal O_\\infty\\}\\cup\\{c_i\\mid i\\in J\\}),\\\\\n\\mathrm{ev}&:\\mathsf{Expr}_B\\to\\mathrm{Fml}_{0,1},\\\\\n\\mathrm{ev}(h_\\alpha)&\\coloneqq H_\\alpha,\\quad\n\\mathrm{ev}(c_i)\\coloneqq C_i,\\quad\\mathrm{ev}(\\bot)\\coloneqq\\bot,\\\\\n\\mathrm{ev}(\\neg e)&\\coloneqq\\neg\\mathrm{ev}(e),\\quad\n\\mathrm{ev}(e\\land g)\\coloneqq\\mathrm{ev}(e)\\land\\mathrm{ev}(g),\\\\\n\\mathcal C_B&\\coloneqq\n\\{(1,\\alpha,i)\\mid\\alpha\\in\\mathcal O_\\infty,i\\in J\\}\\\\\n&\\quad\\cup\\{(2,\\alpha,\\beta,i)\\mid\\alpha\\in\\mathcal O_\\infty,\\alpha>\\beta,\\beta\\in\\mathcal O,i\\in J\\}\\\\\n&\\quad\\cup\\{(3,\\alpha,\\beta,i,j)\\mid\\alpha\\in\\mathcal O_\\infty,\\alpha>\\beta,\\beta\\in\\mathcal O,\ni\\in J,\\ j\\in\\omega\\setminus\\{0\\},\\ i>j,\\ d\\alpha,d\\beta\\ge j\\},\\\\\n\\Phi(1,\\alpha,i)&\\coloneqq\\neg H_\\alpha\\lor\\neg C_i,\\\\\n\\Phi(2,\\alpha,\\beta,i)&\\coloneqq\\neg H_\\alpha\\lor H_\\beta\\lor\\neg C_i,\\\\\n\\Phi(3,\\alpha,\\beta,i,j)&\\coloneqq\\neg H_\\alpha\\lor H_\\beta\\lor\\neg C_i\\lor C_j,\\\\\n\\mathsf{NF}_B&\\coloneqq\\{\\bigwedge\\langle\\Phi(s_k)\\mid k<|s|\\rangle\\mid s\\in\\mathcal C_B^{<\\omega}\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{Var}_B","display":false},{"tex":"\\alpha","display":false},{"tex":"\\mathcal O_\\infty","display":false},{"tex":"J","display":false},{"tex":"\\infty","display":false},{"tex":"\\mathrm{ev}(\\mathsf{Expr}_B)","display":false},{"tex":"\\infty","display":false},{"tex":"\\top","display":false},{"tex":"\\bot","display":false},{"tex":"\\top","display":false}],"bytes":3312,"backlinks":[{"id":"6e228478af514c07","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"0413066aa327a245","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"17034fdfe7fbba71","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"05a599f85e508061","anchor":"ref-91","locations":["正文"],"count":2,"excerpt":"[[89-df-glb-letterless-normal-form]]"},{"id":"e0c421a5b45aeb77","anchor":"ref-193","locations":["正文"],"count":2,"excerpt":"正规化：[[89-df-glb-letterless-normal-form]] → [[89-lem-glb-nice-normalization]] → [[89-lem-glb-second-box-boolean]] → [[89-lem-glb-normal-box-reduction]] → [[89-thm-glb-letterless-normal-form]] → [[89-cor-glb-letterless-truth-decision]]。算例：[[89-ex-glb-normal-form-reduction]]。"}],"outgoing":["8de2ffea9eb2c928","a6d483dd2c6fd176","0716e09b34db523d","0b3c8928cef7eaa4"]}