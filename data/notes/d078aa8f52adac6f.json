"display":true},{"tex":"\\mathsf{Subst}_{617}=\n\\{\\sigma:\\mathsf{Prop}\\to\\mathsf{Frm}_{617}:\n\\{p\\in\\mathsf{Prop}:\\sigma(p)\\ne\\operatorname{atom}(p)\\}\\in\\mathcal P_{\\mathrm{fin}}(\\mathsf{Prop})\\}.","display":true},{"tex":"\\sigma\\in\\mathsf{Subst}_{617}","display":false},{"tex":"\\operatorname{Sub}_{617}(\\sigma,A)=\\widehat\\sigma(A)","display":false},{"tex":"\\widehat\\sigma(\\operatorname{atom}(p))=\\sigma(p),\\quad\n\\widehat\\sigma(\\bot)=\\bot,\\quad\n\\widehat\\sigma(\\neg A)=\\neg\\widehat\\sigma(A),","display":true},{"tex":"\\widehat\\sigma(A\\to B)=\\widehat\\sigma(A)\\to\\widehat\\sigma(B),","display":true},{"tex":"\\widehat\\sigma(A\\Rightarrow_f B)=\\widehat\\sigma(A)\\Rightarrow_f\\widehat\\sigma(B).","display":true},{"tex":"\\operatorname{Sub}_{617}:\\mathsf{Subst}_{617}\\times\\mathsf{Frm}_{617}\\to\\mathsf{Frm}_{617},\\qquad\n\\operatorname{Sub}_{617}(\\sigma,A)=\\widehat\\sigma(A).","display":true},{"tex":"\\operatorname{BV}_{617}:\\mathsf{Frm}_{617}\\to\\{\\varnothing\\}","display":true},{"tex":"\\operatorname{BV}_{617}(A)=\\varnothing","display":false},{"tex":"A\\equiv_{\\alpha,617}B","display":false},{"tex":"A=B","display":false},{"tex":"\\mathsf{Ax}_{\\to,1}^{617}=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{617}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\to,2}^{617}=\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{617}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\to,3}^{617}=\\{((\\neg A\\to\\neg B)\\to(B\\to A)):A,B\\in\\mathsf{Frm}_{617}\\}.","display":true},{"tex":"\\mathsf{Ax}_{SelK}^{617}\n=\n\\{(A\\Rightarrow_f(B\\to C))\\to((A\\Rightarrow_f B)\\to(A\\Rightarrow_f C)):A,B,C\\in\\mathsf{Frm}_{617}\\},","display":true},{"tex":"\\mathsf{Ax}_{SelTop}^{617}\n=\n\\{A\\Rightarrow_f\\top:A\\in\\mathsf{Frm}_{617}\\},","display":true},{"tex":"\\mathsf{Ax}_{SelAnd}^{617}\n=\n\\{(A\\Rightarrow_f B)\\to((A\\Rightarrow_f C)\\to(A\\Rightarrow_f(B\\land C))):A,B,C\\in\\mathsf{Frm}_{617}\\}.","display":true},{"tex":"