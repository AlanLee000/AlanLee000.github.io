fc-rel-composition.md]], [[../batch20/58-df-zfc-inverse-relation.md]])"},{"id":"7dfd7690ebbd5feb","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-3303","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-zfc-rel-composition.md|58-df-zfc-rel-composition]]（batch10）"}],"outgoing":["a3348ed9eb6fb4e3","7e70202d5fff2308","7ccfc8c88f29968a"]}