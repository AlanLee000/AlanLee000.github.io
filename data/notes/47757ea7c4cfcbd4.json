s_G","display":false},{"tex":"\\mathrm{NonStd}_G","display":false},{"tex":"\\mathrm{df\\text{-}nonstandard\\text{-}model} \\vdash\n\\mathrm{NonStd}_G(M)\\Longleftrightarrow\nM\\in\\mathrm{Struc}_G\\land\n\\Bigl[\\forall\\varphi\\in\\mathrm{PA}\\,\\forall\\beta\\in\\mathrm{Assign}_G(|M|)\\;(M,\\beta\\models_G\\varphi)\\Bigr]\n\\land M\\not\\cong\\mathfrak N_G","display":true},{"tex":"\\mathbb{N}","display":false},{"tex":"\\mathfrak N_G\\models\\mathrm{PA}","display":false},{"tex":"\\omega+(\\mathbb Z\\cdot\\mathbb Q)","display":false},{"tex":"\\gamma","display":false},{"tex":"\\mathrm{PA}+\\neg\\gamma","display":false},{"tex":"\\gamma","display":false}],"bytes":2033,"backlinks":[{"id":"8757635b793ed303","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{NonStd}_G$ (nonstandard-model predicate, see [[92-df-nonstandard-model]])"},{"id":"c3afc4c71ad0b7f9","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathfrak M=(M,I)$ and $\\mathrm{NonStd}_G$ (arithmetic structure and nonstandard-model predicate, see [[92-df-nonstandard-model]])"},{"id":"fcf794bdb0764404","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{NonStd}_G$ (nonstandard-model predicate on the $\\mathcal L_G$-reduct, see [[92-df-nonstandard-model]])"},{"id":"823a52c75bbad9bd","anchor":"ref-111","locations":["正文"],"count":1,"excerpt":"[[92-df-nonstandard-model]]"}],"outgoing":["fd60117fc80e6f95","ccb738ae4bbf923c","fdcbc43c728f79fc","89c266445c099752","2b7f27c890af1dc3"]}