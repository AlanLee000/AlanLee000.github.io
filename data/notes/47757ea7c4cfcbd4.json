[\\forall\\varphi\\in\\mathrm{PA}\\,\\forall\\beta\\in\\mathrm{Assign}_G(|M|)\\;(M,\\beta\\models_G\\varphi)\\Bigr]\n\\land M\\not\\cong\\mathfrak N_G","display":true},{"tex":"\\mathbb{N}","display":false},{"tex":"\\mathfrak N_G\\models\\mathrm{PA}","display":false},{"tex":"\\omega+(\\mathbb Z\\cdot\\mathbb Q)","display":false},{"tex":"\\gamma","display":false},{"tex":"\\mathrm{PA}+\\neg\\gamma","display":false},{"tex":"\\gamma","display":false}],"bytes":1868,"backlinks":[{"id":"8757635b793ed303","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{NonStd}_G$ (nonstandard-model predicate, see [[92-df-nonstandard-model]])"},{"id":"c3afc4c71ad0b7f9","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathfrak M=(M,I)$ and $\\mathrm{NonStd}_G$ (arithmetic structure and nonstandard-model predicate, see [[92-df-nonstandard-model]])"},{"id":"fcf794bdb0764404","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{NonStd}_G$ (nonstandard-model predicate on the $L_G$-reduct, see [[92-df-nonstandard-model]])"},{"id":"823a52c75bbad9bd","anchor":"ref-82","locations":["正文"],"count":1,"excerpt":"[[92-df-1-consistency.md]]\n[[92-df-analytical-hierarchy.md]]\n[[92-df-arithmetic-hierarchy.md]]\n[[92-df-arithmetic-truth.md]]\n[[92-df-arithmetical-formula.md]]\n[[92-df-arithmetical-truth.md]]\n[[92-df-arithmetization-formula.md]]\n[[92-df-arithmetization-property.md]]\n[[92-df-arithmetization-steps.md]]\n[[92-df-arithmetization.md]]\n[[92-df-assignment.md]]\n[[92-df-atomic-formula.md]]\n[[92-df-axiom-check.md]]\n[[92-df-axiom-set.md]]\n[[92-df-axiomatization.md]]\n[[92-df-bounded-arithmetic.md]]\n[[92-df-bounded-quantifier.md]]\n[[92-df-ce-set.md]]\n[[92-df-church-turing-thesis.md]]\n[[92-df-closed-term.md]]\n[[92-df-complete-system.md]]\n[[92-df-composition.md]]\n[[92-df-concept-network-complete.md]]\n[[92-df-consistency-hierarchy.md]]\n[[92-df-consistency-statement.md]]\n[[92-df-consistency