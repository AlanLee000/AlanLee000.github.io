FC definition.</li>\n<li>元组编码现作为固定的原始递归映射显式声明，判定函数量词也限制在 <span class=\"math-inline\" data-tex=\"V\">\\(V\\)</span> 中。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch01/58-df-zfc-recursion3-total-recursive-function.md","status":"resolved","id":"37437e63af9f668e","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch01/58-df-zfc-recursion3-total-recursive-function.md]]","embed":false},{"target":"../batch08/58-df-effective-program-coding.md","status":"resolved","id":"a7e1b630ead60caa","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-effective-program-coding.md]]","embed":false},{"target":"../batch01/58-df-zfc-recursion3-total-recursive-function.md","status":"resolved","id":"37437e63af9f668e","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcRecursion3TotalRecursiveFunction}_S:V\\to\\{\\top,\\bot\\}$ (see [[../batch01/58-df-zfc-recursion3-total-recursive-function.md]])","embed":false}],"math":[{"tex":"R\\in V","display":false},{"tex":"\\operatorname{code}_k(\\vec n)\\coloneqq\\operatorname{SeqCode}_{58}(\\vec n)","display":false},{"tex":"k\\in\\omega","display":false},{"tex":"\\vec n\\in\\omega^k","display":false},{"tex":"\\mathrm{ZfcRecursion3TotalRecursiveFunction}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcCompComputableRelation}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}comp\\text{-}computable\\text{-}relation} \\vdash \\mathrm{ZfcCompComputableRelation}_S(R)\\leftrightarrow \\exists k\\in\\omega\\;\\Bigl(R\\subseteq\\ome