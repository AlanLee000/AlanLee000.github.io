{"id":"fcafc6e9cc20d2e8","group":"93","path":"93/93-thm-h-closure.md","title":"thm-h-closure","display":"thm-h-closure","type":"theorem","metadata":{"book":"Algebraizable Logics","book_abbrev":"93","depends_on":["[[93-df-closure-operators]]","[[93-df-homomorphism]]","[[93-df-quotient-algebra]]","[[93-df-isomorphism]]","[[93-df-congruence]]","[[93-df-similarity-type]]"],"display":"thm-h-closure","label":"93-thm-h-closure","aliases":["93-thm-h-closure"],"type":"theorem"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"book","html":"Algebraizable Logics"},{"key":"book_abbrev","html":"93"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"97b46a497e251f9f\" href=\"?note=97b46a497e251f9f\" title=\"93-df-closure-operators\">93-df-closure-operators</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"f10e7e3251fa7f7d\" href=\"?note=f10e7e3251fa7f7d\" title=\"93-df-homomorphism\">93-df-homomorphism</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"510bd94349c4c6d9\" href=\"?note=510bd94349c4c6d9\" title=\"93-df-quotient-algebra\">93-df-quotient-algebra</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"fe06c83d404633c2\" href=\"?note=fe06c83d404633c2\" title=\"93-df-isomorphism\">93-df-isomorphism</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"30b341bfbd8b5301\" href=\"?note=30b341bfbd8b5301\" title=\"93-df-congruence\">93-df-congruence</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"ee84ed8b0fae5bc3\" href=\"?note=ee84ed8b0fae5bc3\" title=\"93-df-similarity-type\">93-df-similarity-type</a></span></div>"},{"key":"display","html":"thm-h-closure"},{"key":"label","html":"93-thm-h-closure"},{"key":"aliases","html":"<div class=\"property-array\"><span>93-thm-h-closure</span></div>"},{"key":"type","html":"theorem"}],"html":"<h1 id=\"thm-h-closure-thm-h-closure\">thm-h-closure <code>thm-h-closure</code></h1>\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{SimType}_{93}(\\tau)\">\\(\\mathrm{SimType}_{93}(\\tau)\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathcal K\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\">\\(\\mathcal K\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm H_{\\tau}\">\\(\\mathrm H_{\\tau}\\)</span> is defined in <a class=\"wiki-link\" id=\"ref-7\" data-note=\"97b46a497e251f9f\" href=\"?note=97b46a497e251f9f\" title=\"93-df-closure-operators\">93-df-closure-operators</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Iso}_{93}\">\\(\\mathrm{Iso}_{93}\\)</span> is the isomorphism predicate of <a class=\"wiki-link\" id=\"ref-8\" data-note=\"fe06c83d404633c2\" href=\"?note=fe06c83d404633c2\" title=\"93-df-isomorphism\">93-df-isomorphism</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Quot}_{93}\">\\(\\mathrm{Quot}_{93}\\)</span> is the type-indexed quotient constructor of <a class=\"wiki-link\" id=\"ref-9\" data-note=\"510bd94349c4c6d9\" href=\"?note=510bd94349c4c6d9\" title=\"93-df-quotient-algebra\">93-df-quotient-algebra</a>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}h\\text{-}closure}\\vdash\n\\mathrm{SimType}_{93}(\\tau)\\land\\mathcal K\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\to\n\\mathrm H_{\\tau}(\\mathcal K)=\\Bigl\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\land\n\\exists\\mathbf B\\in\\mathcal K\\;\\exists\\theta\\in\\mathrm{Con}(\\mathbf B)\\;\\exists h\\;\n\\mathrm{Iso}_{93}\\bigl(h,\\mathbf A,\n\\mathrm{Quot}_{93}(\\mathbf B,\\theta;\\tau)\\bigr)\\Bigr\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}h\\text{-}closure}\\vdash\n\\mathrm{SimType}_{93}(\\tau)\\land\\mathcal K\\subseteq\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\}\\to\n\\mathrm H_{\\tau}(\\mathcal K)=\\Bigl\\{\\mathbf A:\\mathrm{Alg}_{\\tau}(\\mathbf A)\\land\n\\exists\\mathbf B\\in\\mathcal K\\;\\exists\\theta\\in\\mathrm{Con}(\\mathbf B)\\;\\exists h\\;\n\\mathrm{Iso}_{93}\\bigl(h,\\mathbf A,\n\\mathrm{Quot}_{93}(\\mathbf B,\\theta;\\tau)\\bigr)\\Bigr\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"thm-h-closure-thm-h-closure","text":"thm-h-closure `thm-h-closure`","level":1},{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"93-df-closure-operators","status":"resolved","id":"97b46a497e251f9f","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-closure-operators]]","embed":false},{"target":"93-df-homomorphism","status":"resolved","id":"f10e7e3251fa7f7d","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-homomorphism]]","embed":false},{"target":"93-df-quotient-algebra","status":"resolved","id":"510bd94349c4c6d9","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-quotient-algebra]]","embed":false},{"target":"93-df-isomorphism","status":"resolved","id":"fe06c83d404633c2","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-isomorphism]]","embed":false},{"target":"93-df-congruence","status":"resolved","id":"30b341bfbd8b5301","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-congruence]]","embed":false},{"target":"93-df-similarity-type","status":"resolved","id":"ee84ed8b0fae5bc3","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-similarity-type]]","embed":false},{"target":"93-df-closure-operators","status":"resolved","id":"97b46a497e251f9f","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerp