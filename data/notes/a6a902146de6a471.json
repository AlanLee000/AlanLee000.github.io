rak R\\models\\theta[(\\mathbf a)]\n\\quad(\\theta\\in\\operatorname{Form}_1(\\mathcal L_\\le),\\ \\mathbf a\\in\\mathcal R_{\\mathrm{deg}}).\n\\end{gathered}","display":true},{"tex":"\\mathrm{thm\\text{-}nss\\text{-}def}\\vdash\n\\forall n\\in\\omega\\ \\left[n\\ge2\\Rightarrow\n\\exists\\lambda_n,\\eta_{n-1}\\in\\operatorname{Form}_1(\\mathcal L_\\le)\\\n\\forall\\mathbf a\\in\\mathcal R_{\\mathrm{deg}}\\\n\\bigl((\\mathfrak R\\models\\lambda_n[\\mathbf a]\\Longleftrightarrow\\mathbf a\\in L_n)\n\\land(\\mathfrak R\\models\\eta_{n-1}[\\mathbf a]\\Longleftrightarrow\\mathbf a\\in H_{n-1})\\bigr)\\right].","display":true}],"bytes":2990,"backlinks":[{"id":"4011ec29b6dff303","anchor":"ref-13","locations":["正文"],"count":1,"excerpt":"[[20-thm-nss-def]]"},{"id":"005203b6707a19f4","anchor":"ref-480","locations":["正文"],"count":1,"excerpt":"[[20-thm-nss-def]] — 章 supplement；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-480","locations":["正文"],"count":1,"excerpt":"[[20-thm-nss-def]]"}],"outgoing":["f389bdba28de0478","91065cedbdf2fc27","0c35680c0004f5e2","d4a7833057f5a20e"]}