igr\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{I}_{\\mathrm{Int}}","display":false},{"tex":"\\operatorname{Sub}_x(\\overline{\\ulcorner\\varphi\\urcorner},n)","display":false},{"tex":"\\overline n","display":false},{"tex":"\\operatorname{Sub}_x","display":false},{"tex":"T","display":false},{"tex":"\\varphi(0) \\land \\forall n\\;(\\varphi(n) \\to \\varphi(n+1)) \\to \\forall x\\, \\varphi(x)","display":false},{"tex":"T","display":false},{"tex":"\\mathrm{Ind}_{\\mathcal L_T}","display":false}],"bytes":2211,"backlinks":[{"id":"a57cead6abc35383","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e93fc3e2f8fd50d4","anchor":"ref-48","locations":["正文"],"count":1,"excerpt":"[[91-df-CT.md]]\n[[91-df-FS-n.md]]\n[[91-df-FS.md]]\n[[91-df-KF-plus.md]]\n[[91-df-KF.md]]\n[[91-df-T-closure.md]]\n[[91-df-T-schema.md]]\n[[91-df-TB-plus.md]]\n[[91-df-TB.md]]\n[[91-df-UTB-plus.md]]\n[[91-df-UTB.md]]\n[[91-df-VF.md]]\n[[91-df-adequacy-conditions-truth.md]]\n[[91-df-adequacy-conditions.md]]\n[[91-df-arithmetical-hierarchy.md]]\n[[91-df-capture-axiom.md]]\n[[91-df-classical-extension.md]]\n[[91-df-compositional-axioms.md]]\n[[91-df-compositional-truth.md]]\n[[91-df-conjunction-axiom.md]]\n[[91-df-conservative-truth.md]]\n[[91-df-conservativity-proof.md]]\n[[91-df-consistency-predicate.md]]\n[[91-df-continuity.md]]\n[[91-df-diagonal-function.md]]\n[[91-df-diagonal-lemma-truth.md]]\n[[91-df-disquotational-schema.md]]\n[[91-df-disquotational-truth.md]]\n[[91-df-expressive-completeness.md]]\n[[91-df-external-consistency.md]]\n[[91-df-external-logic.md]]\n[[91-df-external-negation.md]]\n[[91-df-extrinsic-fixed-point.md]]\n[[91-df-fixed-point-model.md]]\n[[91-df-gap-sentence.md]]\n[[91-df-global-T-schema.md]]\n[[91-df-global-reflection.md]]\n[[91-df-ground-language.md]]\n[[91-df-ground-model.md]]\n[[91-df-hierarchical-truth.md]]\n[[91-df-hierarchy-of-truth-theories.md]]\n[[91-df-implication-axiom.md]]\n[[91-df-induction-schema.md]]\n[[91-df-inner-outer-