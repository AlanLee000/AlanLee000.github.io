{"id":"9964b0194f4fb6e6","group":"27","path":"27/27-df-restrict.md","title":"Variable restriction","display":"df-restrict — Variable restriction","type":"definition","metadata":{"type":"definition","book":"Boolean Functions: Theory, Algorithms, and Applications","book_abbrev":"27","label":"27-df-restrict","aliases":["27-df-restrict"],"display":"df-restrict — Variable restriction","depends_on":["[[27-df-boolfunc]]"],"local_review_status":"2026-10-20-formalization-reviewed-source-text-not-rechecked"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Boolean Functions: Theory, Algorithms, and Applications"},{"key":"book_abbrev","html":"27"},{"key":"label","html":"27-df-restrict"},{"key":"aliases","html":"<div class=\"property-array\"><span>27-df-restrict</span></div>"},{"key":"display","html":"df-restrict — Variable restriction"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"5d10aed668d85817\" href=\"?note=5d10aed668d85817\" title=\"27-df-boolfunc\">27-df-boolfunc</a></span></div>"},{"key":"local_review_status","html":"2026-10-20-formalization-reviewed-source-text-not-rechecked"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"n\\in\\mathbb N^+\">\\(n\\in\\mathbb N^+\\)</span>。</li>\n<li><span class=\"math-inline\" data-tex=\"f\\in\\mathrm{BoolFunc}_n\">\\(f\\in\\mathrm{BoolFunc}_n\\)</span> (Boolean function, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"5d10aed668d85817\" href=\"?note=5d10aed668d85817\" title=\"27-df-boolfunc\">27-df-boolfunc</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"i\\in\\{1,\\ldots,n\\}\">\\(i\\in\\{1,\\ldots,n\\}\\)</span> and <span class=\"math-inline\" data-tex=\"b\\in\\mathbb{B}\">\\(b\\in\\mathbb{B}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"f_{i\\leftarrow b}:\\mathbb{B}^{n-1}\\to\\mathbb{B},\\qquad f_{i\\leftarrow b}(y_1,\\ldots,y_{n-1})\\coloneqq f(y_1,\\ldots,y_{i-1},b,y_i,\\ldots,y_{n-1})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[f_{i\\leftarrow b}:\\mathbb{B}^{n-1}\\to\\mathbb{B},\\qquad f_{i\\leftarrow b}(y_1,\\ldots,y_{n-1})\\coloneqq f(y_1,\\ldots,y_{i-1},b,y_i,\\ldots,y_{n-1})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"f_{i\\leftarrow b}\">\\(f_{i\\leftarrow b}\\)</span> is the restriction of <span class=\"math-inline\" data-tex=\"f\">\\(f\\)</span> obtained by fixing coordinate <span class=\"math-inline\" data-tex=\"i\">\\(i\\)</span> to <span class=\"math-inline\" data-tex=\"b\">\\(b\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"27-df-boolfunc","status":"resolved","id":"5d10aed668d85817","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[27-df-boolfunc]]","embed":false},{"target":"27-df-boolfunc","status":"resolved","id":"5d10aed668d85817","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$f\\in\\mathrm{BoolFunc}_n$ (Boolean function, see [[27-df-boolfunc]])","embed":false}],"attachments":[],"math":[{"tex":"n\\in\\mathbb N^+","display":false},{"tex":"f\\in\\mathrm{BoolFunc}_n","display":false},{"tex":"i\\in\\{1,\\ldots,n\\}","display":false},{"tex":"b\\in\\mathbb{B}","display":false},{"tex":"f_{i\\leftarrow b}:\\mathbb{B}^{n-1}\\to\\mathbb{B},\\qquad f_{i\\leftarrow b}(y_1,\\ldots,y_{n-1})\\coloneqq f(y_1,\\ldots,y_{i-1},b,y_i,\\ldots,y_{n-1})","display":true},{"tex":"f_{i\\leftarrow b}","display":false},{"tex":"f","display":false},{"tex":"i","display":false},{"tex":"b","display":false}],"bytes":792,"backlinks":[{"id":"227334a8639e2b87","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$n\\in\\mathbb N^+$，$i\\in[n]$，$f\\in\\mathrm{BoolFunc}_n$；降维限制见 [[27-df-restrict]]，异或见 [[27-df-boolop]]。"},{"id":"5244dbb38da17b8a","anchor":"ref-328","locations":["正文"],"count":1,"excerpt":"[[27-df-restrict|df-restrict — Variable restriction]]"},{"id":"4fa15b19c682f360","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$f_{i\\leftarrow b}$ (restriction, see [[27-df-restrict]])"},{"id":"db52121d11e13a81","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$f_{i\\leftarrow0},f_{i\\leftarrow1}:\\mathbb B^{n-1}\\to\\mathbb B$ (see [[27-df-restrict]])"}],"outgoing":["5d10aed668d85817"]}