","display":false},{"tex":"\\mathrm{IncompatibleConditions}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}incompatible\\text{-}conditions} \\vdash \\mathrm{IncompatibleConditions}_S(p,q,P,\\leq_P)\\leftrightarrow \\mathrm{Poset}(P,\\leq_P)\\land p,q\\in P\\land\\neg\\exists r\\in P\\;(r\\leq_P p\\land r\\leq_P q)","display":true}],"bytes":873,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2321","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-zfc-incompatible-conditions.md|58-df-zfc-incompatible-conditions]]（batch10）"}],"outgoing":["a3348ed9eb6fb4e3","d3f859dbdd37f018"]}