{"id":"3393d56353c87df7","group":"58","path":"58/batch10/58-df-zfc-incompatible-conditions.md","title":"ZFC Incompatible Conditions","display":"df-zfc-incompatible-conditions — ZFC Incompatible Conditions","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-incompatible-conditions","aliases":["58-df-zfc-incompatible-conditions"],"display":"df-zfc-incompatible-conditions — ZFC Incompatible Conditions","depends_on":["[[../batch02/58-ax-zfc.md]]","[[../batch02/58-df-poset.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-incompatible-conditions"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-incompatible-conditions</span></div>"},{"key":"display","html":"df-zfc-incompatible-conditions — ZFC Incompatible Conditions"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"p,q,P\\in V\">\\(p,q,P\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\leq_P\\subseteq P\\times P\">\\(\\leq_P\\subseteq P\\times P\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Poset}(P,\\leq_P)\">\\(\\mathrm{Poset}(P,\\leq_P)\\)</span> is the partial-order predicate (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>)</li>\n<li><span class=\"math-inline\" data-te