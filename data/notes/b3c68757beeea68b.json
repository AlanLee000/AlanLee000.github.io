{"id":"b3c68757beeea68b","group":"58","path":"58/batch03/58-df-zfc-cat2-comma-category.md","title":"ZFC Cat2 Comma Category","display":"df-zfc-cat2-comma-category — ZFC Cat2 Comma Category","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-cat2-comma-category","aliases":["58-df-zfc-cat2-comma-category"],"display":"df-zfc-cat2-comma-category — ZFC Cat2 Comma Category","depends_on":["[[58-ax-zfc]]","[[58-df-category]]","[[58-df-functor]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-cat2-comma-category"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-cat2-comma-category</span></div>"},{"key":"display","html":"df-zfc-cat2-comma-category — ZFC Cat2 Comma Category"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"a87b7e1119b63b2c\" href=\"?note=a87b7e1119b63b2c\" title=\"58-df-category\">58-df-category</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"877f1061e295cf5f\" href=\"?note=877f1061e295cf5f\" title=\"58-df-functor\">58-df-functor</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal K,F,G,\\mathcal A,\\mathcal B,\\mathcal C\\in V\">\\(\\mathcal K,F,G,\\mathcal A,\\mathcal B,\\mathcal C\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Category}_S\\subseteq V\">\\(\\mathrm{Category}_S\\subseteq V\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Functor}_S\\subseteq V^3\">\\(\\mathrm{Functor}_S\\subseteq V^3\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCat2CommaCategory}_S\\subseteq V^6\">\\(\\mathrm{ZfcCat2CommaCategory}_S\\subseteq V^6\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}comma\\text{-}category}\\vdash\n\\mathrm{ZfcCat2CommaCategory}_S\n(\\mathcal K,F,G,\\mathcal A,\\mathcal B,\\mathcal C)\\\\\n&amp;\\quad\\leftrightarrow\n\\mathrm{Category}_S(\\mathcal A)\\land\\mathrm{Category}_S(\\mathcal B)\n\\land\\mathrm{Category}_S(\\mathcal C)\n\\land\\mathrm{Functor}_S(F,\\mathcal A,\\mathcal C)\n\\land\\mathrm{Functor}_S(G,\\mathcal B,\\mathcal C)\\\\\n&amp;\\qquad\\land\\exists A_0,A_1,s_A,t_A,c_A,e_A,\nB_0,B_1,s_B,t_B,c_B,e_B,\nC_0,C_1,s_C,t_C,c_C,e_C,F_0,F_1,G_0,G_1,O,M,s,t,c,e\\in V\\;\\Bigl(\\\\\n&amp;\\qquad\\quad\\mathcal A=\\langle A_0,A_1,s_A,t_A,c_A,e_A\\rangle\n\\land\\mathcal B=\\langle B_0,B_1,s_B,t_B,c_B,e_B\\rangle\n\\land\\mathcal C=\\langle C_0,C_1,s_C,t_C,c_C,e_C\\rangle\\\\\n&amp;\\qquad\\quad\\land F=\\langle F_0,F_1\\rangle\\land G=\\langle G_0,G_1\\rangle\\\\\n&amp;\\qquad\\quad\\land O=\\{\\langle a,b,u\\rangle\\in A_0\\times B_0\\times C_1:\ns_C(u)=F_0(a)\\land t_C(u)=G_0(b)\\}\\\\\n&amp;\\qquad\\quad\\land M=\\{\\langle x,y,f,g\\rangle\\in O\\times O\\times A_1\\times B_1:\ns_A(f)=x_0\\land t_A(f)=y_0\\land s_B(g)=x_1\\land t_B(g)=y_1\\\\\n&amp;\\hspace{21em}\\land c_C(\\langle G_1(g),x_2\\rangle)\n=c_C(\\langle y_2,F_1(f)\\rangle)\\}\\\\\n&amp;\\qquad\\quad\\land\\forall\\langle x,y,f,g\\rangle\\in M\\;\n(s(\\langle x,y,f,g\\rangle)=x\\land t(\\langle x,y,f,g\\rangle)=y)\\\\\n&amp;\\qquad\\quad\\land\\forall x=\\langle a,b,u\\rangle\\in O\\;\ne(x)=\\langle x,x,e_A(a),e_B(b)\\rangle\\\\\n&amp;\\qquad\\quad\\land\\forall m_1=\\langle x,y,f_1,g_1\\rangle\\in M\\;\n\\forall m_2=\\langle y,z,f_2,g_2\\rangle\\in M\\;\\\\\n&amp;\\hspace{10em}c(\\langle m_2,m_1\\rangle)\n=\\langle x,z,c_A(\\langle f_2,f_1\\rangle),c_B(\\langle g_2,g_1\\rangle)\\rangle\\\\\n&amp;\\qquad\\quad\\land\\mathcal K=\\langle O,M,s,t,c,e\\rangle\n\\land\\mathrm{Category}_S(\\mathcal K)\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}comma\\text{-}category}\\vdash\n\\mathrm{ZfcCat2CommaCategory}_S\n(\\mathcal K,F,G,\\mathcal A,\\mathcal B,\\mathcal C)\\\\\n&amp;\\quad\\leftrightarrow\n\\mathrm{Category}_S(\\mathcal A)\\land\\mathrm{Category}_S(\\mathcal B)\n\\land\\mathrm{Category}_S(\\mathcal C)\n\\land\\mathrm{Functor}_S(F,\\mathcal A,\\mathcal C)\n\\land\\mathrm{Functor}_S(G,\\mathcal B,\\mathcal C)\\\\\n&amp;\\qquad\\land\\exists A_0,A_1,s_A,t_A,c_A,e_A,\nB_0,B_1,s_B,t_B,c_B,e_B,\nC_0,C_1,s_C,t_C,c_C,e_C,F_0,F_1,G_0,G_1,O,M,s,t,c,e\\in V\\;\\Bigl(\\\\\n&amp;\\qquad\\quad\\mathcal A=\\langle A_0,A_1,s_A,t_A,c_A,e_A\\rangle\n\\land\\mathcal B=\\langle B_0,B_1,s_B,t_B,c_B,e_B\\rangle\n\\land\\mathcal C=\\langle C_0,C_1,s_C,t_C,c_C,e_C\\rangle\\\\\n&amp;\\qquad\\quad\\land F=\\langle F_0,F_1\\rangle\\land G=\\langle G_0,G_1\\rangle\\\\\n&amp;\\qquad\\quad\\land O=\\{\\langle a,b,u\\rangle\\in A_0\\times B_0\\times C_1:\ns_C(u)=F_0(a)\\land t_C(u)=G_0(b)\\}\\\\\n&amp;\\qquad\\quad\\land M=\\{\\langle x,y,f,g\\rangle\\in O\\times O\\times A_1\\times B_1:\ns_A(f)=x_0\\land t_A(f)=y_0\\land s_B(g)=x_1\\land t_B(g)=y_1\\\\\n&amp;\\hspace{21em}\\land c_C(\\langle G_1(g),x_2\\rangle)\n=c_C(\\langle y_2,F_1(f)\\rangle)\\}\\\\\n&amp;\\qquad\\quad\\land\\forall\\langle x,y,f,g\\rangle\\in M\\;\n(s(\\langle x,y,f,g\\rangle)=x\\land t(\\langle x,y,f,g\\rangle)=y)\\\\\n&amp;\\qquad\\quad\\land\\forall x=\\langle a,b,u\\rangle\\in O\\;\ne(x)=\\langle x,x,e_A(a),e_B(b)\\rangle\\\\\n&amp;\\qquad\\quad\\land\\forall m_1=\\langle x,y,f_1,g_1\\rangle\\in M\\;\n\\forall m_2=\\langle y,z,f_2,g_2\\rangle\\in M\\;\\\\\n&amp;\\hspace{10em}c(\\langle m_2,m_1\\rangle)\n=\\langle x,z,c_A(\\langle f_2,f_1\\rangle),c_B(\\langle g_2,g_1\\rangle)\\rangle\\\\\n&amp;\\qquad\\quad\\land\\mathcal K=\\langle O,M,s,t,c,e\\rangle\n\\land\\mathrm{Category}_S(\\mathcal K)\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Objects, arrows, source, target, identities, and componentwise composition are tied to the same three categories and the same two functors; no class functions <span class=\"math-inline\" data-tex=\"F,G:V\\to V\">\\(F,G:V\\to V\\)</span> occur.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-category","status":"resolved","id":"a87b7e1119b63b2c","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-category]]","embed":false},{"target":"58-df-functor","status":"resolved","id":"877f1061e295cf5f","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-functor]]","embed":false}],"math":[{"tex":"\\mathcal K,F,G,\\mathcal A,\\mathcal B,\\mathcal C\\in V","display":false},{"tex":"\\mathrm{Category}_S\\subseteq V","display":false},{"tex":"\\mathrm{Functor}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcCat2CommaCategory}_S\\subseteq V^6","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}cat2\\text{-}comma\\text{-}category}\\vdash\n\\mathrm{ZfcCat2CommaCategory}_S\n(\\mathcal K,F,G,\\mathcal A,\\mathcal B,\\mathcal C)\\\\\n&\\quad\\leftrightarrow\n\\mathrm{Category}_S(\\mathcal A)\\land\\mathrm{Category}_S(\\mathcal B)\n\\land\\mathrm{Category}_S(\\mathcal C)\n\\land\\mathrm{Functor}_S(F,\\mathcal A,\\mathcal C)\n\\land\\mathrm{Functor}_S(G,\\mathcal B,\\mathcal C)\\\\\n&\\qquad\\land\\exists A_0,A_1,s_A,t_A,c_A,e_A,\nB_0,B_1,s_B,t_B,c_B,e_B,\nC_0,C_1,s_C,t_C,c_C,e_C,F_0,F_1,G_0,G_1,O,M,s,t,c,e\\in V\\;\\Bigl(\\\\\n&\\qquad\\quad\\mathcal A=\\langle A_0,A_1,s_A,t_A,c_A,e_A\\rangle\n\\land\\mathcal B=\\langle B_0,B_1,s_B,t_B,c_B,e_B\\rangle\n\\land\\mathcal C=\\langle C_0,C_1,s_C,t_C,c_C,e_C\\rangle\\\\\n&\\qquad\\quad\\land F=\\langle F_0,F_1\\rangle\\land G=\\langle G_0,G_1\\rangle\\\\\n&\\qquad\\quad\\land O=\\{\\langle a,b,u\\rangle\\in A_0\\times B_0\\times C_1:\ns_C(u)=F_0(a)\\land t_C(u)=G_0(b)\\}\\\\\n&\\qquad\\quad\\land M=\\{\\langle x,y,f,g\\rangle\\in O\\times O\\times A_1\\times B_1:\ns_A(f)=x_0\\land t_A(f)=y_0\\land s_B(g)=x_1\\land t_B(g)=y_1\\\\\n&\\hspace{21em}\\land c_C(\\langle G_1(g),x_2\\rangle)\n=c_C(\\langle y_2,F_1(f)\\rangle)\\}\\\\\n&\\qquad\\quad\\land\\forall\\langle x,y,f,g\\rangle\\in M\\;\n(s(\\langle x,y,f,g\\rangle)=x\\land t(\\langle x,y,f,g\\rangle)=y)\\\\\n&\\qquad\\quad\\land\\forall x=\\langle a,b,u\\rangle\\in O\\;\ne(x)=\\langle x,x,e_A(a),e_B(b)\\rangle\\\\\n&\\qquad\\quad\\land\\forall m_1=\\langle x,y,f_1,g_1\\rangle\\in M\\;\n\\forall m_2=\\langle y,z,f_2,g_2\\rangle\\in M\\;\\\\\n&\\hspace{10em}c(\\langle m_2,m_1\\rangle)\n=\\langle x,z,c_A(\\langle f_2,f_1\\rangle),c_B(\\langle g_2,g_1\\rangle)\\rangle\\\\\n&\\qquad\\quad\\land\\mathcal K=\\langle O,M,s,t,c,e\\rangle\n\\land\\mathrm{Category}_S(\\mathcal K)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"F,G:V\\to V","display":false}],"bytes":2434,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1574","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-cat2-comma-category.md|58-df-zfc-cat2-comma-category]]（batch03）"}],"outgoing":["a3348ed9eb6fb4e3","a87b7e1119b63b2c","877f1061e295cf5f"]}