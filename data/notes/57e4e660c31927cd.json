Function}_S(F,\\mathcal A,X,Y)\\leftrightarrow \\mathrm{Set}_S(X)\\land\\mathrm{Set}_S(Y)\\land\\mathcal A\\subseteq\\mathcal P(X)\\land\\mathrm{Function}(F,\\mathcal A,Y)","display":true},{"tex":"X","display":false}],"bytes":849,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1144","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-set-function.md|58-df-set-function]]（batch11）"}],"outgoing":["36d7463d215be751","65d9a1e690c32aad","2b6b1d9eb78a2714"]}