zfc-prob2-adapted-process.md\">../batch05/58-df-zfc-prob2-adapted-process.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"58-df-sigma-algebra.md\">58-df-sigma-algebra.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"Y_\\bullet,X_\\bullet,T,\\Omega,\\mathcal F,\\mathbb P,\\mathcal F_\\bullet,E,\\mathcal E\\in V\">\\(Y_\\bullet,X_\\bullet,T,\\Omega,\\mathcal F,\\mathbb P,\\mathcal F_\\bullet,E,\\mathcal E\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\leq_\\omega=\\{\\langle m,n\\rangle\\in\\omega^2\\mid m\\leq n\\}\">\\(\\leq_\\omega=\\{\\langle m,n\\rangle\\in\\omega^2\\mid m\\leq n\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProbProbabilitySpace}_S\">\\(\\mathrm{ZfcProbProbabilitySpace}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProb2AdaptedProcess}_S\">\\(\\mathrm{ZfcProb2AdaptedProcess}_S\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProb2StoppingTime}_S\">\\(\\mathrm{ZfcProb2StoppingTime}_S\\)</span> (typing predicates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}(Y_\\bullet,\\omega,E^\\Omega)\">\\(\\mathrm{Function}(Y_\\bullet,\\omega,E^\\Omega)\\)</span> (function predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcProb4OptionalStoppedProcess}_S(Y_\\bullet,X_\\bullet,T,\\Omega,\\mathcal F,\\mathbb P,\\mathcal F_\\bullet,E)\">\\(\\mathrm{ZfcProb4OptionalStoppedProcess}_S(Y_\\bullet,X_\\bullet,T,\\Omega,\\mathcal F,\\mathbb P,\\mathcal F_\\bullet,E)\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}prob4\\text{-}optional\\text{-}stopped\\text{-}process} \\vdash \\mathrm{ZfcProb4OptionalStoppedProcess}_S(Y_\\bullet,X_\\bullet,T,\\Omega,\\mathcal F,\\mathbb P,\\mathcal F_\\bullet,E)\\leftrightarrow \\mathrm{ZfcProbProbabilitySpace}_S(\\Omega,\\mathcal F,\\mathbb P)\\land\\exists\\mathcal E\\;\\Bigl(\\operatorname{SigmaAlgebra}(\\mathcal E,E)\\land\\mathrm{ZfcProb2AdaptedProcess}_S(X_\\bullet,\\mathcal F_\\bullet,\\langle\\omega,\\leq_\\omega\\rangle,\\Omega,E,\\mathcal E)\\land\\forall n\\in\\omega\\;(\\operatorname{SigmaAlgebra}(\\mathcal F_\\bullet(n),\\Omega)\\land\\mathcal F_\\bullet(n)\\subseteq\\mathcal F)\\land\\mathrm{ZfcProb2StoppingTime}_S(T,\\Omega,\\mathcal F_\\bullet,\\omega,\\leq_\\omega)\\land\\mathrm{Function}(Y_\\bullet,\\omega,E^\\Omega)\\land\\forall n\\in\\omega\\;\\forall\\omega_0\\in\\Omega\\;\\bigl[(T(\\omega_0)\\in\\omega\\land T(\\omega_0)\\leq n\\land Y_\\bullet(n)(\\omega_0)=X_\\bullet(T(\\omega_0))(\\omega_0))\\lor((T(\\omega_0)=\\infty\\lor(T(\\omega_0)\\in\\omega\\land n&lt;T(\\omega_0)))\\land Y_\\bullet(n)(\\omega_0)=X_\\bullet(n)(\\omega_0))\\bigr]\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}prob4\\text{-}optional\\text{-}stopped\\text{-}process} \\vdash \\mathrm{ZfcProb4OptionalStoppedProcess}_S(Y_\\bullet,X_\\bullet,T,\\Omega,\\mathcal F,\\mathbb P,\\mathcal F_\\bullet,E)\\leftrightarrow \\mathrm{ZfcProbProbabilitySpace}_S(\\Omega,\\mathcal F,\\mathbb P)\\land\\exists\\mathcal E\\;\\Bigl(\\operatorname{SigmaAlgebra}(\\mathcal E,E)\\land\\mathrm{ZfcProb2AdaptedProcess}_S(X_\\bullet,\\mathcal F_\\bullet,\\langle\\omega,\\leq_\\omega\\rangle,\\Omega,E,\\mathcal E)\\land\\forall n\\in\\omega\\;(\\operatorname{SigmaAlgebra}(\\mathcal F_\\bullet(n),\\Omega)\\land\\mathcal F_\\bullet(n)\\subseteq\\mathcal F)\\land\\mathrm{ZfcProb2StoppingTime}_S(T,\\Omega,\\mathcal F_\\bullet,\\omega,\\leq_\\omega)\\land\\mathrm{Function}(Y_\\bullet,\\omega,E^\\Omega)\\land\\forall n\\in\\omega\\;\\forall\\omega_0\\in\\Omega\\;\\bigl[(T(\\omega_0)\\in\\omega\\land T(\\omega_0)\\leq n\\land Y_\\bullet(n)(\\omega_0)=X_\\bullet(T(\\omega_0))(\\omega_0))\\lor((T(\\omega_0)=\\infty\\lor(T(\\omega_0)\\in\\omega\\land n&lt;T(\\omega_0)))\\land Y_\\bullet(n)(\\omega_0)=X_\\bullet(n)(\\omega_0))\\bigr]\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The two pointwise cases explicitly encode <span class=\"math-inline\" data-tex=\"Y_n=X_T\">\\(Y_n=X_T\\)</span> when <span class=\"math-inline\" data-tex=\"T\\leq n\">\\(T\\leq n\\)</span> and <span class=\"math-inline\" data-tex=\"Y_n=X_n\">\\(Y_n=X_n\\)</span> when <span class=\"math-inline\" data-tex=\"n&lt;T\">\\(n&lt;T\\)</span> or <span class=\"math-inline\" data-tex=\"T=\\infty\">\\(T=\\infty\\)</span>; no undefined <span class=\"math-inline\" data-tex=\"\\min\\{n,\\infty\\}\">\\(\\min\\{n,\\infty\\}\\)</span> convention remains in the assertion.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch19/58-df-zfc-prob-probability-space.md","status":"resolved","id":"d4d304b0bbb11c1a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch19/58-df-zfc-prob-probability-space.md]]","embed":false},{"target":"../batch17/58-df-zfc-prob2-stopping-time.md","status":"resolved","id":"cef612157cb4ba5d","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-zfc-prob2-stopping-time.md]]","embed":false},{"target":"../batch05/58-df-zfc-prob2-adapted-process.md","status":"resolved","id":"ddd3fe2bb0aacd1e","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-zfc-prob2-