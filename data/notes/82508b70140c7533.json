ot_P;M,+_M,\\odot_M;R)\n\\land f\\circ\\widetilde g=g\\bigr)\\Bigr)\n\\end{aligned}\n\\Biggr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}projective\\text{-}carrier}\\vdash\n\\mathrm{Projective}_S(P,R)\\leftrightarrow\n\\exists +_P,0_P,+_R,\\cdot_R,0_R,1_R,\\odot_P\\in V\\;\n\\mathrm{ProjectiveModuleStructure}_S(\nP,R,+_P,0_P,+_R,\\cdot_R,0_R,1_R,\\odot_P).","display":true},{"tex":"\\operatorname{Ext}^1","display":false},{"tex":"\\Rightarrow","display":false},{"tex":"\\Rightarrow","display":false}],"bytes":3238,"backlinks":[{"id":"626a376aca69b0c2","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{ModuleHomStructure}$ 取 [[../batch01/58-df-projective.md]] 的同名定义与参数次序。"},{"id":"427dbff531db1052","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Projective}_S(P,R)$（规范投射模谓词，见 [[../batch01/58-df-projective.md]]）"},{"id":"a1ff59b2909a8ac7","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"a11585cba9c21cfd","anchor":"ref-178","locations":["正文"],"count":1,"excerpt":"[[58-df-projective]]"},{"id":"84daad544872cc71","anchor":"ref-1007","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-projective.md|58-df-projective]]（batch01）"}],"outgoing":["ef3a5dd6825f0373","9f8cb046321ba311","36d7463d215be751"]}