}=A\\}.","display":true},{"tex":"\\Gamma\\vdash_{\\mathsf{Ent}}A\\Longleftrightarrow\\mathsf{Prf}_{\\mathsf{Ent}}(\\Gamma,A)\\ne\\varnothing.","display":true},{"tex":"\\mathsf{Cert}_{\\mathsf{Ent}}(\\Gamma,A)=\\mathsf{Prf}_{\\mathsf{Ent}}(\\Gamma,A).","display":true},{"tex":"\\operatorname{Proof}_{\\mathsf{Ent}}(\\Gamma,A)=\\mathsf{Prf}_{\\mathsf{Ent}}(\\Gamma,A).","display":true},{"tex":"\\mathsf{Thm}_{\\mathsf{Ent}}=\\{A\\in\\mathsf{Frm}:\\varnothing\\vdash_{\\mathsf{Ent}}A\\}.","display":true},{"tex":"\\operatorname{EntCore}\n=\n(\\operatorname{ent},\\mathsf{Ax}_{\\neg 1},\\mathsf{Ax}_{\\neg 2},\\mathsf{Rule}_{\\mathsf{trans}},\\mathsf{Rule}_{\\land R},\\mathsf{Rule}_{\\lor L},\\mathsf{Rule}_{\\neg},\\mathsf{Rule}_{\\mathsf{Ent}}).","display":true},{"tex":"\\mathsf{Delta}_{\\mathsf{Ent}}=\\operatorname{EntCore}.","display":true},{"tex":"\\mathcal S_{\\mathsf{Ent}}=(\\mathsf{At},\\mathsf{Frm},\\operatorname{FV},\\operatorname{Sub},\\operatorname{BN},\\operatorname{freshAt},\\operatorname{Ren}_{\\mathsf{Ent}},\\equiv_\\alpha^{\\mathsf{Ent}},\\mathsf{Ax}_{\\neg 1},\\mathsf{Ax}_{\\neg 2},\\mathsf{Ax}_{\\mathsf{Ent}},\\mathsf{Rule}_{\\mathsf{trans}},\\mathsf{Rule}_{\\land R},\\mathsf{Rule}_{\\lor L},\\mathsf{Rule}_{\\neg},\\mathsf{Rule}_{\\mathsf{Ent}},\\mathsf{Prf}_{\\mathsf{Ent}},\\operatorname{Proof}_{\\mathsf{Ent}},\\mathsf{Cert}_{\\mathsf{Ent}},\\vdash_{\\mathsf{Ent}},\\mathsf{Thm}_{\\mathsf{Ent}},\\operatorname{EntCore},\\mathsf{Delta}_{\\mathsf{Ent}}).","display":true}],"bytes":7801,"backlinks":[],"outgoing":[]}