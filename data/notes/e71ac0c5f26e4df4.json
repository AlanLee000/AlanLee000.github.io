eton}\\vdash\n\\exists n\\in\\omega\\ [W_n=\\{n\\}].","display":true},{"tex":"f(x)","display":false},{"tex":"\\{x\\}","display":false}],"bytes":937,"backlinks":[{"id":"57024db84a89e3e6","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-index-set]]；see [[20-df-K]]；see [[20-cor-self-singleton]]；see [[20-lem-padding]]。"},{"id":"005203b6707a19f4","anchor":"ref-78","locations":["正文"],"count":1,"excerpt":"[[20-cor-self-singleton]] — 章 2；直接提供者 2 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-78","locations":["正文"],"count":1,"excerpt":"[[20-cor-self-singleton]]"}],"outgoing":["416559051d6f8f46","60af447f5d59a8dc"]}