kappa\\)</span> (infinite cardinal)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Cardinal}_S\">\\(\\mathrm{Cardinal}_S\\)</span> (cardinal predicate from dependency)</li>\n<li><span class=\"math-inline\" data-tex=\"\\beth_r(\\kappa)\">\\(\\beth_r(\\kappa)\\)</span> (generalized beth hierarchy from dependency)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{PartitionRelation}_S\">\\(\\mathrm{PartitionRelation}_S\\)</span> (partition-relation predicate from dependency)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}erdos\\text{-}rado}\\ \\vdash\\\n\\forall r\\in\\omega\\;\\forall\\kappa\\in V\\;\\Bigl(\n\\mathrm{Cardinal}_S(\\kappa)\\land\\omega\\leq\\kappa\n\\to\n\\mathrm{PartitionRelation}_S\\!\\left((\\beth_r(\\kappa))^+,\\kappa^+,r+1,\\kappa\\right)\n\\Bigr).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}erdos\\text{-}rado}\\ \\vdash\\\n\\forall r\\in\\omega\\;\\forall\\kappa\\in V\\;\\Bigl(\n\\mathrm{Cardinal}_S(\\kappa)\\land\\omega\\leq\\kappa\n\\to\n\\mathrm{PartitionRelation}_S\\!\\left((\\beth_r(\\kappa))^+,\\kappa^+,r+1,\\kappa\\right)\n\\Bigr).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Erdős and Rado (1956): proved the theorem.</li>\n<li>In arrow notation, <span class=\"math-inline\" data-tex=\"(\\beth_r(\\kappa))^+\\to(\\kappa^+)^{r+1}_{\\kappa}\">\\((\\beth_r(\\kappa))^+\\to(\\kappa^+)^{r+1}_{\\kappa}\\)</span>.</li>\n<li>The successor on the left and the color cardinal <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span> are part of the theorem's content.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-partition-notation","status":"resolve