ET}_\\Sigma\\cup\\mathsf{Cong}_\\Sigma^\\pm\\cup\\mathsf{Cl}_\\Sigma(P).\n\\end{aligned}","display":true},{"tex":"R^+","display":false},{"tex":"R^-","display":false},{"tex":"(D_R^P)^+","display":false},{"tex":"(D_R^P)^-","display":false},{"tex":"\\neg(D_R^P)^+","display":false},{"tex":"P","display":false},{"tex":"R","display":false},{"tex":"D_R^P=\\bot","display":false},{"tex":"\\bot","display":false},{"tex":"\\top","display":false}],"bytes":2609,"backlinks":[{"id":"00439897fba390aa","anchor":"ref-281","locations":["正文"],"count":1,"excerpt":"[[72-df-partial-program-completion|df partial program completion]]"},{"id":"2e1cc33090ad6f68","anchor":"ref-38","locations":["正文"],"count":1,"excerpt":"[[72-df-partial-program-completion]]"},{"id":"4d85a6a31705a214","anchor":"ref-281","locations":["正文"],"count":1,"excerpt":"[[./72-df-partial-program-completion|df partial program completion]]"},{"id":"141c93aa59eed1f8","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$P\\in\\mathsf{Program}_\\Sigma$，$A\\in\\mathsf{LPFml}_\\Sigma$，$\\mathsf{pcomp}_\\Sigma(P)$ 和 signed translation 采用 [[72-df-partial-program-completion]]。$\\operatorname{Adequate}(P,M)$ 是 [[72-df-program-envelope]] 在 $M$ 的自身基底上的前不动点条件；$\\operatorname{Lower}$ 采用 [[72-thm-least-adequate-lower-structure]]；$\\vdash^-,\\vdash^-_0$ 采用 [[72-thm-identity-free-cut-elimination]] 的 calculus。"},{"id":"f6f38fb4ec14b41d","anchor":"ref-38","locations":["正文"],"count":1,"excerpt":"[[../72-df-partial-program-completion]]"},{"id":"29de2a641cbd0b98","anchor":"ref-128","locations":["正文"],"count":1,"excerpt":"[[../72-df-partial-program-completion|72-df-partial-program-completion]]"}],"outgoing":["2d49b9fae2b96976","d9586f246c1c6084","c472b2ba86057172"]}