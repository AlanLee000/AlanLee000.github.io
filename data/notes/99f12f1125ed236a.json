f)\\leftrightarrow \\mathrm{ZfcRecursion4ComputableMetricSpace}_S(X,d_X,\\alpha_X)\\land\\mathrm{ZfcRecursion4ComputableMetricSpace}_S(Y,d_Y,\\alpha_Y)\\land\\mathrm{Function}(f,X,Y)\\land\\exists e\\in\\omega\\;\\exists\\Phi_e\\;\\Bigl(\\mathrm{ZfcRecursion2TuringFunctional}_S(\\Phi_e,e)\\land\\forall x\\in X\\;\\forall p\\in\\omega^\\omega\\;\\bigl(\\mathrm{ZfcRecursion4NameInComputableSpace}_S(X,d_X,\\alpha_X,x,p)\\to\\exists G\\subseteq\\omega\\;\\exists q\\in\\omega^\\omega\\;(\\mathrm{BaireGraphCode}_S(G,p)\\land\\mathrm{OracleOutput}_S(q,\\Phi_e,G)\\land\\mathrm{ZfcRecursion4NameInComputableSpace}_S(Y,d_Y,\\alpha_Y,f(x),q))\\bigr)\\Bigr)","display":true},{"tex":"x\\in X","display":false},{"tex":"f(x)","display":false},{"tex":"\\omega","display":false}],"bytes":2652,"backlinks":[{"id":"6f2ff6d2212fecee","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"26eb5b3a994871b2","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcRecursion4ComputableMap}_S$ (computable-map predicate, see [[../batch07/58-df-zfc-recursion4-computable-map]])"},{"id":"84daad544872cc71","anchor":"ref-3260","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-zfc-recursion4-computable-map.md|58-df-zfc-recursion4-computable-map]]（batch07）"}],"outgoing":["36d7463d215be751","7f0d78eba77f4a30","cd77d1a968b64c37","aae13e7d5032f432"]}