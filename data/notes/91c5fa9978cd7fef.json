{"id":"91c5fa9978cd7fef","group":"73","path":"73/73-df-nfa-extended-transition.md","title":"Extended Transition of an NFA","display":"df-nfa-run — Extended Transition of an NFA","type":"definition","metadata":{"type":"definition","book":"Automata Theory, Languages and Computation (Hopcroft, Ullman)","book_abbrev":"73","label":"73-df-nfa-extended-transition","aliases":["73-df-nfa-extended-transition","73-df-nfa-run"],"display":"df-nfa-run — Extended Transition of an NFA","depends_on":["[[73-df-nfa-structure]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Automata Theory, Languages and Computation (Hopcroft, Ullman)"},{"key":"book_abbrev","html":"73"},{"key":"label","html":"73-df-nfa-extended-transition"},{"key":"aliases","html":"<div class=\"property-array\"><span>73-df-nfa-extended-transition</span><span>73-df-nfa-run</span></div>"},{"key":"display","html":"df-nfa-run — Extended Transition of an NFA"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"5abb4703af79a510\" href=\"?note=5abb4703af79a510\" title=\"73-df-nfa-structure\">73-df-nfa-structure</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\Sigma\">\\(\\Sigma\\)</span> (alphabet)</li>\n<li><span class=\"math-inline\" data-tex=\"M=(Q,\\Sigma,\\delta,q_0,F)\\in\\mathsf{NFA}_{\\Sigma}\">\\(M=(Q,\\Sigma,\\delta,q_0,F)\\in\\mathsf{NFA}_{\\Sigma}\\)</span> (nondeterministic finite automaton, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"5abb4703af79a510\" href=\"?note=5abb4703af79a510\" title=\"73-df-nfa-structure\">73-df-nfa-structure</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}nfa\\text{-}run}\\vdash\n\\widehat{\\delta}_M:Q\\times\\Sigma^*\\to\\mathcal P(Q)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">