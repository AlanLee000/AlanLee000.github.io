\\}}&u,v\\in N\\land u\\neq v,\\\\0&(u,v)\\notin(\\{s\\}\\times N)\\cup(N\\times\\{t\\})\\cup\\{(i,j)\\in N^2\\mid i\\neq j\\}.\\end{cases}","display":true},{"tex":"\\mathcal C_q\\coloneqq\\{S\\subseteq W_q\\mid s\\in S\\land t\\notin S\\},\\qquad\\operatorname{Cap}_q(S)\\coloneqq\\sum_{u\\in S}\\sum_{v\\in W_q\\setminus S}\\gamma_q(u,v)\\;(S\\in\\mathcal C_q).","display":true},{"tex":"S_n(x)\\coloneqq\\{s\\}\\cup\\{i\\in N\\mid x_i=0\\}\\;(x\\in\\mathbb B^n),\\qquad X_n(S)\\coloneqq\\{(i,0)\\mid i\\in S\\cap N\\}\\cup\\{(i,1)\\mid i\\in N\\setminus S\\}\\;(S\\in\\mathcal C_q).","display":true},{"tex":"\\mathrm{CutCap}_q:\\mathbb B^n\\to\\mathbb R_{\\geq0},\\qquad\\mathrm{CutCap}_q(x)\\coloneqq\\operatorname{Cap}_q(S_n(x))\\quad(x\\in\\mathbb B^n),\\qquad\\mathrm{MinCut}(q)\\coloneqq\\min_{S\\in\\mathcal C_q}\\operatorname{Cap}_q(S).","display":true}],"bytes":3091,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-313","locations":["正文"],"count":1,"excerpt":"[[27-df-quadcut|df-quadcut — Nonnegative-capacity network for a submodular quadratic]]"},{"id":"1d0e29e9558d4e2f","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$n\\in\\mathbb N$，$q\\in\\mathrm{QuadPB}_n\\cap\\mathrm{Submodular}_n$；$c,a_i,b_{ij},d_i,\\kappa(q),\\gamma_q,\\mathrm{CutCap}_q$（see [[27-df-quadcut]]）；q 的规范多线性表示（see [[27-thm-pbpoly]]）。"},{"id":"a84438ff57f97872","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$n\\in\\mathbb N$，$q\\in\\mathrm{QuadPB}_n\\cap\\mathrm{Submodular}_n$；$\\mathcal C_q,S_n,X_n,\\operatorname{Cap}_q,\\kappa(q),\\mathrm{MinCut}(q)$（see [[27-df-quadcut]]），$\\mathrm{PBArgmin}$（see [[27-df-pbopt]]），逐点容量等式（see [[27-thm-quadmincut]]）。"}],"outgoing":["db1311544a44ed95","9c7a7ba711a14913","7937ecc11ac59760","fb0ee9f563db54d8"]}