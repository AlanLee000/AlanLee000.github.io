all s\\in V\\;(\\mathrm{Assign}(\\mathcal M,s)\\to\n\\operatorname{Sat}(\\phi,s))\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\models","display":false},{"tex":"\\{a \\in M^n : \\mathcal{M} \\models \\phi(a)\\}","display":false}],"bytes":2263,"backlinks":[{"id":"4b5630ce92265965","anchor":"ref-8","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"62380c4175149562","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1328","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-truth.md|58-df-truth]]（batch01）"}],"outgoing":["8b6a90316aad78a4","d9b8711cda3f31ca","64f35ba2e87964e0","65418b505fc53093","715a32e91161b34f"]}