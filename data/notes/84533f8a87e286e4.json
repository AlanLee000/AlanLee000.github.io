osedHull}_S(H,A)\\leftrightarrow A\\subseteq H\\land(\\forall u\\in H\\;\\bigcup u\\in H)\\land\\forall C\\in V\\;\\bigl((A\\subseteq C\\land\\forall u\\in C\\;\\bigcup u\\in C)\\to H\\subseteq C\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}union\\text{-}closed\\text{-}hull} \\vdash \\mathrm{ZfcSet10UnionClosedHull}_S(H,A)\\leftrightarrow A\\subseteq H\\land(\\forall u\\in H\\;\\bigcup u\\in H)\\land\\forall C\\in V\\;\\bigl((A\\subseteq C\\land\\forall u\\in C\\;\\bigcup u\\in C)\\to H\\subseteq C\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary union closure definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-ax-union","status":"resolved","id":"b56ca7a92384a70a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-union]]","embed":false},{"target":"58-df-union","status":"resolved","id":"5a295a90caf70085","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-union]]","embed":false}],"math":[{"tex":"H,A\\in V","display":false},{"tex":"\\mathrm{ZfcSet10UnionClosedHull}_S:V^2\\to\\mathsf{Bool}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}union\\text{-}closed\\text{-}hull} \\vdash \\mathrm{ZfcSet10UnionClosedHull}_S(H,A)\\leftrightarrow A\\subseteq H\\land(\\forall u\\in H\\;\\bigcup u\\in H)\\land\\forall C\\in V\\;\\bigl((A\\subseteq C\\land\\forall u\\in C\\;\\bigcup u\\in C)\\to H\\subseteq C\\bigr)","display":tr