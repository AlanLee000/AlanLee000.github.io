)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal P^M(\\kappa)\\coloneqq\\{A\\in\\operatorname{Univ}(M):A\\subseteq\\kappa\\}\">\\(\\mathcal P^M(\\kappa)\\coloneqq\\{A\\in\\operatorname{Univ}(M):A\\subseteq\\kappa\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ElementaryEmbedding}_S\">\\(\\mathrm{ElementaryEmbedding}_S\\)</span> is the elementary-embedding predicate (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"a25c0a66cf56c0f4\" href=\"?note=a25c0a66cf56c0f4\" title=\"../batch04/58-df-elementary-embedding.md\">../batch04/58-df-elementary-embedding.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ultrafilter}_S\">\\(\\mathrm{Ultrafilter}_S\\)</span> is the ultrafilter predicate (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"5e8b8d97b21dd8e8\" href=\"?note=5e8b8d97b21dd8e8\" title=\"../batch14/58-df-ultrafilter.md\">../batch14/58-df-ultrafilter.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcLargecard4UltrafilterDerivedEmbedding}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcLargecard4UltrafilterDerivedEmbedding}_S:V^5\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}ultrafilter\\text{-}derived\\text{-}embedding} \\vdash \\mathrm{ZfcLargecard4UltrafilterDerivedEmbedding}_S(j,M,N,\\kappa,U)\\leftrightarrow \\mathrm{ElementaryEmbedding}_S(j,M,N)\\land\\kappa\\in\\operatorname{Univ}(M)\\land\\forall\\alpha\\in\\kappa\\;(j(\\alpha)=\\alpha)\\land j(\\kappa)\\neq\\kappa\\land U=\\{A\\in\\mathcal P^M(\\kappa):\\kappa\\in j(A)\\}\\land\\mathrm{Ultrafilter}_S(U,\\kappa)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}ultrafilter\\text{-}derived\\text{-}embedding} \\vdash \\mathrm{ZfcLargecard4UltrafilterDerivedEmbedding}_S(j,M,N,\\kappa,U)\\leftrightarrow \\mathrm{ElementaryEmbedding}_S(j,M,N)\\land\\kappa\\in\\operatorname{Univ}(M)\\land\\forall\\alpha\\in\\kappa\\;(j(\\alpha)=\\alpha)\\land j(\\kappa)\\neq\\kappa\\land U=\\{A\\in\\mathcal P^M(\\kappa):\\kappa\\in j(A)\\}\\land\\mathrm{Ultrafilter}_S(U,\\kappa)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch04/58-df-elementary-embedding.md","status":"resolved","id":"a25c0a66cf56c0f4","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-elementary-embedding.md]]","embed":false},{"target":"../batch14/58-df-ultrafilter.md","status":"resolved","id":"5e8b8d97b21dd8e8","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-df-ultrafilter.md]]","embed":false},{"target":"../batch04/58-df-elementary-embedding.md","status":"resolved","id":"a25c0a66cf56c0f4","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ElementaryEmbedding}_S$ is the elementary-embedding predicate (see [[../batch04/58-df-elementary-embedding.md]])","embed":false},{"target":"../batch14/58-df-ultrafilter.md","status":"resolved","id":"5e8b8d97b21dd8e8","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Ultrafilter}_S$ is the ultrafilter predicate (see [[../batch14/58-df-ultrafilter.md]])","embed":false}],"math":[{"tex":"j,M,N,\\kappa,U\\in V","display":false},{"tex":"\\mathcal P^M(\\kappa)\\coloneqq\\{A\\i