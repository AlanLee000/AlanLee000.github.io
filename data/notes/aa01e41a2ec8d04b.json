\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},&\n\\mathsf I_6&=\\{A\\to A\\lor B\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},\\\\\n\\mathsf I_7&=\\{B\\to A\\lor B\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},&\n\\mathsf I_8&=\\{(A\\to C)\\to((B\\to C)\\to(A\\lor B\\to C))\\mid A,B,C\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},\\\\\n\\mathsf I_9&=\\{\\bot\\to A\\mid A\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\}.\n\\end{aligned}","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{S}K}=\\{\\mathsf S(A\\to B)\\to(\\mathsf S A\\to\\mathsf S B)\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{S}L}=\\{\\mathsf S(\\mathsf S A\\to A)\\to\\mathsf S A\\mid A\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{S}C}=\\{\\mathsf S A\\to\\mathsf S\\mathsf S A\\mid A\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{Sm}}=\\mathsf{Ax}_{\\mathsf I}^{\\mathsf{Sm}}\\cup\\mathsf{Ax}_{\\mathsf{S}K}\\cup\\mathsf{Ax}_{\\mathsf{S}L}\\cup\\mathsf{Ax}_{\\mathsf{S}C}.","display":true},{"tex":"\\mathsf S","display":false},{"tex":"\\mathsf{MP}_{\\mathsf{Sm}}\\subseteq(\\mathsf{Frm}_{\\mathsf{Sm}}^2\\times\\mathsf{Frm}_{\\mathsf{Sm}}),\n\\quad\n\\mathsf{Nec}_{\\mathsf{Sm}}\\subseteq(\\mathsf{Frm}_{\\mathsf{Sm}}^1\\times\\mathsf{Frm}_{\\mathsf{Sm}}),\n\\quad\n\\mathsf{RuleSub}_{\\mathsf{Sm}}\\subseteq(\\mathsf{Frm}_{\\mathsf{Sm}}^1\\times\\mathsf{Frm}_{\\mathsf{Sm}}).","display":true},{"tex":"\\mathsf{MP}_{\\mathsf{Sm}}=\\{((A,A\\to B),B)\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\},\n\\quad\n\\mathsf{Nec}_{\\mathsf{Sm}}=\\{((A),\\mathsf S A)\\mid A\\in\\mathsf{Frm}_{\\mathsf{Sm}}\\}.","display":true},{"tex":"\\mathsf{RuleSub}_{\\mathsf{Sm}}\n=\n\\{((A),\\widehat\\sigma(A)):A\\in\\mathsf{Frm}_{\\mathsf{Sm}},\\ \\sigma\\in\\mathsf{Subst}_{\\mathsf{Sm}}\\}.","display":true},{"tex":"\\Gamma\\subseteq\\mathsf{Frm}_{\\mathsf{Sm}}","display":false},{"tex":"\\pi=((D_0,C_0),\\ldots,(D_{m-1},C_{m-1})),","display":true},{"t