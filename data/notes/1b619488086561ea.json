cal{T\\!h}_{G\\!L}=\\mathrm{GL}","display":false}],"bytes":1240,"backlinks":[{"id":"09d08f3e4b6f7fbb","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e0c421a5b45aeb77","anchor":"ref-90","locations":["正文"],"count":2,"excerpt":"自然数输入的判定接口：[[89-df-modal-godel-code]] → [[89-df-gl-decidability]] → [[89-thm-gl-decidability]]。"}],"outgoing":["128a3cd6545693f6","3bbdf6f3419b5805","f0380129bd9e48f3","ff66b5cf43748aff","b560939370c68b68","0006800fa1c85177","cf7dbabb97c0679f"]}