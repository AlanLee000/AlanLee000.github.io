{"id":"e953363e1f90386b","group":"58","path":"58/batch14/58-df-zfc-top6-connected-space.md","title":"ZFC Top6 Connected Space","display":"df-zfc-top6-connected-space — ZFC Top6 Connected Space","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-top6-connected-space","aliases":["58-df-zfc-top6-connected-space"],"display":"df-zfc-top6-connected-space — ZFC Top6 Connected Space","depends_on":["[[58-ax-zfc]]","[[../batch15/58-df-zfc-top5-connected-space]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-top6-connected-space"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-top6-connected-space</span></div>"},{"key":"display","html":"df-zfc-top6-connected-space — ZFC Top6 Connected Space"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"7c39509f73a34120\" href=\"?note=7c39509f73a34120\" title=\"../batch15/58-df-zfc-top5-connected-space\">../batch15/58-df-zfc-top5-connected-space</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau\\in V\">\\(X,\\tau\\in V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5ConnectedSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTop5ConnectedSpace}_S\\subseteq V^2\\)</span> is from <a class=\"wiki-link\" id=\"ref-3\" data-note=\"7c39509f73a34120\" href=\"?note=7c39509f73a34120\" title=\"../batch15/58-df-zfc-top5-connected-space\">../batch15/58-df-zfc-top5-connected-space</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop6ConnectedSpace}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop6ConnectedSpace}_S:V^2\\to\\{\\top,\\bot\\}\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top6\\text{-}connected\\text{-}space}\\vdash\n\\mathrm{ZfcTop6ConnectedSpace}_S(X,\\tau)\n\\leftrightarrow\n\\mathrm{ZfcTop5ConnectedSpace}_S(X,\\tau).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top6\\text{-}connected\\text{-}space}\\vdash\n\\mathrm{ZfcTop6ConnectedSpace}_S(X,\\tau)\n\\leftrightarrow\n\\mathrm{ZfcTop5ConnectedSpace}_S(X,\\tau).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This numbered variant is an exact alias of the registered connected-space predicate, avoiding a second unregistered topology predicate.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch15/58-df-zfc-top5-connected-space","status":"resolved","id":"7c39509f73a34120","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-zfc-top5-connected-space]]","embed":false},{"target":"../batch15/58-df-zfc-top5-connected-space","status":"resolved","id":"7c39509f73a34120","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcTop5ConnectedSpace}_S\\subseteq V^2$ is from [[../batch15/58-df-zfc-top5-connected-space]].","embed":false}],"math":[{"tex":"X,\\tau\\in V","display":false},{"tex":"\\mathrm{ZfcTop5ConnectedSpace}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcTop6ConnectedSpace}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}top6\\text{-}connected\\text{-}space}\\vdash\n\\mathrm{ZfcTop6ConnectedSpace}_S(X,\\tau)\n\\leftrightarrow\n\\mathrm{ZfcTop5ConnectedSpace}_S(X,\\tau).","display":true}],"bytes":896,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3607","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-top6-connected-space.md|58-df-zfc-top6-connected-space]]（batch14）"}],"outgoing":["a3348ed9eb6fb4e3","7c39509f73a34120"]}