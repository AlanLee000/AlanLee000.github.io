bleSequence}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcCompComputableSequence}_S:V\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comp\\text{-}computable\\text{-}sequence} \\vdash \\mathrm{ZfcCompComputableSequence}_S(s)\\leftrightarrow s\\in\\omega^\\omega\\land s\\in\\mathrm{Rec}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}comp\\text{-}computable\\text{-}sequence} \\vdash \\mathrm{ZfcCompComputableSequence}_S(s)\\leftrightarrow s\\in\\omega^\\omega\\land s\\in\\mathrm{Rec}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The sequence is a unary member of the upstream total-recursive class.  The former version called an undeclared <code>TotalRecursive</code> predicate that the dependency does not define.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-sequence","status":"resolved","id":"d8eb5064b65f8a92","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-sequence]]","embed":false},{"target":"58-df-recursive","status":"resolved","id":"da0bcf2e3f060472","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-recursive]]","embed":false},{"target":"58-df-recursive","status":"resolved","id":"da0bcf2e3f060472","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Rec}$ is the class of total recursive functions of all finite arities (see [[58-df-recursive]])","embed":false}],"math":[{"tex":"s\\in V","display":false},{"tex":"\\mathrm{Rec}","display":false},{"tex":"\\mathrm{ZfcCompComputableSequence}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}comp\\text{-}computable\\text{-}sequence} \\vdash \\mathrm{ZfcCompComputableSequence}_S(s)\\leftrightarrow s\\in\\omega^\\omega\\land s\\in\\mathrm{Rec}","display":true}],"bytes":952,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1750","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-zfc-comp-computable-sequence.md|58-df-zfc-comp-computable-sequence]]（batch19）"}],"outgoing":["a3348ed9eb6fb4e3","d8eb5064b65f8a92","da0bcf2e3f060472"]}