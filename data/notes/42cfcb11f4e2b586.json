\\in2^\\omega:x\\upharpoonright\\operatorname{dom}(s)=s\\})\n\\right|\\leq2^{-n}\n\\Bigr)","display":true}],"bytes":2032,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3261","locations":["正文"],"count":1,"excerpt":"[[../batch08/58-df-zfc-recursion4-computable-measure.md|58-df-zfc-recursion4-computable-measure]]（batch08）"}],"outgoing":["a3348ed9eb6fb4e3","0578a357a86e9d8f","a11ffd0523da6a6c","e03c77e7d23896d9","b8eaf43a040e88b2"]}