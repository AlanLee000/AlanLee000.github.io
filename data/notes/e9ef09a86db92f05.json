)\\bigr)","display":true},{"tex":"\\Gamma","display":false}],"bytes":1620,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3299","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-regularity-package.md|58-df-zfc-regularity-package]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","3b8b3b1a1bbba5e8","b5b9f71b20826f2d","125313f7bdb0c910","2b6b1d9eb78a2714"]}