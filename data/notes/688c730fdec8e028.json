{"id":"688c730fdec8e028","group":"16","path":"16/16-df-coherent-fibration-compat.md","title":"历史入口","display":"df-coherent-fibration — 历史入口","type":"definition","metadata":{"type":"definition","book":"Jacobs — Categorical Logic and Type Theory","book_abbrev":"16","label":"16-df-coherent-fibration-compat","aliases":["16-df-coherent-fibration-compat"],"display":"df-coherent-fibration — 历史入口","depends_on":["[[16-df-coherent-fibration]]"],"source":"Definition 4.2.1(ii), p. 233 (PDF 253)","revision_date":"2026-10-07"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Jacobs — Categorical Logic and Type Theory"},{"key":"book_abbrev","html":"16"},{"key":"label","html":"16-df-coherent-fibration-compat"},{"key":"aliases","html":"<div class=\"property-array\"><span>16-df-coherent-fibration-compat</span></div>"},{"key":"display","html":"df-coherent-fibration — 历史入口"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"e8285984e352a6ff\" href=\"?note=e8285984e352a6ff\" title=\"16-df-coherent-fibration\">16-df-coherent-fibration</a></span></div>"},{"key":"source","html":"Definition 4.2.1(ii), p. 233 (PDF 253)"},{"key":"revision_date","html":"2026-10-07"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"p\">\\(p\\)</span> 为纤维化，<span class=\"math-inline\" data-tex=\"\\mathrm{CohFib}\">\\(\\mathrm{CohFib}\\)</span> 见 <a class=\"wiki-link\" id=\"ref-2\" data-note=\"e8285984e352a6ff\" href=\"?note=e8285984e352a6ff\" title=\"16-df-coherent-fibration\">16-df-coherent-fibration</a>，<span class=\"math-inline\" data-tex=\"\\mathrm{CohFib}_{df}\">\\(\\mathrm{CohFib}_{df}\\)</span> 为旧拼写。</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}coherent\\text{-}fibration}\\vdash\\quad \\mathrm{CohFib}_{df}(p)\\Longleftrightarrow\\mathrm{CohFib}(p).\"><div class=\"math-