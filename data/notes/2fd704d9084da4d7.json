{"id":"2fd704d9084da4d7","group":"58","path":"58/batch02/58-df-zfc-descriptive2-perfect-set.md","title":"ZFC Descriptive2 Perfect Set","display":"df-zfc-descriptive2-perfect-set — ZFC Descriptive2 Perfect Set","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-descriptive2-perfect-set","aliases":["58-df-zfc-descriptive2-perfect-set"],"display":"df-zfc-descriptive2-perfect-set — ZFC Descriptive2 Perfect Set","depends_on":["[[58-ax-zfc]]","[[../batch14/58-df-topology.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-descriptive2-perfect-set"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-descriptive2-perfect-set</span></div>"},{"key":"display","html":"df-zfc-descriptive2-perfect-set — ZFC Descriptive2 Perfect Set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"e7514bc4cefba4f2\" href=\"?note=e7514bc4cefba4f2\" title=\"../batch14/58-df-topology.md\">../batch14/58-df-topology.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"P,X,\\tau\\in V\">\\(P,X,\\tau\\in V\\)</span> (subset, carrier, and topology)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcDescriptive2PerfectSet}_S\">\\(\\mathrm{ZfcDescriptive2PerfectSet}_S\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Top}\">\\(\\mathrm{Top}\\)</span> (topology predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"e7514bc4cefba4f2\" href=\"?note=e7514bc4cefba4f2\" title=\"../batch14/58-df-topology.md\">../batch14/58-df-topology.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}perfect\\text{-}set} \\vdash\n\\mathrm{ZfcDescriptive2PerfectSet}_S(P,X,\\tau)\\leftrightarrow\\left(\n\\mathrm{Top}(\\tau,X)\\land P\\subseteq X\\land X\\setminus P\\in\\tau\\land\n\\forall x\\in P\\;\\forall U\\in\\tau\\;\n\\bigl(x\\in U\\to\\exists y\\in P\\cap U\\;(y\\neq x)\\bigr)\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}perfect\\text{-}set} \\vdash\n\\mathrm{ZfcDescriptive2PerfectSet}_S(P,X,\\tau)\\leftrightarrow\\left(\n\\mathrm{Top}(\\tau,X)\\land P\\subseteq X\\land X\\setminus P\\in\\tau\\land\n\\forall x\\in P\\;\\forall U\\in\\tau\\;\n\\bigl(x\\in U\\to\\exists y\\in P\\cap U\\;(y\\neq x)\\bigr)\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch14/58-df-topology.md","status":"resolved","id":"e7514bc4cefba4f2","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-df-topology.md]]","embed":false},{"target":"../batch14/58-df-topology.md","status":"resolved","id":"e7514bc4cefba4f2","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Top}$ (topology predicate, see [[../batch14/58-df-topology.md]])","embed":false}],"math":[{"tex":"P,X,\\tau\\in V","display":false},{"tex":"\\mathrm{ZfcDescriptive2PerfectSet}_S","display":false},{"tex":"\\mathrm{Top}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}perfect\\text{-}set} \\vdash\n\\mathrm{ZfcDescriptive2PerfectSet}_S(P,X,\\tau)\\leftrightarrow\\left(\n\\mathrm{Top}(\\tau,X)\\land P\\subseteq X\\land X\\setminus P\\in\\tau\\land\n\\forall x\\in P\\;\\forall U\\in\\tau\\;\n\\bigl(x\\in U\\to\\exists y\\in P\\cap U\\;(y\\neq x)\\bigr)\\right)","display":true}],"bytes":948,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1813","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-zfc-descriptive2-perfect-set.md|58-df-zfc-descriptive2-perfect-set]]（batch02）"}],"outgoing":["a3348ed9eb6fb4e3","e7514bc4cefba4f2"]}