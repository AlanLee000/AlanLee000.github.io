\n\\end{gathered}\\right].","display":true},{"tex":"q(e,\\vec a)","display":false},{"tex":"e","display":false},{"tex":"p","display":false},{"tex":"s_n^m(e,\\vec a)=p(q(e,\\vec a),\\operatorname{code}_{m+1}(e,\\vec a))","display":false}],"bytes":2130,"backlinks":[{"id":"94da30522fe93e7f","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"69cf8a2e13927557","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-acceptable-numbering]]；see [[20-df-pairing]]；see [[20-thm-smn]]；see [[20-thm-K-undecidable]]。"},{"id":"05d82ffd170fb7a6","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-function-tree]]；see [[20-thm-smn]]。"},{"id":"d9aaf109dea18156","anchor":"ref-13","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-movable-markers]]；see [[20-thm-sigma3-representation]]；see [[20-df-ext]]；see [[20-df-stages]]；see [[20-thm-smn]]；see [[20-lem-padding]]。"},{"id":"824c073fd4a6ee10","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-productive]]；see [[20-thm-smn]]。"},{"id":"bb045b68eb24d902","anchor":"ref-14","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-computable-independence]]；see [[20-df-uniform-ce-sequence]]；see [[20-lem-one-action-priority-bound]]；see [[20-lem-use-preservation]]；see [[20-df-pairing]]；see [[20-df-oracle-stage-evaluation]]；see [[20-thm-smn]]。"},{"id":"ceab247000d7caa9","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-uniform-ce-sequence]]；see [[20-df-stages]]；see [[20-thm-smn]]；see [[20-df-recursive]]；see [[20-df-computable]]。"},{"id":"b222e27484042250","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-closed-class]]；see [[20-df-stages]]；see [[20-df-computable]]；see [[20-df-recursive]]；see [[20-thm-smn]]。"},{"id":"eedfed81ed59c040","anchor":"ref-20","locations":["元数据 · de