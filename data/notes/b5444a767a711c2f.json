n V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathcal P\">\\(\\mathcal P\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Finite}\">\\(\\mathrm{Finite}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{Ideal}\">\\(\\mathrm{Ideal}\\)</span> are as in <a class=\"wiki-link\" id=\"ref-5\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>, <a class=\"wiki-link\" id=\"ref-6\" data-note=\"2b6b1d9eb78a2714\" href=\"?note=2b6b1d9eb78a2714\" title=\"../batch09/58-df-powerset.md\">../batch09/58-df-powerset.md</a>, <a class=\"wiki-link\" id=\"ref-7\" data-note=\"d9a25b0ac94a3598\" href=\"?note=d9a25b0ac94a3598\" title=\"../batch04/58-df-finite.md\">../batch04/58-df-finite.md</a>, and <a class=\"wiki-link\" id=\"ref-8\" data-note=\"6e4f95381faac4f9\" href=\"?note=6e4f95381faac4f9\" title=\"../batch05/58-df-ideal.md\">../batch05/58-df-ideal.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{FiniteSubmeasure}_S\\subseteq V^2\">\\(\\mathrm{FiniteSubmeasure}_S\\subseteq V^2\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcIdeal7FragmentedIdeal}_S\\subseteq V^3\">\\(\\mathrm{ZfcIdeal7FragmentedIdeal}_S\\subseteq V^3\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}ideal7\\text{-}finite\\text{-}submeasure}\\vdash\n\\mathrm{FiniteSubmeasure}_S(\\varphi,P)\\leftrightarrow\n\\mathrm{Function}(\\varphi,\\mathcal P(P),\\mathbb R_{\\geq0})\\land\n\\varphi(\\emptyset)=0\\land\n\\forall A,B\\subseteq P\\;(A\\subseteq B\\to\\varphi(A)\\leq\\varphi(B))\\land\n\\forall A,B\\subseteq P\\;(\\varphi(A\\cup B)\\leq\\varphi(A)+\\varphi(B))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}ideal7\\text{-}finite\\text{-}submeasure}\\vdash\n\\mathrm{FiniteSubmeasure}_S(\\varphi,P)\\leftrightarrow\n\\mathrm{Function}(\\varphi,\\mathcal P(P),\\mathbb R_{\\geq0})\\land\n\\varphi(\\emptyset)=0\\land\n\\forall A,B\\subseteq P\\;(A\\subseteq B\\to\\varphi(A)\\leq\\varphi(B))\\land\n\\forall A,B\\subseteq P\\;(\\varphi(A\\cup B)\\leq\\varphi(A)+\\varphi(B))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}ideal7\\text{-}fragmented\\text{-}ideal} \\vdash\n\\mathrm{ZfcIdeal7FragmentedIdeal}_S(\\mathcal I,\\vec P,\\vec\\varphi)\\leftrightarrow\n\\mathrm{Function}(\\vec P,\\omega,\\mathcal P(\\omega))\\land\n\\forall n\\in\\omega\\;(\\vec P(n)\\neq\\emptyset\\land\\mathrm{Finite}(\\vec P(n)))\\land\n\\forall m,n\\in\\omega\\;(m\\neq n\\to\\vec P(m)\\cap\\vec P(n)=\\emptyset)\\land\n\\bigcup_{n\\in\\omega}\\vec P(n)=\\omega\\land\n\\mathrm{Function}(\\vec\\varphi,\\omega,\\operatorname{ran}(\\vec\\varphi))\\land\n\\forall n\\in\\omega\\;\\mathrm{FiniteSubmeasure}_S(\\vec\\varphi(n),\\vec P(n))\\land\n\\mathcal I=\\{A\\subseteq\\omega:\\sup_{n\\in\\omega}\\vec\\varphi(n)(A\\cap\\vec P(n))&lt;\\infty\\}\\land\n\\mathrm{Ideal}(\\mathcal I,\\mathcal P(\\omega))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}ideal7\\text{-}fragmented\\text{-}ideal} \\vdash\n\\mathrm{ZfcIdeal7FragmentedIdeal}_S(\\mathcal I,\\vec P,\\vec\\varphi)\\leftrightarrow\n\\mathrm{Function}(\\vec P,\\omega,\\mathcal P(\\omega))\\land\n\\forall n\\in\\omega\\;(\\vec P(n)\\neq\\emptyset\\land\\mathrm{Finite}(\\vec P(n)))\\land\n\\forall m,n\\in\\omega\\;(m\\neq n\\to\\vec P(m)\\cap\\vec P(n)=\\emptyset)\\land\n\\bigcup_{n\\in\\omega}\\vec P(n)=\\omega\\land\n\\mathrm{Function}(\\vec\\varphi,\\omega,\\operatorname{ran}(\\vec\\varphi))\\land\n\\forall n\\in\\omega\\;\\mathrm{FiniteSubmeasure}_S(\\vec\\varphi(n),\\vec P(n))\\land\n\\mathcal I=\\{A\\subseteq\\omega:\\sup_{n\\in\\omega}\\vec\\varphi(n)(A\\cap\\vec P(n))&lt;\\infty\\}\\land\n\\mathrm{Ideal}(\\mathcal I,\\mathcal P(\\omega))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC ideal definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch09/58-df-powerset.md","status":"resolved","id":"2b6b1d9eb78a2714","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch09/58-df-powerset.md]]","embed":false},{"target":"../batch04/58-df-finite.md","status":"resolved","id":"d9a25b0ac94a3598","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-finite.md]]","embed":false},{"target":"../batch05/58-df-ideal.md","status":"resolved","id":"6e4f95381faac4f9","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-ideal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}$, $\\mathcal P$, $\\mathrm{Finite}$, and $\\mathrm{Ideal}$ are as in [[../batch16/58-df-function.md]], [[../batch09/58-df-powerset.md]], [[../batch04/58-df-finite.md]], and [[../batch05/58-df-ideal.md]].","embed":false},{"target":"../batch09/58-df-powerset.md","status":"resolved","id":"2b6b1d9eb78a2714","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":