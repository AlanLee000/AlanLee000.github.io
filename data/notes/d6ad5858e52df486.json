{"id":"d6ad5858e52df486","group":"58","path":"58/batch05/58-thm-bounding-number.md","title":"Bounding Number","display":"thm-bounding-number — Bounding Number","type":"theorem","metadata":{"type":"theorem","book":"Set Theory","book_abbrev":"58","label":"58-thm-bounding-number","aliases":["58-thm-bounding-number"],"display":"thm-bounding-number — Bounding Number","depends_on":["[[58-df-cardinal]]","[[58-df-function]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"theorem"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-thm-bounding-number"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-thm-bounding-number</span></div>"},{"key":"display","html":"thm-bounding-number — Bounding Number"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"5fb1c2241d1943d1\" href=\"?note=5fb1c2241d1943d1\" title=\"58-df-cardinal\">58-df-cardinal</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathfrak b\\in V\">\\(\\mathfrak b\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> and <span class=\"math-inline\" data-tex=\"\\omega^\\omega=\\{f\\in V\\mid\\mathrm{Function}(f,\\omega,\\omega)\\}\">\\(\\omega^\\omega=\\{f\\in V\\mid\\mathrm{Function}(f,\\omega,\\omega)\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\leq^*\\;\\subseteq(\\omega^\\omega)^2\">\\(\\leq^*\\;\\subseteq(\\omega^\\omega)^2\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"f\\leq^*g\\leftrightarrow\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;(N\\leq n\\to f(n)\\leq g(n))\">\\(f\\leq^*g\\leftrightarrow\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;(N\\leq n\\to f(n)\\leq g(n))\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}bounding\\text{-}number} \\vdash \\mathfrak b=\\min\\left\\{|F|\\mid F\\subseteq\\omega^\\omega\\land\\forall g\\in\\omega^\\omega\\;\\exists f\\in F\\;\\forall N\\in\\omega\\;\\exists n\\in\\omega\\;(N\\leq n\\land g(n)&lt;f(n))\\right\\}\\land\\omega_1\\leq\\mathfrak b\\leq 2^{\\aleph_0}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}bounding\\text{-}number} \\vdash \\mathfrak b=\\min\\left\\{|F|\\mid F\\subseteq\\omega^\\omega\\land\\forall g\\in\\omega^\\omega\\;\\exists f\\in F\\;\\forall N\\in\\omega\\;\\exists n\\in\\omega\\;(N\\leq n\\land g(n)&lt;f(n))\\right\\}\\land\\omega_1\\leq\\mathfrak b\\leq 2^{\\aleph_0}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathfrak{b}\">\\(\\mathfrak{b}\\)</span> is the minimum size of an unbounded family in <span class=\"math-inline\" data-tex=\"\\omega^{\\omega}\">\\(\\omega^{\\omega}\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\omega_1 \\leq \\mathfrak{b} \\leq \\mathfrak{c}\">\\(\\omega_1 \\leq \\mathfrak{b} \\leq \\mathfrak{c}\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-cardinal","status":"resolved","id":"5fb1c2241d1943d1","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-cardinal]]","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-function]]","embed":false}],"math":[{"tex":"\\mathfrak b\\in V","display":false},{"tex":"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\omega^\\omega=\\{f\\in V\\mid\\mathrm{Function}(f,\\omega,\\omega)\\}","display":false},{"tex":"\\leq^*\\;\\subseteq(\\omega^\\omega)^2","display":false},{"tex":"f\\leq^*g\\leftrightarrow\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;(N\\leq n\\to f(n)\\leq g(n))","display":false},{"tex":"\\mathrm{thm\\text{-}bounding\\text{-}number} \\vdash \\mathfrak b=\\min\\left\\{|F|\\mid F\\subseteq\\omega^\\omega\\land\\forall g\\in\\omega^\\omega\\;\\exists f\\in F\\;\\forall N\\in\\omega\\;\\exists n\\in\\omega\\;(N\\leq n\\land g(n)<f(n))\\right\\}\\land\\omega_1\\leq\\mathfrak b\\leq 2^{\\aleph_0}","display":true},{"tex":"\\mathfrak{b}","display":false},{"tex":"\\omega^{\\omega}","display":false},{"tex":"\\omega_1 \\leq \\mathfrak{b} \\leq \\mathfrak{c}","display":false}],"bytes":1019,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4059","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-thm-bounding-number.md|58-thm-bounding-number]]（batch05）"}],"outgoing":["5fb1c2241d1943d1","36d7463d215be751"]}