,S,p)\\leftrightarrow{}&\n\\mathrm{SmoothChart}_{58}(c,S)\\land\\exists U,W,\\phi\\;\\bigl[c=\\langle U,W,\\phi\\rangle\n\\land p\\in U\\land v\\in T(S,p)\\land x\\in\\mathbb R^n\\\\\n&\\land\\forall i<n\\;\\exists h\\in C(S)\\;\\exists O\\in\\tau\\;\n\\bigl(p\\in O\\subseteq U\\land\\forall q\\in O\\;h(q)=\\phi(q)(i)\\land x(i)=v(h)\\bigr)\\bigr].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{JacobianData}_{58}(J,F,O,n,m,x)\\leftrightarrow{}&\n\\mathrm{EuclideanSmoothMap}_S(F,O,n,m)\\land x\\in O\\land J\\in\\mathbb R^{m\\times n}\\\\\n&\\land\\exists D\\in(\\mathbb R^O)^{m\\times n}\\;\\forall i<m\\;\\forall j<n\\;\n\\bigl(\\mathrm{CoordinateDerivative}_S(D(i,j),F_i,O,n,j)\\land J(i,j)=D(i,j)(x)\\bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{CriticalPointData}_{58}(p,f,S,S')\\leftrightarrow{}&\n\\mathrm{SmoothManifoldRecord}_{58}(S)\\land\\mathrm{SmoothManifoldRecord}_{58}(S')\n\\land\\mathrm{SmoothMapStructure}_S(f,M,\\tau,\\mathcal A,n,N,\\sigma,\\mathcal B,m)\\\\\n&\\land\\exists\\langle U,W,\\phi\\rangle\\in\\mathcal A\\;\\exists\\langle V,Z,\\psi\\rangle\\in\\mathcal B\\;\n\\exists O\\in\\tau\\;\\exists J,F,a\\;\\bigl[\np\\in O\\subseteq U\\land f[O]\\subseteq V\\\\\n&\\land F=\\{\\langle\\phi(q),\\psi(f(q))\\rangle:q\\in O\\}\n\\land\\mathrm{JacobianData}_{58}(J,F,\\phi[O],n,m,\\phi(p))\\\\\n&\\land a\\in\\mathbb R^m\\land\\exists i<m\\;a(i)\\ne0\n\\land\\forall j<n\\;\\sum_{i<m}a(i)J(i,j)=0\\bigr].\n\\end{aligned}","display":true}],"bytes":3904,"backlinks":[{"id":"b80ea50ccf56b0ca","anchor":"ref-9","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"d7bfcf5788937844","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{CriticalPointData}$ 取 [[58-df-manifold-coordinate-data.md]] 的同名定义与参数次序。"},{"id":"f810bf542334e0d1","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{SmoothChart}$ 取 [[../batch03/58-df-manifold-coordinat