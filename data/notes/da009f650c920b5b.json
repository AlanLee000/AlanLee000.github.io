{"id":"da009f650c920b5b","group":"58","path":"58/batch05/58-df-zfc-measure11-fubini-section-map.md","title":"ZFC Measure11 Fubini Section Map","display":"df-zfc-measure11-fubini-section-map — ZFC Measure11 Fubini Section Map","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-measure11-fubini-section-map","aliases":["58-df-zfc-measure11-fubini-section-map"],"display":"df-zfc-measure11-fubini-section-map — ZFC Measure11 Fubini Section Map","depends_on":["[[58-ax-zfc]]","[[../batch16/58-df-function.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-measure11-fubini-section-map"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-measure11-fubini-section-map</span></div>"},{"key":"display","html":"df-zfc-measure11-fubini-section-map — ZFC Measure11 Fubini Section Map"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"A,X,Y,s\\in V,\\quad A\\subseteq X\\times Y\">\\(A,X,Y,s\\in V,\\quad A\\subseteq X\\times Y\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure11FubiniSectionMap}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcMeasure11FubiniSectionMap}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}fubini\\text{-}section\\text{-}map}\\vdash\\mathrm{ZfcMeasure11FubiniSectionMap}_S(s,A,X)\\leftrightarrow\\exists Y\\;\\left(A\\subseteq X\\times Y\\land\\mathrm{Function}(s,X,\\mathcal P(Y))\\land\\forall x\\in X\\;\\left(s(x)=\\{y\\in Y:\\langle x,y\\rangle\\in A\\}\\right)\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}fubini\\text{-}section\\text{-}map}\\vdash\\mathrm{ZfcMeasure11FubiniSectionMap}_S(s,A,X)\\leftrightarrow\\exists Y\\;\\left(A\\subseteq X\\times Y\\land\\mathrm{Function}(s,X,\\mathcal P(Y))\\land\\forall x\\in X\\;\\left(s(x)=\\{y\\in Y:\\langle x,y\\rangle\\in A\\}\\right)\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The value <span class=\"math-inline\" data-tex=\"s(x)\">\\(s(x)\\)</span> is exactly the vertical section <span class=\"math-inline\" data-tex=\"A_x\">\\(A_x\\)</span> and lies in the power set of the second coordinate space.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false}],"math":[{"tex":"A,X,Y,s\\in V,\\quad A\\subseteq X\\times Y","display":false},{"tex":"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcMeasure11FubiniSectionMap}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}fubini\\text{-}section\\text{-}map}\\vdash\\mathrm{ZfcMeasure11FubiniSectionMap}_S(s,A,X)\\leftrightarrow\\exists Y\\;\\left(A\\subseteq X\\times Y\\land\\mathrm{Function}(s,X,\\mathcal P(Y))\\land\\forall x\\in X\\;\\left(s(x)=\\{y\\in Y:\\langle x,y\\rangle\\in A\\}\\right)\\right)","display":true},{"tex":"s(x)","display":false},{"tex":"A_x","display":false}],"bytes":1011,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2557","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-zfc-measure11-fubini-section-map.md|58-df-zfc-measure11-fubini-section-map]]（batch05）"}],"outgoing":["a3348ed9eb6fb4e3","36d7463d215be751"]}