\\Gamma)\\Bigr).\n\\end{aligned}","display":true},{"tex":"f:P\\to\\lambda","display":false},{"tex":"f(y)","display":false},{"tex":"\\Gamma^{f(y)}=\\{z:zRy\\}","display":false},{"tex":"\\{z:zSy\\}","display":false},{"tex":"yRy","display":false},{"tex":"f(y)","display":false},{"tex":"P","display":false},{"tex":"P\\subseteq\\omega","display":false},{"tex":"f","display":false},{"tex":"\\lambda","display":false},{"tex":"\\omega_1","display":false},{"tex":"\\lambda=0","display":false}],"bytes":2713,"backlinks":[{"id":"e40f6292323bbb0b","anchor":"ref-141","locations":["正文"],"count":1,"excerpt":"[[./18-thm-prewellordering]]"},{"id":"e29d1100705cdb23","anchor":"ref-135","locations":["正文"],"count":1,"excerpt":"[[../18-thm-prewellordering]]"},{"id":"bf01645e59119446","anchor":"ref-144","locations":["正文"],"count":1,"excerpt":"[[../18-thm-prewellordering|18-thm-prewellordering]]"}],"outgoing":["03fd31ede57cedbe","267d66ca73221e94","b8684802726abc97"]}