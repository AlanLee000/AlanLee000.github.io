{"id":"d8f6cb40eba269af","group":"89","path":"89/89-df-modalized-formula.md","title":"Modalized Formula","display":"df-modalized-formula — Modalized Formula","type":"definition","metadata":{"type":"definition","book":"The Logic of Provability","book_abbrev":"89","label":"89-df-modalized-formula","aliases":["89-df-modalized-formula"],"display":"df-modalized-formula — Modalized Formula","depends_on":["[[89-df-modalized]]","[[89-df-modal-formula]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"The Logic of Provability"},{"key":"book_abbrev","html":"89"},{"key":"label","html":"89-df-modalized-formula"},{"key":"aliases","html":"<div class=\"property-array\"><span>89-df-modalized-formula</span></div>"},{"key":"display","html":"df-modalized-formula — Modalized Formula"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"138d8c34e0370a6b\" href=\"?note=138d8c34e0370a6b\" title=\"89-df-modalized\">89-df-modalized</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"56c1b5b75a32ca1d\" href=\"?note=56c1b5b75a32ca1d\" title=\"89-df-modal-formula\">89-df-modal-formula</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"p\\in\\mathrm{Prop}\">\\(p\\in\\mathrm{Prop}\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Modalized}\\subseteq\\mathrm{Fml}_{\\Box}\\times\\mathrm{Prop}\">\\(\\mathrm{Modalized}\\subseteq\\mathrm{Fml}_{\\Box}\\times\\mathrm{Prop}\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"138d8c34e0370a6b\" href=\"?note=138d8c34e0370a6b\" title=\"89-df-modalized\">89-df-modalized</a>).</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}modalized\\text{-}formula}\\vdash\n\\mathcal{M}_{\\Box,p}\\coloneqq\n\\{A\\in\\mathrm{Fml}_{\\Box}\\mid\\mathrm{Modalized}(A,p)\\}.\"><div cla