wellfounded\\text{-}tree}\\vdash\n\\mathrm{WellfoundedTree}_S(T)\n\\leftrightarrow\n\\mathrm{ZfcTree8WellFoundedTree}_S(T).","display":true},{"tex":"\\omega","display":false}],"bytes":864,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3867","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-wellfounded-tree.md|58-df-zfc-wellfounded-tree]]（batch14）"}],"outgoing":["a3348ed9eb6fb4e3","89f48d4d04da27ae"]}