d p\\in\\mathbb P\\land\\forall r\\in\\mathbb Q\\;(r\\leq_{\\mathbb Q}q\\to\\mathrm{Compatible}_S(r,p,\\mathbb P,\\leq_{\\mathbb P}))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch08/58-df-compatible.md","status":"resolved","id":"2ad4b32e9e2eb12a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-compatible.md]]","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-poset.md]]","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Poset}:V^2\\to\\{\\top,\\bot\\}$ (poset predicate, see [[../batch02/58-df-poset.md]])","embed":false},{"target":"../batch08/58-df-compatible.md","status":"resolved","id":"2ad4b32e9e2eb12a","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Compatible}_S:V^4\\to\\{\\top,\\bot\\}$ (compatibility predicate, see [[../batch08/58-df-compatible.md]])","embed":false}],"math":[{"tex":"q,p,\\mathbb{P},\\mathbb{Q}\\in V","display":false},{"tex":"\\mathrm{Poset}:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Compatible}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcForcingReductionOfCondition}_S:V^4\\to\\{\\top,\\bot\\}