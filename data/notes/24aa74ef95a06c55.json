b72b070a","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Simple}$、$\\mathrm{HyperSimple}$ 分别见 [[68-df-simple-set]]、[[68-df-hypersimple-set]]。$W_{e,s}$ 的有限单调枚举见 [[68-df-finite-computation-approximation]]。"},{"id":"f850298d5e806601","anchor":"ref-42","locations":["正文"],"count":1,"excerpt":"[[68-df-hypersimple-set]]"},{"id":"be41c4d7dd143cb1","anchor":"ref-34","locations":["正文"],"count":1,"excerpt":"[[68-df-hypersimple-set]] — definition"},{"id":"3cb8c24064050ea6","anchor":"ref-81","locations":["正文"],"count":1,"excerpt":"[[68-df-hypersimple-set|df-hypersimple-set — Hypersimple Set]]"}],"outgoing":["a82d826d433dcff3","913d52943499d039"]}