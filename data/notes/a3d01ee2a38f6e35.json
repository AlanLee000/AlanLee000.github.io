\\in\\mathrm{lex}].","display":true},{"tex":"\\mathsf{NCFG}\\coloneqq\\{(V,\\Sigma,P,S):\\Sigma,V\\subseteq\\mathbb N\\land\n(V,\\Sigma,P,S)\\in\\mathsf{CFG}_{\\Sigma}\\}.","display":true},{"tex":"Y_P\\coloneqq\\{\\langle A\\rangle\\alpha:(A,\\alpha)\\in P\\},\\quad\n\\operatorname{CFGCode}(G)\\coloneqq\n\\operatorname{NumCode}(S)\\operatorname{NatListCode}(\\operatorname{Sort}(V))\n\\operatorname{NatListCode}(\\operatorname{Sort}(\\Sigma))\n\\operatorname{NumCode}(|P|)\n\\mathop{\\mathbin{\\frown}}_{j=0}^{|P|-1}\n\\operatorname{NatListCode}(\\operatorname{LexSort}(Y_P)(j))\n\\quad(G=(V,\\Sigma,P,S)\\in\\mathsf{NCFG}).","display":true}],"bytes":3195,"backlinks":[{"id":"38a6929b52694b0f","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"6af52783a9bce985","anchor":"ref-197","locations":["正文"],"count":1,"excerpt":"[[73-df-canonical-cfg-binary-code|自然数标号 CFG 的规范二进制代码]] （本轮新建）"},{"id":"f74fb6d7b9fd5e2e","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""}],"outgoing":["33052f37223a11c6","bc88ca69b33d5036","2c2693f4159269f6"]}