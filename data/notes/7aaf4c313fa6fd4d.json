69fde7fe37f\" title=\"17-df-diagram\">17-df-diagram</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"53255a372e5c1ee8\" href=\"?note=53255a372e5c1ee8\" title=\"17-df-model\">17-df-model</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"71ede582cb78a069\" href=\"?note=71ede582cb78a069\" title=\"17-df-elementary-substructure\">17-df-elementary-substructure</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"9f3187e8ff79e64e\" href=\"?note=9f3187e8ff79e64e\" title=\"17-df-isomorphism\">17-df-isomorphism</a></span></div>"},{"key":"label_origin","html":"local-catalog"},{"key":"source_section","html":"2.1"},{"key":"source_result","html":"Proposition 2.1.8; existential-map form (a′) iff (c′)"},{"key":"source_pages_print","html":"<div class=\"property-array\"><span>68</span><span>69</span></div>"},{"key":"source_pages_djvu","html":"<div class=\"property-array\"><span>84</span><span>85</span></div>"},{"key":"source_verification","html":"statement and diagram proof compared in supplied DjVu OCR; embedding expressed as an isomorphic substructure"},{"key":"source_verification_history","html":"<div class=\"property-array\"><span>not-compared-to-book-in-this-pass; local statement reviewed</span></div>"},{"key":"legacy_label","html":"17-thm-2.1.4"},{"key":"local_revision","html":"formal-interface repair from supplied text; inherited source_verification is not reverified"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p><span class=\"math-inline\" data-tex=\"L\\in\\mathrm{FirstOrderLanguages}\">\\(L\\in\\mathrm{FirstOrderLanguages}\\)</span>，<span class=\"math-inline\" data-tex=\"\\mathfrak A,\\mathfrak B\\in\\mathrm{Structure}(L)\">\\(\\mathfrak A,\\mathfrak B\\in\\mathrm{Structure}(L)\\)</span>。命名语言 <span class=\"math-inline\" data-tex=\"L(\\mathfrak A)\">\\(L(\\mathfrak A)\\)</span> 及名字函数按 <a class=\"wiki-link\" id=\"ref-7\" data-note=\"45c3869fde7fe37f\" href=\"?note=45c3869fde7fe37f\" title=\"17-df-diagram\">17-df-diagram</a>；该语言中的模型类按该语言实例化。</p>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{Diag}(\\mathfrak A)\">\\(\\operatorname{Diag}(\\mathfrak A)\\)</span> (diagram, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"45c3869fde7fe37f\" href=\"?note=45c3869fde7fe37f\" title=\"17-df-diagram\">17-df-diagram</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{Mod}\">\\(\\operatorname{Mod}\\)</span> (model-class operation, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"53255a372e5c1ee8\" href=\"?note=53255a372e5c1ee8\" title=\"17-df-model\">17-df-model</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\subseteq_L\">\\(\\subseteq_L\\)</span> (substructure relation, see <a class=\"wiki-link\" id=\"ref-10\" data-note=\"71ede582cb78a069\" href=\"?note=71ede582cb78a069\" title=\"17-df-elementary-substructure\">17-df-elementary-substructure</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\cong\">\\(\\cong\\)</span> (structure isomorphism, see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"9f3187e8ff79e64e\" href=\"?note=9f3187e8ff79e64e\" title=\"17-df-isomorphism\">17-df-isomorphism</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathfrak B^+\\!\\upharpoonright L\">\\(\\mathfrak B^+\\!\\upharpoonright L\\)</span> (<span class=\"math-inline\" data-tex=\"L\">\\(L\\)</span>-reduct of an <span class=\"math-inline\" data-tex=\"L(\\mathfrak A)\">\\(L(\\mathfrak A)\\)</span>-structure, see <a class=\"wiki-link\" id=\"ref-12\" data-note=\"f48c896e5c0651df\" href=\"?note=f48c896e5c0651df\" title=\"17-df-reduct\">17-df-reduct</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\Bigl[\n\\exists\\mathfrak B^+\\in\\operatorname{Mod}(\\operatorname{Diag}(\\mathfrak A))\\;\n(\\mathfrak B^+\\!\\upharpoonright L=\\mathfrak B)\n\\Bigr]\n\\leftrightarrow\n\\Bigl[\n\\exists\\mathfrak C\\in\\mathrm{Structure}(L)\\;\n(\\mathfrak C\\subseteq_L\\mathfrak B\\land\\mathfrak A\\cong\\mathfrak C)\n\\Bigr].\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\Bigl[\n\\exists\\mathfrak B^+\\in\\operatorname{Mod}(\\operatorname{Diag}(\\mathfrak A))\\;\n(\\mathfrak B^+\\!\\upharpoonright L=\\mathfrak B)\n\\Bigr]\n\\leftrightarrow\n\\Bigl[\n\\exists\\mathfrak C\\in\\mathrm{Structure}(L)\\;\n(\\mathfrak C\\subseteq_L\\mathfrak B\\land\\mathfrak A\\cong\\mathfrak C)\n\\Bigr].\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>原书 Proposition 2.1.8(a′)⇔(c′)，印刷 pp.68–69。若 <span class=\"math-inline\" data-tex=\"\\mathfrak B^+\\models\\operatorname{Diag}(\\mathfrak A)\">\\(\\mathfrak B^+\\models\\operatorname{Diag}(\\mathfrak A)\\)</span>，取 <span class=\"math-inline\" data-tex=\"f(a)=c_a^{\\mathfrak B^+}\">\\(f(a)=c_a^{\\mathfrak B^+}\\)</span>；不等式原子句的否定保证单射，原子及否定原子句共同保证函数、常元与关系的保持和反映，故像是与 <span class=\"math-inline\" data-tex=\"\\mathfrak A\">\\(\\mathfrak A\\)</span> 同构的子结构。反向以同构 <span class=\"math-inline\" data-tex=\"f\">\\(f\\)</span> 解释各个 <span class=\"math-inline\" data-tex=\"c_a\">\\(c_a\\)</span>，便满足全部图示句。两向证明已与所供 OCR 中原书证明核对。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"17-df-structure","status":"resolved","id":"fdac06af5a7f3bb5","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[17-df-structure]]","embed":false},{"target":"17-df-reduct","status":"resolved","id":"f48c896e5c0651df","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[17-df-reduct]]","embed":false},{"target":"17-df-diagram","status":"resolved","id":"45c3869fde7fe37f","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[17-df-diagram]]","embed":false},{"target":"17-df-model","status":"resolved","id":"53255a372e5c1ee8","anchor":"ref-4","targetAnch