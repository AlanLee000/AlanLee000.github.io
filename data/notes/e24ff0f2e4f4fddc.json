al A\\subseteq\\mathcal P(X)\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure7JoinOfSigmaAlgebras}_S\\subseteq V^4\">\\(\\mathrm{ZfcMeasure7JoinOfSigmaAlgebras}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{SigmaAlgebra}\\subseteq V^2\">\\(\\operatorname{SigmaAlgebra}\\subseteq V^2\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"../batch07/58-df-sigma-algebra.md\">../batch07/58-df-sigma-algebra.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure7\\text{-}join\\text{-}of\\text{-}sigma\\text{-}algebras}\\vdash\n\\mathrm{ZfcMeasure7JoinOfSigmaAlgebras}_S(X,I,\\vec{\\mathcal A},\\mathcal A)\\\\\n\\leftrightarrow{}&amp;\n\\mathrm{Function}(\\vec{\\mathcal A},I,\\mathcal P(\\mathcal P(X)))\n\\land\\forall i\\in I\\;\\operatorname{SigmaAlgebra}(\\vec{\\mathcal A}(i),X)\\\\\n&amp;{}\\land\\mathcal A=\n\\bigcap\\{\\mathcal B\\subseteq\\mathcal P(X)\\mid\n\\operatorname{SigmaAlgebra}(\\mathcal B,X)\n\\land\\forall i\\in I\\;(\\vec{\\mathcal A}(i)\\subseteq\\mathcal B)\\}.\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}measure7\\text{-}join\\text{-}of\\text{-}sigma\\text{-}algebras}\\vdash\n\\mathrm{ZfcMeasure7JoinOfSigmaAlgebras}_S(X,I,\\vec{\\mathcal A},\\mathcal A)\\\\\n\\leftrightarrow{}&amp;\n\\mathrm{Function}(\\vec{\\mathcal A},I,\\mathcal P(\\mathcal P(X)))\n\\land\\forall i\\in I\\;\\operatorname{SigmaAlgebra}(\\vec{\\mathcal A}(i),X)\\\\\n&amp;{}\\land\\mathcal A=\n\\bigcap\\{\\mathcal B\\subseteq\\mathcal P(X)\\mid\n\\operatorname{SigmaAlgebra}(\\mathcal B,X)\n\\land\\forall i\\in I\\;(\\vec{\\mathcal A}(i)\\subseteq\\mathcal B)\\}.\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC measure definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-sigma-algebra.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}\\subseteq V^3$ (see [[../batch16/58-df-function.md]])","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{SigmaAlgebra}\\subseteq V^2$ (see [[../batch07/58-df-sigma-algebra.md]])","embed":false}],"math":[{"tex":"X,I,\\vec{\\mathcal A},\\mathcal A\\in V","display":false},{"tex":"\\mathcal A\\subseteq\\mathcal P(X)","display":false},{"tex":"\\mathrm{ZfcMeasure7JoinOfSigmaAlgebras}_S\\subseteq V^4","display":false},{"tex":"\\mathrm{Function}\\subseteq V^3","display":false},{"tex":"\\operatorname{SigmaAlgebra}\\subseteq V^2","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}measure7\\text{-}join\\text{-}of\\text{-}sigma\\text{-}algebras}\\vdash\n\\mathrm{ZfcMeasure7JoinOfSigmaAlgebras}_S(X,I,\\vec{\\mathcal A},\\mathcal A)\\\\\n\\leftrightarrow{}&\n\\mathrm{Function}(\\vec{\\mathcal A},I,\\mathcal P(\\mathcal P(X)))\n\\land\\forall i\\in I\\;\\operatorname{SigmaAlgebra}(\\vec{\\mathcal A}(i),X)\\\\\n&{}\\land\\mathcal A=\n\\bigcap\\{\\mathcal B\\subseteq\\mathcal P(X)\\mid\n\\operatorname{SigmaAlgebra}(\\mathcal B,X)\n\\land\\forall i\\in I\\;(\\vec{\\mathcal A}(i)\\subseteq\\mathcal B)\\}.\n\\end{aligned}","display":true}],"bytes":1414,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2633","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-measure7-join-of-sigma-algebras.md|58-df-zfc-measure7-join-of-sigma-algebras]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","36d7463d215be751","a740bdad87b97ac6"]}