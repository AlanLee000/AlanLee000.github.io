学公式\">\\[\\mathrm{FinSatCode}_S\\coloneqq\n\\{g(\\varphi):\\varphi\\in\\mathrm{Sent}_S\\land\\exists\\mathfrak A\\in\\mathrm{Struct}_S\\;\n(\\bigl||\\mathfrak A|\\bigr|&lt;\\aleph_0\\land\\mathfrak A\\models\\varphi)\\}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{FinSatCode}_S\\in\\mathrm{RE}\\setminus\\mathrm{Rec}.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{FinSatCode}_S\\in\\mathrm{RE}\\setminus\\mathrm{Rec}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"57-df-decidable-theory","status":"resolved","id":"4107e891ce817208","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-decidable-theory]]","embed":false},{"target":"57-df-maxcon","status":"resolved","id":"e892c7a9bb01feb5","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-maxcon]]","embed":false},{"target":"57-df-satisfaction","status":"resolved","id":"03dc48eb29950767","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-satisfaction]]","embed":false},{"target":"57-df-first-order-language","status":"resolved","id":"140b30594fbd26d8","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-first-order-language]]","embed":false},{"target":"57-df-godel-numbering","status":"resolved","id":"373da07803c26744","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-godel-numbering]]","embed":false},{"target":"57-df-arith0","status":"resolved","id":"ffb90a5e7b76ea84","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[