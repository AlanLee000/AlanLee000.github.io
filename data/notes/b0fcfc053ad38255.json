{"id":"b0fcfc053ad38255","group":"57","path":"57/57-thm-trakhtenbrot.md","title":"Trakhtenbrot Theorem","display":"thm-trakhtenbrot — Trakhtenbrot Theorem","type":"theorem","metadata":{"type":"theorem","book":"Mathematical Logic","book_abbrev":"57","label":"57-thm-trakhtenbrot","aliases":["57-thm-trakhtenbrot"],"display":"thm-trakhtenbrot — Trakhtenbrot Theorem","depends_on":["[[57-df-decidable-theory]]","[[57-df-maxcon]]","[[57-df-satisfaction]]","[[57-df-first-order-language]]","[[57-df-godel-numbering]]","[[57-df-arith0]]","[[57-df-recursively-enumerable]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"theorem"},{"key":"book","html":"Mathematical Logic"},{"key":"book_abbrev","html":"57"},{"key":"label","html":"57-thm-trakhtenbrot"},{"key":"aliases","html":"<div class=\"property-array\"><span>57-thm-trakhtenbrot</span></div>"},{"key":"display","html":"thm-trakhtenbrot — Trakhtenbrot Theorem"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4107e891ce817208\" href=\"?note=4107e891ce817208\" title=\"57-df-decidable-theory\">57-df-decidable-theory</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"e892c7a9bb01feb5\" href=\"?note=e892c7a9bb01feb5\" title=\"57-df-maxcon\">57-df-maxcon</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"03dc48eb29950767\" href=\"?note=03dc48eb29950767\" title=\"57-df-satisfaction\">57-df-satisfaction</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"140b30594fbd26d8\" href=\"?note=140b30594fbd26d8\" title=\"57-df-first-order-language\">57-df-first-order-language</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"373da07803c26744\" href=\"?note=373da07803c26744\" title=\"57-df-godel-numbering\">57-df-godel-numbering</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"ffb90a5e7b76ea84\" href=\"?note=ffb90a5e7b76ea84\" title=\"57-df-arith0\">57-df-arith0</a></span><span><a class=\"