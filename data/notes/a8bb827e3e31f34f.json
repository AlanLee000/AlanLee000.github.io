 C)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure6\\text{-}product\\text{-}sigma\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure6ProductSigmaAlgebra}_S(X,\\mathcal A,Y,\\mathcal B,\\mathcal C)\\leftrightarrow \\mathrm{ZfcMeasure5ProductSigmaAlgebra}_S(X,\\mathcal A,Y,\\mathcal B,\\mathcal C)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}product\\text{-}sigma\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure11ProductSigmaAlgebra}_S(\\Pi,\\Sigma,\\mathcal T,X,Y)\\leftrightarrow \\mathrm{ZfcMeasure5ProductSigmaAlgebra}_S(X,\\Sigma,Y,\\mathcal T,\\Pi)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}product\\text{-}sigma\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure11ProductSigmaAlgebra}_S(\\Pi,\\Sigma,\\mathcal T,X,Y)\\leftrightarrow \\mathrm{ZfcMeasure5ProductSigmaAlgebra}_S(X,\\Sigma,Y,\\mathcal T,\\Pi)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n<li>The measure5, measure6, and measure11 product-sigma-algebra variants are merged here.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch09/58-df-measurable-space.md","status":"resolved","id":"7f96c502a4a99a46","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch09/58-df-measurable-space.md]]","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07