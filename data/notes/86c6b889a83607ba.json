\\mathrm{Normal}(f)","display":false},{"tex":"\\mathrm{Normal}","display":false},{"tex":"\\mathrm{Fix},\\mathrm{Enum},\\mathrm{IncEnum}","display":false},{"tex":"f'","display":false},{"tex":"\\operatorname{succ}","display":false},{"tex":"f'\\coloneqq\\mathrm{Enum}(\\mathrm{Fix}(f)).","display":true},{"tex":"\\operatorname{dom}(f')=\\mathrm{Ord}\\land\n\\operatorname{ran}(f')=\\mathrm{Fix}(f)\\land\n\\mathrm{IncEnum}(\\mathrm{Fix}(f),f')\\land\\mathrm{Normal}(f').","display":true},{"tex":"f'(0)=\\min\\mathrm{Fix}(f),\\qquad\nf'(\\operatorname{succ}(\\alpha))=\n\\min\\{\\eta\\in\\mathrm{Fix}(f):f'(\\alpha)<\\eta\\}\n\\qquad(\\alpha\\in\\mathrm{Ord}).","display":true},{"tex":"f'=\\mathrm{en}_{\\mathrm{Fix}(f)}","display":false},{"tex":"s=\\sup_{\\xi<\\lambda}f'(\\xi)","display":false},{"tex":"f'(\\lambda)=s","display":false}],"bytes":2588,"backlinks":[{"id":"e40f6292323bbb0b","anchor":"ref-76","locations":["正文"],"count":1,"excerpt":"[[./18-df-normal-derivative]]"},{"id":"100d7af02276fe1b","anchor":"ref-76","locations":["正文"],"count":1,"excerpt":"[[../18-df-normal-derivative]]"},{"id":"e29d1100705cdb23","anchor":"ref-62","locations":["正文"],"count":1,"excerpt":"[[../18-df-normal-derivative]]"},{"id":"bf01645e59119446","anchor":"ref-60","locations":["正文"],"count":1,"excerpt":"[[../18-df-normal-derivative|18-df-normal-derivative]]"}],"outgoing":["83adc13498d19c2f","779baa2ce0d8c0d8","0add8a5835559b4b","92f365ec0f2e26f3","dbde69396a089d39"]}