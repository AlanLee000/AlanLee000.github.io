{"id":"96a18ed0587053d4","group":"58","path":"58/batch19/58-df-zfc-comb6-complete-graph.md","title":"ZFC Comb6 Complete Graph","display":"df-zfc-comb6-complete-graph — ZFC Comb6 Complete Graph","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-comb6-complete-graph","aliases":["58-df-zfc-comb6-complete-graph"],"display":"df-zfc-comb6-complete-graph — ZFC Comb6 Complete Graph","depends_on":["[[58-ax-zfc]]","[[58-df-complete]]","[[58-df-graph]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-comb6-complete-graph"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-comb6-complete-graph</span></div>"},{"key":"display","html":"df-zfc-comb6-complete-graph — ZFC Comb6 Complete Graph"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"363d68f8b3734026\" href=\"?note=363d68f8b3734026\" title=\"58-df-complete\">58-df-complete</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"0dc79ccc1050ee64\" href=\"?note=0dc79ccc1050ee64\" title=\"58-df-graph\">58-df-graph</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,E\\in V\">\\(X,E\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcComb6CompleteGraph}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcComb6CompleteGraph}_S:V^2\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comb6\\text{-}complete\\text{-}graph} \\vdash \\mathrm{ZfcComb6CompleteGraph}_S(X,E)\\leftrightarrow E=[X]^2\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}comb6\\text{-}complete\\text{-}graph} \\vdash \\mathrm{ZfcComb6CompleteGraph}_S(X,E)\\leftrightarrow E=[X]^2\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Edges are exactly the two-element subsets of the vertex set, so the graph is simple, undirected, and complete.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-complete","status":"resolved","id":"363d68f8b3734026","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-complete]]","embed":false},{"target":"58-df-graph","status":"resolved","id":"0dc79ccc1050ee64","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-graph]]","embed":false}],"math":[{"tex":"X,E\\in V","display":false},{"tex":"\\mathrm{ZfcComb6CompleteGraph}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}comb6\\text{-}complete\\text{-}graph} \\vdash \\mathrm{ZfcComb6CompleteGraph}_S(X,E)\\leftrightarrow E=[X]^2","display":true}],"bytes":718,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1670","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-zfc-comb6-complete-graph.md|58-df-zfc-comb6-complete-graph]]（batch19）"}],"outgoing":["a3348ed9eb6fb4e3","363d68f8b3734026","0dc79ccc1050ee64"]}