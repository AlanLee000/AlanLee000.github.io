{"id":"9e539ea4589bb501","group":"58","path":"58/batch14/58-df-zfc-measure11-section-measurable-set.md","title":"ZFC Measure11 Section Measurable Set","display":"df-zfc-measure11-section-measurable-set — ZFC Measure11 Section Measurable Set","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-measure11-section-measurable-set","aliases":["58-df-zfc-measure11-section-measurable-set"],"display":"df-zfc-measure11-section-measurable-set — ZFC Measure11 Section Measurable Set","depends_on":["[[../batch07/58-df-sigma-algebra.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-measure11-section-measurable-set"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-measure11-section-measurable-set</span></div>"},{"key":"display","html":"df-zfc-measure11-section-measurable-set — ZFC Measure11 Section Measurable Set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"../batch07/58-df-sigma-algebra.md\">../batch07/58-df-sigma-algebra.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"S,A,x,X,Y,\\mathcal T\\in V\">\\(S,A,x,X,Y,\\mathcal T\\in V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{SigmaAlgebra}\">\\(\\operatorname{SigmaAlgebra}\\)</span> is the sigma-algebra predicate (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"../batch07/58-df-sigma-algebra.md\">../batch07/58-df-sigma-algebra.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure11SectionMeasurableSet}_S\\subseteq V^6\">\\(\\mathrm{ZfcMeasure11SectionMeasurableSet}_S\\subseteq V^6\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}section\\text{-}measurable\\text{-}set} \\vdash\n\\mathrm{ZfcMeasure11SectionMeasurableSet}_S(S,A,x,X,Y,\\mathcal T)\\leftrightarrow\n\\operatorname{SigmaAlgebra}(\\mathcal T,Y)\\land A\\subseteq X\\times Y\\land x\\in X\\land\nS=\\{y\\in Y:\\langle x,y\\rangle\\in A\\}\\land S\\in\\mathcal T\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}section\\text{-}measurable\\text{-}set} \\vdash\n\\mathrm{ZfcMeasure11SectionMeasurableSet}_S(S,A,x,X,Y,\\mathcal T)\\leftrightarrow\n\\operatorname{SigmaAlgebra}(\\mathcal T,Y)\\land A\\subseteq X\\times Y\\land x\\in X\\land\nS=\\{y\\in Y:\\langle x,y\\rangle\\in A\\}\\land S\\in\\mathcal T\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary measurable section definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-sigma-algebra.md]]","embed":false},{"target":"../batch07/58-df-sigma-algebra.md","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{SigmaAlgebra}$ is the sigma-algebra predicate (see [[../batch07/58-df-sigma-algebra.md]]).","embed":false}],"math":[{"tex":"S,A,x,X,Y,\\mathcal T\\in V","display":false},{"tex":"\\operatorname{SigmaAlgebra}","display":false},{"tex":"\\mathrm{ZfcMeasure11SectionMeasurableSet}_S\\subseteq V^6","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}section\\text{-}measurable\\text{-}set} \\vdash\n\\mathrm{ZfcMeasure11SectionMeasurableSet}_S(S,A,x,X,Y,\\mathcal T)\\leftrightarrow\n\\operatorname{SigmaAlgebra}(\\mathcal T,Y)\\land A\\subseteq X\\times Y\\land x\\in X\\land\nS=\\{y\\in Y:\\langle x,y\\rangle\\in A\\}\\land S\\in\\mathcal T","display":true}],"bytes":1010,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2566","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-measure11-section-measurable-set.md|58-df-zfc-measure11-section-measurable-set]]（batch14）"}],"outgoing":["a740bdad87b97ac6"]}