.md]]","embed":false},{"target":"../batch09/58-df-ring-homomorphism.md","status":"resolved","id":"28f002080d71355a","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{RingHom}_S\\subseteq V^{11}$ (ring-homomorphism predicate, see [[../batch09/58-df-ring-homomorphism.md]])","embed":false}],"math":[{"tex":"K,f,R,+_R,\\cdot_R,0_R,1_R,T,+_T,\\cdot_T,0_T,1_T\\in V","display":false},{"tex":"\\mathrm{ZfcAlgebra2KernelIdeal}_S\\subseteq V^{12}","display":false},{"tex":"\\mathrm{RingHom}_S\\subseteq V^{11}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}algebra2\\text{-}kernel\\text{-}ideal} \\vdash \\mathrm{ZfcAlgebra2KernelIdeal}_S(K,f,R,+_R,\\cdot_R,0_R,1_R,T,+_T,\\cdot_T,0_T,1_T)\\leftrightarrow \\mathrm{RingHom}_S(f,R,+_R,\\cdot_R,0_R,1_R,T,+_T,\\cdot_T,0_T,1_T)\\land K=\\{r\\in R:f(r)=0_T\\}\\land 0_R\\in K\\land\\forall r,r'\\in K\\;(\\exists z\\in K\\;(+_R(\\langle z,r'\\rangle)=r))\\land\\forall a\\in R\\;\\forall r\\in K\\;(a\\cdot_Rr\\in K\\land r\\cdot_Ra\\in K)","display":true}],"bytes":1112,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1422","locations":["正文"],"count":1,"excerpt":"[[../batch13/58-df-zfc-algebra2-kernel-ideal.md|58-df-zfc-algebra2-kernel-ideal]]（batch13）"}],"outgoing":["a3348ed9eb6fb4e3","28f002080d71355a"]}