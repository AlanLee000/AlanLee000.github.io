]\\;\\forall\\varphi\\in\\mathrm{Universal}[\\tau]\\cap\\mathrm{Sent}_\\tau\\quad(A\\subseteq_\\tau B\\land B\\models\\varphi\\to A\\models\\varphi).","display":true},{"tex":"A","display":false},{"tex":"B","display":false},{"tex":"B","display":false},{"tex":"A","display":false}],"bytes":1827,"backlinks":[{"id":"ecc0dd131d213345","anchor":"ref-216","locations":["正文"],"count":1,"excerpt":"[[../29-thm-preservation]]"}],"outgoing":["6c407bfcc6de5b0d","52acb2f008e0c3ff","711217f22972ffc0","3ee556c64b16809b","4de8e0c8085801f5"]}