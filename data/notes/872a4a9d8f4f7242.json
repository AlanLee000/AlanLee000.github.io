{\\mathsf{ML}}\\times\\mathsf{Prop}_{\\mathsf{ML}}\\times\\mathsf{Frm}_{\\mathsf{ML}}\n\\to\n\\mathsf{Frm}_{\\mathsf{ML}}.","display":true},{"tex":"A[p:=B]","display":false},{"tex":"q[p:=B]=\n\\begin{cases}\nB,&q=p,\\\\\n\\operatorname{var}(q),&q\\ne p,\n\\end{cases}","display":true},{"tex":"\\bot[p:=B]=\\bot,","display":true},{"tex":"(A\\land C)[p:=B]=A[p:=B]\\land C[p:=B],","display":true},{"tex":"(A\\lor C)[p:=B]=A[p:=B]\\lor C[p:=B],","display":true},{"tex":"(A\\to C)[p:=B]=A[p:=B]\\to C[p:=B].","display":true},{"tex":"0<|X|<\\omega","display":true},{"tex":"X","display":false},{"tex":"X","display":false},{"tex":"\\mathcal F_X^{\\mathrm{fin}}=(W_X,\\le_X),","display":true},{"tex":"W_X=\\mathcal P(X)\\setminus\\{\\varnothing\\},","display":true},{"tex":"U\\le_X V\\Longleftrightarrow U\\supseteq V.","display":true},{"tex":"W_X\\ne\\varnothing","display":false},{"tex":"\\le_X\\subseteq W_X\\times W_X","display":false},{"tex":"\\mathsf{Fr}_{\\mathsf{ML}}\n=\n\\{\\mathcal F_X^{\\mathrm{fin}}:0<|X|<\\omega\\}.","display":true},{"tex":"X","display":false},{"tex":"\\mathcal F_X^{\\mathrm{fin}}\\in\\mathsf{Fr}_{\\mathsf{ML}}","display":false},{"tex":"\\mathsf{Val}^{\\mathrm{fin}}_X\n=\n\\left\\{\nV:\\mathsf{Prop}_{\\mathsf{ML}}\\to\\mathcal P(W_X):\n\\forall p\\ \\forall U,V_0\\in W_X\\\n(U\\in V(p)\\land U\\le_X V_0\\Rightarrow V_0\\in V(p))\n\\right\\}.","display":true},{"tex":"V\\in\\mathsf{Val}^{\\mathrm{fin}}_X","display":false},{"tex":"V:\\mathsf{Prop}_{\\mathsf{ML}}\\to\\mathcal P(W_X)","display":true},{"tex":"U\\in V(p)\\land U\\le_X V_0\\Longrightarrow V_0\\in V(p).","display":true},{"tex":"\\mathsf{Mod}_{\\mathsf{ML}}\n=\n\\{(X,W_X,\\le_X,V):0<|X|<\\omega,\\ W_X=\\mathcal P(X)\\setminus\\{\\varnothing\\},\\ V\\in\\mathsf{Val}^{\\mathrm{fin}}_X\\}.","display":true},{"tex":"\\mathsf{EvalCtx}_{\\mathsf{ML}}\n=\n\\{(\\mathcal M,U):\\mathcal M=(X,W_X,\\le_X,V)\\in\\mathsf{Mod}_{\\mathsf{ML}},\\ U\\in W_X\\}.","display":true},{"tex":"\\mathcal M=(X,W_X,\\le_X,V)\\in\\