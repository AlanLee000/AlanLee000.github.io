te} \\vdash \\operatorname{Semisimple}(M,R)\\leftrightarrow\\exists +_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot\\in V\\;\\operatorname{SemisimpleStructure}_S(M,R,+_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot)","display":true},{"tex":"\\begin{aligned}\\mathrm{df\\text{-}semisimple\\text{-}decomposition}\\vdash{}&\\operatorname{SemisimpleDecomposition}_S(M,R,S)\\leftrightarrow\\exists I,+_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot\\in V\\;\\Bigl(\\mathrm{Module}_S(M,R,+_M,0_M,+_R,\\cdot_R,0_R,1_R,\\odot)\\\\&\\land\\mathrm{Function}(S,I,\\mathcal P(M))\\land\\forall i\\in I\\;\\mathrm{SimpleModule}_S(S(i),R,+_M\\!\\upharpoonright S(i)^2,0_M,+_R,\\cdot_R,0_R,1_R,\\odot\\!\\upharpoonright(R\\times S(i)))\\\\&\\land\\forall m\\in M\\;\\exists J\\subseteq I\\;\\exists c\\in M^J\\;\\Bigl(\\mathrm{Finite}(J)\\land\\forall j\\in J\\;(c(j)\\in S(j))\\land m=\\sum_{j\\in J}^{+_M}c(j)\\\\&\\qquad\\land\\forall J'\\subseteq I\\;\\forall c'\\in M^{J'}\\;\\bigl(\\mathrm{Finite}(J')\\land\\forall j\\in J'\\;(c'(j)\\in S(j))\\land m=\\sum_{j\\in J'}^{+_M}c'(j)\\to\\{\\langle j,c(j)\\rangle:j\\in J\\land c(j)\\neq0_M\\}=\\{\\langle j,c'(j)\\rangle:j\\in J'\\land c'(j)\\neq0_M\\}\\bigr)\\Bigr)\\Bigr).\\end{aligned}","display":true}],"bytes":3544,"backlinks":[{"id":"a11585cba9c21cfd","anchor":"ref-223","locations":["正文"],"count":1,"excerpt":"[[58-df-semisimple]]"},{"id":"84daad544872cc71","anchor":"ref-1135","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-semisimple.md|58-df-semisimple]]（batch03）"}],"outgoing":["ef3a5dd6825f0373","4deff85a84639467","e309a228bb19c798","36d7463d215be751","d9a25b0ac94a3598"]}