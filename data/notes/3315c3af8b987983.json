","display":false},{"tex":"\\tau_{\\mathbb C}^{\\mathrm{std}}\\coloneqq\n\\{U\\subseteq\\mathbb C:\\forall z\\in U\\;\\exists r\\in\\mathbb R_{>0}\\;\\forall w\\in\\mathbb C\\;\n(|w-z|<r\\to w\\in U)\\}.","display":true},{"tex":"\\mathrm{df\\text{-}riemann\\text{-}mapping\\text{-}subspace} \\vdash\n\\operatorname{SubspaceTopology}_S(\\tau_Y,Y,\\tau_{\\mathbb C})\n\\leftrightarrow Y\\subseteq\\mathbb C\\land\\tau_Y=\\{U\\cap Y:U\\in\\tau_{\\mathbb C}\\}.","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}riemann\\text{-}mapping\\text{-}map}\\vdash\n\\operatorname{RiemannMap}_S(f,\\Omega,\\tau_{\\mathbb C})\\leftrightarrow{}&\n\\exists\\tau_{\\mathbb D},\\tau_\\Omega\\in V\\;\\Bigl(\n\\operatorname{SubspaceTopology}_S(\\tau_{\\mathbb D},\\mathbb D,\\tau_{\\mathbb C})\\\\\n&\\land\\operatorname{SubspaceTopology}_S(\\tau_\\Omega,\\Omega,\\tau_{\\mathbb C})\n\\land\\mathrm{Open}_S(\\Omega,\\mathbb C,\\tau_{\\mathbb C})\\\\\n&\\land\\Omega\\neq\\varnothing\\land\\Omega\\neq\\mathbb C\n\\land\\mathrm{Connected}_S(\\Omega,\\tau_\\Omega)\\\\\n&\\land\\mathrm{SimplyConnected}_S(\\Omega,\\tau_\\Omega)\n\\land\\mathrm{Biholomorphism}_S(f,\\mathbb D,\\tau_{\\mathbb D},1,\\Omega,\\tau_\\Omega,1)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}riemann\\text{-}mapping\\text{-}automorphism}\\vdash\n\\operatorname{DiskAutomorphism}_S(\\alpha,\\tau_{\\mathbb C})\n\\leftrightarrow{}&\n\\exists\\tau_{\\mathbb D}\\in V\\;\\Bigl(\n\\operatorname{SubspaceTopology}_S(\\tau_{\\mathbb D},\\mathbb D,\\tau_{\\mathbb C})\\\\\n&\\land\\mathrm{Biholomorphism}_S(\\alpha,\\mathbb D,\\tau_{\\mathbb D},1,\\mathbb D,\\tau_{\\mathbb D},1)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}riemann\\text{-}mapping\\text{-}class} \\vdash \\operatorname{SameRiemannMapClass}_S(f,g,\\Omega,\\tau_{\\mathbb C})\\leftrightarrow\\operatorname{RiemannMap}_S(f,\\Omega,\\tau_{\\mathbb C})\\land\\operatorname{RiemannMap}_S(g,\\Omega,\\tau_{\\mathbb C})\\land\\exists\\alpha\\in V\\;(\\operatorname{DiskAutomorphism}_S(\\alpha,\\tau_{\\mathbb C})\\land g=f\\circ\\alpha)","display":true},{"tex":"\\mathrm{df\\text{-}riemann\\text{-}mapping\\text{-}theorem} \\vdash \\tau_{\\mathbb C}=\\tau_{\\mathbb C}^{\\mathrm{std}}\\land\n\\mathrm{Open}_S(\\Omega,\\mathbb C,\\tau_{\\mathbb C})\n\\land\\Omega\\neq\\varnothing\\land\\Omega\\neq\\mathbb C\n\\land\\exists\\tau_\\Omega\\in V\\;\\Bigl(\n\\operatorname{SubspaceTopology}_S(\\tau_\\Omega,\\Omega,\\tau_{\\mathbb C})\n\\land\\mathrm{Connected}_S(\\Omega,\\tau_\\Omega)\n\\land\\mathrm{SimplyConnected}_S(\\Omega,\\tau_\\Omega)\\Bigr)\n\\to\\exists f\\in V\\;\\operatorname{RiemannMap}_S(f,\\Omega,\\tau_{\\mathbb C}).","display":true},{"tex":"\\Omega=\\varnothing","display":false},{"tex":"\\Omega=\\mathbb C","display":false}],"bytes":4257,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1093","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-riemann-mapping.md|58-df-riemann-mapping]]（batch03）"}],"outgoing":["2d06636b21adf739","c664c247a9331632","71801f5b9407391a","78e4218bb3804257"]}