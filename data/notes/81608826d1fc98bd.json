tau)\\}","display":true}],"bytes":1569,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1355","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-universal-measurable.md|58-df-universal-measurable]]（batch07）"}],"outgoing":["bbddaeec1a020d3b","990e93a33f4633db","ca832ed6bc22f728","0578a357a86e9d8f"]}