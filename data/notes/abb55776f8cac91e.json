}_{\\widehat{\\mathcal C}}(A,m,!_A,\\chi_A,\\operatorname{true}).","display":true},{"tex":"p\\in A(C)","display":false},{"tex":"\\theta:P\\to\\Omega","display":false},{"tex":"u\\in\\theta_C(p)","display":false},{"tex":"\\operatorname{id}_D\\in\\theta_D(P(u)p)","display":false},{"tex":"P(u)p\\in A(D)","display":false},{"tex":"\\theta=\\chi_A","display":false}],"bytes":2409,"backlinks":[{"id":"c53146be63465990","anchor":"ref-51","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-topos-structure|thm-193 — 筛对象分类预层子对象]]"},{"id":"af8af33cef1d96d9","anchor":"ref-89","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-topos-structure]]"},{"id":"4741fef73eb1a614","anchor":"ref-246","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-topos-structure]]"},{"id":"ffda0c0482667c45","anchor":"ref-168","locations":["正文"],"count":2,"excerpt":"[[14-thm-presheaf-topos-structure]]"},{"id":"c60ad289d123497b","anchor":"ref-52","locations":["正文"],"count":1,"excerpt":"[[14-thm-presheaf-topos-structure|thm-193 — 筛对象分类预层子对象]]"}],"outgoing":["199dc3cf97e92fa1","a0c7f4bf5e51d4b5","4e6c05c92e3b9bf9","e1782799288dd0ec","93c6dd137bf8628e","a56025295f88eafd","fa971ebc9fa7af70","a15ef6697dd133a5"]}