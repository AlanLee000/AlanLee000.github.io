\\mathcal A\">\\(\\mathcal A\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-function]]","embed":false},{"target":"58-df-measure-space","status":"resolved","id":"83a15c7e9b3817dc","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-measure-space]]","embed":false},{"target":"58-df-sigma-algebra","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-sigma-algebra]]","embed":false},{"target":"58-df-measure-space","status":"resolved","id":"83a15c7e9b3817dc","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{MeasureSpace}_S:V^3\\to\\{\\top,\\bot\\}$ (see [[58-df-measure-space]])","embed":false},{"target":"58-df-sigma-algebra","status":"resolved","id":"a740bdad87b97ac6","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{SigmaAlgebra}:V^2\\to\\{\\top,\\bot\\}$ (see [[58-df-sigma-algebra]])","embed":false}],"math":[{"tex":"\\nu,\\mu,X,\\Sigma,\\mathcal A\\in V","display":false},{"tex":"\\operatorname{MeasureSpace}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\operatorname{SigmaAlgebra}:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcMeasure10RestrictionOfMeasure}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}measure10\\text{-}restriction\\text{-}of\\text{-}measure} \\vdash \\mathrm{ZfcMeasure10RestrictionOfMeasure}_S(\\nu,\\mu,X,\\Sigma,\\mathcal A)\\leftrightarrow \\operatorname{MeasureSpace}_S(X,\\Sigma,\\mu)\\land\\operatorname{SigmaAlgebra}(\\mathcal A,X)\\land\\mathca