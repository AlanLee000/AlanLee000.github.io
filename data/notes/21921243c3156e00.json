{"id":"21921243c3156e00","group":"72","path":"72/72-thm-resolution-soundness.md","title":"Soundness of resolution refutations","display":"thm-resolution-soundness — Soundness of resolution refutations","type":"theorem","metadata":{"type":"theorem","book":"Handbook of Proof Theory","book_abbrev":"72","label":"72-thm-resolution-soundness","aliases":["72-thm-resolution-soundness"],"display":"thm-resolution-soundness — Soundness of resolution refutations","depends_on":["[[72-df-clause-semantics]]","[[72-df-resolution-system]]","[[72-df-resolution-derivation]]"],"source_author":"Pavel Pudlák","source_edition":"Buss (ed.), Handbook of Proof Theory, Elsevier, 1998","source_location":"Local proof of the rule in Chapter VIII §8.3; printed p.598; PDF p.610","source_pdf":"C:\\Users\\lzy\\Documents\\BaiduSyncdisk\\calibre\\libgen.li\\[Studies in Logic and the Foundatio (2867)\\[Studies in Logic and the Found - libgen.li.pdf","verification_status":"local-proof-checked","source_statement_status":"book construction compared; explicit local formulation distinguished","source_proof_status":"Complete local rule and finite-derivation induction proof","eligible_as_verified_dependency":true,"revision_date":"2026-10-13","revision_2026_10_22":"将归结可靠性扩充到任意已导出子句"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"theorem"},{"key":"book","html":"Handbook of Proof Theory"},{"key":"book_abbrev","html":"72"},{"key":"label","html":"72-thm-resolution-soundness"},{"key":"aliases","html":"<div class=\"property-array\"><span>72-thm-resolution-soundness</span></div>"},{"key":"display","html":"thm-resolution-soundness — Soundness of resolution refutations"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a7ea013f9a55dcda\" href=\"?note=a7ea013f9a55dcda\" title=\"72-df-clause-semantics\">72-df-clause-semantics</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"e585861c4ee3b135\" href=\"?note=e585861c4ee3b135\" title=\"72-df-resolution-system\">72-df-resolution-system</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"57108f066c5d47ce\" href=\"?note=57108f066c5d47ce\" title=\"72-df-resolution-derivation\">72-df-resolution-derivation</a></span></div>"},{"key":"source_author","html":"Pavel Pudlák"},{"key":"source_edition","html":"Buss (ed.), Handbook of Proof Theory, Elsevier, 1998"},{"key":"source_location","html":"Local proof of the rule in Chapter VIII §8.3; printed p.598; PDF p.610"},{"key":"source_pdf","html":"C:\\Users\\lzy\\Documents\\BaiduSyncdisk\\calibre\\libgen.li[Studies in Logic and the Foundatio (2867)[Studies in Logic and the Found - libgen.li.pdf"},{"key":"verification_status","html":"local-proof-checked"},{"key":"source_statement_status","html":"book construction compared; explicit local formulation distinguished"},{"key":"source_proof_status","html":"Complete local rule and finite-derivation induction proof"},{"key":"eligible_as_verified_dependency","html":"true"},{"key":"revision_date","html":"2026-10-13"},{"key":"revision_2026_10_22","html":"将归结可靠性扩充到任意已导出子句"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"F,\\mathsf{Asn},\\operatorname{ResRefutation},\\operatorname{Res},\\overline l\">\\(F,\\mathsf{Asn},\\operatorname{ResRefutation},\\operatorname{Res},\\overline l\\)</span> 取 <a class=\"wiki-link\" id=\"ref-4\" data-note=\"e585861c4ee3b135\" href=\"?note=e585861c4ee3b135\" title=\"72-df-resolution-system\">72-df-resolution-system</a>，<span class=\"math-inline\" data-tex=\"\\models_{\\rm cl},\\models_{\\rm cnf},\\operatorname{Unsat}\">\\(\\models_{\\rm cl},\\models_{\\rm cnf},\\operatorname{Unsat}\\)</span> 取 <a class=\"wiki-link\" id=\"ref-5\" data-note=\"a7ea013f9a55dcda\" href=\"?note=a7ea013f9a55dcda\" title=\"72-df-clause-semantics\">72-df-clause-semantics</a>。</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"C_1,C_2\\in\\mathsf{Clause}\">\\(C_1,C_2\\in\\mathsf{Clause}\\)</span>，<span class=\"math-inline\" data-tex=\"l\\in C_1\">\\(l\\in C_1\\)</span>，<span class=\"math-inline\" data-tex=\"\\overline l\\in C_2\">\\(\\overline l\\in C_2\\)</span>，<span class=\"math-inline\" data-tex=\"a\\in\\mathsf{Asn}\">\\(a\\in\\mathsf{Asn}\\)</span>；<span class=\"math-inline\" data-tex=\"\\pi\">\\(\\pi\\)</span> 为有限子句序列。</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"C\\in\\mathsf{Clause}\">\\(C\\in\\mathsf{Clause}\\)</span>，<span class=\"math-inline\" data-tex=\"\\operatorname{ResDer}(\\pi,F,C)\">\\(\\operatorname{ResDer}(\\pi,F,C)\\)</span> 取 <a class=\"wiki-link\" id=\"ref-6\" data-note=\"57108f066c5d47ce\" href=\"?note=57108f066c5d47ce\" title=\"72-df-resolution-derivation\">72-df-resolution-derivation</a> 的任意末子句版本。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\bigl(a\\models_{\\rm cl}C_1\\land a\\models_{\\rm cl}C_2\\bigr)\n\\to a\\models_{\\rm cl}\\operatorname{Res}(C_1,C_2,l).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\bigl(a\\models_{\\rm cl}C_1\\land a\\models_{\\rm cl}C_2\\bigr)\n\\to a\\models_{\\rm cl}\\operatorname{Res}(C_1,C_2,l).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\operatorname{ResRefutation}(\\pi,F)\\to\\operatorname{Unsat}(F).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\operatorname{ResRefutation}(\\pi,F)\\to\\operatorname{Unsat}(F).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\operatorname{ResDer}(\\pi,F,C)\\land a\\models_{\\rm cnf}F\\ \\Longrightarrow\\ a\\models_{\\rm cl}C.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\operatorname{ResDer}(\\pi,F,C)\\land a\\models_{\\rm cnf}F\\ \\Longrightarrow\\ a\\models_{\\rm cl}C.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>这是第VIII章 §8.3 归结规则的完整本地可靠性证明，未宣称书中另外编号。</p>\n<p>若所有非主文字都假，则两个父子句为真分别要求 <span class=\"math-inline\" data-tex=\"l\">\\(l\\)</span> 和 <span class=\"math-inline\" data-tex=\"\\overline l\">\\(\\overline l\\)</span> 为真，矛盾。因此归结子句为真。若 <span class=\"math-inline\" data-tex=\"F\">\\(F\\)</span> 有满足赋值，把它扩展到全部命题变量；对反驳的行号归纳，初始行真，归结保持真，故最后空子句也真，与空子句语义矛盾。论证允许重言子句、重复父行及重复使用同一行，不使用未声明的削弱规则。</p>\n<p>新增结论由同一逐行归纳直接得到：不要求末子句为空，也不使用削弱。原反驳结论是C为空时的特例；消元和已导出前提组合因而有可直接复用的可靠性接口。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"72-df-clause-semantics","status":"resolved","id":"a7ea013f9a55dcda","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[72-df-clause-semantics]]","embed":false},{"target":"72-df-resolution-system","status":"resolved","id":"e585861c4ee3b135","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[72-df-resolution-system]]","embed":false},{"target":"72-df-resolution-derivation","status":"resolved","id":"57108f066c5d47ce","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[72-df-resolution-derivation]]","embed":false},{"target":"72-df-resolution-system","status":"resolved","id":"e585861c4ee3b135","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$F,\\mathsf{Asn},\\operatorname{ResRefutation},\\operatorname{Res},\\overline l$ 取 [[72-df-resolution-system]]，$\\models_{\\rm cl},\\models_{\\rm cnf},\\operatorname{Unsat}$ 取 [[72-df-clause-semantics]]。","embed":false},{"target":"72-df-clause-semantics","status":"resolved","id":"a7ea013f9a55dcda","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$F,\\mathsf{Asn},\\operatorname{ResRefutation},\\operatorname{Res},\\overline l$ 取 [[72-df-resolution-system]]，$\\models_{\\rm cl},\\models_{\\rm cnf},\\operatorname{Unsat}$ 取 [[72-df-clause-semantics]]。","embed":false},{"target":"72-df-resolution-derivation","status":"resolved","id":"57108f066c5d47ce","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$C\\in\\mathsf{Clause}$，$\\operatorname{ResDer}(\\pi,F,C)$ 取 [[72-df-resolution-derivation]] 的任意末子句版本。","embed":false}],"attachments":[],"math":[{"tex":"F,\\mathsf{Asn},\\operatorname{ResRefutation},\\operatorname{Res},\\overline l","display":false},{"tex":"\\models_{\\rm cl},\\models_{\\rm cnf},\\operatorname{Unsat}","display":false},{"tex":"C_1,C_2\\in\\mathsf{Clause}","display":false},{"tex":"l\\in C_1","display":false},{"tex":"\\overline l\\in C_2","display":false},{"tex":"a\\in\\mathsf{Asn}","display":false},{"tex":"\\pi","display":false},{"tex":"C\\in\\mathsf{Clause}","display":false},{"tex":"\\operatorname{ResDer}(\\pi,F,C)","display":false},{"tex":"\\bigl(a\\models_{\\rm cl}C_1\\land a\\models_{\\rm cl}C_2\\bigr)\n\\to a\\models_{\\rm cl}\\operatorname{Res}(C_1,C_2,l).","display":true},{"tex":"\\operatorname{ResRefutation}(\\pi,F)\\to\\operatorname{Unsat}(F).","display":true},{"tex":"\\operatorname{ResDer}(\\pi,F,C)\\land a\\models_{\\rm cnf}F\\ \\Longrightarrow\\ a\\models_{\\rm cl}C.","display":true},{"tex":"l","display":false},{"tex":"\\overline l","display":false},{"tex":"F","display":false}],"bytes":2604,"backlinks":[{"id":"4d85a6a31705a214","anchor":"ref-401","locations":["正文"],"count":1,"excerpt":"[[./72-thm-resolution-soundness|thm-resolution-soundness — Soundness of resolution refutations]]"},{"id":"1a1196fd5e373b39","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"7e87d64375127f0e","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$F,V,g,m,\\operatorname{Ext},\\operatorname{Def},\\operatorname{ERRefutation}$ 取 [[72-df-extended-resolu