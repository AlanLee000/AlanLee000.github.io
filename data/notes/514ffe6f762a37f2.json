\\Sigma^{c\\ell_n^2}};n^d,n^d,1/10\\right)\\right].","display":true},{"tex":"1^n","display":false},{"tex":"\\mathbf{FP}","display":false}],"bytes":2400,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-395","locations":["正文"],"count":1,"excerpt":"[[28-df-graph-power]]、[[28-df-graph-tensor-product]]、[[28-df-replacement-product]]、[[28-thm-tensor-product-expansion]]、[[28-thm-replacement-product-expansion]]、[[28-df-flat-source]]、[[28-lem-flat-source-convex-decomposition]]、[[28-df-branching-program]]、[[28-df-undirected-connectivity]]、[[28-thm-reingold]]、[[28-df-space-bounded-prg]]、[[28-thm-nisan-space-prg]]。"}],"outgoing":["c35eaa9794525bdd","adb92775ec020a0b","0dfeff4bd5d69b86"]}