-}energy\\text{-}value}\\vdash\\mathrm{DirichletEnergyValue}_S(r,u,\\Omega,n)\\leftrightarrow\\exists w,q\\in V\\;\\Bigl(\\mathrm{WeakGradient}_S(w,u,\\Omega,n)\\land\\mathrm{Function}(q,\\Omega,\\mathbb R_{\\geq0})\\land\\forall x\\in\\Omega\\;\\bigl(q(x)=\\sum_{i\\in n}w(i)(x)^2\\bigr)\\land\\mathrm{BochnerIntegral}_S(r,q,\\Omega,\\mathcal B_\\Omega,\\mu_\\Omega,\\mathbb R,\\mathcal B_{\\mathbb R},\\mathbb R,+_{\\mathbb R},\\cdot_{\\mathbb R},|\\cdot|)\\Bigr).","display":true},{"tex":"\\mathrm{df\\text{-}energy\\text{-}functional}\\vdash\\mathrm{EnergyFunctional}_S(J,\\Omega,n,H)\\leftrightarrow\\mathrm{SobolevSpace}_S(H,\\Omega,n,1,2)\\land\\mathrm{Function}(J,H,\\mathbb R_{\\geq0})\\land\\forall u\\in H\\;\\mathrm{DirichletEnergyValue}_S(J(u),u,\\Omega,n).","display":true},{"tex":"\\mathrm{df\\text{-}energy\\text{-}first\\text{-}variation}\\vdash\\mathrm{EnergyFirstVariation}_S(r,u,v,\\Omega,n)\\leftrightarrow\\exists w,z,q\\in V\\;\\Bigl(\\mathrm{WeakGradient}_S(w,u,\\Omega,n)\\land\\mathrm{WeakGradient}_S(z,v,\\Omega,n)\\land\\mathrm{Function}(q,\\Omega,\\mathbb R)\\land\\forall x\\in\\Omega\\;\\bigl(q(x)=2\\sum_{i\\in n}w(i)(x)z(i)(x)\\bigr)\\land\\mathrm{BochnerIntegral}_S(r,q,\\Omega,\\mathcal B_\\Omega,\\mu_\\Omega,\\mathbb R,\\mathcal B_{\\mathbb R},\\mathbb R,+_{\\mathbb R},\\cdot_{\\mathbb R},|\\cdot|)\\Bigr).","display":true},{"tex":"\\mathrm{df\\text{-}energy\\text{-}euler\\text{-}lagrange}\\vdash\\mathrm{EulerLagrange}_S(u,\\Omega,n,H)\\leftrightarrow\\mathrm{SobolevSpace}_S(H,\\Omega,n,1,2)\\land u\\in H\\land\\forall v\\in\\mathcal D(\\Omega)\\;\\mathrm{EnergyFirstVariation}_S(0,u,v,\\Omega,n).","display":true},{"tex":"F_\\epsilon(u) = \\int (|\\nabla u|^2/2 + V(u))","display":false}],"bytes":3639,"backlinks":[{"id":"b5c14b388ec6d30c","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e06256d3696011c6","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-481",