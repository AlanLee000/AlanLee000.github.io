x":"\\Box E","display":false},{"tex":"\\neg E","display":false},{"tex":"wRx","display":false},{"tex":"x\\not\\models E","display":false},{"tex":"\\{A,\\neg C\\}","display":false},{"tex":"A","display":false},{"tex":"C","display":false},{"tex":"A","display":false},{"tex":"C","display":false},{"tex":"\\{A\\}","display":false},{"tex":"\\{\\neg C\\}","display":false},{"tex":"w","display":false},{"tex":"A,\\neg C","display":false},{"tex":"A\\to C","display":false}],"bytes":2163,"backlinks":[{"id":"ae10ea6d3d0420ac","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e0c421a5b45aeb77","anchor":"ref-139","locations":["正文"],"count":2,"excerpt":"第三种存在证明：[[89-df-inseparable-pair]] → [[89-lem-inseparable-extension]] → [[89-lem-inseparable-box-witness]] → [[89-thm-craig-interpolation]] → [[89-thm-beth-definability]] → [[89-thm-fixed-point-beth]]。"}],"outgoing":["18a7d6d6f6148b37","28ea14cb0d1e7474","e46af049d0ea6278","9f00301866fbd6f0","0157f8bea9275cf1"]}