\ y\\in FV_T(t),\n\\end{cases}","display":true},{"tex":"z=\\operatorname{fresh}(FV(A)\\cup FV_T(t)\\cup\\{x,y\\})","display":false},{"tex":"\\equiv_\\alpha","display":false},{"tex":"E\\subseteq\\mathsf{Frm}_{\\mathbb H}^2","display":false},{"tex":"E","display":false},{"tex":"s=s'","display":false},{"tex":"t=t'","display":false},{"tex":"(s\\in t)E(s'\\in t')","display":false},{"tex":"s=s'","display":false},{"tex":"t=t'","display":false},{"tex":"(s\\doteq t)E(s'\\doteq t')","display":false},{"tex":"AE A'","display":false},{"tex":"BE B'","display":false},{"tex":"(A\\wedge B)E(A'\\wedge B')","display":false},{"tex":"(A\\vee B)E(A'\\vee B')","display":false},{"tex":"(A\\to B)E(A'\\to B')","display":false},{"tex":"\\bot E\\bot","display":false},{"tex":"AE A'","display":false},{"tex":"(\\forall x.A)E(\\forall x.A')","display":false},{"tex":"(\\exists x.A)E(\\exists x.A')","display":false},{"tex":"y\\notin FV(A)\\setminus\\{x\\}","display":false},{"tex":"(\\forall x.A,\\forall y.(A[\\operatorname{var}(y)/x]))\\in E,\n\\qquad\n(\\exists x.A,\\exists y.(A[\\operatorname{var}(y)/x]))\\in E.","display":true},{"tex":"\\rho:\\mathsf{Var}\\to\\mathsf{Name}_{\\mathbb H}","display":false},{"tex":"\\llbracket\\operatorname{var}(x)\\rrbracket_\\rho=\\rho(x),\n\\qquad\n\\llbracket\\operatorname{name}(\\tau)\\rrbracket_\\rho=\\tau.","display":true},{"tex":"\\rho[x:=a]","display":false},{"tex":"x","display":false},{"tex":"a","display":false},{"tex":"\\|-\\|_{\\mathbb H,\\rho}:\\mathsf{Frm}_{\\mathbb H}\\to H.","display":true},{"tex":"\\|s\\in t\\|_\\rho\n=\n\\bigvee_{\\mathbb H,\\sigma\\in dom(\\llbracket t\\rrbracket_\\rho)}\n\\left(\\llbracket t\\rrbracket_\\rho(\\sigma)\\wedge \\|\\operatorname{name}(\\sigma)\\doteq s\\|_\\rho\\right),","display":true},{"tex":"\\|s\\doteq t\\|_\\rho\n=\n\\left(\n\\bigwedge_{\\mathbb H,\\sigma\\in dom(\\llbracket s\\rrbracket_\\rho)}\n\\left(\\llbracket s\\rrbracket_\\rho(\\sigma)\\Rightarrow \\|\\operatorname{name}(\\sigma)\\in t\\|_\\rho\\right)\n\\r