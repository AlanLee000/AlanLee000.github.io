oldsymbol\\tau,P,\\tau_\\Pi\\bigr)\\land\\mathrm{Function}(\\pi_i,P,\\mathbf X(i))\\land\\forall x\\in P\\;(\\pi_i(x)=x(i))\\land\\mathrm{ZfcTop5ContinuousMap}_S\\bigl(P,\\tau_\\Pi,\\mathbf X(i),\\boldsymbol\\tau(i),\\pi_i\\bigr)\\Bigr)","display":true},{"tex":"\\pi_i(x)=x(i)","display":false}],"bytes":1823,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3690","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-zfc-topo11-product-projection-continuous.md|58-df-zfc-topo11-product-projection-continuous]]（batch17）"}],"outgoing":["a3348ed9eb6fb4e3","5260a5349d0b732f","682d2801cf83c784","36d7463d215be751"]}