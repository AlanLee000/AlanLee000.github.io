m{LpSpace}_S(L_q,q;X,\\Sigma,\\mu)\n\\land\\mathrm{LpSpace}_S(L_1,1;X,\\Sigma,\\mu)\\\\\n&\\quad\\land F\\in L_p\\land G\\in L_q\\\\\n&\\to F\\cdot G\\in L_1\n\\land\\lVert F\\cdot G\\rVert_{1;X,\\Sigma,\\mu}\n\\leq\n\\lVert F\\rVert_{p;X,\\Sigma,\\mu}\n\\lVert G\\rVert_{q;X,\\Sigma,\\mu}.\n\\end{aligned}","display":true}],"bytes":3365,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-63","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-cor-holder-inequality.md|58-cor-holder-inequality]]（batch01）"}],"outgoing":["a1d034d5d39b4a14","fa2f4519ad363e1d","83a15c7e9b3817dc"]}