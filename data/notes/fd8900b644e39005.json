{"id":"fd8900b644e39005","group":"58","path":"58/batch12/58-df-zfc-geology-grounds-family.md","title":"ZFC Geology Grounds Family","display":"df-zfc-geology-grounds-family — ZFC Geology Grounds Family","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-geology-grounds-family","aliases":["58-df-zfc-geology-grounds-family"],"display":"df-zfc-geology-grounds-family — ZFC Geology Grounds Family","depends_on":["[[58-ax-zfc]]","[[58-df-ground]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-geology-grounds-family"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-geology-grounds-family</span></div>"},{"key":"display","html":"df-zfc-geology-grounds-family — ZFC Geology Grounds Family"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"d0244462250ae67e\" href=\"?note=d0244462250ae67e\" title=\"58-df-ground\">58-df-ground</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"V\">\\(V\\)</span> (ambient universe)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal{G}\">\\(\\mathcal{G}\\)</span> (definable class predicate of grounds)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Class}\">\\(\\mathrm{Class}\\)</span> (metalinguistic class-quantifier domain)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{GroundModel}_S\">\\(\\mathrm{GroundModel}_S\\)</span> (ground relation, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"d0244462250ae67e\" href=\"?note=d0244462250ae67e\" title=\"58-df-ground\">58-df-ground</a>)</li>\n<li><span class=\"math-inline\" dat