9b8711cda3f31ca\" title=\"58-df-structure\">58-df-structure</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"bea77fab814b3292\" href=\"?note=bea77fab814b3292\" title=\"58-df-ordered-pair\">58-df-ordered-pair</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"S\">\\(S\\)</span> (ambient formal setting)</li>\n<li><span class=\"math-inline\" data-tex=\"D,\\mathcal M,\\Phi,\\varphi,s,L,\\operatorname{Val},\\operatorname{Sat}\\in V\">\\(D,\\mathcal M,\\Phi,\\varphi,s,L,\\operatorname{Val},\\operatorname{Sat}\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Struct}_S\">\\(\\mathrm{Struct}_S\\)</span> (structure predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"d9b8711cda3f31ca\" href=\"?note=d9b8711cda3f31ca\" title=\"58-df-structure\">58-df-structure</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Satisfaction}_S\">\\(\\mathrm{Satisfaction}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Diag}_{\\mathrm{el}}\">\\(\\mathrm{Diag}_{\\mathrm{el}}\\)</span> (set-coded satisfaction and elementary diagram, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a>, <a class=\"wiki-link\" id=\"ref-9\" data-note=\"2cf3f8687ad60744\" href=\"?note=2cf3f8687ad60744\" title=\"58-df-elementary-diagram\">58-df-elementary-diagram</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcModel10ElementaryDiagramFragment}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcModel10ElementaryDiagramFragment}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}model10\\text{-}elementary\\text{-}diagram\\text{-}fragment} \\vdash \\mathrm{ZfcModel10ElementaryDiagramFragment}_S(D,\\mathcal M,\\Phi)\\leftrightarrow \\exists L,\\operatorname{Val},\\operatorname{Sat}\\;\\Bigl(\\mathrm{Satisfaction}_S(\\mathcal M,L,\\operatorname{Val},\\operatorname{Sat})\\land\\Phi\\subseteq\\mathrm{Fml}_S(L)\\land D=\\{\\langle\\varphi,s\\rangle\\in\\mathrm{Diag}_{\\mathrm{el}}(\\mathcal M,L,\\operatorname{Val},\\operatorname{Sat})\\mid\\varphi\\in\\Phi\\}\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}model10\\text{-}elementary\\text{-}diagram\\text{-}fragment} \\vdash \\mathrm{ZfcModel10ElementaryDiagramFragment}_S(D,\\mathcal M,\\Phi)\\leftrightarrow \\exists L,\\operatorname{Val},\\operatorname{Sat}\\;\\Bigl(\\mathrm{Satisfaction}_S(\\mathcal M,L,\\operatorname{Val},\\operatorname{Sat})\\land\\Phi\\subseteq\\mathrm{Fml}_S(L)\\land D=\\{\\langle\\varphi,s\\rangle\\in\\mathrm{Diag}_{\\mathrm{el}}(\\mathcal M,L,\\operatorname{Val},\\operatorname{Sat})\\mid\\varphi\\in\\Phi\\}\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"D\">\\(D\\)</span> is the restriction of the canonical formula-assignment elementary diagram to the chosen formula fragment <span class=\"math-inline\" data-tex=\"\\Phi\">\\(\\Phi\\)</span>.</li>\n<li>The satisfaction recursion is an explicit witness; no malformed union of a language tuple with new constants and no uninterpreted constant symbols are introduced.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-elementary-diagram","status":"resolved","id":"2cf3f8687ad60744","anchor":"ref-2","targetAnchor":"