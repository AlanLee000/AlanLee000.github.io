\\Sigma_1),\\quad T_i\\coloneqq\\mathcal T(\\Sigma_i,V),\\quad T\\coloneqq\\mathcal T(\\Sigma,V),\\quad\\to_i\\coloneqq\\operatorname{Red}(\\Sigma_i,V,R_i),\\quad\\to\\coloneqq\\operatorname{Red}(\\Sigma,V,R_0\\cup R_1).","display":true},{"tex":"a\\coloneqq\\mathsf{or}(\\mathbf0,\\mathbf1),\\quad t_0\\coloneqq\\mathsf F(a,a,a),\\quad t_1\\coloneqq\\mathsf F(\\mathbf0,a,a),\\quad t_2\\coloneqq\\mathsf F(\\mathbf0,\\mathbf1,a).","display":true},{"tex":"\\mathrm{Terminating}(T_0,\\to_0)\\land\\mathrm{Terminating}(T_1,\\to_1).","display":true},{"tex":"t_0\\to t_1\\to t_2\\to t_0.","display":true},{"tex":"\\gamma:\\mathbb N\\to T,\\qquad\\gamma(n)\\coloneqq t_{n\\bmod3},\\qquad\\forall n\\in\\mathbb N\\;(\\gamma(n)\\to\\gamma(n+1)).","display":true},{"tex":"\\neg\\mathrm{Terminating}(T,\\to).","display":true}],"bytes":2851,"backlinks":[{"id":"fb7f59b6fc58cf0a","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"沿用 [[56-ex-disjoint-union-not-terminating]] 中互异的 $x,y$、$\\Sigma,V,T,R_0,R_1,a,t_0,t_1,t_2,\\gamma$ 和 $\\to$，令 $R=R_0\\cup R_1$。$\\operatorname{Step}_R$、$\\mathcal E_R$ 及其位置、子项、替换接口采用 [[56-df-redex-occurrence]]。$S=\\operatorname{Sub}(\\Sigma,V)$；$\\varepsilon=()$ 是空位置序列，$(1)$、$(2)$ 分别是长度为一的位置序列。"},{"id":"7a89e84aacc9537c","anchor":"ref-344","locations":["正文"],"count":2,"excerpt":"[[56-ex-disjoint-union-not-terminating.md]]"}],"outgoing":["73130ab4ebcdfb39","a0c9e286170288bf","fb7f59b6fc58cf0a"]}