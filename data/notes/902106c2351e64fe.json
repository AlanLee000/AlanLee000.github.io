6","anchor":"ref-11","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Generic}(G,P,\\leq_P,M)$ ($P$-generic filter, see [[../batch16/58-df-generic.md]])","embed":false},{"target":"58-df-generic-extension","status":"resolved","id":"76dde059f166d3e6","anchor":"ref-12","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{GenericExtensionTheory}_S(N,M,\\Gamma_{\\mathrm{GCH}},P,G)$ (generic extension, see [[58-df-generic-extension]])","embed":false}],"math":[{"tex":"\\mathrm{CTM}_S(M,\\Gamma)","display":false},{"tex":"\\Gamma_{\\mathrm{GCH}}=\\mathrm{ZFC}\\cup\\{\\chi_{\\mathrm{GCH}}\\}","display":false},{"tex":"\\Gamma_{\\neg\\mathrm{CH},\\aleph_2}=\\mathrm{ZFC}\\cup\\{\\neg\\chi_{\\mathrm{CH}},\\chi_{2^{\\aleph_0}=\\aleph_2}\\}","display":false},{"tex":"\\kappa=\\omega_2^M","display":false},{"tex":"M","display":false},{"tex":"\\mathrm{Cohen}_S(P,\\leq_P,\\kappa)","display":false},{"tex":"P=\\operatorname{Add}(\\omega,\\kappa)^M","display":false},{"tex":"\\mathrm{Generic}(G,P,\\leq_P,M)","display":false},{"tex":"P","display":false},{"tex":"\\mathrm{GenericExtensionTheory}_S(N,M,\\Gamma_{\\mathrm{GCH}},P,G)","display":false},{"tex":"\\mathrm{thm\\text{-}cohen\\text{-}forcing\\text{-}CH}\\vdash\n\\forall M,P,\\leq_P,G,\\kappa,N\\;\n\\Bigl(\n\\mathrm{ZFC}\\subseteq\\Gamma_{\\mathrm{GCH}}\\land\n\\mathrm{ZFC}\\subseteq\\Gamma_{\\neg\\mathrm{CH},\\aleph_2}\\land\n\\mathrm{CTM}_S(M,\\Gamma_{\\mathrm{GCH}})\\land\n\\kappa=\\omega_2^M\\land\n\\mathrm{Cohen}_S(P,\\leq_P,\\kappa)\\land\n\\mathrm{Generic}(G,P,\\leq_P,M)\\land\n\\mathrm{GenericExtensionTheory}_S(N,M,\\Gamma_{\\mathrm{GCH}},P,G)\n\\Bigr)\n\\to\n\\mathrm{CTM}_S(N,\\Gamma_{\\neg\\mathrm{CH},\\aleph_2})","display":true},{"tex":"P=\\operatorname{Add}(\\omega,\\omega_2)^M","display":false},{"tex":"(\\omega_2^{\\aleph_0})^M=\\omega_2^M","display":false},{"tex":"\\operatorname{Add}(\\omega,\\kappa)","display":false},{"tex":"\\kappa\\leq2^{\\aleph_0}","display":false