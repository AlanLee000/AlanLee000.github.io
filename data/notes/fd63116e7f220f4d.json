rm{ar}}:=\n\\mathrm{AtFml}_{\\mathcal L_{\\mathrm{ar}}}\n\\cup\\{\\neg B\\mid B\\in\\mathrm{AtFml}_{\\mathcal L_{\\mathrm{ar}}}\\}.","display":true},{"tex":"\\mathcal P_{X,n}:=\n\\bigcap\\left\\{\\mathcal C\\subseteq\\mathrm{Fml}(\\mathcal L_{\\mathrm{ar}}\\cup\\{X\\})\\ \\middle|\\\n\\begin{aligned}\n&\\mathsf{Lit}_{\\mathrm{ar}}\\cup\\{X(\\vec t)\\mid\\vec t\\in\\mathrm{Term}_{\\mathcal L_{\\mathrm{ar}}}^n\\}\\subseteq\\mathcal C\\\\\n&\\land\\ \\forall B,C\\in\\mathcal C\\,\n((B\\land C)\\in\\mathcal C\\land(B\\lor C)\\in\\mathcal C)\\\\\n&\\land\\ \\forall B\\in\\mathcal C\\,\\forall y\\in\\mathrm{Var}_{\\mathcal L_{\\mathrm{ar}}}\\,\n((\\forall y\\,B)\\in\\mathcal C\\land(\\exists y\\,B)\\in\\mathcal C)\n\\end{aligned}\n\\right\\}.","display":true},{"tex":"\\begin{aligned}\nA[G/X]&\\coloneqq\\mathrm{PSub}_{X,\\vec x,G}(A),\\\\\n\\mathrm{Cl}_{n,A}(G)&:=\\forall\\vec x\\,(A[G/X]\\to G),\\\\\n\\mathrm{ID1Axioms}_{\\mathcal L}(n,A,P_A)&:=\n\\{\\mathrm{Cl}_{n,A}(P_A(\\vec x))\\}\\\\\n&\\quad\\cup\\left\\{\n\\forall^*\\bigl(\\mathrm{Cl}_{n,A}(G)\\to\n\\forall\\vec x\\,(P_A(\\vec x)\\to G)\\bigr)\n\\ \\middle|\\ G\\in\\mathrm{Fml}(\\mathcal L\\cup\\{P_A\\})\n\\right\\}.\n\\end{aligned}","display":true},{"tex":"^1_1","display":false},{"tex":"^2_1","display":false},{"tex":"\\mathcal P_{X,n}","display":false},{"tex":"X","display":false},{"tex":"n","display":false},{"tex":"\\varphi","display":false},{"tex":"P_A","display":false},{"tex":"G","display":false},{"tex":"A","display":false}],"bytes":3968,"backlinks":[{"id":"ee9a93363bcae359","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\mathcal P_{X^{(n)},n}$、$\\mathrm{ID1Axioms}_{\\mathcal L}(n,A,P_A)$、$\\forall^*$ 按 [[18-df-inductive-definition-axioms]]。"},{"id":"e40f6292323bbb0b","anchor":"ref-121","locations":["正文"],"count":1,"excerpt":"[[./18-df-inductive-definition-axioms]]"},{"id":"e29d1100705cdb23","anchor":"ref-45","locations":["正文"],"count":1,"excerpt":"[[../18-df-inductive-definition-axioms]]"},{"id":"bf01645e59119446","anchor":"ref-42","locations":["正文"],"count":1,"excerpt":"[[../18-df-inductive-definition-axioms|18-df-inductive-definition-axioms]]"},{"id":"09f8f6fb03023072","anchor":"ref-24","locations":["正文"],"count":1,"excerpt":"[[../18-df-inductive-definition-axioms|18-df-inductive-definition-axioms]]"}],"outgoing":["2718a8a11c383b33","0c5e56070c342728","0dfe9d10a9cb0e4f","d6572d061e706d93"]}