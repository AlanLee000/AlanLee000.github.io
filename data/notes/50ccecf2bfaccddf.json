\}","display":false},{"tex":"\\mathrm{LevyMeasure}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{thm\\text{-}levy\\text{-}ito\\text{-}decomposition}\\vdash\n\\mathrm{LevyProcess}_S(X,\\Omega,\\mathcal F,\\mathbb P,1)\\\\\n&\\quad\\to\n\\exists b\\in\\mathbb R\\;\\exists\\sigma\\in[0,\\infty)\\;\n\\exists\\nu,B,N,\\widetilde N\\in V\\;\n\\Bigl(\n\\mathrm{LevyMeasure}_S(\\nu,1)\n\\land\\mathrm{Brownian}_S(B,\\Omega,\\mathcal F,\\mathbb P)\n\\land\n\\operatorname{PoissonRandomMeasure}_S\n(N,ds\\otimes\\nu,\\Omega,\\mathcal F,\\mathbb P,E,\\mathcal E)\\\\\n&\\qquad\\land\n\\widetilde N=N-ds\\otimes\\nu\\\\\n&\\qquad\\land\n\\forall t\\geq0\\;\n\\Bigl(\nX_t=bt+\\sigma B_t\n+\\int_{(0,t]\\times\\{0<|x|<1\\}}x\\,\\widetilde N(ds,dx)\n+\\int_{(0,t]\\times\\{|x|\\geq1\\}}x\\,N(ds,dx)\n\\Bigr)\n\\Bigr).\n\\end{aligned}","display":true}],"bytes":1983,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4285","locations":["正文"],"count":1,"excerpt":"[[../batch08/58-thm-levy-itodecomposition.md|58-thm-levy-itodecomposition]]（batch08）"}],"outgoing":["d0a20d5f74408674","8fc074624288fbbb","8a6696125be20e0d","e36ff0da02f94e7a"]}