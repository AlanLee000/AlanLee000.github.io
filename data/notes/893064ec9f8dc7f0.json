e},{"tex":"\\varphi_{P}(x_1, \\ldots, x_k, y) = (y = x_i)","display":false},{"tex":"G","display":false},{"tex":"\\mathrm{Rep}_G","display":false},{"tex":"Q\\subseteq\\mathrm{Th}(G)","display":false},{"tex":"Q","display":false},{"tex":"G","display":false},{"tex":"Q\\subseteq\\mathrm{Ax}(G)","display":false},{"tex":"G","display":false}],"bytes":3665,"backlinks":[{"id":"823a52c75bbad9bd","anchor":"ref-293","locations":["正文"],"count":1,"excerpt":"[[92-thm-pr-representable-detailed]]"}],"outgoing":["8bff810dd710385a","d9d845f6cd765d21","69750ae210519a25","fadfd5a594e57bef","a599a2f4a391801b","20fe67463d98fb92","468d35690d25ee42","7d55d92fc12a07fc","cc110e19a2eae4ea","e0eabee5d77258a7","d03aab2a94232c0e","0b2170bf5b3075ce","975b3aa9a1e08797","be5eece035332f0c","0a1ba58f66cc8d4e"]}