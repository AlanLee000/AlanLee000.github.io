uad\nA=B.","display":true},{"tex":"\\widehat\\sigma","display":false},{"tex":"T_{\\mathsf{Luk}},I_{\\mathsf{Luk}},M_{\\mathsf{Luk}},J_{\\mathsf{Luk}}:\nV_{\\mathsf{Luk}}^2\\to V_{\\mathsf{Luk}},\n\\qquad\nN_{\\mathsf{Luk}}:V_{\\mathsf{Luk}}\\to V_{\\mathsf{Luk}}.","display":true},{"tex":"T_{\\mathsf{Luk}}(a,b)=\\max(0,a+b-1),","display":true},{"tex":"I_{\\mathsf{Luk}}(a,b)=\\min(1,1-a+b),","display":true},{"tex":"M_{\\mathsf{Luk}}(a,b)=\\min(a,b),\n\\quad\nJ_{\\mathsf{Luk}}(a,b)=\\max(a,b).","display":true},{"tex":"N_{\\mathsf{Luk}}(a)=I_{\\mathsf{Luk}}(a,0)=1-a.","display":true},{"tex":"\\min(1,1-a+b)","display":false},{"tex":"\\mathsf{Val}_{\\mathsf{Luk}}\n=V_{\\mathsf{Luk}}^{\\mathsf{Prop}}.","display":true},{"tex":"v\\in\\mathsf{Val}_{\\mathsf{Luk}}","display":false},{"tex":"\\llbracket\\operatorname{atom}(p)\\rrbracket_v^{\\mathsf{Luk}}=v(p),\n\\quad\n\\llbracket\\operatorname{bot}\\rrbracket_v^{\\mathsf{Luk}}=0,","display":true},{"tex":"\\llbracket\\operatorname{fus}(A,B)\\rrbracket_v^{\\mathsf{Luk}}\n=T_{\\mathsf{Luk}}(\\llbracket A\\rrbracket_v^{\\mathsf{Luk}},\\llbracket B\\rrbracket_v^{\\mathsf{Luk}}),","display":true},{"tex":"\\llbracket\\operatorname{imp}(A,B)\\rrbracket_v^{\\mathsf{Luk}}\n=I_{\\mathsf{Luk}}(\\llbracket A\\rrbracket_v^{\\mathsf{Luk}},\\llbracket B\\rrbracket_v^{\\mathsf{Luk}}),","display":true},{"tex":"\\llbracket\\operatorname{meet}(A,B)\\rrbracket_v^{\\mathsf{Luk}}\n=M_{\\mathsf{Luk}}(\\llbracket A\\rrbracket_v^{\\mathsf{Luk}},\\llbracket B\\rrbracket_v^{\\mathsf{Luk}}),","display":true},{"tex":"\\llbracket\\operatorname{join}(A,B)\\rrbracket_v^{\\mathsf{Luk}}\n=J_{\\mathsf{Luk}}(\\llbracket A\\rrbracket_v^{\\mathsf{Luk}},\\llbracket B\\rrbracket_v^{\\mathsf{Luk}}).","display":true},{"tex":"\\mathsf{Valid}_{\\mathsf{Luk}}\n=\n\\{A\\in\\mathsf{Fm}_{\\mathsf{Luk}}:\n\\forall v:\\mathsf{Prop}\\to[0,1]\\,\n\\llbracket A\\rrbracket_v^{\\mathsf{Luk}}=1\\}.","display":true},{"tex":"\\models_{\\mathsf{Luk}}\n\\ \\subseteq\\\n\\mathcal P(\\math