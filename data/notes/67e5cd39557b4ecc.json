\mathcal P(A)\\bigr)\n\\land\nJ=\n\\left\\{\nX\\subseteq A:\nX=\\varnothing\\lor\\forall\\theta\\in\\operatorname{pcf}(X)\\;(\\theta<\\lambda)\n\\right\\}.\n\\end{aligned}","display":true},{"tex":"\\lambda","display":false},{"tex":"\\operatorname{pcf}(X)","display":false},{"tex":"J_{<\\lambda}[A]","display":false},{"tex":"X","display":false},{"tex":"\\lambda","display":false}],"bytes":1656,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3047","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-zfc-pcf2-ideal-generated-by-bounds.md|58-df-zfc-pcf2-ideal-generated-by-bounds]]（batch15）"}],"outgoing":["a3348ed9eb6fb4e3","6e4f95381faac4f9","b82cea6742372d50","0fbfc19800246e77"]}