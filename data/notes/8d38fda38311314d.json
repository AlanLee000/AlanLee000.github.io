=\"equation\" data-tex=\"\\mathrm{ImplDef}(P,T)\\to\\mathrm{ExplDef}(P,T).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{ImplDef}(P,T)\\to\\mathrm{ExplDef}(P,T).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{ExplDef}(P,T)\\leftrightarrow\\exists\\psi\\in\\mathrm{Fml}_{S_0}\\;[\\mathrm{free}(\\psi)\\subseteq\\{x_1,\\ldots,x_n\\}\\land T\\models\\mathrm{All}(\\vec x,P(\\vec x)\\leftrightarrow\\psi)].\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{ExplDef}(P,T)\\leftrightarrow\\exists\\psi\\in\\mathrm{Fml}_{S_0}\\;[\\mathrm{free}(\\psi)\\subseteq\\{x_1,\\ldots,x_n\\}\\land T\\models\\mathrm{All}(\\vec x,P(\\vec x)\\leftrightarrow\\psi)].\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"57-df-satisfaction","status":"resolved","id":"03dc48eb29950767","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-satisfaction]]","embed":false},{"target":"57-df-theory","status":"resolved","id":"9c053a73bd2d84c4","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-theory]]","embed":false},{"target":"57-df-symbol-alphabet","status":"resolved","id":"d43696a63788f3df","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-symbol-alphabet]]","embed":false},{"target":"57-df-reduct","status":"resolved","id":"6a64ba5f871237a2","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-reduct]]","embed":false},{"target":"57-df-implicit-definability","status":"resolved","id":"d5b4cac238c10c75","anchor":"ref-5","targetAnchor":"","location":"