ans}(\\mathsf{PRA},\\mathsf{PRA},\\lambda,\\mathsf{PA},\\kappa,q)\\land\\operatorname{HBL}(\\mathsf{PRA},\\lambda).","display":true},{"tex":"\\kappa\\in\\operatorname{GN}_{\\mathsf{PRA}}(\\mathsf{PA},e_\\varepsilon)\\land\\operatorname{Trans}(\\mathsf{PRA},\\mathsf{PRA},\\lambda,\\mathsf{PA},\\kappa,q)\\ \\Longrightarrow\\ U\\vdash_2^{(1)}\\operatorname{Con}_\\lambda(\\mathsf{PRA}).","display":true},{"tex":"\\operatorname{HBL}(\\mathsf{PRA},\\lambda)\\land\\operatorname{Con}_{\\rm meta}^{(1)}(\\mathsf{PRA})\\ \\Longrightarrow\\ \\mathsf{PRA}\\nvdash_2^{(1)}\\operatorname{Con}_\\lambda(\\mathsf{PRA}).","display":true},{"tex":"\\varepsilon_0","display":false}],"bytes":3172,"backlinks":[{"id":"4d85a6a31705a214","anchor":"ref-316","locations":["正文"],"count":1,"excerpt":"[[./72-thm-gentzen-consistency-pra|thm-gentzen-consistency-pra — Gentzen Consistency of PRA]]"}],"outgoing":["0869da29c285cc44","4f2af689634edc66","b61898f862c734c8","6d0ec6804191d5a4","21edd49e38c96ce7","4c14656043bc77c1","1c3ecb3059f70f57"]}