sfaction}_S\n(\\mathcal B,L,\\operatorname{Val}_{\\mathcal B},\\operatorname{Sat}_{\\mathcal B})\\\\\n&{}\\land\\forall\\varphi\\in\\Phi\\;\\forall s\\;\n\\Bigl(\\mathrm{Assign}(\\mathcal A,s)\\to\n\\bigl(\\mathrm{Assign}(\\mathcal B,s)\\land\\bigl(\n\\operatorname{Sat}_{\\mathcal A}(\\varphi,s)\n\\leftrightarrow\n\\operatorname{Sat}_{\\mathcal B}(\\varphi,s)\n\\bigr)\\bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"V","display":false}],"bytes":2259,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1058","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-reflection.md|58-df-reflection]]（batch10）"}],"outgoing":["65418b505fc53093","8b6a90316aad78a4","563f382027630287","d9a25b0ac94a3598"]}