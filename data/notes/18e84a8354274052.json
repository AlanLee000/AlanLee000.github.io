)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Bij}_{93}\">\\(\\mathrm{Bij}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{PrimeFil}_{93}\">\\(\\mathrm{PrimeFil}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Top}_{93}\">\\(\\mathrm{Top}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{StoneSpace}_{93}\">\\(\\mathrm{StoneSpace}_{93}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{Clopen}_{93}\">\\(\\mathrm{Clopen}_{93}\\)</span> have their source signatures.</li>\n<li><span class=\"math-inline\" data-tex=\"X_{\\mathbf L}\">\\(X_{\\mathbf L}\\)</span>, <span class=\"math-inline\" data-tex=\"\\preceq_{\\mathbf L}\">\\(\\preceq_{\\mathbf L}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathcal T_{\\mathbf L}\">\\(\\mathcal T_{\\mathbf L}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Up}_{93}\">\\(\\mathrm{Up}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{PrSpace}_{93}\">\\(\\mathrm{PrSpace}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\operatorname{ClopUp}_{93}\">\\(\\operatorname{ClopUp}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\operatorname{ClopUpMeet}_{93}\">\\(\\operatorname{ClopUpMeet}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\operatorname{ClopUpJoin}_{93}\">\\(\\operatorname{ClopUpJoin}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ClopUpAlg}_{93}\">\\(\\mathrm{ClopUpAlg}_{93}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{BDLIso}_{93}\">\\(\\mathrm{BDLIso}_{93}\\)</span>, and the graph <span class=\"math-inline\" data-tex=\"\\eta_{\\mathbf L}\">\\(\\eta_{\\mathbf L}\\)</span> are defined here.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\nX_{\\mathbf L}\\coloneqq\\{F\\subseteq|\\mathbf L|:\\mathrm{PrimeFil}_{93}(F,\\mathbf L)\\},\n\\qquad\n\\preceq_{\\mathbf L}\\;\\coloneqq\n\\{\\langle F,G\\rangle\\in X_{\\mathbf L}^2:F\\subseteq G\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\nX_{\\mathbf L}\\coloneqq\\{F\\subseteq|\\mathbf L|:\\mathrm{PrimeFil}_{93}(F,\\mathbf L)\\},\n\\qquad\n\\preceq_{\\mathbf L}\\;\\coloneqq\n\\{\\langle F,G\\rangle\\in X_{\\mathbf L}^2:F\\subseteq G\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\nF\\preceq_{\\mathbf L}G\\leftrightarrow\n\\langle F,G\\rangle\\in\\preceq_{\\mathbf L}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\nF\\preceq_{\\mathbf L}G\\leftrightarrow\n\\langle F,G\\rangle\\in\\preceq_{\\mathbf L}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\widehat a^{\\mathbf L}\\coloneqq\\{F\\in X_{\\mathbf L}:a\\in F\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\widehat a^{\\mathbf L}\\coloneqq\\{F\\in X_{\\mathbf L}:a\\in F\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathcal T_{\\mathbf L}\\coloneqq\\bigcap\\Bigl\\{\\mathcal T\\subseteq\\mathcal P(X_{\\mathbf L}):{}&amp;\n\\mathrm{Top}_{93}(\\mathcal T,X_{\\mathbf L})\\\\\n&amp;\\land\\forall a\\in|\\mathbf L|\\;\\bigl(\\widehat a^{\\mathbf L}\\in\\mathcal T\n\\land X_{\\mathbf L}\\setminus\\widehat a^{\\mathbf L}\\in\\mathcal T\\bigr)\\Bigr\\}.\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathcal T_{\\mathbf L}\\coloneqq\\bigcap\\Bigl\\{\\mathcal T\\subseteq\\mathcal P(X_{\\mathbf L}):{}&amp;\n\\mathrm{Top}_{93}(\\mathcal T,X_{\\mathbf L})\\\\\n&amp;\\land\\forall a\\in|\\mathbf L|\\;\\bigl(\\widehat a^{\\mathbf L}\\in\\mathcal T\n\\land X_{\\mathbf L}\\setminus\\widehat a^{\\mathbf L}\\in\\mathcal T\\bigr)\\Bigr\\}.\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{Up}_{93}(U;X,R)\\leftrightarrow\nU\\subseteq X\\land R\\subseteq X^2\n\\land\\forall x\\in U\\;\\forall y\\in X\\;(\\langle x,y\\rangle\\in R\\to y\\in U)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{Up}_{93}(U;X,R)\\leftrightarrow\nU\\subseteq X\\land R\\subseteq X^2\n\\land\\forall x\\in U\\;\\forall y\\in X\\;(\\langle x,y\\rangle\\in R\\to y\\in U)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{PrSpace}_{93}(X,\\mathcal T,R)\\leftrightarrow{}&amp;\n\\mathrm{StoneSpace}_{93}(X,\\mathcal T)\\land R\\subseteq X^2\\\\\n&amp;\\land\\forall x\\in X\\;(\\langle x,x\\rangle\\in R)\n\\land\\forall x,y,z\\in X\\;\\bigl(\\langle x,y\\rangle\\in R\\land\n\\langle y,z\\rangle\\in R\\to\\langle x,z\\rangle\\in R\\bigr)\\\\\n&amp;\\land\\forall x,y\\in X\\;\\bigl(\\langle x,y\\rangle\\in R\\land\n\\langle y,x\\rangle\\in R\\to x=y\\bigr)\\\\\n&amp;\\land\\forall x,y\\in X\\;\\Bigl(\\langle x,y\\rangle\\notin R\\to\n\\exists U\\;\\bigl(\\mathrm{Clopen}_{93}(U;X,\\mathcal T)\n\\land\\mathrm{Up}_{93}(U;X,R)\\land x\\in U\\land y\\notin U\\bigr)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{PrSpace}_{93}(X,\\mathcal T,R)\\leftrightarrow{}&amp;\n\\mathrm{StoneSpace}_{93}(X,\\mathcal T)\\land R\\subseteq X^2\\\\\n&amp;\\land\\forall x\\in X\\;(\\langle x,x\\rangle\\in R)\n\\land\\forall x,y,z\\in X\\;\\bigl(\\langle x,y\\rangle\\in R\\land\n\\langle y,z\\rangle\\in R\\to\\langle x,z\\rangle\\in R\\bigr)\\\\\n&amp;\\land\\forall x,y\\in X\\;\\bigl(\\langle x,y\\rangle\\in R\\land\n\\langle y,x\\rangle\\in R\\to x=y\\bigr)\\\\\n&amp;\\land\\forall x,y\\in X\\;\\Bigl(\\langle x,y\\rangle\\notin R\\to\n\\exists U\\;\\bigl(\\mathrm{Clopen}_{93}(U;X,\\mathcal T)\n\\land\\mathrm{Up}_{93}(U;X,R)\\land x\\in U\\land y\\notin U\\bigr)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\operatorname{ClopUp}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\{U\\subseteq X:\\mathrm{Clopen}_{93}(U;X,\\mathcal T)\n\\land\\mathrm{Up}_{93}(U;X,R)\\},\\\\\n\\operatorname{ClopUpMeet}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\{\\langle\\langle U,V\\rangle,U\\cap V\\rangle:\nU,V\\in\\operatorname{ClopUp}_{93}(X,\\mathcal T,R)\\},\\\\\n\\operatorname{ClopUpJoin}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\{\\langle\\langle U,V\\rangle,U\\cup V\\rangle:\nU,V\\in\\operatorname{ClopUp}_{93}(X,\\mathcal T,R)\\},\\\\\n\\mathrm{ClopUpAlg}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\langle\\operatorname{ClopUp}_{93}(X,\\mathcal T,R),\n\\operatorname{ClopUpMeet}_{93}(X,\\mathcal T,R),\n\\operatorname{ClopUpJoin}_{93}(X,\\mathcal T,R),\\varnothing,X\\rangle,\\\\\n\\eta_{\\mathbf L}&amp;\\coloneqq\n\\{\\langle a,\\widehat a^{\\mathbf L}\\rangle:a\\in|\\mathbf L|\\}.\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\operatorname{ClopUp}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\{U\\subseteq X:\\mathrm{Clopen}_{93}(U;X,\\mathcal T)\n\\land\\mathrm{Up}_{93}(U;X,R)\\},\\\\\n\\operatorname{ClopUpMeet}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\{\\langle\\langle U,V\\rangle,U\\cap V\\rangle:\nU,V\\in\\operatorname{ClopUp}_{93}(X,\\mathcal T,R)\\},\\\\\n\\operatorname{ClopUpJoin}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\{\\langle\\langle U,V\\rangle,U\\cup V\\rangle:\nU,V\\in\\operatorname{ClopUp}_{93}(X,\\mathcal T,R)\\},\\\\\n\\mathrm{ClopUpAlg}_{93}(X,\\mathcal T,R)&amp;\\coloneqq\n\\langle\\operatorname{ClopUp}_{93}(X,\\mathcal T,R),\n\\operatorname{ClopUpMeet}_{93}(X,\\mathcal T,R),\n\\operatorname{ClopUpJoin}_{93}(X,\\mathcal T,R),\\varnothing,X\\rangle,\\\\\n\\eta_{\\mathbf L}&amp;\\coloneqq\n\\{\\langle a,\\widehat a^{\\mathbf L}\\rangle:a\\in|\\mathbf L|\\}.\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{BDLIso}_{93}(h,\\mathbf L,\\mathbf K)\\leftrightarrow{}&amp;\n\\mathrm{BoundedDistLat}_{93}(\\mathbf L)\n\\land\\mathrm{BoundedDistLat}_{93}(\\mathbf K)\n\\land\\mathrm{Bij}_{93}(h,|\\mathbf L|,|\\mathbf K|)\\\\\n&amp;\\land\\forall a,b\\in|\\mathbf L|\\;\\bigl(\nh(a\\wedge^{\\mathbf L}b)=h(a)\\wedge^{\\mathbf K}h(b)\n\\land h(a\\vee^{\\mathbf L}b)=h(a)\\vee^{\\mathbf K}h(b)\\bigr)\\\\\n&amp;\\land h(0^{\\mathbf L})=0^{\\mathbf K}\n\\land h(1^{\\mathbf L})=1^{\\mathbf K}.\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{BDLIso}_{93}(h,\\mathbf L,\\mathbf K)\\leftrightarrow{}&amp;\n\\mathrm{BoundedDistLat}_{93}(\\mathbf L)\n\\land\\mathrm{BoundedDistLat}_{93}(\\mathbf K)\n\\land\\mathrm{Bij}_{93}(h,|\\mathbf L|,|\\mathbf K|)\\\\\n&amp;\\land\\forall a,b\\in|\\mathbf L|\\;\\bigl(\nh(a\\wedge^{\\mathbf L}b)=h(a)\\wedge^{\\mathbf K}h(b)\n\\land h(a\\vee^{\\mathbf L}b)=h(a)\\vee^{\\mathbf K}h(b)\\bigr)\\\\\n&amp;\\land h(0^{\\mathbf L})=0^{\\mathbf K}\n\\land h(1^{\\mathbf L})=1^{\\mathbf K}.\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{PrSpace}_{93}(X,\\mathcal T,R)\\to\n\\mathrm{BoundedDistLat}_{93}\n(\\mathrm{ClopUpAlg}_{93}(X,\\mathcal T,R))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{PrSpace}_{93}(X,\\mathcal T,R)\\to\n\\mathrm{BoundedDistLat}_{93}\n(\\mathrm{ClopUpAlg}_{93}(X,\\mathcal T,R))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{BoundedDistLat}_{93}(\\mathbf L)\\to\n\\eta_{\\mathbf L}:|\\mathbf L|\\to\n\\operatorname{ClopUp}_{93}(X_{\\mathbf L},\\mathcal T_{\\mathbf L},\\preceq_{\\mathbf L})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}priestley\\text{-}dual}\\vdash\n\\mathrm{BoundedDistLat}_{93}(\\mathbf L)\\to\n\\eta_{\\mathbf L}:|\\mathbf L|\\to\n\\operatorname{ClopUp}_{93}(X_{\\mathbf L},\\mathcal T_{\\mathbf L},\\preceq_{\\mathbf L})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The order is the explicit inclusion relation on prime filters. The meet and join are restricted function graphs on the clopen-upset carrier, the canonical map is a graph, and <span class=\"math-inline\" data-tex=\"\\mathrm{BDLIso}_{93}\">\\(\\mathrm{BDLIso}_{93}\\)</span> supplies the structure-appropriate isomorphism for the flat bounded-lattice encoding.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"93-df-bounded-distributive-lattice","status":"resolved","id":"0454a0272a142daa","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-bounded-distributive-lattice]]","embed":false},{"target":"93-df-prime-filter","status":"resolved","id":"a830918010f1575a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-prime-filter]]","embed":false},{"target":"93-df-stone-space","status":"resolved","id":"d9a8e20998fad98e","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-stone-space]]","embed":false},{"target":"93-df-set-theoretic-background","status":"resolved","id":"e30eac382dc7d1a7","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-set-theoretic-background]]","embed":false}],"math":[{"tex":"\\mathbf L","display":false},{"tex":"\\mathrm{BoundedDistLat}_{93}","display":false},{"tex":"\\mathrm{Bij}_{93}","display":false},{"tex":"\\mathrm{PrimeFil}_{93}","display":false},{"tex":"\\mathrm{Top}_{93}","display":false},{"tex":"\\mathrm{StoneSpace}_{93}","display":false},{"tex":"\\mathrm{Clopen}_{93}","display":false},{"tex":"X_{\\mathbf L}","display":false},{"tex":"\\preceq_{\\mathbf L}","display":false},{"tex":"\\mathcal T_{\\mathbf L}","display":false},{"tex":"\\mathrm{Up}_{93}","display":false},{"tex":"\\mathrm{PrSpace}_{93}","display":false},{"tex":"\\operatorname{ClopUp}_{93}","display":false},{"tex":"\\operatorname{ClopUpMeet}_{93}","display":false},{"tex":"\\operatorname{ClopUpJoin}_{93}","display":false},{"tex":"\\mathrm{ClopUpAlg}_{93}","display":false},{"tex":"\\mathrm{BDLIso}_{93}","display":false},{"tex":"\\eta_{\\mathbf L}","display"