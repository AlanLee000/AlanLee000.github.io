&\\land\\\n\\operatorname{Ob}\\mathcal C_T=G_T,\\\\\n\\mathsf{RankedDTT}(\\operatorname{rk}(\\Sigma)).\n\\end{aligned}","display":true},{"tex":"\\mathsf{Strict}_{\\varnothing}\n\\bigl(\\varepsilon_S;(S^{\\mathrm{syn}},\\varnothing),(S,\\varnothing)\\bigr).","display":true},{"tex":"\\begin{aligned}\n&(\\forall U,V\\in\\operatorname{Ob}\\mathcal C_{S^{\\mathrm{syn}}})\\quad\n(\\varepsilon_S)_{C,U,V}:\\mathcal C_{S^{\\mathrm{syn}}}(U,V)\n\\xrightarrow{\\sim}\\mathcal C_S((\\varepsilon_S)_CU,(\\varepsilon_S)_CV),\\\\\n&(\\forall U\\in\\operatorname{Ob}\\mathcal C_{S^{\\mathrm{syn}}})\\quad\n(\\varepsilon_S)_{T,U}:\\operatorname{Ty}_{S^{\\mathrm{syn}}}(U)\n\\xrightarrow{\\sim}\\operatorname{Ty}_S((\\varepsilon_S)_CU),\\\\\n&(\\forall U\\in\\operatorname{Ob}\\mathcal C_{S^{\\mathrm{syn}}})\n(\\forall A\\in\\operatorname{Ty}_{S^{\\mathrm{syn}}}(U))\\quad\n(\\varepsilon_S)_{t,U,A}:\\operatorname{Tm}_{S^{\\mathrm{syn}}}(U,A)\n\\xrightarrow{\\sim}\\operatorname{Tm}_S((\\varepsilon_S)_CU,(\\varepsilon_S)_{T,U}A),\\\\\n&\\{(\\varepsilon_S)_CU\\mid U\\in\\operatorname{Ob}\\mathcal C_{S^{\\mathrm{syn}}}\\}=G_S.\n\\end{aligned}","display":true},{"tex":"\\mathsf{CtxDense}(S)\\Longleftrightarrow\n\\mathsf{DTTEquiv}(\\varepsilon_S;S^{\\mathrm{syn}},S).","display":true},{"tex":"\\begin{aligned}\n&\\mathsf{DTTEquiv}\\bigl(\\varepsilon_T;\\operatorname{Cl}(\\operatorname{Spec}(T)),T\\bigr),\\\\\n&\\mathscr P\\simeq_{\\mathrm{pres}}\\operatorname{Spec}(\\operatorname{Cl}(\\mathscr P)),\\\\\n&\\operatorname{rk}(\\Sigma)\\simeq_{\\mathrm{pres}}\n\\operatorname{Spec}\\bigl(\\operatorname{Cl}(\\operatorname{rk}(\\Sigma))\\bigr).\n\\end{aligned}","display":true},{"tex":"\\Lambda_{n+1}","display":false},{"tex":"\\Lambda_n","display":false},{"tex":"n","display":false},{"tex":"\\mathsf{SplitDTT}","display":false},{"tex":"\\Gamma","display":false},{"tex":"a\\in\\operatorname{Ty}_S(⟦\\Gamma⟧)","display":false},{"tex":"a","display":false},{"tex":"A","display":false},{"tex":"f:⟦\\Gamma⟧\\to⟦\\Delta⟧