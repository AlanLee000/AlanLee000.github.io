putable-real\">43-df-computable-real</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"6c0559518cd32104\" href=\"?note=6c0559518cd32104\" title=\"43-df-ce\">43-df-ce</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"e7071caa967351d5\" href=\"?note=e7071caa967351d5\" title=\"43-df-prefixfree\">43-df-prefixfree</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"aa33e0ea8422ba2a\" href=\"?note=aa33e0ea8422ba2a\" title=\"43-df-effective-coding\">43-df-effective-coding</a></span></div>"},{"key":"source_edition","html":"Downey–Hirschfeldt, draft 2007-07-28 (629 PDF pages)"},{"key":"source_locator","html":"Theorem 15.10.1; printed pp.478–479 / PDF pp.498–499"},{"key":"source_scope","html":"book"},{"key":"verification_status","html":"source-statement-checked"},{"key":"source_statement_checked","html":"true"},{"key":"source_proof_checked","html":"false"},{"key":"eligible_as_verified_dependency","html":"true"},{"key":"revision_round","html":"2026-10-16"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p><span class=\"math-inline\" data-tex=\"\\alpha\\in[0,1]\">\\(\\alpha\\in[0,1]\\)</span>；<span class=\"math-inline\" data-tex=\"\\mathrm{KTrivialReal}\">\\(\\mathrm{KTrivialReal}\\)</span>、<span class=\"math-inline\" data-tex=\"\\mathrm{LeftComputable}\">\\(\\mathrm{LeftComputable}\\)</span>、<span class=\"math-inline\" data-tex=\"\\operatorname{ComputableReal}\">\\(\\operatorname{ComputableReal}\\)</span>、<span class=\"math-inline\" data-tex=\"\\operatorname{CE}\">\\(\\operatorname{CE}\\)</span>、<span class=\"math-inline\" data-tex=\"\\operatorname{ComputableSet}\">\\(\\operatorname{ComputableSet}\\)</span>、<span class=\"math-inline\" data-tex=\"\\mathrm{PrefixFree}\">\\(\\mathrm{PrefixFree}\\)</span>、<span class=\"math-inline\" data-tex=\"\\#_2\">\\(\\#_2\\)</span> 分别采用 <a class=\"wiki-link\" id=\"ref-7\" data-note=\"cea02ee793bb0f7b\" href=\"?note=cea02ee793bb0f7b\" title=\"43-df-ktrivial-real\">43-df-ktrivial-real</a>、<a class=\"wiki-link\" id=\"ref-8\" data-note=\"e7d00f16a112ff92\" href=\"?note=e7d00f16a112ff92\" title=\"43-df-leftcomputable\">43-df-leftcomputable</a>、<a class=\"wiki-link\" id=\"ref-9\" data-note=\"96d58aa7b6884a9b\" href=\"?note=96d58aa7b6884a9b\" title=\"43-df-computable-real\">43-df-computable-real</a>、<a class=\"wiki-link\" id=\"ref-10\" data-note=\"6c0559518cd32104\" href=\"?note=6c0559518cd32104\" title=\"43-df-ce\">43-df-ce</a>、<a class=\"wiki-link\" id=\"ref-11\" data-note=\"e7071caa967351d5\" href=\"?note=e7071caa967351d5\" title=\"43-df-prefixfree\">43-df-prefixfree</a>、<a class=\"wiki-link\" id=\"ref-12\" data-note=\"aa33e0ea8422ba2a\" href=\"?note=aa33e0ea8422ba2a\" title=\"43-df-effective-coding\">43-df-effective-coding</a>。</p>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\bigl(\\mathrm{KTrivialReal}(\\alpha)\\land\\mathrm{LeftComputable}(\\alpha)\\land\\neg\\operatorname{ComputableReal}(\\alpha)\\bigr)\\Rightarrow\\exists P\\subseteq2^{&lt;\\omega}\\;\\left(\\operatorname{CE}(\\#_2[P])\\land\\mathrm{PrefixFree}(P)\\land\\alpha=\\sum_{\\sigma\\in P}2^{-|\\sigma|}\\land\\neg\\operatorname{ComputableSet}^{\\varnothing}(\\#_2[P])\\right).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\bigl(\\mathrm{KTrivialReal}(\\alpha)\\land\\mathrm{LeftComputable}(\\alpha)\\land\\neg\\operatorname{ComputableReal}(\\alpha)\\bigr)\\Rightarrow\\exists P\\subseteq2^{&lt;\\omega}\\;\\left(\\operatorname{CE}(\\#_2[P])\\land\\mathrm{PrefixFree}(P)\\land\\alpha=\\sum_{\\sigma\\in P}2^{-|\\sigma|}\\land\\neg\\operatorname{ComputableSet}^{\\varnothing}(\\#_2[P])\\right).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>存在一个非计算表示，不是每个表示均非计算。以串编码显式区分P与自然数集；原稿末段使用W_e表示补集的符号排印不一致，本轮只核对定理陈述。</p>\n<p>来源：用户提供的2007-07-28草稿，Theorem 15.10.1; printed pp.478–479 / PDF pp.498–499。本轮逐项比对来源陈述并人工核对类型、参数和去Remark条件；未声称机器形式验证或来源完整证明核验。</p>\