phi)&\\coloneqq\\neg_{\\rm SK}v_\\Gamma(\\varphi),\\\\\nv_\\Gamma(\\varphi\\land\\psi)&\\coloneqq\nv_\\Gamma(\\varphi)\\land_{\\rm SK}v_\\Gamma(\\psi),\\\\\nv_\\Gamma(\\varphi\\lor\\psi)&\\coloneqq\nv_\\Gamma(\\varphi)\\lor_{\\rm SK}v_\\Gamma(\\psi),\\\\\nv_\\Gamma(\\forall x\\,\\varphi)&\\coloneqq\n\\inf_{<_t}\\{v_\\Gamma(\\varphi(\\overline n)):n\\in\\mathbb N\\},\\\\\nv_\\Gamma(\\exists x\\,\\varphi)&\\coloneqq\n\\sup_{<_t}\\{v_\\Gamma(\\varphi(\\overline n)):n\\in\\mathbb N\\}\n&&(\\varphi(x)\\in\\mathrm{Fml}^{1}_{\\mathcal L_T}).\n\\end{aligned}","display":true},{"tex":"v_\\Gamma","display":false},{"tex":"\\Gamma","display":false},{"tex":"1, 0, u","display":false},{"tex":"v_\\Gamma","display":false},{"tex":"\\Gamma","display":false},{"tex":"\\mathbf f<\\mathbf u<\\mathbf t","display":false},{"tex":"\\Gamma","display":false},{"tex":"J(\\Gamma) = \\Gamma","display":true},{"tex":"\\Gamma=J(\\Gamma)","display":false},{"tex":"\\varphi","display":false},{"tex":"v_\\Gamma(T(\\overline{\\ulcorner\\varphi\\urcorner}))\n=v_\\Gamma(\\varphi)","display":false}],"bytes":2862,"backlinks":[{"id":"f276735320c6ad44","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"ae9eced0b12cbd2a","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{ConInfo}(X)$ (信息一致性, see [[91-df-truth-value-function]])"},{"id":"3a19d5715745463a","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"0f7fd19603cd4cce","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"b0e2f74fa0a4326a","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"80b21a90a0262f70","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"eb8ec521f1c6bc18","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"4278731e7fc892de","anchor":"ref-44","locations":["正文"],"count":1,"excerpt":"[[91-df-truth-value-function]]"},{"id":"e93fc3e2f8