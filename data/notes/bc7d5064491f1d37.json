:"e\\in G'","display":false},{"tex":"\\sigma_n=G\\upharpoonright n","display":false},{"tex":"n","display":false},{"tex":"\\Phi_e^{\\sigma_n}(e)","display":false},{"tex":"1","display":false},{"tex":"K","display":false},{"tex":"\\rho\\succeq\\sigma_n","display":false},{"tex":"V_e","display":false},{"tex":"0","display":false},{"tex":"n","display":false},{"tex":"n","display":false},{"tex":"0","display":false},{"tex":"n","display":false},{"tex":"0","display":false},{"tex":"G'\\le_TG\\oplus K","display":false},{"tex":"G\\le_TG'","display":false},{"tex":"K\\le_TG'","display":false},{"tex":"G\\oplus K\\le_TG'","display":false},{"tex":"K\\equiv_T\\varnothing'","display":false},{"tex":"G\\le_T\\varnothing'","display":false},{"tex":"\\varnothing'","display":false}],"bytes":2290,"backlinks":[{"id":"d6bcd07303c88c81","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-ngen]]；see [[20-thm-1gen-low]]；see [[20-thm-hierarchy-closure]]；see [[20-thm-generic-not-lower-jump]]；see [[20-df-join]]；see [[20-df-jump]]。"},{"id":"eb7be9972d7be6ba","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-uniform-ce-sequence]]；see [[20-thm-finite-extension-paradigm]]；see [[20-df-join]]；see [[20-thm-1gen-low]]；see [[20-df-1gen]]；see [[20-df-strings]]。"},{"id":"54d630bb92c94299","anchor":"ref-16","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-1gen]]；see [[20-df-K]]；see [[20-df-strings]]；see [[20-df-low-high]]；see [[20-thm-K-one-complete]]；see [[20-thm-generic-biimmune]]；see [[20-thm-1gen-low]]。"},{"id":"005203b6707a19f4","anchor":"ref-275","locations":["正文"],"count":1,"excerpt":"[[20-thm-1gen-low]] — 章 6；直接提供者 7 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-275","locations":["正文"],"count":1,"excerpt":"[[20-thm-1gen-low]]"}],"outgoing":["b03a71cd282632fa","c4781c7288e610af","91065cedbdf2fc27","634b02102672cc2a","08b4fd5163a7f955","de54fb8c1326b2f0","2ea8548c98f572c3"]}