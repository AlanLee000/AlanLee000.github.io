pp}(\\operatorname{app}(\\operatorname{comb}(W),X),Y),\n\\operatorname{app}(\\operatorname{app}(X,Y),Y)):X,Y\\in\\mathsf{Tm}_{BCKW}\\}.","display":true},{"tex":"\\to^0_{BCKW}=\n\\mathsf{Red}_{BCKW,B}\\cup\\mathsf{Red}_{BCKW,C}\\cup\\mathsf{Red}_{BCKW,K}\\cup\\mathsf{Red}_{BCKW,W}.","display":true},{"tex":"\\mathsf{RedCtx}_{BCKW}","display":false},{"tex":"\\operatorname{hole}_{BCKW}\\in\\mathsf{RedCtx}_{BCKW}","display":false},{"tex":"C\\in\\mathsf{RedCtx}_{BCKW}","display":false},{"tex":"P\\in\\mathsf{Tm}_{BCKW}","display":false},{"tex":"\\operatorname{appL}_{BCKW}(C,P)\\in\\mathsf{RedCtx}_{BCKW}","display":false},{"tex":"P\\in\\mathsf{Tm}_{BCKW}","display":false},{"tex":"C\\in\\mathsf{RedCtx}_{BCKW}","display":false},{"tex":"\\operatorname{appR}_{BCKW}(P,C)\\in\\mathsf{RedCtx}_{BCKW}","display":false},{"tex":"\\operatorname{plug}_{BCKW}:\\mathsf{RedCtx}_{BCKW}\\times\\mathsf{Tm}_{BCKW}\\to\\mathsf{Tm}_{BCKW}","display":true},{"tex":"\\operatorname{plug}_{BCKW}(\\operatorname{hole}_{BCKW},M)=M,","display":true},{"tex":"\\operatorname{plug}_{BCKW}(\\operatorname{appL}_{BCKW}(C,P),M)=\\operatorname{app}(\\operatorname{plug}_{BCKW}(C,M),P),","display":true},{"tex":"\\operatorname{plug}_{BCKW}(\\operatorname{appR}_{BCKW}(P,C),M)=\\operatorname{app}(P,\\operatorname{plug}_{BCKW}(C,M)).","display":true},{"tex":"\\to_{BCKW}","display":false},{"tex":"\\{(\\operatorname{plug}_{BCKW}(C,M),\\operatorname{plug}_{BCKW}(C,N)):\nC\\in\\mathsf{RedCtx}_{BCKW},\\ M\\to^0_{BCKW}N\\}.","display":true},{"tex":"\\mathsf{RedDer}_{BCKW}\n=\n\\{(M_0,\\ldots,M_{n-1}):n>0,\\forall i<n\\,M_i\\in\\mathsf{Tm}_{BCKW},\n\\forall i+1<n\\,M_i\\to_{BCKW}M_{i+1}\\}.","display":true},{"tex":"M\\to^*_{BCKW}N","display":false},{"tex":"\\rho\\in\\mathsf{RedDer}_{BCKW}","display":false},{"tex":"M","display":false},{"tex":"N","display":false},{"tex":"\\mathsf{Rule}_{BCKW}\n=\n\\{(\\langle M\\rangle,N):M\\to_{BCKW}N\\}\n\\cup\n\\{(\\langle M\\rangle,N):N\\to_{BCKW}M\\}\n\\cup\n\\{(\\langle M\\rangle,N):M\\equiv_\\alpha N\\}.","display":true},{"tex":"(M_0,\\ldots,M_{n-1})","display":false},{"tex":"\\mathsf{Rule}_{BCKW}","display":false},{"tex":"M=_{BCKW}N","display":false},{"tex":"M","display":false},{"tex":"N","display":false},{"tex":"\\mathsf{AxJdg}_{BCKW}\n=\n\\{\\operatorname{var}(x):x\\in\\mathsf{Var}\\}\\cup\\{\\operatorname{comb}(c):c\\in\\mathsf{Comb}_{BCKW}\\}.","display":true},{"tex":"\\mathsf{Der}_{BCKW}\n=\n\\{(M_0,\\ldots,M_{n-1}):n>0,\\forall i<n\\ M_i\\in\\mathsf{Tm}_{BCKW},\n\\forall i+1<n\\ ((\\langle M_i\\rangle,M_{i+1})\\in\\mathsf{Rule}_{BCKW})\\}.","display":true},{"tex":"\\mathsf{Delta}_{BCKW}=(\\operatorname{comb}(B),\\operatorname{comb}(C),\\operatorname{comb}(K),\\operatorname{comb}(W),\\to^0_{BCKW}).","display":true},{"tex":"\\to^0_{BCKW}\\subseteq\\mathsf{Tm}_{BCKW}\\times\\mathsf{Tm}_{BCKW},\n\\quad\n\\to_{BCKW}\\subseteq\\mathsf{Tm}_{BCKW}\\times\\mathsf{Tm}_{BCKW},\n\\quad\n\\mathsf{RedDer}_{BCKW}\\subseteq\\mathsf{Tm}_{BCKW}^{<\\omega},\n\\quad\n\\mathsf{Der}_{BCKW}\\subseteq\\mathsf{Tm}_{BCKW}^{<\\omega}.","display":true},{"tex":"W","display":false},{"tex":"\\mathsf{Root}_{BCKW,B}","display":false},{"tex":"\\mathsf{Root}_{BCKW,C}","display":false},{"tex":"\\mathsf{Root}_{BCKW,K}","display":false},{"tex":"\\mathsf{Root}_{BCKW,W}","display":false},{"tex":"\\to^0_{BCKW}\n=\n\\mathsf{Root}_{BCKW,B}\\cup\\mathsf{Root}_{BCKW,C}\n\\cup\\mathsf{Root}_{BCKW,K}\\cup\\mathsf{Root}_{BCKW,W}\n\\subseteq\\mathsf{Tm}_{BCKW}\\times\\mathsf{Tm}_{BCKW}.","display":true},{"tex":"\\equiv_\\alpha^{BCKW}=\\{(M,M):M\\in\\mathsf{Tm}_{BCKW}\\},\n\\qquad\n\\equiv_\\alpha=\\equiv_\\alpha^{BCKW}.","display":true},{"tex":"\\mathsf{ConvObj}_{BCKW}(M,N)\n=\n\\{\\pi\\in\\mathsf{Der}_{BCKW}:\\pi_0=M\\land\\pi_{|\\pi|-1}=N\\}.","display":true},{"tex":"M=_{BCKW}N","display":false},{"tex":"\\mathsf{Root}_{BCKW,W}","display":false},{"tex":"\\mathcal{BCKW}=(\\mathsf{Var},\\mathsf{Comb}_{BCKW},\\mathsf{Tm}_{BCKW},FV,\\operatorname{BV}_{BCKW},\\operatorname{Sub}_{BCKW},\\equiv_\\alpha^{BCKW},\\mathsf{AxJdg}_{BCKW},\\mathsf{Delta}_{BCKW},\\mathsf{RedCtx}_{BCKW},\\operatorname{plug}_{BCKW},\\mathsf{Root}_{BCKW,B},\\mathsf{Root}_{BCKW,C},\\mathsf{Root}_{BCKW,K},\\mathsf{Root}_{BCKW,W},\\to^0_{BCKW},\\to_{BCKW},\\mathsf{RedDer}_{BCKW},\\to^*_{BCKW},\\mathsf{Rule}_{BCKW},\\mathsf{Der}_{BCKW},\\mathsf{ConvObj}_{BCKW},=_{BCKW}).","display":true},{"tex":"B,C,K,W","display":false},{"tex":"W","display":false},{"tex":"WXY\\to XYY","display":false},{"tex":"S","display":false},{"tex":"I","display":false}],"bytes":6976,"backlinks":[],"outgoing":[]}