\\vec x|}p_{i+1}^{x_i+1},\\\\\n\\langle x_0,\\ldots,x_{n-1}\\rangle&\\coloneqq\\operatorname{enc}_{\\mathrm{seq}}(\\vec x)\n\\quad(\\vec x\\in\\mathbb N^n),\\qquad\\langle\\rangle\\coloneqq1,\\\\\n\\operatorname{SeqCode}(s,n)&\\ \\Longleftrightarrow\\\ns,n\\in\\mathbb N\\land\\exists\\vec x\\in\\mathbb N^n\\ s=\\operatorname{enc}_{\\mathrm{seq}}(\\vec x),\\\\\n\\operatorname{Seq}_{\\mathrm{enc}}(s)&\\ \\Longleftrightarrow\\ \\exists n\\in\\mathbb N\\ \\operatorname{SeqCode}(s,n),\\\\\n&\\forall s\\in\\mathbb N\\quad\\operatorname{Seq}_{\\mathrm{enc}}(s)\\Longrightarrow\n\\exists!n\\in\\mathbb N\\ \\operatorname{SeqCode}(s,n),\\\\\n\\operatorname{Len}_{\\mathrm{enc}}(s)&\\coloneqq\n\\begin{cases}\n\\iota n\\,(n\\in\\mathbb N\\land\\operatorname{SeqCode}(s,n)),&\\operatorname{Seq}_{\\mathrm{enc}}(s),\\\\\n0,&\\neg\\operatorname{Seq}_{\\mathrm{enc}}(s),\n\\end{cases}\\\\\n\\nu_p(s)&\\coloneqq\n\\begin{cases}\n\\max\\{a\\in\\mathbb N:a\\le s\\land p^a\\mid s\\},&s>0\\land\\operatorname{Prime}(p),\\\\\n0,&s=0\\lor\\neg\\operatorname{Prime}(p),\n\\end{cases}\\\\\n(s)^{\\mathrm{enc}}_i&\\coloneqq\n\\begin{cases}\n\\nu_{p_{i+1}}(s)-1,&\\operatorname{Seq}_{\\mathrm{enc}}(s)\\land i<\\operatorname{Len}_{\\mathrm{enc}}(s),\\\\\n0,&\\neg\\operatorname{Seq}_{\\mathrm{enc}}(s)\\lor i\\ge\\operatorname{Len}_{\\mathrm{enc}}(s).\n\\end{cases}\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\forall\\vec x,\\vec y\\in\\mathbb N^{<\\omega}\\quad\n\\operatorname{enc}_{\\mathrm{seq}}(\\vec x)=\\operatorname{enc}_{\\mathrm{seq}}(\\vec y)\n\\Longleftrightarrow\\vec x=\\vec y,\\\\\n&\\forall\\vec x\\in\\mathbb N^{<\\omega}\\quad\n\\operatorname{Len}_{\\mathrm{enc}}(\\operatorname{enc}_{\\mathrm{seq}}(\\vec x))=|\\vec x|,\\\\\n&\\forall\\vec x\\in\\mathbb N^{<\\omega}\\ \\forall i<|\\vec x|\\quad\n(\\operatorname{enc}_{\\mathrm{seq}}(\\vec x))^{\\mathrm{enc}}_i=x_i.\n\\end{aligned}","display":true},{"tex":"\\operatorname{SeqCode}(s,n)","display":false},{"tex":"\\nu_p(0)=0","disp