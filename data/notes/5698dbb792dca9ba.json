":false},{"tex":"\\theta","display":false},{"tex":"T","display":false},{"tex":"\\{\\theta\\}\\cup(Y\\setminus Y_0)","display":false},{"tex":"U","display":false},{"tex":"y\\in Y\\setminus Y_0","display":false},{"tex":"Y_0\\vdash T","display":false},{"tex":"Y_0\\vdash\\theta","display":false},{"tex":"Y\\setminus\\{y\\}\\vdash y","display":false},{"tex":"Y","display":false},{"tex":"\\theta","display":false},{"tex":"T+(Y\\setminus Y_0)","display":false},{"tex":"T","display":false}],"bytes":2533,"backlinks":[{"id":"aceae1bb446510ab","anchor":"ref-191","locations":["正文"],"count":1,"excerpt":"[[../67-cor-finite-base-nonirredundant]]"}],"outgoing":["57d3217ac67bc5a6","d4ae73c2fc9ccebd","851cd80e64893935"]}