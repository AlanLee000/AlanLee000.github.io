\\in\\mathrm{Structure}(L)\\;\n\\Bigl[\n&\\bigl|\\,|\\mathfrak M|\\,\\bigr|\\leq\\aleph_0\n\\land\n\\operatorname{Age}_L(\\mathfrak M)=K\n\\\\\n&{}\\land\n\\operatorname{Ultrahomogeneous}_L(\\mathfrak M)\n\\land\\operatorname{LocallyFinite}_L(\\mathfrak M)\n\\\\\n&{}\\land\n\\forall\\mathfrak N\\in\\mathrm{Structure}(L)\\;\n\\Bigl(\n\\bigl|\\,|\\mathfrak N|\\,\\bigr|\\leq\\aleph_0\n\\\\\n&\\hspace{18mm}\\land\n\\operatorname{Age}_L(\\mathfrak N)=K\n\\land\\operatorname{LocallyFinite}_L(\\mathfrak N)\n\\land\n\\operatorname{Ultrahomogeneous}_L(\\mathfrak N)\n\\to\n\\mathfrak N\\cong\\mathfrak M\n\\Bigr)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"K","display":false},{"tex":"f(x)=x","display":false},{"tex":"(\\mathbb Z,n\\mapsto n+1)","display":false},{"tex":"K","display":false},{"tex":"K","display":false}],"bytes":3395,"backlinks":[{"id":"2c98c9e634ff4b44","anchor":"ref-181","locations":["正文"],"count":1,"excerpt":"[[17-thm-aleph-one-categoricity-consequences]]\n[[17-thm-atomic-model-existence]]\n[[17-thm-beth-definability]]\n[[17-thm-beth-definability-satisfaction-form]]\n[[17-thm-chain-sentence-preservation]]\n[[17-thm-chain-theory-preservation]]\n[[17-thm-compactness]]\n[[17-thm-compactness-equivalents]]\n[[17-thm-compactness-henkin-form]]\n[[17-thm-compactness-ultraproduct-form]]\n[[17-thm-completeness-characterization]]\n[[17-thm-countable-back-and-forth]]\n[[17-thm-countable-omitting-types]]\n[[17-thm-craig-interpolation]]\n[[17-thm-craig-interpolation-common-language]]\n[[17-thm-dense-linear-order-qe]]\n[[17-thm-diagram-embedding]]\n[[17-thm-downward-lowenheim-skolem]]\n[[17-thm-ehrenfeucht-mostowski]]\n[[17-thm-elementary-amalgamation]]\n[[17-thm-elementary-chain-union]]\n[[17-thm-elementary-diagram-embedding]]\n[[17-thm-erdos-rado]]\n[[17-thm-existential-preservation]]\n[[17-thm-extended-omitting-types]]\n[[17-thm-finite-ramsey]]\n[[17-thm-fraisse-limit]]\n[[17-thm-horn-axiomatization]]\n[[17-thm-horn-preservation]]\n[[17-thm-horn-sentence-characteriza