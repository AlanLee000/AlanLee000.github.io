{"id":"e5df5e5db2baf133","group":"89","path":"89/89-cor-gl-k4-extension.md","title":"GL Extends K4","display":"cor-gl-k4-extension — GL Extends K4","type":"corollary","metadata":{"type":"corollary","book":"The Logic of Provability","book_abbrev":"89","label":"89-cor-gl-k4-extension","aliases":["89-cor-gl-k4-extension"],"display":"cor-gl-k4-extension — GL Extends K4","depends_on":["[[89-df-gl-logic]]","[[89-df-modal-logic-k4]]","[[89-lem-l-implies-4]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"corollary"},{"key":"book","html":"The Logic of Provability"},{"key":"book_abbrev","html":"89"},{"key":"label","html":"89-cor-gl-k4-extension"},{"key":"aliases","html":"<div class=\"property-array\"><span>89-cor-gl-k4-extension</span></div>"},{"key":"display","html":"cor-gl-k4-extension — GL Extends K4"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"0006800fa1c85177\" href=\"?note=0006800fa1c85177\" title=\"89-df-gl-logic\">89-df-gl-logic</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"d9f30bc0c9c793d3\" href=\"?note=d9f30bc0c9c793d3\" title=\"89-df-modal-logic-k4\">89-df-modal-logic-k4</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"e2ade50b86346886\" href=\"?note=e2ade50b86346886\" title=\"89-lem-l-implies-4\">89-lem-l-implies-4</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{K4},\\mathrm{GL}\\subseteq\\mathrm{Fml}_{\\Box}\">\\(\\mathrm{K4},\\mathrm{GL}\\subseteq\\mathrm{Fml}_{\\Box}\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{cor\\text{-}gl\\text{-}k4\\text{-}extension}\\vdash\n\\mathrm{K4}\\subseteq\\mathrm{GL}.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{cor\\text{-}gl\\text{-}k4\\text{-}extension}\\vdash\n\\mathrm{K4}\\subseteq\\mathrm{GL}.\\]</div