ale-map-not-covering]]"},{"id":"ffda0c0482667c45","anchor":"ref-133","locations":["正文"],"count":2,"excerpt":"[[14-ex-etale-map-not-covering]]"},{"id":"c60ad289d123497b","anchor":"ref-73","locations":["正文"],"count":1,"excerpt":"[[14-ex-etale-map-not-covering|Example II.6 An Étale Map That Is Not a Covering]]"}],"outgoing":["afeb22707a474889","ead2b5b1b3a20ecd"]}