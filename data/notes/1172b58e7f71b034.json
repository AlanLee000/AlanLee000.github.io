2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch05/58-df-normed-space.md","status":"resolved","id":"bdbbe5a00af04978","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-normed-space.md]]","embed":false},{"target":"../batch07/58-df-linear-operator.md","status":"resolved","id":"9fa59a08139e4466","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-linear-operator.md]]","embed":false},{"target":"../batch05/58-df-normed-space.md","status":"resolved","id":"bdbbe5a00af04978","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$X,Y$ (normed vector spaces, see [[../batch05/58-df-normed-space.md]])","embed":false},{"target":"../batch05/58-df-normed-space.md","status":"resolved","id":"bdbbe5a00af04978","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{NormedSpace}_S$ (normed-space predicate, see [[../batch05/58-df-normed-space.md]])","embed":false},{"target":"../batch07/58-df-linear-operator.md","status":"resolved","id":"9fa59a08139e4466","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{BoundedLinear}_{\\mathbb K}$ (bounded-linear predicate, see [[../batch07/58-df-linear-operator.md]])","embed":false}],"math":[{"tex":"\\mathbb K\\in\\{\\mathbb R,\\mathbb C\\}","display":false},{"tex":"X,Y","display":false},{"tex":"T:X\\to Y","display":false},{"tex":"\\mathrm{NormedSpace}_S","display":false},{"tex":"\\mathrm{Bound