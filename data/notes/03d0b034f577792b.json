,B\\rangle\\in E\\}\\bigr)","display":true}],"bytes":1319,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2589","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-zfc-measure4-atom-of-measure-algebra.md|58-df-zfc-measure4-atom-of-measure-algebra]]（batch17）"}],"outgoing":["a3348ed9eb6fb4e3","40617012e3a2a78d","af40856855b155a1"]}