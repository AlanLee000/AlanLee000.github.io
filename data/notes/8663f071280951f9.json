:"\\widehat\\sigma(\\operatorname{atom}(p))=\\sigma(p),\\quad\n\\widehat\\sigma(\\bot)=\\bot,\\quad\n\\widehat\\sigma(\\neg A)=\\neg\\widehat\\sigma(A),","display":true},{"tex":"\\widehat\\sigma(A\\to B)=\\widehat\\sigma(A)\\to\\widehat\\sigma(B),","display":true},{"tex":"\\widehat\\sigma(A\\square\\!\\!\\to B)=\\widehat\\sigma(A)\\square\\!\\!\\to\\widehat\\sigma(B),","display":true},{"tex":"\\widehat\\sigma(B\\preceq_A C)=\\widehat\\sigma(B)\\preceq_{\\widehat\\sigma(A)}\\widehat\\sigma(C).","display":true},{"tex":"\\operatorname{BV}_{618}(A)=\\varnothing","display":false},{"tex":"A\\equiv_{\\alpha,618}B","display":false},{"tex":"A=B","display":false},{"tex":"\\mathsf{Ax}_{\\to,1}^{618}=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{618}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\to,2}^{618}=\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{618}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\to,3}^{618}=\\{((\\neg A\\to\\neg B)\\to(B\\to A)):A,B\\in\\mathsf{Frm}_{618}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\bot}^{618}=\\{\\bot\\to A:A\\in\\mathsf{Frm}_{618}\\}.","display":true},{"tex":"\\mathsf{Ax}_{CFK}^{618}\n=\n\\{(A\\square\\!\\!\\to(B\\to C))\\to((A\\square\\!\\!\\to B)\\to(A\\square\\!\\!\\to C)):A,B,C\\in\\mathsf{Frm}_{618}\\},","display":true},{"tex":"\\mathsf{Ax}_{SimRefl}^{618}\n=\n\\{B\\preceq_A B:A,B\\in\\mathsf{Frm}_{618}\\},","display":true},{"tex":"\\mathsf{Ax}_{SimTrans}^{618}\n=\n\\{((B\\preceq_A C)\\land(C\\preceq_A D))\\to(B\\preceq_A D):A,B,C,D\\in\\mathsf{Frm}_{618}\\},","display":true},{"tex":"\\mathsf{Ax}_{SimCF}^{618}\n=\n\\{((B\\preceq_A C)\\land(A\\square\\!\\!\\to B))\\to(A\\square\\!\\!\\to C):A,B,C\\in\\mathsf{Frm}_{618}\\}.","display":true},{"tex":"\\mathsf{Ax}_{618}\n=\n\\mathsf{Ax}_{\\to,1}^{618}\\cup\\mathsf{Ax}_{\\to,2}^{618}\\cup\\mathsf{Ax}_{\\to,3}^{618}\n\\cup\\mathsf{Ax}_{\\bot}^{618}\n\\cup\\mathsf{Ax}_{CFK}^{618}\\cup\\mathsf{Ax}_{SimRefl}^{618}\\cup\\mathsf{Ax}_{SimTrans}^{618}\\cup\\mathsf{Ax}_{SimCF}^