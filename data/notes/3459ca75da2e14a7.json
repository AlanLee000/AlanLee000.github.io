tarrow\\;\\exists D\\in\\mathrm{MonotoneDNF}_n\\;(f=\\mathrm{EvalDNF}_n(D))\\right).","display":true}],"bytes":1231,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-470","locations":["正文"],"count":1,"excerpt":"[[27-thm-monochar|thm-monochar — Positive DNF characterization]]"}],"outgoing":["640eb8f2fbffd9d9","814b17f1550bcf38","5d10aed668d85817","0b618255959ff4bc"]}