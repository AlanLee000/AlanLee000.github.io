mega,I,K,N","display":false},{"tex":"\\lambda b.I","display":false},{"tex":"\\mathrm{NF},\\mathrm{WNAt},\\mathrm{SNAt}","display":false},{"tex":"\\Omega\\coloneqq[(\\lambda x.xx)(\\lambda x.xx)]_\\alpha,\\qquad I\\coloneqq[\\lambda z.z]_\\alpha,\\qquad K\\coloneqq[\\lambda a.\\lambda b.a]_\\alpha,\\qquad N\\coloneqq KI\\Omega.","display":true},{"tex":"\\Omega\\to_\\beta\\Omega,\\qquad N\\to_\\beta N,\\qquad N\\to_\\beta(\\lambda b.I)\\Omega\\to_\\beta I,\\qquad\\mathrm{NF}(\\Lambda,\\to_\\beta,I).","display":true},{"tex":"\\mathrm{WNAt}(\\Lambda,\\to_\\beta,N)\\land\\neg\\mathrm{SNAt}(\\Lambda,\\to_\\beta,N).","display":true},{"tex":"I","display":false},{"tex":"Omega","display":false}],"bytes":1812,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-302","locations":["正文"],"count":2,"excerpt":"[[56-ex-weak-normalization-not-strong.md]]"}],"outgoing":["650401013847f443","d547d7414660f6bd","049c0e933557b214","251992a231a52348","e295b2b3159f2b40"]}