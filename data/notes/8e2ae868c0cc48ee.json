exists\\alpha\\\n\\bigl(\\mathrm{IsGeometricMorphism}(f,\\mathcal E,\\mathbf{Sh}(\\mathcal C,J))\\land\\mathrm{IsNaturalIso}(\\alpha,A,f^*\\circ j_0)\\bigr),\\\\\n\\mathrm{IsGeometricMorphism}(f,\\mathcal E,\\mathbf{Sh}(\\mathcal C,J))\\to\\mathrm{IsContinuousFiltering}(f^*\\circ j_0,\\mathcal C,J,\\mathcal E),\\\\\n\\rho_{f,g}:\\mathrm{Hom}_{\\mathrm{FunCat}(\\mathbf{Sh}(\\mathcal C,J),\\mathcal E)}(f^*,g^*)\\to\n\\mathrm{Hom}_{\\mathrm{FunCat}(\\mathcal C,\\mathcal E)}(f^*\\circ j_0,g^*\\circ j_0),\\\\\n\\rho_{f,g}(\\theta)\\coloneqq\\theta j_0,\\qquad\n\\forall\\alpha\\in\\mathrm{Hom}_{\\mathrm{FunCat}(\\mathcal C,\\mathcal E)}(f^*\\circ j_0,g^*\\circ j_0)\\ \\exists!\\theta\\in\\mathrm{Hom}_{\\mathrm{FunCat}(\\mathbf{Sh}(\\mathcal C,J),\\mathcal E)}(f^*,g^*)\\ (\\rho_{f,g}(\\theta)=\\alpha).\n\\end{gathered}","display":true},{"tex":"R\\otimes_{\\mathcal C}A","display":false},{"tex":"\\mathcal U","display":false},{"tex":"C\\mapsto\\mathrm{Hom}_{\\mathcal E}(A(C),-)","display":false},{"tex":"\\mathcal U","display":false},{"tex":"ay(C)","display":false}],"bytes":3991,"backlinks":[{"id":"c53146be63465990","anchor":"ref-256","locations":["正文"],"count":1,"excerpt":"[[14-thm-continuous-filtering-classification|Theorem — Geometric Morphisms Classified by Continuous Filtering Functors]]"},{"id":"af8af33cef1d96d9","anchor":"ref-102","locations":["正文"],"count":1,"excerpt":"[[14-thm-continuous-filtering-classification]]"},{"id":"4741fef73eb1a614","anchor":"ref-259","locations":["正文"],"count":1,"excerpt":"[[14-thm-continuous-filtering-classification]]"},{"id":"ffda0c0482667c45","anchor":"ref-181","locations":["正文"],"count":1,"excerpt":"[[14-thm-continuous-filtering-classification]]"},{"id":"c60ad289d123497b","anchor":"ref-257","locations":["正文"],"count":1,"excerpt":"[[14-thm-continuous-filtering-classification|Theorem — Geometric Morphisms Classified by Continuous Filtering Functors]]"}],"outgoing":["d70b287bd93237ef","9752b779c5f463f9","4123133f8910827a","99b72d10a7d872f5",