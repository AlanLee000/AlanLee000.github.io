/58-df-zfc-model5-reduct.md\">../batch03/58-df-zfc-model5-reduct.md</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"73eebc6c2f743f18\" href=\"?note=73eebc6c2f743f18\" title=\"../batch19/58-df-zfc-model-omitting-type.md\">../batch19/58-df-zfc-model-omitting-type.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"d81b1b2123168018\" href=\"?note=d81b1b2123168018\" title=\"../batch01/58-df-language.md\">../batch01/58-df-language.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"563f382027630287\" href=\"?note=563f382027630287\" title=\"../batch13/58-df-substructure.md\">../batch13/58-df-substructure.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"64f35ba2e87964e0\" href=\"?note=64f35ba2e87964e0\" title=\"../batch03/58-df-assignment.md\">../batch03/58-df-assignment.md</a></span><span><a class=\"wiki-link\" id=\"ref-9\" data-note=\"44e32f3fb4334e0c\" href=\"?note=44e32f3fb4334e0c\" title=\"../batch17/58-df-logic.md\">../batch17/58-df-logic.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"(\\mathcal K,\\leq_{\\mathcal K})\">\\((\\mathcal K,\\leq_{\\mathcal K})\\)</span> (abstract elementary class)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathcal L\">\\(\\mathcal L\\)</span> (base language) and <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span> (Löwenheim–Skolem number)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcLogic9AbstractElementaryClass}_S\">\\(\\mathrm{ZfcLogic9AbstractElementaryClass}_S\\)</span> (AEC predicate, see <a class=\"wiki-link\" id=\"ref-10\" data-note=\"25b9260c94f77a3a\" href=\"?note=25b9260c94f77a3a\" title=\"../batch11/58-df-zfc-logic9-abstract-elementary-class.md\">../batch11/58-df-zfc-logic9-abstract-elementary-class.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcLogic9LoewenheimSkolemNumber}_S\">\\(\\mathrm{ZfcLogic9LoewenheimSkolemNumber}_S\\)</span> (LS-number predicate, see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"9e0df337ab683f77\" href=\"?note=9e0df337ab683f77\" title=\"../batch04/58-df-zfc-logic9-loewenheim-skolem-number.md\">../batch04/58-df-zfc-logic9-loewenheim-skolem-number.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcModel5Reduct}_S\">\\(\\mathrm{ZfcModel5Reduct}_S\\)</span> (reduct predicate, see <a class=\"wiki-link\" id=\"ref-12\" data-note=\"50f633353aed7a3e\" href=\"?note=50f633353aed7a3e\" title=\"../batch03/58-df-zfc-model5-reduct.md\">../batch03/58-df-zfc-model5-reduct.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcModelOmittingType}_S\">\\(\\mathrm{ZfcModelOmittingType}_S\\)</span> (model-omits-type predicate, see <a class=\"wiki-link\" id=\"ref-13\" data-note=\"73eebc6c2f743f18\" href=\"?note=73eebc6c2f743f18\" title=\"../batch19/58-df-zfc-model-omitting-type.md\">../batch19/58-df-zfc-model-omitting-type.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Language}_S\">\\(\\mathrm{Language}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Sent}_S\">\\(\\mathrm{Sent}_S\\)</span> (language and sentence predicates)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Substructure}_S\">\\(\\mathrm{Substructure}_S\\)</span> (substructure predicate, see <a class=\"wiki-link\" id=\"ref-14\" data-note=\"563f382027630287\" href=\"?note=563f382027630287\" title=\"../batch13/58-df-substructure.md\">../batch13/58-df-substructure.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Satisfaction}_S\">\\(\\mathrm{Satisfaction}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Assign}\">\\(\\mathrm{Assign}\\)</span> (object-level semantic predicates, see <a class=\"wiki-link\" id=\"ref-15\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a> and <a class=\"wiki-link\" id=\"ref-16\" data-note=\"64f35ba2e87964e0\" href=\"?note=64f35ba2e87964e0\" title=\"../batch03/58-df-assignment.md\">../batch03/58-df-assignment.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\operatorname{ModelsTheory}_S\">\\(\\operatorname{ModelsTheory}_S\\)</span> (language-indexed model-of-theory predicate defined below)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\operatorname{HasShelahPresentation}\">\\(\\operatorname{HasShelahPresentation}\\)</span> (predicate defined below)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{SubLanguage}_S\">\\(\\mathrm{SubLanguage}_S\\)</span> 来自 reduct 依赖；<span class=\"math-inline\" data-tex=\"\\mathrm{Symbols}_S\">\\(\\mathrm{Symbols}_S\\)</span> 来自规范语言定义。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}models\\text{-}theory} \\vdash \\operatorname{ModelsTheory}_S(\\mathcal M,T,\\mathcal L)\\leftrightarrow T\\subseteq\\mathrm{Sent}_S(\\mathcal L)\\land\\exists\\operatorname{Val},\\operatorname{Sat}\\;\\Bigl(\\mathrm{Satisfaction}_S(\\mathcal M,\\mathcal L,\\operatorname{Val},\\operatorname{Sat})\\land\\forall\\varphi\\in T\\;\\forall s\\;(\\mathrm{Assign}(\\mathcal M,s)\\to\\operatorname{Sat}(\\varphi,s))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}models\\text{-}theory} \\vdash \\operatorname{ModelsTheory}_S(\\mathcal M,T,\\mathcal L)\\leftrightarrow T\\subseteq\\mathrm{Sent}_S(\\mathcal L)\\land\\exists\\operatorname{Val},\\operatorname{Sat}\\;\\Bigl(\\mathrm{Satisfaction}_S(\\mathcal M,\\mathcal L,\\operatorname{Val},\\operatorname{Sat})\\land\\forall\\varphi\\in T\\;\\forall s\\;(\\mathrm{Assign}(\\mathcal M,s)\\to\\operatorname{Sat}(\\varphi,s))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}presentation\\text{-}theorem}\\vdash{}&amp;\n\\operatorname{HasShelahPresentation}(\\mathcal K,\\leq_{\\mathcal K},\\mathcal L,\\kappa)\\leftrightarrow\n\\mathrm{ZfcLogic9AbstractElementaryClass}_S(\\mathcal K,\\leq_{\\mathcal K},\\mathcal L)\n\\land\\mathrm{ZfcLogic9LoewenheimSkolemNumber}_S(\\kappa,\\mathcal K,\\leq_{\\mathcal K})\\\\\n&amp;\\land\\exists\\mathcal L^*,T^*,\\Gamma\\;\\Bigl(\n\\mathrm{Language}_S(\\mathcal L^*)\\land\\mathrm{SubLanguage}_S(\\mathcal L,\\mathcal L^*)\n\\land T^*\\subseteq\\mathrm{Sent}_S(\\mathcal L^*)\n\\land|\\mathrm{Symbols}_S(\\mathcal L^*)|=\\kappa\\land|\\Gamma|\\leq2^\\kappa\\\\\n&amp;\\quad\\land\\mathcal K=\\Bigl\\{M:\\exists M^*\\;\\bigl(\n\\operatorname{ModelsTheory}_S(M^*,T^*,\\mathcal L^*)\n\\land\\forall p\\in\\Gamma\\;\\mathrm{ZfcModelOmittingType}_S(p,M^*,\\mathcal L^*)\n\\land\\mathrm{ZfcModel5Reduct}_S(\\mathcal L,\\mathcal L^*,M^*,M)\\bigr)\\Bigr\\}\\\\\n&amp;\\quad\\land\\forall M,N\\in\\mathcal K\\;\\Bigl(M\\leq_{\\mathcal K}N\\to\\exists M^*,N^*\\;\\bigl(\n\\mathrm{Substructure}_S(M^*,N^*,\\mathcal L^*)\n\\land\\operatorname{ModelsTheory}_S(M^*,T^*,\\mathcal L^*)\n\\land\\operatorname{ModelsTheory}_S(N^*,T^*,\\mathcal L^*)\\\\\n&amp;\\hspace{9em}\\land\\forall p\\in\\Gamma\\;\\bigl(\n\\mathrm{ZfcModelOmittingType}_S(p,M^*,\\mathcal L^*)\n\\land\\mathrm{ZfcModelOmittingType}_S(p,N^*,\\mathcal L^*)\\bigr)\n\\land\\mathrm{ZfcModel5Reduct}_S(\\mathcal L,\\mathcal L^*,M^*,M)\n\\land\\mathrm{ZfcModel5Reduct}_S(\\mathcal L,\\mathcal L^*,N^*,N)\\bigr)\\Bigr)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}logic9\\text{-}presentation\\text{-}theorem}\\vdash{}&amp;\n\\operatorname{HasShelahPresentation}(\\mathcal K,\\leq_{\\mathcal K},\\mathcal L,\\kappa)\\leftrightarrow\n\\mathrm{ZfcLogic9AbstractElementaryClass}_S(\\mathcal K,\\leq_{\\mathcal K},\\mathcal L)\n\\land\\mathrm{ZfcLogic9LoewenheimSkolemNumber}_S(\\kappa,\\mathcal K,\\leq_{\\mathcal K})\\\\\n&amp;\\land\\exists\\mathcal L^*,T^*,\\Gamma\\;\\Bigl(\n\\mathrm{Language}_S(\\mathcal L^*)\\land\\mathrm{SubLanguage}_S(\\mathcal L,\\mathcal L^*)\n\\land T^*\\subseteq\\mathrm{Sent}_S(\\mathcal L^*)\n\\land|\\mathrm{Symbols}_S(\\mathcal L^*)|=\\kappa\\land|\\Gamma|\\leq2^\\kappa\\\\\n&amp;\\quad\\land\\mathcal K=\\Bigl\\{M:\\exists M^*\\;\\bigl(\n\\operatorname{ModelsTheory}_S(M^*,T^*,\\mathcal L^*)\n\\land\\forall p\\in\\Gamma\\;\\mathrm{ZfcModelOmittingType}_S(p,M^*,\\mathcal L^*)\n\\land\\mathrm{ZfcModel5Reduct}_S(\\mathcal L,\\mathcal L^*,M^*,M)\\bigr)\\Bigr\\}\\\\\n&amp;\\quad\\land\\forall M,N\\in\\mathcal K\\;\\Bigl(M\\leq_{\\mathcal K}N\\to\\exists M^*,N^*\\;\\bigl(\n\\mathrm{Substructure}_S(M^*,N^*,\\mathcal L^*)\n\\land\\operatorname{ModelsTheory}_S(M^*,T^*,\\mathcal L^*)\n\\land\\operatorname{ModelsTheory}_S(N^*,T^*,\\mathcal L^*)\\\\\n&amp;\\hspace{9em}\\land\\forall p\\in\\Gamma\\;\\bigl(\n\\mathrm{ZfcModelOmittingType}_S(p,M^*,\\mathcal L^*)\n\\land\\mathrm{ZfcModelOmittingType}_S(p,N^*,\\mathcal L^*)\\bigr)\n\\land\\mathrm{ZfcModel5Reduct}_S(\\mathcal L,\\mathcal L^*,M^*,M)\n\\land\\mathrm{ZfcModel5Reduct}_S(\\mathcal L,\\mathcal L^*,N^*,N)\\bigr)\\Bigr)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This is the content of Shelah's Presentation Theorem: an AEC is the reduct class of models of a first-order expansion omitting a bounded family of types, with strong embeddings represented by compatible expanded substructures.</li>\n<li>Expanded models are checked by the local <span class=\"math-inline\" data-tex=\"\\operatorname{ModelsTheory}_S\">\\(\\operatorname{ModelsTheory}_S\\)</span> wrapper around the registered satisfaction recursion and assignment predicate; the metalinguistic shorthand <span class=\"math-inline\" data-tex=\"M^*\\models T^*\">\\(M^*\\models T^*\\)</span> is not used as an untyped object-language relation.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch11/58-df-zfc-logic9-abstract-elementary-class.md","status":"resolved","id":"25b9260c94f77a3a","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-zfc-logic9-abstract-elementary-class.md]]","embed":false},{"target":"../batch04/58-df-zfc-logic9-loewenheim-skolem-number.md","status":"resolved","id":"9e0df337ab683f77","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-zfc-logic9-loewenheim-skolem-number.md]]","embed":false},{"target":"../batch03/58-df-zfc-model5-reduct.md","status":"resolved","id":"50f633353aed7a3e","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch03/58-df-zfc-model5-reduct.md]]","embed":false},{"target":"../batch19/58-df-zfc-model-omitting-type.md","status":"resolved","id":"73eebc6c2f743f18","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch19/58-df-zfc-model-omitting-type.md]]","embed":false},{"target":"../batch01/58-df-language.md","status":"resolved","id":"d81b1b2123168018","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch01/58-df-language.md]]","embed":false},{"target":"../batch13/58-df-substructure.md","status":"resolved","id":"563f382027630287","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","head