)\\land\\mathrm{Ordinal}(\\kappa)\\land c:\\kappa\\to\\{\\mathrm{Incomplete},\\mathrm{Complete}\\}\\\\&\\land c(0)=\\mathrm{Incomplete}\\land\\forall\\xi\\in\\kappa\\;(\\xi+1\\in\\kappa\\to c(\\xi+1)\\neq c(\\xi))\\land\\forall\\lambda\\in\\kappa\\;(\\operatorname{Lim}(\\lambda)\\to c(\\lambda)=\\mathrm{Complete})\\\\&\\land\\exists\\sigma\\in V\\;\\Bigl(\\sigma:\\{h\\in V:\\exists\\delta\\in\\kappa\\;(h:\\delta\\to P\\land c(\\delta)=\\mathrm{Complete}\\land\\forall\\xi<\\eta<\\delta\\;h(\\eta)\\leq_Ph(\\xi))\\}\\to P\\\\&\\qquad\\land\\forall h\\in\\operatorname{dom}(\\sigma)\\;\\forall\\xi\\in\\operatorname{dom}(h)\\;(\\sigma(h)\\leq_Ph(\\xi))\\Bigr)\\end{aligned}\\right]","display":true},{"tex":"\\mathrm{Win}_S","display":false}],"bytes":2202,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2123","locations":["正文"],"count":1,"excerpt":"[[../batch12/58-df-zfc-forcing8-strategic-closure.md|58-df-zfc-forcing8-strategic-closure]]（batch12）"}],"outgoing":["a3348ed9eb6fb4e3","b5833df5ef175153","5582a281f15a33c2","36d7463d215be751"]}