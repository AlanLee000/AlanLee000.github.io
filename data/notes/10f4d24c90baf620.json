ingSeqTree}_S(T,X)\n\\leftrightarrow\nT\\subseteq X^{<\\omega}\n\\land\\forall t\\in T\\;\\forall m\\in\\operatorname{dom}(t)+1\\;(t{\\upharpoonright}m\\in T)\n\\land\\forall t\\in T\\;\\mathrm{ZfcCard6FiniteSet}_S(\\operatorname{Succ}_T(t)).","display":true},{"tex":"\\mathrm{prop\\text{-}koenigs\\text{-}lemma}\\vdash\n\\mathrm{FinitelyBranchingSeqTree}_S(T,X)\n\\land\\neg\\mathrm{ZfcCard6FiniteSet}_S(T)\n\\to\\exists b\\;\\bigl(\\mathrm{ZfcFunBranchThroughTree}_S(b,T)\\land\\operatorname{dom}(b)=\\omega\\bigr).","display":true},{"tex":"\\subseteq","display":false}],"bytes":1947,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3971","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-prop-koenigs-lemma.md|58-prop-koenigs-lemma]]（batch17）"}],"outgoing":["4c8fda037173bed0","07554a796c3aa1f5","f4bf86f66c1444da","5045d216c83e75cb","ac1dcd0c905db534"]}