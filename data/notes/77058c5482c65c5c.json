"tex":"E\\subseteq\\mathbb R","display":false},{"tex":"f,\\mu,\\mathcal L,\\mathcal L_E,\\tau_{\\mathbb R}\\in V","display":false},{"tex":"\\mathrm{MeasureSpace}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcMeasure3RealMeasurableFunction}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{Compact}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ContinuousFunction}_S\\subseteq V^5","display":false},{"tex":"\\mathrm{thm\\text{-}lusin} \\vdash\n\\mathrm{MeasureSpace}_S(\\mathbb R,\\mathcal L,\\mu)\\land E\\in\\mathcal L\\land\\mu(E)<\\infty\\land\n\\mathcal L_E=\\{A\\cap E:A\\in\\mathcal L\\}\\land\n\\mathrm{ZfcMeasure3RealMeasurableFunction}_S(E,\\mathcal L_E,f)\n\\to\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists K\\subseteq E\\;\\exists\\tau_K\\in V\\;\\Bigl(\n\\tau_K=\\{U\\cap K:U\\in\\tau_{\\mathbb R}\\}\\land\n\\mathrm{Compact}_S(K,\\tau_K)\\land\\mu(E\\setminus K)<\\varepsilon\\land\n\\mathrm{ContinuousFunction}_S(f\\upharpoonright K,K,\\tau_K,\\mathbb R,\\tau_{\\mathbb R})\\Bigr)","display":true},{"tex":"K","display":false},{"tex":"E","display":false}],"bytes":1741,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4291","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-thm-lusin.md|58-thm-lusin]]（batch14）"}],"outgoing":["83a15c7e9b3817dc","bbbec05fde1d3b01","050f6d05b2c94aea","b2e63b755a37f1dc"]}