utable]]","embed":false},{"target":"93-df-malcev-term","status":"resolved","id":"d57b5a54109bb025","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-malcev-term]]","embed":false},{"target":"93-thm-malcev-term","status":"resolved","id":"172be99586e3e75f","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-thm-malcev-term]]","embed":false},{"target":"93-df-permutable","status":"resolved","id":"b4de3484ad8d9669","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{CPerm}_{93}$ and $\\mathrm{MalcevTerm}_{93}$ are the predicates of [[93-df-permutable]] and [[93-df-malcev-term]].","embed":false},{"target":"93-df-malcev-term","status":"resolved","id":"d57b5a54109bb025","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{CPerm}_{93}$ and $\\mathrm{MalcevTerm}_{93}$ are the predicates of [[93-df-permutable]] and [[93-df-malcev-term]].","embed":false}],"math":[{"tex":"\\tau","display":false},{"tex":"\\mathcal V","display":false},{"tex":"\\tau","display":false},{"tex":"\\mathrm{CPerm}_{93}","display":false},{"tex":"\\mathrm{MalcevTerm}_{93}","display":false},{"tex":"\\mathrm{CPerm}_{93}(\\mathcal V;\\tau)\\leftrightarrow\n\\exists p\\;\\mathrm{MalcevTerm}_{93}(p,\\mathcal V;\\tau)","display":true}],"bytes":872,"backlinks":[],"outgoing":["f0b0edbaa6696a1d","b4de3484ad8d9669","d57b5a54109bb025","172be99586e3e75f"]}