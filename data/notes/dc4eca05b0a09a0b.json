{"id":"dc4eca05b0a09a0b","group":"58","path":"58/batch05/58-df-gauss-sum.md","title":"Gauss Sum","display":"df-gauss-sum — Gauss Sum","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-gauss-sum","aliases":["58-df-gauss-sum"],"display":"df-gauss-sum — Gauss Sum","depends_on":["[[../batch15/58-df-dirichlet-character.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-gauss-sum"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-gauss-sum</span></div>"},{"key":"display","html":"df-gauss-sum — Gauss Sum"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"7101d8e1cbc25a43\" href=\"?note=7101d8e1cbc25a43\" title=\"../batch15/58-df-dirichlet-character.md\">../batch15/58-df-dirichlet-character.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\chi,q,z\\in V\">\\(\\chi,q,z\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{DirichletChar}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{DirichletChar}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"7101d8e1cbc25a43\" href=\"?note=7101d8e1cbc25a43\" title=\"../batch15/58-df-dirichlet-character.md\">../batch15/58-df-dirichlet-character.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{GaussSum}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{GaussSum}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}gauss\\text{-}sum} \\vdash \\mathrm{GaussSum}_S(z,\\chi,q)\\leftrightarrow \\mathrm{DirichletChar}_S(\\chi,q)\\land z\\in\\mathbb C\\land z=\\sum_{a&lt;q}\\chi(a)e^{2\\pi ia/q}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}gauss\\text{-}sum} \\vdash \\mathrm{GaussSum}_S(z,\\chi,q)\\leftrightarrow \\mathrm{DirichletChar}_S(\\chi,q)\\land z\\in\\mathbb C\\land z=\\sum_{a&lt;q}\\chi(a)e^{2\\pi ia/q}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Gauss sums connect characters with finite Fourier transforms.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch15/58-df-dirichlet-character.md","status":"resolved","id":"7101d8e1cbc25a43","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-dirichlet-character.md]]","embed":false},{"target":"../batch15/58-df-dirichlet-character.md","status":"resolved","id":"7101d8e1cbc25a43","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{DirichletChar}_S:V^2\\to\\{\\top,\\bot\\}$ (see [[../batch15/58-df-dirichlet-character.md]])","embed":false}],"math":[{"tex":"\\chi,q,z\\in V","display":false},{"tex":"\\mathrm{DirichletChar}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{GaussSum}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}gauss\\text{-}sum} \\vdash \\mathrm{GaussSum}_S(z,\\chi,q)\\leftrightarrow \\mathrm{DirichletChar}_S(\\chi,q)\\land z\\in\\mathbb C\\land z=\\sum_{a<q}\\chi(a)e^{2\\pi ia/q}","display":true}],"bytes":702,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-574","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-gauss-sum.md|58-df-gauss-sum]]（batch05）"}],"outgoing":["7101d8e1cbc25a43"]}