Gamma\\;(v(\\gamma)=1)\n\\to v(\\varphi)=1\\Bigr).\n\\end{aligned}","display":true}],"bytes":1694,"backlinks":[{"id":"57abb955e28f83aa","anchor":"ref-23","locations":["正文"],"count":1,"excerpt":"[[93-df-two-valued-consequence]]"}],"outgoing":["8181bcdfbad8d73a","e2431dc0f64e0f95","a33dcee0f62c9026","757a95a2c335d9fb","ca7404158049be33"]}