"tex":"\\operatorname{SigmaAlgebra}\\subseteq V^2","display":false},{"tex":"\\sigma","display":false},{"tex":"\\mathrm{IntegrableReal}_S\\subseteq V^4","display":false},{"tex":"\\mathrm{Measurable}_S","display":false},{"tex":"\\mathrm{ZfcMeasure7ConditionalExpectationMap}_S\\subseteq V^6","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}measure7\\text{-}conditional\\text{-}expectation\\text{-}map}\\vdash\n\\mathrm{ZfcMeasure7ConditionalExpectationMap}_S(X,\\mathcal A,\\mathcal G,\\mu,f,g)\\leftrightarrow{}&\n\\mathrm{MeasureSpace}_S(X,\\mathcal A,\\mu)\\land\\mathcal G\\subseteq\\mathcal A\n\\land\\operatorname{SigmaAlgebra}(\\mathcal G,X)\\\\\n&\\land\\mathrm{IntegrableReal}_S(f,X,\\mathcal A,\\mu)\n\\land\\mathrm{IntegrableReal}_S(g,X,\\mathcal A,\\mu)\\\\\n&\\land\\mathrm{Measurable}_S(g;(X,\\mathcal G),(\\mathbb R,\\mathcal B(\\mathbb R)))\n\\land\\forall E\\in\\mathcal G\\;\\left(\\int_Eg\\,d\\mu=\\int_Ef\\,d\\mu\\right).\n\\end{aligned}","display":true},{"tex":"\\mathcal G","display":false}],"bytes":1968,"backlinks":[{"id":"a248f75ff6053b23","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcMeasure7ConditionalExpectationMap}_S:V^6\\to\\{\\top,\\bot\\}$ (see [[../batch13/58-df-zfc-measure7-conditional-expectation-map.md]])"},{"id":"84daad544872cc71","anchor":"ref-2625","locations":["正文"],"count":1,"excerpt":"[[../batch13/58-df-zfc-measure7-conditional-expectation-map.md|58-df-zfc-measure7-conditional-expectation-map]]（batch13）"}],"outgoing":["a3348ed9eb6fb4e3","83a15c7e9b3817dc","a740bdad87b97ac6","d139c8e88761c759"]}