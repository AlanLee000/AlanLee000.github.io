fcForcing3GenericUltrafilter}_S(M,\\mathbb B,\\leq_{\\mathbb B},U)\n\\land\\mathrm{ZfcForcing5BooleanUltrafilterExtension}_S(N,M,\\mathbb B,U)\\\\\n&\\quad\\to\\exists Q,E,\\pi\\in V\\;\\Bigl[\nQ=\\{[\\sigma]_U:\\sigma\\in M\\land\\mathrm{BValuedName}_S(\\sigma,\\mathbb B)\\}\n\\land\\forall\\sigma\\in M\\;\\Bigl(\n\\mathrm{BValuedName}_S(\\sigma,\\mathbb B)\\to\\\\\n&\\qquad [\\sigma]_U=\\{\\tau\\in M:\\mathrm{BValuedName}_S(\\tau,\\mathbb B)\\land\n\\llbracket\\sigma=\\tau\\rrbracket_{\\mathbb B}\\in U\\}\\Bigr)\\\\\n&\\qquad\\land E=\\{\\langle[\\sigma]_U,[\\tau]_U\\rangle\\in Q^2:\n\\llbracket\\sigma\\in\\tau\\rrbracket_{\\mathbb B}\\in U\\}\n\\land\\mathrm{Function}(\\pi,Q,N)\n\\land\\operatorname{ran}(\\pi)=N\\\\\n&\\qquad\\land\\forall\\sigma\\in M\\;\\Bigl(\n\\mathrm{BValuedName}_S(\\sigma,\\mathbb B)\\to\n\\exists x\\in N\\;(\\mathrm{NameEvaluation}_S(x,\\sigma,U,\\mathbb B)\n\\land\\pi([\\sigma]_U)=x)\\Bigr)\\\\\n&\\qquad\\land\\forall a,b\\in Q\\;\\bigl(\\langle a,b\\rangle\\in E\\leftrightarrow\\pi(a)\\in\\pi(b)\\bigr)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"M","display":false},{"tex":"U","display":false},{"tex":"N","display":false}],"bytes":2826,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4049","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-thm-boolean-valued-model.md|58-thm-boolean-valued-model]]（batch15）"},{"id":"7334957c6d59eacc","anchor":"ref-151","locations":["正文"],"count":1,"excerpt":"[[58-thm-0-sharp.md]]\n[[58-thm-L-condensation.md]]\n[[58-thm-L-definability.md]]\n[[58-thm-L-generic-extension.md]]\n[[58-thm-L-is-transitive.md]]\n[[58-thm-L-satisfies-GCH.md]]\n[[58-thm-L-satisfies-ZFC.md]]\n[[58-thm-MM.md]]\n[[58-thm-V-equal-L.md]]\n[[58-thm-V-equals-L.md]]\n[[58-thm-absoluteness-calculation.md]]\n[[58-thm-ac-wellorder-equivalent.md]]\n[[58-thm-aleph-properties.md]]\n[[58-thm-analytic-completeness.md]]\n[[58-thm-analytic-set-properties.md]]\n[[58-thm-baire-category-theory.md]]\n[[58-thm-baire-category.md]]\n[[58-thm-ba