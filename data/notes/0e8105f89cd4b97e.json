,a),a);\\quad(eqrec(tmrefl(a),q),q).\n\\end{aligned}","display":true},{"tex":"→^0_O=Root_O","display":false},{"tex":"M→_O N\\iff\\exists H∈ECtx_O\\ \\exists(L,R)∈Root_O\\ M=plug(H,L)\\land N=plug(H,R)","display":false},{"tex":"ConvertCert_O(E,F)","display":false},{"tex":"M≃_O N\\iff M/N∈Tm\\land ConvertCert_O(M,N)\\ne∅","display":false},{"tex":"NF_O(M)\\iff M∈Tm\\land\\neg\\exists N∈Tm\\ M→_O N","display":false},{"tex":"\\frac{Γ⊢A\\ type\\quad Γ⊢B\\ type}{Γ⊢EqTy(A,B)\\ type}\\qquad\n\\frac{Γ⊢A\\ type\\quad Γ⊢a:A\\quad Γ⊢b:A}{Γ⊢EqTm(A,a,b)\\ type}.","display":true},{"tex":"MotiveData_O(Γ,A,z,C)=(Γ,A,z,C,L)","display":false},{"tex":"Motive_O(Γ,A)","display":false},{"tex":"\\mathsf{EqTyRefl}_{O}\n=\n\\{((\\Gamma\\vdash A\\ \\mathsf{type}),\\Gamma\\vdash\\operatorname{tyrefl}(A):\\operatorname{EqTy}(A,A))\\},","display":true},{"tex":"\\mathsf{EqTmRefl}_{O}\n=\n\\{((\\Gamma\\vdash a:A),\\Gamma\\vdash\\operatorname{tmrefl}(a):\\operatorname{EqTm}(A,a,a))\\}.","display":true},{"tex":"\\mathsf{EqTyTrans}_{O}\n=\\{((\\Gamma\\vdash p:\\operatorname{EqTy}(A,B),\n\\Gamma\\vdash q:\\operatorname{EqTy}(B,C)),\n\\Gamma\\vdash\\operatorname{tytrans}(p,q):\\operatorname{EqTy}(A,C))\\},","display":true},{"tex":"\\mathsf{EqTmTrans}_{O}\n=\\{((\\Gamma\\vdash p:\\operatorname{EqTm}(A,a,b),\n\\Gamma\\vdash q:\\operatorname{EqTm}(A,b,c)),\n\\Gamma\\vdash\\operatorname{tmtrans}(p,q):\\operatorname{EqTm}(A,a,c))\\}","display":true},{"tex":"\\mathsf{CoeRule}_{O}\n=\n\\{((\\Gamma\\vdash p:\\operatorname{EqTy}(A,B),\\Gamma\\vdash a:A),\n\\Gamma\\vdash\\operatorname{coe}(p,a):B)\\},","display":true},{"tex":"\\mathsf{CoeRefl}_{O}\n=\n\\{((\\Gamma\\vdash a:A),\n\\Gamma\\vdash\\operatorname{coe}(\\operatorname{tyrefl}(A),a)\\equiv a:A)\\}.","display":true},{"tex":"\\frac{Γ,z:A⊢C\\ type\\quad Γ⊢p:EqTm(A,a,b)\\quad Γ⊢q:C[z:=a]}{Γ⊢eqrec(p,q):C[z:=b]},","display":true},{"tex":"\\frac{Γ,z:A⊢C\\ type\\quad Γ⊢a:A\\quad Γ⊢q:C[z:=a]}{Γ⊢eqrec(tmrefl(a),q)≡q:C[z:=a]}.","display":true},{"tex":"ObsReflection=\