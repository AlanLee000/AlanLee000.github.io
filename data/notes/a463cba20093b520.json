,"display":true},{"tex":"\\mathrm{df\\text{-}correlation} \\vdash\n\\mathrm{Correlation}_S(r,X,Y;\\Omega,\\mathcal F,\\mathbb P)\\leftrightarrow\n\\exists c,v_X,v_Y\\in\\mathbb R\\;\\Bigl(\n\\mathrm{Covariance}_S(c,X,Y;\\Omega,\\mathcal F,\\mathbb P)\\land\n\\mathrm{Variance}_S(v_X,X;\\Omega,\\mathcal F,\\mathbb P)\\land\n\\mathrm{Variance}_S(v_Y,Y;\\Omega,\\mathcal F,\\mathbb P)\\land\nv_X>0\\land v_Y>0\\land r=\\frac{c}{\\sqrt{v_Xv_Y}}\n\\Bigr)","display":true},{"tex":"\\mathrm{Cov}(X, Y) = 0","display":false},{"tex":"\\Sigma_{ij} = \\mathrm{Cov}(X_i, X_j)","display":false},{"tex":"L^2","display":false}],"bytes":2937,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-376","locations":["正文"],"count":1,"excerpt":"[[../batch16/58-df-covariance.md|58-df-covariance]]（batch16）"}],"outgoing":["0578a357a86e9d8f","2e4ee9615831113b","bbbec05fde1d3b01","4884f45058a56aac","36d7463d215be751"]}