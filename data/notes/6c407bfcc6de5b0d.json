{"id":"6c407bfcc6de5b0d","group":"29","path":"29/29-df-substructure.md","title":"子结构","display":"df-substructure — 子结构","type":"definition","metadata":{"type":"definition","book":"Descriptive Complexity (Neil Immerman)","book_abbrev":"29","label":"29-df-substructure","aliases":["29-df-substructure"],"display":"df-substructure — 子结构","depends_on":["[[29-df-struc]]","[[29-df-vocab]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Descriptive Complexity (Neil Immerman)"},{"key":"book_abbrev","html":"29"},{"key":"label","html":"29-df-substructure"},{"key":"aliases","html":"<div class=\"property-array\"><span>29-df-substructure</span></div>"},{"key":"display","html":"df-substructure — 子结构"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4de8e0c8085801f5\" href=\"?note=4de8e0c8085801f5\" title=\"29-df-struc\">29-df-struc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"28e86a5f0243a0ae\" href=\"?note=28e86a5f0243a0ae\" title=\"29-df-vocab\">29-df-vocab</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\tau=\\langle R_1^{(a_1)},\\ldots,R_r^{(a_r)},c_1,\\ldots,c_s,f_1^{(r_1)},\\ldots,f_t^{(r_t)}\\rangle\\in\\mathrm{Vocabulary}\">\\(\\tau=\\langle R_1^{(a_1)},\\ldots,R_r^{(a_r)},c_1,\\ldots,c_s,f_1^{(r_1)},\\ldots,f_t^{(r_t)}\\rangle\\in\\mathrm{Vocabulary}\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"28e86a5f0243a0ae\" href=\"?note=28e86a5f0243a0ae\" title=\"29-df-vocab\">29-df-vocab</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"A,B\\in\\mathrm{STRUC}[\\tau]\">\\(A,B\\in\\mathrm{STRUC}[\\tau]\\)</span> (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"4de8e0c8085801f5\" href=\"?note=4de8e0c8085801f5\" title=\"29-df-struc\">29-df-struc</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\m