p Rule_{\\neg\\Diamond}^{N}\n\\cup Rule_{\\Box}^{N}\\cup Rule_{\\Diamond}^{N}.","display":true},{"tex":"\\operatorname{Tree}_{N}","display":false},{"tex":"\\operatorname{NodeOK}_{N}","display":false},{"tex":"\\operatorname{Path}_{\\prec}(q,u,v)\n\\Longleftrightarrow\n\\exists k\\in\\mathbb N\\,\n\\bigl(k>0\\land q:k\\to\\{u,v\\}\\cup\\operatorname{dom}(\\prec)\\cup\\operatorname{rng}(\\prec)\n\\land q(0)=u\\land q(k-1)=v\n\\land \\forall i+1<k\\ q(i)\\prec q(i+1)\\bigr).","display":true},{"tex":"\\operatorname{RootedTree}(N_0,r,\\prec)\n\\Longleftrightarrow\n\\prec\\subseteq N_0\\times N_0\\land r\\in N_0\n\\land \\forall n\\in N_0\\,\\exists!q\\,\\operatorname{Path}_{\\prec}(q,r,n).","display":true},{"tex":"\\operatorname{ch}_{\\prec}(n)=\\{m\\in\\operatorname{dom}(\\prec)\\cup\\operatorname{rng}(\\prec):n\\prec m\\},\n\\qquad\n\\operatorname{leaf}_{\\prec}(n)\\Longleftrightarrow \\operatorname{ch}_{\\prec}(n)=\\varnothing.","display":true},{"tex":"\\operatorname{Tree}_{N}(N_0,r,\\prec,\\lambda)\n\\Longleftrightarrow\nN_0\\subseteq_{\\mathrm{fin}}\\mathbb N\\land r\\in N_0\\land\n\\operatorname{RootedTree}(N_0,r,\\prec)\\land \\lambda:N_0\\to NSeq.","display":true},{"tex":"Prem_{N}(N_0,\\prec,\\lambda,n)","display":false},{"tex":"e_n:k_n\\to\\operatorname{ch}_{\\prec}(n)","display":false},{"tex":"k_n=|\\operatorname{ch}_{\\prec}(n)|","display":false},{"tex":"Prem_{N}(N_0,\\prec,\\lambda,n):k_n\\to\\operatorname{rng}(\\lambda)","display":false},{"tex":"i","display":false},{"tex":"\\lambda(e_n(i))","display":false},{"tex":"\\operatorname{NodeOK}_{N}(N_0,\\prec,\\lambda,n)\n\\Longleftrightarrow\nn\\in N_0\\land\n\\bigl((\\operatorname{leaf}_{\\prec}(n)\\land\\lambda(n)\\in Ax_N)\n\\lor(Prem_{N}(N_0,\\prec,\\lambda,n),\\lambda(n))\\in Rule_N\\bigr).","display":true},{"tex":"\\operatorname{Tree}_{N}","display":false},{"tex":"\\operatorname{Der}_{N}(N_0,r,\\prec,\\lambda)\n\\Longleftrightarrow\n\\operatorname{Tree}_{N}(N_0,r,\\prec,\\lambda)\\land\n\\forall n\\in N_0\\ \