}_{A}\\cup\\mathsf{WithE1}_{A}\\cup\\mathsf{WithE2}_{A}.","display":true},{"tex":"\\to^0_A","display":false},{"tex":"(\\lambda^a x.M)N\\to_A M[N/x],","display":true},{"tex":"\\mathsf{letTensor}(x,y,M\\otimes N,P)\\to_A P[M/x][N/y],","display":true},{"tex":"\\mathsf{fst}_{\\&}(\\langle M,N\\rangle_{\\&})\\to_A M,\\qquad \\mathsf{snd}_{\\&}(\\langle M,N\\rangle_{\\&})\\to_A N.","display":true},{"tex":"\\mathsf{Red}^{\\beta}_{A}=\\{((\\lambda^a x.M)N,M[N/x]):x\\in\\mathsf{Var}_{A},\\ M,N\\in\\mathsf{Tm}_{A}\\},","display":true},{"tex":"\\mathsf{Red}^{\\otimes}_{A}=\\{(\\mathsf{letTensor}(x,y,M\\otimes N,P),P[M/x][N/y]):x,y\\in\\mathsf{Var}_{A},\\ M,N,P\\in\\mathsf{Tm}_{A}\\},","display":true},{"tex":"\\mathsf{Red}^{\\&}_{A}=\\{(\\mathsf{fst}_{\\&}(\\langle M,N\\rangle_{\\&}),M),(\\mathsf{snd}_{\\&}(\\langle M,N\\rangle_{\\&}),N):M,N\\in\\mathsf{Tm}_{A}\\}.","display":true},{"tex":"\\mathsf{RedCtx}_{A}","display":false},{"tex":"\\Box","display":false},{"tex":"\\lambda^a x.C","display":false},{"tex":"CP","display":false},{"tex":"PC","display":false},{"tex":"C\\otimes P","display":false},{"tex":"P\\otimes C","display":false},{"tex":"\\mathsf{letTensor}(x,y,C,P)","display":false},{"tex":"\\mathsf{letTensor}(x,y,P,C)","display":false},{"tex":"\\langle C,P\\rangle_{\\&}","display":false},{"tex":"\\langle P,C\\rangle_{\\&}","display":false},{"tex":"\\mathsf{fst}_{\\&}(C)","display":false},{"tex":"\\mathsf{snd}_{\\&}(C)","display":false},{"tex":"M\\to_A N\n\\Longleftrightarrow\n\\exists C,P,Q\\,\n(C\\in\\mathsf{RedCtx}_{A}\\land (P,Q)\\in\\to^0_A\\land M=C[P]\\land N=C[Q]).","display":true},{"tex":"T","display":false},{"tex":"\\ell:T\\to\\mathsf{Jud}_{A}","display":false},{"tex":"\\mathsf{Rule}_{A}","display":false},{"tex":"\\Delta\\vdash M:A","display":false},{"tex":"\\Delta\\vdash_A M:A","display":false},{"tex":"\\mathsf{AxJdg}_{A}\n=\n\\{\\varnothing\\vdash b\\ \\mathsf{type}:b\\in\\mathsf{Base}_{A}\\}\n\\cup\n\\{\\Delta\\vdash x:A:x:A\\in\\Delta\\}.","display":true},{"tex":"\\mathsf{AxJdg}_{A}","display":false},{"tex":"\\mathsf{Rule}_{A}","display":false},{"tex":"\\mathsf{Der}_{A}\n=\n\\{(T,r,\\ell):T\\text{ 是非空有限有根树},r\\in T,\\ell:T\\to\\mathsf{Jud}_{A},\n\\text{ 且每个节点的子节点列与节点标记属于 }\\mathsf{Rule}_{A}\\}.","display":true},{"tex":"\\mathsf{Delta}_{A}\n=\n(\\preceq_A,\\mathbin{\\#}_{A},\\mathsf{Drop}_{A},\\mathsf{RedCtx}_{A},\\multimap,\\otimes,\\mathbf 1,\\&,\\to^0_A).","display":true},{"tex":"\\preceq_A","display":false},{"tex":"\\mathbb U_A=(\\{0,1\\},0,\\oplus_A,\\le_A),qquad\n0\\oplus_Au=u\\oplus_A0=u,","display":true},{"tex":"1\\oplus_A1","display":false},{"tex":"0\\le_A1","display":false},{"tex":"\\operatorname{Use}_{A}(M)(x)=\n\\begin{cases}1,&x\\in\\operatorname{FV}_{A}(M),\\\\0,&x\\notin\\operatorname{FV}_{A}(M).\n\\end{cases}","display":true},{"tex":"\\Delta_1\\mathbin{\\#}_{A}\\Delta_2\\preceq_A\\Delta\n\\Longleftrightarrow\n\\forall x\\in\\operatorname{dom}(\\Delta)\\ \n\\chi_{\\Delta_1}(x)\\oplus_A\\chi_{\\Delta_2}(x)\n\\text{ 有定义且 }\\le_A\\chi_\\Delta(x).","display":true},{"tex":"\\mathsf{SplitCert}_{A}(\\Delta,\\Delta_1,\\Delta_2)","display":false},{"tex":"1\\oplus_A1","display":false},{"tex":"\\mathsf{DropCert}_{A}(\\Delta,\\Delta',M)","display":false},{"tex":"x:B","display":false},{"tex":"x\\notin\\operatorname{FV}_{A}(M)","display":false},{"tex":"\\Delta,\\Delta'","display":false},{"tex":"\\mathsf{Drop}_{A}(\\Delta,\\Delta',M)\n\\Longleftrightarrow\n\\exists C\\in\\mathsf{DropCert}_{A}(\\Delta,\\Delta',M).","display":true},{"tex":"\\mathsf{DropRule}_{A}","display":false},{"tex":"\\Delta\\vdash_A M:B\n\\Longleftrightarrow\n\\exists(T,r,\\ell)\\in\\mathsf{Der}_{A}\\ (\\ell(r)=\\Delta\\vdash M:B).","display":true},{"tex":"\\mathsf{DropCert}_{A}","display":false},{"tex":"\\mathsf{Rule}_{A}","display":false},{"tex":"\\mathcal{ATT}=(\\mathsf{Var}_{A},\\mathsf{Base}_{A},\\mathsf{Ty}_{A},\\mathsf{Tm}_{A},\\mathsf{ACtx}_{A},\n\\mathbb U_A,\\oplus_A,\\operatorname{Use}_{A},\\mathsf{SplitCert}_{A},\\mathsf{DropCert}_{A},\n\\pre