A):\\Delta'\\preceq_A\\Delta\\},\\quad\nRawDrop=\\{((\\Delta\\vdash M:A),\\Delta'\\vdash M:A):Drop_A(\\Delta,\\Delta',M)\\},","display":true},{"tex":"RawLam=\\{((\\Delta,x:A\\vdash M:B),\\Delta\\vdash\\lambda^a x.M:A\\multimap B)\\},","display":true},{"tex":"RawApp=\\{((\\Delta_1\\vdash M:A\\multimap B,\\Delta_2\\vdash N:A),\\Delta\\vdash MN:B):\\Delta_1\\#_A\\Delta_2\\preceq_A\\Delta\\},","display":true},{"tex":"RawTensorI=\\{((\\Delta_1\\vdash M:A,\\Delta_2\\vdash N:B),\\Delta\\vdash M\\otimes N:A\\otimes B):\\Delta_1\\#_A\\Delta_2\\preceq_A\\Delta\\},","display":true},{"tex":"RawTensorE=\\{((\\Delta_1\\vdash M:A\\otimes B,\\Delta_2,x:A,y:B\\vdash N:C),\\Delta\\vdash letTensor(x,y,M,N):C):\\Delta_1\\#_A\\Delta_2\\preceq_A\\Delta\\},","display":true},{"tex":"RawWithI=\\{((\\Delta\\vdash M:A,\\Delta\\vdash N:B),\\Delta\\vdash\\langle M,N\\rangle_{\\&}:A\\&B)\\},","display":true},{"tex":"RawWithE1=\\{((\\Delta\\vdash M:A\\&B),\\Delta\\vdash fst_{\\&}(M):A)\\},\\quad\nRawWithE2=\\{((\\Delta\\vdash M:A\\&B),\\Delta\\vdash snd_{\\&}(M):B)\\}.","display":true},{"tex":"Red_A^\\beta=\\{((\\lambda^a x.M)N,M[x:=N]):x\\in Var,M,N\\in Tm\\},","display":true},{"tex":"Red_A^\\otimes=\\{(letTensor(x,y,M\\otimes N,P),PSub(P,(x,y),(M,N))):x,y\\in Var,x\\ne y,M,N,P\\in Tm\\},","display":true},{"tex":"Red_A^{\\&}=\\{(fst_{\\&}(\\langle M,N\\rangle_{\\&}),M),(snd_{\\&}(\\langle M,N\\rangle_{\\&}),N):M,N\\in Tm\\},\n\\quad\\to_A^0=Red_A^\\beta\\cup Red_A^\\otimes\\cup Red_A^{\\&}.","display":true},{"tex":"plug_A:RedCtx_A\\times Tm\\to Tm","display":false},{"tex":"M\\to_A N\\Longleftrightarrow\\exists C\\in RedCtx_A\\ \\exists(P,Q)\\in\\to_A^0\\\n(M=plug_A(C,P)\\land N=plug_A(C,Q)).","display":true},{"tex":"\\mathbb U_A=(\\{0,1\\},0,\\oplus_A,\\le_A),\\qquad\n\\operatorname{dom}(\\oplus_A)=\\{(0,0),(0,1),(1,0)\\},","display":true},{"tex":"0\\oplus_A0=0,\\quad0\\oplus_A1=1,\\quad1\\oplus_A0=1,\\qquad\n\\le_A=\\{(0,0),(0,1),(1,1)\\}.","display":true},{"tex":"(x,A_0,A_1,A_2,a_0,a_1,a_2,s),","display":true},{"tex":"A_0=type_\\Delta(x)","display":false},{"tex":"A_j=type_{\\Delta_j}(x)","display":false},{"tex":"a_0=\\chi_\\Delta(x)","display":false},{"tex":"a_j=\\chi_{\\Delta_j}(x)","display":false},{"tex":"s=a_1\\oplus_Aa_2","display":false},{"tex":"s\\le_Aa_0","display":false},{"tex":"\\Delta_1\\#_A\\Delta_2\\preceq_A\\Delta\n\\Longleftrightarrow SplitCert_A(\\Delta,\\Delta_1,\\Delta_2)\\ne\\varnothing.","display":true},{"tex":"(x,A,A',a,a',m),","display":true},{"tex":"a'\\le_Aa","display":false},{"tex":"m\\le_Aa'","display":false},{"tex":"Drop_A(\\Delta,\\Delta',M)\\Longleftrightarrow DropCert_A(\\Delta,\\Delta',M)\\ne\\varnothing.","display":true},{"tex":"Rule_A=\\{(\\vec J,J):\\exists w\\in W\\ (\\vec J,J,w)\\in RuleInst_A\\}.","display":true},{"tex":"AxJdg_A=\\{term(\\Delta,x,A):\\Delta\\in ACtx,x:A\\in\\Delta\\}\\cup\\{term(\\Delta,\\star,\\mathbf1):\\Delta\\in ACtx\\}.","display":true},{"tex":"P\\subseteq\\mathbb N^{<\\omega}","display":false},{"tex":"p^\\frown q\\in P\\Rightarrow p\\in P","display":false},{"tex":"p^\\frown\\langle i\\rangle\\in P\\Rightarrow\\forall j<i\\ p^\\frown\\langle j\\rangle\\in P","display":false},{"tex":"Der_A=\\{(P,\\ell,\\omega):P\\in TreeDom_A,\\ell:P\\to Jud_A,\\omega:P\\to W,\n\\forall p\\in P\\ ((\\ell(q))_{q\\in ch_P(p)},\\ell(p),\\omega(p))\\in RuleInst_A\\},","display":true},{"tex":"root(P,\\ell,\\omega)=\\ell(\\epsilon),\\qquad\n\\Delta\\vdash_A M:B\\Longleftrightarrow\\exists D\\in Der_A\\quad root(D)=term(\\Delta,M,B).","display":true},{"tex":"M'\\equiv_\\alpha^A M[x:=N]","display":false},{"tex":"Delta_A=(\\preceq_A,\\#_A,Live_A,Drop_A,SplitCert_A,DropCert_A,RedCtx_A,\\multimap,\\otimes,\\mathbf1,\\&,\\to_A^0),","display":true},{"tex":"\\begin{aligned}\n\\mathcal{ATT}=(&Var_A,Base_A,Ty_A,Tm_A,ACtx_A,dom,Jud_A,base,\\preceq_A,\\#_A,\nchild_A,bind,FV_A,BV_A,fresh_A,Sub_A,BSub_A,BSub2_A,PSub,PRen,\\equiv_\\alpha^A,\\\\\n&\\mathbb U_A,\\oplus_A,\\le_A,Use_A,\\chi,type_\\Delta,Live_A,Drop_A,SplitCert_A,DropCert