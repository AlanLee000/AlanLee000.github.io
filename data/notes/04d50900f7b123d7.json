operatorname{SeriesNeg}_\\epsilon(a)\\coloneqq\\{\\langle n,c\\rangle\\in\\mathbb Z\\times A:+\\!(\\langle a(n),c\\rangle)=0_A\\}","display":true},{"tex":"\\mathrm{df\\text{-}renormalization\\text{-}minimal\\text{-}subtraction} \\vdash \\operatorname{MinimalSubtraction}_S(F,F_{\\mathrm{ren}};A,+,\\cdot,0_A,1_A,\\epsilon)\\leftrightarrow\\operatorname{CommutativeRing}_S(A,+,\\cdot,0_A,1_A)\\land F\\in\\operatorname{Laurent}_S(A,+,\\cdot,0_A,1_A;\\epsilon)\\land F_{\\mathrm{ren}}=\\operatorname{FinitePart}_\\epsilon(F)","display":true},{"tex":"\\mathrm{df\\text{-}renormalization\\text{-}counterterm} \\vdash \\operatorname{CountertermRenormalized}_S(\\mathcal L_{\\mathrm{reg}},\\mathcal L_{\\mathrm{ct}},\\mathcal L_{\\mathrm{ren}};A,+,\\cdot,0_A,1_A,\\epsilon)\\leftrightarrow\\operatorname{CommutativeRing}_S(A,+,\\cdot,0_A,1_A)\\land\\mathcal L_{\\mathrm{reg}}\\in\\operatorname{Laurent}_S(A,+,\\cdot,0_A,1_A;\\epsilon)\\land\\mathcal L_{\\mathrm{ct}}=\\operatorname{SeriesNeg}_\\epsilon(\\operatorname{PolePart}_\\epsilon(\\mathcal L_{\\mathrm{reg}}))\\land\\mathcal L_{\\mathrm{ren}}=\\operatorname{FinitePart}_\\epsilon(\\operatorname{SeriesAdd}_\\epsilon(\\mathcal L_{\\mathrm{reg}},\\mathcal L_{\\mathrm{ct}}))","display":true},{"tex":"\\mathbb Z\\to A","display":false}],"bytes":4202,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1073","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-renormalization.md|58-df-renormalization]]（batch03）"}],"outgoing":["1c30d21ea7b443f6","36d7463d215be751"]}