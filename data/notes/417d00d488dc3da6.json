athrm{Sub}_S","display":false},{"tex":"\\mathrm{Fml}_S^{(1)}","display":false},{"tex":"\\mathrm{Fml}_S^{(1)}[\\langle v\\rangle]","display":false},{"tex":"g,d,S","display":false},{"tex":"\\mathrm{thm\\text{-}smullyan\\text{-}diagonal}\\ \\vdash\\\n\\mathrm{GN}_{\\operatorname{Expr}(S)}(g,d)\\Longrightarrow\n\\operatorname{SmDiag}(e)\n=\\mathrm{Sub}_S(e,e)\n=g\\bigl(\\varphi[\\overline e/v]\\bigr).","display":true}],"bytes":1694,"backlinks":[{"id":"32c1f47762a7f658","anchor":"ref-132","locations":["正文"],"count":1,"excerpt":"[[90-thm-diagonal-closure.md]]\n[[90-thm-diagonal-lemma-formal.md]]\n[[90-thm-first-incompleteness.md]]\n[[90-thm-fixed-point-algorithm.md]]\n[[90-thm-kleene-second-recursion.md]]\n[[90-thm-min-closure-rec.md]]\n[[90-thm-myhill-operator.md]]\n[[90-thm-recursion-theorem.md]]\n[[90-thm-recursive-set-representation.md]]\n[[90-thm-second-incompleteness.md]]\n[[90-thm-smullyan-diagonal.md]]\n[[90-thm-tarski-undefinability.md]]"}],"outgoing":["fb8a113c2891ff19","72adf94db165e486","7279c20158ac140e","b86b211a75cf1748","d53b945955293235","4ce2b2789d377e1f"]}