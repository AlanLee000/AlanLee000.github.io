l E)","display":false},{"tex":"\\varphi_e","display":false},{"tex":"\\mathrm{RECURSIVE}_{\\mathbb N}","display":false},{"tex":"\\mathrm{RE}","display":false},{"tex":"\\sqcup\\notin\\mathbf2\\cup\\{\\varepsilon\\}","display":false},{"tex":"\\beta","display":false},{"tex":"\\mathrm{thm\\text{-}5.4}\\vdash\n\\forall\\mathcal C\\subseteq\\mathrm{RE}\\;\n\\bigl((\\mathcal C\\ne\\emptyset\\land\\mathcal C\\ne\\mathrm{RE})\\to\n\\{e\\in\\mathbb N:L(\\varphi_e)\\in\\mathcal C\\}\\notin\\mathrm{RECURSIVE}_{\\mathbb N}\\bigr)","display":true}],"bytes":2067,"backlinks":[],"outgoing":["6759b2502900015f","219767ec839d8c84","1d543e6e6f293638","db96cabedd089e5f","e0b452dd8be3146b"]}