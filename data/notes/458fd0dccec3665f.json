std}},S,\\tau_S)\n\\land\\mathrm{Compact}_S(S,\\tau_S)\\bigr)\n\\end{aligned}\n\\right\\}","display":true},{"tex":"\\mathcal{D}(\\Omega) = C_c^\\infty(\\Omega)","display":false},{"tex":"\\Omega","display":false},{"tex":"\\Omega","display":false},{"tex":"\\mathbb R^n","display":false},{"tex":"\\operatorname{supp}","display":false},{"tex":"\\Subset","display":false},{"tex":"\\mathcal D'(\\Omega)","display":false},{"tex":"\\delta","display":false},{"tex":"1/x","display":false},{"tex":"H","display":false},{"tex":"T'[\\phi] = -T[\\phi']","display":false}],"bytes":2709,"backlinks":[{"id":"70a18be302d94faf","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"c53fe47de39217ed","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\Omega$ is open in the Euclidean topology and $\\mathcal D(\\Omega)=C_c^\\infty(\\Omega,\\mathbb R)$ (see [[58-df-test-function]])"},{"id":"70d7a97bd7315c54","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"bc125fa84031840f","anchor":"ref-6","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e23ce64dcd9dfdbf","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\chi\\in\\mathcal D(\\Omega)$ (cutoff function, see [[58-df-test-function]])"},{"id":"03ca577eb4c1b05e","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$C_c^\\infty(\\Omega)\\subseteq V$ (test-function space, see [[../batch06/58-df-test-function.md]])"},{"id":"a1f6d4733dbaf832","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1290","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-test-function.md|58-df-test-function]]（batch06）"}],"outgoing":["17de8347f6f91384","edc520f758b19264","ba4e1ea7e4f4dbef","3482d3dfe87a8b71","050f6d05b2c94aea","ca7fc3ab38a11801"]}