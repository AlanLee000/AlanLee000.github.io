{"id":"1360db13be12aa41","group":"58","path":"58/batch14/58-df-zfc-top3-accumulation-point.md","title":"ZFC Top3 Accumulation Point","display":"df-zfc-top3-accumulation-point — ZFC Top3 Accumulation Point","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-top3-accumulation-point","aliases":["58-df-zfc-top3-accumulation-point"],"display":"df-zfc-top3-accumulation-point — ZFC Top3 Accumulation Point","depends_on":["[[./58-df-topology.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-top3-accumulation-point"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-top3-accumulation-point</span></div>"},{"key":"display","html":"df-zfc-top3-accumulation-point — ZFC Top3 Accumulation Point"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"e7514bc4cefba4f2\" href=\"?note=e7514bc4cefba4f2\" title=\"./58-df-topology.md\">58-df-topology.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,A,x\\in V\">\\(X,\\tau,A,x\\in V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Top}\\subseteq V^2\">\\(\\mathrm{Top}\\subseteq V^2\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"e7514bc4cefba4f2\" href=\"?note=e7514bc4cefba4f2\" title=\"./58-df-topology.md\">58-df-topology.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop3AccumulationPoint}_S\\subseteq V^4\">\\(\\mathrm{ZfcTop3AccumulationPoint}_S\\subseteq V^4\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top3\\text{-}accumulation\\text{-}point} \\vdash\n\\mathrm{ZfcTop3AccumulationPoint}_S(X,\\tau,A,x)\\leftrightarrow\n\\mathrm{Top}(\\tau,X)\\land x\\in X\\land A\\subseteq X\\land\n\\forall U\\in\\tau\\;(x\\in U\\to U\\cap(A\\setminus\\{x\\})\\neq\\emptyset)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top3\\text{-}accumulation\\text{-}point} \\vdash\n\\mathrm{ZfcTop3AccumulationPoint}_S(X,\\tau,A,x)\\leftrightarrow\n\\mathrm{Top}(\\tau,X)\\land x\\in X\\land A\\subseteq X\\land\n\\forall U\\in\\tau\\;(x\\in U\\to U\\cap(A\\setminus\\{x\\})\\neq\\emptyset)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"./58-df-topology.md","status":"resolved","id":"e7514bc4cefba4f2","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[./58-df-topology.md]]","embed":false},{"target":"./58-df-topology.md","status":"resolved","id":"e7514bc4cefba4f2","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Top}\\subseteq V^2$ (see [[./58-df-topology.md]]).","embed":false}],"math":[{"tex":"X,\\tau,A,x\\in V","display":false},{"tex":"\\mathrm{Top}\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcTop3AccumulationPoint}_S\\subseteq V^4","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}top3\\text{-}accumulation\\text{-}point} \\vdash\n\\mathrm{ZfcTop3AccumulationPoint}_S(X,\\tau,A,x)\\leftrightarrow\n\\mathrm{Top}(\\tau,X)\\land x\\in X\\land A\\subseteq X\\land\n\\forall U\\in\\tau\\;(x\\in U\\to U\\cap(A\\setminus\\{x\\})\\neq\\emptyset)","display":true}],"bytes":811,"backlinks":[{"id":"3a026a1ab9db16e8","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"dd02c0953f5eface","anchor":"ref-2","locations":["元数据 · depend