mathcal C_n(\\lfloor\\epsilon^2S/(100n)\\rfloor)\\;\\sum_{x:\\operatorname{out}_C(x)_1=f(x)}H(x)\\le\\frac12+\\epsilon].\\end{aligned}","display":true}],"bytes":2771,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-377","locations":["正文"],"count":1,"excerpt":"[[28-df-reed-muller-code]]、[[28-thm-reed-muller-distance]]、[[28-df-list-decodable-code]]、[[28-df-local-decoder]]、[[28-thm-berlekamp-welch-decoding]]、[[28-lem-hardcore-distribution]]、[[28-df-local-list-decoder]]。"}],"outgoing":["7776a98a623ada8d","14f69cc09dc02600"]}