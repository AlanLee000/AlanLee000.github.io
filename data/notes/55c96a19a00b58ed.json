si))\\}\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}analytical\\text{-}hierarchy\\text{-}pi}\\vdash\\forall n\\in\\omega\\;\\left(\\Pi^1_{n+1}=\\{\\varphi\\in\\mathrm{Fml}_S^2:\\exists\\psi\\in\\Sigma^1_n\\;\\exists q\\in\\omega_{&gt;0}\\;\\exists s\\in\\omega^q\\;\\mathrm{Equivalent}_2(\\varphi,\\mathrm{AllBlock}_2(s,\\psi))\\}\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}analytical\\text{-}hierarchy\\text{-}pi}\\vdash\\forall n\\in\\omega\\;\\left(\\Pi^1_{n+1}=\\{\\varphi\\in\\mathrm{Fml}_S^2:\\exists\\psi\\in\\Sigma^1_n\\;\\exists q\\in\\omega_{&gt;0}\\;\\exists s\\in\\omega^q\\;\\mathrm{Equivalent}_2(\\varphi,\\mathrm{AllBlock}_2(s,\\psi))\\}\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}analytical\\text{-}hierarchy\\text{-}delta}\\vdash\\forall n\\in\\omega\\;(\\Delta^1_n=\\Sigma^1_n\\cap\\Pi^1_n)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}analytical\\text{-}hierarchy\\text{-}delta}\\vdash\\forall n\\in\\omega\\;(\\Delta^1_n=\\Sigma^1_n\\cap\\Pi^1_n)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}recursion3\\text{-}analytical\\text{-}hierarchy\\text{-}level} \\vdash \\mathrm{ZfcRecursion3AnalyticalHierarchyLevel}_S(n,\\Gamma)\\leftrightarrow n\\in\\omega\\land \\Gamma\\in\\{\\Sigma^1_n,\\Pi^1_n,\\Delta^1_n\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}recursion3\\tex