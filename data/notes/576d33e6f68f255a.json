q_P))\n\\to\\exists m\\in P\\;\\forall p\\in P\\;(\\langle m,p\\rangle\\in\\leq_P\\to p=m)\\Bigr)","display":true},{"tex":"\\leq_P","display":false}],"bytes":1066,"backlinks":[{"id":"5eab288ce162122f","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"b8d460646e93c3b1","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"903bc1b61d6713be","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{AC}_S$ is the choice principle used by [[58-lem-zorn]]."},{"id":"84daad544872cc71","anchor":"ref-3928","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-lem-zorn.md|58-lem-zorn]]（batch14）"}],"outgoing":["6ea17c91dcff1011","d3f859dbdd37f018","a07664003abe8d32"]}