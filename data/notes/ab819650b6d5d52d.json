{"id":"ab819650b6d5d52d","group":"58","path":"58/batch18/58-df-zfc-mouse-premouse.md","title":"ZFC Mouse Premouse","display":"df-zfc-mouse-premouse — ZFC Mouse Premouse","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-mouse-premouse","aliases":["58-df-zfc-mouse-premouse"],"display":"df-zfc-mouse-premouse — ZFC Mouse Premouse","depends_on":["[[58-ax-zfc]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-mouse-premouse"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-mouse-premouse</span></div>"},{"key":"display","html":"df-zfc-mouse-premouse — ZFC Mouse Premouse"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"M,\\vec E\\in V\">\\(M,\\vec E\\in V\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Ord}\">\\(\\mathrm{Ord}\\)</span> is the class of ordinals</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{CoherentES}(\\vec E,\\alpha)\">\\(\\operatorname{CoherentES}(\\vec E,\\alpha)\\)</span> means that each active <span class=\"math-inline\" data-tex=\"\\vec E(\\beta)\">\\(\\vec E(\\beta)\\)</span> is an extender over <span class=\"math-inline\" data-tex=\"J_\\beta^{\\vec E}\">\\(J_\\beta^{\\vec E}\\)</span> and its ultrapower agrees with <span class=\"math-inline\" data-tex=\"\\vec E\">\\(\\vec E\\)</span> below the index prescribed by the initial-segment condition</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{Amenable}(\\vec E,J_\\alpha^{\\vec E})\">\\(\\operatorname{Amenable}(\\vec E,J_\\alpha^{\\vec E})\\)</span> is amenability of the extender predicate</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{Acceptable}(J_\\alpha^{\\vec E},\\vec E)\">\\(\\operatorname{Acceptable}(J_\\alpha^{\\vec E},\\vec E)\\)</span> is Jensen acceptability and fine-structural condensation for all proper initial segments</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Premouse}_S\\subseteq V^2\">\\(\\mathrm{Premouse}_S\\subseteq V^2\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}mouse\\text{-}premouse}\\vdash\n\\mathrm{Premouse}_S(M,\\vec E)\\leftrightarrow\n\\exists\\alpha\\in\\mathrm{Ord}\\;\\bigl(&amp;\n\\operatorname{dom}(\\vec E)=\\alpha\n\\land M=\\langle J_\\alpha^{\\vec E},\\in,\\vec E\\rangle\\\\\n&amp;{}\\land\\operatorname{CoherentES}(\\vec E,\\alpha)\n\\land\\operatorname{Amenable}(\\vec E,J_\\alpha^{\\vec E})\n\\land\\operatorname{Acceptable}(J_\\alpha^{\\vec E},\\vec E)\\bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}mouse\\text{-}premouse}\\vdash\n\\mathrm{Premouse}_S(M,\\vec E)\\leftrightarrow\n\\exists\\alpha\\in\\mathrm{Ord}\\;\\bigl(&amp;\n\\operatorname{dom}(\\vec E)=\\alpha\n\\land M=\\langle J_\\alpha^{\\vec E},\\in,\\vec E\\rangle\\\\\n&amp;{}\\land\\operatorname{CoherentES}(\\vec E,\\alpha)\n\\land\\operatorname{Amenable}(\\vec E,J_\\alpha^{\\vec E})\n\\land\\operatorname{Acceptable}(J_\\alpha^{\\vec E},\\vec E)\\bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false}],"math":[{"tex":"M,\\vec E\\in V","display":false},{"tex":"\\mathrm{Ord}","display":false},{"tex":"\\operatorname{CoherentES}(\\vec E,\\alpha)","display":false},{"tex":"\\vec E(\\beta)","display":false},{"tex":"J_\\beta^{\\vec E}","display":false},{"tex":"\\vec E","display":false},{"tex":"\\operatorname{Amenable}(\\vec E,J_\\alpha^{\\vec E})","display":false},{"tex":"\\operatorname{Acceptable}(J_\\alpha^{\\vec E},\\vec E)","display":false},{"tex":"\\mathrm{Premouse}_S\\subseteq V^2","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}mouse\\text{-}premouse}\\vdash\n\\mathrm{Premouse}_S(M,\\vec E)\\leftrightarrow\n\\exists\\alpha\\in\\mathrm{Ord}\\;\\bigl(&\n\\operatorname{dom}(\\vec E)=\\alpha\n\\land M=\\langle J_\\alpha^{\\vec E},\\in,\\vec E\\rangle\\\\\n&{}\\land\\operatorname{CoherentES}(\\vec E,\\alpha)\n\\land\\operatorname{Amenable}(\\vec E,J_\\alpha^{\\vec E})\n\\land\\operatorname{Acceptable}(J_\\alpha^{\\vec E},\\vec E)\\bigr).\n\\end{aligned}","display":true}],"bytes":1367,"backlinks":[{"id":"203f765d44ea3c39","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S$ (fine-structural premouse predicate, see [[../batch18/58-df-zfc-mouse-premouse.md]])"},{"id":"0f1db95b853d761e","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S$ (canonical premouse predicate, see [[../batch18/58-df-zfc-mouse-premouse.md]])"},{"id":"7854b320fddf7289","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S$ (premouse predicate, see [[../batch18/58-df-zfc-mouse-premouse.md]])"},{"id":"67304db766f65ebb","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"78077d539058b62d","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S(M,\\vec E)$ is the premouse predicate (see [[../batch18/58-df-zfc-mouse-premouse.md]])"},{"id":"3d23dbbdaaaa01c3","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"1048d44b28527ff2","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S\\subseteq V^2$ is the canonical premouse predicate (see [[../batch18/58-df-zfc-mouse-premouse.md]])."},{"id":"3dad3d3806b81f88","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"b78f1aa00040ca7f","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"695d439fd8428da4","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S\\subseteq V^2$ (see [[58-df-zfc-mouse-premouse]])"},{"id":"8ee467bd1d472e5f","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Premouse}_S\\subseteq V^2$ (see [[58-df-zfc-mouse-premouse]])"},{"id":"84daad544872cc71","anchor":"ref-2830","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-mouse-premouse.md|58-df-zfc-mouse-premouse]]（batch18）"}],"outgoing":["a3348ed9eb6fb4e3"]}