{"id":"cb0607459077d92c","group":"58","path":"58/batch10/58-df-zfc-forcing5-complete-subalgebra.md","title":"ZFC Forcing5 Complete Subalgebra","display":"df-zfc-forcing5-complete-subalgebra — ZFC Forcing5 Complete Subalgebra","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-forcing5-complete-subalgebra","aliases":["58-df-zfc-forcing5-complete-subalgebra"],"display":"df-zfc-forcing5-complete-subalgebra — ZFC Forcing5 Complete Subalgebra","depends_on":["[[58-ax-zfc]]","[[../batch07/58-df-boolean-algebra.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-forcing5-complete-subalgebra"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-forcing5-complete-subalgebra</span></div>"},{"key":"display","html":"df-zfc-forcing5-complete-subalgebra — ZFC Forcing5 Complete Subalgebra"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"a5e10857074b912e\" href=\"?note=a5e10857074b912e\" title=\"../batch07/58-df-boolean-algebra.md\">../batch07/58-df-boolean-algebra.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathbb A,\\mathbb B\\in V\">\\(\\mathbb A,\\mathbb B\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Boolean}:V^6\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Boolean}:V^6\\to\\{\\top,\\bot\\}\\)</span> (Boolean-algebra predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"a5e10857074b912e\" href=\"?note=a5e10857074b912e\" title=\"../batch07/58-df-boolean-algebra.md\">../batch07/58-df-boolean-algebra.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcing5CompleteSubalgebra}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcForcing5CompleteSubalgebra}_S:V^2\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing5\\text{-}complete\\text{-}subalgebra} \\vdash \\mathrm{ZfcForcing5CompleteSubalgebra}_S(\\mathbb A,\\mathbb B)\\leftrightarrow \\exists A,B,\\wedge_A,\\vee_A,\\neg_A,\\wedge_B,\\vee_B,\\neg_B,0,1\\in V\\;\\Bigl(\\mathbb A=(A,\\wedge_A,\\vee_A,\\neg_A,0,1)\\land\\mathbb B=(B,\\wedge_B,\\vee_B,\\neg_B,0,1)\\land\\mathrm{Boolean}(A,\\wedge_A,\\vee_A,\\neg_A,0,1)\\land\\mathrm{Boolean}(B,\\wedge_B,\\vee_B,\\neg_B,0,1)\\land A\\subseteq B\\land\\wedge_A=\\wedge_B\\upharpoonright(A\\times A)\\land\\vee_A=\\vee_B\\upharpoonright(A\\times A)\\land\\neg_A=\\neg_B\\upharpoonright A\\land\\forall X\\subseteq A\\;\\exists a\\in A\\;\\bigl(\\forall x\\in X\\;(x\\wedge_A a=x)\\land\\forall b\\in B\\;((\\forall x\\in X\\;(x\\wedge_B b=x))\\to a\\wedge_B b=a)\\bigr)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing5\\text{-}complete\\text{-}subalgebra} \\vdash \\mathrm{ZfcForcing5CompleteSubalgebra}_S(\\mathbb A,\\mathbb B)\\leftrightarrow \\exists A,B,\\wedge_A,\\vee_A,\\neg_A,\\wedge_B,\\vee_B,\\neg_B,0,1\\in V\\;\\Bigl(\\mathbb A=(A,\\wedge_A,\\vee_A,\\neg_A,0,1)\\land\\mathbb B=(B,\\wedge_B,\\vee_B,\\neg_B,0,1)\\land\\mathrm{Boolean}(A,\\wedge_A,\\vee_A,\\neg_A,0,1)\\land\\mathrm{Boolean}(B,\\wedge_B,\\vee_B,\\neg_B,0,1)\\land A\\subseteq B\\land\\wedge_A=\\wedge_B\\upharpoonright(A\\times A)\\land\\vee_A=\\vee_B\\upharpoonright(A\\times A)\\land\\neg_A=\\neg_B\\upharpoonright A\\land\\forall X\\subseteq A\\;\\exists a\\in A\\;\\bigl(\\forall x\\in X\\;(x\\wedge_A a=x)\\land\\forall b\\in B\\;((\\forall x\\in X\\;(x\\wedge_B b=x))\\to a\\wedge_B b=a)\\bigr)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch07/58-df-boolean-algebra.md","status":"resolved","id":"a5e10857074b912e","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-boolean-algebra.md]]","embed":false},{"target":"../batch07/58-df-boolean-algebra.md","status":"resolved","id":"a5e10857074b912e","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Boolean}:V^6\\to\\{\\top,\\bot\\}$ (Boolean-algebra predicate, see [[../batch07/58-df-boolean-algebra.md]])","embed":false}],"math":[{"tex":"\\mathbb A,\\mathbb B\\in V","display":false},{"tex":"\\mathrm{Boolean}:V^6\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcForcing5CompleteSubalgebra}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}forcing5\\text{-}complete\\text{-}subalgebra} \\vdash \\mathrm{ZfcForcing5CompleteSubalgebra}_S(\\mathbb A,\\mathbb B)\\leftrightarrow \\exists A,B,\\wedge_A,\\vee_A,\\neg_A,\\wedge_B,\\vee_B,\\neg_B,0,1\\in V\\;\\Bigl(\\mathbb A=(A,\\wedge_A,\\vee_A,\\neg_A,0,1)\\land\\mathbb B=(B,\\wedge_B,\\vee_B,\\neg_B,0,1)\\land\\mathrm{Boolean}(A,\\wedge_A,\\vee_A,\\neg_A,0,1)\\land\\mathrm{Boolean}(B,\\wedge_B,\\vee_B,\\neg_B,0,1)\\land A\\subseteq B\\land\\wedge_A=\\wedge_B\\upharpoonright(A\\times A)\\land\\vee_A=\\vee_B\\upharpoonright(A\\times A)\\land\\neg_A=\\neg_B\\upharpoonright A\\land\\forall X\\subseteq A\\;\\exists a\\in A\\;\\bigl(\\forall x\\in X\\;(x\\wedge_A a=x)\\land\\forall 