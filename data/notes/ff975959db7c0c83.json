ure relation (see <a class=\"wiki-link\" id=\"ref-10\" data-note=\"6a7fe4775125052f\" href=\"?note=6a7fe4775125052f\" title=\"57-df-elementary-substructure\">57-df-elementary-substructure</a>).</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"57-df-first-order-language","status":"resolved","id":"140b30594fbd26d8","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-first-order-language]]","embed":false},{"target":"57-thm-ls-downward","status":"resolved","id":"7e46eab7508a86c4","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-thm-ls-downward]]","embed":false},{"target":"57-df-structure","status":"resolved","id":"c136ba3960a7223a","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-structure]]","embed":false},{"target":"57-df-elementary-substructure","status":"resolved","id":"6a7fe4775125052f","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-elementary-substructure]]","embed":false},{"target":"57-df-satisfaction","status":"resolved","id":"03dc48eb29950767","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-satisfaction]]","embed":false},{"target":"57-df-theory","status":"resolved","id":"9c053a73bd2d84c4","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[57-df-theory]]","embed":false},{"target":"57-df-first-order-language","status":"resolved","id":"140b30594fbd26d8","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$S$ (签名, see [[57-df-first-order-language]])","embed":false},{"target":"57-df-structure","status":"resolved","id":"c136ba3960a7223a","anchor":"ref-8","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\