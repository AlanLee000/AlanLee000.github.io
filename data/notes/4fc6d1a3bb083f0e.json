e{tgt}(\\operatorname{LPath}_{R_2}(\\rho_n))=A(t,(1)).","display":true}],"bytes":2931,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-153","locations":["正文"],"count":2,"excerpt":"[[56-ex-levy-label-history.md]]"}],"outgoing":["e1df6cfb55a11bcc"]}