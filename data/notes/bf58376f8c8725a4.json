ntichain}_S\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>, <a class=\"wiki-link\" id=\"ref-4\" data-note=\"fb7c32a0f0383968\" href=\"?note=fb7c32a0f0383968\" title=\"../batch01/58-df-maximal-antichain.md\">../batch01/58-df-maximal-antichain.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcing3RegularSuborder}_S,\\mathrm{ZfcForcing11RegularSuborder}_S\\subseteq V^4\">\\(\\mathrm{ZfcForcing3RegularSuborder}_S,\\mathrm{ZfcForcing11RegularSuborder}_S\\subseteq V^4\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing3\\text{-}regular\\text{-}suborder} \\vdash\n\\mathrm{ZfcForcing3RegularSuborder}_S(\\mathbb P,\\leq_{\\mathbb P},\\mathbb Q,\\leq_{\\mathbb Q})\\leftrightarrow\n\\mathrm{Poset}(\\mathbb P,\\leq_{\\mathbb P})\\land\n\\mathrm{Poset}(\\mathbb Q,\\leq_{\\mathbb Q})\\land\n\\mathbb P\\subseteq\\mathbb Q\\land\n\\forall p,q\\in\\mathbb P\\;(\\langle p,q\\rangle\\in\\leq_{\\mathbb P}\\leftrightarrow\n\\langle p,q\\rangle\\in\\leq_{\\mathbb Q})\\land\n\\forall A\\subseteq\\mathbb P\\;\n(\\mathrm{MaxAntichain}_S(A,\\mathbb P,\\leq_{\\mathbb P})\\to\n\\mathrm{MaxAntichain}_S(A,\\mathbb Q,\\leq_{\\mathbb Q}))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing3\\text{-}regular\\text{-}suborder} \\vdash\n\\mathrm{ZfcForcing3RegularSuborder}_S(\\mathbb P,\\leq_{\\mathbb P},\\mathbb Q,\\leq_{\\mathbb Q})\\leftrightarrow\n\\mathrm{Poset}(\\mathbb P,\\leq_{\\mathbb P})\\land\n\\mathrm{Poset}(\\mathbb Q,\\leq_{\\mathbb Q})\\land\n\\mathbb P\\subseteq\\mathbb Q\\land\n\\forall p,q\\in\\mathbb P\\;(\\langle p,q\\rangle\\in\\leq_{\\mathbb P}\\leftrightarrow\n\\langle p,q\\rangle\\in\\leq_{\\mathbb Q})\\land\n\\forall A\\subseteq\\mathbb P\\;\n(\\mathr