"tex":"G","display":false},{"tex":"\\mathrm{SeqCode}","display":false},{"tex":"\\ulcorner\\cdot\\urcorner","display":false},{"tex":"\\mathrm{Prf}_G","display":false},{"tex":"\\mathrm{df\\text{-}proof\\text{-}predicate} \\vdash\n\\mathrm{Prf}_G(k,m)\\Longleftrightarrow\n\\exists r\\in\\mathbb N_{>0}\\;\\exists(\\psi_1,\\ldots,\\psi_r)\\in(\\mathrm{Fml}_G)^r\\;\\Bigl(\nk=\\mathrm{SeqCode}(\\langle\\ulcorner\\psi_1\\urcorner,\\ldots,\\ulcorner\\psi_r\\urcorner\\rangle)\n\\land m=\\ulcorner\\psi_r\\urcorner\n\\land\\mathrm{Proof}_{G}(\\langle\\psi_1,\\ldots,\\psi_r\\rangle,\\psi_r)\\Bigr)","display":true},{"tex":"\\mathrm{Prf}_G(k,m)","display":false},{"tex":"k","display":false},{"tex":"m","display":false},{"tex":"G","display":false},{"tex":"G","display":false},{"tex":"\\mathrm{Prf}_G","display":false},{"tex":"\\mathrm{ProvCode}_G(m)\\leftrightarrow\\exists k\\;\\mathrm{Prf}_G(k,m)","display":false},{"tex":"\\mathrm{Prf}_G","display":false},{"tex":"\\mathrm{Prov}_G","display":false},{"tex":"\\Sigma_1","display":false}],"bytes":2477,"backlinks":[{"id":"e29ed1961d4b73a9","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G$ (coded proof relation, see [[92-df-proof-predicate]])"},{"id":"d8d33d47202e6d60","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G$ (proof-code predicate, see [[92-df-proof-predicate]])"},{"id":"e9cc91aaee998c7b","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"d8d7d3ba56a05b13","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G$ (proof predicate, see [[92-df-proof-predicate]])"},{"id":"a9f0825717f03a8f","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G\\subseteq\\mathbb N^2$ (external proof-code predicate, see [[92-df-proof-predicate]])"},{"id":"5984f0527f1f4cba","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G$ (proof-code predicate, see [[92-df-proof-predicate]])"},{"id":"bf315ef87cd91c88","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G$ (code-level proof predicate, see [[92-df-proof-predicate]])"},{"id":"baf256d78d60c2a6","anchor":"ref-50","locations":["正文"],"count":1,"excerpt":"本地 PA 支线由[[92-df-g-system]]、[[92-df-logical-axiom]]、[[92-df-godel-numbering]]、[[92-df-proof-predicate]]给出。[[92-lem-local-pa-proves-q]]解释为什么这里需要 $Q\\subseteq\\mathrm{Th}(G)$，不能误写所有七条 $Q$ 公理均为该 PA 呈现的原始公理。"},{"id":"603b78700e219950","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Prf}_G\\subseteq\\mathbb N^2$ (external proof-code predicate, see [[92-df-proof-predicate]])"},{"id":"911d25a82b6a7593","anchor":"ref-16","locations":["正文"],"count":2,"excerpt":"[[92-df-proof-predicate]]"},{"id":"823a52c75bbad9bd","anchor":"ref-132","locations":["正文"],"count":1,"excerpt":"[[92-df-proof-predicate]]"}],"outgoing":["2413c1d0ca8a0ce6","573d6ccf155d773c","5a1bd470754681a7","23b675b1348a813e","e0eabee5d77258a7","360e00ddf38f0f16","298d80fabfd2a708"]}