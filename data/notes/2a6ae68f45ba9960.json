uad\\coloneqq\\quad\n\\operatorname{val}^{\\mathcal N,\\Gamma}_3(\\varphi)=\\mathbf t.","display":true},{"tex":"t","display":false},{"tex":"T(t)","display":false},{"tex":"\\min","display":false}],"bytes":2139,"backlinks":[{"id":"bde974325ff73b34","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"15f80240a42e9796","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"2bc1263010e83604","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"8747011468390705","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"4278731e7fc892de","anchor":"ref-46","locations":["正文"],"count":1,"excerpt":"[[91-df-three-valued-satisfaction]]"},{"id":"e93fc3e2f8fd50d4","anchor":"ref-91","locations":["正文"],"count":1,"excerpt":"[[91-df-CT.md]]\n[[91-df-FS-n.md]]\n[[91-df-FS.md]]\n[[91-df-KF-plus.md]]\n[[91-df-KF.md]]\n[[91-df-T-closure.md]]\n[[91-df-T-schema.md]]\n[[91-df-TB-plus.md]]\n[[91-df-TB.md]]\n[[91-df-UTB-plus.md]]\n[[91-df-UTB.md]]\n[[91-df-VF.md]]\n[[91-df-adequacy-conditions-truth.md]]\n[[91-df-adequacy-conditions.md]]\n[[91-df-arithmetical-hierarchy.md]]\n[[91-df-capture-axiom.md]]\n[[91-df-classical-extension.md]]\n[[91-df-coded-syntax.md]]\n[[91-df-compositional-axioms.md]]\n[[91-df-compositional-truth.md]]\n[[91-df-conjunction-axiom.md]]\n[[91-df-conservative-truth.md]]\n[[91-df-conservativity-proof.md]]\n[[91-df-consistency-predicate.md]]\n[[91-df-continuity.md]]\n[[91-df-diagonal-function.md]]\n[[91-df-diagonal-lemma-truth.md]]\n[[91-df-disquotational-schema.md]]\n[[91-df-disquotational-truth.md]]\n[[91-df-expressive-completeness.md]]\n[[91-df-external-consistency.md]]\n[[91-df-external-logic.md]]\n[[91-df-external-negation.md]]\n[[91-df-extrinsic-fixed-point.md]]\n[[91-df-fixed-point-model.md]]\n[[91-df-gap-sentence.md]]\n[[91-df-global-T-schema.md]]\n[[91-df-global-reflection.md]]\n[[91-df-ground-language.md]]\n[[91-df-ground-model.md]]\n[[91-df-hierarchical-truth