in)\n\\land\\mathrm{FV}_{\\mathcal L_\\in}(\\varphi)\\subseteq\\operatorname{dom}(s).","display":true},{"tex":"\\mathrm{df\\text{-}class\\text{-}satisfaction}\\vdash_{\\mathrm{meta}}\n\\begin{aligned}\n\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\ulcorner x\\doteq y\\urcorner,s)\n&\\leftrightarrow\\mathrm{ClassAssignment}_{\\mathrm{meta}}(s,M,\\ulcorner x\\doteq y\\urcorner)\\land s(x)=s(y),\\\\\n\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\ulcorner x\\dot\\in y\\urcorner,s)\n&\\leftrightarrow\\mathrm{ClassAssignment}_{\\mathrm{meta}}(s,M,\\ulcorner x\\dot\\in y\\urcorner)\\land s(x)\\in s(y),\\\\\n\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\ulcorner\\neg\\varphi\\urcorner,s)\n&\\leftrightarrow\\mathrm{ClassAssignment}_{\\mathrm{meta}}(s,M,\\ulcorner\\neg\\varphi\\urcorner)\\land\\neg\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\varphi,s),\\\\\n\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\ulcorner\\varphi\\lor\\psi\\urcorner,s)\n&\\leftrightarrow\\mathrm{ClassAssignment}_{\\mathrm{meta}}(s,M,\\ulcorner\\varphi\\lor\\psi\\urcorner)\\land\n(\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\varphi,s)\\lor\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\psi,s)),\\\\\n\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\ulcorner\\forall x\\varphi\\urcorner,s)\n&\\leftrightarrow\\mathrm{ClassAssignment}_{\\mathrm{meta}}(s,M,\\ulcorner\\forall x\\varphi\\urcorner)\\land\n\\forall a\\in M\\;\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\varphi,s[x\\mapsto a]).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}class\\text{-}satisfaction\\text{-}notation}\\vdash_{\\mathrm{meta}}\n\\begin{aligned}\n&n\\in\\omega\\land\\vec a\\in M^n\\land\n\\mathrm{FV}_{\\mathcal L_\\in}(\\varphi)\\subseteq\\{v_i:i<n\\}\\\\\n&\\quad\\to\\Bigl(\\langle M,\\in\\rangle\\models\\varphi[\\vec a]\\leftrightarrow\n\\mathrm{ClassSat}_{\\mathrm{meta}}(M,\\varphi,\\{\\langle v_i,\\vec a(i)\\rangle:i<n\\})\\Bigr).\n\\end{aligned}","display":true}],"bytes":3703,"backlinks":[{"id":"7e060283e46d1355","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"0d480b0822a231c2","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\vec U,\\vec\\kappa$ 为定义域 $\\omega$ 的集合函数。$\\mathcal L_\\in$、$\\mathrm{FV}_{\\mathcal L_\\in}$ 与 $\\langle M,\\in\\rangle\\models\\varphi[\\vec a]$ 采用 [[../batch05/58-df-class-satisfaction.md]]；$M^r$ 为长度 $r$ 的有限集合函数赋值类。"},{"id":"4e04cbefb6776d1b","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{ClassSat}$ 取 [[../batch05/58-df-class-satisfaction.md]] 的同名定义与参数次序。"},{"id":"9398b95a78da977c","anchor":"ref-7","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"5578254565969219","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"1689492fab8da0e1","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{ClassSat}$ 取 [[../batch05/58-df-class-satisfaction.md]] 的同名定义与参数次序。"},{"id":"62983ac7606858a6","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"0fc577c79c699e0c","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\bigwedge_{\\varphi}$ 是元语言模式，按 [[58-df-class-satisfaction]] 的有限公式递归解释每一个成员结构满意式；$\\vdash_{\\mathrm{meta}}$ 不是 ZFC 中的统一类真谓词。"},{"id":"150182b44c47c043","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"533640adc79e621f","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$L_\\in=\\langle\\{\\dot\\in\\},\\varnothing,\\varnothing,\\{\\langle\\dot\\in,2\\rangle\\}\\rangle$。公式、自由变量、$v_i$ 与成员结构满意关系取 [[../batch05/58-df-class-satisfaction.md]]；$V^r$ 仅表示长度 $r$ 的有限集合赋值类。"},{"id":"a15944d89f213496","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$L_\\in=\\langle\\{\\dot\\in\\},\\varnothing,\\varnothing,\\{\\langle\\dot\\in,2\\rangle\\}\\rangle$。公式、自由变量、$v_i$ 与成员结构满意关系取 [[../batch05/58-df-class-satisfaction.md]]；$V^r$ 仅表示长度 $r$ 的有限集合赋值类。"},{"id":"ca2a9c9166fa8cce","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\models_{\\mathsf{meta}}$ 使用 [[../batch05/58-df-class-satisfaction.md]] 的有限公式递归语义；不是 $V$ 的集合编码真谓词。"},{"id":"e91996b4cded8a6b","anchor":"ref-7","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"641a3566187bf66b","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathcal L_\\in=\\langle\\{\\dot\\in\\},\\varnothing,\\varnothing,\\{\\langle\\dot\\in,2\\rangle\\}\\rangle$，$\\mathrm{Fml}_\\in=\\mathrm{Fml}_S(\\mathcal L_\\in)$。满意关系、变量编码及有限赋值使用 [[../batch05/58-df-class-satisfaction.md]]；$V^r$ 表示长度 $r$ 的有限集合函数赋值类。"},{"id":"a762f9d6c343e3a0","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{ClassSat}$ 取 [[../batch05/58-df-class-satisfaction.md]] 的同名定义与参数次序。"},{"id":"e7499072623198aa","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{Elem}^{\\mathrm{Cls}}_{\\in}(j,V,M)$ 使用 [[../batch18/58-df-huge.md]] 中以 [[../batch05/58-df-class-satisfaction.md]] 的满意关系展开的初等性模式。"},{"id":"84daad544872cc71","anchor":"ref-285","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-class-satisfaction.md|58-df-class-satisfaction]]（batch05）"}],"outgoing":["65418b505fc53093","715a32e91161b34f","36d7463d215be751","d9a25b0ac94a3598"]}