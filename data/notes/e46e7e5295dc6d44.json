{"id":"e46e7e5295dc6d44","group":"58","path":"58/batch14/58-prop-intersection-preservation.md","title":"Intersection Preservation","display":"prop-intersection-preservation — Intersection Preservation","type":"proposition","metadata":{"type":"proposition","book":"Set Theory","book_abbrev":"58","label":"58-prop-intersection-preservation","aliases":["58-prop-intersection-preservation"],"display":"prop-intersection-preservation — Intersection Preservation","depends_on":["[[./58-df-filter-set.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"proposition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-prop-intersection-preservation"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-prop-intersection-preservation</span></div>"},{"key":"display","html":"prop-intersection-preservation — Intersection Preservation"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"5a7d94a7a7f8209a\" href=\"?note=5a7d94a7a7f8209a\" title=\"./58-df-filter-set.md\">58-df-filter-set.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\mathcal F,A,B\\in V\">\\(X,\\mathcal F,A,B\\in V\\)</span> and <span class=\"math-inline\" data-tex=\"A,B\\in\\mathcal F\">\\(A,B\\in\\mathcal F\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Filter}_S\\subseteq V^2\">\\(\\mathrm{Filter}_S\\subseteq V^2\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"5a7d94a7a7f8209a\" href=\"?note=5a7d94a7a7f8209a\" title=\"./58-df-filter-set.md\">58-df-filter-set.md</a>).</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{prop\\text{-}intersection\\text{-}preservation} \\vdash\n\\mathrm{Filter}_S(\\mathcal F,X)\\land A\\in\\mathcal F\\land B\\in\\mathcal F\\to A\\cap B\\in\\mathcal F\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{prop\\text{-}intersection\\text{-}preservation} \\vdash\n\\mathrm{Filter}_S(\\mathcal F,X)\\land A\\in\\mathcal F\\land B\\in\\mathcal F\\to A\\cap B\\in\\mathcal F\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Filters are closed under finite intersections.</li>\n<li>This is one of the defining properties of filters.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"./58-df-filter-set.md","status":"resolved","id":"5a7d94a7a7f8209a","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[./58-df-filter-set.md]]","embed":false},{"target":"./58-df-filter-set.md","status":"resolved","id":"5a7d94a7a7f8209a","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Filter}_S\\subseteq V^2$ (see [[./58-df-filter-set.md]]).","embed":false}],"math":[{"tex":"X,\\mathcal F,A,B\\in V","display":false},{"tex":"A,B\\in\\mathcal F","display":false},{"tex":"\\mathrm{Filter}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{prop\\text{-}intersection\\text{-}preservation} \\vdash\n\\mathrm{Filter}_S(\\mathcal F,X)\\land A\\in\\mathcal F\\land B\\in\\mathcal F\\to A\\cap B\\in\\mathcal F","display":true}],"bytes":787,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3968","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-prop-intersection-preservation.md|58-prop-intersection-preservation]]（batch14）"}],"outgoing":["5a7d94a7a7f8209a"]}