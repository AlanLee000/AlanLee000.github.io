eefb4572709e\" href=\"?note=8317eefb4572709e\" title=\"../batch15/58-df-injective.md\">../batch15/58-df-injective.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"2d9fd66bae7ead5a\" href=\"?note=2d9fd66bae7ead5a\" title=\"../batch13/58-df-transitive.md\">../batch13/58-df-transitive.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"44d32dc8fecf5e62\" href=\"?note=44d32dc8fecf5e62\" title=\"../batch09/58-df-range.md\">../batch09/58-df-range.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"D,R,\\pi,x,y\\in V\">\\(D,R,\\pi,x,y\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRelWellFoundedRelation}_S,\\mathrm{ZfcRelExtensionalRelation}_S\\subseteq V^2\">\\(\\mathrm{ZfcRelWellFoundedRelation}_S,\\mathrm{ZfcRelExtensionalRelation}_S\\subseteq V^2\\)</span>（参数顺序均为 <span class=\"math-inline\" data-tex=\"(R,D)\">\\((R,D)\\)</span>，see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"a6e2250a95e86cd5\" href=\"?note=a6e2250a95e86cd5\" title=\"../batch13/58-df-zfc-rel-well-founded-relation.md\">../batch13/58-df-zfc-rel-well-founded-relation.md</a>、<a class=\"wiki-link\" id=\"ref-8\" data-note=\"a76f75f6b26e320a\" href=\"?note=a76f75f6b26e320a\" title=\"../batch16/58-df-zfc-rel-extensional-relation.md\">../batch16/58-df-zfc-rel-extensional-relation.md</a>）</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function},\\mathrm{Injective}\\subseteq V^3\">\\(\\mathrm{Function},\\mathrm{Injective}\\subseteq V^3\\)</span>（参数顺序均为“映射、定义域、陪域”，see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>、<a class=\"wiki-link\" id=\"ref-10\" data-note=\"8317eefb4572709e\" href=\"?note=8317eefb4572709e\" title=\"../batch15/58-df-injective.md\">../batch15/58-df-injective.md</a>）</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Transitive}\\subseteq V\">\\(\\mathrm{Transitive}\\subseteq V\\)</span>（see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"2d9fd66bae7ead5a\" href=\"?note=2d9fd66bae7ead5a\" title=\"../batch13/58-df-transitive.md\">../batch13/58-df-transitive.md</a>）</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{ran}\">\\(\\operatorname{ran}\\)</span> (range operator, see <a class=\"wiki-link\" id=\"ref-12\" data-note=\"44d32dc8fecf5e62\" href=\"?note=44d32dc8fecf5e62\" title=\"../batch09/58-df-range.md\">../batch09/58-df-range.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcSet10TransitiveCollapseDomain}_S\\subseteq V^3\">\\(\\mathrm{ZfcSet10TransitiveCollapseDomain}_S\\subseteq V^3\\)</span>（本文件定义）</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}transitive\\text{-}collapse\\text{-}domain} \\vdash\n\\mathrm{ZfcSet10TransitiveCollapseDomain}_S(D,R,\\pi)\\leftrightarrow\n\\left(\n\\mathrm{ZfcRelWellFoundedRelation}_S(R,D)\\land\n\\mathrm{ZfcRelExtensionalRelation}_S(R,D)\\land\n\\mathrm{Function}(\\pi,D,\\operatorname{ran}(\\pi))\\land\n\\mathrm{Injective}(\\pi,D,\\operatorname{ran}(\\pi))\\land\n\\mathrm{Transitive}(\\operatorname{ran}(\\pi))\\land\n\\forall x,y\\in D\\;\n\\bigl(\\langle x,y\\rangle\\in R\\leftrightarrow\\pi(x)\\in\\pi(y)\\bigr)\n\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}transitive\\text{-}collapse\\text{-}domain} \\vdash\n\\mathrm{ZfcSet10TransitiveCollapseDomain}_S(D,R,\\pi)\\leftrightarrow\n\\left(\n\\mathrm{ZfcRelWellFoundedRelation}_S(R,D)\\land\n\\mathrm{ZfcRelExtensionalRelation}_S(R,D)\\land\n\\mathrm{Function}(\\pi,D,\\operatorname{ran}(\\pi))\\land\n\\mathrm{Injective}(\\pi,D,\\operatorname{ran}(\\pi))\\land\n\\mathrm{Transitive}(\\operatorname{ran}(\\pi))\\land\n\\forall x,y\\in D\\;\n\\bigl(\\langle x,y\\rangle\\in R\\leftrightarrow\\pi(x)\\in\\pi(y)\\bigr)\n\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary collapse-domain definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch13/58-df-zfc-rel-well-founded-relation.md","status":"resolved","id":"a6e2250a95e86cd5","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-zfc-rel-well-founded-relation.md]]","embed":false},{"target":"../batch16/58-df-zfc-rel-extensional-relation.md","status":"resolved","id":"a76f75f6b26e320a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-zfc-rel-extensional-relation.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch15/58-df-injective.md","status":"resolved","id":"8317eefb4572709e","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-injective.md]]","embed":false},{"target":"../batch13/58-df-transitive.md","status":"resolved","id":"2d9fd66bae7ead5a","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-transitive.md]]","embed":false},{"target":"../batch09/58-df-range.md","status":"resolved","id":"44d32dc8fecf5e62","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch09/58-df-range.md]]","embed":false},{"target":"../batch13/58-df-zfc-rel-well-founded-relation.md","status":"resolved","id":"a6e2250a95e86cd5","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesi