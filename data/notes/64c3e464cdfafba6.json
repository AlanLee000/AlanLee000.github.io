})\\times\\mathsf{Tick}_{T}\\times\\mathsf{Time}_{T}\\to(\\mathsf{Time}_{T}\\cup\\mathsf{Ty}_{T}\\cup\\mathsf{Tm}_{T})","display":true},{"tex":"E[\\theta:=\\tau]_t","display":false},{"tex":"\\theta[\\theta:=\\tau]_t=\\tau,\\qquad\n\\eta[\\theta:=\\tau]_t=\\eta\\quad(\\eta\\ne\\theta),","display":true},{"tex":"(\\rho+1)[\\theta:=\\tau]_t=(\\rho[\\theta:=\\tau]_t)+1,","display":true},{"tex":"(\\square_\\rho A)[\\theta:=\\tau]_t=\n\\square_{\\rho[\\theta:=\\tau]_t}(A[\\theta:=\\tau]_t),","display":true},{"tex":"(\\lozenge_\\rho A)[\\theta:=\\tau]_t=\n\\lozenge_{\\rho[\\theta:=\\tau]_t}(A[\\theta:=\\tau]_t),","display":true},{"tex":"\\mathsf{eventually}(\\rho,M)[\\theta:=\\tau]_t=\n\\mathsf{eventually}(\\rho[\\theta:=\\tau]_t,M[\\theta:=\\tau]_t).","display":true},{"tex":"\\operatorname{fresh}_{T}(X)=x_m","display":false},{"tex":"m=\\min\\{i\\in\\mathbb N:x_i\\notin X\\}","display":false},{"tex":"\\operatorname{Sub}_{T}:\\mathsf{Tm}_{T}\\times\\mathsf{Var}_{T}\\times\\mathsf{Tm}_{T}\\to\\mathsf{Tm}_{T}","display":false},{"tex":"\\operatorname{BSub}_{T}(y,E,x,N)=\n\\begin{cases}\nE,&y=x,\\\\\nE[x:=N],&y\\ne x\\ \\wedge\\ y\\notin\\operatorname{FV}_{T}(N),\\\\\n(E[y:=z])[x:=N],&y\\ne x\\ \\wedge\\ y\\in\\operatorname{FV}_{T}(N),\n\\end{cases}","display":true},{"tex":"z=\\operatorname{fresh}_{T}(\\operatorname{FV}_{T}(E)\\cup\\operatorname{FV}_{T}(N)\\cup\\{x,y\\})","display":false},{"tex":"(\\lambda y.M)[x:=N]=\\lambda y.\\operatorname{BSub}_{T}(y,M,x,N),","display":true},{"tex":"\\mathsf{letevent}(y,M_0,N_0)[x:=N]=\n\\mathsf{letevent}(y,M_0[x:=N],\\operatorname{BSub}_{T}(y,N_0,x,N)).","display":true},{"tex":"\\equiv_\\alpha^{T}","display":false},{"tex":"E","display":false},{"tex":"E","display":false},{"tex":"E","display":false},{"tex":"\\lambda","display":false},{"tex":"\\mathsf{letevent}","display":false},{"tex":"E","display":false},{"tex":"\\mathsf{stable}_T(\\Theta;\\Gamma;M)","display":false},{"tex":"\\operatorname{FV}_{T}(M)","display":false},{"tex":"\\Gamma","displ