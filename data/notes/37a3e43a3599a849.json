{"tex":"\\mathrm{MostowskiCollapse}_S","display":false},{"tex":"\\mathrm{Function}","display":false},{"tex":"M_i\\coloneqq\\vec M(i)","display":false},{"tex":"\\kappa_i\\coloneqq\\vec\\kappa(i)","display":false},{"tex":"U_i\\coloneqq\\vec U(i)","display":false},{"tex":"j_{ih}\\coloneqq\\vec j(\\langle i,h\\rangle)","display":false},{"tex":"\\langle j_{i\\lambda}:i<\\lambda\\rangle\\coloneqq\\{\\langle i,\\vec j(\\langle i,\\lambda\\rangle)\\rangle:i<\\lambda\\}","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}internal\\text{-}ultrapower}\\vdash_{\\mathsf{meta}}\n\\mathrm{InternalUltrapower}_S(N,j;M,\\kappa,U)\\\\\n\\leftrightarrow{}&\n\\exists F,E_U,Q,R_U,\\pi\\in V\\;\\Biggl[\nF=\\{f\\in M:\\mathrm{Function}(f,\\kappa,M)\\}\\\\\n&\\quad\\land E_U=\n\\{\\langle f,g\\rangle\\in F\\times F:\n\\{\\xi\\in\\kappa:f(\\xi)=g(\\xi)\\}\\in U\\}\\\\\n&\\quad\\land\\mathrm{QuotientSet}_S(Q,F,E_U)\\\\\n&\\quad\\land R_U=\n\\{\\langle[f]_{E_U},[g]_{E_U}\\rangle:f,g\\in F\\land\n\\{\\xi\\in\\kappa:f(\\xi)\\in g(\\xi)\\}\\in U\\}\\\\\n&\\quad\\land\\mathrm{MostowskiCollapse}_S(Q,R_U,N,\\pi)\n\\land\\mathrm{Function}(j,M,N)\\\\\n&\\quad\\land\\forall x\\in M\\;\\exists c\\in F\\;\\Bigl(\n\\forall\\xi\\in\\kappa\\;(c(\\xi)=x)\n\\land j(x)=\\pi([c]_{E_U})\\Bigr)\n\\Biggr].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}iteration\\text{-}direct\\text{-}limit}\\vdash_{\\mathsf{meta}}\n\\mathrm{DirectLimitSystem}_S(N,\\vec k;\\vec M,\\vec j,\\lambda)\\\\\n\\leftrightarrow{}&\n\\mathrm{LimitOrdinal}_S(\\lambda)\\land\\lambda\\neq0\n\\land\\mathrm{Function}(\\vec M,\\operatorname{dom}(\\vec M),\\operatorname{ran}(\\vec M))\\land\\lambda\\subseteq\\operatorname{dom}(\\vec M)\n\\land\\mathrm{Function}(\\vec j,\\operatorname{dom}(\\vec j),\\operatorname{ran}(\\vec j))\n\\land\\forall i\\leq h<\\lambda\\;\\bigl(\\langle i,h\\rangle\\in\\operatorname{dom}(\\vec j)\\land\\mathrm{Function}(j_{ih},M_i,M_h)\\bigr)\n\\land\\mathrm{Function}(\\vec k,\\lambda,\\operatorname{ran}(\\vec k))\\\\\n&\\land\\exists D,E,Q,R,\\pi\\in V\\;\\Biggl[\nD=\\{\\langle i,x\\rangle:i<\\lambda\\land x\\in M_i\\}\\\\\n&\\quad\\land E=\\Bigl\\{\n\\langle\\langle i,x\\rangle,\\langle j,y\\rangle\\rangle\\in D\\times D:\n\\exists k<\\lambda\\;\\bigl(i,j\\leq k\n\\land j_{ik}(x)=j_{jk}(y)\\bigr)\\Bigr\\}\\\\\n&\\quad\\land\\mathrm{QuotientSet}_S(Q,D,E)\\\\\n&\\quad\\land R=\\Bigl\\{\n\\langle[\\langle i,x\\rangle]_E,[\\langle j,y\\rangle]_E\\rangle:\ni,j<\\lambda\\land x\\in M_i\\land y\\in M_j\\land\\exists k<\\lambda\\;\\bigl(i,j\\leq k\n\\land j_{ik}(x)\\in j_{jk}(y)\\bigr)\\Bigr\\}\\\\\n&\\quad\\land\\mathrm{MostowskiCollapse}_S(Q,R,N,\\pi)\\\\\n&\\quad\\land\\forall i<\\lambda\\;\\Bigl(\n\\mathrm{Function}(\\vec k(i),M_i,N)\n\\land\\forall x\\in M_i\\;\n\\vec k(i)(x)=\\pi([\\langle i,x\\rangle]_E)\\Bigr)\n\\Biggr].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}normal\\text{-}measure\\text{-}iteration}\\vdash_{\\mathsf{meta}}\n\\mathrm{NormalMeasureIteration}_S\n(\\mathcal I;M,\\kappa,U,\\alpha)\\\\\n\\leftrightarrow{}&\n\\exists\\vec M,\\vec\\kappa,\\vec U,\\vec j\\in V\\;\\Biggl[\n\\mathcal I=\\langle\\vec M,\\vec\\kappa,\\vec U,\\vec j\\rangle\n\\land\\mathrm{Function}(\\vec M,\\alpha+1,\\operatorname{ran}(\\vec M))\n&\\quad\\land\\mathrm{Function}(\\vec\\kappa,\\alpha+1,\\operatorname{ran}(\\vec\\kappa))\n\\land\\mathrm{Function}(\\vec U,\\alpha+1,\\operatorname{ran}(\\vec U))\\\\\n&\\quad\\land\\mathrm{Function}(\\vec j,\\{\\langle i,h\\rangle\\in(\\alpha+1)\\times(\\alpha+1):i\\leq h\\},\\operatorname{ran}(\\vec j))\\\\\n&\\quad\\land\\forall i\\leq h\\leq\\alpha\\;\\mathrm{Function}(j_{ih},M_i,M_h)\n&\\quad\\land M_0=M\\land\\kappa_0=\\kappa\\land U_0=U\n\\land\\forall i\\leq\\alpha\\;(\n\\kappa_i=j_{0i}(\\kappa)\\land U_i=j_{0i}(U))\\\\\n&\\quad\\land\\forall i<\\alpha\\;\n\\mathrm{InternalUltrapower}_S\n(M_{i+1},j_{i,i+1};M_i,\\kappa_i,U_i)\\\\\n&\\quad\\land\\forall\\lambda\\leq\\alpha\\;\\Bigl(\n\\mathrm{LimitOrdinal}_S(\\lambda)\\land\\lambda\\neq0\\to\n\\mathrm{DirectLimitSystem}_S\n(M_\\lambda,\\langle j_{i\\lambda}:i<\\lambda\\rangle;\n\\vec M,\\vec j,\\lambda)\\Bigr)\\\\\n&\\quad\\land\\forall i\\leq\\alpha\\;\n\\mathrm{WF}(\\in\\cap(M_i\\times M_i),M_i)\\\\\n&\\quad\\land\\forall i\\leq j\\leq k\\leq\\alpha\\;\\Bigl(\nj_{ii}=\\operatorname{id}_{M_i}\n\\land j_{ik}=j_{jk}\\circ j_{ij}\\Bigr)\n\\Biggr].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{thm\\text{-}iterated\\text{-}ultrapower}\\vdash_{\\mathsf{meta}}\n\\mathrm{TransitiveModel}_S(M)\n\\land\\kappa,U\\in M\n\\land\\mathrm{NormalMeasure}_S(U,\\kappa)\n\\land\\mathrm{Ordinal}(\\alpha)\\\\\n&\\to\\exists\\mathcal I\\in V\\;\n\\mathrm{NormalMeasureIteration}_S\n(\\mathcal I;M,\\kappa,U,\\alpha).\n\\end{aligned}","display":true},{"tex":"M_i^{\\kappa_i}/U_i","display":false}],"bytes":5736,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4236","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-thm-iterated-ultrapower.md|58-thm-iterated-ultrapower]]（batch01）"}],"outgoing":["2e059389c097fae1","a9132c2c1a18acd1","7308daa58e0345ed","5582a281f15a33c2","81cabbac7fa4d75d","9ced46394294c1a6","b6ec5105268243bd","36d7463d215be751"]}