TreeOrder}_S\\subseteq V^2\">\\(\\mathrm{ZfcTree8TreeOrder}_S\\subseteq V^2\\)</span> (tree-order predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCard6CountableSet}_S\\subseteq V\">\\(\\mathrm{ZfcCard6CountableSet}_S\\subseteq V\\)</span> (at-most-countable predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTree9CountablyBranchingTree}_S\\subseteq V\">\\(\\mathrm{ZfcTree9CountablyBranchingTree}_S\\subseteq V\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}tree9\\text{-}countably\\text{-}branching\\text{-}tree} \\vdash \\mathrm{ZfcTree9CountablyBranchingTree}_S(T)\\leftrightarrow \\exists\\sqsubseteq_T\\in V\\;\\Bigl(\\sqsubseteq_T=\\{\\langle s,t\\rangle\\in T\\times T:s\\subseteq t\\}\\land\\mathrm{ZfcTree8TreeOrder}_S(T,\\sqsubseteq_T)\\land\\forall s\\in T\\;\\mathrm{ZfcCard6CountableSet}_S\\!\\left(\\{t\\in T:s\\subsetneq t\\land\\neg\\exists u\\in T\\;(s\\subsetneq u\\land u\\subsetneq t)\\}\\right)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}tree9\\text{-}countably\\text{-}branching\\text{-}tree} \\vdash \\mathrm{ZfcTree9CountablyBranchingTree}_S(T)\\leftrightarrow \\exists\\sqsubseteq_T\\in V\\;\\Bigl(\\sqsubseteq_T=\\{\\langle s,t\\rangle\\in T\\times T:s\\subseteq t\\}\\land\\mathrm{ZfcTree8TreeOrder}_S(T,\\sqsubseteq_T)\\land\\forall s\\in T\\;\\mathrm{ZfcCard6CountableSet}_S\\!\\left(\\{t\\in T:s\\subsetneq t\\land\\neg\\exists u\\in T\\;(s\\subsetneq u\\land u\\subsetneq t)\\}\\right)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Countable branching is imposed on the set of immediate successors of each node, not on an entire cone or level.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},