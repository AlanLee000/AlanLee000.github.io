,"display":true},{"tex":"\\operatorname{FV}_{\\mathsf{IS4}}(\\Box A)=\\operatorname{FV}_{\\mathsf{IS4}}(A),\n\\qquad\n\\operatorname{FV}_{\\mathsf{IS4}}(\\Diamond A)=\\operatorname{FV}_{\\mathsf{IS4}}(A).","display":true},{"tex":"\\operatorname{BV}_{\\mathsf{IS4}}:\n\\mathsf{Frm}_{\\mathsf{IS4}}\\to\\mathcal P_{\\mathrm{fin}}(\\mathsf{Prop}),\n\\qquad\n\\operatorname{BV}_{\\mathsf{IS4}}(A)=\\varnothing.","display":true},{"tex":"\\operatorname{Sub}_{\\mathsf{IS4}}:\n\\mathsf{Frm}_{\\mathsf{IS4}}\\times\\mathsf{Prop}\\times\\mathsf{Frm}_{\\mathsf{IS4}}\\to\\mathsf{Frm}_{\\mathsf{IS4}}","display":true},{"tex":"\\operatorname{var}(q)[p:=B]=\n\\begin{cases}\nB,&q=p,\\\\\n\\operatorname{var}(q),&q\\ne p,\n\\end{cases}","display":true},{"tex":"\\bot[p:=B]=\\bot,","display":true},{"tex":"(A\\to C)[p:=B]=A[p:=B]\\to C[p:=B],\n\\quad\n(A\\land C)[p:=B]=A[p:=B]\\land C[p:=B],","display":true},{"tex":"(A\\lor C)[p:=B]=A[p:=B]\\lor C[p:=B],","display":true},{"tex":"(\\Box A)[p:=B]=\\Box(A[p:=B]),\n\\qquad\n(\\Diamond A)[p:=B]=\\Diamond(A[p:=B]).","display":true},{"tex":"\\equiv_{\\alpha,\\mathsf{IS4}}\\subseteq\n\\mathsf{Frm}_{\\mathsf{IS4}}\\times\\mathsf{Frm}_{\\mathsf{IS4}},\n\\qquad\nA\\equiv_{\\alpha,\\mathsf{IS4}}B\\Longleftrightarrow A=B.","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{IPC}}^{\\mathsf{IS4}}","display":false},{"tex":"\\mathsf{Frm}_{\\mathsf{IS4}}","display":false},{"tex":"\\{A\\to(B\\to A)\\}\\cup\n\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C))\\}\\cup\n\\{A\\land B\\to A\\}\\cup\n\\{A\\land B\\to B\\}","display":true},{"tex":"\\cup\\{A\\to(B\\to A\\land B)\\}\\cup\n\\{A\\to A\\lor B\\}\\cup\n\\{B\\to A\\lor B\\}\n\\cup\\{(A\\to C)\\to((B\\to C)\\to(A\\lor B\\to C))\\}\n\\cup\\{\\bot\\to A\\},","display":true},{"tex":"A,B,C\\in\\mathsf{Frm}_{\\mathsf{IS4}}","display":false},{"tex":"\\begin{aligned}\n\\mathsf{Ax}_{\\mathsf{IPC},1}^{\\mathsf{IS4}}&=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},2}^{\\mathsf{IS4}}&=\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},3}^{\\mathsf{IS4}}&=\\{A\\land B\\to A:A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},4}^{\\mathsf{IS4}}&=\\{A\\land B\\to B:A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},5}^{\\mathsf{IS4}}&=\\{A\\to(B\\to A\\land B):A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},6}^{\\mathsf{IS4}}&=\\{A\\to A\\lor B:A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},7}^{\\mathsf{IS4}}&=\\{B\\to A\\lor B:A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},&\n\\mathsf{Ax}_{\\mathsf{IPC},8}^{\\mathsf{IS4}}&=\\{(A\\to C)\\to((B\\to C)\\to(A\\lor B\\to C)):A,B,C\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},\\\\\n\\mathsf{Ax}_{\\mathsf{IPC},9}^{\\mathsf{IS4}}&=\\{\\bot\\to A:A\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\}.\n\\end{aligned}","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{IPC}}^{\\mathsf{IS4}}=\\bigcup_{1\\le i\\le9}\\mathsf{Ax}_{\\mathsf{IPC},i}^{\\mathsf{IS4}}","display":false},{"tex":"\\mathsf{Ax}_{\\Box K}^{\\mathsf{IS4}}\n=\n\\{\\Box(A\\to B)\\to(\\Box A\\to\\Box B):A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\Diamond K}^{\\mathsf{IS4}}\n=\n\\{\\Box(A\\to B)\\to(\\Diamond A\\to\\Diamond B):A,B\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\Box T}^{\\mathsf{IS4}}\n=\n\\{\\Box A\\to A:A\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\Box4}^{\\mathsf{IS4}}\n=\n\\{\\Box A\\to\\Box\\Box A:A\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\Diamond T}^{\\mathsf{IS4}}\n=\n\\{A\\to\\Diamond A:A\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\Diamond4}^{\\mathsf{IS4}}\n=\n\\{\\Diamond\\Diamond A\\to\\Diamond A:A\\in\\mathsf{Frm}_{\\mathsf{IS4}}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{IS4}}\n=\n\\mathsf{Ax}_{\\mathsf{IPC}}^{\\