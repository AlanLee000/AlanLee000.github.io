thbb N\\;(s\\ge s_0\\Rightarrow g(x,s)=\\chi_A(x))).","display":true}],"bytes":1248,"backlinks":[{"id":"f5b5175508d7a1c1","anchor":"ref-72","locations":["正文"],"count":1,"excerpt":"[[43-thm-relative-limit]] — 相对极限引理"}],"outgoing":["0784d1de3a88cd94","b3936ae4c5d2dc79","f357216a7edb035a"]}