\lambda_{\\mathcal C},R)\\\\\n&\\hspace{15mm}{}\\land\n\\mathcal A_X=\\{A\\times Y:A\\in\\mathcal B_X\\}\n\\land\\mathcal A_Y=\\{X\\times B:B\\in\\mathcal B_Y\\}\\\\\n&\\hspace{15mm}{}\\land\n\\mathcal C_*=\n\\bigl\\{\\{\\langle x,y\\rangle\\in X\\times Y:q_X(x)\\in C\\}:C\\in\\mathcal C\\bigr\\}\\\\\n&\\hspace{15mm}{}\\land\n\\forall C\\in\\mathcal C\\;\n\\lambda\\Bigl(\n\\bigl(q_X^{-1}[C]\\times Y\\bigr)\n\\mathbin\\triangle\n\\bigl(X\\times q_Y^{-1}[C]\\bigr)\\Bigr)=0\\\\\n&\\hspace{15mm}{}\\land\n\\mathrm{ZfcMeasure8ConditionalIndependence}_S(\nX\\times Y,\\mathcal B_{X\\times Y},\\lambda,\n\\mathcal A_X,\\mathcal A_Y,\\mathcal C_*)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"R","display":false},{"tex":"q_X","display":false},{"tex":"q_Y","display":false},{"tex":"\\mathcal B_{X\\times Y}","display":false},{"tex":"C\\in\\mathcal C","display":false},{"tex":"\\lambda","display":false}],"bytes":4040,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2658","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-measure8-relatively-independent-joining.md|58-df-zfc-measure8-relatively-independent-joining]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","4a3373ca17fc93e6","3579e07be41aa5cd","a8bb827e3e31f34f","d4d304b0bbb11c1a","93f2d1f40aee7116","6be89bf537c52975"]}