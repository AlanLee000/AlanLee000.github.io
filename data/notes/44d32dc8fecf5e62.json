{"id":"44d32dc8fecf5e62","group":"58","path":"58/batch09/58-df-range.md","title":"Range of Relation","display":"df-range — Range of Relation","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-range","aliases":["58-df-range"],"display":"df-range — Range of Relation","depends_on":["[[../batch18/58-df-relation.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-range"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-range</span></div>"},{"key":"display","html":"df-range — Range of Relation"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"7ccfc8c88f29968a\" href=\"?note=7ccfc8c88f29968a\" title=\"../batch18/58-df-relation.md\">../batch18/58-df-relation.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"A,B,R\\in V\">\\(A,B,R\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Rel}_S\\subseteq V^3\">\\(\\mathrm{Rel}_S\\subseteq V^3\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{ran}:V\\to V\">\\(\\operatorname{ran}:V\\to V\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}range} \\vdash \\mathrm{Rel}_S(R,A,B)\\to\\operatorname{ran}(R)=\\{b\\in B:\\exists a\\in A\\;(\\langle a,b\\rangle\\in R)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}range} \\vdash \\mathrm{Rel}_S(R,A,B)\\to\\operatorname{ran}(R)=\\{b\\in B:\\exists a\\in A\\;(\\langle a,b\\rangle\\in R)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Symbol\">[Symbol]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\