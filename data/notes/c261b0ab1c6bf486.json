uring-reduction]]；有限层的可归约刻画使用 [[88-thm-post-theorem]]。","embed":false}],"math":[{"tex":"\\mathrm{HYP}","display":false},{"tex":"H_a","display":false},{"tex":"\\mathcal O_{88}","display":false},{"tex":"\\Sigma_n^0,\\Pi_n^0","display":false},{"tex":"n=0","display":false},{"tex":"\\emptyset^{(n)}","display":false},{"tex":"\\leq_T","display":false},{"tex":"\\mathrm{prop\\text{-}hyp\\text{-}contains\\text{-}arith}\\vdash\n\\exists a:\\mathbb N\\to\\mathcal O_{88}\\;\n\\Bigl(a(0)=1\\land\\forall n\\in\\mathbb N\\;\n(a(n+1)=2^{a(n)}\\land H_{a(n)}=\\emptyset^{(n)})\\Bigr)","display":true},{"tex":"\\mathrm{prop\\text{-}hyp\\text{-}contains\\text{-}arith}\\vdash\n\\forall n\\in\\mathbb N\\;\n(\\Sigma_n^0\\cup\\Pi_n^0\\subseteq\\mathrm{HYP})","display":true},{"tex":"a(0)=1","display":false},{"tex":"a(n+1)=2^{a(n)}","display":false},{"tex":"\\mathcal O_{88}","display":false},{"tex":"H_{a(n)}=\\emptyset^{(n)}","display":false},{"tex":"n=0","display":false},{"tex":"H_1=\\emptyset","display":false},{"tex":"n\\geq1","display":false},{"tex":"\\Sigma_n^0","display":false},{"tex":"\\emptyset^{(n)}","display":false},{"tex":"\\Pi_n^0","display":false},{"tex":"\\mathrm{HYP}","display":false}],"bytes":2018,"backlinks":[],"outgoing":["a8bec8cb4c1a4891","ca39023cb294c484","6587ae27f7ed289f","b23177f17eeaa7a2","17e23d087321028e","c78101abe1090034","2b6a4a081d493b4c","ceb241b03d936136","4b6966788d04924e"]}