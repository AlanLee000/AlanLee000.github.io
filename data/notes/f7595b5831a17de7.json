{"id":"f7595b5831a17de7","group":"58","path":"58/batch17/58-df-zfc-measure5-finite-measure.md","title":"ZFC Measure5 Finite Measure","display":"df-zfc-measure5-finite-measure — ZFC Measure5 Finite Measure","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-measure5-finite-measure","aliases":["58-df-zfc-measure5-finite-measure"],"display":"df-zfc-measure5-finite-measure — ZFC Measure5 Finite Measure","depends_on":["[[../batch02/58-ax-zfc.md]]","[[../batch19/58-df-zfc-measure5-measure-on-space.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-measure5-finite-measure"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-measure5-finite-measure</span></div>"},{"key":"display","html":"df-zfc-measure5-finite-measure — ZFC Measure5 Finite Measure"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"../batch02/58-ax-zfc.md\">../batch02/58-ax-zfc.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"6bcdecbdd77201ee\" href=\"?note=6bcdecbdd77201ee\" title=\"../batch19/58-df-zfc-measure5-measure-on-space.md\">../batch19/58-df-zfc-measure5-measure-on-space.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\mathcal A,\\mu\">\\(X,\\mathcal A,\\mu\\)</span> (measure-space data)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure5MeasureOnSpace}_S\">\\(\\mathrm{ZfcMeasure5MeasureOnSpace}_S\\)</span> (measure predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"6bcdecbdd77201ee\" href=\"?note=6bcdecbdd77201ee\" title=\"../batch19/58-df-zfc-measure5-measure-on-space.md\">../batch19/58-df-zfc-measure5-measure-on-space.md</a>)</l