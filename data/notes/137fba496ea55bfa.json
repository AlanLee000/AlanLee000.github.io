\\to_m((A\\land_m\\Box_m C)\\triangleright(B\\land_m\\Box_m C)):A,B,C\\in\\mathcal F_{\\triangleright}\\},\\\\\nH^\\epsilon_0&:=\\mathsf{PT}_I\\cup\\mathsf K_I\\cup\\mathsf L_I\\cup\\bigcup_{1\\le j\\le5}\\mathsf J_j\\cup\\mathsf M_\\epsilon,\\\\\nH^\\epsilon_{n+1}&:=H^\\epsilon_n\\cup\\{B\\in\\mathcal F_{\\triangleright}:\\exists A\\in H^\\epsilon_n\\ ((A\\to_m B)\\in H^\\epsilon_n)\\}\\cup\\{\\Box_m A:A\\in H^\\epsilon_n\\},\\\\\n\\mathsf{IL}_\\epsilon&:=\\bigcup_{n\\in\\omega}H^\\epsilon_n,\\qquad\n\\mathsf{IL}:=\\mathsf{IL}_0,\\quad\\mathsf{ILM}:=\\mathsf{IL}_1,\\\\\n\\vdash_{\\mathsf{IL}_\\epsilon} A&:\\Longleftrightarrow A\\in\\mathsf{IL}_\\epsilon.\n\\end{aligned}","display":true}],"bytes":3150,"backlinks":[{"id":"e6c99e2646691c7d","anchor":"ref-78","locations":["正文"],"count":1,"excerpt":"VII章新增11项：[[72-df-il-ilm-calculi]] · [[72-df-interpretability-modal-language]] · [[72-df-minimal-veltman-expansion]] · [[72-df-veltman-forcing]] · [[72-df-veltman-frame]] · [[72-ex-veltman-non-montagna-frame]] · [[72-lem-interpretability-box-definition]] · [[72-thm-il-conservative-over-gl]] · [[72-thm-ilm-proper-extension]] · [[72-thm-interpretability-kripke-soundness]] · [[72-thm-montagna-frame-correspondence]]"},{"id":"6aa9c9e25ba49583","anchor":"ref-74","locations":["正文"],"count":1,"excerpt":"VII章新增11项：[[72-df-il-ilm-calculi]] · [[72-df-interpretability-modal-language]] · [[72-df-minimal-veltman-expansion]] · [[72-df-veltman-forcing]] · [[72-df-veltman-frame]] · [[72-ex-veltman-non-montagna-frame]] · [[72-lem-interpretability-box-definition]] · [[72-thm-il-conservative-over-gl]] · [[72-thm-ilm-proper-extension]] · [[72-thm-interpretability-kripke-soundness]] · [[72-thm-montagna-frame-correspondence]]"},{"id":"585b23d932148aa0","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"4d85a6a31705a214","anchor":"ref-74","locations":["正文"],"count":1,"excerpt":"VII章新增11项：[[72-df-il-ilm-calculi]] · [[72-df-interpretability-modal-language]] · [[72-df-min