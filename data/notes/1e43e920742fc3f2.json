al.md]])","embed":false},{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-9","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Poset}:V^2\\to\\{\\top,\\bot\\}$ (see [[../batch02/58-df-poset.md]])","embed":false},{"target":"../batch16/58-df-generic.md","status":"resolved","id":"545853811ce0a4b6","anchor":"ref-10","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Generic}:V^4\\to\\{\\top,\\bot\\}$ (see [[../batch16/58-df-generic.md]])","embed":false},{"target":"../batch13/58-df-generic-extension.md","status":"resolved","id":"76dde059f166d3e6","anchor":"ref-11","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{GenericExtension}_S:V^4\\to\\{\\top,\\bot\\}$ (see [[../batch13/58-df-generic-extension.md]])","embed":false},{"target":"../batch09/58-df-elementary.md","status":"resolved","id":"e91c1261e1c2374b","anchor":"ref-12","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ElementarySubstructure}_S:V^3\\to\\{\\top,\\bot\\}$ (see [[../batch09/58-df-elementary.md]])","embed":false}],"math":[{"tex":"M,N,W,\\mathbb P,R,\\mathbb Q,S,\\kappa,G,H,\\mathcal L_{\\in}\\in V","display":false},{"tex":"\\mathrm{TransitiveSet}_S,\\mathrm{RegularCardinal}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Poset}:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Generic}:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{GenericExtension}_S:V^4\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathfrak H_\\kappa(N)\\in V","display":false},{"tex":"H_\\kappa^N","display":false},{"tex":"\\mathrm{ElementarySubstructure}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Res}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathcal L_{\\in}","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}resurrecting}\\vdash_{\\mathsf{meta}}{}&\\mathrm{Res}_S(\\mathbb P,R,\\kappa,M,\\ma