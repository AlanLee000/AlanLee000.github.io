),\\langle a,b\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\forall,\\langle i,a\\rangle,\\mathsf{nd}(\\pi(7,i),\\langle a\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\land,\\langle a,b\\rangle,\\mathsf c_\\neg(\\mathsf c_\\lor(\\mathsf c_\\neg(a),\\mathsf c_\\neg(b)))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\to,\\langle a,b\\rangle,\\mathsf c_\\lor(\\mathsf c_\\neg(a),b)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\leftrightarrow,\\langle a,b\\rangle,\\mathsf c_\\land(\\mathsf c_\\to(a,b),\\mathsf c_\\to(b,a))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\exists,\\langle i,a\\rangle,\\mathsf c_\\neg(\\mathsf c_\\forall(i,\\mathsf c_\\neg(a)))) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{FVC}_\\in,\\langle c\\rangle,X,\\mathsf{FVG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{AVC}_\\in,\\langle c\\rangle,X,\\mathsf{AVG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{subc},\\langle c\\rangle,X,\\mathsf{SubG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(m,\\langle c\\rangle,n,\\mathsf{MG}_\\in(c,n)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{RenC}_\\in,\\langle c,i,j\\rangle,r,\\mathsf{Ren}_\\in(c,i,j,r)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{UclC}_\\in,\\langle c\\rangle,r,\\mathsf{UclG}_\\in(c,r)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf r,\\langle i,j,k\\rangle,z,(k=i\\land z=j)\\lor(k\\ne i\\land z=k)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf{FreshC},\\langle d,j\\rangle,\\min(\\omega\\setminus(\\mathsf{AVC}_\\in(d)\\cup\\{j\\}))) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{UnqC},\\langle d,j\\rangle,r,\\exists z(z=\\mathsf{FreshC}(d,j)\\land r=\\mathsf c_\\exists(j,\\mathsf c_\\land(d,\\mathsf c_\\forall(z,\\mathsf c_\\to(\\mathsf{RenC}_\\in(d,j,z),\\mathsf c_=(z,j))))))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf{SepC},\\langle d,i,a,b\\rangle,\\mathsf{UclC}_\\in(\\mathsf c_\\forall(a,\\mathsf c_\\exists(b,\\mathsf c_\\forall(i,\\mathsf c_\\leftrightarrow(\\mathsf c_\\in(i,b),\\mathsf c_\\land(\\mathsf c_\\in(i,a),d))))))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf{RepC},\\langle d,i,j,a,b\\rangle,\\mathsf{UclC}_\\in(\\mathsf c_\\forall(a,\\mathsf c_\\to(\\mathsf c_\\forall(i,\\mathsf c_\\to(\\mathsf c_\\in(i,a),\\mathsf{UnqC}(d,j))),\\mathsf c_\\exists(b,\\mathsf c_\\forall(j,\\mathsf c_\\leftrightarrow(\\mathsf c_\\in(j,b),\\mathsf c_\\exists(i,\\mathsf c_\\land(\\mathsf c_\\in(i,a),d)))))))))\\},\\\\\n\\mathcal D&amp;=\\mathcal B_{\\rm lang}^{+}\\cup\\mathcal B_{\\rm syn},\\quad\\mathsf{Admissible}(\\mathcal D).\\\\\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathcal B_{\\rm syn}&amp;\\coloneqq\\{\\mathsf{RegR}(\\mathsf{Shape}_\\in,\\langle d,D\\rangle,\\mathsf{Shape}_\\in(d,D)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{SynRec}_\\in,\\langle c,D,F,A,C\\rangle,\\mathsf{SynRec}_\\in(c,D,F,A,C)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{FC}^{\\mathrm{ob}}_\\in,\\langle c\\rangle,\\mathsf{FC}^{\\mathrm{ob}}_\\in(c)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{SC}^{\\mathrm{ob}}_\\in,\\langle c\\rangle,\\mathsf{SC}^{\\mathrm{ob}}_\\in(c)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{FVG}_\\in,\\langle c,X\\rangle,\\mathsf{FVG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{AVG}_\\in,\\langle c,X\\rangle,\\mathsf{AVG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{SubG}_\\in,\\langle c,X\\rangle,\\mathsf{SubG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{MG}_\\in,\\langle c,n\\rangle,\\mathsf{MG}_\\in(c,n)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{Ren}_\\in,\\langle c,i,j,r\\rangle,\\mathsf{Ren}_\\in(c,i,j,r)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{UclG}_\\in,\\langle c,r\\rangle,\\mathsf{UclG}_\\in(c,r)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{BaseAx}^{\\mathrm{ob}}_\\in,\\langle c\\rangle,\\mathsf{BaseAx}^{\\mathrm{ob}}_\\in(c)) ,\\\\\n&amp;\\qquad \\mathsf{RegR}(\\mathsf{AxZF}^{\\mathrm{ob}},\\langle c\\rangle,\\mathsf{AxZF}^{\\mathrm{ob}}(c)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_v,\\langle i\\rangle,\\mathsf{nd}(\\pi(0,i),\\langle\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_=,\\langle i,j\\rangle,\\mathsf{nd}(\\pi(3,0),\\langle\\mathsf c_v(i),\\mathsf c_v(j)\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\in,\\langle i,j\\rangle,\\mathsf{nd}(\\pi(4,0),\\langle\\mathsf c_v(i),\\mathsf c_v(j)\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\neg,\\langle a\\rangle,\\mathsf{nd}(\\pi(5,0),\\langle a\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\lor,\\langle a,b\\rangle,\\mathsf{nd}(\\pi(6,0),\\langle a,b\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\forall,\\langle i,a\\rangle,\\mathsf{nd}(\\pi(7,i),\\langle a\\rangle)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\land,\\langle a,b\\rangle,\\mathsf c_\\neg(\\mathsf c_\\lor(\\mathsf c_\\neg(a),\\mathsf c_\\neg(b)))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\to,\\langle a,b\\rangle,\\mathsf c_\\lor(\\mathsf c_\\neg(a),b)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\leftrightarrow,\\langle a,b\\rangle,\\mathsf c_\\land(\\mathsf c_\\to(a,b),\\mathsf c_\\to(b,a))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf c_\\exists,\\langle i,a\\rangle,\\mathsf c_\\neg(\\mathsf c_\\forall(i,\\mathsf c_\\neg(a)))) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{FVC}_\\in,\\langle c\\rangle,X,\\mathsf{FVG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{AVC}_\\in,\\langle c\\rangle,X,\\mathsf{AVG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{subc},\\langle c\\rangle,X,\\mathsf{SubG}_\\in(c,X)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(m,\\langle c\\rangle,n,\\mathsf{MG}_\\in(c,n)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{RenC}_\\in,\\langle c,i,j\\rangle,r,\\mathsf{Ren}_\\in(c,i,j,r)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{UclC}_\\in,\\langle c\\rangle,r,\\mathsf{UclG}_\\in(c,r)) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf r,\\langle i,j,k\\rangle,z,(k=i\\land z=j)\\lor(k\\ne i\\land z=k)) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf{FreshC},\\langle d,j\\rangle,\\min(\\omega\\setminus(\\mathsf{AVC}_\\in(d)\\cup\\{j\\}))) ,\\\\\n&amp;\\qquad \\mathsf{RegG}(\\mathsf{UnqC},\\langle d,j\\rangle,r,\\exists z(z=\\mathsf{FreshC}(d,j)\\land r=\\mathsf c_\\exists(j,\\mathsf c_\\land(d,\\mathsf c_\\forall(z,\\mathsf c_\\to(\\mathsf{RenC}_\\in(d,j,z),\\mathsf c_=(z,j))))))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf{SepC},\\langle d,i,a,b\\rangle,\\mathsf{UclC}_\\in(\\mathsf c_\\forall(a,\\mathsf c_\\exists(b,\\mathsf c_\\forall(i,\\mathsf c_\\leftrightarrow(\\mathsf c_\\in(i,b),\\mathsf c_\\land(\\mathsf c_\\in(i,a),d))))))) ,\\\\\n&amp;\\qquad \\mathsf{RegE}(\\mathsf{RepC},\\langle d,i,j,a,b\\rangle,\\mathsf{UclC}_\\in(\\mathsf c_\\forall(a,\\mathsf c_\\to(\\mathsf c_\\forall(i,\\mathsf c_\\to(\\mathsf c_\\in(i,a),\\mathsf{UnqC}(d,j))),\\mathsf c_\\exists(b,\\mathsf c_\\forall(j,\\mathsf c_\\leftrightarrow(\\mathsf c_\\in(j,b),\\mathsf c_\\exists(i,\\mathsf c_\\land(\\mathsf c_\\in(i,a),d)))))))))\\},\\\\\n\\mathcal D&amp;=\\mathcal B_{\\rm lang}^{+}\\cup\\mathcal B_{\\rm syn},\\quad\\mathsf{Admissible}(\\mathcal D).\\\\\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathsf r_{i,j}(k)=\\mathsf r(i,j,k).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathsf r_{i,j}(k)=\\mathsf r(i,j,k).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathsf{subc}(c)&amp;\\coloneqq\\iota X\\ \\mathsf{SubG}_\\in(c,X),\\quad\nm(c)\\coloneqq\\iota n\\ \\mathsf{MG}_\\in(c,n)\\quad(c\\in\\omega),\\\\\n&amp;\\forall c\\in\\omega\\ ((\\exists!X\\ \\mathsf{SubG}_\\in(c,X))\\land(\\exists!n\\ \\mathsf{MG}_\\in(c,n))).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathsf{subc}(c)&amp;\\coloneqq\\iota X\\ \\mathsf{SubG}_\\in(c,X),\\quad\nm(c)\\coloneqq\\iota n\\ \\mathsf{MG}_\\in(c,n)\\quad(c\\in\\omega),\\\\\n&amp;\\forall c\\in\\omega\\ ((\\exists!X\\ \\mathsf{SubG}_\\in(c,X))\\land(\\exists!n\\ \\mathsf{MG}_\\in(c,n))).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>合法码、自由变量、全部变量、子公式以及 ZF 公理码均在对象语言内部定义。合法性递归只读取严格较小的子码；替换只在明确的新鲜指标域内使用。ZF 的有限公理与两套模式分别处理，不把可满足性或所有集合论真句子的集合用作公理判定。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"89-df-settheoretic-language","status":"resolved","id":"22c2c4cecc692616","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[89-df-settheoretic-language]]","embed":false},{"target":"89-df-settheoretic-graph-notation","status":"resolved","id":"1076c7ed1730eab7","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[89-df-settheoretic-graph-notation]]","embed":false},{"target":"89-df-godel-numbering","status":"resolved","id":"7f53d84c2164d9c5","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[89-df-godel-numbering]]","embed":false}],"math":[{"tex":"g_\\in","display":false},{"tex":"\\mathsf c_v,\\mathsf c_=,\\mathsf c_\\in,\\mathsf c_\\neg,\\mathsf c_\\lor,\\mathsf c_\\forall","display":false},{"tex":"\\mathsf{SynRec}_\\in(c,D,F,A,C)","display":false},{"tex":"F,A,C","display":false},{"tex":"c+1","display":false},{"tex":"D","display":false},{"tex":"c","display":false},{"tex":"c+1","display":false},{"tex":"c\\cup\\{c\\}","display":false},{"tex":"\\mathsf{SetExp}","display":false},{"tex":"\\mathrm{ob}","display":false},{"tex":"\\mathsf{FC}_\\in,\\mathsf{SC}_\\in,\\mathsf{AxCode}_{\\mathrm{ZF}}","display":false},{"tex":"\\mathsf{Ren}_\\in(c,i,j,r)","display":false},{"tex":"c","display":false},{"tex":"j","display":false},{"tex":"\\mathsf{AVC}_\\in(c)","display":false},{"tex":"v_i","display":false},{"tex":"v_j","display":false},{"tex":"\\mathsf{UclC}_\\in","display":false},{"tex":"\\mathrm{ucl}","display":false},{"tex":"\\mathsf{SetExp}","display":false},{"tex":"g_\\in(B)","display":false},{"tex":"\\mathsf{Num}_{g_\\in(B)}","display":false},{"tex":"i,j,k,a,b,c,d,r\\in\\omega","display":false},{"tex":"\\mathsf r_{i,j}(k)","display":false},{"tex":"\\mathsf r(i,j,k)","display":false},{"tex":"\\mathrm{df\\text{-}settheoretic\\text{-}coded\\text{-}syntax}\\vdash\n\\begin{aligned}\n\\mathsf c_v(i)&\\coloneqq\\mathsf{nd}(\\pi(0,i),\\langle\\rangle),\\\\\n\\mathsf c_=(i,j)&\\coloneqq\\mathsf{nd}(\\pi(3,0),\\langle\\mathsf c_v(i),\\mathsf c_v(j)\\rangle),\\quad\n\\mathsf c_\\in(i,j)\\coloneqq\\mathsf{nd}(\\pi(4,0),\\langle\\mathsf c_v(i),\\mathsf c_v(j)\\rangle),\\\\\n\\mathsf c_\\neg(a)&\\coloneqq\\mathsf{nd}(\\pi(5,0),\\langle a\\rangle),\\quad\n\\mathsf c_\\lor(a,b)\\coloneqq\\mathsf{nd}(\\pi(6,0),\\langle a,b\\rangle),\\\\\n\\mathsf c_\\forall(i,a)&\\coloneqq\\mathsf{nd}(\\pi(7,i),\\langle a\\rangle),\\\\\n\\mathsf c_\\land(a,b)&\\coloneqq\\mathsf c_\\neg(\\mathsf c_\\lor(\\mathsf c_\\neg(a),\\mathsf c_\\neg(b))),\\quad\n\\mathsf c_\\to(a,b)\\coloneqq\\mathsf c_\\lor(\\mathsf c_\\neg(a),b),\\\\\n\\mathsf c_\\leftrightarrow(a,b)&\\coloneqq\\mathsf c_\\land(\\mathsf c_\\to(a,b),\\mathsf c_\\to(b,a)),\\quad\n\\mathsf c_\\exists(i,a)\\coloneqq\\mathsf c_\\neg(\\mathsf c_\\forall(i,\\mathsf c_\\neg(a))),\\\\\n\\mathsf{Shape}_\\in(d,D)&\\coloneqq\n[\\exists i,j<d+1\\ (d=\\mathsf c_=(i,j)\\lor d=\\mathsf c_\\in(i,j))]\\\\\n&\\quad\\lor[\\exists b\\in D\\cap d\\ d=\\mathsf c_\\neg(b)]\n\\lor[\\exists b,e\\in D\\cap d\\ d=\\mathsf c_\\lor(b,e)]\n\\lor[\\exists i<d+1\\ \\exists b\\in D\\cap d\\ d=\\mathsf c_\\forall(i,b)],\\\\\n\\mathsf{SynRec}_\\in(c,D,F,A,C)&\\coloneqq\\mathsf{Nat}_0(c)\\land D\\subseteq c+1\\land\n(\\mathsf{Fn}_0(F)\\land\\mathsf{Dom}_0(F,c+1))\\land(\\mathsf{Fn}_0(A)\\land\\mathsf{Dom}_0(A,c+1))\\land(\\mathsf{Fn}_0(C)\\land\\mathsf{Dom}_0(C,c+1))\\\\\n&\\quad\\land\\forall d<c+1\\left[\n(d\\in D\\leftrightarrow\\mathsf{Shape}_\\in(d,D))\n\\land(d\\notin D\\to(F(d)=\\varnothing\\land A(d)=\\varnothing\\land C(d)=\\varnothing))\\right.\\\\\n&\\qquad\\land\\forall i,j<d+1\\left((d=\\mathsf c_=(i,j)\\lor d=\\mathsf c_\\in(i,j))\\to\n(F(d)=\\{i,j\\}\\land A(d)=\\{i,j\\}\\land C(d)=\\{d\\})\\right)\\\\\n&\\qquad\\land\\forall b\\in D\\cap d\\left(d=\\mathsf c_\\neg(b)\\to\n(F(d)=F(b)\\land A(d)=A(b)\\land C(d)=\\{d\\}\\cup C(b))\\right)\\\\\n&\\qquad\\land\\forall b,e\\in D\\cap d\\left(d=\\mathsf c_\\lor(b,e)\\to\n(F(d)=F(b)\\cup F(e)\\land A(d)=A(b)\\cup A(e)\\land C(d)=\\{d\\}\\cup C(b)\\cup C(e))\\right)\\\\\n&\\qquad\\left.\\land\\forall i<d+1\\ \\forall b\\in D\\cap d\\left(d=\\mathsf c_\\forall(i,b)\\to\n(F(d)=F(b)\\setminus\\{i\\}\\land A(d)=A(b)\\cup\\{i\\}\\land C(d)=\\{d\\}\\cup C(b))\\right)\\right],\\\\\n\\mathsf{FC}^{\\mathrm{ob}}_\\in(c)&\\coloneqq\\exists D\\exists F\\exists A\\exists C\n(\\mathsf{SynRec}_\\in(c,D,F,A,C)\\land c\\in D),\\\\\n\\mathsf{SC}^{\\mathrm{ob}}_\\in(c)&\\coloneqq\\exists D\\exists F\\exists A\\exists C\n(\\mathsf{SynRec}_\\in(c,D,F,A,C)\\land c\\in D\\land F(c)=\\varnothing),\\\\\n\\mathsf{FVG}_\\in(c,X)&\\coloneqq\\exists D\\exists F\\exists A\\exists C\n(\\mathsf{SynRec}_\\in(c,D,F,A,C)\\land X=F(c)),\\\\\n\\mathsf{AVG}_\\in(c,X)&\\coloneqq\\exists D\\exists F\\exists A\\exists C\n(\\mathsf{SynRec}_\\in(c,D,F,A,C)\\land X=A(c)),\\\\\n\\mathsf{SubG}_\\in(c,X)&\\coloneqq\\exists D\\exists F\\exists A\\exists C\n(\\mathsf{SynRec}_\\in(c,D,F,A,C)\\land X=C(c)),\\\\\n\\mathsf{MG}_\\in(c,n)&\\coloneqq\\exists D\\exists F\\exists A\\exists C\n\\left(\\mathsf{SynRec}_\\in(c,D,F,A,C)\\land\n[(c\\notin D\\land n=0)\\lor(c\\in D\\land n=1+\\max(\\{0\\}\\cup A(c)))]\\right),\\\\\n\\Gamma_{\\mathsf{FVC}_\\in}&\\coloneqq\\mathsf{FVG}_\\in,\\quad\n\\Gamma_{\\mathsf{AVC}_\\in}\\coloneqq\\mathsf{AVG}_\\in,\\quad\n\\Gamma_{\\mathsf{subc}}\\coloneqq\\mathsf{SubG}_\\in,\\quad\\Gamma_m\\coloneqq\\mathsf{MG}_\\in,\\\\\n\\mathsf r(i,j,k)&\\coloneqq\\begin{cases}j,&k=i,\\\\k,&k\\ne i,\\end{cases}\\quad\\mathsf r_{i,j}(k)\\coloneqq\\mathsf r(i,j,k)\\\\\n\\mathsf{Ren}_\\in(c,i,j,r)&\\coloneqq\n\\mathsf{FC}^{\\mathrm{ob}}_\\in(c)\\land\\mathsf{Nat}_0(i)\\land\\mathsf{Nat}_0(j)\n\\land j\\notin\\mathsf{AVC}_\\in(c)\\land\\exists h\\left[\\mathsf{Fun}_0(h,c+1,\\omega)\\land r=h(c)\\right.\\\\\n&\\quad\\land\\forall d<c+1\\left[(\\neg\\mathsf{FC}^{\\mathrm{ob}}_\\in(d)\\to h(d)=0)\\right.\\\\\n&\\qquad\\land\\forall k,l<d+1\\left(d=\\mathsf c_=(k,l)\\to h(d)=\\mathsf c_=(\\mathsf r_{i,j}(k),\\mathsf r_{i,j}(l))\\right)\\\\\n&\\qquad\\land\\forall k,l<d+1\\left(d=\\mathsf c_\\in(k,l)\\to h(d)=\\mathsf c_\\in(\\mathsf r_{i,j}(k),\\mathsf r_{i,j}(l))\\right)\\\\\n&\\qquad\\land\\forall b<d\\left(\\mathsf{FC}^{\\mathrm{ob}}_\\in(b)\\land d=\\mathsf c_\\neg(b)\\to h(d)=\\mathsf c_\\neg(h(b))\\right)\\\\\n&\\qquad\\land\\forall b,e<d\\left(\\mathsf{FC}^{\\mathrm{ob}}_\\in(b)\\land\\mathsf{FC}^{\\mathrm{ob}}_\\in(e)\\land d=\\mathsf c_\\lor(b,e)\n\\to h(d)=\\mathsf c_\\lor(h(b),h(e))\\right)\\\\\n&\\qquad\\left.\\left.\\land\\forall k<d+1\\ \\forall b<d\\left(\\mathsf{FC}^{\\mathrm{ob}}_\\in(b)\\land d=\\mathsf c_\\forall(k,b)\\to\n[(k=i\\to h(d)=d)\\land(k\\ne i\\to h(d)=\\mathsf c_\\forall(k,h(b)))]\\right)\\right]\\right],\\\\\n\\mathsf{UclG}_\\in(c,r)&\\coloneqq\\mathsf{FC}^{\\mathrm{ob}}_\\in(c)\\land\n\\exists s\\exists h\\left[\\mathsf{Inc}_0(\\mathsf{FVC}_\\in(c),s)\\land\\mathsf{Fun}_0(h,|s|+1,\\omega)\n\\land h(|s|)=c\\land r=h(0)\\land\\forall i<|s|\\ h(i)=\\mathsf c_\\forall(s_i,h(i+1))\\right],\\\\\n\\Gamma_{\\mathsf{RenC}_\\in}&\\coloneqq\\mathsf{Ren}_\\in,\\quad\n\\Gamma_{\\mathsf{UclC}_\\in}\\coloneqq\\mathsf{UclG}_\\in,\\\\\n\\mathsf{FreshC}(d,j)&\\coloneqq\\min\\left(\\omega\\setminus(\\mathsf{AVC}_\\in(d)\\cup\\{j\\})\\right),\\\\\n\\mathsf{UnqC}(d,j)&\\coloneqq\n\\mathsf c_\\exists\\left(j,\\mathsf c_\\land\\left(d,\n\\mathsf c_\\forall\\left(z,\\mathsf c_\\to(\\mathsf{RenC}_\\in(d,j,z),\\mathsf c_=(z,j))\\right)\\right)\\right)\n\\quad(z=\\mathsf{FreshC}(d,j)),\\\\\n\\mathsf{SepC}(d,i,a,b)&\\coloneqq\\mathsf{UclC}_\\in\\left(\n\\mathsf c_\\forall\\left(a,\\mathsf c_\\exists\\left(b,\\mathsf c_\\forall\\left(i,\n\\mathsf c_\\leftrightarrow(\\mathsf c_\\in(i,b),\\mathsf c_\\land(\\mathsf c_\\in(i,a),d))\\right)\\right)\\right)\\right),\\\\\n\\mathsf{RepC}(d,i,j,a,b)&\\coloneqq\\mathsf{UclC}_\\in\\left(\\mathsf c_\\forall\\left(a,\n\\mathsf c_\\to\\left(\\mathsf c_\\forall(i,\\mathsf c_\\to(\\mathsf c_\\in(i,a),\\mathsf{UnqC}(d,j))),\\right.\\right.\\right.\\\\\n&\\hspace{15mm}\\left.\\left.\\left.\\mathsf c_\\exists\\left(b,\\mathsf c_\\forall\\left(j,\n\\mathsf c_\\leftrightarrow\\left(\\mathsf c_\\in(j,b),\\mathsf c_\\exists(i,\\mathsf c_\\land(\\mathsf c_\\in(i,a),d))\\right)\\right)\\right)\\right)\\right)\\right),\\\\\n\\mathsf{BaseAx}^{\\mathrm{ob}}_\\in(c)&\\coloneqq\n\\bigvee_{j<7}\\mathsf{Num}_{g_\\in(B_j)}(c)\\quad(\\vec B=\\langle\\mathsf{Ext},\\mathsf{EmpAx},\\mathsf{PairAx},\\mathsf{UnionAx},\\mathsf{PowAx},\\mathsf{InfAx},\\mathsf{FoundAx}\\rangle),\\\\\n\\mathsf{AxZF}^{\\mathrm{ob}}(c)&\\coloneqq\\mathsf{BaseAx}^{\\mathrm{ob}}_\\in(c)\\\\\n&\\quad\\lor\\exists d,i,a,b\\in\\omega\\left[\\mathsf{FC}^{\\mathrm{ob}}_\\in(d)\\land i\\ne a\\land\nb\\notin\\mathsf{AVC}_\\in(d)\\cup\\{i,a\\}\\land c=\\mathsf{SepC}(d,i,a,b)\\right]\\\\\n&\\quad\\lor\\exists d,i,j,a,b\\in\\omega\\left[\\mathsf{FC}^{\\mathrm{ob}}_\\in(d)\\land i\\ne j\\land a\\ne b\n\\land a\\notin\\mathsf{AVC}_\\in(d)\\cup\\{i,j\\}\\land b\\notin\\mathsf{AVC}_\\in(d)\\cup\\{i,j\\}\n\\land c=\\mathsf{RepC}(d,i,j,a,b)\\right].\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathsf{FVC}_\\in(c)&\\coloneqq\\iota X\\ \\mathsf{FVG}_\\in(c,X),\\quad\n\\mathsf{AVC}_\\in(c)