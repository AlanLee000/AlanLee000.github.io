":"../batch20/58-df-lp-space.md","status":"resolved","id":"a1d034d5d39b4a14","anchor":"ref-11","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"外部接口 $\\mathrm{AeClass}$ 取 [[../batch20/58-df-lp-space.md]] 的同名定义与参数次序。","embed":false}],"math":[{"tex":"n\\in\\omega_{>0}","display":false},{"tex":"s\\in\\mathbb R","display":false},{"tex":"\\mathcal S_n=\\mathcal S_{\\mathbb C}(\\mathbb R^n)","display":false},{"tex":"\\mathcal B_n,\\lambda_n","display":false},{"tex":"\\mathcal S'_n","display":false},{"tex":"\\mathrm{ZfcAnaFourierTransform}_S","display":false},{"tex":"e^{-2\\pi i x\\cdot\\xi}","display":false},{"tex":"H^s(\\mathbb R^n)","display":false},{"tex":"L^2","display":false},{"tex":"\\|\\cdot\\|_{H^s}","display":false},{"tex":"J_n","display":false},{"tex":"\\mathcal S_n","display":false},{"tex":"\\mathcal B(\\mathbb C)","display":false},{"tex":"\\|\\xi\\|_2=(\\sum_{j\\in n}\\xi(j)^2)^{1/2}","display":false},{"tex":"aT+bU=\\{\\langle\\varphi,aT(\\varphi)+bU(\\varphi)\\rangle:\\varphi\\in\\mathcal S_n\\}","display":false},{"tex":"T,U\\in\\mathcal S'_n","display":false},{"tex":"a,b\\in\\mathbb C","display":false},{"tex":"\\mathrm{ComplexIntegralValue}","display":false},{"tex":"\\mathrm{ZfcAnaTemperedDistribution}","display":false},{"tex":"\\mathrm{Measurable}","display":false},{"tex":"\\mathrm{AeClass}","display":false},{"tex":"\\mathrm{BesselNormValue}","display":false},{"tex":"\\mathrm{FourierTemperedDistribution}","display":false},{"tex":"\\mathrm{RegularTemperedDistribution}","display":false},{"tex":"\\mathcal S'_n\\coloneqq\\{T\\in\\mathbb C^{\\mathcal S_n}:\\mathrm{ZfcAnaTemperedDistribution}_S(T,n)\\}.","display":true},{"tex":"\\begin{aligned}\n\\mathrm{RegularTemperedDistribution}_S(T,f,n)\\leftrightarrow{}&\nT\\in\\mathcal S'_n\\land f\\in\\mathbb C^{\\mathbb R^n}\n\\land\\mathrm{Measurable}_S(f;(\\mathbb R^n,\\mathcal B_n),(\\mathbb C,\\mathcal B(\\mathbb C)))\\\\\n&\\land\\forall\\varphi\\in\\mathcal S_n\\;\\mathrm{ComplexIntegralValue}_S\n\\bigl(T(\\varphi),\\{\\langle x,f(x)\\varphi(x)\\rangle:x\\in\\mathbb R^n\\},\\mathbb R^n,\\mathcal B_n,\\lambda_n\\bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{FourierTemperedDistribution}_S(U,T,n)\\leftrightarrow{}&T,U\\in\\mathcal S'_n\\\\\n&\\land\\forall\\varphi\\in\\mathcal S_n\\;\\exists\\psi\\in\\mathcal S_n\\;\n\\bigl(\\mathrm{ZfcAnaFourierTransform}_S(\\varphi,\\psi,n)\\land U(\\varphi)=T(\\psi)\\bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{BesselNormValue}_S(r,T,n,s)\\leftrightarrow{}&\nr\\in\\mathbb R_{\\ge0}\\land T\\in\\mathcal S'_n\\land s\\in\\mathbb R\\\\\n&\\land\\exists U\\in\\mathcal S'_n\\;\\exists g,w\\in\\mathbb C^{\\mathbb R^n}\\;\\exists v\\;\\Bigl[\n\\mathrm{FourierTemperedDistribution}_S(U,T,n)\\land\\mathrm{RegularTemperedDistribution}_S(U,g,n)\\\\\n&\\qquad\\land\\forall\\xi\\in\\mathbb R^n\\;(w(\\xi)=(1+4\\pi^2\\|\\xi\\|_2^2)^{s/2}g(\\xi))\\\\\n&\\qquad\\land v=\\mathrm{AeClass}_S(w;\\mathbb R^n,\\mathcal B_n,\\lambda_n)\n\\land v\\in L^2(\\mathbb R^n,\\mathcal B_n,\\lambda_n)\\land r=\\|v\\|_{L^2(\\mathbb R^n,\\mathcal B_n,\\lambda_n)}\\Bigr].\n\\end{aligned}","display":true},{"tex":"H^s(\\mathbb R^n)\\coloneqq\\{T\\in\\mathcal S'_n:\\exists r\\in\\mathbb R_{\\ge0}\\;\\mathrm{BesselNormValue}_S(r,T,n,s)\\}.","display":true},{"tex":"T\\in H^s(\\mathbb R^n)\\to\\exists!r\\in\\mathbb R_{\\ge0}\\;\\mathrm{BesselNormValue}_S(r,T,n,s).","display":true},{"tex":"T\\in H^s(\\mathbb R^n)\\to\n\\bigl(\\|T\\|_{H^s(\\mathbb R^n)}=r\\leftrightarrow\\mathrm{BesselNormValue}_S(r,T,n,s)\\bigr).","display":true},{"tex":"u\\in\\mathcal S_n\\to\\exists!T\\in\\mathcal S'_n\\;\\mathrm{RegularTemperedDistribution}_S(T,u,n).","display":true},{"tex":"J_n\\coloneqq\\{\\langle u,T\\rangle\\in\\mathcal S_n\\times\\mathcal S'_n:\\mathrm{RegularTemperedDistribution}_S(T,u,n)\\}.","display":true}],"bytes":4428,"backlinks":[{"id":"e22e6b1080a66235","anchor":"ref-1","locations":["元数据 · depends_on"],"count