m{EuclideanSmoothMap}_S\\bigl(\\{\\langle\\phi(x),\\langle f(x)\\rangle\\rangle:x\\in U\\},W,n,1\\bigr).\n\\end{aligned}","display":true},{"tex":"C^\\infty(M,\\tau,\\mathcal A;\\mathbb R)\\coloneqq\n\\{f\\in\\mathbb R^M:\\exists n\\in\\omega_{>0}\\;\\mathrm{SmoothRealFunction}_S(f,M,\\tau,\\mathcal A,n)\\}.","display":true},{"tex":"\\mathbb R","display":false},{"tex":"\\mathbb R^1","display":false}],"bytes":2686,"backlinks":[{"id":"6067389cc689812f","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{SmoothMap}_S$ (smooth-map predicate; see [[../batch13/58-df-smooth-map.md]])"},{"id":"1cb1491fbbaff37d","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$F\\in{}^M N$ 且 $\\mathrm{SmoothMap}_S(F,M,N)$（see [[../batch13/58-df-smooth-map.md]]）"},{"id":"efe8e2f202483a88","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{SmoothMapStructure}$ 取 [[../batch13/58-df-smooth-map.md]] 的同名定义与参数次序。"},{"id":"d7bfcf5788937844","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{SmoothMapStructure}$ 取 [[../batch13/58-df-smooth-map.md]] 的同名定义与参数次序。"},{"id":"50f0afd61c5e6fe6","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{SmoothMap}_S:V^3\\to\\{\\top,\\bot\\}$ (smooth-map predicate, see [[../batch13/58-df-smooth-map.md]])"},{"id":"c5f44e08576c6b2e","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"3771961e9c41f6ee","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{SmoothMap}_S:V^3\\to\\{\\top,\\bot\\}$ (see [[../batch13/58-df-smooth-map.md]])"},{"id":"8e70eff045618bab","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"b6060c5d1003e78e","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"7056a4392f2b25e2","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm