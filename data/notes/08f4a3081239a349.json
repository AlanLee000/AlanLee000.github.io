peratorname{Obj}(\\mathcal C)\\land Y\\in\\operatorname{Obj}(\\mathcal D)\\to(\\eta_X\\in\\operatorname{Hom}_{\\mathcal C}(X,G(F(X)))\\land\\varepsilon_Y\\in\\operatorname{Hom}_{\\mathcal D}(F(G(Y)),Y))","display":true},{"tex":"T = GF","display":false},{"tex":"F \\dashv G","display":false},{"tex":"X","display":false},{"tex":"Y","display":false}],"bytes":2670,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1350","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-unit-counit.md|58-df-unit-counit]]（batch03）"}],"outgoing":["dfa5042443233c40","970e2b8779070da0","e637becf421e4e61"]}