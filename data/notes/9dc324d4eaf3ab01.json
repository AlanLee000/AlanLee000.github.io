535}),\n\\qquad\n\\operatorname{BV}_{535}(A)=\\varnothing,\n\\qquad\n\\equiv_{\\alpha,535}\\subseteq\\mathsf{Frm}_{535}\\times\\mathsf{Frm}_{535},\n\\qquad\nA\\equiv_{\\alpha,535}B\\Longleftrightarrow A=B.","display":true},{"tex":"\\mathsf{Subst}_{535}\n=\n\\{\\sigma:\\mathsf{Prop}_{535}\\to\\mathsf{Frm}_{535}:\n\\{p:\\sigma(p)\\ne\\operatorname{atm}(p)\\}\\in\\mathcal P_{\\mathrm{fin}}(\\mathsf{Prop}_{535})\\}.","display":true},{"tex":"\\operatorname{Sub}_{535}:\\mathsf{Subst}_{535}\\times\\mathsf{Frm}_{535}\\to\\mathsf{Frm}_{535}","display":true},{"tex":"\\operatorname{Sub}_{535}(\\sigma,\\operatorname{atm}(p))=\\sigma(p),\n\\quad\n\\operatorname{Sub}_{535}(\\sigma,\\operatorname{bot})=\\operatorname{bot},","display":true},{"tex":"\\operatorname{Sub}_{535}(\\sigma,\\operatorname{neg}(A))=\n\\operatorname{neg}(\\operatorname{Sub}_{535}(\\sigma,A)),","display":true},{"tex":"\\operatorname{Sub}_{535}(\\sigma,\\operatorname{imp}(A,B))=\n\\operatorname{imp}(\\operatorname{Sub}_{535}(\\sigma,A),\\operatorname{Sub}_{535}(\\sigma,B)),","display":true},{"tex":"\\operatorname{Sub}_{535}(\\sigma,\\operatorname{box}(A))=\n\\operatorname{box}(\\operatorname{Sub}_{535}(\\sigma,A)).","display":true},{"tex":"\\mathsf{Ax}_{C1}^{535}=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{535}\\},","display":true},{"tex":"\\mathsf{Ax}_{C2}^{535}\n=\n\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{535}\\},","display":true},{"tex":"\\mathsf{Ax}_{C3}^{535}\n=\n\\{((\\neg A\\to\\neg B)\\to(B\\to A)):A,B\\in\\mathsf{Frm}_{535}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\bot}^{535}=\\{\\neg\\bot\\}.","display":true},{"tex":"\\mathsf{Ax}_{K}^{535}\n=\n\\{\\Box(A\\to B)\\to(\\Box A\\to\\Box B):A,B\\in\\mathsf{Frm}_{535}\\}.","display":true},{"tex":"\\mathsf{Ax}_{T}^{535}=\\{\\Box A\\to A:A\\in\\mathsf{Frm}_{535}\\},\n\\qquad\n\\mathsf{Ax}_{4}^{535}=\\{\\Box A\\to\\Box\\Box A:A\\in\\mathsf{Frm}_{535}\\}.","display":true},{"tex":"\\mathsf{Ax}_{S4.4}^{535}\n=\n\\{(A\\land\\Diamond\\B