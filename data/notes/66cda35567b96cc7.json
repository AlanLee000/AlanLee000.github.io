{"id":"66cda35567b96cc7","group":"58","path":"58/batch14/58-df-zfc-set10-pairing-closed-hull.md","title":"ZFC Set10 Pairing Closed Hull","display":"df-zfc-set10-pairing-closed-hull — ZFC Set10 Pairing Closed Hull","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-set10-pairing-closed-hull","aliases":["58-df-zfc-set10-pairing-closed-hull"],"display":"df-zfc-set10-pairing-closed-hull — ZFC Set10 Pairing Closed Hull","depends_on":[]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-set10-pairing-closed-hull"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-set10-pairing-closed-hull</span></div>"},{"key":"display","html":"df-zfc-set10-pairing-closed-hull — ZFC Set10 Pairing Closed Hull"},{"key":"depends_on","html":"<span class=\"property-null\">无</span>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"H,A\\in V\">\\(H,A\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcSet10PairingClosedHull}_S\\subseteq V^2\">\\(\\mathrm{ZfcSet10PairingClosedHull}_S\\subseteq V^2\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}pairing\\text{-}closed\\text{-}hull} \\vdash\n\\mathrm{ZfcSet10PairingClosedHull}_S(H,A)\\leftrightarrow\nA\\subseteq H\\land\\forall u,v\\in H\\;(\\{u,v\\}\\in H)\\land\n\\forall K\\in V\\;\\Bigl(\nA\\subseteq K\\land\\forall u,v\\in K\\;(\\{u,v\\}\\in K)\n\\to H\\subseteq K\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}pairing\\text{-}closed\\text{-}hull} \\vdash\n\\mathrm{ZfcSet10PairingClosedHull}_S(H,A)\\leftrightarrow\nA\\subseteq H\\land\\forall u,v\\in H\\;(\\{u,v\\}\\in H)\\land\n\\forall K\\in V\\;\\Bigl(\nA\\subseteq K\\land\\forall u,v\\in K\\;(\\{u,v\\}\\in K)\n\\to H\\subseteq K\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The minimality quantifier is explicitly set-bounded and its antecedent is grouped.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[],"math":[{"tex":"H,A\\in V","display":false},{"tex":"\\mathrm{ZfcSet10PairingClosedHull}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}set10\\text{-}pairing\\text{-}closed\\text{-}hull} \\vdash\n\\mathrm{ZfcSet10PairingClosedHull}_S(H,A)\\leftrightarrow\nA\\subseteq H\\land\\forall u,v\\in H\\;(\\{u,v\\}\\in H)\\land\n\\forall K\\in V\\;\\Bigl(\nA\\subseteq K\\land\\forall u,v\\in K\\;(\\{u,v\\}\\in K)\n\\to H\\subseteq K\\Bigr)","display":true}],"bytes":818,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3387","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-set10-pairing-closed-hull.md|58-df-zfc-set10-pairing-closed-hull]]（batch14）"}],"outgoing":[]}