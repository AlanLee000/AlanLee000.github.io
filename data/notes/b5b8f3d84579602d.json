ER}.","display":true},{"tex":"k\\le|V|","display":false},{"tex":"|V|-k","display":false},{"tex":"k>|V|","display":false},{"tex":"K_2","display":false}],"bytes":1976,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-61","locations":["正文"],"count":1,"excerpt":"NP 完全性：[[28-thm-clique-np-complete]]、[[28-thm-vertex-cover-np-complete]]、[[28-thm-independent-set-np-complete]]、[[28-thm-hamiltonian-cycle-np-complete]]、[[28-thm-3coloring-np-complete]]。"}],"outgoing":["9b48ca7c5c96f8c5","17335df21f7731bf","7a9125ebbfdef91e","14088421136f8182","a93b83e8c9de9da6"]}