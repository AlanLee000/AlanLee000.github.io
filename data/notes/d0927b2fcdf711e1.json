}}","display":true},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A","display":false},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}p\\Longleftrightarrow w\\in V(p),","display":true},{"tex":"\\neg(w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}\\bot),\n\\qquad\nw\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}\\top,","display":true},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\land B\n\\Longleftrightarrow\n(w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\land w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}B),","display":true},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\lor B\n\\Longleftrightarrow\n(w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\lor w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}B),","display":true},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\to B\n\\Longleftrightarrow\n\\forall v\\in W\\,\n\\bigl(w\\le v\\Rightarrow(v\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\Rightarrow v\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}B)\\bigr),","display":true},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}\\mathsf K_aA\n\\Longleftrightarrow\n\\forall v,u\\in W\\,\n\\bigl(w\\le v\\land vR_au\\Rightarrow u\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\bigr).","display":true},{"tex":"w\\le w'","display":false},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}\\mathsf K_aA","display":false},{"tex":"w'\\le v","display":false},{"tex":"vR_au","display":false},{"tex":"w\\le v","display":false},{"tex":"u\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A","display":false},{"tex":"w'\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}\\mathsf K_aA","display":false},{"tex":"\\Gamma\\models_{\\mathsf{IEp}}A","display":false},{"tex":"\\mathcal M\\in\\mathsf{Mod}_{\\mathsf{IEp}}","display":false},{"tex":"w\\in W_\\mathcal M","display":false},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}B","display":false},{"tex":"B\\in\\Gamma","display":false},{"tex":"w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A","display":false},{"tex":"a","display":false},{"tex":"R_a","display":false},{"tex":"\\mathsf{Val}_{\\mathsf{IEp}}\n=\n\\{A\\in\\mathsf{Frm}_{\\mathsf{IEp}}:\\varnothing\\models_{\\mathsf{IEp}}A\\}.","display":true},{"tex":"\\mathsf{SatCert}_{\\mathsf{IEp}}\n=\n\\{(\\mathcal M,w,A):\n(\\mathcal M,w)\\in\\mathsf{EvalCtx}_{\\mathsf{IEp}},\nA\\in\\mathsf{Frm}_{\\mathsf{IEp}},\nw\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A\\},","display":true},{"tex":"\\begin{aligned}\n\\mathsf{CounterCert}_{\\mathsf{IEp}}(\\Gamma,A)\n=\\{(\\mathcal M,w)\\in\\mathsf{EvalCtx}_{\\mathsf{IEp}}:\n&\\ \\forall B\\in\\Gamma\\ (w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}B),\\\\\n&\\ \\neg(w\\Vdash_{\\mathcal M}^{\\mathsf{IEp}}A)\\}.\n\\end{aligned}","display":true},{"tex":"\\Gamma\\models_{\\mathsf{IEp}}A\n\\Longleftrightarrow\n\\mathsf{CounterCert}_{\\mathsf{IEp}}(\\Gamma,A)=\\varnothing.","display":true},{"tex":"\\mathsf{MainConseq}_{\\mathsf{IEp}}\n=\n\\{(\\Gamma,A):\n\\Gamma\\subseteq\\mathsf{Frm}_{\\mathsf{IEp}},\nA\\in\\mathsf{Frm}_{\\mathsf{IEp}},\n\\mathsf{CounterCert}_{\\mathsf{IEp}}(\\Gamma,A)=\\varnothing\\}.","display":true},{"tex":"\\mathcal{IEp}\n=\n(\\mathsf{Ag},\n\\mathsf{Prop},\n\\mathsf{Frm}_{\\mathsf{IEp}},\n\\operatorname{FV}_{\\mathsf{IEp}},\n\\operatorname{BV}_{\\mathsf{IEp}},\n\\operatorname{Sub}_{\\mathsf{IEp}},\n\\equiv_{\\alpha,\\mathsf{IEp}},\n\\mathsf{Frame}_{\\mathsf{IEp}},\n\\mathsf{Mod}_{\\mathsf{IEp}},\n\\mathsf{EvalCtx}_{\\mathsf{IEp}},\n\\Vdash^{\\mathsf{IEp}},\n\\mathsf{SatCert}_{\\mathsf{IEp}},\n\\mathsf{CounterCert}_{\\mathsf{IEp}},\n\\mathsf{MainConseq}_{\\mathsf{IEp}},\n\\mathsf{Val}_{\\mathsf{IEp}},\n\\models_{\\mathsf{IEp}}).","display":true}],"bytes":7879,"backlinks":[],"outgoing":[]}