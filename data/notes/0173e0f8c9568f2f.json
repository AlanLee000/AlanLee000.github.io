}_{\\mathbf2}\\;\\Bigl[\n\\operatorname{Computes}_{\\mathbf2,\\mathbf2}(M,f)\n\\land\\bigl(\\exists k,c\\in\\mathbb N_{>0}\\;\\exists n_0\\in\\mathbb N\\;\\forall w\\in\\mathbf2^*\\;\n(|w|\\ge n_0\\to\\exists r\\in\\mathbb N\\;((w,r)\\in\\operatorname{stime}_M\\land r\\le c|w|^k))\\bigr)\\Bigr]\\Bigr\\}","display":true},{"tex":"\\mathsf{FP}","display":false}],"bytes":2218,"backlinks":[{"id":"69f4f24da36d1d66","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathsf{FP}$ (total polynomial-time string functions, see [[73-df-polynomial-string-functions]])"},{"id":"9d47330e332544bd","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$A,B\\subseteq\\mathbf2^*$；$\\mathsf{FP}$ 见 [[73-df-polynomial-string-functions]]，$\\mathrm{FP}$ 保留原罗马体类名作为别名。"}],"outgoing":["fd9e85296ed6a24d","888d8ab66ec7efca","773cae915e5165f3"]}