{"id":"9fca030cde4a0217","group":"58","path":"58/batch16/58-df-zfc-filter7-tukey-reduction.md","title":"ZFC Filter7 Tukey Reduction","display":"df-zfc-filter7-tukey-reduction — ZFC Filter7 Tukey Reduction","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-filter7-tukey-reduction","aliases":["58-df-zfc-filter7-tukey-reduction"],"display":"df-zfc-filter7-tukey-reduction — ZFC Filter7 Tukey Reduction","depends_on":["[[58-ax-zfc]]","[[58-df-tukey]]","[[58-df-poset]]","[[58-df-function]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-filter7-tukey-reduction"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-filter7-tukey-reduction</span></div>"},{"key":"display","html":"df-zfc-filter7-tukey-reduction — ZFC Filter7 Tukey Reduction"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"70f427bb4b24622b\" href=\"?note=70f427bb4b24622b\" title=\"58-df-tukey\">58-df-tukey</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"58-df-poset\">58-df-poset</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"P,Q,f\\in V\">\\(P,Q,f\\in V\\)</span>, <span class=\"math-inline\" data-tex=\"R\\subseteq P\\times P\">\\(R\\subseteq P\\times P\\)</span>, and <span class=\"math-inline\" data-tex=\"S\\subseteq Q\\times Q\">\\(S\\subseteq Q\\times Q\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Poset}\">\\(\\mathrm{Poset}\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"58-df-poset\">58-df-poset</a>) and <span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcFilter7TukeyReduction}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcFilter7TukeyReduction}_S:V^5\\to\\{\\top,\\bot\\}\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}filter7\\text{-}tukey\\text{-}reduction} \\vdash \\mathrm{ZfcFilter7TukeyReduction}_S(P,R,Q,S,f)\\leftrightarrow \\mathrm{Poset}(P,R)\\land\\mathrm{Poset}(Q,S)\\land\\bigl[\\forall p_0,p_1\\in P\\;\\exists p_2\\in P\\;(p_0\\,R\\,p_2\\land p_1\\,R\\,p_2)\\bigr]\\land\\bigl[\\forall q_0,q_1\\in Q\\;\\exists q_2\\in Q\\;(q_0\\,S\\,q_2\\land q_1\\,S\\,q_2)\\bigr]\\land\\mathrm{Function}(f,P,Q)\\land\\forall A\\subseteq P\\;\\Bigl(\\neg\\exists p\\in P\\;\\forall a\\in A\\;(a\\,R\\,p)\\to\\neg\\exists q\\in Q\\;\\forall a\\in A\\;(f(a)\\,S\\,q)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}filter7\\text{-}tukey\\text{-}reduction} \\vdash \\mathrm{ZfcFilter7TukeyReduction}_S(P,R,Q,S,f)\\leftrightarrow \\mathrm{Poset}(P,R)\\land\\mathrm{Poset}(Q,S)\\land\\bigl[\\forall p_0,p_1\\in P\\;\\exists p_2\\in P\\;(p_0\\,R\\,p_2\\land p_1\\,R\\,p_2)\\bigr]\\land\\bigl[\\forall q_0,q_1\\in Q\\;\\exists q_2\\in Q\\;(q_0\\,S\\,q_2\\land q_1\\,S\\,q_2)\\bigr]\\land\\mathrm{Function}(f,P,Q)\\land\\forall A\\subseteq P\\;\\Bigl(\\neg\\exists p\\in P\\;\\forall a\\in A\\;(a\\,R\\,p)\\to\\neg\\exists q\\in Q\\;\\forall a\\in A\\;(f(a)\\,S\\,q)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC filter definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-tukey","status":"resolved","id":"70f427bb4b24622b","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-tukey]]","embed":false},{"target":"58-df-poset","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-poset]]","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-function]]","embed":false},{"target":"58-df-poset","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Poset}$ (see [[58-df-poset]]) and $\\mathrm{Function}$ (see [[58-df-function]])","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Poset}$ (see [[58-df-poset]]) and $\\mathrm{Function}$ (see [[58-df-function]])","embed":false}],"math":[{"tex":"P,Q,f\\in V","display":false},{"tex":"R\\subseteq P\\times P","display":false},{"tex":"S\\subseteq Q\\times Q","display":false},{"tex":"\\mathrm{Poset}","display":false},{"tex":"\\mathrm{Function}","display":false},{"tex":"\\mathrm{ZfcFilter7TukeyReduction}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mat