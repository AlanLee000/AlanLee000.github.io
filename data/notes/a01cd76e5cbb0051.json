=52e38b01446c4422\" title=\"73-df-cfg-generating-variables\">73-df-cfg-generating-variables</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"8bb21416dea99a4c\" href=\"?note=8bb21416dea99a4c\" title=\"73-df-cfg-reachable-variables\">73-df-cfg-reachable-variables</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"97562bc4aa1d6014\" href=\"?note=97562bc4aa1d6014\" title=\"73-df-cfg-generated-language\">73-df-cfg-generated-language</a></span></div>"},{"key":"source_id","html":"HMU2007"},{"key":"source_ref","html":"§7.1, print pp. 261–275; PDF pp. 283–297; local effective construction"},{"key":"source_status","html":"third-edition-topic-mapped; inherited-local-review; not-a-line-by-line-source-proof-certificate"},{"key":"reviewed_on","html":"2026-10-24"},{"key":"legacy_source_id","html":"HU1979"},{"key":"legacy_source_ref","html":"§4.4, pp. 87–91; Theorem 6.6, p. 137; scans 95–99, 145"},{"key":"legacy_source_status","html":"book-based-local-formalization"},{"key":"revision_round","html":"pdf-third-edition-20261024"},{"key":"edition_role","html":"third-edition-core"},{"key":"third_edition_chapter","html":"7"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p><span class=\"math-inline\" data-tex=\"G=(V,\\Sigma,P,S)\\in\\mathsf{CFG}_{\\Sigma}\">\\(G=(V,\\Sigma,P,S)\\in\\mathsf{CFG}_{\\Sigma}\\)</span>，<span class=\"math-inline\" data-tex=\"A\\in V\">\\(A\\in V\\)</span>。三个阶段序列和推导语言见 <a class=\"wiki-link\" id=\"ref-5\" data-note=\"ec4c645913320961\" href=\"?note=ec4c645913320961\" title=\"73-df-cfg-nullable-variables\">73-df-cfg-nullable-variables</a>、<a class=\"wiki-link\" id=\"ref-6\" data-note=\"52e38b01446c4422\" href=\"?note=52e38b01446c4422\" title=\"73-df-cfg-generating-variables\">73-df-cfg-generating-variables</a>、<a class=\"wiki-link\" id=\"ref-7\" data-note=\"8bb21416dea99a4c\" href=\"?note=8bb21416dea99a4c\" title=\"73-df-cfg-reachable-variables\">73-df-cfg-reachable-variables</a>、<a class=\"wiki-link\" id=\"ref-8\" data-note=\"97562bc4aa1d6014\" href=\"?note=97562bc4aa1d6014\" title=\"73-df-cfg-generated-language\">73-df-cfg-generated-language</a>。</p>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\n\\operatorname{Nullable}(G)=N^G_{|V|},\\quad\\operatorname{Generating}(G)=B^G_{|V|},\\quad\\operatorname{ReachVar}(G)=A^G_{|V|}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\n\\operatorname{Nullable}(G)=N^G_{|V|},\\quad\\operatorname{Generating}(G)=B^G_{|V|},\\quad\\operatorname{ReachVar}(G)=A^G_{|V|}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nA\\in\\operatorname{Nullable}(G)\\leftrightarrow\\langle A\\rangle\\Rightarrow_G^*\\varepsilon\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nA\\in\\operatorname{Nullable}(G)\\leftrightarrow\\langle A\\rangle\\Rightarrow_G^*\\varepsilon\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nA\\in\\operatorname{Generating}(G)\\leftrightarrow\\exists w\\in\\Sigma^*\\;\\langle A\\rangle\\Rightarrow_G^*w\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nA\\in\\operatorname{Generating}(G)\\leftrightarrow\\exists w\\in\\Sigma^*\\;\\langle A\\rangle\\Rightarrow_G^*w\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nA\\in\\operatorname{ReachVar}(G)\\leftrightarrow\\exists u,v\\in(V\\cup\\Sigma)^*\\;\\langle S\\rangle\\Rightarrow_G^*uAv\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nA\\in\\operatorname{ReachVar}(G)\\leftrightarrow\\exists u,v\\in(V\\cup\\Sigma)^*\\;\\langle S\\rangle\\Rightarrow_G^*uAv\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nL(G)=\\varnothing\\leftrightarrow S\\notin\\operatorname{Generating}(G)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}cfg\\text{-}fixed\\text{-}point\\text{-}correctness}\\vdash\nL(G)=\\varnothing\\leftrightarrow S\\notin\\operatorname{Generating}(G)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>阶段到语义按阶段归纳，语义到阶段按推导树高度归纳；可达性用包含该变量的推导路径归纳。三个递增链都在有限 V 内，一旦不再增长即稳定，最多 |V| 次真增长。判空只需有限集合迭代。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"73-df-cfg-nullable-variables","status":"resolved","id":"ec4c645913320961","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-cfg-nullable-variables]]","embed":false},{"target":"73-df-cfg-generating-variables","status":"resolved","id":"52e38b01446c4422","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-cfg-generating-variables]]","embed":false},{"target":"73-df-cfg-reachable-variables","status":"resolved","id