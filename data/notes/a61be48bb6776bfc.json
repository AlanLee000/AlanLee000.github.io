t,u)\\mid\\Lambda r\\mid\\mathrm{tapp}(t,A)\\\\\n&\\mid\\mathrm{pack}(C,A,t)\\mid\\mathrm{unpack}(t,w)\n\\mid\\mathrm{abort}(A,t)\\mid\\mathrm{inl}(A,D,t)\\mid\\mathrm{inr}(A,D,t)\n\\mid\\mathrm{case}(t,q,q'),\\\\\n&t,u\\in\\mathsf{Raw}_{n,m}^+,\\quad q,q'\\in\\mathsf{Raw}_{n,m+1}^+,\n\\quad r\\in\\mathsf{Raw}_{n+1,m}^+,\\quad w\\in\\mathsf{Raw}_{n+1,m+1}^+,\\\\\n&A,D\\in\\mathsf{Ty}_n^+,\\quad C\\in\\mathsf{Ty}_{n+1}^+,\\quad i\\in\\{1,2\\},\\\\\n\\mathbf d(0)&\\coloneqq(),\\quad\n\\mathbf d(+)\\coloneqq((0,0),(0,0)),\\\\\n\\mathbf d(\\mathrm{abort})&\\coloneqq((0,0),(0,0)),\\\\\n\\mathbf d(\\mathrm{inl})&\\coloneqq((0,0),(0,0),(0,0)),\\quad\n\\mathbf d(\\mathrm{inr})\\coloneqq((0,0),(0,0),(0,0)),\\\\\n\\mathbf d(\\mathrm{case})&\\coloneqq((0,0),(0,1),(0,1)),\\\\\n\\mathrm{abort}_A(t)&\\coloneqq\\mathrm{abort}(A,t),\\quad\n\\mathrm{inl}_{A,D}(t)\\coloneqq\\mathrm{inl}(A,D,t),\\quad\n\\mathrm{inr}_{A,D}(t)\\coloneqq\\mathrm{inr}(A,D,t),\\\\\n\\mathrm{case}(t;x.u,y.v)&\\coloneqq\\mathrm{case}(t,u,v).\n\\end{aligned}","display":true},{"tex":"\\mathcal S_+^{\\rm ext}\\coloneqq\\left\\{\\begin{gathered}\n\\frac{}{\\Xi\\vdash0}\\qquad\\frac{\\Xi\\vdash A\\quad\\Xi\\vdash B}{\\Xi\\vdash A+B},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:0\\quad\\Xi\\vdash A}{\\Xi\\mid\\Gamma\\vdash\\mathrm{abort}_A(t):A},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:A\\quad\\Xi\\vdash B}{\\Xi\\mid\\Gamma\\vdash\\mathrm{inl}_{A,B}(t):A+B}\\qquad\n\\frac{\\Xi\\vdash A\\quad\\Xi\\mid\\Gamma\\vdash t:B}{\\Xi\\mid\\Gamma\\vdash\\mathrm{inr}_{A,B}(t):A+B},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:A+B\\quad\\Xi\\mid\\Gamma,x:A\\vdash u:D\\quad\\Xi\\mid\\Gamma,y:B\\vdash v:D}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{case}(t;x.u,y.v):D},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t\\equiv t':0\\quad\\Xi\\vdash D}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{abort}_D(t)\\equiv\\mathrm{abort}_D(t'):D},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t\\equiv t':A\\quad\\Xi\\vdash B}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{inl}_{A,B}(t)\\equiv\\mathrm{inl}_{A,B}(t'):A+B},\\\\\n\\frac{\\Xi\\vdash A\\quad\\Xi\\mid\\Gamma\\vdash t\\equiv t':B}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{inr}_{A,B}(t)\\equiv\\mathrm{inr}_{A,B}(t'):A+B},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t\\equiv t':A+B\\quad\n\\Xi\\mid\\Gamma,x:A\\vdash u\\equiv u':D\\quad\n\\Xi\\mid\\Gamma,y:B\\vdash v\\equiv v':D}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{case}(t;x.u,y.v)\\equiv\\mathrm{case}(t';x.u',y.v'):D},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:A\\quad\\Xi\\mid\\Gamma,x:A\\vdash u:D\\quad\\Xi\\mid\\Gamma,y:B\\vdash v:D}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{case}(\\mathrm{inl}_{A,B}(t);x.u,y.v)\\equiv u[t/x]:D},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:B\\quad\\Xi\\mid\\Gamma,x:A\\vdash u:D\\quad\\Xi\\mid\\Gamma,y:B\\vdash v:D}\n{\\Xi\\mid\\Gamma\\vdash\\mathrm{case}(\\mathrm{inr}_{A,B}(t);x.u,y.v)\\equiv v[t/y]:D},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:A+B\\quad\\Xi\\mid\\Gamma,z:A+B\\vdash w:D}\n{\\Xi\\mid\\Gamma\\vdash w[t/z]\\equiv\n\\mathrm{case}(t;x.w[\\mathrm{inl}_{A,B}(x)/z],y.w[\\mathrm{inr}_{A,B}(y)/z]):D},\\\\\n\\frac{\\Xi\\mid\\Gamma\\vdash t:0\\quad\\Xi\\mid\\Gamma,z:0\\vdash w:D}\n{\\Xi\\mid\\Gamma\\vdash w[t/z]\\equiv\\mathrm{abort}_D(t):D}.\n\\end{gathered}\\right\\}.","display":true},{"tex":"\\begin{aligned}\n\\mathcal R_+&\\coloneqq\\{(P\\cup\\mathsf{Req}(j),j)\\mid\n(P,j)\\in\\mathcal S_{\\lambda2}^+\\cup\\mathcal S_+^{\\rm ext},\\\nP\\in\\mathcal P_{\\rm fin}(\\mathcal J_+),\\ j\\in\\mathcal J_+\\},\\\\\nD_+^0&\\coloneqq\\varnothing,\\\\\nD_+^{k+1}&\\coloneqq D_+^k\\cup\n\\{j\\in\\mathcal J_+\\mid(\\exists P\\subseteq D_+^k)\\ (P,j)\\in\\mathcal R_+\\},\\\\\n\\mathcal D_+&\\coloneqq\\bigcup_{k\\in\\mathbb N}D_+^k,\\\\\n\\Xi\\vdash A&\\Longleftrightarrow\\mathsf F(\\Xi,A)\\in\\mathcal D_+,\\\\\n\\Xi\\vdash\\Gamma&\\Longleftrightarrow\\mathsf C(\\Xi,\\Gamma)\\in\\mathcal D_+,\\\\\n\\Xi\\mid\\Gamma\\vdash t:A&\\Longleftrightarrow\\mathsf T(\\Xi,\\Gamma,t,A)\\in\\mathcal D_+,\\\\\n\\Xi\\mid\\Gamma\\vdash t\\equiv u:A&\\Longleftrightarrow\\mathsf E(\\Xi,\\Gamma,t,u,A)\\in\\mathcal D_+.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\operatorname{Ob}\\mathcal C_\\Xi&\\coloneqq\\{A\\mid\\Xi\\vdash A\\},\\\\\n\\mathcal C_\\Xi(A,B)&\\coloneqq\\{(A,B,[t]_\\equiv)\\mid\\Xi\\mid\\varnothing\\vdash t:A\\to B\\},\\\\\n\\operatorname{id}_A&\\coloneqq[\\lambda x:A.x],\\qquad\n[g]\\circ[f]\\coloneqq[\\lambda x:A.g(fx)],\\\\\nP&::=X\\mid C\\mid0\\mid1\\mid P\\times Q\\mid P+Q,\\\\\n\\mathsf{Inst}_{X,k}(T)&\\coloneqq T,\\qquad\n\\mathsf{Inst}_{C,k}(T)\\coloneqq\\mathsf W_{n,0}^{k-n,0}(C),\\\\\n\\mathsf{Inst}_{0,k}(T)&\\coloneqq0,\\qquad\\mathsf{Inst}_{1,k}(T)\\coloneqq1,\\\\\n\\mathsf{Inst}_{P\\times Q,k}(T)&\\coloneqq\n\\mathsf{Inst}_{P,k}(T)\\times\\mathsf{Inst}_{Q,k}(T),\\\\\n\\mathsf{Inst}_{P+Q,k}(T)&\\coloneqq\n\\mathsf{Inst}_{P,k}(T)+\\mathsf{Inst}_{Q,k}(T),\\\\\nP[A/X]&\\coloneqq\\mathsf{Inst}_{P,n}(A),\\\\\n(F_P)_0(A)&\\coloneqq P[A/X],\\\\\n\\operatorname{map}_{X,k}^{A,B}(f)&\\coloneqq f,\\\\\n\\operatorname{map}_{C,k}^{A,B}(f)&\\coloneqq\n\\lambda z:\\mathsf W_{n,0}^{k-n,0}(C).z,\\\\\n\\operatorname{map}_{0,k}^{A,B}(f)&\\coloneqq\\lambda z:0.z,\\qquad\n\\operatorname{map}_{1,k}^{A,B}(f)\\coloneqq\\lambda z:1.z,\\\\\n\\operatorname{map}_{P\\times Q,k}^{A,B}(f)&\\coloneqq\n\\lambda z:\\mathsf{Inst}_{P,k}(A)\\times\\mathsf{Inst}_{Q,k}(A).\n\\langle\\operatorname{map}_{P,k}^{A,B}(f)(\\pi_1z),\\operatorname{map}_{Q,k}^{A,B}(f)(\\pi_2z)\\rangle,\\\\\n\\operatorname{map}_{P+Q,k}^{A,B}(f)&\\coloneqq\n\\lambda z:\\mathsf{Inst}_{P,k}(A)+\\mathsf{Inst}_{Q,k}(A).\n\\mathrm{case}(z;x.\\mathrm{inl}(\\operatorname{map}_{P,k}^{A,B}(f)x),y.\\mathrm{inr}(\\operatorname{map}_{Q,k}^{A,B}(f)y)),\\\\\n\\Theta\\mid\\Gamma\\vdash f:A\\to B&\\Longrightarrow\n\\Theta\\mid\\Gamma\\vdash\\operatorname{map}_{P,k}^{A,B}(f):\n\\mathsf{Inst}_{P,k}(A)\\to\\mathsf{Inst}_{P,k}(B),\\\\\n\\mathsf W_{k,0}^{r,0}(\\mathsf{Inst}_{P,k}(T))&=\n\\mathsf{Inst}_{P,k+r}(\\mathsf W_{k,0}^{r,0}(T)),\\\\\n\\operatorname{map}_{P}^{A,B}(f)&\\coloneqq\\operatorname{map}_{P,n}^{A,B}(f),\\\\\n(F_P)_1([f])&\\coloneqq[\\operatorname{map}_P^{A,B}(f)]\\quad(\\Xi\\mid\\varnothing\\vdash f:A\\to B),\\\\\nF_P&\\coloneqq\\langle(F_P)_0,(F_P)_1\\rangle,\\\\\nF_P(\\operatorname{id}_A)&=\\operatorname{id}_{F_P(A)},\\qquad\nF_P(g\\circ f)=F_P(g)\\circ F_P(f).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\nO_\\Xi&\\coloneqq\\{A\\mid\\Xi\\vdash A\\},\\qquad M_\\Xi\\coloneqq\\bigcup_{A,B\\in O_\\Xi}\\mathcal C_\\Xi(A,B),\\\\\ns_\\Xi(A,B,[t]_\\equiv)&\\coloneqq A,\\qquad t_\\Xi(A,B,[t]_\\equiv)\\coloneqq B,\\\\\ne_\\Xi(A)&\\coloneqq\\operatorname{id}_A,\\qquad c_\\Xi([g],[f])\\coloneqq[g]\\circ[f],\\\\\n\\mathcal C_\\Xi&\\coloneqq\\langle O_\\Xi,M_\\Xi,s_\\Xi,t_\\Xi,e_\\Xi,c_\\Xi\\rangle,\\qquad\\mathrm{Cat}(\\mathcal C_\\Xi).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\operatorname{Ob}\\operatorname{Alg}(F_P)&\\coloneqq\\{(A,a)\\mid A\\in\\operatorname{Ob}\\mathcal C_\\Xi,\\ a\\in\\mathcal C_\\Xi(F_P(A),A)\\},\\\\\n\\operatorname{Alg}(F_P)((A,a),(B,b))&\\coloneqq\\{\\langle(A,a),(B,b),h\\rangle\\mid h\\in\\mathcal C_\\Xi(A,B)\\land h\\circ a=b\\circ F_P(h)\\},\\\\\n\\operatorname{Ob}\\operatorname{Coalg}(F_P)&\\coloneqq\\{(A,c)\\mid A\\in\\operatorname{Ob}\\mathcal C_\\Xi,\\ c\\in\\mathcal C_\\Xi(A,F_P(A))\\},\\\\\n\\operatorname{Coalg}(F_P)((A,c),(B,d))&\\coloneqq\\{\\langle(A,c),(B,d),h\\rangle\\mid h\\in\\mathcal C_\\Xi(A,B)\\land d\\circ h=F_P(h)\\circ c\\}.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\nO_\\mathcal A&\\coloneqq\\operatorname{Ob}\\mathcal A,\\qquad\nM_\\mathcal A\\coloneqq\\bigcup_{Q,R\\in O_\\mathcal A}\\mathcal A(Q,R),\\\\\ns_\\mathcal A\\langle Q,R,h\\rangle&\\coloneqq Q,\\qquad t_\\mathcal A\\langle Q,R,h\\rangle\\coloneqq R,\\\\\ne_\\mathcal A(Q)&\\coloneqq\\langle Q,Q,\\operatorname{id}_{\\operatorname{pr}_1Q}\\rangle,\\\\\nc_\\mathcal A(\\langle R,S,k\\rangle,\\langle Q,R,h\\rangle)&\\coloneqq\\langle Q,S,k\\circ h\\rangle,\\\\\n\\mathcal A&\\coloneqq\\langle O_\\mathcal A,M_\\mathcal A,s_\\mathcal A,t_\\mathcal A,e_\\mathcal A,c_\\mathcal A\\rangle,\n\\qquad\\mathrm{Cat}(\\mathcal A)\n\\quad(\\mathcal A\\in\\{\\operatorname{Alg}(F_P),\\operatorname{Coalg}(F_P)\\}).\n\\end{aligned}","display":true},{"tex":"P","display":false},{"tex":"\\mathcal C_\\Xi","display":false},{"tex":"\\operatorname{pr}_1","display":false},{"tex":"X","display":false}],"bytes":13503,"backlinks":[{"id":"5dd51ee837134717","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"固定 [[16-df-hagino-functor]] 定义的类型变量语境 $\\Xi$ 及闭项商范畴 $\\mathcal C_\\Xi$，使用其中的 λ2 子语法。$A$ 为任意类型，$a:1\\to A$、$f:A\\to A$ 为闭项转换类，选定闭项代表 $a=[\\widehat a]$、$f=[\\widehat f]$，$\\star:1$。$\\mathbb N_\\lambda$、$z$、$s$、$h_{a,f}$ 在本页定义；$n$ 遍历外部自然数，$f^0\\coloneqq\\operatorname{id}_A$，$f^{n+1}\\coloneqq f\\circ f^n$。"},{"id":"1bdcb9b14f83cac1","anchor":"ref-111","locations":["正文"],"count":2,"excerpt":"[[16-df-stlc-syntax]]、[[16-df-stlc-syntactic-category]]、[[16-df-simple-type-semantics]]、[[16-thm-categorical-completeness]]、[[16-df-lambda-systems]]、[[16-df-polymorphic-signature]]、[[16-df-hagino-functor]]、[[16-thm-weak-initial-algebra]]、[[16-ex-church-weak-nno]]、[[16-df-polymorphic-fibration]]、[[16-df-lambda-fibrations]]。"},{"id":"ebcba3904cade675","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"固定 [[16-df-hagino-functor]] 中带真正有限余积的 λ2、类型变量语境 $\\Xi$、Hagino 类型树 $P(X)$、类型与项商范畴 $\\mathcal C_\\Xi$ 及函子 $F=F_P$。$X$ 为对 $\\Xi$ 新鲜的类型变量，$a:F(A)\\to A$、$c:A\\to F(A)$ 是 $\\mathcal C_\\Xi$ 中任意箭头；选定闭项 $\\widehat a:F(A)\\to A$、$\\widehat c:A\\to F(A)$，满足 $a=[\\widehat a]$、$c=[\\widehat c]$。所有函数与方程均是良型项转换类；$\\forall X$、$\\exists X$ 及 $\\mathrm{pack}$、$\\mathrm{unpack}$ 的形成、β/η 采用 [[16-df-lambda-systems]]。"}],"outgoing":["9691785e1689a2c1","25a281534aa42440"]}