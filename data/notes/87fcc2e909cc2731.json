{"id":"87fcc2e909cc2731","group":"27","path":"27/27-df-binom2.md","title":"Two-element subsets","display":"df-binom2 — Two-element subsets","type":"definition","metadata":{"type":"definition","book":"Boolean Functions: Theory, Algorithms, and Applications","book_abbrev":"27","label":"27-df-binom2","aliases":["27-df-binom2"],"display":"df-binom2 — Two-element subsets","depends_on":[],"local_review_status":"formally-reviewed-2026-10-20; source-not-rechecked"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Boolean Functions: Theory, Algorithms, and Applications"},{"key":"book_abbrev","html":"27"},{"key":"label","html":"27-df-binom2"},{"key":"aliases","html":"<div class=\"property-array\"><span>27-df-binom2</span></div>"},{"key":"display","html":"df-binom2 — Two-element subsets"},{"key":"depends_on","html":"<span class=\"property-null\">无</span>"},{"key":"local_review_status","html":"formally-reviewed-2026-10-20; source-not-rechecked"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"V\">\\(V\\)</span> (a set)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\binom{V}{2} \\coloneqq \\{e \\subseteq V \\mid |e|=2\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\binom{V}{2} \\coloneqq \\{e \\subseteq V \\mid |e|=2\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>If <span class=\"math-inline\" data-tex=\"V\">\\(V\\)</span> is finite, then <span class=\"math-inline\" data-tex=\"\\left|\\binom{V}{2}\\right|=|V|(|V|-1)/2\">\\(\\left|\\binom{V}{2}\\right|=|V|(|V|-1)/2\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[],"attachments":[],"math":[{"tex":"V","display":false},{"tex":"\\binom{V}{2} \\coloneqq \\{e \\subseteq V \\mid |e|=2\\}","display":true},{"tex":"V","display":false},{"tex":"\\left|\\binom{V}{2}\\right|=|V|(|V|-1)/2","display":false}],"bytes":513,"backlinks":[{"id":"448689b85eeddd41","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$G=(V,E)$ 为集合的有序对；$\\binom V2$（see [[27-df-binom2]]）。"},{"id":"d65efe7c4f987bfe","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$G^\\sigma=(V,E^+,E^-)$ 为集合的有序三元组；$\\binom V2$（see [[27-df-binom2]]）。"},{"id":"5244dbb38da17b8a","anchor":"ref-159","locations":["正文"],"count":1,"excerpt":"[[27-df-binom2|df-binom2 — Two-element subsets]]"},{"id":"4c6ea69877ad9783","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\binom C2$（see [[27-df-binom2]]）。"}],"outgoing":[]}