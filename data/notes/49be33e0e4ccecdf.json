eacbac3\" title=\"../batch04/58-df-zfc-normal-filter.md\">../batch04/58-df-zfc-normal-filter.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"a30585c644c0e15f\" href=\"?note=a30585c644c0e15f\" title=\"../batch19/58-df-zfc-filter6-uniform-filter.md\">../batch19/58-df-zfc-filter6-uniform-filter.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"65418b505fc53093\" href=\"?note=65418b505fc53093\" title=\"../batch17/58-df-formula.md\">../batch17/58-df-formula.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"aabdf3005231e9dc\" href=\"?note=aabdf3005231e9dc\" title=\"../batch12/58-df-v-alpha.md\">../batch12/58-df-v-alpha.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a></span><span><a class=\"wiki-link\" id=\"ref-9\" data-note=\"64f35ba2e87964e0\" href=\"?note=64f35ba2e87964e0\" title=\"../batch03/58-df-assignment.md\">../batch03/58-df-assignment.md</a></span><span><a class=\"wiki-link\" id=\"ref-10\" data-note=\"44e32f3fb4334e0c\" href=\"?note=44e32f3fb4334e0c\" title=\"../batch17/58-df-logic.md\">../batch17/58-df-logic.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span> (weakly compact cardinal, see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"3b1542a0cd60ec5a\" href=\"?note=3b1542a0cd60ec5a\" title=\"../batch11/58-df-zfc-weakly-compact-cardinal.md\">../batch11/58-df-zfc-weakly-compact-cardinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{WeaklyCompactCardinal}_S\">\\(\\mathrm{WeaklyCompactCardinal}_S\\)</span> (weak-compactness predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal L_{\\in,\\dot R,\\dot X}\">\\(\\mathcal L_{\\in,\\dot R,\\dot X}\\)</span> (first-order language with membership and two unary predicate symbols)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Sent}_S(\\mathcal L_{\\in,\\dot R,\\dot X})\">\\(\\mathrm{Sent}_S(\\mathcal L_{\\in,\\dot R,\\dot X})\\)</span> (set-coded sentence set)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Satisfaction}_S\">\\(\\mathrm{Satisfaction}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Assign}\">\\(\\mathrm{Assign}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Univ}\">\\(\\mathrm{Univ}\\)</span>, and <span class=\"math-inline\" data-tex=\"I^{\\mathcal M}_{\\mathrm{rel},n}\">\\(I^{\\mathcal M}_{\\mathrm{rel},n}\\)</span> (object-level semantic data)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{PiOneOneSentence}_S\">\\(\\mathrm{PiOneOneSentence}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{PiOneOneSat}_S\">\\(\\mathrm{PiOneOneSat}_S\\)</span> (coded <span class=\"math-inline\" data-tex=\"\\Pi^1_1\">\\(\\Pi^1_1\\)</span> syntax and truth predicates defined below)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{PiOneOneIndescribableSubset}_S(A,\\kappa)\">\\(\\mathrm{PiOneOneIndescribableSubset}_S(A,\\kappa)\\)</span> (subset indescribability predicate defined below)</li>\n<li><span class=\"math-inline\" data-tex=\"I_{\\mathrm{wc}}(\\kappa)\">\\(I_{\\mathrm{wc}}(\\kappa)\\)</span> (weakly compact ideal defined below)</li>\n<li><span class=\"math-inline\" data-tex=\"F_{\\mathrm{wc}}(\\kappa)\">\\(F_{\\mathrm{wc}}(\\kappa)\\)</span> (dual weakly compact filter defined below)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ideal},\\mathrm{KappaCompleteFilter}_S,\\mathrm{NormalFilter}_S,\\mathrm{ZfcFilter6UniformFilter}_S\">\\(\\mathrm{Ideal},\\mathrm{KappaCompleteFilter}_S,\\mathrm{NormalFilter}_S,\\mathrm{ZfcFilter6UniformFilter}_S\\)</span> (ideal and filter-property predicates)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}pi11\\text{-}sentence}\\vdash \\mathrm{PiOneOneSentence}_S(\\varphi)\\leftrightarrow\\exists\\psi\\in\\mathrm{Sent}_S(\\mathcal L_{\\in,\\dot R,\\dot X})\\;\\bigl(\\varphi=\\langle\\forall\\dot X,\\psi\\rangle\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}pi11\\text{-}sentence}\\vdash \\mathrm{PiOneOneSentence}_S(\\varphi)\\leftrightarrow\\exists\\psi\\in\\mathrm{Sent}_S(\\mathcal L_{\\in,\\dot R,\\dot X})\\;\\bigl(\\varphi=\\langle\\forall\\dot X,\\psi\\rangle\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}pi11\\text{-}truth}\\vdash{}&amp;\n\\mathrm{PiOneOneSat}_S(\\alpha,R,\\varphi)\\leftrightarrow\nR\\subseteq V_\\alpha\\land\\exists\\psi\\in\\mathrm{Sent}_S(\\mathcal L_{\\in,\\dot R,\\dot X})\\;\\Bigl(\n\\varphi=\\langle\\forall\\dot X,\\psi\\rangle\\\\\n&amp;\\quad\\land\\forall X\\subseteq V_\\alpha\\;\\exists\\mathcal M_{\\alpha,R,X},\\operatorname{Val},\\operatorname{Sat}\\;\\Bigl(\n\\mathrm{Univ}(\\mathcal M_{\\alpha,R,X})=V_\\alpha\n\\land\\mathrm{Satisfaction}_S(\\mathcal M_{\\alpha,R,X},\\mathcal L_{\\in,\\dot R,\\dot X},\\operatorname{Val},\\operatorname{Sat})\\\\\n&amp;\\qquad\\land I^{\\mathcal M_{\\alpha,R,X}}_{\\mathrm{rel},2}(\\dot{\\in})=\\{\\langle x,y\\rangle\\in V_\\alpha^2:x\\in y\\}\n\\land I^{\\mathcal M_{\\alpha,R,X}}_{\\mathrm{rel},1}(\\dot R)=R\n\\land I^{\\mathcal M_{\\alpha,R,X}}_{\\mathrm{rel},1}(\\dot X)=X\\\\\n&amp;\\qquad\\land\\forall s\\;(\\mathrm{Assign}(\\mathcal M_{\\alpha,R,X},s)\\to\\operatorname{Sat}(\\psi,s))\\Bigr)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}pi11\\text{-}truth}\\vdash{}&amp;\n\\mathrm{PiOneOneSat}_S(\\alpha,R,\\varphi)\\leftrightarrow\nR\\subseteq V_\\alpha\\land\\exists\\psi\\in\\mathrm{Sent}_S(\\mathcal L_{\\in,\\dot R,\\dot X})\\;\\Bigl(\n\\varphi=\\langle\\forall\\dot X,\\psi\\rangle\\\\\n&amp;\\quad\\land\\forall X\\subseteq V_\\alpha\\;\\exists\\mathcal M_{\\alpha,R,X},\\operatorname{Val},\\operatorname{Sat}\\;\\Bigl(\n\\mathrm{Univ}(\\mathcal M_{\\alpha,R,X})=V_\\alpha\n\\land\\mathrm{Satisfaction}_S(\\mathcal M_{\\alpha,R,X},\\mathcal L_{\\in,\\dot R,\\dot X},\\operatorname{Val},\\operatorname{Sat})\\\\\n&amp;\\qquad\\land I^{\\mathcal M_{\\alpha,R,X}}_{\\mathrm{rel},2}(\\dot{\\in})=\\{\\langle x,y\\rangle\\in V_\\alpha^2:x\\in y\\}\n\\land I^{\\mathcal M_{\\alpha,R,X}}_{\\mathrm{rel},1}(\\dot R)=R\n\\land I^{\\mathcal M_{\\alpha,R,X}}_{\\mathrm{rel},1}(\\dot X)=X\\\\\n&amp;\\qquad\\land\\forall s\\;(\\mathrm{Assign}(\\mathcal M_{\\alpha,R,X},s)\\to\\operatorname{Sat}(\\psi,s))\\Bigr)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}pi11\\text{-}indescribable\\text{-}subset}\\vdash\n\\mathrm{PiOneOneIndescribableSubset}_S(A,\\kappa)\\\\\n&amp;\\quad\\leftrightarrow A\\subseteq\\kappa\\land\n\\forall R\\subseteq V_\\kappa\\;\\forall\\varphi\\;\n\\Bigl(\\mathrm{PiOneOneSentence}_S(\\varphi)\\land\\mathrm{PiOneOneSat}_S(\\kappa,R,\\varphi)\n\\to\\exists\\alpha\\in A\\;\\mathrm{PiOneOneSat}_S(\\alpha,R\\cap V_\\alpha,\\varphi)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}pi11\\text{-}indescribable\\text{-}subset}\\vdash\n\\mathrm{PiOneOneIndescribableSubset}_S(A,\\kappa)\\\\\n&amp;\\quad\\leftrightarrow A\\subseteq\\kappa\\land\n\\forall R\\subseteq V_\\kappa\\;\\forall\\varphi\\;\n\\Bigl(\\mathrm{PiOneOneSentence}_S(\\varphi)\\land\\mathrm{PiOneOneSat}_S(\\kappa,R,\\varphi)\n\\to\\exists\\alpha\\in A\\;\\mathrm{PiOneOneSat}_S(\\alpha,R\\cap V_\\alpha,\\varphi)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}weakly\\text{-}compact\\text{-}ideal}\\vdash I_{\\mathrm{wc}}(\\kappa)\\coloneqq\\{A\\subseteq\\kappa:\\neg\\mathrm{PiOneOneIndescribableSubset}_S(A,\\kappa)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}weakly\\text{-}compact\\text{-}ideal}\\vdash I_{\\mathrm{wc}}(\\kappa)\\coloneqq\\{A\\subseteq\\kappa:\\neg\\mathrm{PiOneOneIndescribableSubset}_S(A,\\kappa)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}weakly\\text{-}compact\\text{-}filter}\\vdash F_{\\mathrm{wc}}(\\kappa)\\coloneqq\\{X\\subseteq\\kappa:\\kappa\\setminus X\\in I_{\\mathrm{wc}}(\\kappa)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}weakly\\text{-}compact\\text{-}filter}\\vdash F_{\\mathrm{wc}}(\\kappa)\\coloneqq\\{X\\subseteq\\kappa:\\kappa\\setminus X\\in I_{\\mathrm{wc}}(\\kappa)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{thm\\text{-}weakly\\text{-}compact\\text{-}filter}\\vdash\n\\mathrm{WeaklyCompactCardinal}_S(\\kappa)\\\\\n&amp;\\quad\\to\n\\Bigl(\n\\mathrm{Ideal}(I_{\\mathrm{wc}}(\\kappa),\\mathcal P(\\kappa))\n\\land\\kappa\\notin I_{\\mathrm{wc}}(\\kappa)\\\\\n&amp;\\qquad\\land\n\\mathrm{KappaCompleteFilter}_S(F_{\\mathrm{wc}}(\\kappa),\\kappa,\\kappa)\n\\land\\mathrm{NormalFilter}_S(F_{\\mathrm{wc}}(\\kappa),\\kappa)\n\\land\\mathrm{ZfcFilter6UniformFilter}_S(\\kappa,F_{\\mathrm{wc}}(\\kappa))\n\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{thm\\text{-}weakly\\text{-}compact\\text{-}filter}\\vdash\n\\mathrm{WeaklyCompactCardinal}_S(\\kappa)\\\\\n&amp;\\quad\\to\n\\Bigl(\n\\mathrm{Ideal}(I_{\\mathrm{wc}}(\\kappa),\\mathcal P(\\kappa))\n\\land\\kappa\\notin I_{\\mathrm{wc}}(\\kappa)\\\\\n&amp;\\qquad\\land\n\\mathrm{KappaCompleteFilter}_S(F_{\\mathrm{wc}}(\\kappa),\\kappa,\\kappa)\n\\land\\mathrm{NormalFilter}_S(F_{\\mathrm{wc}}(\\kappa),\\kappa)\n\\land\\mathrm{ZfcFilter6UniformFilter}_S(\\kappa,F_{\\mathrm{wc}}(\\kappa))\n\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>On a weakly compact cardinal, non-<span class=\"math-inline\" data-tex=\"\\Pi^1_1\">\\(\\Pi^1_1\\)</span>-indescribable subsets form a proper normal <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span>-complete ideal; its dual is the weakly compact filter displayed above.</li>\n<li>A <span class=\"math-inline\" data-tex=\"\\Pi^1_1\">\\(\\Pi^1_1\\)</span> sentence is represented as a universal second-order set quantifier followed by a first-order sentence. Its truth is expanded as truth of that matrix for every subset interpretation, using the registered first-order satisfaction recursion; raw metalinguistic <span class=\"math-inline\" data-tex=\"\\models\">\\(\\models\\)</span> no longer appears in the object formula.</li>\n<li>This does not assert the existence of a normal measure, which would strengthen weak compactness to measurability.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch11/58-df-zfc-weakly-compact-cardinal.md","status":"resolved","id":"3b1542a0cd60ec5a","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-zfc-weakly-compact-cardinal.md]]","embed":false},{"target":"../batch05/58-df-ideal.md","status":"resolved","id":"6e4f95381faac4f9","anchor":"ref-2","targetAnchor":"",