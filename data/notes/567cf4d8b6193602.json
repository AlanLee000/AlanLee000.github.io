lay":false},{"tex":"|A|","display":false},{"tex":"A","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}pcf3\\text{-}scale\\text{-}good\\text{-}point}\\vdash\n\\mathrm{ZfcPcf3ScaleGoodPoint}_S(A,J,\\vec f,\\delta)\\\\\n&\\quad\\leftrightarrow\n\\mathrm{ZfcPcf2Scale}_S(A,J,\\operatorname{dom}(\\vec f),\\vec f)\n\\land\\mathrm{LimitOrdinal}_S(\\delta)\n\\land\\delta<\\operatorname{dom}(\\vec f)\n\\land\\operatorname{cf}(\\delta)>|A|\\\\\n&\\qquad\\land\n\\exists U\\subseteq\\delta\\;\\exists S\\;\n\\Bigl[\n\\mathrm{Cofinal}_S(U,\\delta)\n\\land\\mathrm{Function}(S,U,J)\n\\land\n\\forall\\alpha,\\beta\\in U\\;\n\\bigl(\n\\alpha<\\beta\\to\\\\\n&\\hspace{42mm}\n\\forall a\\in A\\setminus(S(\\alpha)\\cup S(\\beta))\\;\n\\vec f(\\alpha)(a)<\\vec f(\\beta)(a)\n\\bigr)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"J","display":false}],"bytes":1803,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3076","locations":["正文"],"count":1,"excerpt":"[[../batch04/58-df-zfc-pcf3-scale-good-point.md|58-df-zfc-pcf3-scale-good-point]]（batch04）"}],"outgoing":["a3348ed9eb6fb4e3","255774e81caebda9","81cabbac7fa4d75d","6c8f804f98505ae8","315ad00b8744fdfc","36d7463d215be751","2be08d4ee8aa1590"]}