ge_{i<2}(\\mathbf a_i'=\\mathbf a_i\\vee\\mathbf0'=\\mathbf b)].","display":true},{"tex":"B\\in\\mathbf b","display":false},{"tex":"B","display":false},{"tex":"e","display":false},{"tex":"e","display":false},{"tex":"e","display":false},{"tex":"B(e)","display":false},{"tex":"\\varnothing'","display":false},{"tex":"B(e)","display":false},{"tex":"A_i'\\le_TB","display":false},{"tex":"A_i\\oplus\\varnothing'","display":false},{"tex":"A_i","display":false},{"tex":"B(e)","display":false},{"tex":"B\\le_TA_i\\oplus\\varnothing'\\le_TA_i'","display":false}],"bytes":2137,"backlinks":[{"id":"005203b6707a19f4","anchor":"ref-291","locations":["正文"],"count":1,"excerpt":"[[20-thm-incomparable-jump-inverses]] — 章 6；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-291","locations":["正文"],"count":1,"excerpt":"[[20-thm-incomparable-jump-inverses]]"}],"outgoing":["02c10d5d18aba717","45ca9c4551913b6a","e890b3c29e4a70a3","e888141c21b61ce5"]}