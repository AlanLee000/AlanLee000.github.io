{"id":"c4da5e95c10688be","group":"58","path":"58/batch03/58-df-zfc-descriptive2-pointclass.md","title":"ZFC Descriptive2 Pointclass","display":"df-zfc-descriptive2-pointclass — ZFC Descriptive2 Pointclass","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-descriptive2-pointclass","aliases":["58-df-zfc-descriptive2-pointclass"],"display":"df-zfc-descriptive2-pointclass — ZFC Descriptive2 Pointclass","depends_on":["[[58-ax-zfc]]","[[58-df-family]]","[[58-df-set]]","[[58-df-function]]","[[58-df-zfc-descriptive2-standard-borel-space]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-descriptive2-pointclass"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-descriptive2-pointclass</span></div>"},{"key":"display","html":"df-zfc-descriptive2-pointclass — ZFC Descriptive2 Pointclass"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"545b51e7aa011030\" href=\"?note=545b51e7aa011030\" title=\"58-df-family\">58-df-family</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"65d9a1e690c32aad\" href=\"?note=65d9a1e690c32aad\" title=\"58-df-set\">58-df-set</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"3169dc41990b4bbe\" href=\"?note=3169dc41990b4bbe\" title=\"58-df-zfc-descriptive2-standard-borel-space\">58-df-zfc-descriptive2-standard-borel-space</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\Sigma,D,\\Gamma,B,d\\in V\">\\(X,\\Sigma,D,\\Gamma,B,d\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{StandardBorelSpace}:V^2\\to\\{\\top,\\bot\\}\">\\(\\operatorname{StandardBorelSpace}:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"3169dc41990b4bbe\" href=\"?note=3169dc41990b4bbe\" title=\"58-df-zfc-descriptive2-standard-borel-space\">58-df-zfc-descriptive2-standard-borel-space</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcDescriptive2Pointclass}_S\\subseteq V^2\">\\(\\mathrm{ZfcDescriptive2Pointclass}_S\\subseteq V^2\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}pointclass}\\vdash\n\\mathrm{ZfcDescriptive2Pointclass}_S(\\Gamma,D)\n\\leftrightarrow\n\\exists B\\in V\\;\\Bigl(\n\\mathrm{Function}(\\Gamma,D,B)\n\\land\\forall d\\in D\\;\\exists X,\\Sigma\\in V\\;\\Bigl(\nd=\\langle X,\\Sigma\\rangle\n\\land\\operatorname{StandardBorelSpace}(X,\\Sigma)\n\\land\\Gamma(d)\\subseteq\\mathcal P(X)\\Bigr)\n\\Bigr).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}pointclass}\\vdash\n\\mathrm{ZfcDescriptive2Pointclass}_S(\\Gamma,D)\n\\leftrightarrow\n\\exists B\\in V\\;\\Bigl(\n\\mathrm{Function}(\\Gamma,D,B)\n\\land\\forall d\\in D\\;\\exists X,\\Sigma\\in V\\;\\Bigl(\nd=\\langle X,\\Sigma\\rangle\n\\land\\operatorname{StandardBorelSpace}(X,\\Sigma)\n\\land\\Gamma(d)\\subseteq\\mathcal P(X)\\Bigr)\n\\Bigr).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"D\">\\(D\\)</span> is an explicit set of pairs <span class=\"math-inline\" data-tex=\"\\langle X,\\Sigma\\rangle\">\\(\\langle X,\\Sigma\\rangle\\)</span> carrying the measurable structure required by the exact two-place standard-Borel predicate. A global pointclass is represented by these set-sized restrictions, not by a function on the proper class <span class=\"math-inline\" data-tex=\"V\">\\(V\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-family","status":"resolved","id":"545b51e7aa011030","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-family]]","embed":false},{"target":"58-df-set","status":"resolved","id":"65d9a1e690c32aad","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-set]]","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-function]]","embed":false},{"target":"58-df-zfc-descriptive2-standard-borel-space","status":"resolved","id":"3169dc41990b4bbe","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-descriptive2-standard-borel-space]]","embed":false},{"target":"58-df-zfc-descriptive2-standard-borel-space","status":"resolved","id":"3169dc41990b4bbe","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{StandardBorelSpace}:V^2\\to\\{\\top,\\bot\\}$ (see [[58-df-zfc-descriptive2-standard-borel-space]])","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}\\subseteq V^3$ (see [[58-df-function]])","embed":false}],"math":[{"tex":"X,\\Sigma,D,\\Gamma,B,d\\in V","display":false},{"tex":"\\operatorname{StandardBorelSpace}:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Function}\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcDescriptive2Pointclass}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}descriptive2\\text{-}pointclass}\\vdash\n\\mathrm{ZfcDescriptive2Pointclass}_S(\\Gamma,D)\n\\leftrightarrow\n\\exists B\\in V\\;\\Bigl(\n\\mathrm{Function}(\\Gamma,D,B)\n\\land\\forall d\\in D\\;\\exists X,\\Sigma\\in V\\;\\Bigl(\nd=\\langle X,\\Sigma\\rangle\n\\land\\operatorname{StandardBorelSpace}(X,\\Sigma)\n\\land\\Gamma(d)\\subseteq\\mathcal P(X)\\Bigr)\n\\Bigr).","display":true},{"tex":"D","display":false},{"tex":"\\langle X,\\Sigma\\rangle","display":false},{"tex":"V","display":false}],"bytes":1371,"backlinks":[{"id":"5504b232d98f6167","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"66b7b29c36e8cacb","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"afe5ed5400a824d0","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcDescriptive2Pointclass}_S$ 使用 [[../batch03/58-df-zfc-descriptive2-pointclass.md]]。"},{"id":"84daad544872cc71","anchor":"ref-1814","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-descriptive2-pointclass.md|58-df-zfc-descriptive2-pointclass]]（batch03）"}],"outgoing":["a3348ed9eb6fb4e3","545b51e7aa011030","65d9a1e690c32aad","36d7463d215be751","3169dc41990b4bbe"]}