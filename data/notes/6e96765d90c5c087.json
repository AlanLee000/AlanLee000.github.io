hi,P,\\leq_P,G)\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing11\\text{-}preservation\\text{-}template} \\vdash\n\\mathrm{ZfcForcing11PreservationTemplateData}_S(T,M,P,\\leq_P,\\Phi,\\Psi,L,\\mathfrak M,\\mathcal N,\\mathcal S)\\leftrightarrow\\left(\nT=\\langle M,P,\\leq_P,\\Phi,\\Psi,L\\rangle\\land\n\\mathrm{Univ}(\\mathfrak M)=M\\land\\mathrm{Model}_S(\\mathfrak M,\\Phi,L)\\land\n\\mathrm{Function}(\\mathcal N,\\mathcal G_{M,\\Phi,P,\\leq_P},\\mathcal S)\\land\n\\forall G\\in\\mathcal G_{M,\\Phi,P,\\leq_P}\\;\\left(\n\\mathrm{Struct}_S(\\mathcal N(G),L)\\land\\mathrm{Univ}(\\mathcal N(G))=M[G]_P\\land\n\\mathrm{Model}_S(\\mathcal N(G),\\Psi,L)\n\\right)\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing11\\text{-}preservation\\text{-}template} \\vdash\n\\mathrm{ZfcForcing11PreservationTemplateData}_S(T,M,P,\\leq_P,\\Phi,\\Psi,L,\\mathfrak M,\\mathcal N,\\mathcal S)\\leftrightarrow\\left(\nT=\\langle M,P,\\leq_P,\\Phi,\\Psi,L\\rangle\\land\n\\mathrm{Univ}(\\mathfrak M)=M\\land\\mathrm{Model}_S(\\mathfrak M,\\Phi,L)\\land\n\\mathrm{Function}(\\mathcal N,\\mathcal G_{M,\\Phi,P,\\leq_P},\\mathcal S)\\land\n\\forall G\\in\\mathcal G_{M,\\Phi,P,\\leq_P}\\;\\left(\n\\mathrm{Struct}_S(\\mathcal N(G),L)\\land\\mathrm{Univ}(\\mathcal N(G))=M[G]_P\\land\n\\mathrm{Model}_S(\\mathcal N(G),\\Psi,L)\n\\right)\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing11\\text{-}preservation\\text{-}template\\text{-}projection}\\vdash\n\\mathrm{ZfcForcing11PreservationTemplate}_S(T,M,P,\\leq_P,\\Phi,\\Psi)\n\\leftrightarrow\\exists L,\\mathfrak M,\\mathcal N,\\mathcal S\\in V\\;\n\\mathrm{ZfcForcing11PreservationTemplateData}_S(T,M,P,\\leq_P,\\Phi,\\Psi,L,\\mathfrak M,\\mathcal N,\\mathcal S).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing11\\text{-}preservation\\text{-}template\\text{-}projection}\\vdash\n\\mathrm{ZfcForcing11PreservationTemplate}_S(T,M,P,\\leq_P,\\Phi,\\Psi)\n\\leftrightarrow\\exists L,\\mathfrak M,\\mathcal N,\\mathcal S\\in V\\;\n\\mathrm{ZfcForcing11PreservationTemplateData}_S(T,M,P,\\leq_P,\\Phi,\\Psi,L,\\mathfrak M,\\mathcal N,\\mathcal S).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\Phi\">\\(\\Phi\\)</span> and <span class=\"math-inline\" data-tex=\"\\Psi\">\\(\\Psi\\)</span> are explicit theories of the same language; both the ground model and every generic extension are represented by set structure codes with selected universes.</li>\n<li>泛型族现在调用上游五元 <span class=\"math-inline\" data-tex=\"\\operatorname{ForcingSetup}_S\">\\(\\operatorname{ForcingSetup}_S\\)</span> 并把地模型理论 <span class=\"math-inline\" data-tex=\"\\Phi\">\\(\\Phi\\)</span> 传入；扩张论域使用该来源定义的 <span class=\"math-inline\" data-tex=\"M[G]_P\">\\(M[G]_P\\)</span>，不再调用缺少 forcing 参数的自由项 <span class=\"math-inline\" data-tex=\"M[G]\">\\(M[G]\\)</span>。核心十元关系与六元存在投影也不再共享同一符号而重载元数。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch15/58-df-forcing.md","status":"resolved","id":"d06ac5a66d69d291","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-forcing.md]]","embed":false},{"target":"../batch09/58-df-model.md","status":"resolved","id":"923884eb8fe4e61d",