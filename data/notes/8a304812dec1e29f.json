9","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"fff5dc780f29d486","anchor":"ref-5","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-projection-function.md]] — 投影函数"},{"id":"e8997cda0865ef9b","anchor":"ref-5","locations":["正文"],"count":1,"excerpt":"[[58-df-projection-function]] — 投影函数"},{"id":"84daad544872cc71","anchor":"ref-997","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-projection-function.md|58-df-projection-function]]（batch11）"}],"outgoing":["36d7463d215be751","5045d216c83e75cb","fff5dc780f29d486","e8997cda0865ef9b","1cf46a0ea13ab5dd"]}