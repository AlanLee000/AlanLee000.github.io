t{-}antibasis}\\vdash\n\\operatorname{Antibasis}(D).","display":true},{"tex":"\\mathcal C=[T]","display":false},{"tex":"T","display":false},{"tex":"\\deg_T(A)","display":false},{"tex":"\\mathcal C","display":false},{"tex":"K","display":false},{"tex":"e","display":false},{"tex":"n=|\\sigma|","display":false},{"tex":"K","display":false},{"tex":"\\varphi_e(n)","display":false},{"tex":"0","display":false},{"tex":"1","display":false},{"tex":"0","display":false},{"tex":"A","display":false},{"tex":"K","display":false},{"tex":"\\exists\\rho\\succeq\\sigma\\,[\\Phi_e^\\rho(e)\\downarrow]","display":false},{"tex":"e\\in A'","display":false},{"tex":"K","display":false},{"tex":"A'\\le_TK","display":false},{"tex":"K\\le_TA'","display":false},{"tex":"A","display":false},{"tex":"\\mathcal C","display":false},{"tex":"K","display":false},{"tex":"\\alpha","display":false},{"tex":"T","display":false},{"tex":"\\eta","display":false},{"tex":"\\Phi_e^A","display":false},{"tex":"[T]","display":false},{"tex":"\\rho","display":false},{"tex":"V_\\rho","display":false},{"tex":"K","display":false},{"tex":"V_\\rho=\\varnothing","display":false},{"tex":"T","display":false},{"tex":"[T]","display":false},{"tex":"\\rho","display":false},{"tex":"\\Phi_e^A=h\\in2^\\omega","display":false},{"tex":"h(n)","display":false},{"tex":"\\alpha\\succeq\\rho","display":false},{"tex":"\\eta","display":false},{"tex":"|\\eta|>n","display":false},{"tex":"A","display":false},{"tex":"\\eta(n)\\ne h(n)","display":false},{"tex":"A","display":false},{"tex":"V_\\rho","display":false},{"tex":"\\eta(n)","display":false},{"tex":"h","display":false},{"tex":"h\\le_TA","display":false},{"tex":"h\\notin\\mathcal C","display":false},{"tex":"h","display":false},{"tex":"A","display":false},{"tex":"h\\equiv_TA","display":false},{"tex":"\\mathcal C","display":false},{"tex":"D","display":false},{"tex":"\\Pi_1","display":false}],"bytes":3992,"backlinks":[],"outgoing":["a03c2828834ee687","91065cedbdf2fc27","140cce30ee9c16d1","4b1f1864d7fb1f2e","de54fb8c1326b2f0","2ea8548c98f572c3","a2e45aeae7b65467","b650dc2733f4802d"]}