thcal T).\n\\end{aligned}","display":true}],"bytes":1807,"backlinks":[{"id":"18e84a8354274052","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"29bf786772c49a4b","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"1ff2903ad51947b1","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{StoneSpace}_{93}$ and $\\mathrm{TopAlg}_{93,\\tau}$ are the predicates of [[93-df-stone-space]] and [[93-df-profinite]]."},{"id":"57abb955e28f83aa","anchor":"ref-83","locations":["正文"],"count":1,"excerpt":"[[93-df-stone-space]]"}],"outgoing":["2f5dec406c92aa2e","e30eac382dc7d1a7"]}