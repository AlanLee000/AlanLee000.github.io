ned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}shoenfield\\text{-}absoluteness}[\\varphi]\\vdash{}&\n\\mathrm{TransitiveModel}_S(M)\\land\\mathrm{TransitiveModel}_S(N)\n\\land M\\subseteq N\\land\\omega_1^N\\in M\n\\land r\\in\\mathbb R\\cap M\\\\\n&\\to\\Bigl(\n\\mathrm{MembershipTruth}_S(M,\\varphi^{\\mathrm{set}},r)\n\\leftrightarrow\n\\mathrm{MembershipTruth}_S(N,\\varphi^{\\mathrm{set}},r)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\Sigma_1^1","display":false},{"tex":"\\Pi_1^1","display":false},{"tex":"\\Sigma_3^1","display":false},{"tex":"\\varphi","display":false},{"tex":"M","display":false},{"tex":"\\omega_1^N\\in M","display":false},{"tex":"\\omega_1^N","display":false},{"tex":"M","display":false},{"tex":"V","display":false},{"tex":"L","display":false},{"tex":"V","display":false},{"tex":"\\omega_1","display":false}],"bytes":3316,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4417","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-thm-shoenfield-absoluteness.md|58-thm-shoenfield-absoluteness]]（batch19）"},{"id":"7334957c6d59eacc","anchor":"ref-257","locations":["正文"],"count":1,"excerpt":"[[58-thm-0-sharp.md]]\n[[58-thm-L-condensation.md]]\n[[58-thm-L-definability.md]]\n[[58-thm-L-generic-extension.md]]\n[[58-thm-L-is-transitive.md]]\n[[58-thm-L-satisfies-GCH.md]]\n[[58-thm-L-satisfies-ZFC.md]]\n[[58-thm-MM.md]]\n[[58-thm-V-equal-L.md]]\n[[58-thm-V-equals-L.md]]\n[[58-thm-absoluteness-calculation.md]]\n[[58-thm-ac-wellorder-equivalent.md]]\n[[58-thm-aleph-properties.md]]\n[[58-thm-analytic-completeness.md]]\n[[58-thm-analytic-set-properties.md]]\n[[58-thm-baire-category-theory.md]]\n[[58-thm-baire-category.md]]\n[[58-thm-banach-tarski.md]]\n[[58-thm-beth-function-properties.md]]\n[[58-thm-boolean-valued-model.md]]\n[[58-thm-borel-cardinality.md]]\n[[58-thm-borel-determinacy-proof.md]]\n[[58-thm-bounded-forcing-axioms.md]]\n[[58-thm-cantor.md]]\n[[58-thm-cardinal-multiplication.md]]\n[[58-thm-club-filter-properties.md]]