in\\mathcal T\\;(A\\neq B\\to A\\cap B=\\emptyset)\\\\\n&\\land\\mathcal P=\\Bigl\\{C\\subseteq M\\setminus\\bigcup\\mathcal T:\\mathrm{Connected}_S(C,\\tau_M\\!\\upharpoonright C)\\land\\neg\\exists D\\in V\\;\\bigl(C\\subsetneq D\\subseteq M\\setminus\\bigcup\\mathcal T\\land\\mathrm{Connected}_S(D,\\tau_M\\!\\upharpoonright D)\\bigr)\\Bigr\\}.\n\\end{aligned}","display":true},{"tex":"3","display":false}],"bytes":2342,"backlinks":[{"id":"ff113b4d11bbe470","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{TorusDecomposition}_S$ (torus-decomposition predicate, see [[../batch18/58-df-torus-decomposition.md]])"},{"id":"84daad544872cc71","anchor":"ref-1303","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-torus-decomposition.md|58-df-torus-decomposition]]（batch18）"}],"outgoing":["815e63e5071e7b58","71801f5b9407391a","c4b4a825f2ea608d","d9a25b0ac94a3598"]}