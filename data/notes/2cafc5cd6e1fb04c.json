ting-node.md\">../batch20/58-df-zfc-tree10-splitting-node.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTree10TreeLevelSet}_S\">\\(\\mathrm{ZfcTree10TreeLevelSet}_S\\)</span> (tree-level predicate, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"48d860d89bef14c5\" href=\"?note=48d860d89bef14c5\" title=\"../batch05/58-df-zfc-tree10-tree-level-set.md\">../batch05/58-df-zfc-tree10-tree-level-set.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTree11SplittingLevelSet}_S\">\\(\\mathrm{ZfcTree11SplittingLevelSet}_S\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}tree11\\text{-}splitting\\text{-}level\\text{-}set} \\vdash \\mathrm{ZfcTree11SplittingLevelSet}_S(S,T,\\alpha)\\leftrightarrow \\exists L\\;(\\mathrm{ZfcTree10TreeLevelSet}_S(L,T,\\alpha)\\land S=\\{t\\in L\\mid\\mathrm{ZfcTree10SplittingNode}_S(t,T)\\})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}tree11\\text{-}splitting\\text{-}level\\text{-}set} \\vdash \\mathrm{ZfcTree11SplittingLevelSet}_S(S,T,\\alpha)\\leftrightarrow \\exists L\\;(\\mathrm{ZfcTree10TreeLevelSet}_S(L,T,\\alpha)\\land S=\\{t\\in L\\mid\\mathrm{ZfcTree10SplittingNode}_S(t,T)\\})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This selects exactly the splitting nodes on the ordinal level <span class=\"math-inline\" data-tex=\"\\alpha\">\\(\\alpha\\)</span> of <span class=\"math-inline\" data-tex=\"T\">\\(T\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch20/58-df-zfc-tree10-splitting-node.md","status":"resolved","id":"ecbf926ec18d5a6f","anchor":"ref-1","target