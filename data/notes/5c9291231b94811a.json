r_\\kappa(U)+1:U\\in\\mathsf{NM}_\\kappa\\},\\\\\no_{\\mathrm M}^{\\kappa}(U)&\\coloneqq r_\\kappa(U)\n\\qquad(U\\in\\mathsf{NM}_\\kappa).\n\\end{aligned}","display":true},{"tex":"o_{\\mathrm M}(\\kappa)=0","display":false},{"tex":"\\kappa","display":false},{"tex":"o_{\\mathrm M}(\\kappa)\\geq1","display":false},{"tex":"\\operatorname{Ult}(\\mathbf V,W)","display":false},{"tex":"\\mathbf V","display":false}],"bytes":2651,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4315","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-thm-mitchells-order.md|58-thm-mitchells-order]]（batch18）"}],"outgoing":["b22660cd0ce1252a","5582a281f15a33c2"]}