{"id":"722e6cb3de98b5b1","group":"58","path":"58/batch10/58-df-zfc-cat-equalizer.md","title":"ZFC Cat Equalizer","display":"df-zfc-cat-equalizer — ZFC Cat Equalizer","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-cat-equalizer","aliases":["58-df-zfc-cat-equalizer"],"display":"df-zfc-cat-equalizer — ZFC Cat Equalizer","depends_on":["[[58-ax-zfc]]","[[../batch04/58-df-category.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-cat-equalizer"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-cat-equalizer</span></div>"},{"key":"display","html":"df-zfc-cat-equalizer — ZFC Cat Equalizer"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"a87b7e1119b63b2c\" href=\"?note=a87b7e1119b63b2c\" title=\"../batch04/58-df-category.md\">../batch04/58-df-category.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"e,E,A,B,f,g,\\mathcal C\\in V\">\\(e,E,A,B,f,g,\\mathcal C\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Category}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Category}_S:V\\to\\{\\top,\\bot\\}\\)</span> (category predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"a87b7e1119b63b2c\" href=\"?note=a87b7e1119b63b2c\" title=\"../batch04/58-df-category.md\">../batch04/58-df-category.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCatEqualizer}_S:V^7\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcCatEqualizer}_S:V^7\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}cat\\text{-}equalizer} \\vdash \\mathrm{ZfcCatEqualizer}_S(e,E,A,B,f,g,\\mathcal C)\\leftrightarrow \\mathrm{Category}_S(\\mathcal C)\\land\\exists O,M,s,t,\\star,\\iota\\in V\\;\\Bigl(\\mathcal C=(O,M,s,t,\\star,\\iota)\\land E,A,B\\in O\\land e,f,g\\in M\\land s(e)=E\\land t(e)=A\\land s(f)=A\\land t(f)=B\\land s(g)=A\\land t(g)=B\\land\\star(f,e)=\\star(g,e)\\land\\forall X\\in O\\;\\forall h\\in M\\;\\bigl((s(h)=X\\land t(h)=A\\land\\star(f,h)=\\star(g,h))\\to\\exists!u\\in M\\;(s(u)=X\\land t(u)=E\\land\\star(e,u)=h)\\bigr)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}cat\\text{-}equalizer} \\vdash \\mathrm{ZfcCatEqualizer}_S(e,E,A,B,f,g,\\mathcal C)\\leftrightarrow \\mathrm{Category}_S(\\mathcal C)\\land\\exists O,M,s,t,\\star,\\iota\\in V\\;\\Bigl(\\mathcal C=(O,M,s,t,\\star,\\iota)\\land E,A,B\\in O\\land e,f,g\\in M\\land s(e)=E\\land t(e)=A\\land s(f)=A\\land t(f)=B\\land s(g)=A\\land t(g)=B\\land\\star(f,e)=\\star(g,e)\\land\\forall X\\in O\\;\\forall h\\in M\\;\\bigl((s(h)=X\\land t(h)=A\\land\\star(f,h)=\\star(g,h))\\to\\exists!u\\in M\\;(s(u)=X\\land t(u)=E\\land\\star(e,u)=h)\\bigr)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch04/58-df-category.md","status":"resolved","id":"a87b7e1119b63b2c","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch04/58-df-category.md]]","embed":fals