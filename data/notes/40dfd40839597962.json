{"id":"40dfd40839597962","group":"58","path":"58/batch01/58-df-element.md","title":"Element","display":"df-element — Element","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-element","aliases":["58-df-element"],"display":"df-element — Element","depends_on":[]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-element"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-element</span></div>"},{"key":"display","html":"df-element — Element"},{"key":"depends_on","html":"<span class=\"property-null\">无</span>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"x,A\\in V\">\\(x,A\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Element}_S\">\\(\\mathrm{Element}_S\\)</span> (element predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}element} \\vdash \\mathrm{Element}_S(x,A) \\leftrightarrow x\\in A\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}element} \\vdash \\mathrm{Element}_S(x,A) \\leftrightarrow x\\in A\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This is the atomic membership predicate viewed as an element relation.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[],"math":[{"tex":"x,A\\in V","display":false},{"tex":"\\mathrm{Element}_S","display":false},{"tex":"\\mathrm{df\\text{-}element} \\vdash \\mathrm{Element}_S(x,A) \\leftrightarrow x\\in A","display":true}],"bytes":465,"backlinks":[{"id":"8e9ab8b3f0cb5f0a","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Element}_S\\subseteq V^2$ (see [[../batch01/58-df-element.md]])"},{"id":"84daad544872cc71","anchor":"ref-465","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-element.md|58-df-element]]（batch01）"}],"outgoing":[]}