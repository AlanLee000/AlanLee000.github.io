nelOfTree}_S(K,T)\\\\\n&\\quad\\leftrightarrow\n\\mathrm{ZfcTree9PerfectKernelTree}_S(K,T).\n\\end{aligned}","display":true},{"tex":"T","display":false}],"bytes":1008,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3797","locations":["正文"],"count":1,"excerpt":"[[../batch04/58-df-zfc-tree11-perfect-kernel-of-tree.md|58-df-zfc-tree11-perfect-kernel-of-tree]]（batch04）"}],"outgoing":["a3348ed9eb6fb4e3","2ab8bcd7b57a9c4e"]}