\forall}(i,u):i\\in\\mathbb N\\land u\\in Q_n\\},\\qquad\\mathsf{QForm}\\coloneqq\\bigcup_{n\\in\\mathbb N}Q_n.\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}qbf\\text{-}prefix\\text{-}syntax}\\vdash\n\\operatorname{QParse}(\\varphi)\\coloneqq\n\\{(0,i):i\\in\\mathbb N\\land\\varphi=q_v(i)\\}\n\\cup\\{(1,u):u\\in\\mathsf{QForm}\\land\\varphi=q_{\\neg}(u)\\}\n\\cup\\{(2,u,v):u,v\\in\\mathsf{QForm}\\land\\varphi=q_{\\wedge}(u,v)\\}\n\\cup\\{(3,u,v):u,v\\in\\mathsf{QForm}\\land\\varphi=q_{\\vee}(u,v)\\}\n\\cup\\{(4,i,u):i\\in\\mathbb N\\land u\\in\\mathsf{QForm}\\land\\varphi=q_{\\exists}(i,u)\\}\n\\cup\\{(5,i,u):i\\in\\mathbb N\\land u\\in\\mathsf{QForm}\\land\\varphi=q_{\\forall}(i,u)\\}.","display":true},{"tex":"\\mathrm{df\\text{-}qbf\\text{-}prefix\\text{-}syntax}\\vdash\n\\forall\\varphi\\in\\mathsf{QForm}\\;|\\operatorname{QParse}(\\varphi)|=1,\\qquad\n\\forall u,v\\in\\mathsf{QForm}\\;\\forall z\\in\\mathbf2^*\\;(uz=v\\Longrightarrow z=\\varepsilon).","display":true},{"tex":"\\mathrm{df\\text{-}qbf\\text{-}prefix\\text{-}syntax}\\vdash\n\\forall u,v\\in\\mathsf{QForm}\\;\\forall i\\in\\mathbb N\\;\\bigl[\n|u|<|q_{\\neg}(u)|\\land\\max\\{|u|,|v|\\}<|q_{\\wedge}(u,v)|\n\\land\\max\\{|u|,|v|\\}<|q_{\\vee}(u,v)|\n\\land|u|<|q_{\\exists}(i,u)|\\land|u|<|q_{\\forall}(i,u)|\\bigr].","display":true}],"bytes":3735,"backlinks":[{"id":"011094b454369426","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\varphi,\\psi\\in\\mathsf{QForm}$，$i,j\\in\\mathbb N$、$b\\in\\mathbf2$，$\\nu:\\mathbb N\\to\\mathbf2$。语法构造子及唯一解析见 [[73-df-qbf-prefix-syntax]]；以下递归按严格子公式进行。$\\operatorname{FV}:\\mathsf{QForm}\\to\\mathcal P_{\\mathrm{fin}}(\\mathbb N)$，$\\operatorname{val}_{\\nu}:\\mathsf{QForm}\\to\\mathbf2$。"},{"id":"6af52783a9bce985","anchor":"ref-301","locations":["正文"],"count":1,"excerpt":"[[73-df-qbf-prefix-syntax|带量词布尔公式的自定界二进制语法]]"}],"outgoing":["0a6da8c909717780"]}