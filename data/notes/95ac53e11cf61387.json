}instance} \\vdash_{\\mathrm{meta}}\n\\mathrm{ZfcDescriptiveShoensfieldAbsolutenessInstance}_{\\mathrm{meta}}(M,N,\\varphi,x) \\leftrightarrow\n\\mathrm{TransitiveModel}_S(M)\\land\\mathrm{TransitiveModel}_S(N)\n\\land M\\subseteq N\n\\land\\{\\alpha\\in M:\\mathrm{Ordinal}(\\alpha)\\}\n=\\{\\alpha\\in N:\\mathrm{Ordinal}(\\alpha)\\}\n\\land x\\in M\\cap\\omega^\\omega\n\\land\\varphi\\in\\Sigma^1_2\\cup\\Pi^1_2\n\\land\\Bigl(\n\\langle\\omega,\\mathcal P(\\omega)\\cap M\\rangle\\models_2\\varphi(x)\n\\leftrightarrow\n\\langle\\omega,\\mathcal P(\\omega)\\cap N\\rangle\\models_2\\varphi(x)\\Bigr)","display":true},{"tex":"M\\subseteq N","display":false}],"bytes":2161,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1805","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-zfc-descriptive-shoensfield-absoluteness-instance.md|58-df-zfc-descriptive-shoensfield-absoluteness-instance]]（batch14）"}],"outgoing":["a9132c2c1a18acd1","55c96a19a00b58ed","5582a281f15a33c2"]}