ha\\in[0,1]^n:\\forall T\\in D\\;\\left(\\sum_{i\\in P_T}\\alpha_i+\\sum_{j\\in N_T}(1-\\alpha_j)\\leq1\\right)\\right\\}.","display":true},{"tex":"\\mathrm{QHornDNF}_n\\coloneqq\\{D\\in\\mathrm{DNF}_n:\\mathcal P_D\\neq\\varnothing\\}.","display":true},{"tex":"\\rho(\\alpha)_i\\coloneqq\\begin{cases}0&\\alpha_i<\\frac12,\\\\\\frac12&\\alpha_i=\\frac12,\\\\1&\\alpha_i>\\frac12,\\end{cases}\\quad(i\\in[n]),\\qquad H(\\alpha)\\coloneqq\\{i\\in[n]:\\alpha_i=\\frac12\\}.","display":true}],"bytes":1855,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-54","locations":["正文"],"count":2,"excerpt":"[[27-df-qhornpolyhedron|df-qhornpolyhedron — Q-Horn feasibility polyhedron and half-integral rounding]]"},{"id":"3148ea93514fc833","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$n\\in\\mathbb N$。$D\\in\\mathrm{DNF}_n$；$\\mathcal P_D,\\rho,H$ 见 [[27-df-qhornpolyhedron]]。"}],"outgoing":["0b618255959ff4bc","8311e93eaac6c631"]}