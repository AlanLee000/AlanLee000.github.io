},{"tex":"n","display":false},{"tex":"Q\\subseteq\\mathrm{Th}(G)","display":false},{"tex":"\\mathrm{lem\\text{-}self\\text{-}reference\\text{-}construction}\\vdash\nQ\\subseteq\\mathrm{Th}(G)\\Longrightarrow\n\\forall\\theta\\in\\mathrm{Fml}_G\\;\\Bigl(\n\\mathrm{FV}_G(\\theta)\\subseteq\\{v_1\\}\\Longrightarrow\n\\exists\\delta_d\\in\\mathrm{Fml}_G\\;\n\\exists\\eta_\\theta\\in\\mathrm{Fml}_G\\;\n\\exists\\gamma_\\theta\\in\\mathrm{Fml}_G\\;\\Bigl[\n\\begin{aligned}\n&\\mathrm{FV}_G(\\delta_d)\\subseteq\\{v_0,v_1\\},\\\\\n&\\forall n\\in\\mathbb N\\;\nG\\vdash\\forall v_1\\Bigl(\n\\mathrm{Subst}_G(\\delta_d,\\bar n,v_0)\n\\leftrightarrow v_1=\\overline{\\widehat d(n)}\\Bigr),\\\\\n&\\eta_\\theta=\\exists v_1\\,(\\delta_d\\land\\theta),\\\\\n&\\gamma_\\theta=\n\\mathrm{Subst}_G(\\eta_\\theta,\\overline{\\ulcorner\\eta_\\theta\\urcorner},v_0),\\\\\n&\\gamma_\\theta\\in\\mathrm{Sent}_G,\\\\\n&G\\vdash\\Bigl(\n\\gamma_\\theta\\leftrightarrow\n\\mathrm{Subst}_G(\\theta,\\overline{\\ulcorner\\gamma_\\theta\\urcorner},v_1)\n\\Bigr)\n\\end{aligned}\n\\Bigr]\\Bigr)","display":true},{"tex":"\\delta_d","display":false},{"tex":"D_d","display":false},{"tex":"\\eta_\\theta","display":false},{"tex":"\\eta_\\theta","display":false},{"tex":"\\gamma_\\theta","display":false},{"tex":"\\widehat d","display":false},{"tex":"d","display":false},{"tex":"\\widehat d(\\ulcorner\\eta_\\theta\\urcorner)=\\ulcorner\\gamma_\\theta\\urcorner","display":false},{"tex":"\\mathrm{Subst}_G","display":false},{"tex":"\\theta(\\overline{\\ulcorner\\gamma_\\theta\\urcorner})","display":false},{"tex":"Q\\subseteq\\mathrm{Th}(G)","display":false},{"tex":"Q","display":false},{"tex":"G","display":false},{"tex":"Q\\subseteq\\mathrm{Ax}(G)","display":false},{"tex":"G","display":false}],"bytes":3583,"backlinks":[{"id":"f28281ca315fc78c","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"ced07f0d506d2066","anchor":"ref-17","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"它