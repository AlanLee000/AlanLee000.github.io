gle\\in\\operatorname{Mor}(\\mathcal D)\\}\n\\right\\rangle\\\\\n&\\land\\mathrm{Functor}_S(E,\\mathcal D,\\mathcal A).\n\\end{aligned}","display":true}],"bytes":4076,"backlinks":[{"id":"6eedc7cef16ac70e","anchor":"ref-11","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{EvaluationFunctor}$、$\\mathrm{FullFunctorSubcategory}$、$\\mathrm{FunctorCodes}$ 取 [[../batch15/58-df-functor-subcategory.md]] 的同名定义与参数次序。"},{"id":"3de4d546216326d8","anchor":"ref-7","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"外部接口 $\\mathrm{FunctorCodes}$ 取 [[../batch15/58-df-functor-subcategory.md]] 的同名定义与参数次序。"},{"id":"84daad544872cc71","anchor":"ref-566","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-functor-subcategory.md|58-df-functor-subcategory]]（batch15）"}],"outgoing":["e637becf421e4e61","877f1061e295cf5f","970e2b8779070da0","a87b7e1119b63b2c"]}