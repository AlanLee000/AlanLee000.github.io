","display":false},{"tex":"\\mathsf{LineOK}_{\\mathsf{IPC}}(\\Gamma,\\pi,i)\n\\Longleftrightarrow\nA_i\\in\\Gamma\n\\lor\nA_i\\in\\mathsf{Ax}_{\\mathsf{IPC}}\n\\lor\n\\exists j,k<i\\,((A_j,A_k),A_i)\\in\\mathsf{Rule}_{\\mathsf{MP}}^{\\mathsf{IPC}}.","display":true},{"tex":"\\mathsf{MainJud}_{\\mathsf{IPC}}\n=\n\\{(\\Gamma,A,\\pi):\n\\Gamma\\subseteq\\mathsf{Frm}_{\\mathsf{IPC}},\nA\\in\\mathsf{Frm}_{\\mathsf{IPC}},\n\\pi\\in\\mathsf{Prf}_{\\mathsf{IPC}}(\\Gamma,A)\\}.","display":true},{"tex":"\\pi\\in\\mathsf{Prf}_{\\mathsf{IPC}}(\\Gamma,A)","display":false},{"tex":"(\\Gamma,A,\\pi)\\in\\mathsf{MainJud}_{\\mathsf{IPC}}","display":false},{"tex":"\\Gamma\\vdash_{\\mathsf{IPC}}A","display":true},{"tex":"\\mathsf{Prf}_{\\mathsf{IPC}}(\\Gamma,A)\\ne\\varnothing.","display":true},{"tex":"\\mathsf{Thm}_{\\mathsf{IPC}}\n=\n\\{A\\in\\mathsf{Frm}_{\\mathsf{IPC}}:\\varnothing\\vdash_{\\mathsf{IPC}}A\\}.","display":true},{"tex":"\\mathcal{IPC}\n=\n(\\mathsf{Prop},\n\\mathsf{Frm}_{\\mathsf{IPC}},\n\\operatorname{FV}_{\\mathsf{IPC}},\n\\operatorname{BV}_{\\mathsf{IPC}},\n\\operatorname{Sub}_{\\mathsf{IPC}},\n\\equiv_{\\alpha,\\mathsf{IPC}},\n\\mathsf{Ax}_{\\mathsf{IPC}},\n\\mathsf{Rule}_{\\mathsf{MP}}^{\\mathsf{IPC}},\n\\mathsf{LineOK}_{\\mathsf{IPC}},\n\\mathsf{MainJud}_{\\mathsf{IPC}},\n\\mathsf{Prf}_{\\mathsf{IPC}},\n\\vdash_{\\mathsf{IPC}},\n\\mathsf{Thm}_{\\mathsf{IPC}}).","display":true}],"bytes":6974,"backlinks":[],"outgoing":[]}