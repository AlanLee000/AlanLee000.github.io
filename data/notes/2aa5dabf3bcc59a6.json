o(A),\\widehat\\rho(B)),\n\\qquad\n\\widehat\\rho(\\operatorname{or}(A,B))=\\operatorname{or}(\\widehat\\rho(A),\\widehat\\rho(B)).","display":true},{"tex":"\\operatorname{RenAct}_{PDLdep}(A,\\rho)=\\widehat\\rho(A)","display":false},{"tex":"\\operatorname{BV}_{PDLdep}(A)=\\varnothing,\n\\qquad\nA\\equiv_\\alpha^{PDLdep}B\\Longleftrightarrow A=B.","display":true},{"tex":"V\\subseteq\\mathsf{Prop}","display":false},{"tex":"s:V\\to\\{0,1\\}","display":false},{"tex":"X\\subseteq\\{0,1\\}^{V}.","display":true},{"tex":"\\mathsf{Team}_{Prop}(V)=\\{X:X\\subseteq\\{0,1\\}^{V}\\},\n\\qquad\n\\mathsf{Team}_{Prop}=\\{(V,X):V\\subseteq\\mathsf{Prop},X\\in\\mathsf{Team}_{Prop}(V)\\}.","display":true},{"tex":"p\\in V","display":false},{"tex":"s(p)","display":false},{"tex":"p","display":false},{"tex":"s","display":false},{"tex":"\\operatorname{Split}(X,Y,Z)\n\\Longleftrightarrow\nY\\cup Z=X\\wedge Y\\subseteq X\\wedge Z\\subseteq X.","display":true},{"tex":"\\vec p=(p_0,\\ldots,p_{n-1})","display":false},{"tex":"s(\\vec p)=s'(\\vec p)\n\\Longleftrightarrow\n\\forall i<n\\ s(p_i)=s'(p_i).","display":true},{"tex":"\\models_{PDLdep}\n\\ \\subseteq\\ \n\\mathsf{Team}_{Prop}\\times\\mathsf{Fm}_{PDLdep}.","display":true},{"tex":"X\\in\\mathsf{Team}_{Prop}(V)","display":false},{"tex":"\\operatorname{FV}(A)\\subseteq V","display":false},{"tex":"(V,X)\\models_{PDLdep}A","display":false},{"tex":"(V,X)\\models\\operatorname{pos}(p)\n\\Longleftrightarrow\n\\forall s\\in X\\ s(p)=1,","display":true},{"tex":"(V,X)\\models\\operatorname{negp}(p)\n\\Longleftrightarrow\n\\forall s\\in X\\ s(p)=0,","display":true},{"tex":"(V,X)\\models\\operatorname{dep}(\\alpha;q)\n\\Longleftrightarrow\n\\forall s,s'\\in X\\bigl((\\forall i<n\\ s(\\alpha(i))=s'(\\alpha(i)))\\Rightarrow s(q)=s'(q)\\bigr),","display":true},{"tex":"(V,X)\\models\\operatorname{and}(A,B)\n\\Longleftrightarrow\n(V,X)\\models A\\wedge (V,X)\\models B,","display":true},{"tex":"(V,X)\\models\\operatorname{or}(A,B)\n\\Longleftrightarrow\n\\