n\\mathrm{Hom}_{\\mathcal C}(A,B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}morphism}\\vdash \\mathrm{Mor}_{93}(f,A,B,\\mathcal C)\\leftrightarrow\\mathrm{Cat}_{93}(\\mathcal C)\\land A,B\\in\\mathrm{Obj}_{\\mathcal C}\\land f\\in\\mathrm{Hom}_{\\mathcal C}(A,B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This local predicate packages typed membership in the explicit hom-set family of <a class=\"wiki-link\" id=\"ref-3\" data-note=\"aa74a8aadef06b6c\" href=\"?note=aa74a8aadef06b6c\" title=\"93-df-category\">93-df-category</a>; it introduces no second morphism signature.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"93-df-category","status":"resolved","id":"aa74a8aadef06b6c","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-category]]","embed":false},{"target":"93-df-category","status":"resolved","id":"aa74a8aadef06b6c","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Hom}_{\\mathcal{C}}$ (hom-class, see [[93-df-category]])","embed":false},{"target":"93-df-category","status":"resolved","id":"aa74a8aadef06b6c","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Remark]","excerpt":"This local predicate packages typed membership in the explicit hom-set family of [[93-df-category]]; it introduces no second morphism signature.","embed":false}],"math":[{"tex":"\\mathrm{Cat}_{93}(\\mathcal C)","display":false},{"tex":"A,B\\in\\mathrm{Obj}_{\\mathcal C}","display":false},{"tex":"f","display":false},{"tex":"\\mathrm{Mor}_{93}","display":false},{"tex":"\\mathrm{Hom}_{\\mathcal{C}}","display":false},{"tex":"\\mathrm{df\\text{-}morphism}\\vdash \\mathrm{Mor}_{93}(f,A,B,\\mathcal C)\\leftrightarrow\\mathrm{Cat}_{93}(\\mathcal C)\\land A,B\\in\\mathrm{Obj}_{\\mathcal C}\\land f\\in\\mathrm{Hom}_{\\mathcal C}(A,B)","display":true}],"bytes":838,"backlinks":[{"id":"a57fde3586b9e79c","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Mor}_{93}$ (morphism predicate, see [[93-df-morphism]])"},{"id":"8311ab8098e68fa0","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Mor}_{93}$ and $\\mathrm{Mono}_{93}$ (see [[93-df-morphism]] and [[93-df-monomorphism]])"},{"id":"58d8bff43d6d4102","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Mor}_{93}$ (the typed morphism predicate of [[93-df-morphism]])"},{"id":"7702f850d0f755f5","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Mor}_{93}$ (the typed morphism predicate of [[93-df-morphism]])"},{"id":"5b57b2e83882e1d8","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Mor}_{93}$ (morphism predicate, see [[93-df-morphism]])"}],"outgoing":["aa74a8aadef06b6c"]}