3d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,n,\\Gamma\\in V\">\\(X,\\tau,n,\\Gamma\\in V\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathcal N\\coloneqq\\omega^\\omega\">\\(\\mathcal N\\coloneqq\\omega^\\omega\\)</span> with Baire topology <span class=\"math-inline\" data-tex=\"\\tau_{\\mathcal N}\">\\(\\tau_{\\mathcal N}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Polish}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Polish}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"4b3a8629f6a6f868\" href=\"?note=4b3a8629f6a6f868\" title=\"../batch17/58-df-polish-space.md\">../batch17/58-df-polish-space.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Borel}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Borel}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"dedfc8e5804658ad\" href=\"?note=dedfc8e5804658ad\" title=\"../batch14/58-df-borel-set.md\">../batch14/58-df-borel-set.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5ProductTopology}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop5ProductTopology}_S:V^5\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"5260a5349d0b732f\" href=\"?note=5260a5349d0b732f\" title=\"../batch05/58-df-zfc-top5-product-topology.md\">../batch05/58-df-zfc-top5-product-topology.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ProjectionOne}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ProjectionOne}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{ProductTopologyTwo}_S:V^5\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ProductTopologyTwo}_S:V^5\\to\\{\\top,\\bot\\}\\)</span> (本文件定义)</li>\n<li><span class=\"math-inline\" data-tex=\"\\boldsymbol\\Sigma^1_n(X,\\tau),\\boldsymbol\\Pi^1_n(X,\\tau),\\boldsymbol\\Delta^1_n(X,\\tau)\\in V\">\\(\\boldsymbol\\Sigma^1_n(X,\\tau),\\boldsymbol\\Pi^1_n(X,\\tau),\\boldsymbol\\Delta^1_n(X,\\tau)\\in V\\)</span>（本文件定义）</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcDescriptive3ProjectiveLevel}_S:V^4\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcDescriptive3ProjectiveLevel}_S:V^4\\to\\{\\top,\\bot\\}\\)</span> (本文件定义)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projection}\\vdash\\mathrm{ProjectionOne}_S(\\pi,Y,Z)\\leftrightarrow\\mathrm{Function}(\\pi,Y\\times Z,Y)\\land\\forall y\\in Y\\;\\forall z\\in Z\\;(\\pi(\\langle y,z\\rangle)=y)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projection}\\vdash\\mathrm{ProjectionOne}_S(\\pi,Y,Z)\\leftrightarrow\\mathrm{Function}(\\pi,Y\\times Z,Y)\\land\\forall y\\in Y\\;\\forall z\\in Z\\;(\\pi(\\langle y,z\\rangle)=y)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}product\\text{-}topology}\\vdash{}&amp;\\mathrm{ProductTopologyTwo}_S(\\theta,Y,\\tau_Y,Z,\\tau_Z)\\\\\n\\leftrightarrow{}&amp;\\exists\\vec Y,\\vec\\tau\\in V\\;\\Bigl(\\mathrm{Function}(\\vec Y,2,\\{Y,Z\\})\\land\\vec Y(0)=Y\\land\\vec Y(1)=Z\\\\\n&amp;\\land\\mathrm{Function}(\\vec\\tau,2,\\{\\tau_Y,\\tau_Z\\})\\land\\vec\\tau(0)=\\tau_Y\\land\\vec\\tau(1)=\\tau_Z\\\\\n&amp;\\land\\mathrm{ZfcTop5ProductTopology}_S(2,\\vec Y,\\vec\\tau,Y\\times Z,\\theta)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}product\\text{-}topology}\\vdash{}&amp;\\mathrm{ProductTopologyTwo}_S(\\theta,Y,\\tau_Y,Z,\\tau_Z)\\\\\n\\leftrightarrow{}&amp;\\exists\\vec Y,\\vec\\tau\\in V\\;\\Bigl(\\mathrm{Function}(\\vec Y,2,\\{Y,Z\\})\\land\\vec Y(0)=Y\\land\\vec Y(1)=Z\\\\\n&amp;\\land\\mathrm{Function}(\\vec\\tau,2,\\{\\tau_Y,\\tau_Z\\})\\land\\vec\\tau(0)=\\tau_Y\\land\\vec\\tau(1)=\\tau_Z\\\\\n&amp;\\land\\mathrm{ZfcTop5ProductTopology}_S(2,\\vec Y,\\vec\\tau,Y\\times Z,\\theta)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}sigma1}\\vdash\\mathrm{Polish}_S(X,\\tau)\\to\\boldsymbol\\Sigma^1_1(X,\\tau)\\coloneqq\\{A\\subseteq X:\\exists B,\\theta,\\pi\\in V\\;(B\\subseteq X\\times\\mathcal N\\land\\mathrm{ProductTopologyTwo}_S(\\theta,X,\\tau,\\mathcal N,\\tau_{\\mathcal N})\\land\\mathrm{ProjectionOne}_S(\\pi,X,\\mathcal N)\\land\\mathrm{Borel}_S(B,X\\times\\mathcal N,\\theta)\\land A=\\pi[B])\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}sigma1}\\vdash\\mathrm{Polish}_S(X,\\tau)\\to\\boldsymbol\\Sigma^1_1(X,\\tau)\\coloneqq\\{A\\subseteq X:\\exists B,\\theta,\\pi\\in V\\;(B\\subseteq X\\times\\mathcal N\\land\\mathrm{ProductTopologyTwo}_S(\\theta,X,\\tau,\\mathcal N,\\tau_{\\mathcal N})\\land\\mathrm{ProjectionOne}_S(\\pi,X,\\mathcal N)\\land\\mathrm{Borel}_S(B,X\\times\\mathcal N,\\theta)\\land A=\\pi[B])\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}dual}\\vdash n\\in\\omega\\setminus\\{0\\}\\to\\boldsymbol\\Pi^1_n(X,\\tau)\\coloneqq\\{X\\setminus A:A\\in\\boldsymbol\\Sigma^1_n(X,\\tau)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}dual}\\vdash n\\in\\omega\\setminus\\{0\\}\\to\\boldsymbol\\Pi^1_n(X,\\tau)\\coloneqq\\{X\\setminus A:A\\in\\boldsymbol\\Sigma^1_n(X,\\tau)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}successor}\\vdash n\\in\\omega\\setminus\\{0\\}\\to\\boldsymbol\\Sigma^1_{n+1}(X,\\tau)\\coloneqq\\{A\\subseteq X:\\exists B,\\theta,\\pi\\in V\\;(\\mathrm{ProductTopologyTwo}_S(\\theta,X,\\tau,\\mathcal N,\\tau_{\\mathcal N})\\land\\mathrm{ProjectionOne}_S(\\pi,X,\\mathcal N)\\land B\\in\\boldsymbol\\Pi^1_n(X\\times\\mathcal N,\\theta)\\land A=\\pi[B])\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}successor}\\vdash n\\in\\omega\\setminus\\{0\\}\\to\\boldsymbol\\Sigma^1_{n+1}(X,\\tau)\\coloneqq\\{A\\subseteq X:\\exists B,\\theta,\\pi\\in V\\;(\\mathrm{ProductTopologyTwo}_S(\\theta,X,\\tau,\\mathcal N,\\tau_{\\mathcal N})\\land\\mathrm{ProjectionOne}_S(\\pi,X,\\mathcal N)\\land B\\in\\boldsymbol\\Pi^1_n(X\\times\\mathcal N,\\theta)\\land A=\\pi[B])\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}delta}\\vdash n\\in\\omega\\setminus\\{0\\}\\to\\boldsymbol\\Delta^1_n(X,\\tau)\\coloneqq\\boldsymbol\\Sigma^1_n(X,\\tau)\\cap\\boldsymbol\\Pi^1_n(X,\\tau)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}delta}\\vdash n\\in\\omega\\setminus\\{0\\}\\to\\boldsymbol\\Delta^1_n(X,\\tau)\\coloneqq\\boldsymbol\\Sigma^1_n(X,\\tau)\\cap\\boldsymbol\\Pi^1_n(X,\\tau)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}level} \\vdash \\mathrm{ZfcDescriptive3ProjectiveLevel}_S(n,\\Gamma,X,\\tau)\\leftrightarrow\\mathrm{Polish}_S(X,\\tau)\\land n\\in\\omega\\setminus\\{0\\}\\land\\Gamma\\in\\{\\boldsymbol\\Sigma^1_n(X,\\tau),\\boldsymbol\\Pi^1_n(X,\\tau),\\boldsymbol\\Delta^1_n(X,\\tau)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}projective\\text{-}level} \\vdash \\mathrm{ZfcDescriptive3ProjectiveLevel}_S(n,\\Gamma,X,\\tau)\\leftrightarrow\\mathrm{Polish}_S(X,\\tau)\\land n\\in\\omega\\setminus\\{0\\}\\land\\Gamma\\in\\{\\boldsymbol\\Sigma^1_n(X,\\tau),\\boldsymbol\\Pi^1_n(X,\\tau),\\boldsymbol\\Delta^1_n(X,\\tau)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This is the boldface projective hierarchy of subsets of a Polish space, generated from Borel sets by projection and complement. It is not the lightface analytical hierarchy of second-order arithmetic formula codes.</li>\n<li>乘积拓扑和第一投影现由集合数据谓词见证；层级定义不再依赖隐藏的 <span class=\"math-inline\" data-tex=\"\\tau\\times\\tau_{\\mathcal N}\">\\(\\tau\\times\\tau_{\\mathcal N}\\)</span> 或 <span class=\"math-inline\" data-tex=\"\\pi_X\">\\(\\pi_X\\)</span> 运算。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","sta