{"id":"0913400d5aca3109","group":"58","path":"58/batch03/58-df-zfc-order2-interval.md","title":"ZFC Order2 Interval","display":"df-zfc-order2-interval — ZFC Order2 Interval","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-order2-interval","aliases":["58-df-zfc-order2-interval"],"display":"df-zfc-order2-interval — ZFC Order2 Interval","depends_on":["[[58-df-order]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-order2-interval"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-order2-interval</span></div>"},{"key":"display","html":"df-zfc-order2-interval — ZFC Order2 Interval"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"2aa29158e60b337f\" href=\"?note=2aa29158e60b337f\" title=\"58-df-order\">58-df-order</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"I,P,a,b\\in V\">\\(I,P,a,b\\in V\\)</span> and <span class=\"math-inline\" data-tex=\"\\leq_P\\subseteq P^2\">\\(\\leq_P\\subseteq P^2\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Order}_S:V^2\\to\\mathsf{Bool}\">\\(\\mathrm{Order}_S:V^2\\to\\mathsf{Bool}\\)</span> (see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"2aa29158e60b337f\" href=\"?note=2aa29158e60b337f\" title=\"58-df-order\">58-df-order</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcOrder2Interval}_S:V^5\\to\\mathsf{Bool}\">\\(\\mathrm{ZfcOrder2Interval}_S:V^5\\to\\mathsf{Bool}\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}order2\\text{-}interval} \\vdash \\mathrm{ZfcOrder2Interval}_S(I,a,b,P,\\leq_P)\\leftrightarrow\\mathrm{Order}_S(P,\\leq_P)\\land a\\in P\\land b\\in P\\land I=\\{x\\in P:a\\leq_P x\\land x\\leq_P b\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}order2\\text{-}interval} \\vdash \\mathrm{ZfcOrder2Interval}_S(I,a,b,P,\\leq_P)\\leftrightarrow\\mathrm{Order}_S(P,\\leq_P)\\land a\\in P\\land b\\in P\\land I=\\{x\\in P:a\\leq_P x\\land x\\leq_P b\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-order","status":"resolved","id":"2aa29158e60b337f","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-order]]","embed":false},{"target":"58-df-order","status":"resolved","id":"2aa29158e60b337f","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Order}_S:V^2\\to\\mathsf{Bool}$ (see [[58-df-order]])","embed":false}],"math":[{"tex":"I,P,a,b\\in V","display":false},{"tex":"\\leq_P\\subseteq P^2","display":false},{"tex":"\\mathrm{Order}_S:V^2\\to\\mathsf{Bool}","display":false},{"tex":"\\mathrm{ZfcOrder2Interval}_S:V^5\\to\\mathsf{Bool}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}order2\\text{-}interval} \\vdash \\mathrm{ZfcOrder2Interval}_S(I,a,b,P,\\leq_P)\\leftrightarrow\\mathrm{Order}_S(P,\\leq_P)\\land a\\in P\\land b\\in P\\land I=\\{x\\in P:a\\leq_P x\\land x\\leq_P b\\}","display":true}],"bytes":753,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2935","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-order2-interval.md|58-df-zfc-order2-interval]]（batch03）"}],"outgoing":["2aa29158e60b337f"]}