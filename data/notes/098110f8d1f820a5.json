"ref-5\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"a8154e2b2d1118fd\" href=\"?note=a8154e2b2d1118fd\" title=\"../batch20/58-df-zfc-ordinal2-club-subset.md\">../batch20/58-df-zfc-ordinal2-club-subset.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\kappa,\\alpha,\\vec a,C,\\beta,i\\in V\">\\(\\kappa,\\alpha,\\vec a,C,\\beta,i\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{RegularCardinal}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{RegularCardinal}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"0fbfc19800246e77\" href=\"?note=0fbfc19800246e77\" title=\"../batch13/58-df-regular-cardinal.md\">../batch13/58-df-regular-cardinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcOrdinal2ClubSubset}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcOrdinal2ClubSubset}_S:V^2\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"a8154e2b2d1118fd\" href=\"?note=a8154e2b2d1118fd\" title=\"../batch20/58-df-zfc-ordinal2-club-subset.md\">../batch20/58-df-zfc-ordinal2-club-subset.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcPcf4ApproachableCardinal}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcPcf4ApproachableCardinal}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}pcf4\\text{-}approachable\\text{-}cardinal} \\vdash\n\\mathrm{ZfcPcf4ApproachableCardinal}_S(\\kappa,\\alpha,\\vec a)\n\\leftrightarrow\n\\mathrm{RegularCardinal}_S(\\kappa)\n\\land\\omega\\in\\kappa\n\\land\\alpha\\in\\kappa\n\\land\\mathrm{Function}(\\vec a,\\kappa,\\mathcal P(\\kappa))\n\\land\\forall i\\in\\kappa\\;(\\vec a(i)\\subseteq i)\n\\land\\exists C\\subseteq\\alpha\\;\\Bigl(\n\\mathrm{ZfcOrdinal2ClubSubset}_S(C,\\alpha)\n\\land\\operatorname{otp}(C)=\\operatorname{cf}(\\alpha)\n\\land\\forall\\beta\\in\\alpha\\;\\exists i\\in\\alpha\\;(C\\cap\\beta=\\vec a(i))\n\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}pcf4\\text{-}approachable\\text{-}cardinal} \\vdash\n\\mathrm{ZfcPcf4ApproachableCardinal}_S(\\kappa,\\alpha,\\vec a)\n\\leftrightarrow\n\\mathrm{RegularCardinal}_S(\\kappa)\n\\land\\omega\\in\\kappa\n\\land\\alpha\\in\\kappa\n\\land\\mathrm{Function}(\\vec a,\\kappa,\\mathcal P(\\kappa))\n\\land\\forall i\\in\\kappa\\;(\\vec a(i)\\subseteq i)\n\\land\\exists C\\subseteq\\alpha\\;\\Bigl(\n\\mathrm{ZfcOrdinal2ClubSubset}_S(C,\\alpha)\n\\land\\operatorname{otp}(C)=\\operatorname{cf}(\\alpha)\n\\land\\forall\\beta\\in\\alpha\\;\\exists i\\in\\alpha\\;(C\\cap\\beta=\\vec a(i))\n\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This says that <span class=\"math-inline\" data-tex=\"\\alpha&lt;\\kappa\">\\(\\alpha&lt;\\kappa\\)</span> is approachable relative to the normalized sequence <span class=\"math-inline\" data-tex=\"\\vec a\">\\(\\vec a\\)</span>.</li>\n<li>Initial segments of the witnessing club must occur before <span class=\"math-inline\" data-tex=\"\\alpha\">\\(\\alpha\\)</span>, not merely somewhere below <span class=\"math-inline\" data-tex=\"\\kappa\">\\(\\kappa\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch11/58-df-order-type.md","status":"resolved","id":"5d2cd56a38a81b7a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-order-type.md]]","embed":false},{"target":"../batch13/58-df-cofinality.md","status":"resolved","id":"315ad00b8744fdfc","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-cofinality.md]]","embed":false},{"target":"../batch13/58-df-regular-cardinal.md","status":"resolved","id":"0fbfc19800246e77","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-regular-cardinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch20/58-df-zfc-ordinal2-club-subset.md","status":"resolved","id":"a8154e2b2d1118fd","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch20/58-df-zfc-ordinal2-club-subset.md]]","embed":false},{"target":"../batch13/58-df-regular-cardinal.md","status":"resolved","id":"0fbfc19800246e77","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{RegularCardinal}_S:V\\to\\{\\top,\\bot\\}$ (see [[../batch13/58-df-regular-cardinal.md]])","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-8","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}$ (see [[../batch16