{"id":"7e5f43000c788a56","group":"58","path":"58/batch09/58-df-zfc-topo10-locally-compact-point.md","title":"ZFC Topo10 Locally Compact Point","display":"df-zfc-topo10-locally-compact-point — ZFC Topo10 Locally Compact Point","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-topo10-locally-compact-point","aliases":["58-df-zfc-topo10-locally-compact-point"],"display":"df-zfc-topo10-locally-compact-point — ZFC Topo10 Locally Compact Point","depends_on":["[[58-ax-zfc]]","[[../batch10/58-df-zfc-top5-topological-space.md]]","[[../batch18/58-df-zfc-top2-compact-subset.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-topo10-locally-compact-point"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-topo10-locally-compact-point</span></div>"},{"key":"display","html":"df-zfc-topo10-locally-compact-point — ZFC Topo10 Locally Compact Point"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"74086485fba8d86f\" href=\"?note=74086485fba8d86f\" title=\"../batch10/58-df-zfc-top5-topological-space.md\">../batch10/58-df-zfc-top5-topological-space.md</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"67cf48a2f6e27861\" href=\"?note=67cf48a2f6e27861\" title=\"../batch18/58-df-zfc-top2-compact-subset.md\">../batch18/58-df-zfc-top2-compact-subset.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"x,X,\\tau\\in V\">\\(x,X,\\tau\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2\">\\(\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2\\)</span>，<span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop2CompactSubset}_S\\subseteq V^3\">\\(\\mathrm{ZfcTop2CompactSubset}_S\\subseteq V^3\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopo10LocallyCompactPoint}_S\\subseteq V^3\">\\(\\mathrm{ZfcTopo10LocallyCompactPoint}_S\\subseteq V^3\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}topo10\\text{-}locally\\text{-}compact\\text{-}point} \\vdash \\mathrm{ZfcTopo10LocallyCompactPoint}_S(x,X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land x\\in X\\land\\exists U\\in\\tau\\;\\exists K\\subseteq X\\;(x\\in U\\land U\\subseteq K\\land\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}topo10\\text{-}locally\\text{-}compact\\text{-}point} \\vdash \\mathrm{ZfcTopo10LocallyCompactPoint}_S(x,X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land x\\in X\\land\\exists U\\in\\tau\\;\\exists K\\subseteq X\\;(x\\in U\\land U\\subseteq K\\land\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"K\">\\(K\\)</span> 是包含开邻域 <span class=\"math-inline\" data-tex=\"U\">\\(U\\)</span> 的紧邻域；该定义不额外假设 Hausdorff，因而不把“紧”偷换为“闭紧”。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch10/58-df-zfc-top5-topological-space.md","status":"resolved","id":"74086485fba8d86f","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch10/58-df-zfc-top5-topological-space.md]]","embed":false},{"target":"../batch18/58-df-zfc-top2-compact-subset.md","status":"resolved","id":"67cf48a2f6e27861","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-zfc-top2-compact-subset.md]]","embed":false}],"math":[{"tex":"x,X,\\tau\\in V","display":false},{"tex":"\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcTop2CompactSubset}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcTopo10LocallyCompactPoint}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}topo10\\text{-}locally\\text{-}compact\\text{-}point} \\vdash \\mathrm{ZfcTopo10LocallyCompactPoint}_S(x,X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land x\\in X\\land\\exists U\\in\\tau\\;\\exists K\\subseteq X\\;(x\\in U\\land U\\subseteq K\\land\\mathrm{ZfcTop2CompactSubset}_S(K,X,\\tau))","display":true},{"tex":"K","display":false},{"tex":"U","display":false}],"bytes":1141,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3662","locations":["正文"],"count":1,"excerpt":"[[../batch09/58-df-zfc-topo10-locally-compact-point.md|58-df-zfc-topo10-locally-compact-point]]（batch09）"}],"outgoing":["a3348ed9eb6fb4e3","74086485fba8d86f","67cf48a2f6e27861"]}