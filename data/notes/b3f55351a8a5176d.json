) - g + 1","display":false},{"tex":"\\geq 2","display":false}],"bytes":2766,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-391","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-curve.md|58-df-curve]]（batch11）"}],"outgoing":["ab5e359a8ea0dcb4","8c958034cb5b5a95","1eb4a89b005d9cda"]}