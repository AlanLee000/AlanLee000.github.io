A,\\ M\\in H_{n,B}\\},\\qquad\nH_A^{\\mathrm{raw}}\\coloneqq\\bigcup_{n\\in\\mathbb N}H_{n,A}.","display":true},{"tex":"H_A\\coloneqq\\{[M]_{\\alpha,E_\\tau}:M\\in H_A^{\\mathrm{raw}}\\},\\qquad\nH\\coloneqq\\bigcup_{A\\in\\mathrm{Typ}}H_A,\\qquad\n\\bar h\\coloneqq[h]_{\\alpha,E_\\tau}.","display":true},{"tex":"H_A\\subseteq\\Lambda_A.","display":true},{"tex":"\\forall M\\in\\Lambda_A\\;\\exists!N\\in H_A\\;(M\\simeq_A N).","display":true},{"tex":"\\nu_A\\coloneqq\\{(M,N)\\in\\Lambda_A\\times H_A:M\\simeq_A N\\},\\qquad\n\\nu_A:\\Lambda_A\\to H_A.","display":true},{"tex":"\\operatorname{Occ}(x)\\coloneqq\\{\\epsilon\\},\\qquad\n\\operatorname{Occ}(f)\\coloneqq\\{\\epsilon\\}\\quad(f\\in F).","display":true},{"tex":"\\operatorname{Occ}(MN)\\coloneqq\\{\\epsilon\\}\\cup\n\\{(1)\\cdot p:p\\in\\operatorname{Occ}(M)\\}\\cup\n\\{(2)\\cdot p:p\\in\\operatorname{Occ}(N)\\}.","display":true},{"tex":"\\operatorname{Occ}(\\lambda x.M)\\coloneqq\\{\\epsilon\\}\\cup\n\\{(1)\\cdot p:p\\in\\operatorname{Occ}(M)\\}.","display":true},{"tex":"M|_\\epsilon\\coloneqq M,\\qquad\n(MN)|_{(1)\\cdot p}\\coloneqq M|_p\\quad(p\\in\\operatorname{Occ}(M)),\\qquad\n(MN)|_{(2)\\cdot p}\\coloneqq N|_p\\quad(p\\in\\operatorname{Occ}(N)).","display":true},{"tex":"(\\lambda x.M)|_{(1)\\cdot p}\\coloneqq M|_p\n\\quad(p\\in\\operatorname{Occ}(M)).","display":true},{"tex":"\\operatorname{Bind}(M,p)\\coloneqq\n\\{x\\in V:\\exists q\\in\\operatorname{Occ}(M)\\;\\exists P\\in L\\;\n(M|_q=\\lambda x.P\\land q\\cdot(1)\\preceq p)\\}.","display":true},{"tex":"\\operatorname{Spine}(M,p,h,\\vec N)\\Longleftrightarrow\n\\exists q\\in\\operatorname{Occ}(M)\\;\\Bigl(p=q\\land M|_q=hN_1\\cdots N_k\\land\n\\neg\\exists r\\in\\operatorname{Occ}(M)\\;\\exists P,Q\\in L\\;\n(q=r\\cdot(1)\\land M|_r=PQ)\\Bigr).","display":true},{"tex":"H_{n,A}","display":false},{"tex":"\\simeq_A","display":false}],"bytes":5003,"backlinks":[{"id":"c7d107c2c14774de","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"给定非空带类型签名 $(F,\\tau_F)$。$H_A,H,H_A^{\\mathrm{raw}},\\nu_A,\\bar h$、出现路径、绑定集合与最大应用脊见 [[56-df-higher-order-terms]]；$\\simeq_A$ 是其中明确引用的固定类型 βη 转换。令 $L_0=\\Lambda^{\\mathrm{raw}}(V,F)$、$W_\\lambda=\\{1,2\\}^{<\\omega}$。$M$ 为集合参数，Pattern 使用同一个原始代表元计算所有出现路径。商上应用、抽象及 $\\mathrm{FV}_{\\alpha,E_\\tau}$ 见 [[56-df-lambda-term]]。$\\lambda(z_1,\\ldots,z_n).l$ 表示按列表次序的嵌套商上抽象，空列表时为 $l$；连续应用左结合，空应用列表时为头本身。$R$ 为集合参数，以下 $I_R$ 与 $\\to_H$ 仅对 $R\\subseteq\\mathrm{HRule}$ 定义。$Q$ 是关系参数。"},{"id":"7a89e84aacc9537c","anchor":"ref-304","locations":["正文"],"count":2,"excerpt":"[[56-df-higher-order-terms.md]]"}],"outgoing":["da02033e6d596cae","d344b982e3ec8df3","24bd3576f4c5852a","884fb16496d08ed1","650401013847f443","9ddd157960e9574a"]}