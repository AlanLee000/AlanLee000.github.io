lay\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}map\\text{-}preimage}\\vdash\\mathrm{ZfcMapPreimage}_S(P,f,Y)\\leftrightarrow\\exists X,Z\\;\\left(\\mathrm{Function}(f,X,Z)\\land Y\\subseteq Z\\land P=\\{a\\in X:f(a)\\in Y\\}\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The definition records the function domain and codomain, so the preimage cannot acquire elements outside the domain.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false}],"math":[{"tex":"f,Y,P\\in V","display":false},{"tex":"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcMapPreimage}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}map\\text{-}preimage}\\vdash\\mathrm{ZfcMapPreimage}_S(P,f,Y)\\leftrightarrow\\exists X,Z\\;\\left(\\mathrm{Function}(f,X,Z)\\land Y\\subseteq Z\\land P=\\{a\\in X:f(a)\\in Y\\}\\right)","display":true}],"bytes":770,"backlinks":[{"id":"2b0f7d4c2fc8ba4d","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e3a691aa8eb9a794","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"b639865968a11516","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-2517","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-