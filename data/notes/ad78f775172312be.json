thcal A,\\mu\\in V\">\\(X,\\mathcal A,\\mu\\in V\\)</span> (measure-space carrier, sigma algebra, and measure)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Measure}_S\">\\(\\mathrm{Measure}_S\\)</span> (measure predicate, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"../batch13/58-df-measure\">../batch13/58-df-measure</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (function predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function\">../batch16/58-df-function</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S\">\\(\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S\\)</span> (canonical sigma-finite-measure predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure5SigmaFiniteMeasure}_S,\\mathrm{ZfcMeasure6SigmaFiniteMeasure}_S,\\mathrm{ZfcMeasure10SigmaFiniteMeasure}_S\">\\(\\mathrm{ZfcMeasure5SigmaFiniteMeasure}_S,\\mathrm{ZfcMeasure6SigmaFiniteMeasure}_S,\\mathrm{ZfcMeasure10SigmaFiniteMeasure}_S\\)</span> (compatibility aliases)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure}\\vdash\n\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\leftrightarrow\n\\mathrm{Measure}_S(\\mu,X,\\mathcal A)\\land\n\\exists F\\;\\Bigl(\\mathrm{Function}(F,\\omega,\\mathcal A)\\land\nX=\\bigcup_{n\\in\\omega}F(n)\\land\n\\forall n\\in\\omega\\;(\\mu(F(n))&lt;\\infty)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure}\\vdash\n\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\leftrightarrow\n\\mathrm{Measure}_S(\\mu,X,\\mathcal A)\\land\n\\exists F\\;\\Bigl(\\mathrm{Function}(F,\\omega,\\mathcal A)\\land\nX=\\bigcup_{n\\in\\omega}F(n)\\land\n\\forall n\\in\\omega\\;(\\mu(F(n))&lt;\\infty)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure\\text{-}alias\\text{-}measure5}\\vdash\n\\mathrm{ZfcMeasure5SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\leftrightarrow\n\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure\\text{-}alias\\text{-}measure5}\\vdash\n\\mathrm{ZfcMeasure5SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\leftrightarrow\n\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure\\text{-}alias\\text{-}measure6}\\vdash\n\\mathrm{ZfcMeasure6SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\leftrightarrow\n\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure\\text{-}alias\\text{-}measure6}\\vdash\n\\mathrm{ZfcMeasure6SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\leftrightarrow\n\\mathrm{ZfcMeasure3SigmaFiniteMeasure}_S(X,\\mathcal A,\\mu)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure3\\text{-}sigma\\text{-}finite\\text{-}measure\\text{-}alias\\text{-}measure10}\\vdash\n\\mathrm{ZfcMeasure10Sigm