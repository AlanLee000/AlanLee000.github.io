leq_P\\land\\forall u\\in P\\;\\bigl((\\langle x,u\\rangle\\in\\leq_P\\land\\langle y,u\\rangle\\in\\leq_P)\\to\\langle j,u\\rangle\\in\\leq_P\\bigr)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}poset\\text{-}join\\text{-}semilattice} \\vdash \\mathrm{ZfcPosetJoinSemilattice}_S(P,\\leq_P)\\leftrightarrow \\mathrm{Poset}(P,\\leq_P)\\land\\forall x,y\\in P\\;\\exists j\\in P\\;\\Bigl(\\langle x,j\\rangle\\in\\leq_P\\land\\langle y,j\\rangle\\in\\leq_P\\land\\forall u\\in P\\;\\bigl((\\langle x,u\\rangle\\in\\leq_P\\land\\langle y,u\\rangle\\in\\leq_P)\\to\\langle j,u\\rangle\\in\\leq_P\\bigr)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The join is typed as the least common upper bound of each pair. This expands the previously undeclared <span class=\"math-inline\" data-tex=\"\\operatorname{Join}\">\\(\\operatorname{Join}\\)</span> placeholder and makes the order relation explicit.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-df-poset.md","status":"resolved","id":"d3f859dbdd37f018","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-poset.md]]","embed":false}],"math":[{"tex":"P,\\leq_P\\in V","display":false},{"tex":"\\mathrm{Poset}(P,\\leq_P)","display":false},{"tex":"\\mathrm{ZfcPosetJoinSemilattice}_S(P,\\leq_P)","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}poset\\text{-}join\\text{-}semilattice} \\vdash \\mathrm{ZfcPosetJoinSemilattice}_S(P,\\leq_P)\\leftrightarrow \\mathrm{Poset}(P,\\leq_P)\\land\\forall x,y\\in P\\;\\exists j\\in P\\;\\Bigl(\\langle x,j\\rangle\\in\\leq_P\\land\\langle y,j\\rangle\\in\\leq_P\\land\\forall u\\in P\\;\\bigl((\\langle x,u\\rangle\\in\\leq_P\\land\\langle y,u\\rangle\\in\\leq_P)\\to\\langle j,u\\rangle\\in\\leq_P\\bigr)\\Bigr)","display":true},{"tex":"\\operatorname{Join}","display":false}],"bytes":1097,"backlinks":[{"id":"201288d018392871","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcPosetJoinSemilattice}_S$ (join-semilattice predicate, see [[../batch07/58-df-zfc-poset-join-semilattice.md]])"},{"id":"84daad544872cc71","anchor":"ref-3119","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-zfc-poset-join-semilattice.md|58-df-zfc-poset-join-semilattice]]（batch07）"}],"outgoing":["d3f859dbdd37f018"]}