\\nu)\\\\\n&{}\\land\\forall B\\in\\mathcal B\\;(\\nu(B)=\\mu(f^{-1}[B])).\n\\end{aligned}","display":true}],"bytes":1537,"backlinks":[{"id":"34a7e79edd9f7f6e","anchor":"ref-7","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-3153","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-prob-pushforward-measure.md|58-df-zfc-prob-pushforward-measure]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","0578a357a86e9d8f","a740bdad87b97ac6","c202e401aa180874"]}