-expression.md]]\n[[91-df-predicative-impredicative.md]]\n[[91-df-proof-theory-truth.md]]\n[[91-df-provable-truth.md]]\n[[91-df-quantifier-axiom.md]]\n[[91-df-ramified-truth.md]]\n[[91-df-reflection-principle.md]]\n[[91-df-release-axiom.md]]\n[[91-df-revision-theory.md]]\n[[91-df-self-reference.md]]\n[[91-df-soundness-predicate.md]]\n[[91-df-stable-sentence.md]]\n[[91-df-strengthened-liar.md]]\n[[91-df-strong-kleene.md]]\n[[91-df-strong-truth.md]]\n[[91-df-structure.md]]\n[[91-df-substitution-function.md]]\n[[91-df-superfalsehood.md]]\n[[91-df-supertruth.md]]\n[[91-df-supervaluation.md]]\n[[91-df-three-valued-satisfaction.md]]\n[[91-df-transparency.md]]\n[[91-df-truth-axiom.md]]\n[[91-df-truth-biconditional.md]]\n[[91-df-truth-consistency.md]]\n[[91-df-truth-definability.md]]\n[[91-df-truth-expansion.md]]\n[[91-df-truth-extension.md]]\n[[91-df-truth-induction.md]]\n[[91-df-truth-iteration.md]]\n[[91-df-truth-model-general.md]]\n[[91-df-truth-negation-axiom.md]]\n[[91-df-truth-predicate-typed.md]]\n[[91-df-truth-predicate-varieties.md]]\n[[91-df-truth-predicate.md]]\n[[91-df-truth-strength.md]]\n[[91-df-truth-teller-semantic.md]]\n[[91-df-truth-teller.md]]\n[[91-df-truth-theory-choice.md]]\n[[91-df-truth-theory.md]]\n[[91-df-truth-value-function.md]]\n[[91-df-truth-value-gap.md]]\n[[91-df-truth-value-glut.md]]\n[[91-df-type-index.md]]\n[[91-df-typed-language.md]]\n[[91-df-typed-truth.md]]\n[[91-df-uniform-reflection.md]]\n[[91-df-unstable-sentence.md]]\n[[91-df-untyped-truth.md]]\n[[91-df-vKF.md]]\n[[91-df-weak-kleene.md]]"}],"outgoing":["38c875c58a0bf84c","ec1d9c6fcc3c0767"]}