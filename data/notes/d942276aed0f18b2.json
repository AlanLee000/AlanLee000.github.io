":"T\\subseteq A^{<\\omega}","display":false},{"tex":"U\\subseteq B^{<\\omega}","display":false},{"tex":"\\mathrm{ZfcTree10TreeEmbedding}_S","display":false},{"tex":"\\mathrm{ZfcTree11BodyOfTree}_S","display":false},{"tex":"\\mathrm{Function}","display":false},{"tex":"\\omega","display":false},{"tex":"\\mathrm{ZfcTree11BodyMapUnderEmbedding}_S:V^6\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}tree11\\text{-}body\\text{-}map\\text{-}under\\text{-}embedding}\\vdash\n\\mathrm{ZfcTree11BodyMapUnderEmbedding}_S(\\widehat f,f,T,A,U,B)\\\\\n&\\quad\\leftrightarrow\n\\exists P_T,P_U\\in V\\;\\Bigl(\n\\mathrm{ZfcTree11BodyOfTree}_S(P_T,T,A)\n\\land\\mathrm{ZfcTree11BodyOfTree}_S(P_U,U,B)\\\\\n&\\qquad\\land\\mathrm{ZfcTree10TreeEmbedding}_S(f,T,\\{\\langle a,b\\rangle\\in T\\times T:a\\subseteq b\\},U,\\{\\langle a,b\\rangle\\in U\\times U:a\\subseteq b\\})\n\\land\\mathrm{Function}(\\widehat f,P_T,P_U)\\\\\n&\\qquad\\land\\forall b\\in P_T\\;\\left(\n\\widehat f(b)=\\bigcup\\{f(b{\\upharpoonright}n):n\\in\\omega\\}\n\\right)\n\\Bigr).\n\\end{aligned}","display":true}],"bytes":2050,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3783","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-zfc-tree11-body-map-under-embedding.md|58-df-zfc-tree11-body-map-under-embedding]]（batch10）"}],"outgoing":["a3348ed9eb6fb4e3","31795d01e0ea2e91","a71444a10218d32c","36d7463d215be751","481582931ea56519","5045d216c83e75cb"]}