l{B})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comb7\\text{-}bounding\\text{-}family\\text{-}alias} \\vdash \\mathrm{ZfcComb7BoundingFamily}_S(\\mathcal{B})\\leftrightarrow \\mathrm{ZfcComb8UnboundedFamily}_S(\\mathcal{B})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}comb7\\text{-}bounding\\text{-}family\\text{-}alias} \\vdash \\mathrm{ZfcComb7BoundingFamily}_S(\\mathcal{B})\\leftrightarrow \\mathrm{ZfcComb8UnboundedFamily}_S(\\mathcal{B})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Canonical predicate is named unbounded family; the two bounding-family names are retained as legacy names from the bounding-number convention.</li>\n<li><code>58-df-zfc-comb7-bounding-family</code> is merged here; it used the equivalent no-single-eventual-bound formulation.</li>\n<li>Eventual domination is sourced from <a class=\"wiki-link\" id=\"ref-5\" data-note=\"00625b4f58c83284\" href=\"?note=00625b4f58c83284\" title=\"58-df-dominating\">58-df-dominating</a>, and the two legacy aliases have distinct assertion labels.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-dominating","status":"resolved","id":"00625b4f58c83284","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-dominating]]","embed":false},{"target":"58-df-family","status":"resolved","id":"545b51e7aa011030","anchor":"ref-3","targetAnchor":"","l