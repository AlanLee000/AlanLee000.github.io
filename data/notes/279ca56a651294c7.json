{d_n}","display":false},{"tex":"\\{a_n:n\\in\\mathbb N\\}","display":false},{"tex":"\\overline H","display":false},{"tex":"\\mathrm{HSimple}(H)","display":false},{"tex":"\\mathrm{Simple}(H)","display":false}],"bytes":1658,"backlinks":[{"id":"32c1f47762a7f658","anchor":"ref-146","locations":["正文"],"count":1,"excerpt":"[[90-cor-creative-not-recursive.md]]\n[[90-cor-godel-sound.md]]\n[[90-cor-henkin-provable.md]]\n[[90-cor-henkin-sentence.md]]\n[[90-cor-hypersimple-not-creative.md]]\n[[90-cor-liar-independent.md]]"}],"outgoing":["a3c41e3442057746","40041a5a5d6a4573","30f3283b9dedba60","5d66bf24ea0c6e5a","42029390ebbb59c5","5cdab62986807336","5dc32170bd55a322"]}