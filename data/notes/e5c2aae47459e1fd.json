{"id":"e5c2aae47459e1fd","group":"58","path":"58/batch19/58-df-zfc-measure4-complete-sigma-algebra.md","title":"ZFC Measure4 Complete Sigma Algebra","display":"df-zfc-measure4-complete-sigma-algebra — ZFC Measure4 Complete Sigma Algebra","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-measure4-complete-sigma-algebra","aliases":["58-df-zfc-measure4-complete-sigma-algebra"],"display":"df-zfc-measure4-complete-sigma-algebra — ZFC Measure4 Complete Sigma Algebra","depends_on":["[[58-ax-zfc]]","[[58-df-complete]]","[[58-df-zfc-measure2-complete-measure]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-measure4-complete-sigma-algebra"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-measure4-complete-sigma-algebra</span></div>"},{"key":"display","html":"df-zfc-measure4-complete-sigma-algebra — ZFC Measure4 Complete Sigma Algebra"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"363d68f8b3734026\" href=\"?note=363d68f8b3734026\" title=\"58-df-complete\">58-df-complete</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"9d94df75da531fdd\" href=\"?note=9d94df75da531fdd\" title=\"58-df-zfc-measure2-complete-measure\">58-df-zfc-measure2-complete-measure</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\Sigma,\\mu\\in V\">\\(X,\\Sigma,\\mu\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure2CompleteMeasure}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcMeasure2CompleteMeasure}_S:V^3\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"9d94df75da531fdd\" href=\"?note=9d94df75da531fdd\" title=\"58-df-zfc-measure2-complete-measure\">58-df-zfc-measure2-complete-measure</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure4CompleteSigmaAlgebra}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcMeasure4CompleteSigmaAlgebra}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}complete\\text{-}sigma\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure4CompleteSigmaAlgebra}_S(X,\\Sigma,\\mu)\\leftrightarrow \\mathrm{ZfcMeasure2CompleteMeasure}_S(X,\\Sigma,\\mu)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}complete\\text{-}sigma\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure4CompleteSigmaAlgebra}_S(X,\\Sigma,\\mu)\\leftrightarrow \\mathrm{ZfcMeasure2CompleteMeasure}_S(X,\\Sigma,\\mu)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This name is an alias for completeness of the measure space; it therefore includes the measure-space axioms.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-complete","status":"resolved","id":"363d68f8b3734026","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-complete]]","embed":false},{"target":"58-df-zfc-measure2-complete-measure","status":"resolved","id":"9d94df75da531fdd","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-measure2-complete-measure]]","embed":false},{"target":"58-df-zfc-measure2-complete-measure","status":"resolved","id":"9d94df75da531fdd","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcMeasure2CompleteMeasure}_S:V^3\\to\\{\\top,\\bot\\}$ (see [[58-df-zfc-measure2-complete-measure]])","embed":false}],"math":[{"tex":"X,\\Sigma,\\mu\\in V","display":false},{"tex":"\\mathrm{ZfcMeasure2CompleteMeasure}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ZfcMeasure4CompleteSigmaAlgebra}_S:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}complete\\text{-}sigma\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure4CompleteSigmaAlgebra}_S(X,\\Sigma,\\mu)\\leftrightarrow \\mathrm{ZfcMeasure2CompleteMeasure}_S(X,\\Sigma,\\mu)","display":true}],"bytes":1011,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2591","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-zfc-measure4-complete-sigma-algebra.md|58-df-zfc-measure4-complete-sigma-algebra]]（batch19）"}],"outgoing":["a3348ed9eb6fb4e3","363d68f8b3734026","9d94df75da531fdd"]}