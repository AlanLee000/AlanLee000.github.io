play":false},{"tex":"\\mathrm{OperatorValuedDistribution}_S","display":false},{"tex":"\\mathrm{QuantumField}_S","display":false},{"tex":"\\mathrm{df\\text{-}quantum\\text{-}field\\text{-}dense\\text{-}domain}\\vdash\n\\mathrm{DenseLinearDomain}_S(\\mathcal D_H,H,\\langle\\cdot,\\cdot\\rangle_H)\\leftrightarrow\n\\operatorname{LinearSubspace}_{\\mathbb C}(\\mathcal D_H,H)\\land\n\\forall h\\in H\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists d\\in\\mathcal D_H\\;(\\|h-d\\|_H<\\varepsilon)","display":true},{"tex":"\\mathrm{df\\text{-}quantum\\text{-}field\\text{-}operator\\text{-}valued\\text{-}distribution}\\vdash\n\\mathrm{OperatorValuedDistribution}_S(\\Phi,\\mathcal D(M),\\tau_{\\mathcal D},H,\\langle\\cdot,\\cdot\\rangle_H,\\mathcal D_H)\\leftrightarrow\n\\left[\\begin{aligned}\n&\\mathrm{Function}\\!\\left(\\Phi,\\mathcal D(M),H^{\\mathcal D_H}\\right)\\land\n\\forall f\\in\\mathcal D(M)\\;\\operatorname{Operator}_{\\mathbb C}(\\Phi(f);\\mathcal D_H,H,H)\\\\\n&{}\\land\\mathrm{Linear}_{\\mathbb C}(\\Phi;\\mathcal D(M),H^{\\mathcal D_H})\\\\\n&{}\\land\\forall\\psi,\\chi\\in\\mathcal D_H\\;\\exists L_{\\psi,\\chi}\\;\\left[\n\\mathrm{Function}(L_{\\psi,\\chi},\\mathcal D(M),\\mathbb C)\\right.\\\\\n&\\qquad{}\\land\\forall f\\in\\mathcal D(M)\\;L_{\\psi,\\chi}(f)=\\langle\\psi,\\Phi(f)\\chi\\rangle_H\\\\\n&\\qquad{}\\left.\\land\\mathrm{Linear}_{\\mathbb C}(L_{\\psi,\\chi};\\mathcal D(M),\\mathbb C)\\land\n\\mathrm{Continuous}_S(L_{\\psi,\\chi},\\mathcal D(M),\\tau_{\\mathcal D},\\mathbb C,\\tau_{\\mathbb C})\\right]\n\\end{aligned}\\right]","display":true},{"tex":"\\mathrm{df\\text{-}quantum\\text{-}field}\\vdash\n\\mathrm{QuantumField}_S(\\Phi,M,\\tau_M,\\mathcal A_M,n,\\mathcal D(M),\\tau_{\\mathcal D},H,\\langle\\cdot,\\cdot\\rangle_H,\\mathcal D_H)\n\\leftrightarrow\n\\operatorname{SmoothManifoldStructure}_S(M,\\tau_M,\\mathcal A_M,n)\\land\\mathrm{HilbertSpace}_S(H,\\langle\\cdot,\\cdot\\rangle_H)\\land\n\\mathcal D(M)=C_c^\\infty(M,\\mathbb C)\\land\n\\mathrm{DenseLinearDomain}_S(\\mathcal D_H,H,\\langle\\cdot,\\cdot\\rangle_H)\\land\n\\mathrm{OperatorValuedDistribution}_S(\\Phi,\\mathcal D(M),\\tau_{\\mathcal D},H,\\langle\\cdot,\\cdot\\rangle_H,\\mathcal D_H)","display":true},{"tex":"f\\mapsto\\langle\\psi,\\Phi(f)\\chi\\rangle","display":false}],"bytes":3548,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1022","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-df-quantum-field.md|58-df-quantum-field]]（batch15）"}],"outgoing":["5e8c7b8a7c03e2ed","36d7463d215be751","b70ce791d5b1a19b","3cd1834de4f2efb2","f67456d74b418241","17de8347f6f91384","71fe0dc4c8613e69"]}