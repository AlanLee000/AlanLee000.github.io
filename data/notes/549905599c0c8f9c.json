,X,\\mathcal F,\\mu)\n\\land\nr=\\inf\\Bigl\\{\nh\\in[0,\\infty]:\n\\exists\\alpha\\in V\\;\\bigl(\n\\mathrm{ZfcMeasure7EntropyOfPartition}_S\n(X,\\mathcal F,\\mu,\\alpha,h)\n\\land\n\\mathrm{GeneratesModuloNull}_S\n(\\alpha,T,S,X,\\mathcal F,\\mu)\n\\bigr)\n\\Bigr\\}\n\\Biggr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{prop\\text{-}rokip}\\vdash\n&\\mathrm{ZfcMeasure8StandardProbabilitySpace}_S(X,\\mathcal F,\\mu)\n\\land\\mathrm{Ergodic}_S(T,\\mu,X,\\mathcal F)\\\\\n&{}\\land\\exists S\\in V\\;\n\\mathrm{InversePairModNull}_S(S,T,X,\\mathcal F,\\mu)\\\\\n&\\to\\exists!r\\in[0,\\infty]\\;\n\\mathrm{RokhlinEntropyValue}_S(r,T,X,\\mathcal F,\\mu).\n\\end{aligned}","display":true},{"tex":"\\mathbb Z","display":false},{"tex":"S","display":false},{"tex":"\\sigma","display":false}],"bytes":4089,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3991","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-prop-rokip.md|58-prop-rokip]]（batch17）"}],"outgoing":["11a66aa01f6e941d","a95c8ce648dde2ec","401407224816e743","549cf65f429db76a","e03c77e7d23896d9"]}