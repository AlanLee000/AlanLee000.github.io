ists d\\in D\\cap M\\;\\mathrm{Compatible}_S(d,r,P,\\leq_P)\n\\bigr)\n\\bigr)\n\\bigr\\}\n\\Bigr).","display":true},{"tex":"\\operatorname{MGeneric}","display":false}],"bytes":1620,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2013","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-zfc-forcing10-properness-residue.md|58-df-zfc-forcing10-properness-residue]]（batch02）"}],"outgoing":["a3348ed9eb6fb4e3","8935dcac821c0104","d3f859dbdd37f018","681e6314e26cdd0b","2ad4b32e9e2eb12a"]}