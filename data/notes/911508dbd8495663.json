\" title=\"../batch07/58-df-name.md\">../batch07/58-df-name.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"d9b8711cda3f31ca\" href=\"?note=d9b8711cda3f31ca\" title=\"../batch18/58-df-structure.md\">../batch18/58-df-structure.md</a></span><span><a class=\"wiki-link\" id=\"ref-9\" data-note=\"65418b505fc53093\" href=\"?note=65418b505fc53093\" title=\"../batch17/58-df-formula.md\">../batch17/58-df-formula.md</a></span><span><a class=\"wiki-link\" id=\"ref-10\" data-note=\"64f35ba2e87964e0\" href=\"?note=64f35ba2e87964e0\" title=\"../batch03/58-df-assignment.md\">../batch03/58-df-assignment.md</a></span><span><a class=\"wiki-link\" id=\"ref-11\" data-note=\"715a32e91161b34f\" href=\"?note=715a32e91161b34f\" title=\"../batch07/58-df-free-variable.md\">../batch07/58-df-free-variable.md</a></span><span><a class=\"wiki-link\" id=\"ref-12\" data-note=\"3888033a846b1cd5\" href=\"?note=3888033a846b1cd5\" title=\"../batch06/58-df-first-order-language.md\">../batch06/58-df-first-order-language.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"M,p,\\varphi,\\vec\\tau,\\mathbb P,\\leq_{\\mathbb P},\\mathcal N\\in V\">\\(M,p,\\varphi,\\vec\\tau,\\mathbb P,\\leq_{\\mathbb P},\\mathcal N\\in V\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathcal L_\\in\">\\(\\mathcal L_\\in\\)</span> is the language of set theory.</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{Generic}(G,\\mathbb P,\\leq_{\\mathbb P},M)\">\\(\\operatorname{Generic}(G,\\mathbb P,\\leq_{\\mathbb P},M)\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{GenericExtension}_S(N,M,\\mathbb P,G)\">\\(\\mathrm{GenericExtension}_S(N,M,\\mathbb P,G)\\)</span> are as in <a class=\"wiki-link\" id=\"ref-13\" data-note=\"545853811ce0a4b6\" href=\"?note=545853811ce0a4b6\" title=\"../batch16/58-df-generic.md\">../batch16/58-df-generic.md</a> and <a class=\"wiki-link\" id=\"ref-14\" data-note=\"76dde059f166d3e6\" href=\"?note=76dde059f166d3e6\" title=\"../batch13/58-df-generic-extension.md\">../batch13/58-df-generic-extension.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Name}\\subseteq V^2\">\\(\\mathrm{Name}\\subseteq V^2\\)</span> is the forcing-name predicate (see <a class=\"wiki-link\" id=\"ref-15\" data-note=\"ec28b62254928d73\" href=\"?note=ec28b62254928d73\" title=\"../batch07/58-df-name.md\">../batch07/58-df-name.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{NameEvaluation}_S\">\\(\\mathrm{NameEvaluation}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Assign}\">\\(\\mathrm{Assign}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\operatorname{FV}\">\\(\\operatorname{FV}\\)</span> are as in <a class=\"wiki-link\" id=\"ref-16\" data-note=\"0c40d420e5118724\" href=\"?note=0c40d420e5118724\" title=\"../batch05/58-df-name-evaluation.md\">../batch05/58-df-name-evaluation.md</a>, <a class=\"wiki-link\" id=\"ref-17\" data-note=\"64f35ba2e87964e0\" href=\"?note=64f35ba2e87964e0\" title=\"../batch03/58-df-assignment.md\">../batch03/58-df-assignment.md</a>, and <a class=\"wiki-link\" id=\"ref-18\" data-note=\"715a32e91161b34f\" href=\"?note=715a32e91161b34f\" title=\"../batch07/58-df-free-variable.md\">../batch07/58-df-free-variable.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Poset}\">\\(\\mathrm{Poset}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Struct}_S\">\\(\\mathrm{Struct}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Univ}\">\\(\\mathrm{Univ}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Fml}_S\">\\(\\mathrm{Fml}_S\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{Satisfaction}_S\">\\(\\mathrm{Satisfaction}_S\\)</span> are as in <a class=\"wiki-link\" id=\"ref-19\" data-note=\"d3f859dbdd37f018\" href=\"?note=d3f859dbdd37f018\" title=\"../batch02/58-df-poset.md\">../batch02/58-df-poset.md</a>, <a class=\"wiki-link\" id=\"ref-20\" data-note=\"d9b8711cda3f31ca\" href=\"?note=d9b8711cda3f31ca\" title=\"../batch18/58-df-structure.md\">../batch18/58-df-structure.md</a>, <a class=\"wiki-link\" id=\"ref-21\" data-note=\"65418b505fc53093\" href=\"?note=65418b505fc53093\" title=\"../batch17/58-df-formula.md\">../batch17/58-df-formula.md</a>, and <a class=\"wiki-link\" id=\"ref-22\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcingRelation}_S\\subseteq V^6\">\\(\\mathrm{ZfcForcingRelation}_S\\subseteq V^6\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{ZfcForcingRelation}_S(M,p,\\varphi,\\vec\\tau,\\mathbb P,\\leq_{\\mathbb P})\\leftrightarrow{}&amp;\n\\mathrm{Poset}(\\mathbb P,\\leq_{\\mathbb P})\\land p\\in\\mathbb P\n\\land\\varphi\\in\\mathrm{Fml}_S(\\mathcal L_\\in)\\\\\n&amp;\\land\\exists n\\in\\omega\\;\\Bigl(\\mathrm{Function}(\\vec\\tau,n,M)\n\\land\\forall i\\in n\\;\\mathrm{Name}(\\vec\\tau(i),\\mathbb P)\n\\land\\operatorname{FV}_{\\mathcal L_\\in}(\\varphi)\\subseteq\\{v_i:i\\in n\\}\\\\\n&amp;\\quad\\land\\forall G,N\\in V\\;\\Bigl(\n\\operatorname{Generic}(G,\\mathbb P,\\leq_{\\mathbb P},M)\\land p\\in G\n\\land\\mathrm{GenericExtension}_S(N,M,\\mathbb P,G)\\\\\n&amp;\\qquad\\to\\exists\\mathcal N,\\operatorname{Val},\\operatorname{Sat},\\bar b,s\\in V\\;\\Bigl(\n\\mathcal N=\\langle N,\\{\\langle x,y\\rangle\\in N\\times N:x\\in y\\}\\rangle\\\\\n&amp;\\qquad\\quad\\land\\mathrm{Struct}_S(\\mathcal N,\\mathcal L_\\in)\\land\\mathrm{Univ}(\\mathcal N)=N\n\\land\\mathrm{Satisfaction}_S(\\mathcal N,\\mathcal L_\\in,\\operatorname{Val},\\operatorname{Sat})\\\\\n&amp;\\qquad\\quad\\land\\mathrm{Function}(\\bar b,n,N)\n\\land\\forall i\\in n\\;\\mathrm{NameEvaluation}_S(\\bar b(i),\\vec\\tau(i),G,\\mathbb P)\\\\\n&amp;\\qquad\\quad\\land\\mathrm{Assign}(\\mathcal N,s)\\land\\forall i\\in n\\;s(v_i)=\\bar b(i)\n\\land\\operatorname{Sat}(\\varphi,s)\\Bigr)\\Bigr)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{ZfcForcingRelation}_S(M,p,\\varphi,\\vec\\tau,\\mathbb P,\\leq_{\\mathbb P})\\leftrightarrow{}&amp;\n\\mathrm{Poset}(\\mathbb P,\\leq_{\\mathbb P})\\land p\\in\\mathbb P\n\\land\\varphi\\in\\mathrm{Fml}_S(\\mathcal L_\\in)\\\\\n&amp;\\land\\exists n\\in\\omega\\;\\Bigl(\\mathrm{Function}(\\vec\\tau,n,M)\n\\land\\forall i\\in n\\;\\mathrm{Name}(\\vec\\tau(i),\\mathbb P)\n\\land\\operatorname{FV}_{\\mathcal L_\\in}(\\varphi)\\subseteq\\{v_i:i\\in n\\}\\\\\n&amp;\\quad\\land\\forall G,N\\in V\\;\\Bigl(\n\\operatorname{Generic}(G,\\mathbb P,\\leq_{\\mathbb P},M)\\land p\\in G\n\\land\\mathrm{GenericExtension}_S(N,M,\\mathbb P,G)\\\\\n&amp;\\qquad\\to\\exists\\mathcal N,\\operatorname{Val},\\operatorname{Sat},\\bar b,s\\in V\\;\\Bigl(\n\\mathcal N=\\langle N,\\{\\langle x,y\\rangle\\in N\\times N:x\\in y\\}\\rangle\\\\\n&amp;\\qquad\\quad\\land\\mathrm{Struct}_S(\\mathcal N,\\mathcal L_\\in)\\land\\mathrm{Univ}(\\mathcal N)=N\n\\land\\mathrm{Satisfaction}_S(\\mathcal N,\\mathcal L_\\in,\\operatorname{Val},\\operatorname{Sat})\\\\\n&amp;\\qquad\\quad\\land\\mathrm{Function}(\\bar b,n,N)\n\\land\\forall i\\in n\\;\\mathrm{NameEvaluation}_S(\\bar b(i),\\vec\\tau(i),G,\\mathbb P)\\\\\n&amp;\\qquad\\quad\\land\\mathrm{Assign}(\\mathcal N,s)\\land\\forall i\\in n\\;s(v_i)=\\bar b(i)\n\\land\\operatorname{Sat}(\\varphi,s)\\Bigr)\\Bigr)\\Bigr).\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Evaluation of <span class=\"math-inline\" data-tex=\"\\vec\\tau\">\\(\\vec\\tau\\)</span> is componentwise through the sourced value relation. The free-variable bound and a total assignment connect the evaluated tuple to the selected satisfaction recursion; no independent <span class=\"math-inline\" data-tex=\"\\models\">\\(\\models\\)</span> notation remains.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch16/58-df-generic.md","status":"resolved","id":"545853811ce0a4b6","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-generic.md]]","embed":false},{"target":"../batch13/58-df-generic-extension.md","status":"resolved","id":"76dde059f166d3e6","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-generic-extension.md]]","embed":false},{"target":"../batch05/58-df-name-evaluation.md","status":"resolved","id":"0c40d420e5118724","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-name-evaluation.md]]","embed":false},{"target":"../batch07/58-df-name.md","status":"resolved","id":"ec28b62254928d73","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-name.md]]","embed":false},{"target":"../batch18/58-df-satisfaction.md","status":"resolved","id":"8b6a90316aad78a4","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-satisfaction.md]]","emb