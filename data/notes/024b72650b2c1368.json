n\\langle S,+_S,\\cdot_S,0_S,1_S\\rangle\n=\\prod_{i<k}^{\\mathrm{Ring}}M_{n_i}(D_i,+_i,\\cdot_i,0_i,1_i).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}artin\\text{-}wedderburn}\\vdash\n&\\mathrm{SemisimpleRing}_S(R,+_R,\\cdot_R,0_R,1_R)\\leftrightarrow\\\\\n&\\exists k\\in\\omega_{>0}\\;\\exists D_\\bullet,+_\\bullet,\\cdot_\\bullet,0_\\bullet,1_\\bullet,n_\\bullet,S,+_S,\\cdot_S,0_S,1_S,f\\in V\\;\\Bigl(\n\\mathrm{Function}(D_\\bullet,k,\\operatorname{ran}(D_\\bullet))\\\\\n&\\quad\\land\\mathrm{Function}(+_\\bullet,k,\\operatorname{ran}(+_\\bullet))\n\\land\\mathrm{Function}(\\cdot_\\bullet,k,\\operatorname{ran}(\\cdot_\\bullet))\n\\land\\mathrm{Function}(0_\\bullet,k,\\operatorname{ran}(0_\\bullet))\\\\\n&\\quad\\land\\mathrm{Function}(1_\\bullet,k,\\operatorname{ran}(1_\\bullet))\n\\land\\mathrm{Function}(n_\\bullet,k,\\omega_{>0})\n\\land\\forall i<k\\;\\mathrm{DivisionRing}_S(D_i,+_i,\\cdot_i,0_i,1_i)\\\\\n&\\quad\\land\\mathrm{FiniteMatrixProduct}_S(S,+_S,\\cdot_S,0_S,1_S;k,D_\\bullet,+_\\bullet,\\cdot_\\bullet,0_\\bullet,1_\\bullet,n_\\bullet)\\\\\n&\\quad\\land\\mathrm{RingIso}_S(f;R,+_R,\\cdot_R,0_R,1_R;S,+_S,\\cdot_S,0_S,1_S)\\Bigr).\n\\end{aligned}","display":true}],"bytes":4518,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4032","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-thm-artin-wedderburn.md|58-thm-artin-wedderburn]]（batch18）"}],"outgoing":["1c30d21ea7b443f6","28f002080d71355a","d583890235faf0d5","36d7463d215be751"]}