{"id":"d9f30bc0c9c793d3","group":"89","path":"89/89-df-modal-logic-k4.md","title":"Modal Logic K4","display":"df-modal-logic-k4 — Modal Logic K4","type":"definition","metadata":{"type":"definition","book":"The Logic of Provability","book_abbrev":"89","label":"89-df-modal-logic-k4","aliases":["89-df-modal-logic-k4"],"display":"df-modal-logic-k4 — Modal Logic K4","depends_on":["[[89-df-modal-logic-k]]","[[89-df-box-modality]]","[[89-df-modal-formula]]","[[89-df-4-axiom]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"The Logic of Provability"},{"key":"book_abbrev","html":"89"},{"key":"label","html":"89-df-modal-logic-k4"},{"key":"aliases","html":"<div class=\"property-array\"><span>89-df-modal-logic-k4</span></div>"},{"key":"display","html":"df-modal-logic-k4 — Modal Logic K4"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"550226a6aaff441c\" href=\"?note=550226a6aaff441c\" title=\"89-df-modal-logic-k\">89-df-modal-logic-k</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"d246470e97fec132\" href=\"?note=d246470e97fec132\" title=\"89-df-box-modality\">89-df-box-modality</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"56c1b5b75a32ca1d\" href=\"?note=56c1b5b75a32ca1d\" title=\"89-df-modal-formula\">89-df-modal-formula</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"883bfda9f28cc5ea\" href=\"?note=883bfda9f28cc5ea\" title=\"89-df-4-axiom\">89-df-4-axiom</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{K}\\subseteq\\mathrm{Fml}_{\\Box}\">\\(\\mathrm{K}\\subseteq\\mathrm{Fml}_{\\Box}\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"550226a6aaff441c\" href=\"?note=550226a6aaff441c\" title=\"89-df-modal-logic-k\">89-df-modal-logic-k</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal{A}_{4}\\subseteq\\mathrm{Fml}_{\\Box}\">\\(\\mathcal{A}_{4}\\subseteq\\mathrm{Fml}_{\\Box}\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"883bfda9f28cc5ea\" href=\"?note=883bfda9f28cc5ea\" title=\"89-df-4-axiom\">89-df-4-axiom</a>).</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}modal\\text{-}logic\\text{-}k4}\\vdash\n\\mathrm{K4}\\coloneqq\n\\bigcap\\left\\{X\\subseteq\\mathrm{Fml}_{\\Box}\\ \\middle|\\\n\\begin{aligned}\n&amp;\\mathrm{K}\\cup\\mathcal{A}_{4}\\subseteq X,\\\\\n&amp;\\forall A,B\\in\\mathrm{Fml}_{\\Box}\\;\n((A\\in X\\land(A\\to B)\\in X)\\to B\\in X),\\\\\n&amp;\\forall A\\in\\mathrm{Fml}_{\\Box}\\;(A\\in X\\to\\Box A\\in X)\n\\end{aligned}\n\\right\\}.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}modal\\text{-}logic\\text{-}k4}\\vdash\n\\mathrm{K4}\\coloneqq\n\\bigcap\\left\\{X\\subseteq\\mathrm{Fml}_{\\Box}\\ \\middle|\\\n\\begin{aligned}\n&amp;\\mathrm{K}\\cup\\mathcal{A}_{4}\\subseteq X,\\\\\n&amp;\\forall A,B\\in\\mathrm{Fml}_{\\Box}\\;\n((A\\in X\\land(A\\to B)\\in X)\\to B\\in X),\\\\\n&amp;\\forall A\\in\\mathrm{Fml}_{\\Box}\\;(A\\in X\\to\\Box A\\in X)\n\\end{aligned}\n\\right\\}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"89-df-modal-logic-k","status":"resolved","id":"550226a6aaff441c","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[89-df-modal-logic-k]]","embed":false},{"target":"89-df-box-modality","status":"resolved","id":"d246470e97fec132","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[89-df-box-modality]]","embed":false},{"target":"89-df-modal-formula","status":"resolved","id":"56c1b5b75a32ca1d","anchor":"ref-3","targetAnchor":