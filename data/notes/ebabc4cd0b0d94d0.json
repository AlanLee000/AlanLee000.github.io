\\mathrm{Hom}_{93}(h,\\mathbf A,\\mathbf B)\\land h[|\\mathbf A|]=|\\mathbf B|\n\\to\\exists!\\widetilde h\\;\\Bigl(\n\\mathrm{Iso}_{93}(\\widetilde h,\n\\mathrm{Quot}_{93}(\\mathbf A,\\mathrm{Ker}_{93}(h;\\mathbf A);\\tau),\\mathbf B)\n\\land\\widetilde h\\circ\n\\mathrm{QuotProj}_{93}(\\mathbf A,\\mathrm{Ker}_{93}(h;\\mathbf A);\\tau)=h\\Bigr)","display":true}],"bytes":1572,"backlinks":[],"outgoing":["6730349967b8ffce","f10e7e3251fa7f7d","510bd94349c4c6d9","fe06c83d404633c2","4f176786881b1435"]}