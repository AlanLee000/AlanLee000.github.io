ass=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"0626faf5263e31f8\" href=\"?note=0626faf5263e31f8\" title=\"17-df-omega-stability\">17-df-omega-stability</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"086b1b3d5b60a929\" href=\"?note=086b1b3d5b60a929\" title=\"17-df-prime-model\">17-df-prime-model</a></span></div>"},{"key":"label_origin","html":"local-catalog"},{"key":"legacy_label","html":"17-thm-7.1.4b"},{"key":"local_revision","html":"content audit of supplied 17(1).zip; inherited source_verification and bibliographic fields not independently reverified"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p><span class=\"math-inline\" data-tex=\"L\\in\\mathrm{FirstOrderLanguages}\">\\(L\\in\\mathrm{FirstOrderLanguages}\\)</span>，<span class=\"math-inline\" data-tex=\"T\\subseteq\\mathrm{Sent}_L\">\\(T\\subseteq\\mathrm{Sent}_L\\)</span>。</p>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{OmegaStable}_L\">\\(\\operatorname{OmegaStable}_L\\)</span> (<span class=\"math-inline\" data-tex=\"\\omega\">\\(\\omega\\)</span>-stability predicate, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"0626faf5263e31f8\" href=\"?note=0626faf5263e31f8\" title=\"17-df-omega-stability\">17-df-omega-stability</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{PrimeModel}_L\">\\(\\operatorname{PrimeModel}_L\\)</span> (prime-model predicate, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"086b1b3d5b60a929\" href=\"?note=086b1b3d5b60a929\" title=\"17-df-prime-model\">17-df-prime-model</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\operatorname{OmegaStable}_L(T)\n\\to\n\\exists\\mathfrak P\\;\n\\operatorname{PrimeModel}_L(\\mathfrak P,T).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\operatorname{OmegaStable}_L(T)\n\\to\n\\exists\\mathfrak P\\;\n\\operatorname{PrimeModel}_L(\\mathfrak P,T).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>In the countable complete setting built into <span class=\"math-inline\" data-tex=\"\\operatorname{OmegaStable}_L\">\\(\\operatorname{OmegaStable}_L\\)</span>, isolated types are dense enough to construct an atomic, hence prime, model.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"17-df-omega-stability","status":"resolved","id":"0626faf5263e31f8","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[17-df-omega-stability]]","embed":false},{"target":"17-df-prime-model","status":"resolved","id":"086b1b3d5b60a929","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[17-df-prime-model]]","embed":false},{"target":"17-df-omega-stability","status":"resolved","id":"0626faf5263e31f8","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{OmegaStable}_L$ ($\\omega$-stability predicate, see [[17-df-omega-stability]])","embed":false},{"target":"17-df-prime-model","status":"resolved","id":"086b1b3d5b60a929","anchor":"ref-4","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{PrimeModel}_L$ (prime-model predicate, see [[17-df-prime-model]])","embed":false}],"attachments":[],"math":[{"tex":"L\\in\\mathrm{FirstOrderLanguages}","display":false},{"tex":"T\\subseteq\\mathrm{Sent}_L","display":false},{"tex":"\\operatorname{OmegaStable}_L","display":false},{"tex":"\\omega","display":false},{"tex":"\\operatorname{PrimeModel}_L","display":false},{"tex":"\\operatorname{OmegaStable}_L(T)\n\\to\n\\exists\\mathfrak P\\;\n\\operatorname{PrimeModel}_L(\\mathfrak P,T).","display":true},{"tex":"\\operatorname{OmegaStable}_L","display":false}],"bytes":1459,"backlinks":[{"id