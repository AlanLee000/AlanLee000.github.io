6aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"d9b8711cda3f31ca\" href=\"?note=d9b8711cda3f31ca\" title=\"../batch18/58-df-structure.md\">../batch18/58-df-structure.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"64f35ba2e87964e0\" href=\"?note=64f35ba2e87964e0\" title=\"../batch03/58-df-assignment.md\">../batch03/58-df-assignment.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"715a32e91161b34f\" href=\"?note=715a32e91161b34f\" title=\"../batch07/58-df-free-variable.md\">../batch07/58-df-free-variable.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathcal M,M,A,H,\\rho,p,L_{\\mathrm{pm}}\\in V\">\\(\\mathcal M,M,A,H,\\rho,p,L_{\\mathrm{pm}}\\in V\\)</span> and <span class=\"math-inline\" data-tex=\"\\Sigma_1(L_{\\mathrm{pm}})\">\\(\\Sigma_1(L_{\\mathrm{pm}})\\)</span> is the set of <span class=\"math-inline\" data-tex=\"\\Sigma_1\">\\(\\Sigma_1\\)</span> formula codes in the premouse language.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcModel7Premouse}_S\\subseteq V\">\\(\\mathrm{ZfcModel7Premouse}_S\\subseteq V\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"1048d44b28527ff2\" href=\"?note=1048d44b28527ff2\" title=\"./58-df-zfc-model7-premouse.md\">58-df-zfc-model7-premouse.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ordinal}\">\\(\\mathrm{Ordinal}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Struct}_S\">\\(\\mathrm{Struct}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Univ}\">\\(\\mathrm{Univ}\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Satisfaction}_S\">\\(\\mathrm{Satisfaction}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Assign}\">\\(\\mathrm{Assign}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\operatorname{FV}\">\\(\\operatorname{FV}\\)</span> are as in the cited dependencies.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{SigmaOneHull}_S\\subseteq V^4\">\\(\\mathrm{SigmaOneHull}_S\\subseteq V^4\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcInnerSoundPremouse}_S\\subseteq V^4\">\\(\\mathrm{ZfcInnerSoundPremouse}_S\\subseteq V^4\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}inner\\text{-}sigmaone\\text{-}hull}\\vdash\n\\mathrm{SigmaOneHull}_S(H,\\mathcal M,L_{\\mathrm{pm}},A)\\leftrightarrow\n\\exists\\operatorname{Val},\\operatorname{Sat}\\in V\\;\\Bigl(\n\\mathrm{Struct}_S(\\mathcal M,L_{\\mathrm{pm}})\\land\n\\mathrm{Satisfaction}_S(\\mathcal M,L_{\\mathrm{pm}},\\operatorname{Val},\\operatorname{Sat})\\land\n\\ A\\subseteq\\mathrm{Univ}(\\mathcal M)\\land\nH=\\Bigl\\{b\\in\\mathrm{Univ}(\\mathcal M):\\exists\\varphi\\in\\Sigma_1(L_{\\mathrm{pm}})\\;\\exists n\\in\\omega\\;\\exists a\\in V\\;\n\\exists s\\in V\\;\\Bigl(\n\\mathrm{Function}(a,n,A)\n\\land\\operatorname{FV}_{L_{\\mathrm{pm}}}(\\varphi)\\subseteq\\{v_j:j\\in n+1\\}\n\\land\\mathrm{Assign}(\\mathcal M,s)\n\\land s(v_0)=b\\land\\forall j\\in n\\;(s(v_{j+1})=a(j))\\\\\n\\land\\operatorname{Sat}(\\varphi,s)\n\\land\\forall c\\in\\mathrm{Univ}(\\mathcal M)\\;\n\\bigl(\\operatorname{Sat}(\\varphi,s[v_0\\mapsto c])\\leftrightarrow c=b\\bigr)\n\\Bigr)\\Bigr\\}\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}inner\\text{-}sigmaone\\text{-}hull}\\vdash\n\\mathrm{SigmaOneHull}_S(H,\\mathcal M,L_{\\mathrm{pm}},A)\\leftrightarrow\n\\exists\\operatorname{Val},\\operatorname{Sat}\\in V\\;\\Bigl(\n\\mathrm{Struct}_S(\\mathcal M,L_{\\mathrm{pm}})\\land\n\\mathrm{Satisfaction}_S(\\mathcal M,L_{\\mathrm{pm}},\\operatorname{Val},\\operatorname{Sat})\\land\n\\ A\\subseteq\\mathrm{Univ}(\\mathcal M)\\land\nH=\\Bigl\\{b\\in\\mathrm{Univ}(\\mathcal M):\\exists\\varphi\\in\\Sigma_1(L_{\\mathrm{pm}})\\;\\exists n\\in\\omega\\;\\exists a\\in V\\;\n\\exists s\\in V\\;\\Bigl(\n\\mathrm{Function}(a,n,A)\n\\land\\operatorname{FV}_{L_{\\mathrm{pm}}}(\\varphi)\\subseteq\\{v_j:j\\in n+1\\}\n\\land\\mathrm{Assign}(\\mathcal M,s)\n\\land s(v_0)=b\\land\\forall j\\in n\\;(s(v_{j+1})=a(j))\\\\\n\\land\\operatorname{Sat}(\\varphi,s)\n\\land\\forall c\\in\\mathrm{Univ}(\\mathcal M)\\;\n\\bigl(\\operatorname{Sat}(\\varphi,s[v_0\\mapsto c])\\leftrightarrow c=b\\bigr)\n\\Bigr)\\Bigr\\}\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}inner\\text{-}sound\\text{-}premouse} \\vdash\n\\mathrm{ZfcInnerSoundPremouse}_S(\\mathcal M,L_{\\mathrm{pm}},\\rho,p)\\leftrightarrow\n\\mathrm{ZfcModel7Premouse}_S(\\mathcal M)\\land\n\\mathcal M=\\langle M,\\in,\\vec E\\rangle\\land\n\\mathrm{Univ}(\\mathcal M)=M\\land\n\\mathrm{Ordinal}(\\rho)\\land\\rho\\in M\\land p\\in M\\land\n\\exists H\\in V\\;(\\mathrm{SigmaOneHull}_S(H,\\mathcal M,L_{\\mathrm{pm}},\\rho\\cup\\{p\\})\\land H=M)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}inner\\text{-}sound\\text{-}premouse} \\vdash\n\\mathrm{ZfcInnerSoundPremouse}_S(\\mathcal M,L_{\\mathrm{pm}},\\rho,p)\\leftrightarrow\n\\mathrm{ZfcModel7Premouse}_S(\\mathcal M)\\land\n\\mathcal M=\\langle M,\\in,\\vec E\\rangle\\land\n\\mathrm{Univ}(\\mathcal M)=M\\land\n\\mathrm{Ordinal}(\\rho)\\land\\rho\\in M\\land p\\in M\\land\n\\exists H\\in V\\;(\\mathrm{SigmaOneHull}_S(H,\\mathcal M,L_{\\mathrm{pm}},\\rho\\cup\\{p\\})\\land H=M)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Soundness is stated relative to explicit candidate projectum <span class=\"math-inline\" data-tex=\"\\rho\">\\(\\rho\\)</span> and standard parameter <span class=\"math-inline\" data-tex=\"p\">\\(p\\)</span>; the hull uses the full premouse structure and its satisfaction recursion, so the extender predicate is not discarded by replacing the premouse with a bare membership pair.</li>\n<li>Definability in the <span class=\"math-inline\" data-tex=\"\\Sigma_1\">\\(\\Sigma_1\\)</span> hull now uses the selected <span class=\"math-inline\" data-tex=\"\\operatorname{Sat}\">\\(\\operatorname{Sat}\\)</span> recursion and an explicit assignment of the distinguished output variable and finite parameter tuple.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"./58-df-zfc-model7-premouse.md","status":"resolved","id":"1048d44b28527ff2","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[./58-df-zfc-model7-premouse.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch17/58-df-formula.md","status":"resolved","id":"65418b505fc53093","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-formula.md]]","embed":false},{"target":"../batch18/58-df-satisfaction.md","status":"resolved","id":"8b6a90316aad78a4","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch18/58-df-satisfaction.md]]","embed":false},{