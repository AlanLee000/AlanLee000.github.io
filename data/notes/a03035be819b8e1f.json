(M,\\mathrm{ZFC})\n\\land\\lambda,\\kappa,\\check\\lambda,\\check\\kappa\\in M\n\\land\\mathrm{RegularCardinal}_S(\\lambda)\n\\land\\mathrm{StronglyInaccessible}_S(\\kappa)\n\\land\\lambda<\\kappa\n\\land P=\\operatorname{Coll}(\\lambda,{<}\\kappa)\n\\land R=\\leq_{\\operatorname{Coll}(\\lambda,{<}\\kappa)}\n\\land\\mathrm{Name}(\\check\\lambda,P)\n\\land\\mathrm{Name}(\\check\\kappa,P)\n\\to\\mathrm{ZfcForcingRelation}_S(\nM,\\varnothing,\\varphi_{\\mathrm{succ}},\n\\langle\\check\\lambda,\\check\\kappa\\rangle,P,R).","display":true},{"tex":"\\lambda","display":false},{"tex":"\\kappa","display":false},{"tex":"<\\lambda","display":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa","display":false},{"tex":"\\lambda","display":false},{"tex":"\\lambda","display":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa","display":false},{"tex":"\\kappa = \\lambda^+","display":false},{"tex":"\\kappa = \\omega_2","display":false},{"tex":"\\mathrm{Col}(\\omega, <\\kappa)","display":false},{"tex":"\\kappa","display":false}],"bytes":2721,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4092","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-thm-collapse-forcing.md|58-thm-collapse-forcing]]（batch18）"},{"id":"7334957c6d59eacc","anchor":"ref-165","locations":["正文"],"count":1,"excerpt":"[[58-thm-0-sharp.md]]\n[[58-thm-L-condensation.md]]\n[[58-thm-L-definability.md]]\n[[58-thm-L-generic-extension.md]]\n[[58-thm-L-is-transitive.md]]\n[[58-thm-L-satisfies-GCH.md]]\n[[58-thm-L-satisfies-ZFC.md]]\n[[58-thm-MM.md]]\n[[58-thm-V-equal-L.md]]\n[[58-thm-V-equals-L.md]]\n[[58-thm-absoluteness-calculation.md]]\n[[58-thm-ac-wellorder-equivalent.md]]\n[[58-thm-aleph-properties.md]]\n[[58-thm-analytic-completeness.md]]\n[[58-thm-analytic-set-properties.md]]\n[[58-thm-baire-category-theory.md]]\n[[58-thm-baire-category.md]]\n[[58-thm-banach-tarski.md]]\n[[58-thm-beth-function-properties.md]]\n[[58-thm-boolean-valued-model.md]]\n[[58-thm-borel-cardinality.md]]\n[[58-thm-borel-de