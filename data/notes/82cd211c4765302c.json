vec\\tau,\\tau_\\times\\in V\\;\\Bigl(&G=\\langle X,m,e,i,\\tau\\rangle\n\\land\\mathrm{Group}_S(X,m)\n\\land e\\in X\\land\\mathrm{Function}(i,X,X)\\\\\n&{}\\land\\forall x\\in X\\;\\bigl(m(\\langle x,i(x)\\rangle)=e\n\\land m(\\langle i(x),x\\rangle)=e\\bigr)\\\\\n&{}\\land\\mathrm{ZfcTop2LocallyCompactSpace}_S(X,\\tau)\n\\land\\mathrm{ZfcTop5HausdorffSpace}_S(X,\\tau)\\\\\n&{}\\land\\mathrm{Function}(\\vec X,2,\\{X\\})\n\\land\\vec X(0)=X\\land\\vec X(1)=X\\\\\n&{}\\land\\mathrm{Function}(\\vec\\tau,2,\\{\\tau\\})\n\\land\\vec\\tau(0)=\\tau\\land\\vec\\tau(1)=\\tau\\\\\n&{}\\land\\tau_\\times=\\mathrm{BinaryProductTopology}_S(X,\\tau,X,\\tau)\n\\land\\mathrm{ZfcTop5ContinuousMap}_S(X\\times X,\\tau_\\times,X,\\tau,m)\n\\land\\mathrm{ZfcTop5ContinuousMap}_S(X,\\tau,X,\\tau,i)\\\\\n&{}\\land\\mathrm{RadonLF}_S(\\mu,X,\\tau)\\land\\mu(X)>0\\\\\n&{}\\land\\forall g\\in X\\;\\forall A\\in\\mathcal B(X,\\tau)\\;\n\\bigl(\\mu(\\{m(\\langle g,a\\rangle):a\\in A\\})=\\mu(A)\\bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mu(K)","display":false}],"bytes":3808,"backlinks":[{"id":"9b559d9a72ff847c","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$G_K=\\langle\\mathbb A_K^\\times,m_K,e_K,i_K,\\tau_K\\rangle$ and $\\mathrm{ZfcMeasure8HaarMeasure}_S(\\mu_K^\\times,G_K)$ (idele-group data and a left Haar measure, see [[../batch18/58-df-zfc-measure8-haar-measure.md]])"},{"id":"84dce5217e459217","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcMeasure8HaarMeasure}_S\\subseteq V^2$ (see [[../batch18/58-df-zfc-measure8-haar-measure.md]])."},{"id":"84daad544872cc71","anchor":"ref-2650","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-zfc-measure8-haar-measure.md|58-df-zfc-measure8-haar-measure]]（batch18）"}],"outgoing":["ca7fc3ab38a11801","a3348ed9eb6fb4e3","ed71f39f59370734","1d11f892f3efc814","69f8a4b0afb36176","682d2801cf83c784","67cf48a2f6e27861","ca832ed6bc22f728","9375de7089953a2b","36d7463d2