{"id":"71c6d20545c847aa","group":"58","path":"58/batch19/58-df-zfc-comb7-linked-family.md","title":"ZFC Comb7 Linked Family","display":"df-zfc-comb7-linked-family — ZFC Comb7 Linked Family","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-comb7-linked-family","aliases":["58-df-zfc-comb7-linked-family"],"display":"df-zfc-comb7-linked-family — ZFC Comb7 Linked Family","depends_on":["[[58-ax-zfc]]","[[58-df-family]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-comb7-linked-family"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-comb7-linked-family</span></div>"},{"key":"display","html":"df-zfc-comb7-linked-family — ZFC Comb7 Linked Family"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"545b51e7aa011030\" href=\"?note=545b51e7aa011030\" title=\"58-df-family\">58-df-family</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\mathcal F\\in V\">\\(X,\\mathcal F\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcComb7LinkedFamily}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcComb7LinkedFamily}_S:V^2\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comb7\\text{-}linked\\text{-}family} \\vdash \\mathrm{ZfcComb7LinkedFamily}_S(X,\\mathcal F)\\leftrightarrow \\mathcal F\\subseteq\\mathcal P(X)\\land\\forall A,B\\in\\mathcal F\\;(A\\cap B\\neq\\emptyset)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm