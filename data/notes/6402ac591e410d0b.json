mathrm{Countable}_{93}(\\operatorname{Sym}_{93}(\\mathcal L))","display":true},{"tex":"\\mathrm{Var}_{93}","display":false}],"bytes":949,"backlinks":[{"id":"958ef9477c2fa52f","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"840f3a795c44b39b","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""}],"outgoing":["e30eac382dc7d1a7","cc9bc888c7dda430"]}