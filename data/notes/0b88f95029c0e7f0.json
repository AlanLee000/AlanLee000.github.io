<li><span class=\"math-inline\" data-tex=\"\\mathrm{DominatingNumber}_S\">\\(\\mathrm{DominatingNumber}_S\\)</span> (dominating-number predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCiDominatingNumber}_S\">\\(\\mathrm{ZfcCiDominatingNumber}_S\\)</span> (alias predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}dominating\\text{-}number} \\vdash \\mathrm{DominatingNumber}_S(\\mathfrak d)\\leftrightarrow \\mathrm{Cardinal}_S(\\mathfrak d)\\land\\mathfrak d=\\min\\left\\{|D|\\ \\middle|\\ D\\subseteq\\omega^\\omega\\land\\forall f\\in\\omega^\\omega\\;\\exists g\\in D\\;\\exists n\\in\\omega\\;\\forall m\\geq n\\;(f(m)\\leq g(m))\\right\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}dominating\\text{-}number} \\vdash \\mathrm{DominatingNumber}_S(\\mathfrak d)\\leftrightarrow \\mathrm{Cardinal}_S(\\mathfrak d)\\land\\mathfrak d=\\min\\left\\{|D|\\ \\middle|\\ D\\subseteq\\omega^\\omega\\land\\forall f\\in\\omega^\\omega\\;\\exists g\\in D\\;\\exists n\\in\\omega\\;\\forall m\\geq n\\;(f(m)\\leq g(m))\\right\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}dominating\\text{-}number} \\vdash \\mathrm{ZfcCiDominatingNumber}_S(\\mathfrak d)\\leftrightarrow \\mathrm{DominatingNumber}_S(\\mathfrak d)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}dominating\\text{-}number} \\vdash \\mathrm{ZfcCiDominatingNumber}_S(\\mathfrak d)\\leftrightarrow \\mathrm{DominatingNumber}_S(\\mathfrak d)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathfrak{d}\">\\(\\mathfrak{d}\\)</span> is the smallest size of a family dominating all functions in <span class=\"math-inline\" data-tex=\"\\omega^{\\omega}\">\\(\\omega^{\\omega}\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathfrak{b} \\leq \\mathfrak{d}\">\\(\\mathfrak{b} \\leq \\mathfrak{d}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathfrak{d} \\leq \\mathfrak{c}\">\\(\\mathfrak{d} \\leq \\mathfrak{c}\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-df-cardinal","status":"resolved","id":"5fb1c2241d1943d1","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-cardinal]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"58-df-cardinal","status":"resolved","id":"5fb1c2241d1943d1","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Cardinal}_S$ (cardinal predicate, see [[58-df-cardinal]])","embed":false}],"math":[{"tex":"\\mathfrak{d}","display":false},{"tex":"f\\leq^*g\\leftrightarrow\\exists n\\in\\omega\\;\\forall m\\geq n\\;(f(m)\\leq g(m))","display":false},{"tex":"\\mathrm{Cardinal}_S","display":false},{"tex":"\\mathrm{DominatingNumber}_S","display":false},{"tex":"\\mathrm{ZfcCiDominatingNumber}_S","display":false},{"tex":"\\mathrm{df\\text{-}dominating\\text{-}number} \\vdash \\mathrm{DominatingNumber}_S(\\mathfrak d)\\leftrightarrow \\mathrm{Cardinal}_S(\\mathfrak d)\\land\\mathfrak d=\\min\\left\\{|D|\\ \\middle|\\ D\\subseteq\\omega^\\omega\\land\\forall f\\in\\omega^\\omega\\;\\exists g\\in D\\;\\exists n\\in\\omega\\;\\forall m\\geq n\\;(f(m)\\leq g(m))\\right\\}","display":true},{"tex":"\\mathrm{df\\text{-}dominating\\text{-}number} \\vda