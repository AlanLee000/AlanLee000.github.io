6c83e75cb\" href=\"?note=5045d216c83e75cb\" title=\"../batch16/58-df-omega.md\">../batch16/58-df-omega.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"4884f45058a56aac\" href=\"?note=4884f45058a56aac\" title=\"../batch02/58-df-integral.md\">../batch02/58-df-integral.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mu\">\\(\\mu\\)</span> (set function, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"58-df-measure\">58-df-measure</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathcal{A}\">\\(\\mathcal{A}\\)</span> (algebra of sets, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"c1a035d3f86ce767\" href=\"?note=c1a035d3f86ce767\" title=\"../batch03/58-df-zfc-measure10-algebra-of-sets.md\">../batch03/58-df-zfc-measure10-algebra-of-sets.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"X\">\\(X\\)</span> (underlying set)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure10AlgebraOfSets}_S\">\\(\\mathrm{ZfcMeasure10AlgebraOfSets}_S\\)</span> (algebra-of-sets predicate, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"c1a035d3f86ce767\" href=\"?note=c1a035d3f86ce767\" title=\"../batch03/58-df-zfc-measure10-algebra-of-sets.md\">../batch03/58-df-zfc-measure10-algebra-of-sets.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (three-argument function predicate, see <a class=\"wiki-link\" id=\"ref-10\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function\">../batch16/58-df-function</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure11PremeasureOnAlgebra}_S\">\\(\\mathrm{ZfcMeasure11PremeasureOnAlgebra}_S\\)</span> (predicate defined here)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"E_+\\coloneqq\\mathbb R_{\\geq0}\\cup\\{\\infty\\}\">\\(E_+\\coloneqq\\mathbb R_{\\geq0}\\cup\\{\\infty\\}\\)</span>，<span class=\"math-inline\" data-tex=\"\\infty\\notin\\mathbb R\">\\(\\infty\\notin\\mathbb R\\)</span>；在 <span class=\"math-inline\" data-tex=\"E_+\">\\(E_+\\)</span> 上，\n<span class=\"math-inline\" data-tex=\"a\\leq b\\leftrightarrow(b=\\infty\\lor(a,b\\in\\mathbb R_{\\geq0}\\land a\\leq_{\\mathbb R}b))\">\\(a\\leq b\\leftrightarrow(b=\\infty\\lor(a,b\\in\\mathbb R_{\\geq0}\\land a\\leq_{\\mathbb R}b))\\)</span>，\n<span class=\"math-inline\" data-tex=\"a\\oplus b\\coloneqq\\begin{cases}a+_{\\mathbb R}b,&amp;a,b\\in\\mathbb R_{\\geq0},\\\\\\infty,&amp;a=\\infty\\lor b=\\infty.\\end{cases}\">\\(a\\oplus b\\coloneqq\\begin{cases}a+_{\\mathbb R}b,&amp;a,b\\in\\mathbb R_{\\geq0},\\\\\\infty,&amp;a=\\infty\\lor b=\\infty.\\end{cases}\\)</span></p>\n</li>\n<li>\n<p>对 <span class=\"math-inline\" data-tex=\"u\\in E_+^\\omega\">\\(u\\in E_+^\\omega\\)</span>，<span class=\"math-inline\" data-tex=\"p_u\">\\(p_u\\)</span> 是满足 <span class=\"math-inline\" data-tex=\"\\mathrm{Function}(p_u,\\omega,E_+)\\land p_u(0)=0\\land\\forall n\\in\\omega\\;(p_u(n+1)=p_u(n)\\oplus u(n))\">\\(\\mathrm{Function}(p_u,\\omega,E_+)\\land p_u(0)=0\\land\\forall n\\in\\omega\\;(p_u(n+1)=p_u(n)\\oplus u(n))\\)</span> 的唯一函数图。可数和是下式唯一确定的 <span class=\"math-inline\" data-tex=\"r\">\\(r\\)</span>：\n<span class=\"math-inline\" data-tex=\"\\sum_{n\\in\\omega}u(n)=r\\leftrightarrow r\\in E_+\\land[\\forall N\\in\\omega\\;(p_u(N)\\leq r)]\\land\\forall b\\in E_+\\;([\\forall N\\in\\omega\\;(p_u(N)\\leq b)]\\to r\\leq b)\">\\(\\sum_{n\\in\\omega}u(n)=r\\leftrightarrow r\\in E_+\\land[\\forall N\\in\\omega\\;(p_u(N)\\leq r)]\\land\\forall b\\in E_+\\;([\\forall N\\in\\omega\\;(p_u(N)\\leq b)]\\to r\\leq b)\\)</span>。</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\sum_{n\\in\\omega}t(n)\">\\(\\sum_{n\\in\\omega}t(n)\\)</span> 使用函数图 <span class=\"math-inline\" data-tex=\"\\{\\langle n,t(n)\\rangle:n\\in\\omega\\}\">\\(\\{\\langle n,t(n)\\rangle:n\\in\\omega\\}\\)</span>；只在各项属于 <span class=\"math-inline\" data-tex=\"E_+\">\\(E_+\\)</span> 时使用。函数图及自然数分别见 <a class=\"wiki-link\" id=\"ref-11\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>、<a class=\"wiki-link\" id=\"ref-12\" data-note=\"5045d216c83e75cb\" href=\"?note=5045d216c83e75cb\" title=\"../batch16/58-df-omega.md\">../batch16/58-df-omega.md</a>；本约定展开 <a class=\"wiki-link\" id=\"ref-13\" data-note=\"4884f45058a56aac\" href=\"?note=4884f45058a56aac\" title=\"../batch02/58-df-integral.md\">../batch02/58-df-integral.md</a> 的非负部分和约定。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}premeasure\\text{-}on\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure11PremeasureOnAlgebra}_S(\\mu,\\mathcal{A},X)\\leftrightarrow \\mathrm{ZfcMeasure10AlgebraOfSets}_S(\\mathcal{A},X)\\land\\mathrm{Function}(\\mu,\\mathcal A,[0,\\infty])\\land\\mu(\\emptyset)=0\\land\\forall F\\in V\\;\\Bigl(\\bigl[\\mathrm{Function}(F,\\omega,\\mathcal A)\\land\\forall m,n\\in\\omega\\;(m\\neq n\\to F(m)\\cap F(n)=\\emptyset)\\land\\bigcup_{n\\in\\omega}F(n)\\in\\mathcal A\\bigr]\\to\\mu\\bigl(\\bigcup_{n\\in\\omega}F(n)\\bigr)=\\sum_{n\\in\\omega}\\mu(F(n))\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure11\\text{-}premeasure\\text{-}on\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure11PremeasureOnAlgebra}_S(\\mu,\\mathcal{A},X)\\leftrightarrow \\mathrm{ZfcMeasure10AlgebraOfSets}_S(\\mathcal{A},X)\\land\\mathrm{Function}(\\mu,\\mathcal A,[0,\\infty])\\land\\mu(\\emptyset)=0\\land\\forall F\\in V\\;\\Bigl(\\bigl[\\mathrm{Function}(F,\\omega,\\mathcal A)\\land\\forall m,n\\in\\omega\\;(m\\neq n\\to F(m)\\cap F(n)=\\emptyset)\\land\\bigcup_{n\\in\\omega}F(n)\\in\\mathcal A\\bigr]\\to\\mu\\bigl(\\bigcup_{n\\in\\omega}F(n)\\bigr)=\\sum_{n\\in\\omega}\\mu(F(n))\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Both the premeasure and each tested sequence are typed by the actual graph predicate before application and countable additivity are used.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch03/58-df-zfc-measure10-algebra-of-sets.md","status":"resolved","id":"c1a035d3f86ce767","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch03/58-df-zfc-measure10-algebra-of-sets.md]]","embed":false},{"target":"58-df-measure","status":"resolved","id":"ca832ed6bc22f728","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-measure]]","embed":false},{"target":"../batch16/58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function]]","embed":false},{"target":"../batch16/58-df-omega.md","status":"resolved","id":"5045d216c83e75cb","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-omega.md]]","embed":false},{"target":"../batch02/58-df-integral.md","status":"resolved","id":"4884f45058a56aac","anchor":"ref-6","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-df-integral.md]]","embed":false},{"target":"58-df-measure","status":"resolved","id":"ca832ed6bc22f728","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesi