{"id":"34061709b4acb279","group":"73","path":"73/73-df-universal-language-notation.md","title":"universal language notation","display":"df-universal-language-notation — universal language notation","type":"definition","metadata":{"type":"definition","book":"Introduction to Automata Theory, Languages, and Computation (Hopcroft, Motwani, Ullman; 3rd ed., 2007)","book_abbrev":"73","label":"73-df-universal-language-notation","display":"df-universal-language-notation — universal language notation","depends_on":["[[73-df-binary-program-coding]]","[[73-df-dtm-language-semantics]]"],"aliases":["73-df-universal-language-notation","73-definition-8.3"],"source_id":"HMU2007","source_ref":"§9.1–9.2, print pp. 378–390; PDF pp. 400–412; local effective program/tuple representation","source_status":"third-edition-topic-mapped; inherited-local-review; not-a-line-by-line-source-proof-certificate","reviewed_on":"2026-10-24","legacy_numbering":"local-catalog; not book numbering","legacy_source_id":"HU1979","legacy_source_ref":"§8.3, pp. 181–185; local typed acceptance/halting languages and coding","legacy_source_status":"local-formalization; source-section-located; proof scope recorded in review","revision_round":"pdf-third-edition-20261024","edition_role":"third-edition-core","third_edition_chapter":9},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Introduction to Automata Theory, Languages, and Computation (Hopcroft, Motwani, Ullman; 3rd ed., 2007)"},{"key":"book_abbrev","html":"73"},{"key":"label","html":"73-df-universal-language-notation"},{"key":"display","html":"df-universal-language-notation — universal language notation"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"db96cabedd089e5f\" href=\"?note=db96cabedd089e5f\" title=\"73-df-binary-program-coding\">73-df-binary-program-coding</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"888d