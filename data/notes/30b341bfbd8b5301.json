cerpt":""},{"id":"bc6be798712f24f2","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{Cg}^{\\mathbf A}$ and $\\mathrm{Con}(\\mathbf A)$ are sourced from [[93-df-congruence-lattice]] and [[93-df-congruence]]."},{"id":"cc0e90fd941e3f0c","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"86be4df10dc371c0","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"d4635c6e179ddf8a","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"6db8269e34c129cd","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"a5a69b9a2969217e","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"d9c7505f9ccdb5ad","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"fcafc6e9cc20d2e8","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e6fd74a4291b286e","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"073446c7e27f1cce","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"730edd22d82070e5","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"57abb955e28f83aa","anchor":"ref-32","locations":["正文"],"count":1,"excerpt":"[[93-df-congruence]]"}],"outgoing":["6730349967b8ffce"]}