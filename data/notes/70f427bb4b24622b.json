tions":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\leq_T\\subseteq V^2$ is the Tukey preorder from [[../batch02/58-df-tukey.md]]."},{"id":"9fca030cde4a0217","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-1329","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-tukey.md|58-df-tukey]]（batch02）"}],"outgoing":["d3f859dbdd37f018","36d7463d215be751"]}