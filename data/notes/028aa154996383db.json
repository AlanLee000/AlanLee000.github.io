V^{3}","display":false},{"tex":"\\mathrm{Cohen}_S\\subseteq V^{3}","display":false},{"tex":"\\mathrm{ZfcForcingRelation}_S\\subseteq V^{6}","display":false},{"tex":"M,\\Gamma,P,\\leq_P,1_P,\\lambda,\\varphi_{\\mathrm{Cohen}}\\in V","display":false},{"tex":"\\mathrm{CTM}_S(M,\\Gamma)","display":false},{"tex":"P,\\lambda\\in M","display":false},{"tex":"\\mathrm{Cardinal}_S(\\lambda)","display":false},{"tex":"\\mathrm{Cohen}_S(P,\\leq_P,\\lambda)","display":false},{"tex":"\\varphi_{\\mathrm{Cohen}}","display":false},{"tex":"v_0=\\omega_1","display":false},{"tex":"|\\mathcal P(v_1)|\\geq v_2","display":false},{"tex":"\\mathrm{ZfcForcingRelation}_S","display":false},{"tex":"\\mathrm{CheckName}_S","display":false},{"tex":"\\begin{aligned}\n\\mathrm{cor\\text{-}cohen\\text{-}adds}\\vdash{}&\n\\mathrm{CTM}_S(M,\\Gamma)\\land P,\\lambda\\in M\n\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\aleph_1^M\\leq\\lambda\n\\land\\mathrm{Cohen}_S(P,\\leq_P,\\lambda)\\land1_P=\\varnothing\\\\\n&\\land\\varphi_{\\mathrm{Cohen}}\\in\\mathrm{Fml}_S(\\mathcal L_\\in)\n\\land\\operatorname{FV}_{\\mathcal L_\\in}(\\varphi_{\\mathrm{Cohen}})=\\{v_0,v_1,v_2\\}\\\\\n&\\to\\exists\\widehat{\\omega_1^M},\\widehat\\omega,\\widehat\\lambda\\in M\\;\\Bigl(\n\\mathrm{CheckName}_S(\\widehat{\\omega_1^M},\\omega_1^M,P)\n\\land\\mathrm{CheckName}_S(\\widehat\\omega,\\omega,P)\\\\\n&\\hspace{75pt}\\land\\mathrm{CheckName}_S(\\widehat\\lambda,\\lambda,P)\n\\land\\mathrm{ZfcForcingRelation}_S\\!\\left(\nM,1_P,\\varphi_{\\mathrm{Cohen}},\n\\langle\\widehat{\\omega_1^M},\\widehat\\omega,\\widehat\\lambda\\rangle,P,\\leq_P\n\\right)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\omega_1","display":false},{"tex":"\\lambda","display":false},{"tex":"\\check\\lambda","display":false},{"tex":"2^{\\aleph_0}=\\aleph_2","display":false},{"tex":"\\lambda=\\aleph_2","display":false}],"bytes":2395,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-41","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-cor-cohen-a