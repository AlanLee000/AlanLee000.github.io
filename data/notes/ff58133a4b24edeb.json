\chi_B","display":false},{"tex":"\\psi\\sqsubseteq\\chi_C","display":false},{"tex":"f=\\Phi_e^B=\\Phi_i^C","display":false},{"tex":"\\theta,\\psi","display":false},{"tex":"\\rho,\\tau","display":false},{"tex":"x","display":false},{"tex":"\\Phi_e^\\rho(x)\\downarrow\\ne\\Phi_i^\\tau(x)\\downarrow","display":false},{"tex":"\\mathrm{lem\\text{-}compatible\\text{-}cross\\text{-}search}\\vdash\nf\\le_TZ.","display":true},{"tex":"x","display":false},{"tex":"Z","display":false},{"tex":"\\theta","display":false},{"tex":"\\rho","display":false},{"tex":"e","display":false},{"tex":"Z","display":false},{"tex":"B","display":false},{"tex":"C","display":false},{"tex":"\\psi","display":false},{"tex":"f(x)","display":false},{"tex":"B,C","display":false},{"tex":"Z","display":false}],"bytes":2018,"backlinks":[{"id":"f1ca4420af66074c","anchor":"ref-10","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-df-exact-pair]]；see [[20-df-column-thickness]]；see [[20-df-partial-compatibility]]；see [[20-lem-compatible-cross-search]]；see [[20-df-join]]；see [[20-df-deg]]。"},{"id":"005203b6707a19f4","anchor":"ref-269","locations":["正文"],"count":1,"excerpt":"[[20-lem-compatible-cross-search]] — 章 6；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-269","locations":["正文"],"count":1,"excerpt":"[[20-lem-compatible-cross-search]]"}],"outgoing":["8cea21e174a04417","140cce30ee9c16d1","52376918bee1945e","755e421576224435"]}