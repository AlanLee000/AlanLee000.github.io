\n\\mathrm{SingularSupport}_S(S,T,X,\\mathcal T_X,n)\\leftrightarrow{}&\nn\\in\\omega_{>0}\\land\\mathrm{EuclideanOpen}_S(X,n)\n\\land\\mathcal T_X=\\mathrm{EuclideanSubspaceTopology}_S(X,n)\n\\land T\\in\\mathcal D'(X)\\\\\n&\\land S=X\\setminus\\bigcup\\{U\\in\\mathcal T_X:\n\\mathrm{DistributionSmoothOn}_S(T,U,X,\\mathcal T_X,n)\\}.\n\\end{aligned}","display":true},{"tex":"T\\in\\mathcal D'(X)\\to\n\\bigl(\\operatorname{singsupp}_{X,\\mathcal T_X,n}(T)=S\n\\leftrightarrow\\mathrm{SingularSupport}_S(S,T,X,\\mathcal T_X,n)\\bigr).","display":true}],"bytes":3862,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1179","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-singular-support.md|58-df-singular-support]]（batch02）"}],"outgoing":["c53fe47de39217ed","c664c247a9331632","17de8347f6f91384","458fd0dccec3665f","36d7463d215be751","5111035a66b30703","a6c5654857edae16","76a1ed4ae7e8b05d","ca7fc3ab38a11801"]}