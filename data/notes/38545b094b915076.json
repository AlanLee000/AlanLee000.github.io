sentially\\text{-}undecidable}\\vdash\n\\forall A'\\subseteq\\mathrm{Fml}_G\\;\\forall G'\\;\\Bigl[\nG'=(\\Sigma_G,A',\\mathrm{MP}\\cup\\mathrm{Gen})\\land\n\\mathrm{Ax}(G)\\subseteq A'\\land\\mathrm{Elem}(G')\\land\\mathrm{Con}(G')\n\\Longrightarrow\\neg\\mathrm{Complete}(G')\\Bigr]","display":true},{"tex":"G","display":false},{"tex":"G","display":false},{"tex":"G'\\supseteq G","display":false},{"tex":"G","display":false}],"bytes":1781,"backlinks":[{"id":"7c6a45591fbdd08e","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"c762edc5b4f95fbd","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e9a4da37b8e411f7","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"52184c84df392b80","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"823a52c75bbad9bd","anchor":"ref-162","locations":["正文"],"count":1,"excerpt":"[[92-thm-ce-incompleteness.md]]\n[[92-thm-ch-independence.md]]\n[[92-thm-compactness.md]]\n[[92-thm-completeness-fo.md]]\n[[92-thm-consistency-addable.md]]\n[[92-thm-consistency-strength-hierarchy.md]]\n[[92-thm-craig-theorem.md]]\n[[92-thm-deduction-theorem.md]]\n[[92-thm-diagonal-lemma.md]]\n[[92-thm-essentially-undecidable.md]]\n[[92-thm-first-incompleteness.md]]\n[[92-thm-godel-incompleteness-general.md]]\n[[92-thm-godel-set-undecidable.md]]\n[[92-thm-halting-undecidable.md]]\n[[92-thm-incompleteness-recursive-extension.md]]\n[[92-thm-induction-axiom-decidable.md]]\n[[92-thm-k-g-equivalent.md]]\n[[92-thm-lob-theorem.md]]\n[[92-thm-m-complete-creative.md]]\n[[92-thm-numeral-injective.md]]\n[[92-thm-omega-incompleteness.md]]\n[[92-thm-pairing-bijective.md]]\n[[92-thm-pi1-incompleteness.md]]\n[[92-thm-pr-representable-detailed.md]]\n[[92-thm-pr-representable.md]]\n[[92-thm-reflection-undecidable.md]]\n[[92-thm-reflection-unprovable.md]]\n[[92-thm-representability.md]]\n[[92-thm-representation-strong.md]]\n[[92-thm-rice-theorem-arithmetic.md]]\n[[92-