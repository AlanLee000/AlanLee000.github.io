t}(\\mathcal G)\\Longleftrightarrow\\exists M\\in\\mathrm{TM}\\;\\exists a,c\\in\\mathbb N_{\\ge1}\\;\\forall N\\ge1\\;\\forall v\\in[N]\\;\\forall i\\in[D]\\;\n\\left(M(\\operatorname{in}(N,v,i))=\\operatorname{bin}(\\operatorname{nbr}_{G_N}(v,i))\\land\\operatorname{time}_M(\\operatorname{in}(N,v,i))\\le c(1+\\lceil\\log_2(N+1)\\rceil)^a\\right).","display":true},{"tex":"D","display":false},{"tex":"1^N","display":false},{"tex":"[0,D]","display":false},{"tex":"ND","display":false},{"tex":"N","display":false},{"tex":"\\operatorname{ExpFamily}(\\mathcal G)","display":false}],"bytes":3384,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-263","locations":["正文"],"count":1,"excerpt":"第21章：扩展图、游走与提取器：[[28-df-regular-rotation-graph]]、[[28-df-random-walk-matrix]]、[[28-df-spectral-expander]]、[[28-df-edge-expander]]、[[28-df-explicit-expander-family]]、[[28-thm-random-walk-mixing]]、[[28-thm-expander-mixing-lemma]]、[[28-thm-spectral-implies-edge-expansion]]、[[28-thm-lazy-walk-spectrum]]、[[28-thm-expander-walk-extractor]]。"}],"outgoing":["df14955ee1f08cd3","1965e2b0765554c9","b5d4fc2d291ce98b"]}