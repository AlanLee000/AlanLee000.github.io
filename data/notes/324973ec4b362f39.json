orname{Val},\\operatorname{Sat},\\varphi,s\\in V\\;\\Bigl(\n\\mathrm{Satisfaction}_S(\\mathcal M,\\mathcal L_\\in,\\operatorname{Val},\\operatorname{Sat})\n\\land\\varphi\\in\\mathrm{Fml}_S(\\mathcal L_\\in)\\\\\n&\\qquad\\land\\mathrm{Assign}(\\mathcal M,s)\n\\land\\forall x\\in\\mathrm{Univ}(\\mathcal M)\\;\n\\bigl(x\\in C\\leftrightarrow\\operatorname{Sat}(\\varphi,s[v_0\\mapsto x])\\bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"s","display":false},{"tex":"v_0","display":false},{"tex":"C\\in V","display":false}],"bytes":2208,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1784","locations":["正文"],"count":1,"excerpt":"[[../batch13/58-df-zfc-definable-class.md|58-df-zfc-definable-class]]（batch13）"}],"outgoing":["a3348ed9eb6fb4e3","d9b8711cda3f31ca","65418b505fc53093","8b6a90316aad78a4","64f35ba2e87964e0"]}