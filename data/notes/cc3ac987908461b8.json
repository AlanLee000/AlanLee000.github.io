af56ba4\" href=\"?note=1cb4649e6af56ba4\" title=\"43-df-string\">43-df-string</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"aa33e0ea8422ba2a\" href=\"?note=aa33e0ea8422ba2a\" title=\"43-df-effective-coding\">43-df-effective-coding</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"565c3258eee2a5ff\" href=\"?note=565c3258eee2a5ff\" title=\"43-df-infseq\">43-df-infseq</a></span></div>"},{"key":"source_edition","html":"Downey–Hirschfeldt, Algorithmic Randomness and Complexity, draft 2007-07-28 (629 PDF pages)"},{"key":"source_locator","html":"§17.2–17.3, printed pp.514–517 / PDF pp.534–537"},{"key":"verification_status","html":"formalization-reviewed"},{"key":"eligible_as_verified_dependency","html":"true"},{"key":"source_proof_checked","html":"false"},{"key":"source_statement_checked","html":"false"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<p><span class=\"math-inline\" data-tex=\"D\">\\(D\\)</span> 是 <a class=\"wiki-link\" id=\"ref-7\" data-note=\"aa33e0ea8422ba2a\" href=\"?note=aa33e0ea8422ba2a\" title=\"43-df-effective-coding\">43-df-effective-coding</a> 中带固定有效编码、代码像可判定的非空可数域。<span class=\"math-inline\" data-tex=\"A\\in\\mathcal P(\\mathbb N)\\cup2^\\omega\">\\(A\\in\\mathcal P(\\mathbb N)\\cup2^\\omega\\)</span>；<span class=\"math-inline\" data-tex=\"\\operatorname{AsSet}\">\\(\\operatorname{AsSet}\\)</span> 见 <a class=\"wiki-link\" id=\"ref-8\" data-note=\"565c3258eee2a5ff\" href=\"?note=565c3258eee2a5ff\" title=\"43-df-infseq\">43-df-infseq</a>。<span class=\"math-inline\" data-tex=\"f:D\\to[0,\\infty)\">\\(f:D\\to[0,\\infty)\\)</span>，<span class=\"math-inline\" data-tex=\"g:2^{&lt;\\omega}\\to[0,\\infty)\">\\(g:2^{&lt;\\omega}\\to[0,\\infty)\\)</span>；<span class=\"math-inline\" data-tex=\"\\operatorname{LowerSemicomputable}^A\">\\(\\operatorname{LowerSemicomputable}^A\\)</span> 见 <a class=\"wiki-link\" id=\"ref-9\" data-note=\"4a53577d80a47730\" href=\"?note=4a53577d80a47730\" title=\"43-df-left-c.e.-function\">43-df-left-c.e.-function</a>。</p>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{LSC}_D^A(f)\\iff\\operatorname{LowerSemicomputable}^{\\operatorname{AsSet}(A)}(f).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{LSC}_D^A(f)\\iff\\operatorname{LowerSemicomputable}^{\\operatorname{AsSet}(A)}(f).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{LSC}_D(f)\\iff\\mathrm{LSC}_D^{\\varnothing}(f).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{LSC}_D(f)\\iff\\mathrm{LSC}_D^{\\varnothing}(f).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{LSC}^A(g)\\iff\\mathrm{LSC}_{2^{&lt;\\omega}}^A(g),\\qquad\\mathrm{LSC}(g)\\iff\\mathrm{LSC}_{2^{&lt;\\omega}}^{\\varnothing}(g).\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{LSC}^A(g)\\iff\\mathrm{LSC}_{2^{&lt;\\omega}}^A(g),\\qquad\\mathrm{LSC}(g)\\iff\\mathrm{LSC}_{2^{&lt;\\omega}}^{\\varnothing}(g).\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<p>本节点是统一下半可计算函数的有限值接口；输入函数的声明排除了无穷资本。一般域与二进制串域分别声明变量，避免以不匹配的定义域调用特化谓词。所有必要关系已在前两节给出。</p>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"43-df-left-c.e.-function","status":"resolved","id":"4a53577d80a47730","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[43-df-left-c.e.-function]]","embed":false},{"target":"43-df-computable","status":"resolved","id":"f357216a7edb035a","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":