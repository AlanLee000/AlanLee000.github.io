\}\\rangle:x\\in X\\}\\land\\tau=\\{U\\subseteq Q:\\mathrm{MetricOpen}_S(\\pi^{-1}[U],X,d)\\}","display":true},{"tex":"Q","display":false}],"bytes":1892,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2692","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-df-zfc-metric-quotient-space.md|58-df-zfc-metric-quotient-space]]（batch20）"}],"outgoing":["267957a097ff75bf","9ced46394294c1a6","36d7463d215be751"]}