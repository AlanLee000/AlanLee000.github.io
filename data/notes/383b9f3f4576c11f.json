M}},\\\n\\mathbf N\\in\\mathsf{Alg}_{\\mathsf{NM}},\\\nv:\\mathsf{Prop}\\to N,\\\n\\forall C\\in\\Gamma\\,⟦ C⟧_{\\mathbf N,v}^{\\mathsf{NM}}=1,\\\n⟦ A⟧_{\\mathbf N,v}^{\\mathsf{NM}}\\ne1\\}.","display":true},{"tex":"\\mathsf{Fail}_{\\mathsf{NM}}(\\Gamma,A)\n=\\{(\\mathbf N,v):(\\Gamma,A,\\mathbf N,v)\\in\\mathsf{Cex}_{\\mathsf{NM}}\\},\n\\qquad\n\\mathsf{SemCert}_{\\mathsf{NM}}(\\Gamma,A)\n=\n\\begin{cases}\n\\{\\star\\},&\\mathsf{Fail}_{\\mathsf{NM}}(\\Gamma,A)=\\varnothing,\\\\\n\\varnothing,&\\mathsf{Fail}_{\\mathsf{NM}}(\\Gamma,A)\\ne\\varnothing.\n\\end{cases}","display":true},{"tex":"\\mathsf{Rule}^{\\operatorname{proof}}_{\\mathsf{NM}}\n\\subseteq\\mathsf{Fm}_{\\mathsf{NM}}^{<\\omega}\\times\\mathsf{Fm}_{\\mathsf{NM}},\n\\qquad \\mathsf{Rule}^{\\operatorname{proof}}_{\\mathsf{NM}}=\\varnothing.","display":true},{"tex":"\\mathcal S_{\\mathsf{NM}}\n=\n\\bigl(\n\\mathsf{Prop},\n\\mathsf{Fm}_{\\mathsf{NM}},\n\\operatorname{PV}_{\\mathsf{NM}},\n\\operatorname{FV}_{\\mathsf{NM}},\n\\operatorname{BV}_{\\mathsf{NM}},\n\\mathsf{Subst}_{\\mathsf{NM}},\n\\operatorname{Ext}_{\\mathsf{NM}},\n\\operatorname{Sub}_{\\mathsf{NM}},\n\\equiv_{\\alpha,\\mathsf{NM}},\n\\mathsf{Alg}_{\\mathsf{NM}},\n⟦-⟧^{\\mathsf{NM}},\n\\mathsf{Valid}_{\\mathsf{NM}},\n\\models_{\\mathsf{NM}},\n\\mathsf{Cex}_{\\mathsf{NM}},\n\\mathsf{Fail}_{\\mathsf{NM}},\n\\mathsf{SemCert}_{\\mathsf{NM}},\n\\mathsf{Rule}^{\\operatorname{proof}}_{\\mathsf{NM}}\n\\bigr).","display":true},{"tex":"\\mathsf{Alg}_{\\mathsf{NM}}","display":false},{"tex":"\\models_{\\mathsf{NM}}","display":false}],"bytes":7950,"backlinks":[],"outgoing":[]}