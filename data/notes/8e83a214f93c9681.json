\\in\\mathrm{Var}_S\\;\n\\bigl(b(\\neg\\varphi)=b(\\varphi)\\land b(\\varphi\\lor\\psi)=b(\\varphi)\\cup b(\\psi)\n\\land b(\\forall x\\,\\varphi)=b(\\varphi)\\bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{FirstOrderLanguage}_S(\\Sigma)\\land\\varphi\\in\\mathrm{Fml}_S(\\Sigma)\\\\\n&\\quad\\to\\Bigl(\\operatorname{Vocabulary}_{\\mathsf{meta}}(\\Sigma,\\varphi)=S\n\\leftrightarrow\\exists a,b\\in V\\;\n(\\mathrm{FormulaVocabularyRecursion}_{58}(a,b,\\Sigma)\\land S=b(\\varphi))\\Bigr).\n\\end{aligned}","display":true}],"bytes":3512,"backlinks":[{"id":"8184bbc4f58748b7","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-2495","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-logic9-interpolation-property.md|58-df-zfc-logic9-interpolation-property]]（batch03）"}],"outgoing":["a3348ed9eb6fb4e3","65418b505fc53093","44e32f3fb4334e0c","3888033a846b1cd5","36d7463d215be751"]}