forall O\\in\\tau_{\\mathbb R}\\;(f^{-1}[O]\\in\\tau)\\land\\exists C\\in\\mathbb R_{\\geq0}\\;\\forall x\\in X\\;(|f(x)|\\leq C)\\Bigr\\}\\land\\forall f\\in F\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\\exists N\\in\\omega\\;\\forall n\\in\\omega\\;\\Bigl(N\\leq n\\to\\bigl|\\int f\\,d\\vec\\mu(n)-\\int f\\,d\\mu\\bigr|<\\varepsilon\\Bigr)","display":true}],"bytes":2289,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2569","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-zfc-measure11-weak-convergence-code.md|58-df-zfc-measure11-weak-convergence-code]]（batch17）"}],"outgoing":["a3348ed9eb6fb4e3","815e63e5071e7b58","9375de7089953a2b","0578a357a86e9d8f","36d7463d215be751"]}