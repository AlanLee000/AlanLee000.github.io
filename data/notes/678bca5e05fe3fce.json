,\\mathbb P,E,\\mathcal E,\\vec X)\\leftrightarrow\\mathrm{MeasureSpace}_S(\\Omega,\\mathcal F,\\mathbb P)\\land\\mathbb P(\\Omega)=1\\land\\mathrm{Function}(\\vec X,\\omega,\\mathcal P(\\Omega\\times E))\\land\\forall k\\in\\omega\\;\\bigl(\\mathrm{Function}(\\vec X(k),\\Omega,E)\\land\\mathrm{Measurable}_S(\\vec X(k);(\\Omega,\\mathcal F),(E,\\mathcal E))\\bigr)\\land\\forall n\\in\\omega\\setminus\\{0\\}\\;\\exists\\mathcal C_n\\subseteq\\mathcal P(E^n)\\;\\Bigl(\\mathrm{FiniteProductSigma}_S(\\mathcal C_n,E,\\mathcal E,n)\\land\\forall\\pi\\in V\\;\\bigl(\\mathrm{Bijective}(\\pi,n,n)\\to\\forall C\\in\\mathcal C_n\\;\\bigl(\\mathbb P(\\{u\\in\\Omega:\\langle\\vec X(0)(u),\\ldots,\\vec X(n-1)(u)\\rangle\\in C\\})=\\mathbb P(\\{u\\in\\Omega:\\langle\\vec X(\\pi(0))(u),\\ldots,\\vec X(\\pi(n-1))(u)\\rangle\\in C\\})\\bigr)\\bigr)\\Bigr)","display":true}],"bytes":2745,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3192","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-df-zfc-prob4-exchangeable-sequence.md|58-df-zfc-prob4-exchangeable-sequence]]（batch20）"}],"outgoing":["83a15c7e9b3817dc","bbbec05fde1d3b01","7f96c502a4a99a46","36d7463d215be751","d583890235faf0d5"]}