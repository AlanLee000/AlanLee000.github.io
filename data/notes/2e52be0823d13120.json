,\\\n\\forall C\\in\\Gamma\\ ⟦ C⟧_v^{\\Pi}=1,\\\n⟦ A⟧_v^{\\Pi}\\ne1\\}.","display":true},{"tex":"\\mathsf{Fail}_{\\Pi}(\\Gamma,A)\n=\\{v:(\\Gamma,A,v)\\in\\mathsf{Cex}_{\\Pi}\\},\n\\qquad\n\\mathsf{SemCert}_{\\Pi}(\\Gamma,A)\n=\n\\begin{cases}\n\\{\\star\\},&\\mathsf{Fail}_{\\Pi}(\\Gamma,A)=\\varnothing,\\\\\n\\varnothing,&\\mathsf{Fail}_{\\Pi}(\\Gamma,A)\\ne\\varnothing.\n\\end{cases}","display":true},{"tex":"\\mathsf{Rule}^{\\operatorname{proof}}_{\\Pi}\n\\subseteq\\mathsf{Fm}_{\\Pi}^{<\\omega}\\times\\mathsf{Fm}_{\\Pi},\n\\qquad \\mathsf{Rule}^{\\operatorname{proof}}_{\\Pi}=\\varnothing.","display":true},{"tex":"\\mathcal S_{\\Pi}\n=\n\\bigl(\n\\mathsf{Prop},\n\\mathsf{Fm}_{\\Pi},\n\\operatorname{PV}_{\\Pi},\n\\operatorname{FV}_{\\Pi},\n\\operatorname{BV}_{\\Pi},\n\\mathsf{Subst}_{\\Pi},\n\\operatorname{Ext}_{\\Pi},\n\\operatorname{Sub}_{\\Pi},\n\\equiv_{\\alpha,\\Pi},\n\\mathsf V_{\\Pi},\n\\mathsf D_{\\Pi},\nT_{\\Pi},\nI_{\\Pi},\nM_{\\Pi},\nJ_{\\Pi},\nN_{\\Pi},\n\\mathsf{Val}_{\\Pi},\n⟦-⟧^{\\Pi},\n\\mathsf{Valid}_{\\Pi},\n\\models_{\\Pi},\n\\mathsf{Cex}_{\\Pi},\n\\mathsf{Fail}_{\\Pi},\n\\mathsf{SemCert}_{\\Pi},\n\\mathsf{Rule}^{\\operatorname{proof}}_{\\Pi}\n\\bigr).","display":true},{"tex":"\\models_{\\Pi}","display":false}],"bytes":6405,"backlinks":[],"outgoing":[]}