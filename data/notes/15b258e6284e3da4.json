be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"a9132c2c1a18acd1\" href=\"?note=a9132c2c1a18acd1\" title=\"../batch19/58-df-zfc-transitive-model.md\">../batch19/58-df-zfc-transitive-model.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"b5833df5ef175153\" href=\"?note=b5833df5ef175153\" title=\"../batch15/58-df-zfc-forcing2-forcing-poset.md\">../batch15/58-df-zfc-forcing2-forcing-poset.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"911508dbd8495663\" href=\"?note=911508dbd8495663\" title=\"../batch14/58-df-zfc-forcing-relation.md\">../batch14/58-df-zfc-forcing-relation.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"ec28b62254928d73\" href=\"?note=ec28b62254928d73\" title=\"../batch07/58-df-name.md\">../batch07/58-df-name.md</a></span><span><a class=\"wiki-link\" id=\"ref-8\" data-note=\"65418b505fc53093\" href=\"?note=65418b505fc53093\" title=\"../batch17/58-df-formula.md\">../batch17/58-df-formula.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}}\\in V\">\\(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}}\\in V\\)</span> (set ground model, length, stage forcings, and iterand-name sequence)</li>\n<li><span class=\"math-inline\" data-tex=\"\\vec{\\mathbb P}(\\alpha)=\\langle P_\\alpha,\\leq_\\alpha,\\varnothing\\rangle\">\\(\\vec{\\mathbb P}(\\alpha)=\\langle P_\\alpha,\\leq_\\alpha,\\varnothing\\rangle\\)</span> and <span class=\"math-inline\" data-tex=\"\\vec{\\dot{\\mathbb Q}}(\\alpha)=\\langle\\dot Q_\\alpha,\\dot\\leq_\\alpha,\\dot1_\\alpha\\rangle\">\\(\\vec{\\dot{\\mathbb Q}}(\\alpha)=\\langle\\dot Q_\\alpha,\\dot\\leq_\\alpha,\\dot1_\\alpha\\rangle\\)</span>; the empty function is the top condition at every iteration stage.</li>\n<li><span class=\"math-inline\" data-tex=\"\\varphi_{\\mathrm{fn}},\\varphi_\\in,\\varphi_{\\leq}\\in\\mathrm{Fml}_S(\\Sigma_\\in)\">\\(\\varphi_{\\mathrm{fn}},\\varphi_\\in,\\varphi_{\\leq}\\in\\mathrm{Fml}_S(\\Sigma_\\in)\\)</span> (fixed codes saying that three parameters form a forcing notion, that <span class=\"math-inline\" data-tex=\"v_0\\in v_1\">\\(v_0\\in v_1\\)</span>, and that <span class=\"math-inline\" data-tex=\"\\langle v_0,v_1\\rangle\\in v_2\">\\(\\langle v_0,v_1\\rangle\\in v_2\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ordinal}\">\\(\\mathrm{Ordinal}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (set-ordinal and set-coded function predicates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{TransitiveModel}_S\">\\(\\mathrm{TransitiveModel}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcing2ForcingPoset}_S\">\\(\\mathrm{ZfcForcing2ForcingPoset}_S\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathrm{Name}\">\\(\\mathrm{Name}\\)</span>, and <span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcingRelation}_S\">\\(\\mathrm{ZfcForcingRelation}_S\\)</span> (ground-model, forcing-poset, name, and six-argument forcing predicates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{FiniteSupportIteration}_S\\subseteq V^4\">\\(\\mathrm{FiniteSupportIteration}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcingFiniteSupportIteration}_S,\\mathrm{ZfcForcing8FiniteSupportIteration}_S,\\mathrm{ZfcForcing11FiniteSupportIteration}_S\\subseteq V^4\">\\(\\mathrm{ZfcForcingFiniteSupportIteration}_S,\\mathrm{ZfcForcing8FiniteSupportIteration}_S,\\mathrm{ZfcForcing11FiniteSupportIteration}_S\\subseteq V^4\\)</span> (alias predicates defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration}\\vdash\n\\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\\\\n&amp;\\quad\\leftrightarrow\n\\mathrm{TransitiveModel}_S(M)\n\\land\\mathrm{Ordinal}(\\delta)\n\\land\\mathrm{Function}(\\vec{\\mathbb P},\\delta+1,\\operatorname{ran}(\\vec{\\mathbb P}))\n\\land\\mathrm{Function}(\\vec{\\dot{\\mathbb Q}},\\delta,\\operatorname{ran}(\\vec{\\dot{\\mathbb Q}}))\\\\\n&amp;\\qquad\\land\\forall\\beta\\in\\delta\\;\\exists P_\\beta,\\leq_\\beta,\n\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\in M\\;\\Bigl[\n\\vec{\\mathbb P}(\\beta)=\\langle P_\\beta,\\leq_\\beta,\\varnothing\\rangle\n\\land\\vec{\\dot{\\mathbb Q}}(\\beta)=\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle\\\\\n&amp;\\hspace{33mm}\\land\\forall\\sigma\\in\\{\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\}\\;\\mathrm{Name}(\\sigma,P_\\beta)\n\\land\\mathrm{ZfcForcingRelation}_S\n(M,\\varnothing,\\varphi_{\\mathrm{fn}},\n\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle,P_\\beta,\\leq_\\beta)\n\\Bigr]\\\\\n&amp;\\qquad\\land\\forall\\alpha\\in\\delta+1\\;\\exists P_\\alpha,\\leq_\\alpha\\in M\\;\\Biggl[\n\\vec{\\mathbb P}(\\alpha)=\\langle P_\\alpha,\\leq_\\alpha,\\varnothing\\rangle\n\\land\\mathrm{ZfcForcing2ForcingPoset}_S(P_\\alpha,\\leq_\\alpha,\\varnothing)\\\\\n&amp;\\hspace{27mm}\\land P_\\alpha=\\Bigl\\{p\\in\\mathcal P(\\alpha\\times M):\n\\mathrm{Function}(p,\\operatorname{dom}(p),M)\n\\land\\operatorname{dom}(p)\\subseteq\\alpha\n\\land|\\operatorname{dom}(p)|&lt;\\omega\\\\\n&amp;\\hspace{47mm}\\land\\forall\\beta\\in\\operatorname{dom}(p)\\;\\exists P_\\beta,\\leq_\\beta,\n\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\in M\\;\\Bigl(\n\\vec{\\mathbb P}(\\beta)=\\langle P_\\beta,\\leq_\\beta,\\varnothing\\rangle\\\\\n&amp;\\hspace{61mm}\\land\\vec{\\dot{\\mathbb Q}}(\\beta)=\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle\n\\land p\\upharpoonright\\beta\\in P_\\beta\n\\land\\mathrm{Name}(p(\\beta),P_\\beta)\\\\\n&amp;\\hspace{61mm}\\land\\mathrm{ZfcForcingRelation}_S\n(M,p\\upharpoonright\\beta,\\varphi_\\in,\n\\langle p(\\beta),\\dot Q_\\beta\\rangle,P_\\beta,\\leq_\\beta)\n\\Bigr)\\Bigr\\}\\\\\n&amp;\\hspace{27mm}\\land\\forall p,q\\in P_\\alpha\\;\\Bigl(\nq\\leq_\\alpha p\\leftrightarrow\n\\operatorname{dom}(p)\\subseteq\\operatorname{dom}(q)\\\\\n&amp;\\hspace{47mm}\\land\\forall\\beta\\in\\operatorname{dom}(p)\\;\\exists P_\\beta,\\leq_\\beta,\n\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\in M\\;\\Bigl(\n\\vec{\\mathbb P}(\\beta)=\\langle P_\\beta,\\leq_\\beta,\\varnothing\\rangle\\\\\n&amp;\\hspace{61mm}\\land\\vec{\\dot{\\mathbb Q}}(\\beta)=\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle\n\\land\\mathrm{ZfcForcingRelation}_S\n(M,q\\upharpoonright\\beta,\\varphi_{\\leq},\n\\langle q(\\beta),p(\\beta),\\dot\\leq_\\beta\\rangle,P_\\beta,\\leq_\\beta)\n\\Bigr)\\Bigr)\n\\Biggr].\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration}\\vdash\n\\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\\\\n&amp;\\quad\\leftrightarrow\n\\mathrm{TransitiveModel}_S(M)\n\\land\\mathrm{Ordinal}(\\delta)\n\\land\\mathrm{Function}(\\vec{\\mathbb P},\\delta+1,\\operatorname{ran}(\\vec{\\mathbb P}))\n\\land\\mathrm{Function}(\\vec{\\dot{\\mathbb Q}},\\delta,\\operatorname{ran}(\\vec{\\dot{\\mathbb Q}}))\\\\\n&amp;\\qquad\\land\\forall\\beta\\in\\delta\\;\\exists P_\\beta,\\leq_\\beta,\n\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\in M\\;\\Bigl[\n\\vec{\\mathbb P}(\\beta)=\\langle P_\\beta,\\leq_\\beta,\\varnothing\\rangle\n\\land\\vec{\\dot{\\mathbb Q}}(\\beta)=\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle\\\\\n&amp;\\hspace{33mm}\\land\\forall\\sigma\\in\\{\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\}\\;\\mathrm{Name}(\\sigma,P_\\beta)\n\\land\\mathrm{ZfcForcingRelation}_S\n(M,\\varnothing,\\varphi_{\\mathrm{fn}},\n\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle,P_\\beta,\\leq_\\beta)\n\\Bigr]\\\\\n&amp;\\qquad\\land\\forall\\alpha\\in\\delta+1\\;\\exists P_\\alpha,\\leq_\\alpha\\in M\\;\\Biggl[\n\\vec{\\mathbb P}(\\alpha)=\\langle P_\\alpha,\\leq_\\alpha,\\varnothing\\rangle\n\\land\\mathrm{ZfcForcing2ForcingPoset}_S(P_\\alpha,\\leq_\\alpha,\\varnothing)\\\\\n&amp;\\hspace{27mm}\\land P_\\alpha=\\Bigl\\{p\\in\\mathcal P(\\alpha\\times M):\n\\mathrm{Function}(p,\\operatorname{dom}(p),M)\n\\land\\operatorname{dom}(p)\\subseteq\\alpha\n\\land|\\operatorname{dom}(p)|&lt;\\omega\\\\\n&amp;\\hspace{47mm}\\land\\forall\\beta\\in\\operatorname{dom}(p)\\;\\exists P_\\beta,\\leq_\\beta,\n\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\in M\\;\\Bigl(\n\\vec{\\mathbb P}(\\beta)=\\langle P_\\beta,\\leq_\\beta,\\varnothing\\rangle\\\\\n&amp;\\hspace{61mm}\\land\\vec{\\dot{\\mathbb Q}}(\\beta)=\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle\n\\land p\\upharpoonright\\beta\\in P_\\beta\n\\land\\mathrm{Name}(p(\\beta),P_\\beta)\\\\\n&amp;\\hspace{61mm}\\land\\mathrm{ZfcForcingRelation}_S\n(M,p\\upharpoonright\\beta,\\varphi_\\in,\n\\langle p(\\beta),\\dot Q_\\beta\\rangle,P_\\beta,\\leq_\\beta)\n\\Bigr)\\Bigr\\}\\\\\n&amp;\\hspace{27mm}\\land\\forall p,q\\in P_\\alpha\\;\\Bigl(\nq\\leq_\\alpha p\\leftrightarrow\n\\operatorname{dom}(p)\\subseteq\\operatorname{dom}(q)\\\\\n&amp;\\hspace{47mm}\\land\\forall\\beta\\in\\operatorname{dom}(p)\\;\\exists P_\\beta,\\leq_\\beta,\n\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\in M\\;\\Bigl(\n\\vec{\\mathbb P}(\\beta)=\\langle P_\\beta,\\leq_\\beta,\\varnothing\\rangle\\\\\n&amp;\\hspace{61mm}\\land\\vec{\\dot{\\mathbb Q}}(\\beta)=\\langle\\dot Q_\\beta,\\dot\\leq_\\beta,\\dot1_\\beta\\rangle\n\\land\\mathrm{ZfcForcingRelation}_S\n(M,q\\upharpoonright\\beta,\\varphi_{\\leq},\n\\langle q(\\beta),p(\\beta),\\dot\\leq_\\beta\\rangle,P_\\beta,\\leq_\\beta)\n\\Bigr)\\Bigr)\n\\Biggr].\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration} \\vdash \\mathrm{ZfcForcingFiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\leftrightarrow \\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration} \\vdash \\mathrm{ZfcForcingFiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\leftrightarrow \\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration} \\vdash \\mathrm{ZfcForcing8FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\leftrightarrow \\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration} \\vdash \\mathrm{ZfcForcing8FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\leftrightarrow \\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration} \\vdash \\mathrm{ZfcForcing11FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\leftrightarrow \\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}finite\\text{-}support\\text{-}iteration} \\vdash \\mathrm{ZfcForcing11FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\leftrightarrow \\mathrm{FiniteSupportIteration}_S(M,\\delta,\\vec{\\mathbb P},\\vec{\\dot{\\mathbb Q}})\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Conditions are finite partial functions. At coordinate <span class=\"math-inline\" data-tex=\"\\beta\">\\(\\beta\\)</span>, the earlier restriction <span class=\"math-inline\" data-tex=\"p\\upharpoonright\\beta\">\\(p\\upharpoonright\\beta\\)</span> forces the chosen name to belong to the named iterand; the order is the standard coordinatewise forced order.</li>\n<li>The empty function is the top condition at every stage. The simultaneous recursion over set ordinals defines all carriers and orders without an undefined <span class=\"math-inline\" data-tex=\"\\operatorname{ForcingIteration}\">\\(\\operatorname{ForcingIteration}\\)</span> predicate or the unrelated topological notion of support.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a33c2","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-ordinal.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be7