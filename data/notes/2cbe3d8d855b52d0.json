":false},{"tex":"\\mathbf{Ctx}_\\Sigma","display":false},{"tex":"\\sigma","display":false},{"tex":"r_\\sigma","display":false},{"tex":"\\mathbf{Set}_{\\mathcal U}","display":false},{"tex":"\\begin{aligned}\nA\\sim^\\Gamma_T B&\\Longleftrightarrow\\Gamma\\vdash_\\Sigma A=B:\\mathsf{Ty},\\\\\nt\\sim^{\\Gamma,A}_t u&\\Longleftrightarrow\\Gamma\\vdash_\\Sigma t=u:A,\\\\\nO_G&\\coloneqq\\{(\\Gamma,a)\\mid\\Gamma\\in\\operatorname{Ob}\\mathbf{Ctx}_\\Sigma\\land a\\in\\operatorname{Ty}_\\Sigma(\\Gamma)\\},\\\\\nM_G&\\coloneqq\\{\\langle(\\Delta,b),(\\Gamma,a),\\sigma\\rangle\\mid\n(\\Delta,b),(\\Gamma,a)\\in O_G\\land\\sigma\\in\\mathbf{Ctx}_\\Sigma(\\Delta,\\Gamma)\n\\land b=r^T_\\sigma(a)\\},\\\\\ns_G\\langle U,V,\\sigma\\rangle&\\coloneqq U,\\qquad t_G\\langle U,V,\\sigma\\rangle\\coloneqq V,\\\\\ne_G(\\Gamma,a)&\\coloneqq\\langle(\\Gamma,a),(\\Gamma,a),\\operatorname{id}_\\Gamma\\rangle,\\\\\nc_G(\\langle V,W,\\tau\\rangle,\\langle U,V,\\sigma\\rangle)&\\coloneqq\\langle U,W,\\tau\\circ\\sigma\\rangle,\\\\\n\\mathcal G_\\Sigma&\\coloneqq\\langle O_G,M_G,s_G,t_G,e_G,c_G\\rangle,\\qquad\n\\textstyle\\int\\operatorname{Ty}_\\Sigma\\coloneqq\\mathcal G_\\Sigma,\\\\\n\\mathrm{Cat}(\\mathcal G_\\Sigma)&.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n(\\operatorname{Tm}_\\Sigma)_0(\\Gamma,[A])&\\coloneqq\n\\{t\\in\\mathsf{RawTm}\\mid\\Gamma\\vdash_\\Sigma t:A\\}/{\\sim^{\\Gamma,A}_t},\\\\\nr_\\sigma([t])&\\coloneqq[t[\\vec a]]\n\\quad\\bigl(\\sigma=\\langle\\Delta,\\Gamma,[\\vec a]\\rangle\\bigr),\\\\\n(\\operatorname{Tm}_\\Sigma)_1\\langle U,V,\\sigma\\rangle&\\coloneqq\n\\bigl\\langle(\\operatorname{Tm}_\\Sigma)_0V,(\\operatorname{Tm}_\\Sigma)_0U,r_\\sigma\\bigr\\rangle,\\\\\n\\operatorname{Tm}_\\Sigma&\\coloneqq\\langle(\\operatorname{Tm}_\\Sigma)_0,(\\operatorname{Tm}_\\Sigma)_1\\rangle,\\\\\n\\mathrm{Functor}(\\operatorname{Tm}_\\Sigma,\\mathcal G_\\Sigma^{\\mathrm{op}},\\mathbf{Set}_{\\mathcal U})&.\n\\end{aligned}","display":true},{"tex":"A","display":fals