ists\\alpha\\in\\kappa\\;\n\\bigl(U=\\{X\\subseteq\\kappa\\mid\\alpha\\in X\\}\\bigr)\\\\\n&{}\\land\\forall\\lambda<\\kappa\\;\\forall F\\;\n\\left(\\mathrm{Function}(F,\\lambda,U)\n\\to\\{\\alpha\\in\\kappa\\mid\\forall\\xi\\in\\lambda\\;(\\alpha\\in F(\\xi))\\}\\in U\\right).\n\\end{aligned}","display":true},{"tex":"\\kappa","display":false},{"tex":"\\lambda=0","display":false},{"tex":"\\kappa\\in U","display":false}],"bytes":1646,"backlinks":[{"id":"ccdb3aca529813a9","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"4cf9725e6800030d","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcLcMeasurableCardinalUltrafilter}_S\\subseteq V^2$ (see [[58-df-zfc-lc-measurable-cardinal-ultrafilter.md]])"},{"id":"69ebe15818f1e306","anchor":"ref-6","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-2452","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-lc-measurable-cardinal-ultrafilter.md|58-df-zfc-lc-measurable-cardinal-ultrafilter]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","5fb1c2241d1943d1","5e8b8d97b21dd8e8","36d7463d215be751"]}