\setminus N\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\n\\exists n_0\\in\\omega\\;\\forall n\\in\\omega\\\\\n&\\hspace{9em}{}\\bigl(n\\geq n_0\\land n\\neq0\n\\to |A(n)(x)-g(x)|<\\varepsilon\\bigr)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}time\\text{-}average\\text{-}ergodic}\\vdash{}&\n\\operatorname{ProbabilitySpace}(X,\\mathcal F,\\mu)\n\\land\\mathrm{Ergodic}_S(T,\\mu,X,\\mathcal F)\n\\land\\mathrm{TimeAverageSequence}_S(A,f,T,X)\\\\\n&{}\\land\\exists g\\in V\\;\\operatorname{CondExp}_S(g,f,\\mathcal F,X,\\mathcal F,\\mu)\\\\\n\\to{}&\n\\exists N\\in\\mathcal F\\;\\Bigl(\n\\mu(N)=0\\land\n\\forall x\\in X\\setminus N\\;\\forall\\varepsilon\\in\\mathbb R_{>0}\\;\n\\exists n_0\\in\\omega\\;\\forall n\\in\\omega\\\\\n&\\hspace{8em}{}\\bigl(n\\geq n_0\\land n\\neq0\n\\to |A(n)(x)-\\textstyle\\int_Xf\\,d\\mu|<\\varepsilon\\bigr)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\varepsilon","display":false},{"tex":"n_0","display":false},{"tex":"\\mathrm{MeasPreserving}_S(T,\\mu,X,\\mathcal F)","display":false},{"tex":"\\mathrm{Ergodic}_S(T,\\mu,X,\\mathcal F)","display":false},{"tex":"L^1","display":false}],"bytes":3119,"backlinks":[{"id":"8160ac3d14bcbf65","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"a11585cba9c21cfd","anchor":"ref-352","locations":["正文"],"count":1,"excerpt":"[[58-df-time-average]]"},{"id":"84daad544872cc71","anchor":"ref-1295","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-time-average.md|58-df-time-average]]（batch10）"}],"outgoing":["0578a357a86e9d8f","785c80475c01fc69","52ad543842bcb570","36d7463d215be751"]}