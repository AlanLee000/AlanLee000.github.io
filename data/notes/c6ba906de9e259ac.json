\omega\\;(A(n+1)\\subseteq A(n))\\\\\n&\\hspace{8em}\\land\\forall n\\in\\omega\\;\nA(2n)=\\sigma(A\\upharpoonright2n)\n\\to\\bigcap\\operatorname{ran}(A)=\\varnothing\n\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}ideal6\\text{-}precipitous\\text{-}ideal}\\vdash\n\\mathrm{ZfcIdeal6PrecipitousIdeal}_S(X,\\mathcal I)\n\\leftrightarrow\n\\operatorname{Ideal}(\\mathcal I,\\mathcal P(X))\\land X\\notin\\mathcal I\n\\land\\neg\\exists\\sigma\\in V\\;\n\\mathrm{IdealGameEmptyWinningStrategy}_S(\\sigma,X,\\mathcal I).","display":true},{"tex":"X","display":false},{"tex":"\\mathcal I","display":false},{"tex":"V","display":false}],"bytes":2681,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2294","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-ideal6-precipitous-ideal.md|58-df-zfc-ideal6-precipitous-ideal]]（batch03）"}],"outgoing":["a3348ed9eb6fb4e3","6e4f95381faac4f9","36d7463d215be751","f4bf86f66c1444da"]}