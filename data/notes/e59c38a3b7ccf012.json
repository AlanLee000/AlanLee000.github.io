{REAx}_{S,g}(T)\\land\\operatorname{Con}^{\\mathrm{meta}}(T)\\land \\operatorname{Ax}(Q)\\subseteq T\n\\land\\mathrm{RosserSent}_T(R)\n\\Bigr)\n\\Longrightarrow\n\\bigl(T\\nvdash R\\land T\\nvdash\\neg R\\bigr).","display":true},{"tex":"T\\vdash R","display":false},{"tex":"p_0","display":false},{"tex":"T\\vdash\\mathrm{Prf}_T(\\bar p_0,\\overline{g(R)})","display":false},{"tex":"\\neg R","display":false},{"tex":"q\\le p_0","display":false},{"tex":"Q","display":false},{"tex":"\\neg\\mathrm{Prf}_T(\\bar q,\\overline{g(\\neg R)})","display":false},{"tex":"T\\vdash\\forall q\\le\\bar p_0\\,\\neg\\mathrm{Prf}_T(q,\\overline{g(\\neg R)})","display":false},{"tex":"R","display":false},{"tex":"T\\nvdash R","display":false},{"tex":"T\\vdash\\neg R","display":false},{"tex":"q_0","display":false},{"tex":"p<q_0","display":false},{"tex":"R","display":false},{"tex":"Q","display":false},{"tex":"Q\\vdash\\mathrm{Prf}_T(\\bar q_0,\\overline{g(\\neg R)})","display":false},{"tex":"Q","display":false},{"tex":"p","display":false},{"tex":"\\bar q_0","display":false},{"tex":"\\bar q_0\\le p","display":false},{"tex":"q=\\bar q_0","display":false},{"tex":"T","display":false},{"tex":"R","display":false},{"tex":"\\omega","display":false},{"tex":"R","display":false}],"bytes":2614,"backlinks":[{"id":"32c1f47762a7f658","anchor":"ref-138","locations":["正文"],"count":1,"excerpt":"[[90-prop-creative-complete.md]]\n[[90-prop-essential-undecidable-implies.md]]\n[[90-prop-kolmogorov-non-computable.md]]\n[[90-prop-kolmogorov-unbounded.md]]\n[[90-prop-omega-consistent-stronger.md]]\n[[90-prop-representability-criterion.md]]\n[[90-prop-rosser-sentence.md]]\n[[90-prop-simple-immune.md]]"}],"outgoing":["b7bcf1e41c4a9fc9","7c51b51998a67f02","8c071ce52fa72de0","4e89323a1592aeb9","b7d7a03ff76428de","002c574215686062","25356da0f2b0b22e","278a6c2cfc6160a3","635265d0fe56f718"]}