{"id":"3e2ce4e4d23a0ce2","group":"27","path":"27/27-df-piset.md","title":"Prime-implicant set","display":"df-piset — Prime-implicant set","type":"definition","metadata":{"type":"definition","book":"Boolean Functions: Theory, Algorithms, and Applications","book_abbrev":"27","label":"27-df-piset","aliases":["27-df-piset"],"display":"df-piset — Prime-implicant set","depends_on":["[[27-df-primeimp]]","[[27-df-impset]]"],"local_review_status":"2026-10-20-formalization-reviewed-source-text-not-rechecked"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Boolean Functions: Theory, Algorithms, and Applications"},{"key":"book_abbrev","html":"27"},{"key":"label","html":"27-df-piset"},{"key":"aliases","html":"<div class=\"property-array\"><span>27-df-piset</span></div>"},{"key":"display","html":"df-piset — Prime-implicant set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"5b52f2915b942520\" href=\"?note=5b52f2915b942520\" title=\"27-df-primeimp\">27-df-primeimp</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"e9e30bad3bbd56ff\" href=\"?note=e9e30bad3bbd56ff\" title=\"27-df-impset\">27-df-impset</a></span></div>"},{"key":"local_review_status","html":"2026-10-20-formalization-reviewed-source-text-not-rechecked"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"n\\in\\mathbb N\">\\(n\\in\\mathbb N\\)</span>。</li>\n<li><span class=\"math-inline\" data-tex=\"f\\in\\mathrm{BoolFunc}_n\">\\(f\\in\\mathrm{BoolFunc}_n\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{PrimeImp}\">\\(\\mathrm{PrimeImp}\\)</span> (prime-implicant relation, see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"5b52f2915b942520\" href=\"?note=5b52f2915b942520\" title=\"27-df-primeimp\">27-df-primeimp</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Imp}(f)\">\\(\\mathrm{Imp}(f)\\)</sp