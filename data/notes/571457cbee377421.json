{Sent}_2\\ (\\tau_{O,r}(A)\\in\\mathrm{Th}(\\mathrm{An}))\\\\\n&\\Longleftrightarrow\\forall r:\\mathrm{Prop}\\to\\mathrm{Sent}_2\\ (\\tau_{O,r}(A)\\in\\mathrm{Th}(\\mathrm{An}_\\omega)).\n\\end{aligned}","display":true},{"tex":"\\omega","display":false},{"tex":"O","display":false},{"tex":"O","display":false},{"tex":"\\Pi^1_1","display":false}],"bytes":2341,"backlinks":[{"id":"43a8d98c9b5fc94d","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"05a599f85e508061","anchor":"ref-60","locations":["正文"],"count":1,"excerpt":"[[89-thm-analysis-omega-completeness]]"},{"id":"e0c421a5b45aeb77","anchor":"ref-187","locations":["正文"],"count":2,"excerpt":"[[89-df-omega-rule]] → [[89-df-analysis-omega-theory]] → [[89-thm-analysis-omega-completeness]]"}],"outgoing":["508219e8b4c7dadf","0006800fa1c85177","d0116d2c9f5af20f","8ab645f955c77848"]}