\\mathrm{Continuous}_S(H,U\\times[0,1],\\tau_{U\\times I},X,\\mathcal T)\\\\\n&\\quad\\land\\forall u\\in U\\;\\bigl(H(\\langle u,0\\rangle)=u\\land H(\\langle u,1\\rangle)=x_0\\bigr)\n\\Bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}categorical\\text{-}cover}\\vdash\n\\mathrm{CategoricalCover}_S(m,X,\\mathcal T)\n\\leftrightarrow m\\in\\omega\\setminus\\{0\\}\\land\\exists U\\in V\\;\\Bigl(\n\\operatorname{Function}(U,m,\\mathcal T)\n\\land X=\\bigcup_{i\\in m}U(i)\n\\land\\forall i\\in m\\;\\operatorname{ContractibleIn}_S(U(i),X,\\mathcal T)\\Bigr).","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}ls\\text{-}category} \\vdash\n\\mathrm{LSCategory}_S(k,X,\\mathcal T)\\leftrightarrow\n\\operatorname{TopologicalSpace}_S(X,\\mathcal T)\\land\\Bigl[\\\\\n&\\quad\\bigl(k\\in\\omega\\setminus\\{0\\}\\land\\mathrm{CategoricalCover}_S(k,X,\\mathcal T)\n\\land\\forall m\\in k\\setminus\\{0\\}\\;\\neg\\mathrm{CategoricalCover}_S(m,X,\\mathcal T)\\bigr)\\\\\n&\\quad\\lor\\bigl(k=\\infty\\land\\forall m\\in\\omega\\setminus\\{0\\}\\;\n\\neg\\mathrm{CategoricalCover}_S(m,X,\\mathcal T)\\bigr)\\Bigr].\n\\end{aligned}","display":true},{"tex":"\\infty","display":false},{"tex":"\\mathrm{cat}(X) \\leq \\dim(X) + 1","display":false},{"tex":"\\mathrm{cat}(X) \\geq \\operatorname{cuplength}(X)+1","display":false},{"tex":"\\mathrm{cat}(\\mathbb{R}^n) = 1","display":false},{"tex":"\\mathrm{cat}(S^n) = 2","display":false},{"tex":"\\infty","display":false}],"bytes":3491,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-803","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-ls-category.md|58-df-ls-category]]（batch01）"}],"outgoing":["3b5b3d48ff1ff369","815e63e5071e7b58","36d7463d215be751","3cd1834de4f2efb2","ca7fc3ab38a11801"]}