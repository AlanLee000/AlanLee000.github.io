{"id":"9ac97ecaeb21258a","group":"58","path":"58/batch13/58-df-zfc-top5-closure.md","title":"ZFC Top5 Closure","display":"df-zfc-top5-closure — ZFC Top5 Closure","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-top5-closure","aliases":["58-df-zfc-top5-closure"],"display":"df-zfc-top5-closure — ZFC Top5 Closure","depends_on":["[[../batch12/58-df-zfc-top5-closed-set.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-top5-closure"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-top5-closure</span></div>"},{"key":"display","html":"df-zfc-top5-closure — ZFC Top5 Closure"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4dc8b2d2e69010a2\" href=\"?note=4dc8b2d2e69010a2\" title=\"../batch12/58-df-zfc-top5-closed-set.md\">../batch12/58-df-zfc-top5-closed-set.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,\\tau,A,C\\in V\">\\(X,\\tau,A,C\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5ClosedSet}_S\\subseteq V^3\">\\(\\mathrm{ZfcTop5ClosedSet}_S\\subseteq V^3\\)</span> (closed set predicate, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"4dc8b2d2e69010a2\" href=\"?note=4dc8b2d2e69010a2\" title=\"../batch12/58-df-zfc-top5-closed-set.md\">../batch12/58-df-zfc-top5-closed-set.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5Closure}_S\\subseteq V^4\">\\(\\mathrm{ZfcTop5Closure}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top5\\text{-}closure} \\vdash \\mathrm{ZfcTop5Closure}_S(X,\\tau,A,C)\\leftrightarrow A\\subseteq X\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,X)\\land C=\\bigcap\\{F\\subseteq X:A\\subseteq F\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,F)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top5\\text{-}closure} \\vdash \\mathrm{ZfcTop5Closure}_S(X,\\tau,A,C)\\leftrightarrow A\\subseteq X\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,X)\\land C=\\bigcap\\{F\\subseteq X:A\\subseteq F\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,F)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The closure is the intersection of all closed supersets.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch12/58-df-zfc-top5-closed-set.md","status":"resolved","id":"4dc8b2d2e69010a2","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch12/58-df-zfc-top5-closed-set.md]]","embed":false},{"target":"../batch12/58-df-zfc-top5-closed-set.md","status":"resolved","id":"4dc8b2d2e69010a2","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{ZfcTop5ClosedSet}_S\\subseteq V^3$ (closed set predicate, see [[../batch12/58-df-zfc-top5-closed-set.md]])","embed":false}],"math":[{"tex":"X,\\tau,A,C\\in V","display":false},{"tex":"\\mathrm{ZfcTop5ClosedSet}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcTop5Closure}_S\\subseteq V^4","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}top5\\text{-}closure} \\vdash \\mathrm{ZfcTop5Closure}_S(X,\\tau,A,C)\\leftrightarrow A\\subseteq X\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,X)\\land C=\\bigcap\\{F\\subseteq X:A\\subseteq F\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,F)\\}","display":true}],"bytes":856,"backlinks":[{"id":"d085bf2428c43bab","anchor":"ref-4","loc