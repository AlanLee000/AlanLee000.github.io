forall p\\in P\\;(\\langle m,p\\rangle\\in\\leq\\to p=m)","display":true}],"bytes":830,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2525","locations":["正文"],"count":1,"excerpt":"[[../batch13/58-df-zfc-maximal-element.md|58-df-zfc-maximal-element]]（batch13）"}],"outgoing":["a3348ed9eb6fb4e3","2aa29158e60b337f"]}