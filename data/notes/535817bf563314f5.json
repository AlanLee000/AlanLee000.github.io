atch02/58-df-supremum.md\">../batch02/58-df-supremum.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"30f7fa6c101bbb39\" href=\"?note=30f7fa6c101bbb39\" title=\"../batch18/58-df-limit-ordinal.md\">../batch18/58-df-limit-ordinal.md</a></span></div>"}],"html":"<h1 id=\"df-aleph-—-$\\aleph$-Numbers\">df-aleph — <span class=\"math-inline\" data-tex=\"\\aleph\">\\(\\aleph\\)</span> Numbers</h1>\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\alpha,\\beta,\\lambda\\in\\mathrm{Ord}\">\\(\\alpha,\\beta,\\lambda\\in\\mathrm{Ord}\\)</span> (ordinals, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"../batch17/58-df-ordinal.md\">../batch17/58-df-ordinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\omega\">\\(\\omega\\)</span> (the first infinite ordinal, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"5045d216c83e75cb\" href=\"?note=5045d216c83e75cb\" title=\"../batch16/58-df-omega.md\">../batch16/58-df-omega.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Card}\">\\(\\mathrm{Card}\\)</span> (class of initial ordinals, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"a3838e99021ae044\" href=\"?note=a3838e99021ae044\" title=\"../batch13/58-df-cardinalclass.md\">../batch13/58-df-cardinalclass.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Limit}\">\\(\\mathrm{Limit}\\)</span> (limit-ordinal predicate, see <a class=\"wiki-link\" id=\"ref-10\" data-note=\"81cabbac7fa4d75d\" href=\"?note=81cabbac7fa4d75d\" title=\"../batch01/58-df-limitordinal.md\">../batch01/58-df-limitordinal.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\sup\">\\(\\sup\\)</span> (ordinal supremum, see <a class=\"wiki-link\" id=\"ref-11\" data-note=\"da76334bd8496c66\" href=\"?note=da76334bd8496c66\" title=\"../batch02/58-df-supremum.md\">../batch02/58-df-supremum.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\aleph_\\alpha\">\\(\\aleph_\\alpha\\)</span>（由下述超限递归定义的 aleph 类运算；不是集合函数 <span class=\"math-inline\" data-tex=\"\\mathrm{Ord}\\to\\mathrm{Card}\">\\(\\mathrm{Ord}\\to\\mathrm{Card}\\)</span>）</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}aleph} \\vdash \\left(\\forall\\alpha\\in\\mathrm{Ord}\\;\\aleph_\\alpha\\in\\mathrm{Card}\\right)\\land\\left(\n\\aleph_0=\\omega\n\\right)\\land\n\\left(\\forall\\alpha\\in\\mathrm{Ord}\\;\\aleph_{\\alpha+1}=\n\\min\\{\\kappa\\in\\mathrm{Card}:\\aleph_\\alpha&lt;\\kappa\\}\\right)\\land\n\\left(\\forall\\lambda\\in\\mathrm{Ord}\\;(\\mathrm{Limit}(\\lambda)\\to\n\\aleph_\\lambda=\\sup\\{\\aleph_\\beta:\\beta\\in\\lambda\\})\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}aleph} \\vdash \\left(\\forall\\alpha\\in\\mathrm{Ord}\\;\\aleph_\\alpha\\in\\mathrm{Card}\\right)\\land\\left(\n\\aleph_0=\\omega\n\\right)\\land\n\\left(\\forall\\alpha\\in\\mathrm{Ord}\\;\\aleph_{\\alpha+1}=\n\\min\\{\\kappa\\in\\mathrm{Card}:\\aleph_\\alpha&lt;\\kappa\\}\\right)\\land\n\\left(\\forall\\lambda\\in\\mathrm{Ord}\\;(\\mathrm{Limit}(\\lambda)\\to\n\\aleph_\\lambda=\\sup\\{\\aleph_\\beta:\\beta\\in\\lambda\\})\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><code>58-df-alephfunction</code> and <code>58-df-aleph-function</code> are merged here as aliases of the same transfinite recursion for <span class=\"math-inline\" data-tex=\"\\aleph_\\alpha\">\\(\\aleph_\\alpha\\)</span>.</li>\n</ul>\n","headings":[{"id":"df-aleph-—-$\\aleph$-Numbers","text":"df-aleph — $\\aleph$ Numbers","level":1},{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch17/58-df-ordinal.md","status":"resolved","id":"5582a281f15a