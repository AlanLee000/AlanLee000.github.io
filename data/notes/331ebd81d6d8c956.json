"\\bigvee_{\\leq}","display":false}],"bytes":1871,"backlinks":[{"id":"8ffdd76172ba4225","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-125","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-df-algebraic-lattice.md|58-df-algebraic-lattice]]（batch02）"}],"outgoing":["d3f859dbdd37f018"]}