^{\\varnothing\\mathrm{FO}}_{93}","display":false},{"tex":"\\Vdash^{\\varnothing\\mathrm{FO}}_{93}","display":false},{"tex":"\\mathsf L^{\\varnothing\\mathrm{FO}}_{93}","display":false},{"tex":"\\mathrm{ex\\text{-}nonalgebraizable}\\vdash\n\\mathcal L^{\\varnothing\\mathrm{FO}}_{93}\\coloneqq\n\\langle\\varnothing,\\varnothing,\\varnothing,\\varnothing,\\mathrm{Var}_{93}\\rangle,\n\\qquad\nF^{\\varnothing\\mathrm{FO}}_{93}\\coloneqq\n\\mathrm{FOSent}_{93}(\\mathcal L^{\\varnothing\\mathrm{FO}}_{93})","display":true},{"tex":"\\begin{aligned}\n\\mathrm{ex\\text{-}nonalgebraizable}\\vdash\n\\Vdash^{\\varnothing\\mathrm{FO}}_{93}\\coloneqq\n\\bigl\\{\\langle\\Gamma,\\varphi\\rangle\\in\n\\mathcal P(F^{\\varnothing\\mathrm{FO}}_{93})\\times F^{\\varnothing\\mathrm{FO}}_{93}:{}&\n\\forall\\mathfrak A\\;\\bigl(\n\\mathrm{FOStruct}_{93}(\\mathfrak A,\\mathcal L^{\\varnothing\\mathrm{FO}}_{93})\\\\\n&\\land\\mathfrak A\\models_{\\mathcal L^{\\varnothing\\mathrm{FO}}_{93}}\\Gamma\n\\to\\mathfrak A\\models_{\\mathcal L^{\\varnothing\\mathrm{FO}}_{93}}\\varphi\n\\bigr)\\bigr\\}.\n\\end{aligned}","display":true},{"tex":"\\mathrm{ex\\text{-}nonalgebraizable}\\vdash\n\\mathsf L^{\\varnothing\\mathrm{FO}}_{93}\\coloneqq\n\\langle F^{\\varnothing\\mathrm{FO}}_{93},\\Vdash^{\\varnothing\\mathrm{FO}}_{93}\\rangle","display":true},{"tex":"\\begin{aligned}\n\\mathrm{ex\\text{-}nonalgebraizable}\\vdash{}&\n\\mathrm{FOLang}_{93}(\\mathcal L^{\\varnothing\\mathrm{FO}}_{93})\n\\land F^{\\varnothing\\mathrm{FO}}_{93}\\cap\\mathrm{Var}_{93}=\\varnothing\n\\land\\mathrm{Var}_{93}\\neq\\varnothing\\\\\n&\\land\\forall S\\;\\forall\\alpha\\;\\Bigl(\n\\mathrm{SimilarityType}(S,\\alpha)\\to\nF^{\\varnothing\\mathrm{FO}}_{93}\\neq\nT_{\\langle S,\\alpha\\rangle}(\\mathrm{Var}_{93})\\Bigr)\\\\\n&\\land\\mathsf L^{\\varnothing\\mathrm{FO}}_{93}\\notin\\mathrm{AlgLog}.\n\\end{aligned}","display":true},{"tex":"T_{\\langle S,\\alpha\\rangle}(\\mathrm{Var}_{93})","display":false},{"tex":"\\mathrm{Var}_{9