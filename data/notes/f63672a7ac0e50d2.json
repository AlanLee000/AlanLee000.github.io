^*}^{(1)}$；$\\mathrm{Sent}_S$ 见 [[90-df-sentence]]，数码及其代入使用当前算术子语言。$\\mathrm{TruthDef}_{S,\\mathcal M,g}$ 在此固定环境内定义。","embed":false}],"math":[{"tex":"S\\subseteq S^*","display":false},{"tex":"S_{\\mathrm{arith}}\\subseteq S^*","display":false},{"tex":"\\sharp","display":false},{"tex":"S_{\\mathrm{arith}},\\mathcal N_{\\mathrm{arith}}","display":false},{"tex":"\\mathcal M=\\langle A,C,(F_n)_{n\\ge1},(R_n)_{n\\ge1}\\rangle","display":false},{"tex":"\\mathrm{Struct}_{(S^*)^\\sharp}(\\mathcal M)","display":false},{"tex":"\\mathcal M\\upharpoonright S_{\\mathrm{arith}}=\\mathcal N_{\\mathrm{arith}}","display":false},{"tex":"g:\\operatorname{Expr}(S)\\to\\mathbb N","display":false},{"tex":"d:\\mathbb N\\rightharpoonup\\operatorname{Expr}(S)","display":false},{"tex":"\\mathrm{GN}_{\\operatorname{Expr}(S)}(g,d)","display":false},{"tex":"\\tau(v)\\in\\mathrm{Fml}_{S^*}^{(1)}","display":false},{"tex":"\\mathrm{Sent}_S","display":false},{"tex":"\\mathrm{TruthDef}_{S,\\mathcal M,g}","display":false},{"tex":"\\begin{aligned}\n\\mathcal M\\upharpoonright S&\\coloneqq\n\\langle A,C\\upharpoonright C_S,(F_n\\upharpoonright F_S^n)_{n\\ge1},\n(R_n\\upharpoonright R_S^n)_{n\\ge1}\\rangle,\\\\\n\\mathcal M\\upharpoonright S_{\\mathrm{arith}}&\\coloneqq\n\\langle A,C\\upharpoonright C_{S_{\\mathrm{arith}}},\n(F_n\\upharpoonright F_{S_{\\mathrm{arith}}}^n)_{n\\ge1},\n(R_n\\upharpoonright R_{S_{\\mathrm{arith}}}^n)_{n\\ge1}\\rangle,\\\\\n\\mathrm{TruthDef}_{S,\\mathcal M,g}(\\tau)&\\ \\Longleftrightarrow\\\n\\forall\\sigma\\in\\mathrm{Sent}_S\\\n\\left(\\mathcal M\\models\\tau(\\overline{g(\\sigma)})\n\\Longleftrightarrow\\mathcal M\\upharpoonright S\\models\\sigma\\right).\n\\end{aligned}","display":true},{"tex":"\\mathrm{TruthDef}_{S,\\mathcal M,g}(\\tau)","display":false},{"tex":"\\tau","display":false},{"tex":"\\mathcal M","display":false},{"tex":"S","display":false},{"tex":"S","display":false},{"tex":"\\mathcal M","display":false},{"tex":"\\overline{g(\\sigma)}","display":false},{"te