ds_on","正文"],"count":3,"excerpt":"$L_1,L_2\\subseteq\\mathbb B^*$；机器、输出函数见 [[27-df-turing-machine]]，运行时间见 [[27-df-tm-runtime]]。"},{"id":"5244dbb38da17b8a","anchor":"ref-357","locations":["正文"],"count":1,"excerpt":"[[27-df-tm-runtime|df-tm-runtime — Turing-machine running time]]"}],"outgoing":["a31024701b006c36"]}