{"id":"3e09dc1309e006cb","group":"29","path":"29/29-df-suc.md","title":"有限初段上的后继函数","display":"df-suc — 有限初段上的后继函数","type":"definition","metadata":{"type":"definition","book":"Descriptive Complexity (Neil Immerman)","book_abbrev":"29","label":"29-df-suc","aliases":["29-df-suc"],"display":"df-suc — 有限初段上的后继函数","depends_on":[]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Descriptive Complexity (Neil Immerman)"},{"key":"book_abbrev","html":"29"},{"key":"label","html":"29-df-suc"},{"key":"aliases","html":"<div class=\"property-array\"><span>29-df-suc</span></div>"},{"key":"display","html":"df-suc — 有限初段上的后继函数"},{"key":"depends_on","html":"<span class=\"property-null\">无</span>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"n\\in\\mathbb N_{\\geq1}\">\\(n\\in\\mathbb N_{\\geq1}\\)</span> and <span class=\"math-inline\" data-tex=\"n=\\{0,\\ldots,n-1\\}\">\\(n=\\{0,\\ldots,n-1\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}suc}\\vdash\n\\operatorname{SUC}_n\\coloneqq\n\\left\\{(x,y)\\in n^2\\mid x&lt;n-1\\land y=x+1\\right\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}suc}\\vdash\n\\operatorname{SUC}_n\\coloneqq\n\\left\\{(x,y)\\in n^2\\mid x&lt;n-1\\land y=x+1\\right\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\operatorname{SUC}_n:n\\setminus\\{n-1\\}\\to n,\\qquad\n\\forall x&lt;n-1\\;\\operatorname{SUC}_n(x)=x+1\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\operatorname{SUC}_n:n\\setminus\\{n-1\\}\\to n,\\qquad\n\\forall x&lt;n-1\\;\\operatorname{SUC}_n(x)=x+1\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[],"math":[{"tex":"n\\in\\mathbb N_{\\geq1}","display":false},{"tex":"n=\\{0,\\ldots,n-1\\}","display":false},{"tex":"\\mathrm{df\\text{-}suc}\\vdash\n\\operatorname{SUC}_n\\coloneqq\n\\left\\{(x,y)\\in n^2\\mid x<n-1\\land y=x+1\\right\\}","display":true},{"tex":"\\operatorname{SUC}_n:n\\setminus\\{n-1\\}\\to n,\\qquad\n\\forall x<n-1\\;\\operatorname{SUC}_n(x)=x+1","display":true}],"bytes":543,"backlinks":[{"id":"ecc0dd131d213345","anchor":"ref-139","locations":["正文"],"count":1,"excerpt":"[[../29-df-suc]]"}],"outgoing":[]}