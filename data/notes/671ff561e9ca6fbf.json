_S(B_\\bullet,\\mathcal F_\\bullet,\\Omega,\\mathcal A,\\mathbb P)\\leftrightarrow \\mathrm{ZfcProbBrownianMotionProcess}_S(B_\\bullet,\\Omega,\\mathcal A,\\mathbb P)\\land\\mathrm{ZfcProb2Filtration}_S(\\mathcal F_\\bullet,\\langle\\mathbb R_{\\geq0},\\leq\\rangle)\\land\\forall t\\in\\mathbb R_{\\geq0}\\;\\bigl(\\mathcal F_\\bullet(t)\\subseteq\\mathcal A\\land\\mathrm{BorelMeasurable}_S(B_\\bullet(t);\\Omega,\\mathcal F_\\bullet(t))\\bigr)","display":true},{"tex":"\\langle\\mathbb R_{\\geq0},\\leq\\rangle","display":false}],"bytes":2059,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3158","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-prob2-brownian-motion-code.md|58-df-zfc-prob2-brownian-motion-code]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","bbbec05fde1d3b01","a8a0a7253619eec2","20d69bde348c5967"]}