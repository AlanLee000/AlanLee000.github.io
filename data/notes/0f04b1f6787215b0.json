eratorname{Sub}_{\\mathbf{Sh}(X)}(1),\\qquad\\Theta_X(a):=[\\iota_a].","display":true},{"tex":"\\forall B\\in\\operatorname{Sub}_{\\mathbf{Sh}(X)}(1)\\ \\exists!a\\in|L|\\ (\\Theta_X(a)=B),\\qquad\\Theta_X(\\top_L)=\\top_1.","display":true},{"tex":"\\forall a,b\\in|L|\\ (\\Theta_X(a\\wedge_Lb)=\\Theta_X(a)\\wedge_1\\Theta_X(b)).","display":true},{"tex":"\\forall S\\subseteq|L|\\ \\forall B\\in\\operatorname{Sub}_{\\mathbf{Sh}(X)}(1)\\ \\left(\\Theta_X(\\bigvee_LS)\\le_1 B\\Longleftrightarrow\\forall a\\in S\\ (\\Theta_X(a)\\le_1 B)\\right).","display":true},{"tex":"a","display":false},{"tex":"a","display":false},{"tex":"\\downarrow a","display":false},{"tex":"y_Xa","display":false},{"tex":"y_Xa\\le y_Xb","display":false},{"tex":"a\\le b","display":false},{"tex":"a","display":false},{"tex":"\\Theta_X","display":false},{"tex":"S=\\varnothing","display":false}],"bytes":2336,"backlinks":[{"id":"c53146be63465990","anchor":"ref-244","locations":["正文"],"count":1,"excerpt":"[[14-thm-locale-opens-recovery|Theorem — locale 的开集恢复]]"},{"id":"4741fef73eb1a614","anchor":"ref-220","locations":["正文"],"count":1,"excerpt":"[[14-thm-locale-opens-recovery]]"},{"id":"ffda0c0482667c45","anchor":"ref-150","locations":["正文"],"count":2,"excerpt":"[[14-thm-locale-opens-recovery]]"},{"id":"c60ad289d123497b","anchor":"ref-245","locations":["正文"],"count":1,"excerpt":"[[14-thm-locale-opens-recovery|Theorem — locale 的开集恢复]]"}],"outgoing":["2f8d75439f8e94de","bcaaa430e12534f8","d3923e299ec2ec5a","b51ff4f43221971d","1289398555ba3eed"]}