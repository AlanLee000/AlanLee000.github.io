\\vec{\\mathcal M},\\vec E,\\vec i\\rangle\\land\\mathrm{IterationTree}_S(\\mathcal T,\\mathcal M,\\theta)\\Bigr)","display":true}],"bytes":1207,"backlinks":[{"id":"3ea3dede2645310a","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcModel7IterationTree}_S\\subseteq V^6$ (see [[../batch11/58-df-zfc-model7-iteration-tree.md]])"},{"id":"939b911af701aed8","anchor":"ref-2","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcModel7IterationTree}_S\\subseteq V^6$ (see [[58-df-zfc-model7-iteration-tree]])"},{"id":"b244db7d9d164dbe","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcModel7IterationTree}_S:V^6\\to\\{\\top,\\bot\\}$ (see [[58-df-zfc-model7-iteration-tree]])"},{"id":"84daad544872cc71","anchor":"ref-2783","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-zfc-model7-iteration-tree.md|58-df-zfc-model7-iteration-tree]]（batch11）"}],"outgoing":["92fbda0605a6cb98"]}