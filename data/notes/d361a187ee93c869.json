\forall r\\in\\{0,1\\}^{\\mathbb N}\\;T_D^y(m,i,j;r)\\le c(\\epsilon^{-1}\\lceil\\log_2(m+2)\\rceil+1)^b\\\\&\\land\\forall x\\in\\{0,1\\}^{n(m)}\\;\\forall y\\in\\{0,1\\}^m\\;(\\Delta_m^{\\{0,1\\}}(E_m(x),y)\\le\\rho\\Rightarrow\\exists i_0\\in[\\lceil c(n(m)/\\epsilon+1)^a\\rceil]\\;\\forall j\\in[n(m)]\\;\\nu\\{r:D^y(m,i_0,j;r)=\\langle x_j\\rangle\\}\\ge2/3)].\\end{aligned}","display":true}],"bytes":3853,"backlinks":[{"id":"61dee9752dab3b61","anchor":"ref-378","locations":["正文"],"count":1,"excerpt":"[[28-df-reed-muller-code]]、[[28-thm-reed-muller-distance]]、[[28-df-list-decodable-code]]、[[28-df-local-decoder]]、[[28-thm-berlekamp-welch-decoding]]、[[28-lem-hardcore-distribution]]、[[28-df-local-list-decoder]]。"}],"outgoing":["a58fab71e26cf742","fb76a370ebde152b"]}