e [[58-df-injection]])","embed":false}],"math":[{"tex":"f,P,Q,\\leq_P,\\leq_Q\\in V","display":false},{"tex":"\\mathrm{Injection}_S","display":false},{"tex":"\\mathrm{PartOrd}","display":false},{"tex":"\\mathrm{ZfcPosetOrderEmbedding}_S","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}poset\\text{-}order\\text{-}embedding} \\vdash \\mathrm{ZfcPosetOrderEmbedding}_S(f,P,\\leq_P,Q,\\leq_Q)\\leftrightarrow \\mathrm{PartOrd}(P,\\leq_P)\\land\\mathrm{PartOrd}(Q,\\leq_Q)\\land\\mathrm{Injection}_S(f,P,Q)\\land\\forall x,y\\in P\\;(\\langle x,y\\rangle\\in\\leq_P\\leftrightarrow\\langle f(x),f(y)\\rangle\\in\\leq_Q)","display":true}],"bytes":1016,"backlinks":[{"id":"1a4698440d79ae29","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{LinearOrder}_S$ and $\\mathrm{ZfcPosetOrderEmbedding}_S$ are the linear-order and order-embedding predicates (see [[../batch15/58-df-zfc-linear-order.md]], [[../batch11/58-df-zfc-poset-order-embedding.md]])"},{"id":"1dea640a186ddc67","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-3123","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-zfc-poset-order-embedding.md|58-df-zfc-poset-order-embedding]]（batch11）"}],"outgoing":["f5a60b2c6e668b3e","83dfbde66bc78255"]}