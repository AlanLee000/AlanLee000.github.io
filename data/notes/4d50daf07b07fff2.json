display":true},{"tex":"\\mathrm{Terminating}(T_S,\\to_R^S).","display":true},{"tex":"s_1","display":false},{"tex":"s_1","display":false},{"tex":"f","display":false},{"tex":"s_2","display":false},{"tex":"s_1","display":false},{"tex":"f","display":false},{"tex":"f(c_0,c_1,w)","display":false},{"tex":"f(w,w,w)","display":false},{"tex":"w=c_0","display":false},{"tex":"w=c_1","display":false},{"tex":"c_0,c_1","display":false}],"bytes":2629,"backlinks":[{"id":"7a89e84aacc9537c","anchor":"ref-333","locations":["正文"],"count":2,"excerpt":"[[56-ex-many-sorted-type-introduction-one-step.md]]"}],"outgoing":["4f47f83c51f651d3","629f88abafad3e3c","a0c9e286170288bf"]}