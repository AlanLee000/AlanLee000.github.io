rm{thm\\text{-}cohen\\text{-}indestructible}\\vdash\n\\left[\\begin{aligned}\n&\\mathrm{TransitiveModel}_S(M)\\land\\mathrm{Cohen}_S(P,\\leq_P,\\kappa)\\land\nP,\\leq_P,\\kappa,S,\\omega_1^M\\in M\\\\\n&{}\\land\\exists\\mathcal M,\\operatorname{Val}_M,\\operatorname{Sat}_M,s\\in V\\;\\Bigl(\n\\mathrm{CohenMembershipStructure}_S(\\mathcal M,M)\n\\land\\mathrm{Satisfaction}_S(\\mathcal M,\\Sigma_\\in,\\operatorname{Val}_M,\\operatorname{Sat}_M)\\\\\n&\\hspace{38mm}\\land\\mathrm{Assign}(\\mathcal M,s)\n\\land s(v_0)=S\\land s(v_1)=\\omega_1^M\n\\land\\operatorname{Sat}_M(\\ulcorner\\theta_{\\mathrm{stat}}\\urcorner,s)\n\\Bigr)\n\\end{aligned}\\right]\n\\to\\forall p\\in P\\;\\mathrm{ZfcForcingRelation}_S\n\\left(M,p,\\ulcorner\\theta_{\\mathrm{stat}}\\urcorner,\n\\langle\\check S^P,\\check{\\omega_1^M}^P\\rangle,P,\\leq_P\\right)","display":true},{"tex":"M","display":false},{"tex":"S","display":false},{"tex":"\\mathrm{Add}(\\omega,\\kappa)","display":false},{"tex":"\\omega_1","display":false}],"bytes":3261,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4089","locations":["正文"],"count":1,"excerpt":"[[../batch15/58-thm-cohen-indestructible.md|58-thm-cohen-indestructible]]（batch15）"}],"outgoing":["aa69e82627a80f1e","b802c3dd76418d95","911508dbd8495663","a9132c2c1a18acd1","36d7463d215be751","65418b505fc53093","ec28b62254928d73","d9b8711cda3f31ca","8b6a90316aad78a4","64f35ba2e87964e0"]}