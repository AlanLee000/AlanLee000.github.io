in{aligned}\nI_p&\\coloneqq\\operatorname{inc}(\\{i<n\\mid e(i)\\in V(p)\\}),\\\\\n\\bigvee_{\\mathrm{PA}}\\langle\\rangle&\\coloneqq\\bot_{\\mathrm{PA}},\\quad\n\\bigvee_{\\mathrm{PA}}(s\\frown\\langle B\\rangle)\\coloneqq\n(\\bigvee_{\\mathrm{PA}}s)\\lor B\n\\quad(s\\in\\mathrm{Sent}_{\\mathrm{PA}}^{<\\omega},\\ B\\in\\mathrm{Sent}_{\\mathrm{PA}}).\n\\end{aligned}","display":true},{"tex":"e","display":false}],"bytes":2062,"backlinks":[{"id":"070cc23caeb65b77","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"02523cf5c9863d04","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"2adc36a611449e23","anchor":"ref-4","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"1e36ef17b6856ad1","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"e0c421a5b45aeb77","anchor":"ref-401","locations":["正文"],"count":1,"excerpt":"[[89-df-solovay-realization]]"}],"outgoing":["1f581262c09d5e34","55612987d4585fa4","a257e5b1de6880b7","ab746eb779e20ce0","0d71e87a2f416230"]}