11\\text{-}equivalence\\text{-}class\\text{-}map} \\vdash \\mathrm{ZfcSet11EquivalenceClassMap}_S(q,A,E)\\leftrightarrow \\mathrm{EquivRel}_S(E,A)\\land\\exists Q\\;\\Bigl(\\mathrm{ZfcSet11QuotientSetCode}_S(Q,A,E)\\land\\mathrm{Function}(q,A,Q)\\land\\forall x\\in A\\;\\bigl(q(x)=\\{y\\in A:\\langle x,y\\rangle\\in E\\}\\bigr)\\Bigr)","display":true}],"bytes":1616,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3405","locations":["正文"],"count":1,"excerpt":"[[../batch12/58-df-zfc-set11-equivalence-class-map.md|58-df-zfc-set11-equivalence-class-map]]（batch12）"}],"outgoing":["a3348ed9eb6fb4e3","36d7463d215be751","908bc7b079f5d25b","7f45d439462ca7fa"]}