,x],\\mathcal L_{[2,x]},\\lambda_{[2,x]}\\right).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}riemann\\text{-}hypothesis}\\vdash\n\\mathrm{RiemannHypothesis}_S(\\zeta)\\leftrightarrow\n\\mathrm{ZetaFunction}_S(\\zeta)\\land\n\\forall z\\in\\operatorname{dom}(\\zeta)\\;\\Bigl(\n\\zeta(z)=0\\land0<\\operatorname{Re}(z)<1\n\\to\\operatorname{Re}(z)=\\tfrac12\n\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}prime\\text{-}counting}\\vdash\n\\mathrm{PrimeCounting}_S(\\pi)\\leftrightarrow\n\\mathrm{Function}(\\pi,\\mathbb R_{\\geq0},\\omega)\\land\n\\forall x\\in\\mathbb R_{\\geq0}\\;\\left(\n\\pi(x)=\\left|\\{p\\in\\omega:\\mathrm{Prime}(p)\\land p\\leq x\\}\\right|\n\\right)","display":true},{"tex":"\\mathrm{df\\text{-}von\\text{-}koch\\text{-}estimate}\\vdash_{\\mathsf{meta}}\n\\mathrm{VonKochEstimate}_{\\mathsf{meta}}(\\pi,\\operatorname{Li})\\leftrightarrow\n\\exists C\\in\\mathbb R_{>0}\\;\\exists x_0\\in\\mathbb R_{>2}\\;\\forall x\\in\\mathbb R\\;\\left(\nx\\geq x_0\\to\n|\\pi(x)-\\operatorname{Li}(x)|\\leq C\\sqrt x\\log x\n\\right)","display":true},{"tex":"\\mathrm{thm\\text{-}hardy\\text{-}littlewood}\\vdash_{\\mathsf{meta}}\n\\Bigl(\n\\mathrm{ZetaFunction}_S(\\zeta)\n\\land\\mathrm{PrimeCounting}_S(\\pi)\n\\land\\mathrm{LogarithmicIntegral}_{\\mathsf{meta}}(\\operatorname{Li})\n\\Bigr)\n\\to\\Bigl(\n\\mathrm{RiemannHypothesis}_S(\\zeta)\n\\leftrightarrow\\mathrm{VonKochEstimate}_{\\mathsf{meta}}(\\pi,\\operatorname{Li})\n\\Bigr)","display":true}],"bytes":3093,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4197","locations":["正文"],"count":1,"excerpt":"[[../batch02/58-thm-hardy-littlewood.md|58-thm-hardy-littlewood]]（batch02）"}],"outgoing":["dad686059f3ca152","bd554d3da5a43116","36d7463d215be751","76a1ed4ae7e8b05d","68427bc628af9b8d"]}