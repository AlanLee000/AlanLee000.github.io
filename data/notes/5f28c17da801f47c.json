:false},{"tex":"\\mathrm{Homotopic}_S:V^6\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{Continuous}_S:V^5\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{HomotopyCategory}_S:V^2\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}category\\text{-}object\\text{-}hom\\text{-}decoding}\\vdash\n&\\mathrm{Category}_S(\\mathcal C)\n\\land\\mathcal C=\n\\langle O_{\\mathcal C},M_{\\mathcal C},s_{\\mathcal C},t_{\\mathcal C},\nc_{\\mathcal C},e_{\\mathcal C}\\rangle\\\\\n&{}\\to\\left[\n\\operatorname{Ob}(\\mathcal C)=O_{\\mathcal C}\n\\land\\forall A,B\\in O_{\\mathcal C}\\;\n\\operatorname{Hom}_{\\mathcal C}(A,B)=\n\\{f\\in M_{\\mathcal C}:s_{\\mathcal C}(f)=A\\land t_{\\mathcal C}(f)=B\\}\n\\right].\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}homotopy\\text{-}category}\\vdash\n\\mathrm{HomotopyCategory}_S(\\mathbf{hTop},\\mathbf{Top})\n\\leftrightarrow\n\\mathrm{Category}_S(\\mathbf{Top})\n\\land\\mathrm{Category}_S(\\mathbf{hTop})\n\\land\\operatorname{Ob}(\\mathbf{hTop})=\\operatorname{Ob}(\\mathbf{Top})\n\\land\\forall\\mathbf X,\\mathbf Y\\in\\operatorname{Ob}(\\mathbf{Top})\\;\n\\operatorname{Hom}_{\\mathbf{hTop}}(\\mathbf X,\\mathbf Y)\n=\n\\frac{\n\\{f\\in Y^X:\\mathrm{Continuous}_S(f,X,\\tau_X,Y,\\tau_Y)\\}\n}{\nf\\sim g\\;\\leftrightarrow\\;\n\\mathrm{Homotopic}_S(f,g,X,\\tau_X,Y,\\tau_Y)\n}\n\\land [g]\\circ[f]=[g\\circ f].","display":true},{"tex":"\\pi_n(X)=[S^n,X]","display":false}],"bytes":2725,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-641","locations":["正文"],"count":1,"excerpt":"[[../batch10/58-df-homotopy-category.md|58-df-homotopy-category]]（batch10）"}],"outgoing":["cc1ce993dd3ce56d","3cd1834de4f2efb2","a87b7e1119b63b2c","e637becf421e4e61"]}