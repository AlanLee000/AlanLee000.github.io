able Boolean functions, see [[27-df-sat]])","embed":false}],"attachments":[],"math":[{"tex":"n\\in\\mathbb N","display":false},{"tex":"D\\in\\mathrm{DNF}_n","display":false},{"tex":"\\mathrm{EvalDNF}_n(D)","display":false},{"tex":"\\mathrm{SAT}","display":false},{"tex":"\\forall D\\in\\mathrm{DNF}_n\\;(\\mathrm{EvalDNF}_n(D)\\in\\mathrm{SAT}\\leftrightarrow D\\neq\\emptyset)","display":true}],"bytes":912,"backlinks":[{"id":"5244dbb38da17b8a","anchor":"ref-402","locations":["正文"],"count":1,"excerpt":"[[27-thm-dnfsatcriterion|thm-dnfsatcriterion — DNF satisfiability criterion]]"}],"outgoing":["0b618255959ff4bc","ef7f049c27667c75"]}