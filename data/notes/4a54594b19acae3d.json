own\\langle n\\rangle\\in T))\\to\\ell(s)\\in\\tau\\bigr)\\land\\forall s\\in T\\;\\bigl((\\exists n\\in\\omega\\;(s^\\frown\\langle n\\rangle\\in T))\\to\\ell(s)\\in\\{0,1\\}\\bigr)\\land\\forall s\\in T\\;\\bigl(\\ell(s)=0\\to\\exists!n\\in\\omega\\;(s^\\frown\\langle n\\rangle\\in T)\\bigr)\\Bigr)","display":true},{"tex":"\\operatorname{Succ}_T","display":false},{"tex":"R_T","display":false},{"tex":"T","display":false},{"tex":"\\supsetneq","display":false}],"bytes":2008,"backlinks":[{"id":"163cfc16d40fba06","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcDescriptive3BorelCode}_S$ (typed Borel-code predicate, see [[58-df-zfc-descriptive3-borel-code]])"},{"id":"3e37d8fb642c97db","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcDescriptive3BorelCode}_S$ (Borel-code predicate, see [[58-df-zfc-descriptive3-borel-code]])"},{"id":"0ebaa95b3a4cec4c","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcDescriptive3BorelCode}_S$ (typed Borel-code predicate, see [[58-df-zfc-descriptive3-borel-code]])"},{"id":"02fd458d16eb6b0f","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{ZfcDescriptive3BorelCode}_S:V^3\\to\\{\\top,\\bot\\}$ (see [[../batch11/58-df-zfc-descriptive3-borel-code.md]])"},{"id":"84daad544872cc71","anchor":"ref-1822","locations":["正文"],"count":1,"excerpt":"[[../batch11/58-df-zfc-descriptive3-borel-code.md|58-df-zfc-descriptive3-borel-code]]（batch11）"}],"outgoing":["a3348ed9eb6fb4e3","815e63e5071e7b58","1038f84878b895b1"]}