}_S","display":false},{"tex":"\\int|\\nabla u|^2 \\geq c\\|u\\|_{H^1}^2","display":false},{"tex":"A","display":false},{"tex":"\\operatorname{Re}(v^* A v) \\geq c\\|v\\|^2","display":false}],"bytes":2632,"backlinks":[{"id":"b2726dc25b01fa48","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-303","locations":["正文"],"count":1,"excerpt":"[[../batch07/58-df-coercive.md|58-df-coercive]]（batch07）"}],"outgoing":["bdbbe5a00af04978"]}