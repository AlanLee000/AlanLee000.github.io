:false},{"tex":"e\\le i","display":false},{"tex":"x\\ge r(e,s)","display":false},{"tex":"x","display":false},{"tex":"e","display":false},{"tex":"i<e","display":false},{"tex":"\\Phi_e^A\\ne\\chi_C","display":false},{"tex":"W_i","display":false},{"tex":"W_i\\cap A\\ne\\varnothing","display":false},{"tex":"[0,2n]","display":false},{"tex":"i<n","display":false},{"tex":"n","display":false},{"tex":"n+1","display":false},{"tex":"A","display":false}],"bytes":1871,"backlinks":[],"outgoing":["daa141317125dee0","428fc565e7338639","4ef1aee16db6b308","60af447f5d59a8dc"]}