rio}(\\mathcal F)\\Longrightarrow M^{-1}[K]\\in\\mathcal F","display":true}],"bytes":2186,"backlinks":[{"id":"6af52783a9bce985","anchor":"ref-342","locations":["正文"],"count":1,"excerpt":"[[73-thm-trio-gsm-closure|Trio/full trio 的 GSM 封闭性]]"}],"outgoing":["5050f3361a6cf98f","481adbebb0f51a94"]}