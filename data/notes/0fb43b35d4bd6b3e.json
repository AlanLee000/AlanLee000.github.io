"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"(\\Omega,\\mathcal F,\\mathbb P)\">\\((\\Omega,\\mathcal F,\\mathbb P)\\)</span> (probability-space candidate)</li>\n<li><span class=\"math-inline\" data-tex=\"(Y,\\mathcal E)\">\\((Y,\\mathcal E)\\)</span> (measurable target space)</li>\n<li><span class=\"math-inline\" data-tex=\"Z,\\mu\\in V\">\\(Z,\\mu\\in V\\)</span> (random-variable graph and pushforward-measure candidate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (function predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function\">../batch16/58-df-function</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{SigmaAlgebra}\">\\(\\operatorname{SigmaAlgebra}\\)</span> (sigma-algebra predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"a740bdad87b97ac6\" href=\"?note=a740bdad87b97ac6\" title=\"../batch07/58-df-sigma-algebra\">../batch07/58-df-sigma-algebra</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Measure}_S\">\\(\\mathrm{Measure}_S\\)</span> (measure predicate, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"ca832ed6bc22f728\" href=\"?note=ca832ed6bc22f728\" title=\"../batch13/58-df-measure\">../batch13/58-df-measure</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{ProbabilityMeasure}\">\\(\\operatorname{ProbabilityMeasure}\\)</span> (probability-measure predicate, see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"5e0db065132180df\" href=\"?note=5e0db065132180df\" title=\"../batch08/58-df-probability\">../batch08/58-df-probability</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure8DistributionLaw}_S\">\\(\\mathrm{ZfcMeasure8DistributionLaw}_S\\)</span> (distribution-law predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure8\\text{-}distribution\\text{-}law}\\vdash\n\\mathrm{ZfcMeasure8DistributionLaw}_S(\\mu,Z,\\mathbb P,\\Omega,\\mathcal F,Y,\\mathcal E)\\leftrightarrow\n\\operatorname{ProbabilityMeasure}(\\mathbb P,\\Omega,\\mathcal F)\\land\n\\operatorname{SigmaAlgebra}(\\mathcal E,Y)\\land\n\\mathrm{Function}(Z,\\Omega,Y)\\land\n\\bigl(\\forall B\\in\\mathcal E\\;(\\{\\omega\\in\\Omega:Z(\\omega)\\in B\\}\\in\\mathcal F)\\bigr)\\land\n\\mathrm{Measure}_S(\\mu,Y,\\mathcal E)\\land\n\\forall B\\in\\mathcal E\\;(\\mu(B)=\\mathbb P(\\{\\omega\\in\\Omega:Z(\\omega)\\in B\\}))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure8\\text{-}distribution\\text{-}law}\\vdash\n\\mathrm{ZfcMeasure8DistributionLaw}_S(\\mu,Z,\\mathbb P,\\Omega,\\mathcal F,Y,\\mathcal E)\\leftrightarrow\n\\operatorname{ProbabilityMeasure}(\\mathbb P,\\Omega,\\mathcal F)\\land\n\\operatorname{SigmaAlgebra}(\\mathcal E,Y)\\land\n\\mathrm{Function}(Z,\\Omega,Y)\\land\n\\bigl(\\forall B\\in\\mathcal E\\;(\\{\\omega\\in\\Omega:Z(\\omega)\\in B\\}\\in\\mathcal F)\\bigr)\\land\n\\mathrm{Measure}_S(\\mu,Y,\\mathcal E)\\land\n\\forall B\\in\\mathcal E\\;(\\mu(B)=\\mathbb P(\\{\\omega\\in\\Omega:Z(\\omega)\\in B\\}))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary probability definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch16/58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on