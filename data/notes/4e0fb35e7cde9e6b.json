\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcPcfTrueCofinality}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcPcfTrueCofinality}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}pcf\\text{-}true\\text{-}cofinality}\\vdash\\mathrm{ZfcPcfTrueCofinality}_S(P,\\leq_P,\\lambda)\\leftrightarrow\\mathrm{PartialOrder}_S(P,\\leq_P)\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\operatorname{cf}(\\lambda)=\\lambda\\land\\exists\\vec p\\in{}^\\lambda P\\;\\left(\\forall\\alpha&lt;\\beta&lt;\\lambda\\;(\\vec p(\\alpha)\\leq_P\\vec p(\\beta)\\land\\vec p(\\alpha)\\neq\\vec p(\\beta))\\land\\forall q\\in P\\;\\exists\\alpha&lt;\\lambda\\;(q\\leq_P\\vec p(\\alpha))\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}pcf\\text{-}true\\text{-}cofinality}\\vdash\\mathrm{ZfcPcfTrueCofinality}_S(P,\\leq_P,\\lambda)\\leftrightarrow\\mathrm{PartialOrder}_S(P,\\leq_P)\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\operatorname{cf}(\\lambda)=\\lambda\\land\\exists\\vec p\\in{}^\\lambda P\\;\\left(\\forall\\alpha&lt;\\beta&lt;\\lambda\\;(\\vec p(\\alpha)\\leq_P\\vec p(\\beta)\\land\\vec p(\\alpha)\\neq\\vec p(\\beta))\\land\\forall q\\in P\\;\\exists\\alpha&lt;\\lambda\\;(q\\leq_P\\vec p(\\alpha))\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>True cofinality is witnessed by a strictly increasing cofinal sequence of regular length.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","