cal R_{\\mathrm{deg}}\\setminus\\{\\mathbf0\\},\\\\\n\\{\\deg_T(C_j):j\\in\\omega\\}\\ne\\{\\mathbf d\\in\\mathcal D:\\mathbf0<\\mathbf d\\le\\mathbf0'\\}.\n\\end{gathered}","display":true},{"tex":"B=K","display":false},{"tex":"C_j","display":false},{"tex":"A_0,A_1","display":false},{"tex":"K\\equiv_TA_0\\oplus A_1","display":false},{"tex":"K","display":false},{"tex":"A_i","display":false},{"tex":"j","display":false},{"tex":"C_j\\equiv_TA_i","display":false},{"tex":"C_j\\not\\le_TA_i","display":false}],"bytes":2047,"backlinks":[],"outgoing":["38ffff953003d9fb","4f2d2355efa286b3","f389bdba28de0478","d4ca35593c6aba92","d18ba716e49ac8c6","0e6b2238da5572e4"]}