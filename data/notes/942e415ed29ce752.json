{"id":"942e415ed29ce752","group":"72","path":"72/72-df-sequent-contraction.md","title":"Sequent Contraction","display":"df-sequent-contraction — Sequent Contraction","type":"definition","metadata":{"type":"definition","book":"Handbook of Proof Theory","book_abbrev":"72","label":"72-df-sequent-contraction","aliases":["72-df-sequent-contraction"],"display":"df-sequent-contraction — Sequent Contraction","depends_on":["[[72-df-contraction]]"],"source_edition":"Buss (ed.), Handbook of Proof Theory, Elsevier, 1998","source_location":"Chapter I, section 1.2.2, printed p.11, PDF p.23","source_statement_checked":true,"verification_status":"definition-contract-checked","proof_status":"local typed rule-relation or compatibility-alias construction checked","eligible_as_verified_dependency":true},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Handbook of Proof Theory"},{"key":"book_abbrev","html":"72"},{"key":"label","html":"72-df-sequent-contraction"},{"key":"aliases","html":"<div class=\"property-array\"><span>72-df-sequent-contraction</span></div>"},{"key":"display","html":"df-sequent-contraction — Sequent Contraction"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"8d7c19b195bb17fe\" href=\"?note=8d7c19b195bb17fe\" title=\"72-df-contraction\">72-df-contraction</a></span></div>"},{"key":"source_edition","html":"Buss (ed.), Handbook of Proof Theory, Elsevier, 1998"},{"key":"source_location","html":"Chapter I, section 1.2.2, printed p.11, PDF p.23"},{"key":"source_statement_checked","html":"true"},{"key":"verification_status","html":"definition-contract-checked"},{"key":"proof_status","html":"local typed rule-relation or compatibility-alias construction checked"},{"key":"eligible_as_verified_dependency","html":"true"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{Contraction}_L\">\\(\\operatorname{Contraction}_L\\)</span> and <span class=\"math-inline\" data-tex=\"\\operatorname{Contraction}_R\">\\(\\operatorname{Contraction}_R\\)</span> are the two structural rule inference relations of <a class=\"wiki-link\" id=\"ref-2\" data-note=\"8d7c19b195bb17fe\" href=\"?note=8d7c19b195bb17fe\" title=\"72-df-contraction\">72-df-contraction</a></li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{SeqContraction}\">\\(\\operatorname{SeqContraction}\\)</span> is the local compatibility name</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\operatorname{SeqContraction}\n\\coloneqq\n\\operatorname{Contraction}_L\\cup\\operatorname{Contraction}_R.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\operatorname{SeqContraction}\n\\coloneqq\n\\operatorname{Contraction}_L\\cup\\operatorname{Contraction}_R.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>This bridge includes both sides of a classical sequent.  The unrestricted rules are absent from linear logic except through exponentials.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"72-df-contraction","status":"resolved","id":"8d7c19b195bb17fe","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[72-df-contraction]]","embed":false},{"target":"72-df-contraction","status":"resolved","id":"8d7c19b195bb17fe","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\operatorname{Contraction}_L$ and $\\operatorname{Contraction}_R$ are the two structural rule inference relations of [[72-df-contraction]]","embed":false}],"attachments":[],"math":[{"tex":"\\operatorname{Contraction}_L","display":false},{"tex":"\\operatorname{Contraction}_R","display":false},{"tex":"\\operatorname{SeqContraction}","display":false},{"tex":"\\operatorname{SeqContraction}\n\\coloneqq\n\\operatorname{Contraction}_L\\cup\\operatorname{Contraction}_R.","display":true}],"bytes":1128,"backlinks":[{"id":"00439897fba390aa","anchor":"ref-144","locations":["正文"],"count":1,"excerpt":"[[72-df-sequent-contraction|df-sequent-contraction — Sequent Contraction]]"},{"id":"70ff58eeae2491db","anchor":"ref-142","locations":["正文"],"count":1,"excerpt":"[df-sequent-contraction — Sequent Contraction](72-df-sequent-contraction.md)"},{"id":"4d85a6a31705a214","anchor":"ref-144","locations":["正文"],"count":1,"excerpt":"[[./72-df-sequent-contraction|df-sequent-contraction — Sequent Contraction]]"},{"id":"29de2a641cbd0b98","anchor":"ref-262","locations":["正文"],"count":1,"excerpt":"[[../72-df-sequent-contraction]]"}],"outgoing":["8d7c19b195bb17fe"]}