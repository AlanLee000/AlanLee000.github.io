{"id":"8f70d25c66fdd4b8","group":"58","path":"58/batch20/58-df-zfc-top7-irreducible-closed-set.md","title":"ZFC Top7 Irreducible Closed Set","display":"df-zfc-top7-irreducible-closed-set — ZFC Top7 Irreducible Closed Set","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-top7-irreducible-closed-set","aliases":["58-df-zfc-top7-irreducible-closed-set"],"display":"df-zfc-top7-irreducible-closed-set — ZFC Top7 Irreducible Closed Set","depends_on":["[[58-ax-zfc]]","[[58-df-topological-space]]","[[58-df-zfc-top5-closed-set]]","[[58-df-zfc-setop-set-difference]]","[[58-df-zfc-set-indexed-union]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-top7-irreducible-closed-set"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-top7-irreducible-closed-set</span></div>"},{"key":"display","html":"df-zfc-top7-irreducible-closed-set — ZFC Top7 Irreducible Closed Set"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"815e63e5071e7b58\" href=\"?note=815e63e5071e7b58\" title=\"58-df-topological-space\">58-df-topological-space</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"4dc8b2d2e69010a2\" href=\"?note=4dc8b2d2e69010a2\" title=\"58-df-zfc-top5-closed-set\">58-df-zfc-top5-closed-set</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"90335d0f6a9bc60f\" href=\"?note=90335d0f6a9bc60f\" title=\"58-df-zfc-setop-set-difference\">58-df-zfc-setop-set-difference</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"3a78929818a246ba\" href=\"?note=3a78929818a246ba\" title=\"58-df-zfc-set-indexed-union\">58-df-zfc-set-indexed-union</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X\\in V\">\\(X\\in V\\)</span> (topological carrier)</li>\n<li><span class=\"math-inline\" data-tex=\"\\tau\\subseteq\\mathcal P(X)\">\\(\\tau\\subseteq\\mathcal P(X)\\)</span> (topology)</li>\n<li><span class=\"math-inline\" data-tex=\"F\\subseteq X\">\\(F\\subseteq X\\)</span> (closed irreducible-set candidate)</li>\n<li><span class=\"math-inline\" data-tex=\"A,B\\subseteq X\">\\(A,B\\subseteq X\\)</span> (closed-set cover candidates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\operatorname{TopologicalSpace}_S\">\\(\\operatorname{TopologicalSpace}_S\\)</span> (topological-space predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5ClosedSet}_S\">\\(\\mathrm{ZfcTop5ClosedSet}_S\\)</span> (closed-set predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop7IrreducibleClosedSet}_S\">\\(\\mathrm{ZfcTop7IrreducibleClosedSet}_S\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}top7\\text{-}irreducible\\text{-}closed\\text{-}set} \\vdash \\mathrm{ZfcTop7IrreducibleClosedSet}_S(X,\\tau,F)\\leftrightarrow\\operatorname{TopologicalSpace}_S(X,\\tau)\\land F\\neq\\varnothing\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,F)\\land\\forall A,B\\subseteq X\\;\\Bigl(\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,A)\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,B)\\land F\\subseteq A\\cup B\\to F\\subseteq A\\lor F\\subseteq B\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}top7\\text{-}irreducible\\text{-}closed\\text{-}set} \\vdash \\mathrm{ZfcTop7IrreducibleClosedSet}_S(X,\\tau,F)\\leftrightarrow\\operatorname{TopologicalSpace}_S(X,\\tau)\\land F\\neq\\varnothing\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,F)\\land\\forall A,B\\subseteq X\\;\\Bigl(\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,A)\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,B)\\land F\\subseteq A\\cup B\\to F\\subseteq A\\lor F\\subseteq B\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The nonempty closed set <span class=\"math-inline\" data-tex=\"F\">\\(F\\)</span> cannot be covered by two sourced closed subsets without lying in one of them.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-topological-space","status":"resolved","id":"815e63e5071e7b58","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-topological-space]]","embed":false},{"target":"58-df-zfc-top5-closed-set","status":"resolved","id":"4dc8b2d2e69010a2","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-top5-closed-set]]","embed":false},{"target":"58-df-zfc-setop-set-difference","status":"resolved","id":"90335d0f6a9bc60f","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-setop-set-difference]]","embed":false},{"target":"58-df-zfc-set-indexed-union","status":"resolved","id":"3a78929818a246ba","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-set-indexed-union]]","embed":false}],"math":[{"tex":"X\\in V","display":false},{"tex":"\\tau\\subseteq\\mathcal P(X)","display":false},{"tex":"F\\subseteq X","display":false},{"tex":"A,B\\subseteq X","display":false},{"tex":"\\operatorname{TopologicalSpace}_S","display":false},{"tex":"\\mathrm{ZfcTop5ClosedSet}_S","display":false},{"tex":"\\mathrm{ZfcTop7IrreducibleClosedSet}_S","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}top7\\text{-}irreducible\\text{-}closed\\text{-}set} \\vdash \\mathrm{ZfcTop7IrreducibleClosedSet}_S(X,\\tau,F)\\leftrightarrow\\operatorname{TopologicalSpace}_S(X,\\tau)\\land F\\neq\\varnothing\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,F)\\land\\forall A,B\\subseteq X\\;\\Bigl(\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,A)\\land\\mathrm{ZfcTop5ClosedSet}_S(X,\\tau,B)\\land F\\subseteq A\\cup B\\to F\\subseteq A\\lor F\\subseteq B\\Bigr)","display":true},{"tex":"F","display":false}],"bytes":1445,"backlinks":[{"id":"8927eac9882fb933","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-3633","locations":["正文"],"count":1,"excerpt":"[[../batch20/58-df-zfc-top7-irreducible-closed-set.md|58-df-zfc-top7-irreducible-closed-set]]（batch20）"}],"outgoing":["a3348ed9eb6fb4e3","815e63e5071e7b58","4dc8b2d2e69010a2","90335d0f6a9bc60f","3a78929818a246ba"]}