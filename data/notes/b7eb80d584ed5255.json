ource_printed_pages","html":"99–100"},{"key":"source_pdf_pages","html":"111–112"},{"key":"source_pdf","html":"C:\\Users\\lzy\\Documents\\BaiduSyncdisk\\calibre\\libgen.li[Studies in Logic and the Foundatio (2867)[Studies in Logic and the Found - libgen.li.pdf"},{"key":"verification_status","html":"definition-contract-checked"},{"key":"source_proof_status","html":"not-applicable-definition; local well-definedness and referenced interfaces checked"},{"key":"eligible_as_verified_dependency","html":"true"},{"key":"round2_verification_status","html":"definition-contract-checked"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{SharpBoundedFml}_{\\mathrm{BA}}\">\\(\\mathrm{SharpBoundedFml}_{\\mathrm{BA}}\\)</span> 为该同时递归的零层，语言参数为 <span class=\"math-inline\" data-tex=\"\\mathcal L_{\\mathrm{BA}}\">\\(\\mathcal L_{\\mathrm{BA}}\\)</span>。</li>\n<li><span class=\"math-inline\" data-tex=\"i\\in\\omega\">\\(i\\in\\omega\\)</span>；<span class=\"math-inline\" data-tex=\"\\mathcal F\">\\(\\mathcal F\\)</span>、<span class=\"math-inline\" data-tex=\"\\mathcal K_i\">\\(\\mathcal K_i\\)</span> 及同时递归对 <span class=\"math-inline\" data-tex=\"(\\Sigma_i^b,\\Pi_i^b)\">\\((\\Sigma_i^b,\\Pi_i^b)\\)</span> 取 <a class=\"wiki-link\" id=\"ref-2\" data-note=\"95a33888a8fb67bb\" href=\"?note=95a33888a8fb67bb\" title=\"72-df-sigma-bounded-hierarchy\">72-df-sigma-bounded-hierarchy</a>。</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{PiBounded}(i,A)\">\\(\\mathrm{PiBounded}(i,A)\\)</span> 是下式定义的二元语法谓词，<span class=\"math-inline\" data-tex=\"A\\in\\mathcal F\">\\(A\\in\\mathcal F\\)</span>。</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{PiBounded}(i,A)\\ \\Longleftrightarrow\\ A\\in\\Pi_i^b.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{PiBounded}(i,A)\\ \\Longleftrightarrow\\ A\\in\\Pi_i^b.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\Pi_0^b=\\mathrm{SharpBoundedFml}_{\\mathrm{BA}}.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\Pi_0^b=\\mathrm{SharpBoundedFml}_{\\mathrm{BA}}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"i\\geq1\\ \\Longrightarrow\\\n\\Pi_i^b=\\bigcap\\{W\\subseteq\\mathcal F:\\exists U\\subseteq\\mathcal F\\;(U,W)\\in\\mathcal K_i\\}.\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[i\\geq1\\ \\Longrightarrow\\\n\\Pi_i^b=\\bigcap\\{W\\subseteq\\mathcal F:\\exists U\\subseteq\\mathcal F\\;(U,W)\\in\\mathcal K_i\\}.\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Ch. II §1.3.3，印刷 pp. 99–100（PDF pp. 111–112）。Pi 层是上游同时定义的第二分量；此导航入口不另造不一致递归。</li>\n<li>原书对偶规则包含有界全称及锐有界存在，同层任意否定闭包不成立。</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"72-df-sigma-bounded-hierarchy","status":"resolved","id":"95a33888a8fb67bb","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[72-df-sigma-bounded-hierarchy]]","embed":false},{"target":"72-df-sigma-bounded-hierarchy","status":"resolved","id":"95a33888a8fb67bb","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$i\\in\\omega$；$\\mathcal F$、$\\mathcal K_i$ 及同时递归对 $(\\Sigma_i^b,\\Pi_i^b)$ 取 [[72-df-sigma-bounded-hierarchy]]。","embed":false}],"math":[{"tex":"\\mathrm{SharpBoundedFml}_{\\mathrm{BA}}","display":false},{"tex":"\\mathcal L_{\\mathrm{BA}}","display":false},{"tex":"i\\in\\omega","display":false},{"tex":"\\mathcal F","display":false},{"tex":"\\mathcal K_i","display":false},{"tex":"(\\Sigma_i^b,\\Pi_i^b)","display":false},{"tex":"\\mathrm{PiBounded}(i,A)","display":false},{"tex":"A\\in\\mathcal F","display":false},{"tex":"\\mathrm{PiBounded}(i,A)\\ \\Longleftrightarrow\\ A\\in\\Pi_i^b.","display":true},{"tex":"\\Pi_0^b=\\mathrm{SharpBoundedFml}_{\\mathrm{BA}}.","display":true},{"tex":"i\\geq1\\ \\Longrightarrow\\\n\\Pi_i^b=\\bigcap\\{W\\subseteq\\mathcal F:\\exists U\\subseteq\\mathcal F\\;(U,W)\\in\\mathcal K_i\\}.","display":true}],"bytes":1843,"backlinks":[{"id":"00439897fba390aa","anchor":"ref-97","locations":["正文"],"count":1,"excerpt":"[[72-df-pi-bounded-hierarchy|df-pi-bounded-hierarchy — Pi-bounded Hierarchy]]"},{"id":"b1b2bc1f3d190ee9","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$i\\in\\omega$；$\\mathcal F=\\mathrm{Fml}_S(\\mathcal L_{\\mathrm{BA}})$ 及 $\\Sigma_i^b,\\Pi_i^b$ 取 [[72-df-sigma-bounded-hierarchy]]、[[72-df-pi-bounded-hierarchy]]。"},{"id":"4d85a6a31705a214","anchor":"ref-97","locations":["正文"],"count":1,"excerpt":"[[./72-df-pi-bounded-hierarchy|df-pi-bounded-hierarchy — Pi-bounded Hierarchy]]"},{"id":"a04488efdf405cc2","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$i\\geq1$；对所有 $j\\in\\omega$ 固定 $x_j=v_j$。对每个 $k\\in\\omega$，$\\vec x=(x_0,\\ldots,x_{k-1})$；$\\Sigma_i^b,\\Pi_i^b$ 取 [[72-df-sigma-bounded-hierarchy]]、[[72-df-pi-bounded-hierarchy]]。"}],"outgoing":["95a33888a8fb67bb"]}