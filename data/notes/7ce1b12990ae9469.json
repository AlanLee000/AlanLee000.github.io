\Sigma_n","display":false},{"tex":"n","display":false},{"tex":"\\Sigma","display":false},{"tex":"\\Pi_n","display":false},{"tex":"n","display":false},{"tex":"\\Pi","display":false},{"tex":"\\Delta_n","display":false},{"tex":"\\Sigma_n","display":false},{"tex":"\\Pi_n","display":false},{"tex":"\\Sigma_n^G,\\Pi_n^G","display":false},{"tex":"\\Delta_n^G","display":false},{"tex":"\\mathrm{Prov}_G(x)","display":false},{"tex":"\\Sigma^0_1","display":false},{"tex":"\\mathrm{Con}_G=\\neg\\mathrm{Prov}_G(\\overline{\\ulcorner\\bot_G\\urcorner})","display":false},{"tex":"\\Pi^0_1","display":false},{"tex":"\\mathrm{Con}(G)","display":false}],"bytes":2529,"backlinks":[{"id":"140342deea557884","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\Pi_1^G$ (first universal level, see [[92-df-arithmetic-hierarchy]])"},{"id":"8862b10f6e040c16","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\Pi_2^G$ (second universal level, see [[92-df-arithmetic-hierarchy]])"},{"id":"8fd1dce21b2c65db","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\Sigma_1^G$ (first existential level, see [[92-df-arithmetic-hierarchy]])"},{"id":"96ffbdbf20811eb6","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":3,"excerpt":"$\\Sigma_2^G$ (second existential level, see [[92-df-arithmetic-hierarchy]])"},{"id":"ae2aea0052d422dc","anchor":"ref-8","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\varphi \\in \\Delta_0^G$ (bounded formula, see [[92-df-arithmetic-hierarchy]])"},{"id":"56f4ef08abc6d228","anchor":"ref-5","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"823a52c75bbad9bd","anchor":"ref-12","locations":["正文"],"count":1,"excerpt":"[[92-df-arithmetic-hierarchy]]"}],"outgoing":["5a1bd470754681a7","d754a154b50a9533","d666a3e3ee6c8148","b201853606d6de9c","08d7841178f7293b"]}