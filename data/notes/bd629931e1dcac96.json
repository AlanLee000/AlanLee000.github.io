lay":false},{"tex":"\\chi_A(x)=\\chi_B(q(x))","display":false},{"tex":"q(x)","display":false},{"tex":"\\chi_A(x)=1-\\chi_B(q(x))","display":false},{"tex":"x","display":false},{"tex":"A","display":false},{"tex":"q(x)","display":false},{"tex":"B","display":false},{"tex":"b_1","display":false},{"tex":"b_0","display":false},{"tex":"h","display":false},{"tex":"x\\in A\\iff h(x)\\in B","display":false},{"tex":"A","display":false},{"tex":"B","display":false},{"tex":"A","display":false},{"tex":"A","display":false}],"bytes":2012,"backlinks":[{"id":"005203b6707a19f4","anchor":"ref-116","locations":["正文"],"count":1,"excerpt":"[[20-thm-btt-one-ce-mreduction]] — 章 5；直接提供者 4 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-116","locations":["正文"],"count":1,"excerpt":"[[20-thm-btt-one-ce-mreduction]]"}],"outgoing":["d12aec25b5426f2f","d5dada982b721c80","60af447f5d59a8dc","4ef1aee16db6b308"]}