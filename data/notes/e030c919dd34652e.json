ternal-category]]、[[16-df-internal-functor]] 的精确签名。","embed":false},{"target":"16-df-internal-functor","status":"resolved","id":"64d6f11083f002d7","anchor":"ref-11","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Cat}$、$\\mathrm{IntCat}_{\\mathcal B}$、$\\mathrm{IntFunctor}_{\\mathcal B}$ 分别采用 [[16-df-category]]、[[16-df-internal-category]]、[[16-df-internal-functor]] 的精确签名。","embed":false}],"attachments":[],"math":[{"tex":"\\mathcal B","display":false},{"tex":"\\mathrm{FinLim}(\\mathcal B)","display":false},{"tex":"\\mathrm{FinLim}","display":false},{"tex":"F=(F_0,F_1):C\\to D","display":false},{"tex":"G=(G_0,G_1):D\\to E","display":false},{"tex":"\\operatorname{Cat}(\\mathcal B)","display":false},{"tex":"\\operatorname{cat}(\\mathcal B)","display":false},{"tex":"P_{s,t}","display":false},{"tex":"\\mathrm{Cat}","display":false},{"tex":"\\mathrm{IntCat}_{\\mathcal B}","display":false},{"tex":"\\mathrm{IntFunctor}_{\\mathcal B}","display":false},{"tex":"\\begin{aligned}\nO&\\coloneqq\\{\\langle C_0,C_1,s,t,e,m\\rangle\\mid C_0,C_1\\in\\operatorname{Ob}\\mathcal B\n\\land s,t\\in\\mathcal B(C_1,C_0)\\\\\n&\\qquad\\land e\\in\\mathcal B(C_0,C_1)\\land m\\in\\mathcal B(P_{s,t},C_1)\n\\land\\mathrm{IntCat}_{\\mathcal B}(C_0,C_1,s,t,e,m)\\},\\\\\nM&\\coloneqq\\{\\langle C,D,F\\rangle\\mid C,D\\in O\\land F=(F_0,F_1)\n\\land(\\mathrm{IntFunctor}_{\\mathcal B}(F_0,F_1):C\\to D)\\},\\\\\ns\\langle C,D,F\\rangle&\\coloneqq C,\n\\qquad t\\langle C,D,F\\rangle\\coloneqq D,\\\\\ne(C)&\\coloneqq\\langle C,C,(\\operatorname{id}_{C_0},\\operatorname{id}_{C_1})\\rangle,\\\\\nc(\\langle D,E,G\\rangle,\\langle C,D,F\\rangle)&\\coloneqq\n\\langle C,E,(G_0F_0,G_1F_1)\\rangle,\\\\\n\\operatorname{Cat}(\\mathcal B)&\\coloneqq\\langle O,M,s,t,e,c\\rangle,\n\\qquad\\operatorname{cat}(\\mathcal B)\\coloneqq\\operatorname{Cat}(\\mathcal B),\\\\\n\\mathrm{Cat}(\\operatorname{Cat}(\\mathcal B))&,\n\\qquad\\mathrm{FinLim}(\\operatorname{Cat}(\\mathcal B)).\n\\end{ali