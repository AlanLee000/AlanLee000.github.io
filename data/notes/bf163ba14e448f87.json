psilon)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure8\\text{-}tight\\text{-}measure} \\vdash \\mathrm{ZfcMeasure8TightMeasure}_S(\\mu,X,\\tau)\\leftrightarrow \\exists\\mathcal B\\in V\\;\\Bigl(\\mathrm{ZfcMeasure7BorelSigmaAlgebra}_S(X,\\tau,\\mathcal B)\\land\\mathrm{Measure}_S(\\mu,X,\\mathcal B)\\land\\forall\\epsilon\\in\\mathbb R_{&gt;0}\\;\\exists K\\in\\mathcal B\\;(\\mathrm{Compact}_S(K,\\tau\\upharpoonright K)\\land\\mu(X\\setminus K)&lt;\\epsilon)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary measure definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch05/58-df-compact.md","status":"resolved","id":"050f6d05b2c94aea","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch05/58-df-compact.md]]","embed":false},{"target":"../batch13/58-df-measure.md","status":"resolved","id":"ca832ed6bc22f728","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-measure.md]]","embed":false},{"target":"58-df-zfc-measure7-borel-sigma-algebra","status":"resolved","id":"fc62425f71562bf8","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-measure7-borel-sigma-algebra]]","embed":false},{"target":"58-df-zfc-measure7-borel-sigma-algebra","status":"resolved","id":"fc62425f71562bf8","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\