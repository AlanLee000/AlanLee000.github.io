pi,M,N)\\)</span> (canonical collapse-map predicate)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Bijective}(\\pi,M,N)\">\\(\\mathrm{Bijective}(\\pi,M,N)\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Function}(\\sigma,N,M)\">\\(\\mathrm{Function}(\\sigma,N,M)\\)</span> (map predicates)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcModel9InverseCollapseMap}_S(\\sigma,\\pi,M,N)\">\\(\\mathrm{ZfcModel9InverseCollapseMap}_S(\\sigma,\\pi,M,N)\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}model9\\text{-}inverse\\text{-}collapse\\text{-}map} \\vdash \\mathrm{ZfcModel9InverseCollapseMap}_S(\\sigma,\\pi,M,N)\\leftrightarrow \\mathrm{ZfcModelCollapseMap}_S(\\pi,M,N)\\land\\mathrm{Bijective}(\\pi,M,N)\\land\\mathrm{Function}(\\sigma,N,M)\\land\\forall x\\in M\\;(\\sigma(\\pi(x))=x)\\land\\forall y\\in N\\;(\\pi(\\sigma(y))=y)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}model9\\text{-}inverse\\text{-}collapse\\text{-}map} \\vdash \\mathrm{ZfcModel9InverseCollapseMap}_S(\\sigma,\\pi,M,N)\\leftrightarrow \\mathrm{ZfcModelCollapseMap}_S(\\pi,M,N)\\land\\mathrm{Bijective}(\\pi,M,N)\\land\\mathrm{Function}(\\sigma,N,M)\\land\\forall x\\in M\\;(\\sigma(\\pi(x))=x)\\land\\forall y\\in N\\;(\\pi(\\sigma(y))=y)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Both inverse equations are stated, and <span class=\"math-inline\" data-tex=\"\\pi\">\\(\\pi\\)</span> is required to be the canonical membership-preserving collapse map. Domain/range data plus only one composite equation did not by itself identify an inverse collapse map.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Rema