section.md\">../batch06/58-df-intersection.md</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcFilter6CenteredFamily}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcFilter6CenteredFamily}_S:V^2\\to\\{\\top,\\bot\\}\\)</span></p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"[A]^{&lt;\\omega}\\coloneqq\\{B\\in\\mathcal P(A):\\mathrm{Finite}(B)\\}\">\\([A]^{&lt;\\omega}\\coloneqq\\{B\\in\\mathcal P(A):\\mathrm{Finite}(B)\\}\\)</span>，其中 <span class=\"math-inline\" data-tex=\"\\mathrm{Finite}\">\\(\\mathrm{Finite}\\)</span> 见 <a class=\"wiki-link\" id=\"ref-5\" data-note=\"d9a25b0ac94a3598\" href=\"?note=d9a25b0ac94a3598\" title=\"../batch04/58-df-finite.md\">../batch04/58-df-finite.md</a>。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}filter6\\text{-}centered\\text{-}family} \\vdash \\mathrm{ZfcFilter6CenteredFamily}_S(X,\\mathcal A)\\leftrightarrow \\emptyset\\neq\\mathcal A\\subseteq\\mathcal P(X)\\land\\forall\\mathcal B\\in[\\mathcal A]^{&lt;\\omega}\\;(\\mathcal B\\neq\\emptyset\\to\\bigcap\\mathcal B\\neq\\emptyset)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}filter6\\text{-}centered\\text{-}family} \\vdash \\mathrm{ZfcFilter6CenteredFamily}_S(X,\\mathcal A)\\leftrightarrow \\emptyset\\neq\\mathcal A\\subseteq\\mathcal P(X)\\land\\forall\\mathcal B\\in[\\mathcal A]^{&lt;\\omega}\\;(\\mathcal B\\neq\\emptyset\\to\\bigcap\\mathcal B\\neq\\emptyset)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC filter definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor