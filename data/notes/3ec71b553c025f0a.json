-extension-model.md</a></span><span><a class=\"wiki-link\" id=\"ref-5\" data-note=\"573457b8e5661629\" href=\"?note=573457b8e5661629\" title=\"../batch07/58-thm-forcing-truth-lemma.md\">../batch07/58-thm-forcing-truth-lemma.md</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"8b6a90316aad78a4\" href=\"?note=8b6a90316aad78a4\" title=\"../batch18/58-df-satisfaction.md\">../batch18/58-df-satisfaction.md</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"6996aaff4caeacce\" href=\"?note=6996aaff4caeacce\" title=\"../batch13/58-df-consistency.md\">../batch13/58-df-consistency.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{CH}\">\\(\\mathrm{CH}\\)</span> (<span class=\"math-inline\" data-tex=\"\\mathrm{CH}: 2^{\\aleph_0} = \\aleph_1\">\\(\\mathrm{CH}: 2^{\\aleph_0} = \\aleph_1\\)</span>, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"a8e91517c28976b8\" href=\"?note=a8e91517c28976b8\" title=\"../batch14/58-df-ch.md\">../batch14/58-df-ch.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZFC}\">\\(\\mathrm{ZFC}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Con}_S:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Con}_S:V\\to\\{\\top,\\bot\\}\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"6996aaff4caeacce\" href=\"?note=6996aaff4caeacce\" title=\"../batch13/58-df-consistency.md\">../batch13/58-df-consistency.md</a>)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}independence\\text{-}CH} \\vdash \\mathrm{Con}_S(\\mathrm{ZFC}) \\to (\\mathrm{Con}_S(\\mathrm{ZFC}\\cup\\{\\mathrm{CH}\\}) \\land \\mathrm{Con}_S(\\mathrm{ZFC}\\cup\\{\\neg\\mathrm{CH}\\}))\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}independence\\text{-}CH} \\vdash \\mathrm{Con}_S(\\mathrm{ZFC}) \\to (\\mathrm{Con}_S(\\mathrm{ZFC}\\cup\\{\\mathrm{CH}\\}) \\land \\mathrm{Con}_S(\\mathrm{ZFC}\\cup\\{\\neg\\mathrm{CH}\\}))\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The <span class=\"math-inline\" data-tex=\"\\mathrm{Con}(\\mathrm{ZFC} + \\mathrm{CH})\">\\(\\mathrm{Con}(\\mathrm{ZFC} + \\mathrm{CH})\\)</span> direction is obtained via <span class=\"math-inline\" data-tex=\"L\">\\(L\\)</span>.</li>\n<li>The <span class=\"math-inline\" data-tex=\"\\mathrm{Con}(\\mathrm{ZFC} + \\neg \\mathrm{CH})\">\\(\\mathrm{Con}(\\mathrm{ZFC} + \\neg \\mathrm{CH})\\)</span> direction is obtained via Cohen forcing.</li>\n<li>This is a relative-consistency theorem in the metatheory; it does not assert that ZFC proves its own consistency.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch14/58-df-ch.md","status":"resolved","id":"a8e91517c28976b8","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-df-ch.md]]","embed":false},{"target":"../batch14/58-thm-L-satisfies-GCH.md","status":"resolved","id":"bdf91bc7ddbdd903","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch14/58-thm-L-satisfies-GCH.md]]","embed":false},{"target":"../batch13/58-thm-cohen-forcing-CH.md","status":"resolved","id":"902106c2351e64fe","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-thm-cohen-forcing-CH.md]]","embed":false},{"target":"../batch03/58-thm-generic-extension-model.md","status":"resolved","id":"8eb8466c3c417107","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch03/58-thm-generic-extension-model.md]]","embed":false},{"target":"../batch07/58-thm-forcing-truth-lemma.md","status":"resolved","id":"57