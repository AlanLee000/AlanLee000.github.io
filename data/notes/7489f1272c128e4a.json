{"id":"7489f1272c128e4a","group":"58","path":"58/batch20/58-df-zfc-descriptive3-reduction-map.md","title":"ZFC Descriptive3 Reduction Map","display":"df-zfc-descriptive3-reduction-map — ZFC Descriptive3 Reduction Map","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-descriptive3-reduction-map","aliases":["58-df-zfc-descriptive3-reduction-map"],"display":"df-zfc-descriptive3-reduction-map — ZFC Descriptive3 Reduction Map","depends_on":["[[58-ax-zfc]]","[[58-df-function]]","[[58-df-set]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-descriptive3-reduction-map"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-descriptive3-reduction-map</span></div>"},{"key":"display","html":"df-zfc-descriptive3-reduction-map — ZFC Descriptive3 Reduction Map"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"65d9a1e690c32aad\" href=\"?note=65d9a1e690c32aad\" title=\"58-df-set\">58-df-set</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"X,Y\\in V\">\\(X,Y\\in V\\)</span> (source and target sets)</li>\n<li><span class=\"math-inline\" data-tex=\"A\\subseteq X\">\\(A\\subseteq X\\)</span> (source subset)</li>\n<li><span class=\"math-inline\" data-tex=\"B\\subseteq Y\">\\(B\\subseteq Y\\)</span> (target subset)</li>\n<li><span class=\"math-inline\" data-tex=\"f\\in V\">\\(f\\in V\\)</span> with <span class=\"math-inline\" data-tex=\"\\mathrm{Function}(f,X,Y)\">\\(\\mathrm{Function}(f,X,Y)\\)</span> (reduction map, see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcDescriptive3ReductionMap}_S\">\\(\\mathrm{ZfcDescriptive3ReductionMap}_S\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}reduction\\text{-}map} \\vdash \\mathrm{ZfcDescriptive3ReductionMap}_S(X,Y,A,B,f)\\leftrightarrow A\\subseteq X\\land B\\subseteq Y\\land\\mathrm{Function}(f,X,Y)\\land\\forall x\\in X\\;(x\\in A\\leftrightarrow f(x)\\in B)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}descriptive3\\text{-}reduction\\text{-}map} \\vdash \\mathrm{ZfcDescriptive3ReductionMap}_S(X,Y,A,B,f)\\leftrightarrow A\\subseteq X\\land B\\subseteq Y\\land\\mathrm{Function}(f,X,Y)\\land\\forall x\\in X\\;(x\\in A\\leftrightarrow f(x)\\in B)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-function]]","embed":false},{"target":"58-df-set","status":"resolved","id":"65d9a1e690c32aad","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","headin