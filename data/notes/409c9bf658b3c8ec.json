abindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}prob3\\text{-}zero\\text{-}random\\text{-}variable}\\vdash0_\\Omega\\coloneqq\\{\\langle\\omega,0\\rangle:\\omega\\in\\Omega\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}prob3\\text{-}martingale\\text{-}difference}\\vdash{}&amp;\\mathrm{ZfcProb3MartingaleDifference}_S(\\Omega,\\mathcal F,\\mathbb P,\\vec{\\mathcal F},\\vec X)\\\\\n\\leftrightarrow{}&amp;\\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land\\operatorname{dom}(\\vec{\\mathcal F})=\\omega\\land\\operatorname{dom}(\\vec X)=\\omega\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\left(\\operatorname{SigmaAlgebra}(\\vec{\\mathcal F}(n),\\Omega)\\land\\vec{\\mathcal F}(n)\\subseteq\\vec{\\mathcal F}(n+1)\\subseteq\\mathcal F\\land\\mathrm{IntegrableReal}_S(\\vec X(n),\\Omega,\\mathcal F,\\mathbb P)\\land\\mathrm{Measurable}_S(\\vec X(n);(\\Omega,\\vec{\\mathcal F}(n)),(\\mathbb R,\\mathcal B(\\mathbb R)))\\right)\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\mathrm{ZfcProbConditionalExpectation}_S(0_\\Omega,\\vec X(n+1),\\vec{\\mathcal F}(n),\\mathbb P).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}zfc\\text{-}prob3\\text{-}martingale\\text{-}difference}\\vdash{}&amp;\\mathrm{ZfcProb3MartingaleDifference}_S(\\Omega,\\mathcal F,\\mathbb P,\\vec{\\mathcal F},\\vec X)\\\\\n\\leftrightarrow{}&amp;\\mathrm{Measure}_S(\\mathbb P,\\Omega,\\mathcal F)\\land\\mathbb P(\\Omega)=1\\land\\operatorname{dom}(\\vec{\\mathcal F})=\\omega\\land\\operatorname{dom}(\\vec X)=\\omega\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\left(\\operatorname{SigmaAlgebra}(\\vec{\\mathcal F}(n),\\Omega)\\land\\vec{\\mathcal F}(n)\\subseteq\\vec{\\mathcal F}(n+1)\\subseteq\\mathcal F\\land\\mathrm{I