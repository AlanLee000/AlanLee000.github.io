\}.\n\\end{aligned}","display":true},{"tex":"\\Sigma^{\\mathrm{PA}}_1","display":false},{"tex":"\\Sigma","display":false},{"tex":"\\Sigma_1","display":false},{"tex":"\\Sigma_1","display":false},{"tex":"\\omega\\mathrm{Bew}","display":false},{"tex":"\\Sigma_3","display":false}],"bytes":2531,"backlinks":[{"id":"76b37345e1a3ad95","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"3b78fd5923bcaa6c","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"05a599f85e508061","anchor":"ref-37","locations":["正文"],"count":1,"excerpt":"[[89-df-sigma-one-formula]]"},{"id":"e0c421a5b45aeb77","anchor":"ref-33","locations":["正文"],"count":2,"excerpt":"[[89-df-arithmetical-language]] → [[89-df-arithmetical-proof-calculus]] → [[89-df-peano-arithmetic]] → [[89-df-provability-predicate]] → [[89-df-sigma-one-formula]] → [[89-thm-sigma-one-completeness]] → [[89-thm-pa-derivability-conditions]]"}],"outgoing":["a257e5b1de6880b7","86ad48bbd1843ed6","2e7227755a8473e0"]}