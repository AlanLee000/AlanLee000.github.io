\mathrm{FO}[2^{n^{O(1)}},\\tau]","display":false},{"tex":"E_\\tau(U)","display":false},{"tex":"\\mathcal O_\\tau=\\mathrm{OrdSTRUC}[\\tau]","display":false},{"tex":"n=\\operatorname{card}(|A|)","display":false},{"tex":"\\mathrm{PSPACE}^{<}[\\tau]=Q(\\mathrm{FO(PFP)}[<])[\\tau]=\\mathrm{FO}[2^{n^{O(1)}},\\tau].","display":true}],"bytes":1975,"backlinks":[{"id":"8277156a4d684ae0","anchor":"ref-7","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"38909ffa6d1e85ce","anchor":"ref-51","locations":["正文"],"count":1,"excerpt":"[[29-thm-pspace-fo-pfp]] — 有序有限结构上 `\\mathrm{PSPACE}=Q(\\mathrm{FO}(\\mathrm{PFP}))`"},{"id":"805a7de3b1249a36","anchor":"ref-60","locations":["正文"],"count":1,"excerpt":"[[29-thm-pspace-fo-pfp]]"},{"id":"ecc0dd131d213345","anchor":"ref-217","locations":["正文"],"count":1,"excerpt":"[[../29-thm-pspace-fo-pfp]]"}],"outgoing":["95fd0348476d19cc","7174257cf5cba5d4","9f21a81def92d642","2017fdd1c0072445","b89b00b2e37a4ae5","4f651c8d1bdc9a58"]}