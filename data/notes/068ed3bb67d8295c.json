d":false}],"attachments":[],"math":[{"tex":"A\\subseteq\\mathbb N","display":false},{"tex":"\\mathrm{ComputablyTraceable}","display":false},{"tex":"\\mathrm{ComputableTrace}","display":false},{"tex":"\\operatorname{Order}","display":false},{"tex":"\\operatorname{Computable}^A","display":false},{"tex":"h:\\mathbb N\\to\\mathbb N_{>0}","display":false},{"tex":"f,g:\\mathbb N\\to\\mathbb N","display":false},{"tex":"\\mathrm{ComputablyTraceable}(A)\\iff\\forall h\\in\\mathbb N_{>0}^{\\mathbb N}\\;\\left(\\operatorname{Order}(h)\\Rightarrow\\forall f\\in\\mathbb N^{\\mathbb N}\\;\\left[\\operatorname{Computable}^A(f)\\Rightarrow\\exists g\\in\\mathbb N^{\\mathbb N}\\;\\mathrm{ComputableTrace}(g,f,h)\\right]\\right).","display":true}],"bytes":1892,"backlinks":[{"id":"f5b5175508d7a1c1","anchor":"ref-417","locations":["正文"],"count":1,"excerpt":"[[43-thm-trace-order-bound]] — 可计算可迹性的任意正阶函数界"}],"outgoing":["abd2ac3cf0e63c86","782b07fc06268214","9919dea7144eefd8","f357216a7edb035a"]}