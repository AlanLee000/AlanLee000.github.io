fcPosetBooleanUltrafilter}_S\\subseteq V^8","display":false},{"tex":"\\mathrm{ZfcTop5TopologicalSpace}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{ZfcTopBase}_S,\\mathrm{ZfcTop7ClopenSet}_S\\subseteq V^3","display":false},{"tex":"\\mathrm{ZfcTopo8StoneSpace}_S\\subseteq V^3","display":false},{"tex":"\\begin{aligned}\n&\\mathrm{df\\text{-}zfc\\text{-}topo8\\text{-}stone\\text{-}space}\\vdash\n\\mathrm{ZfcTopo8StoneSpace}_S(X,\\tau,B)\\\\\n\\leftrightarrow{}&\n\\exists\\leq_B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B\\in V\\;\\Bigl(\n\\mathrm{ZfcPosetBooleanAlgebra}_S\n(B,\\leq_B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B)\n\\land X=\\bigl\\{U\\subseteq B\\mid\n\\mathrm{ZfcPosetBooleanUltrafilter}_S\n(U,B,\\leq_B,\\wedge_B,\\vee_B,\\neg_B,0_B,1_B)\\bigr\\}\n\\land\\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\\\\n&{}\\land\\exists\\mathcal B\\;\\Bigl(\n\\mathcal B=\\bigl\\{\\{U\\in X\\mid b\\in U\\}:b\\in B\\bigr\\}\n\\land\\mathrm{ZfcTopBase}_S(\\mathcal B,X,\\tau)\\\\\n&\\hspace{31mm}{}\\land\\forall W\\in\\mathcal B\\;\n\\mathrm{ZfcTop7ClopenSet}_S(X,\\tau,W)\\Bigr)\\Bigr).\n\\end{aligned}","display":true},{"tex":"b\\in B","display":false}],"bytes":2004,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3714","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-df-zfc-topo8-stone-space.md|58-df-zfc-topo8-stone-space]]（batch01）"}],"outgoing":["a3348ed9eb6fb4e3","7be50e9501572e41","44ab18b3631aa4ec","74086485fba8d86f","5b5ecc27cb1d76ae","da2c915c953b62ca"]}