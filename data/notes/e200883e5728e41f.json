uralTransformation}_S(\\theta,H,R,\\mathcal D,\\mathcal E)\\\\\n&\\hspace{55mm}\\land\\forall X\\in C_0\\;\n\\eta(X)=c_E\\bigl(\\langle\\varepsilon(X),\\theta(K_0(X))\\rangle\\bigr)\n\\Bigr)\\Bigr)\n\\Bigr].\n\\end{aligned}","display":true},{"tex":"\\eta_X=\\varepsilon_X\\circ\\theta_{KX}","display":false},{"tex":"c_E","display":false}],"bytes":2615,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-1588","locations":["正文"],"count":1,"excerpt":"[[../batch17/58-df-zfc-cat2-right-kan-extension.md|58-df-zfc-cat2-right-kan-extension]]（batch17）"}],"outgoing":["a3348ed9eb6fb4e3","8790486ac053461c","877f1061e295cf5f","970e2b8779070da0"]}