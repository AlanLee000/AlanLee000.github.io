forall\\mid\\operatorname{outdeg}_G(v)>0\\land\\forall u\\in|G|\\;((v,u)\\in E^G\\to u\\in X)\\}.","display":true},{"tex":"\\operatorname{Win}_a(G,t,V_\\exists,V_\\forall)\\coloneqq\\bigcup_{i\\in\\mathbb N}F_{G,t,V_\\exists,V_\\forall}^i(\\varnothing).","display":true},{"tex":"\\mathrm{REACH}_a\\coloneqq\\{\\langle G,s,t,V_\\exists,V_\\forall\\rangle\\mid G\\in\\mathrm{STRUC}[\\tau_{\\mathrm{digraph}}],\\ s,t\\in|G|,\\ V_\\exists\\cap V_\\forall=\\varnothing,\\ V_\\exists\\cup V_\\forall=|G|,\\ s\\in\\operatorname{Win}_a(G,t,V_\\exists,V_\\forall)\\}.","display":true},{"tex":"\\mathrm{REACH}_a^{\\mathrm{std}}\\coloneqq\\{B\\in\\mathrm{StdSTRUC}[\\tau_{ag}]\\mid\\langle\\langle|B|,E^B\\rangle,s^B,t^B,|B|\\setminus A^B,A^B\\rangle\\in\\mathrm{REACH}_a\\}.","display":true}],"bytes":1958,"backlinks":[{"id":"38909ffa6d1e85ce","anchor":"ref-75","locations":["正文"],"count":1,"excerpt":"[[29-df-alternating-reachability]] — `\\mathrm{REACH}_a`"},{"id":"240580939d1fd13a","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"805a7de3b1249a36","anchor":"ref-54","locations":["正文"],"count":1,"excerpt":"[[29-df-alternating-reachability]]"},{"id":"ecc0dd131d213345","anchor":"ref-10","locations":["正文"],"count":1,"excerpt":"[[../29-df-alternating-reachability]]"}],"outgoing":["4563061cac782dab","9403bcdfde263660","4de8e0c8085801f5"]}