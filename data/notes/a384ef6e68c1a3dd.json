{"id":"a384ef6e68c1a3dd","group":"93","path":"93/93-thm-boolean-filter.md","title":"thm-boolean-filter","display":"thm-boolean-filter","type":"theorem","metadata":{"book":"Algebraizable Logics","book_abbrev":"93","depends_on":["[[93-df-boolalg]]","[[93-df-filter]]","[[93-df-ideal]]","[[93-df-boolean-algebra]]"],"display":"thm-boolean-filter","label":"93-thm-boolean-filter","aliases":["93-thm-boolean-filter"],"type":"theorem"},"metadataError":null,"renderWarnings":[],"properties":[{"key":"book","html":"Algebraizable Logics"},{"key":"book_abbrev","html":"93"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"757a95a2c335d9fb\" href=\"?note=757a95a2c335d9fb\" title=\"93-df-boolalg\">93-df-boolalg</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"9beeac4373d773f8\" href=\"?note=9beeac4373d773f8\" title=\"93-df-filter\">93-df-filter</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"247282d0ac964dd5\" href=\"?note=247282d0ac964dd5\" title=\"93-df-ideal\">93-df-ideal</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"7087f500cc845c3b\" href=\"?note=7087f500cc845c3b\" title=\"93-df-boolean-algebra\">93-df-boolean-algebra</a></span></div>"},{"key":"display","html":"thm-boolean-filter"},{"key":"label","html":"93-thm-boolean-filter"},{"key":"aliases","html":"<div class=\"property-array\"><span>93-thm-boolean-filter</span></div>"},{"key":"type","html":"theorem"}],"html":"<h1 id=\"thm-boolean-filter-thm-boolean-filter\">thm-boolean-filter <code>thm-boolean-filter</code></h1>\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{BooleanAlg}_{93}(\\mathbf B)\">\\(\\mathrm{BooleanAlg}_{93}(\\mathbf B)\\)</span>, <span class=\"math-inline\" data-tex=\"\\mathbf B^-\">\\(\\mathbf B^-\\)</span> is its sourced lattice reduct, and <span class=\"math-inline\" data-tex=\"F\\subseteq|\\mathbf B|\">\\(F\\subseteq|\\mathbf B|\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Fil}\">\\(\\mathrm{Fil}\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Idl}\">\\(\\mathrm{Idl}\\)</span> are the filter and ideal classes of <a class=\"wiki-link\" id=\"ref-5\" data-note=\"9beeac4373d773f8\" href=\"?note=9beeac4373d773f8\" title=\"93-df-filter\">93-df-filter</a> and <a class=\"wiki-link\" id=\"ref-6\" data-note=\"247282d0ac964dd5\" href=\"?note=247282d0ac964dd5\" title=\"93-df-ideal\">93-df-ideal</a>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{thm\\text{-}boolean\\text{-}filter}\\vdash\n\\mathrm{BooleanAlg}_{93}(\\mathbf B)\\to\n\\forall F\\subseteq|\\mathbf B|\\;\\Bigl(\nF\\in\\mathrm{Fil}(\\mathbf B^-)\\leftrightarrow\n\\{b\\in|\\mathbf B|:\\neg^{\\mathbf B}(\\langle b\\rangle)\\in F\\}\n\\in\\mathrm{Idl}(\\mathbf B^-)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{thm\\text{-}boolean\\text{-}filter}\\vdash\n\\mathrm{BooleanAlg}_{93}(\\mathbf B)\\to\n\\forall F\\subseteq|\\mathbf B|\\;\\Bigl(\nF\\in\\mathrm{Fil}(\\mathbf B^-)\\leftrightarrow\n\\{b\\in|\\mathbf B|:\\neg^{\\mathbf B}(\\langle b\\rangle)\\in F\\}\n\\in\\mathrm{Idl}(\\mathbf B^-)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"thm-boolean-filter-thm-boolean-filter","text":"thm-boolean-filter `thm-boolean-filter`","level":1},{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"93-df-boolalg","status":"resolved","id":"757a95a2c335d9fb","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-boolalg]]","embed":false},{"target":"93-df-filter","status":"resolved","id":"9beeac4373d773f8","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[93-df-filter]]","embed":false},{"target":"93-df-ide