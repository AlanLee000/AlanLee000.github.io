{"id":"4f651c8d1bdc9a58","group":"29","path":"29/29-df-ordering.md","title":"排序规则","display":"df-ordering — 排序规则","type":"definition","metadata":{"type":"definition","book":"Descriptive Complexity (Neil Immerman)","book_abbrev":"29","label":"29-df-ordering","aliases":["29-df-ordering","29-reg-ordering"],"display":"df-ordering — 排序规则","depends_on":["[[29-df-struc]]","[[29-df-vocab]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Descriptive Complexity (Neil Immerman)"},{"key":"book_abbrev","html":"29"},{"key":"label","html":"29-df-ordering"},{"key":"aliases","html":"<div class=\"property-array\"><span>29-df-ordering</span><span>29-reg-ordering</span></div>"},{"key":"display","html":"df-ordering — 排序规则"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"4de8e0c8085801f5\" href=\"?note=4de8e0c8085801f5\" title=\"29-df-struc\">29-df-struc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"28e86a5f0243a0ae\" href=\"?note=28e86a5f0243a0ae\" title=\"29-df-vocab\">29-df-vocab</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\tau\\in\\mathrm{Vocabulary}\">\\(\\tau\\in\\mathrm{Vocabulary}\\)</span> (see <a class=\"wiki-link\" id=\"ref-3\" data-note=\"28e86a5f0243a0ae\" href=\"?note=28e86a5f0243a0ae\" title=\"29-df-vocab\">29-df-vocab</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"A\\in\\mathrm{STRUC}[\\tau]\">\\(A\\in\\mathrm{STRUC}[\\tau]\\)</span> (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"4de8e0c8085801f5\" href=\"?note=4de8e0c8085801f5\" title=\"29-df-struc\">29-df-struc</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"&lt;\\;\\subseteq|A|^2\">\\(&lt;\\;\\subseteq|A|^2\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<p><span class=\"math-inline\" data-tex=\"\\operatorname{LinOrd}(|A|)\\coloneqq\\{L\\subseteq|A|^2\\mid\\operatorname{LinOrd}(|A|,L)\\}.\">\\(\\operatorname{LinOrd}(|A|)\\coloneqq\\{L\\subseteq|A|^2\\mid\\operatorname{LinOrd}(|A|,L)\\}.\\)</span></p>\n<figure class=\"equation\" data-tex=\"\\operatorname{LinOrd}(|A|,&lt;)\\ \\Longleftrightarrow\\ \\bigl(\\forall a\\in|A|\\;\\neg(a&lt;a)\\bigr)\\land\\bigl(\\forall a,b,c\\in|A|\\;(a&lt;b\\land b&lt;c\\Rightarrow a&lt;c)\\bigr)\\land\\bigl(\\forall a\\neq b\\in|A|\\;(a&lt;b\\lor b&lt;a)\\bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\operatorname{LinOrd}(|A|,&lt;)\\ \\Longleftrightarrow\\ \\bigl(\\forall a\\in|A|\\;\\neg(a&lt;a)\\bigr)\\land\\bigl(\\forall a,b,c\\in|A|\\;(a&lt;b\\land b&lt;c\\Rightarrow a&lt;c)\\bigr)\\land\\bigl(\\forall a\\neq b\\in|A|\\;(a&lt;b\\lor b&lt;a)\\bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}ordering}\\vdash\\mathrm{OrdSTRUC}[\\tau]\\coloneqq\\{(A,&lt;)\\mid A\\in\\mathrm{STRUC}[\\tau]\\land\\operatorname{LinOrd}(|A|,&lt;)\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}ordering}\\vdash\\mathrm{OrdSTRUC}[\\tau]\\coloneqq\\{(A,&lt;)\\mid A\\in\\mathrm{STRUC}[\\tau]\\land\\operatorname{LinOrd}(|A|,&lt;)\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure>","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2}],"links":[{"target":"29-df-struc","status":"resolved","id":"4de8e0c8085801f5","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-df-struc]]","embed":false},{"target":"29-df-vocab","status":"resolved","id":"28e86a5f0243a0ae","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[29-df-vocab]]","embed":false},{"target":"29-df-vocab","status":"resolved","id":"28e86a5f0243a0ae","an