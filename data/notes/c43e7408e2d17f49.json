\land\\mathrm{Function}(f,\\kappa^a,N)\\}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}extender\\text{-}constant}\\vdash\nc_{x,\\kappa}\\coloneqq\\{\\langle s,x\\rangle:s\\in\\kappa^\\varnothing\\}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}extender\\text{-}equality}\\vdash\n\\langle a,f\\rangle\\equiv_{E,\\kappa,\\lambda}\\langle b,g\\rangle\n\\leftrightarrow\n\\langle a,f\\rangle,\\langle b,g\\rangle\\in D_{N,E,\\kappa,\\lambda}\\land\n\\{u\\in\\kappa^{|a\\cup b|}:f(\\widehat u_{a\\cup b}\\upharpoonright a)=g(\\widehat u_{a\\cup b}\\upharpoonright b)\\}\\in E(a\\cup b)","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}extender\\text{-}quotient}\\vdash\n\\mathrm{ZfcLargecard4Extender}_S(E,\\kappa,\\lambda)\\to\n\\mathrm{EquivRel}_S(\\equiv_{E,\\kappa,\\lambda},D_{N,E,\\kappa,\\lambda})\\land\nU_{N,E,\\kappa,\\lambda}\\coloneqq D_{N,E,\\kappa,\\lambda}/\\!\\equiv_{E,\\kappa,\\lambda}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}extender\\text{-}membership}\\vdash\nR_{N,E,\\kappa,\\lambda}\\coloneqq\\left\\{\\left\\langle[\\langle a,f\\rangle]_{E,\\kappa,\\lambda},[\\langle b,g\\rangle]_{E,\\kappa,\\lambda}\\right\\rangle:\\begin{aligned}\n&\\langle a,f\\rangle,\\langle b,g\\rangle\\in D_{N,E,\\kappa,\\lambda}\\\\\n&{}\\land\\{u\\in\\kappa^{|a\\cup b|}:f(\\widehat u_{a\\cup b}\\upharpoonright a)\\in g(\\widehat u_{a\\cup b}\\upharpoonright b)\\}\\in E(a\\cup b)\n\\end{aligned}\\right\\}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}extender\\text{-}diagonal}\\vdash\n\\mathrm{Function}(j_{N,E,\\kappa,\\lambda}^0,N,U_{N,E,\\kappa,\\lambda})\\land\n\\forall x\\in N\\;j_{N,E,\\kappa,\\lambda}^0(x)=[\\langle\\varnothing,c_{x,\\kappa}\\rangle]_{E,\\kappa,\\lambda}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}largecard4\\text{-}extender\\text{-}ultrapower}\\vdash\n\\mathrm{ZfcLargecard4ExtenderUltrapower}_S(N,E,M,