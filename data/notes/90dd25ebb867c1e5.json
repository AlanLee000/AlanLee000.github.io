calePoint}_S(\\delta,\\vec f,A,J) \\leftrightarrow \\mathrm{ZfcLargePcfScale}_S(\\vec f,A,\\operatorname{dom}(\\vec f),J)\\land\\mathrm{LimitOrdinal}_S(\\delta)\\land\\delta\\in\\operatorname{dom}(\\vec f)\\land|A|<\\mathrm{cf}(\\delta)\\land\\exists C,Z\\in V\\;\\Bigl(C\\subseteq\\delta\\land\\mathrm{Club}(C,\\delta)\\land\\mathrm{Function}(Z,C,J)\\land\\forall\\alpha,\\beta\\in C\\;(\\alpha\\in\\beta\\to\\forall i\\in A\\setminus(Z(\\alpha)\\cup Z(\\beta))\\;(\\vec f(\\alpha)(i)<\\vec f(\\beta)(i)))\\Bigr)","display":true},{"tex":"J","display":false},{"tex":"<_{J}","display":false}],"bytes":1618,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3031","locations":["正文"],"count":1,"excerpt":"[[../batch19/58-df-zfc-pcf-good-scale-point.md|58-df-zfc-pcf-good-scale-point]]（batch19）"}],"outgoing":["04670bdc8b64b8dd","315ad00b8744fdfc","36d7463d215be751","81cabbac7fa4d75d","4ed6a5f84f08e526","2be08d4ee8aa1590"]}