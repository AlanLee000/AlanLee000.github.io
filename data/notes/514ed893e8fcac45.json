\\mathrm{MorseFunction}_S(f,M,\\tau,\\mathcal A,n)\\\\\n\\to{}&\\forall q\\in n+1\\;\\left(\n\\sum_{k=0}^{q}(-1)^{q-k}c_{f,\\mathcal A}(k)\n\\ge\\sum_{k=0}^{q}(-1)^{q-k}b_M(k)\\right).\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n\\mathrm{thm\\text{-}morse\\text{-}euler}\\vdash_{\\mathrm{meta}}{}&\n\\operatorname{SmoothManifoldStructure}_S(M,\\tau,\\mathcal A,n)\n\\land\\mathrm{ZfcTop5CompactSpace}_S(M,\\tau)\n\\land\\mathrm{MorseFunction}_S(f,M,\\tau,\\mathcal A,n)\\\\\n\\to{}&\\sum_{k=0}^{n}(-1)^kc_{f,\\mathcal A}(k)\n=\\sum_{k=0}^{n}(-1)^kb_M(k)=\\chi(M).\n\\end{aligned}","display":true},{"tex":"b_M(k)\\le c_{f,\\mathcal A}(k)","display":false},{"tex":"c_{f,\\mathcal A}(k)=b_M(k)","display":false},{"tex":"k","display":false}],"bytes":2594,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4321","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-thm-morse-inequalities.md|58-thm-morse-inequalities]]（batch03）"}],"outgoing":["62ba03663f91241e","e4cdc6123abf4dd8","025c5240f130d970","06b5f03f1e28a63b"]}