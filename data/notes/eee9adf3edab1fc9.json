odel6\\text{-}embedding\\text{-}in\\text{-}language}\\vdash\n\\mathrm{EmbeddingInLanguage}_S(f,A,B,L)\\\\\n\\leftrightarrow{}&\n\\mathrm{Struct}_S(A,L)\\land\\mathrm{Struct}_S(B,L)\n\\land\\mathrm{Injective}_S(f,\\operatorname{Univ}(A),\\operatorname{Univ}(B))\\\\\n&{}\\land\\forall c\\in L.\\mathrm{Cst}\\;\\bigl(f(c^A)=c^B\\bigr)\\\\\n&{}\\land\\forall n\\in\\omega\\;\\forall h\\in L.\\mathrm{Fun}_n\\;\\forall\\bar a\\in\\operatorname{Univ}(A)^n\\;\n\\bigl(f(h^A(\\bar a))=h^B(f\\circ\\bar a)\\bigr)\\\\\n&{}\\land\\forall n\\in\\omega\\;\\forall R\\in L.\\mathrm{Rel}_n\\;\\forall\\bar a\\in\\operatorname{Univ}(A)^n\\;\n\\bigl(\\bar a\\in R^A\\leftrightarrow f\\circ\\bar a\\in R^B\\bigr).\n\\end{aligned}","display":true},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}model6\\text{-}amalgamation\\text{-}property} \\vdash \\mathrm{ZfcModel6AmalgamationProperty}_S(K,L)\\leftrightarrow K\\neq\\emptyset\\land\\forall M\\in K\\;\\mathrm{Struct}_S(M,L)\\land\\forall M_0,M_1,M_2\\in K\\;\\forall f_1,f_2\\;\\Bigl((\\mathrm{EmbeddingInLanguage}_S(f_1,M_0,M_1,L)\\land\\mathrm{EmbeddingInLanguage}_S(f_2,M_0,M_2,L))\\to\\exists N\\in K\\;\\exists g_1,g_2\\;(\\mathrm{EmbeddingInLanguage}_S(g_1,M_1,N,L)\\land\\mathrm{EmbeddingInLanguage}_S(g_2,M_2,N,L)\\land g_1\\circ f_1=g_2\\circ f_2)\\Bigr)","display":true},{"tex":"K","display":false},{"tex":"K","display":false},{"tex":"L","display":false}],"bytes":2489,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2758","locations":["正文"],"count":1,"excerpt":"[[../batch06/58-df-zfc-model6-amalgamation-property.md|58-df-zfc-model6-amalgamation-property]]（batch06）"}],"outgoing":["a3348ed9eb6fb4e3","8317eefb4572709e","437f8f48cb6b32a3","d9b8711cda3f31ca","3888033a846b1cd5"]}