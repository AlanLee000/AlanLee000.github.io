an> (regular uncountable cardinal)</li>\n<li><span class=\"math-inline\" data-tex=\"S\\subseteq\\kappa\">\\(S\\subseteq\\kappa\\)</span> (stationary index set)</li>\n<li><span class=\"math-inline\" data-tex=\"\\vec A\\in V\">\\(\\vec A\\in V\\)</span> (candidate diamond sequence)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{RegularCardinal}_S\">\\(\\mathrm{RegularCardinal}_S\\)</span> (regular-cardinal predicate, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"0fbfc19800246e77\" href=\"?note=0fbfc19800246e77\" title=\"../batch13/58-df-regular-cardinal\">../batch13/58-df-regular-cardinal</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcComb9StationarySetOnCardinal}_S\">\\(\\mathrm{ZfcComb9StationarySetOnCardinal}_S\\)</span> (stationary-set predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"1697a0344b965e07\" href=\"?note=1697a0344b965e07\" title=\"../batch10/58-df-zfc-comb9-stationary-set-on-cardinal\">../batch10/58-df-zfc-comb9-stationary-set-on-cardinal</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (function predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCardinal8DiamondCardinal}_S\">\\(\\mathrm{ZfcCardinal8DiamondCardinal}_S\\)</span> (diamond-on-<span class=\"math-inline\" data-tex=\"S\">\\(S\\)</span> predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}cardinal8\\text{-}diamond\\text{-}cardinal}\\vdash\n\\mathrm{ZfcCardinal8DiamondCardinal}_S(\\kappa,S)\\leftrightarrow\n\\mathrm{RegularCardinal}_S(\\kappa)\\land\\omega&lt;\\kappa\\land\n\\mathrm{ZfcComb9StationarySetOnCardinal}_S(S,\\kappa)\\land\n\\exists\\vec A\\;\\exists B\\;\\Bigl(\\mathrm{Function}(\\vec A,S,B)\\land\n\\forall\\alpha\\in S\\;(\\vec A(\\alpha)\\subseteq\\alpha)\\land\n\\forall A\\subseteq\\kappa\\;\n\\mathrm{ZfcComb9StationarySetOnCardinal}_S(\\{\\alpha\\in S:A\\cap\\alpha=\\vec A(\\alpha)\\},\\kappa)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}cardinal8\\text{-}diamond\\text{-}cardinal}\\vdash\n\\mathrm{ZfcCardinal8DiamondCardinal}_S(\\kappa,S)\\leftrightarrow\n\\mathrm{RegularCardinal}_S(\\kappa)\\land\\omega&lt;\\kappa\\land\n\\mathrm{ZfcComb9StationarySetOnCardinal}_S(S,\\kappa)\\land\n\\exists\\vec A\\;\\exists B\\;\\Bigl(\\mathrm{Function}(\\vec A,S,B)\\land\n\\forall\\alpha\\in S\\;(\\vec A(\\alpha)\\subseteq\\alpha)\\land\n\\forall A\\subseteq\\kappa\\;\n\\mathrm{ZfcComb9StationarySetOnCardinal}_S(\\{\\alpha\\in S:A\\cap\\alpha=\\vec A(\\alpha)\\},\\kappa)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary guessing principle definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch13/58-df-regular-cardinal","status":"resolved","id":"0fbfc19800246e77","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-regular-cardinal]]","embed":false},{"target":"../batch10/58-df-zfc-comb9-stationary-set-on-cardinal","status":"resolved","id":"1697a0344b965e07","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch10/58-df-zfc-comb9-stationary-set-on-cardinal]]","embed":false},{"target":"58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targe