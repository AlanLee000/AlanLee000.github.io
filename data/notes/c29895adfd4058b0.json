of\\text{-}languages}\\vdash\n\\operatorname{PlusClosed}(\\mathcal F)\\leftrightarrow\\forall A\\in\\mathcal F\\;A^+\\in\\mathcal F,\\qquad\\operatorname{StarClosed}(\\mathcal F)\\leftrightarrow\\forall A\\in\\mathcal F\\;A^*\\in\\mathcal F\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}abstract\\text{-}family\\text{-}of\\text{-}languages}\\vdash\n\\operatorname{PlusClosed}(\\mathcal F)\\leftrightarrow\\forall A\\in\\mathcal F\\;A^+\\in\\mathcal F,\\qquad\\operatorname{StarClosed}(\\mathcal F)\\leftrightarrow\\forall A\\in\\mathcal F\\;A^*\\in\\mathcal F\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}abstract\\text{-}family\\text{-}of\\text{-}languages}\\vdash\n\\operatorname{AFL}(\\mathcal F)\\leftrightarrow\\operatorname{Trio}(\\mathcal F)\\land\\operatorname{UnionClosed}(\\mathcal F)\\land\\operatorname{ConcatClosed}(\\mathcal F)\\land\\operatorname{PlusClosed}(\\mathcal F)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}abstract\\text{-}family\\text{-}of\\text{-}languages}\\vdash\n\\operatorname{AFL}(\\mathcal F)\\leftrightarrow\\operatorname{Trio}(\\mathcal F)\\land\\operatorname{UnionClosed}(\\mathcal F)\\land\\operatorname{ConcatClosed}(\\mathcal F)\\land\\operatorname{PlusClosed}(\\mathcal F)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}abstract\\text{-}family\\text{-}of\\text{-}languages}\\vdash\n\\operatorname{FullAFL}(\\mathcal F)\\leftrightarrow\\operatorname{FullTrio}(\\mathcal F)\\land\\operatorname{UnionClosed}(\\mathcal F)\\land\\operatorname{ConcatClosed}(\\mathcal F)\\land\\operatorname{StarClosed}(\\mathcal F)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\