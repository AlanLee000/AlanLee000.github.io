all B\\in\\mathrm{Fml}_{\\Box}\\;\n(\\mathrm{Modalized}(B,p)\\to((p\\lor\\Box p)\\leftrightarrow B)\\notin\\mathrm{GL}).\n\\end{aligned}","display":true},{"tex":"H\\leftrightarrow H","display":false},{"tex":"\\Box^+(p\\leftrightarrow p)","display":false},{"tex":"p\\leftrightarrow H","display":false},{"tex":"p:=\\top","display":false},{"tex":"p:=\\bot","display":false},{"tex":"H,\\neg H","display":false},{"tex":"H\\leftrightarrow\\neg H","display":false},{"tex":"E=(\\Box p\\to p)","display":false},{"tex":"p\\leftrightarrow(p\\lor\\Box p)","display":false},{"tex":"E","display":false},{"tex":"\\Box^+E","display":false},{"tex":"\\Box p","display":false},{"tex":"E","display":false},{"tex":"p","display":false},{"tex":"\\Box^+p","display":false},{"tex":"p","display":false},{"tex":"E","display":false},{"tex":"\\Box p","display":false},{"tex":"\\Box E","display":false},{"tex":"\\Box^+p\\to\\Box^+E","display":false},{"tex":"\\Box^+(p\\leftrightarrow\\top)","display":false},{"tex":"\\Box^+p","display":false},{"tex":"B","display":false},{"tex":"p\\to B","display":false},{"tex":"B","display":false},{"tex":"p","display":false},{"tex":"B","display":false},{"tex":"B","display":false},{"tex":"p\\lor\\Box p","display":false},{"tex":"p:=\\bot","display":false},{"tex":"\\Box\\bot","display":false}],"bytes":2679,"backlinks":[{"id":"e0c421a5b45aeb77","anchor":"ref-128","locations":["正文"],"count":2,"excerpt":"例子与边界：[[89-ex-fixed-point-computation]]、[[89-ex-fixed-point-degree-increase]]、[[89-prop-nonmodalized-fixed-points]]、[[89-ex-fixed-point-table-erratum]]、[[89-ex-godel-sentence-modal]]、[[89-ex-henkin-sentence-modal]]。练习展开：[[89-lem-fixed-point-valuation]]、[[89-thm-double-fixed-point]]。"}],"outgoing":["85e306b51d3267ec","12a315bba5062a88","fae50ce87c0c5e77","ad8a244f68941668","b47f1c6b1cd23b5e","0157f8bea9275cf1","491579297d817026"]}