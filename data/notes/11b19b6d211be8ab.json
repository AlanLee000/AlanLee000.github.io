semantics\">73-df-dtm-language-semantics</a></span></div>"},{"key":"source_id","html":"HMU2007"},{"key":"source_ref","html":"§8.2, print pp. 324–336; PDF pp. 346–358; local normalized interface unless explicitly BookTM"},{"key":"source_status","html":"third-edition-topic-mapped; inherited-local-review; not-a-line-by-line-source-proof-certificate"},{"key":"reviewed_on","html":"2026-10-24"},{"key":"legacy_source_id","html":"HU1979"},{"key":"legacy_source_ref","html":"§7.2–7.3 and §7.5, pp. 148–152, 159–166; local normalized model, not literal book tuple"},{"key":"legacy_source_status","html":"local-formalization; source-section-located; proof scope recorded in review"},{"key":"revision_round","html":"pdf-third-edition-20261024"},{"key":"edition_role","html":"third-edition-core"},{"key":"third_edition_chapter","html":"8"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\Sigma\">\\(\\Sigma\\)</span> (alphabet)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathsf{DTM}_{\\Sigma}\">\\(\\mathsf{DTM}_{\\Sigma}\\)</span> and <span class=\"math-inline\" data-tex=\"L(M)\">\\(L(M)\\)</span> (deterministic Turing machines and their accepted languages, see <a class=\"wiki-link\" id=\"ref-2\" data-note=\"888d8ab66ec7efca\" href=\"?note=888d8ab66ec7efca\" title=\"73-df-dtm-language-semantics\">73-df-dtm-language-semantics</a>)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"L\\subseteq\\Sigma^*\">\\(L\\subseteq\\Sigma^*\\)</span>；<span class=\"math-inline\" data-tex=\"\\operatorname{Recognizable}_{\\Sigma}\">\\(\\operatorname{Recognizable}_{\\Sigma}\\)</span> 是此语言域上的谓词。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}turing\\text{-}recognizable\\text{-}language}\\vdash\n\\mathsf{RE}_{\\Sigma}\\coloneqq\n\\{L\\subseteq\\Sigma^*:\\exists M\\in\\mathsf{DTM}_{\\Sigma}\\;(L=L(M))\\}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}turing\\text{-}recognizable\\text{-}language}\\vdash\n\\mathsf{RE}_{\\Sigma}\\coloneqq\n\\{L\\subseteq\\Sigma^*:\\exists M\\in\\mathsf{DTM}_{\\Sigma}\\;(L=L(M))\\}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}turing\\text{-}recognizable\\text{-}language}\\vdash\n\\operatorname{Recognizable}_{\\Sigma}(L)\\leftrightarrow L\\in\\mathsf{RE}_{\\Sigma}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}turing\\text{-}recognizable\\text{-}language}\\vdash\n\\operatorname{Recognizable}_{\\Sigma}(L)\\leftrightarrow L\\in\\mathsf{RE}_{\\Sigma}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>On inputs outside <span class=\"math-inline\" data-tex=\"L\">\\(L\\)</span>, a recognizer may reject or run forever. The notation <span class=\"math-inline\" data-tex=\"\\mathsf{RE}_{\\Sigma}\">\\(\\mathsf{RE}_{\\Sigma}\\)</span> is now disjoint from <span class=\"math-inline\" data-tex=\"\\mathsf{RegExp}_{\\Sigma}\">\\(\\mathsf{RegExp}_{\\Sigma}\\)</span>.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"73-df-dtm-language-semantics","status":"resolved","id":"888d8ab66ec7efca","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[73-df-dtm-language-semantics]]","embed":false},{"target":"73-df-dtm-language-semantics","status":"resolved","id":"888d8ab66ec7efca","anchor":"ref-2","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathsf{DTM}_{\\Sigma}$ and $L(M)$ (deterministic Turing machines and their accepted languages, see [[73-df-dtm-language-semantics]])","embed":false}],"attachments":[],"math":[{"tex":"\\Sigma","display":false},{"tex":"\\mathsf{DTM}_{\\Sigma}","display":false},{"tex":"L(M)","display":false},{"tex":"L\\subseteq\\Sigma^*","display":false},{"tex":"\\operatorname{Recognizable}_{\\Sigma}","display":false},{"tex":"\\mathrm{df\\text{-}turing\\text{-}recognizable\\text{-}language}\\vdash\n\\mathsf{RE}_{\\Sigma}\\coloneqq\n\\{L\\subseteq\\Sigma^*:\\exists M\\in\\mathsf{DTM}_{\\Sigma}\\;(L=L(M))\\}","display":true},{"tex":"\\mathrm{df\\text{-}turing\\text{-}recognizable\\text{-}language}\\vdash\n\\operatorname{Recognizable}_{\\Sigma}(L)\\leftrightarrow L\\in\\mathsf{RE}_{\\Sigma}","display":true},{"tex":"L","display":false},{"tex":"\\mathsf{RE}_{\\Sigma}","display":false},{"tex":"\\mathsf{RegExp}_{\\Sigma}","display":false}],"bytes":1844,"backlinks":[{"id":"349bd461911980d1","anchor":"ref-5","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathsf{RE}_{\\mathbf 2}$ (recognizable binary languages, see [[73-df-dtm-recognizable-languages]])"},{"id":"219767ec839d8c84","anchor":"ref-20","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\operatorname{PartialComp}_{\\mathbf2,\\mathbf2}$、$\\mathsf{RE}_{\\mathbf2}$ 与 $\\mathsf{DEC}_{\\mathbf2}$ 分别见 [[73-df-string-function-computation]]、[[73-df-dtm-recognizable-languages]]、[[73-df-dtm-language-decision]]。最后的表示对应式中的 $f:\\mathbb N\\rightharpoonup\\mathbb N$ 为任意部分函数，不预先假设可计算性；$\\beta$ 固定为本文件的同一双射。"},{"id":"23b25eb6ccba1a53","anchor":"ref-9","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"自然数字母范围 $\\mathfrak A,\\mathfrak L$ 见 [[73-df-families-of-languages]]。各固定字母表语言类见 [[73-df-finite-automaton-language-class]]、[[73-df-cfg-language-class]]、[[73-df-dtm-recognizable-languages]]、[[73-df-dtm-language-decision]]。"},{"id":"6af52783a9bce985","anchor":"ref-159","locations":["正文"],"count":1,"excerpt":"[[73-df-dtm-recognizable-languages|Turing-Recognizable Language]]"},{"id":"2caf5daca8cda484","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excer