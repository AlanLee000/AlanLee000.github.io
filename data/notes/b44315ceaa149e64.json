ue},{"tex":"Init_{CoS}=\\{top\\}.","display":true},{"tex":"S","display":false},{"tex":"T","display":false},{"tex":"\\pi=(S_0,\\ldots,S_{m-1})","display":true},{"tex":"S_0=S","display":false},{"tex":"S_{m-1}=T","display":false},{"tex":"i+1<m","display":false},{"tex":"(S_i,S_{i+1})\\in Rule_{CoS}","display":false},{"tex":"S_i\\equiv_S S_{i+1}","display":false},{"tex":"\\operatorname{Der}_{CoS}(S,T,\\pi)","display":false},{"tex":"m\\in\\mathbb N","display":false},{"tex":"m>0\\wedge \\pi:m\\to Str_S\n\\wedge\n\\pi(0)=S\n\\wedge\n\\pi(m-1)=T\n\\wedge\n\\forall i+1<m\\bigl((\\pi(i),\\pi(i+1))\\in Rule_{CoS}\\vee \\pi(i)\\equiv_S\\pi(i+1)\\bigr).","display":true},{"tex":"S\\vdash_{CoS}T","display":true},{"tex":"\\pi","display":false},{"tex":"\\operatorname{Der}_{CoS}(S,T,\\pi)","display":false},{"tex":"Thm_{CoS}=\\{S\\in Str_S:\\exists I\\in Init_{CoS}\\ I\\vdash_{CoS}S\\}.","display":true},{"tex":"\\Delta_{CoS}\n=\n(SCtx,Plug_S,\\equiv_S,Rule_{ai},Rule_{sw},Rule_{med},Rule_w,Rule_c,\\vdash_{CoS}).","display":true},{"tex":"Plug_S","display":false},{"tex":"v:Prop\\to\\{0,1\\}","display":false},{"tex":"b_v:Str_S\\to\\{0,1\\}","display":false},{"tex":"b_v(top)=1,\\quad b_v(bot)=0,\\quad b_v(atm(p))=v(p),\\quad b_v(natm(p))=1-v(p),","display":true},{"tex":"b_v(copar(A,B))=\\min(b_v(A),b_v(B)),\\qquad\nb_v(par(A,B))=\\max(b_v(A),b_v(B)).","display":true},{"tex":"b_v","display":false},{"tex":"b_v(\\text{前})\\le b_v(\\text{后})","display":false},{"tex":"(s\\lor t)\\land u\\to s\\lor(t\\land u)","display":false},{"tex":"(a\\land b)\\lor(d\\land e)\\to(a\\lor d)\\land(b\\lor e)","display":false},{"tex":"bot","display":false},{"tex":"p\\lor\\neg p","display":false},{"tex":"b_v","display":false},{"tex":"top","display":false},{"tex":"v","display":false},{"tex":"1","display":false},{"tex":"top","display":false},{"tex":"par(atm(p),natm(p))","display":false},{"tex":"bot","display":false},{"tex":"atm(p)","display":false},{"tex":"v(p)=0","display":false},{"tex":"\\mathcal{CalculusOfStructures}\n=\n\\bigl(\nProp,\nStr_S,\nAt_S,\nSub_S,\n\\widehat\\sigma^+,\n\\widehat\\sigma^-,\ndual_S,\nSCtx,\nPlug_S,\n\\equiv_S,\nRule_{ai},\nRule_{sw},\nRule_{med},\nRule_w,\nRule_c,\nRule_{CoS},\nInit_{CoS},\n\\operatorname{Der}_{CoS},\n\\vdash_{CoS},\nThm_{CoS},\n\\Delta_{CoS}\n\\bigr).","display":true}],"bytes":6583,"backlinks":[],"outgoing":[]}