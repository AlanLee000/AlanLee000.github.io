dberg\\text{-}inversion}\\vdash\n\\exists\\mathbf a\\ge\\mathbf c\\ [\\mathbf a'=\\mathbf a\\vee\\mathbf c'=\\mathbf b].","display":true},{"tex":"C\\in\\mathbf c","display":false},{"tex":"B\\in\\mathbf b","display":false},{"tex":"C'\\le_TB","display":false},{"tex":"B","display":false},{"tex":"X","display":false},{"tex":"e","display":false},{"tex":"C'","display":false},{"tex":"\\rho","display":false},{"tex":"\\Phi_e^{C\\oplus\\rho}(e)","display":false},{"tex":"C","display":false},{"tex":"e\\notin(C\\oplus X)'","display":false},{"tex":"X","display":false},{"tex":"\\chi_B(e)","display":false},{"tex":"A=C\\oplus X","display":false},{"tex":"B","display":false},{"tex":"B","display":false},{"tex":"A'\\le_TB","display":false},{"tex":"A\\oplus C'","display":false},{"tex":"C'","display":false},{"tex":"X","display":false},{"tex":"B(e)","display":false},{"tex":"B\\le_TA\\oplus C'","display":false},{"tex":"C\\le_TA","display":false},{"tex":"A\\oplus C'\\le_TA'","display":false},{"tex":"\\deg_T(A)\\ge\\mathbf c","display":false},{"tex":"X","display":false},{"tex":"C","display":false}],"bytes":2143,"backlinks":[{"id":"562aa6d95dcc4d4d","anchor":"ref-6","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-thm-kleene-post]]；see [[20-thm-relative-friedberg-inversion]]；see [[20-df-jump]]；see [[20-df-degle]]。"},{"id":"f504685cd9dbe257","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"直接使用：see [[20-thm-relative-friedberg-inversion]]；see [[20-df-jump]]；see [[20-df-join]]。"},{"id":"005203b6707a19f4","anchor":"ref-290","locations":["正文"],"count":1,"excerpt":"[[20-thm-relative-friedberg-inversion]] — 章 6；直接提供者 5 个。"},{"id":"f4368dd1e05cad1f","anchor":"ref-290","locations":["正文"],"count":1,"excerpt":"[[20-thm-relative-friedberg-inversion]]"}],"outgoing":["e890b3c29e4a70a3","08b4fd5163a7f955","e888141c21b61ce5","60962a9176d0987e","2ea8548c98f572c3","cc0aeae8dce11855"]}