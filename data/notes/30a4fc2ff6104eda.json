{"id":"30a4fc2ff6104eda","group":"58","path":"58/batch14/58-df-injective-resolution.md","title":"Injective Resolution","display":"df-injective-resolution — Injective Resolution","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-injective-resolution","aliases":["58-df-injective-resolution","Injective Resolution"],"display":"df-injective-resolution — Injective Resolution","depends_on":["[[../batch13/58-df-injective-module.md]]","[[../batch13/58-df-module.md]]","[[../batch15/58-df-injective.md]]","[[../batch16/58-df-function.md]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-injective-resolution"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-injective-resolution</span><span>Injective Resolution</span></div>"},{"key":"display","html":"df-injective-resolution — Injective Resolution"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"215fb05d088ded8c\" href=\"?note=215fb05d088ded8c\" title=\"../batch13/58-df-injective-module.md\">../batch13/58-df-injective-module.md</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"ef3a5dd6825f0373\" href=\"?note=ef3a5dd6825f0373\" title=\"../batch13/58-df-module.md\">../batch13/58-df-module.md</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"8317eefb4572709e\" href=\"?note=8317eefb4572709e\" title=\"../batch15/58-df-injective.md\">../batch15/58-df-injective.md</a></span><span><a class=\"wiki-link\" id=\"ref-4\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"R,A,I,d,\\eta\\in V\">\\(R,A,I,d,\\eta\\in V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Injective}\\subseteq V^3\">\\(\\mathrm{Injective}\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"8317eefb4572709e\" href=\"?note=8317eefb4572709e\" title=\"../batch15/58-df-injective.md\">../batch15/58-df-injective.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Module}_S\\subseteq V^9\">\\(\\mathrm{Module}_S\\subseteq V^9\\)</span> is the structured left-module predicate from <a class=\"wiki-link\" id=\"ref-7\" data-note=\"ef3a5dd6825f0373\" href=\"?note=ef3a5dd6825f0373\" title=\"../batch13/58-df-module.md\">../batch13/58-df-module.md</a>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{InjectiveModule}_S\\subseteq V^2\">\\(\\mathrm{InjectiveModule}_S\\subseteq V^2\\)</span> (see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"215fb05d088ded8c\" href=\"?note=215fb05d088ded8c\" title=\"../batch13/58-df-injective-module.md\">../batch13/58-df-injective-module.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{InjectiveResolution}_S\\subseteq V^5\">\\(\\mathrm{InjectiveResolution}_S\\subseteq V^5\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n\\mathrm{df\\text{-}injective\\text{-}resolution}\\vdash{}&amp;\n\\mathrm{InjectiveResolution}_S(I,d,\\eta,A,R)\\\\\n\\leftrightarrow{}&amp;\n\\exists +_A,0_A,+_R,\\cdot_R,0_R,1_R,\\odot_A\\in V\\;\n\\exists +_I,0_I,\\odot_I\\in V^\\omega\\;\\Bigl[\\\\\n&amp;\\mathrm{Module}_S(A,R,+_A,0_A,+_R,\\cdot_R,0_R,1_R,\\odot_A)\\\\\n&amp;\\land I,d\\in V^\\omega\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\mathrm{Module}_S\\bigl(I(n),R,+_I(n),0_I(n),+_R,\\cdot_R,0_R,1_R,\\odot_I(n)\\bigr)\\\\\n&amp;\\land\\mathrm{Injective}(\\eta,A,I(0))\\\\\n&amp;\\land\\forall x,y\\in A\\;\\forall r\\in R\\;\\Bigl(\n\\eta\\bigl(+_A(\\langle x,y\\rangle)\\bigr)=+_I(0)(\\langle\\eta(x),\\eta(y)\\rangle)\n\\land\\eta\\bigl(\\odot_A(\\langle r,x\\rangle)\\bigr)=\\odot_I(0)(\\langle r,\\eta(x)\\rangle)\\Bigr)\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\Bigl(\n\\mathrm{InjectiveModule}_S(I(n),R)\\land\\mathrm{Function}(d(n),I(n),I(n+1))\\\\\n&amp;\\qquad\\land\\forall x,y\\in I(n)\\;\\forall r\\in R\\;\\bigl(\nd(n)(+_I(n)(\\langle x,y\\rangle))=+_I(n+1)(\\langle d(n)(x),d(n)(y)\\rangle)\\\\\n&amp;\\qquad\\qquad\\land d(n)(\\odot_I(n)(\\langle r,x\\rangle))=\\odot_I(n+1)(\\langle r,d(n)(x)\\rangle)\\bigr)\\Bigr)\\\\\n&amp;\\land\\eta[A]=\\{x\\in I(0)\\mid d(0)(x)=0_I(1)\\}\\\\\n&amp;\\land\\forall n\\in\\omega\\;d(n)[I(n)]=\\{x\\in I(n+1)\\mid d(n+1)(x)=0_I(n+2)\\}\\Bigr].\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n\\mathrm{df\\text{-}injective\\text{-}resolution}\\vdash{}&amp;\n\\mathrm{InjectiveResolution}_S(I,d,\\eta,A,R)\\\\\n\\leftrightarrow{}&amp;\n\\exists +_A,0_A,+_R,\\cdot_R,0_R,1_R,\\odot_A\\in V\\;\n\\exists +_I,0_I,\\odot_I\\in V^\\omega\\;\\Bigl[\\\\\n&amp;\\mathrm{Module}_S(A,R,+_A,0_A,+_R,\\cdot_R,0_R,1_R,\\odot_A)\\\\\n&amp;\\land I,d\\in V^\\omega\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\mathrm{Module}_S\\bigl(I(n),R,+_I(n),0_I(n),+_R,\\cdot_R,0_R,1_R,\\odot_I(n)\\bigr)\\\\\n&amp;\\land\\mathrm{Injective}(\\eta,A,I(0))\\\\\n&amp;\\land\\forall x,y\\in A\\;\\forall r\\in R\\;\\Bigl(\n\\eta\\bigl(+_A(\\langle x,y\\rangle)\\bigr)=+_I(0)(\\langle\\eta(x),\\eta(y)\\rangle)\n\\land\\eta\\bigl(\\odot_A(\\langle r,x\\rangle)\\bigr)=\\odot_I(0)(\\langle r,\\eta(x)\\rangle)\\Bigr)\\\\\n&amp;\\land\\forall n\\in\\omega\\;\\Bigl(\n\\mathrm{InjectiveModule}_S(I(n),R)\\land\\mathrm{Function}(d(n),I(n),I(n+1))\\\\\n&amp;\\qquad\\land\\forall x,y\\in I(n)\\;\\forall r\\in R\\;\\bigl(\nd(n)(+_I(n)(\\langle x,y\\rangle))=+_I(n+1)(\\langle d(n)(x),d(n)(y)\\rangle)\\\\\n&amp;\\qquad\\qquad\\land d(n)(\\odot_I(n)(\\langle r,x\\rangle))=\\odot_I(n+1)(\\langle r,d(n)(x)\\rangle)\\bigr)\\Bigr)\\\\\n&amp;\\land\\eta[A]=\\{x\\in I(0)\\mid d(0)(x)=0_I(1)\\}\\\\\n&amp;\\land\\forall n\\in\\omega\\;d(n)[I(n)]=\\{x\\in I(n+1)\\mid d(n+1)(x)=0_I(n+2)\\}\\Bigr].\n\\end{aligned}\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Injective resolution: injectives replacing <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> to compute right derived functors</li>\n<li>Derived category: <span class=\"math-inline\" data-tex=\"K(Inj(R))/\\sim_{qh}\">\\(K(Inj(R))/\\sim_{qh}\\)</span> for quasi-isomorphisms</li>\n<li>Injective modules: <span class=\"math-inline\" data-tex=\"R\">\\(R\\)</span>-mod has enough injectives (Baer); enough for derived functors</li>\n<li>Dual to projective resolution; used for sheaf <span class=\"math-inline\" data-tex=\"\\mathcal{E}xt\">\\(\\mathcal{E}xt\\)</span>, global sections</li>\n<li>Exactness now uses the set-theoretic images of the displayed functions and the zero elements belonging to one coherent family of module structures.  The former unary <span class=\"math-inline\" data-tex=\"\\operatorname{im}\">\\(\\operatorname{im}\\)</span> and <span class=\"math-inline\" data-tex=\"\\ker\">\\(\\ker\\)</span> operators came from a vector-space atom and did not apply to these module maps.</li>\n</ul>\n<h2 id=\"Reference\">[Reference]</h2>\n<ul>\n<li>Weibel, An Introduction to Homological Algebra</li>\n<li>Cartan and Eilenberg, Homological Algebra</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2},{"id":"Reference","text":"[Reference]","level":2}],"links":[{"target":"../batch13/58-df-injective-module.md","status":"resolved","id":"215fb05d088ded8c","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-injective-module.md]]","embed":false},{"target":"../batch13/58-df-module.md","status":"resolved","id":"ef3a5dd6825f0373","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch13/58-df-module.md]]","embed":false},{"target":"../batch15/58-df-injective.md","status":"resolved","id":"8317eefb4572709e","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-df-injective.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-5","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}\\subseteq V^3$ (see [[../batch16/58-df-function.md]]).","embed":false},{"target":"../batch15/58-df-injective.md","status":"resolved","id":"8317eefb4572709e","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Injective}\\subseteq V^3$ (see [[../batch15/58-df-injective.md]]).","embed":false},{"target":"../batch13/58-df-module.md","status":"resolved","id":"ef3a5dd6825f0373","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Module}_S\\subseteq V^9$ is the structured left-module predicate from [[../batch13/58-df-module.md]].","embed":false},{"target":"../batch13/58-df-injective-module.md","status":"resolved","id":"215fb05d088ded8c","anchor":"ref-8","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{InjectiveModule}_S\\subseteq V^2$ (see [[../batch13/58-df-injective-module.md]]).","embed":false}],"math":[{"tex":"R,A,I,d,\\eta\\in V","display":false},{"tex":"\\mathrm{Function}\\subseteq V^3","display":false},{"tex":"\\mathrm{Injective}\\subseteq V^3","display":false},{"tex":"\\mathrm{Module}_S\\subseteq V^9","display":false},{"tex":"\\mathrm{InjectiveModule}_S\\subseteq V^2","display":false},{"tex":"\\mathrm{InjectiveResolution}_S\\subseteq V^5","display":false},{"tex":"\\begin{aligned}\n\\mathrm{df\\text{-}injective\\text{-}resolution}\\vdash{}&\n\\mathrm{InjectiveResolution}_S(I,d,\\eta,A,R)\\\\\n\\leftrightarrow{}&\n\\exists +_A,0_A,+_R,\\cdot_R,0_R,1_R,\\odot_A\\in V\\;\n\\exists +_I,0_I,\\odot_I\\in V^\\omega\\;\\Bigl[\\\\\n&\\mathrm{Module}_S(A,R,+_A,0_A,+_R,\\cdot_R,0_R,1_R,\\odot_A)\\\\\n&\\land I,d\\in V^\\omega\\\\\n&\\land\\forall n\\in\\omega\\;\\mathrm{Module}_S\\bigl(I(n),R,+_I(n),0_I(n),+_R,\\cdot_R,0_R,1_R,\\odot_I(n)\\bigr)\\\\\n&\\land\\mathrm{Injective}(\\eta,A,I(0))\\\\\n&\\land\\forall x,y\\in A\\;\\forall r\\in R\\;\\Bigl(\n\\eta\\bigl(+_A(\\langle x,y\\rangle)\\bigr)=+_I(0)(\\langle\\eta(x),\\eta(y)\\rangle)\n\\land\\eta\\bigl(\\odot_A(\\langle r,x\\rangle)\\bigr)=\\odot_I(0)(\\langle r,\\eta(x)\\rangle)\\Bigr)\\\\\n&\\land\\forall n\\in\\omega\\;\\Bigl(\n\\mathrm{InjectiveModule}_S(I(n),R)\\land\\mathrm{Function}(d(n),I(n),I(n+1))\\\\\n&\\qquad\\land\\forall x,y\\in I(n)\\;\\forall r\\in R\\;\\bigl(\nd(n)(+_I(n)(\\langle x,y\\rangle))=+_I(n+1)(\\langle d(n)(x),d(n)(y)\\rangle)\\\\\n&\\qquad\\qquad\\land d(n)(\\odot_I(n)(\\langle r,x\\rangle))=\\odot_I(n+1)(\\langle r,d(n)(x)\\rangle)\\bigr)\\Bigr)\\\\\n&\\land\\eta[A]=\\{x\\in I(0)\\mid d(0)(x)=0_I(1)\\}\\\\\n&\\land\\forall n\\in\\omega\\;d(n)[I(n)]=\\{x\\in I(n+1)\\mid d(n+1)(x)=0_I(n+2)\\}\\Bigr].\n\\end{aligned}","display":true},{"tex":"A","display":false},{"tex":"K(Inj(R))/\\sim_{qh}","display":false},{"tex":"R","display":false},{"tex":"\\mathcal{E}xt","display":false},{"tex":"\\operatorname{im}","display":false},{"tex":"\\ker","display":false}],"bytes":2817,"backlinks":[{"id":"d6024046101f0472","ancho