{"id":"9a8f01bfcbcdc014","group":"58","path":"58/batch03/58-df-zfc-rel-range.md","title":"ZFC Rel Range","display":"df-zfc-rel-range — ZFC Rel Range","type":"definition","metadata":{"type":"definition","book":"Set Theory","book_abbrev":"58","label":"58-df-zfc-rel-range","aliases":["58-df-zfc-rel-range"],"display":"df-zfc-rel-range — ZFC Rel Range","depends_on":["[[58-ax-zfc]]","[[58-df-zfc-relation-on]]","[[58-df-zfc-set-ordered-pair]]"]},"metadataError":null,"renderWarnings":[],"properties":[{"key":"type","html":"definition"},{"key":"book","html":"Set Theory"},{"key":"book_abbrev","html":"58"},{"key":"label","html":"58-df-zfc-rel-range"},{"key":"aliases","html":"<div class=\"property-array\"><span>58-df-zfc-rel-range</span></div>"},{"key":"display","html":"df-zfc-rel-range — ZFC Rel Range"},{"key":"depends_on","html":"<div class=\"property-array\"><span><a class=\"wiki-link\" id=\"ref-1\" data-note=\"a3348ed9eb6fb4e3\" href=\"?note=a3348ed9eb6fb4e3\" title=\"58-ax-zfc\">58-ax-zfc</a></span><span><a class=\"wiki-link\" id=\"ref-2\" data-note=\"41276343f41b253b\" href=\"?note=41276343f41b253b\" title=\"58-df-zfc-relation-on\">58-df-zfc-relation-on</a></span><span><a class=\"wiki-link\" id=\"ref-3\" data-note=\"599d16bb1d9ed41c\" href=\"?note=599d16bb1d9ed41c\" title=\"58-df-zfc-set-ordered-pair\">58-df-zfc-set-ordered-pair</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"R,Y\\in V\">\\(R,Y\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{RelationOn}_S:V^2\\to\\mathsf{Bool}\">\\(\\mathrm{RelationOn}_S:V^2\\to\\mathsf{Bool}\\)</span> (see <a class=\"wiki-link\" id=\"ref-4\" data-note=\"41276343f41b253b\" href=\"?note=41276343f41b253b\" title=\"58-df-zfc-relation-on\">58-df-zfc-relation-on</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcRelRange}_S:V^2\\to\\mathsf{Bool}\">\\(\\mathrm{ZfcRelRange}_S:V^2\\to\\mathsf{Bool}\\)</span> (predicate defined here)</li