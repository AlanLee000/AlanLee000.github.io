iom.md]])"},{"id":"84daad544872cc71","anchor":"ref-595","locations":["正文"],"count":1,"excerpt":"[[../batch05/58-df-ground-axiom.md|58-df-ground-axiom]]（batch05）"}],"outgoing":["d0244462250ae67e","ca2a9c9166fa8cce"]}