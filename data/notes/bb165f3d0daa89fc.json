]\\to B[x:=s].","display":true},{"tex":"C=\\forall_k y\\,A","display":false},{"tex":"y=x\\Rightarrow C[x:=s]=\\forall_k y\\,A.","display":true},{"tex":"y\\ne x","display":false},{"tex":"y\\notin\\operatorname{FV}_{\\mathsf T}^{TST}(s)","display":false},{"tex":"C[x:=s]=\\forall_k y\\,(A[x:=s]).","display":true},{"tex":"y\\ne x","display":false},{"tex":"y\\in\\operatorname{FV}_{\\mathsf T}^{TST}(s)","display":false},{"tex":"z=\n\\operatorname{fresh}_{TST}\n\\bigl(k,\n(\\operatorname{FV}_{\\mathsf F}^{TST}(A)\n\\cup\\operatorname{FV}_{\\mathsf T}^{TST}(s)\n\\cup\\{x,y\\})\\cap\\mathsf{Var}_k^{TST}\n\\bigr).","display":true},{"tex":"C[x:=s]=\\forall_k z\\,((A[y:=\\operatorname{var}_k(z)])[x:=s]).","display":true},{"tex":"x,y\\in\\mathsf{Var}_n^{TST}","display":false},{"tex":"\\operatorname{FreeRen}_{TST}(A,x,y)\n:=A[x:=\\operatorname{var}_n(y)].","display":true},{"tex":"A=\\forall_n x\\,B","display":false},{"tex":"y\\notin\\operatorname{FV}_{\\mathsf F}^{TST}(B)\\setminus\\{x\\}","display":false},{"tex":"\\operatorname{BoundRen}_{TST}(A,x,y)\n:=\\forall_n y\\,(B[x:=\\operatorname{var}_n(y)]).","display":true},{"tex":"\\equiv_{\\alpha}^{TST}","display":false},{"tex":"\\mathsf{Frm}_{TST}","display":false},{"tex":"\\neg","display":false},{"tex":"\\to","display":false},{"tex":"\\forall_n","display":false},{"tex":"x,y\\in\\mathsf{Var}_n^{TST}","display":false},{"tex":"y\\notin\\operatorname{FV}_{\\mathsf F}^{TST}(A)\\setminus\\{x\\}","display":false},{"tex":"\\forall_n x\\,A\\equiv_{\\alpha}^{TST}\n\\forall_n y\\,(A[x:=\\operatorname{var}_n(y)]).","display":true},{"tex":"\\mathsf{Ax}_{Log}^{TST}\n=\\mathsf{Ax}_{\\to,1}^{TST}\\cup\\mathsf{Ax}_{\\to,2}^{TST}\\cup\n\\mathsf{Ax}_{\\to,3}^{TST}\\cup\\mathsf{Ax}_{\\forall,1}^{TST}\\cup\n\\mathsf{Ax}_{\\forall,2}^{TST}\\cup\\mathsf{Ax}_{=,1}^{TST}\\cup\n\\mathsf{Ax}_{=,2}^{TST}.","display":true},{"tex":"\\mathsf{Ax}_{\\to,1}^{TST}=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{TST}\\},","display":true},{"tex":"\\mathsf{Ax}_{\\to,2}^{TST}=