operatorname{ex}(v,a))\\to[T(\\operatorname{ex}(v,a))\\leftrightarrow\\exists t\\,T(\\operatorname{SubTm}(a,t,v))];\\\\\n\\forall v\\forall a\\quad&D(\\operatorname{ex}(v,a))\\to[N(\\operatorname{ex}(v,a))\\leftrightarrow\\forall t\\,N(\\operatorname{SubTm}(a,t,v))];\\\\\n\\forall t\\quad&T(\\operatorname{tr}(t))\\leftrightarrow T(\\operatorname{val}(t));\\\\\n\\forall t\\quad&N(\\operatorname{tr}(t))\\leftrightarrow[N(\\operatorname{val}(t))\\lor\\neg D(\\operatorname{val}(t))].\n\\end{aligned}","display":true},{"tex":"\\mathrm{KF}\\coloneqq\\operatorname{Cn}_{\\mathrm{CL}}(\\mathrm{PA}_T\\cup\\operatorname{Ax}_{\\mathrm{KF}}).","display":true},{"tex":"N(a)","display":false},{"tex":"\\neg T(a)","display":false},{"tex":"\\forall a(T(a)\\to D(a))","display":false}],"bytes":3109,"backlinks":[{"id":"c6dd3bfc0bc402ea","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{KF}$ 见 [[91-df-KF]]；$D=\\operatorname{Sent}_{\\mathcal L_T}$，$\\operatorname{neg}$ 为否定编码。"},{"id":"5b13bea8fb4eeb65","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$K_1,\\ldots,K_{13}$ 依次指 [[91-df-KF]] 列出的十三个编码量化公理；$D=\\operatorname{Sent}_{\\mathcal L_T}$。"},{"id":"0d27d2c0bdcc7452","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{KF}$ 见 [[91-df-KF]]，$D=\\operatorname{Sent}_{\\mathcal L_T}$；$\\operatorname{Cn}_{\\mathrm{CL}}$ 为经典演绎闭包。"},{"id":"f23e822ba5d24954","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"551c8bf1fc88e1ec","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"edf61bb893ee0ba7","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"a295446296ee06c0","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"cb582ee79087af80","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{KF}$ 为 [[91-df-KF]] 的经典公理系统；$\\models_{\\mathrm{CL}}$ 为经典满足关系，$\\varphi\\i