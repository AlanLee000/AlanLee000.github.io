class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}image\\text{-}closed\\text{-}class} \\vdash \\mathrm{ImageClosedClass}_S(C) \\leftrightarrow \\forall f,a\\in C\\;\\left(\\mathrm{Function}(f,\\operatorname{dom}(f),\\operatorname{ran}(f))\\to\\{y\\in\\operatorname{ran}(f)\\mid\\exists x\\in a\\;(\\langle x,y\\rangle\\in f)\\}\\in C\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}image\\text{-}closed\\text{-}class} \\vdash \\mathrm{ImageClosedClass}_S(C) \\leftrightarrow \\forall f,a\\in C\\;\\left(\\mathrm{Function}(f,\\operatorname{dom}(f),\\operatorname{ran}(f))\\to\\{y\\in\\operatorname{ran}(f)\\mid\\exists x\\in a\\;(\\langle x,y\\rangle\\in f)\\}\\in C\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The predicate is a set-coded closure condition; its image term is bounded by the range of the member function.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-3","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}$ (see [[../batch16/58-df-function.md]])","embed":false}],"math":[{"tex":"C,f,a,x,y\\in V","display":false},{"tex":"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{ImageClosedClass}_S:V\\to\\{\\top,\\bot\\}","display":false},{"tex":"\\mathrm{df\\text{-}zfc\\text{-}image\\text{-}closed\\text{-}class} \\vdash \\mathrm{ImageClosedClass}_S(C) \\leftrightarrow \\forall f,a\\in C\\;\\left(\\mathrm{Function}(f,\\operatorname{dom}(f),\\operatorname{ran}(f))\\to\\{y\\in\\operatorname{ran}(f)\\mid\\exists x\\in a\\;(\\langle x,y\\rangle\\in f)\\}\\in C\\right)","display":true}],"bytes":957,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-2319","locations":["正文"],"count":1,"excerpt":"[[../batch08/58-df-zfc-image-closed-class.md|58-df-zfc-image-closed-class]]（batch08）"}],"outgoing":["a3348ed9eb6fb4e3","36d7463d215be751"]}