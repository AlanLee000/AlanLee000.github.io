\\mathsf{Seq}^n.","display":true},{"tex":"\\mathsf{Seq}^{<\\omega}\\times\\mathsf{Seq}","display":false},{"tex":"(Q_0,\\ldots,Q_{n-1};Q):=((Q_0,\\ldots,Q_{n-1}),Q)","display":false},{"tex":"(();Q):=((),Q)","display":false},{"tex":"\\mathsf{Rule}_{\\mathsf{rot}}=\\{(([\\Gamma]\\Rightarrow A);[\\Delta]\\Rightarrow A):\\Gamma,\\Delta\\in\\mathsf{List}^{+},\\Gamma\\sim_{\\mathsf{rot}}\\Delta,A\\in\\mathsf{Frm}\\},","display":true},{"tex":"\\mathsf{Rule}_{\\cdot R}=\\{(([\\Gamma]\\Rightarrow A),([\\Delta]\\Rightarrow B);[\\Gamma\\cdot\\Delta]\\Rightarrow\\operatorname{prod}(A,B)):\\Gamma,\\Delta\\in\\mathsf{List}^{+},A,B\\in\\mathsf{Frm}\\},","display":true},{"tex":"\\mathsf{Rule}_{\\cdot L}=\n\\{(([\\Gamma\\cdot(A)\\cdot(B)\\cdot\\Delta]\\Rightarrow C);[\\Gamma\\cdot(\\operatorname{prod}(A,B))\\cdot\\Delta]\\Rightarrow C):\n\\Gamma,\\Delta\\in\\mathsf{List},A,B,C\\in\\mathsf{Frm},\\Gamma\\cdot(A)\\cdot(B)\\cdot\\Delta\\in\\mathsf{List}^{+}\\},","display":true},{"tex":"\\mathsf{Rule}_{\\backslash R}=\\{(([A,\\Gamma]\\Rightarrow B);[\\Gamma]\\Rightarrow\\operatorname{ldiv}(A,B)):\\Gamma\\in\\mathsf{List}^{+},A,B\\in\\mathsf{Frm}\\},","display":true},{"tex":"\\mathsf{Rule}_{/R}=\\{(([\\Gamma,A]\\Rightarrow B);[\\Gamma]\\Rightarrow\\operatorname{rdiv}(B,A)):\\Gamma\\in\\mathsf{List}^{+},A,B\\in\\mathsf{Frm}\\},","display":true},{"tex":"\\mathsf{Rule}_{\\backslash L}=\n\\{(([\\Gamma]\\Rightarrow A),([\\Delta,B,\\Pi]\\Rightarrow C);[\\Delta,\\operatorname{ldiv}(A,B),\\Gamma,\\Pi]\\Rightarrow C):\n\\Gamma\\in\\mathsf{List}^{+},\\Delta,\\Pi\\in\\mathsf{List},A,B,C\\in\\mathsf{Frm},\\Delta,B,\\Pi\\in\\mathsf{List}^{+}\\},","display":true},{"tex":"\\mathsf{Rule}_{/L}=\n\\{(([\\Gamma]\\Rightarrow A),([\\Delta,B,\\Pi]\\Rightarrow C);[\\Delta,\\Gamma,\\operatorname{rdiv}(B,A),\\Pi]\\Rightarrow C):\n\\Gamma\\in\\mathsf{List}^{+},\\Delta,\\Pi\\in\\mathsf{List},A,B,C\\in\\mathsf{Frm},\\Delta,B,\\Pi\\in\\mathsf{List}^{+}\\},","display":true},{"tex":"\\mathsf{Rule}_{\\mathsf{cut}}=\\{(([\\Gamma]\\Rightarrow A),([\\Delta,A,\\Pi]\\Rightarrow B);[\\Delta,\\Gamma,\\Pi]\\Rightarrow B):\\Gamma\\in\\mathsf{List}^{+},\\Delta,\\Pi\\in\\mathsf{List},\\Delta,A,\\Pi\\in\\mathsf{List}^{+},A,B\\in\\mathsf{Frm}\\}.","display":true},{"tex":"\\mathsf{Rule}_{\\mathsf{CL}}","display":false},{"tex":"\\mathsf{Rule}_{\\mathsf{rot}}\\cup\n\\mathsf{Rule}_{\\cdot R}\\cup\n\\mathsf{Rule}_{\\cdot L}\\cup\n\\mathsf{Rule}_{\\backslash R}\\cup\n\\mathsf{Rule}_{/R}\\cup\n\\mathsf{Rule}_{\\backslash L}\\cup\n\\mathsf{Rule}_{/L}\\cup\n\\mathsf{Rule}_{\\mathsf{cut}}.","display":true},{"tex":"(T,r,\\prec,\\operatorname{ch})","display":false},{"tex":"T","display":false},{"tex":"r\\in T","display":false},{"tex":"r","display":false},{"tex":"\\prec","display":false},{"tex":"r","display":false},{"tex":"\\operatorname{ch}(u)","display":false},{"tex":"u","display":false},{"tex":"\\pi,Q","display":false},{"tex":"\\operatorname{PrfOK}_{\\mathsf{CL}}(\\pi,Q)\n\\Longleftrightarrow Q\\in\\mathsf{Seq}\\land\n\\exists T,r,\\prec,\\operatorname{ch},\\ell\\;\n\\left[\\begin{array}{l}\n\\pi=(T,r,\\prec,\\operatorname{ch},\\ell)\\land\n(T,r,\\prec,\\operatorname{ch})\\text{ 满足本节的全部有限有根有序树条件}\\\\\n{}\\land\\ell:T\\to\\mathsf{Seq}\\land\\ell(r)=Q\\\\\n{}\\land\\forall u\\in T\\;\n\\left((\\operatorname{ch}(u)=()\\land\\ell(u)\\in\\mathsf{Ax}_{\\mathsf{CL}})\n\\lor(\\operatorname{ch}(u)\\ne()\\land(\\ell\\circ\\operatorname{ch}(u),\\ell(u))\\in\\mathsf{Rule}_{\\mathsf{CL}})\\right)\n\\end{array}\\right].","display":true},{"tex":"\\ell\\circ\\operatorname{ch}(u)","display":false},{"tex":"C\\in\\mathsf{Cyc}","display":false},{"tex":"A\\in\\mathsf{Frm}","display":false},{"tex":"\\mathsf{Prf}_{\\mathsf{CL}}(C,A)=\\{\\pi:\\operatorname{PrfOK}_{\\mathsf{CL}}(\\pi,C\\Rightarrow A)\\}.","display":true},{"tex":"[\\Gamma]\\vdash_{\\mathsf{CL}}A\\Longleftrightarrow\\exists\\pi\\;\\operatorname{PrfOK}_{\\mathsf{CL}}(\\pi,[\\Gamma]\\Rightarrow A).","display":true},{"tex":"\\mathsf{Thm}_{\\mathsf{CL}}\n=\n\\{[\\Gamma