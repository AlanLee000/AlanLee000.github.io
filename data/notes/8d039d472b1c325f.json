e11MeasureAlgebra}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (predicates from dependencies)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure4SeparableMeasureAlgebra}_S\">\\(\\mathrm{ZfcMeasure4SeparableMeasureAlgebra}_S\\)</span> (predicate defined here)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathbb B,\\nu\">\\(\\mathbb B,\\nu\\)</span> (merged measure-algebra parameters)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcMeasure7SeparableMeasureAlgebra}_S\">\\(\\mathrm{ZfcMeasure7SeparableMeasureAlgebra}_S\\)</span> (merged predicate)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}separable\\text{-}measure\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure4SeparableMeasureAlgebra}_S(\\mathbb A,\\mu,d)\\leftrightarrow \\exists\\Sigma\\;\\exists E\\;\\Bigl(\\mathrm{ZfcMeasure11MeasureAlgebra}_S(\\mathbb A,\\Sigma,\\mu,E)\\land\\mu(\\bigcup\\Sigma)&lt;\\infty\\land\\mathrm{Function}(d,\\mathbb A\\times\\mathbb A,[0,\\infty))\\land\\forall A,B\\in\\Sigma\\;\\bigl(d([A]_E,[B]_E)=\\mu(A\\triangle B)\\bigr)\\land\\exists D\\in[\\mathbb A]^{\\leq\\omega}\\;\\forall a\\in\\mathbb A\\;\\forall\\varepsilon\\in\\mathbb R_{&gt;0}\\;\\exists b\\in D\\;(d(a,b)&lt;\\varepsilon)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}separable\\text{-}measure\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure4SeparableMeasureAlgebra}_S(\\mathbb A,\\mu,d)\\leftrightarrow \\exists\\Sigma\\;\\exists E\\;\\Bigl(\\mathrm{ZfcMeasure11MeasureAlgebra}_S(\\mathbb A,\\Sigma,\\mu,E)\\land\\mu(\\bigcup\\Sigma)&lt;\\infty\\land\\mathrm{Function}(d,\\mathbb A\\times\\mathbb A,[0,\\infty))\\land\\forall A,B\\in\\Sigma\\;\\bigl(d([A]_E,[B]_E)=\\mu(A\\triangle B)\\bigr)\\land\\exists D\\in[\\mathbb A]^{\\leq\\omega}\\;\\forall a\\in\\mathbb A\\;\\forall\\varepsilon\\in\\mathbb R_{&gt;0}\\;\\exists b\\in D\\;(d(a,b)&lt;\\varepsilon)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}separable\\text{-}measure\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure7SeparableMeasureAlgebra}_S(\\mathbb B,\\nu,d)\\leftrightarrow \\mathrm{ZfcMeasure4SeparableMeasureAlgebra}_S(\\mathbb B,\\nu,d)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}measure4\\text{-}separable\\text{-}measure\\text{-}algebra} \\vdash \\mathrm{ZfcMeasure7SeparableMeasureAlgebra}_S(\\mathbb B,\\nu,d)\\leftrightarrow \\mathrm{ZfcMeasure4SeparableMeasureAlgebra}_S(\\mathbb B,\\nu,d)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The measure7 separable-measure-algebra variant is merged here.</li>\n<li>The metric is defined on quotient classes through representatives; finite total measure makes it real-valued, and the last clause supplies a countable dense subset.</li>\n<li>The measure7 separable-measure-algebra variant is merged here.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch08/58-df-zfc-measure11-measure-algebra","status":"resolved","id":"40617012e3a2a78d","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch08/58-df-zfc-measure11-measure-algebra]]","embed":false},{"target":"../batch16/58-df-function","status":"resolved","id":"36d7463d215be751","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function]]","embed":false}],"math":[{"tex":"\\mathbb A,\\mu,d\\in V","disp