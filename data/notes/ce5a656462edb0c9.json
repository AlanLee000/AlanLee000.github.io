","display":false},{"tex":"+_V","display":false},{"tex":"\\odot","display":false},{"tex":"|\\langle x, y \\rangle| \\leq \\|x\\| \\|y\\|","display":false},{"tex":"\\|x+y\\|^2 + \\|x-y\\|^2 = 2\\|x\\|^2 + 2\\|y\\|^2","display":false},{"tex":"M^\\perp = \\{x : \\langle x, m \\rangle = 0 \\;\\forall m \\in M\\}","display":false}],"bytes":1942,"backlinks":[{"id":"d9b9ad74f5bc0aa7","anchor":"ref-4","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{InnerProduct}_S(B,H,k,+_H,\\odot_H)$ (inner-product predicate, see [[../batch18/58-df-inner-product.md]])"},{"id":"cae2c5219270d535","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"633f67d630a481ae","anchor":"ref-1","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"200eacd293b1282b","anchor":"ref-3","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"b70ce791d5b1a19b","anchor":"ref-3","locations":["元数据 · depends_on","正文"],"count":2,"excerpt":"$\\mathrm{InnerProduct}_S(B,H,k,+_H,\\odot_H)$ (inner-product predicate, see [[../batch18/58-df-inner-product.md]])"},{"id":"1e5fb9d97fa0606e","anchor":"ref-2","locations":["元数据 · depends_on"],"count":1,"excerpt":""},{"id":"84daad544872cc71","anchor":"ref-691","locations":["正文"],"count":1,"excerpt":"[[../batch18/58-df-inner-product.md|58-df-inner-product]]（batch18）"}],"outgoing":["592f9cfb66a507c2","36d7463d215be751"]}