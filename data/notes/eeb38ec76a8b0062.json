a,\\pi,A),\\qquad\nThm_{RTT}=\\{A\\in\\mathsf{Frm}_{RTT}:\\varnothing\\vdash_{RTT}A\\}.","display":true},{"tex":"d","display":false},{"tex":"o","display":false},{"tex":"o(\\tau)\\ge d(\\tau)","display":false},{"tex":"2","display":false},{"tex":"1","display":false},{"tex":"\\mathcal{RTT}=\n\\bigl(\\mathsf{RType},\\mathsf{SType}_{RTT},d,o,\\mathsf{Branch}_{RTT},\\mathsf{RelType}_{RTT},\n(\\mathsf{Var}_\\tau^{RTT})_{\\tau\\in\\mathsf{RType}},\\mathsf{Var}_{RTT},\n(\\mathsf{Term}_\\tau^{RTT})_{\\tau\\in\\mathsf{RType}},\\mathsf{Term}_{RTT},\\mathsf{Frm}_{RTT},\nFV_T,BV_T,FV,BV,Sub_T,Sub_F,FreeRen,BoundRen,\\equiv_\\alpha,\nord,PredCompOK,Ax_{RTT},Rule_{MP},Rule_{Gen},Rule_\\alpha,Proof_{RTT},\\vdash_{RTT},Thm_{RTT}\\bigr).","display":true}],"bytes":11166,"backlinks":[],"outgoing":[]}