y)","display":false},{"tex":"ord:\\mathsf{Frm}_{RTT}\\to\\mathbb N","display":false},{"tex":"ord(s\\doteq_\\tau t)=0,\\qquad ord(s\\in_{\\tau,r}t)=r,","display":true},{"tex":"ord(\\neg A)=ord(A),\\qquad ord(A\\to B)=\\max(ord(A),ord(B)),","display":true},{"tex":"ord(\\forall_\\tau x A)=\\max(o(\\tau)+1,ord(A)).","display":true},{"tex":"PredCompOK(A,\\tau,r,x,y)","display":false},{"tex":"A\\in\\mathsf{Frm}_{RTT},\\quad\\tau\\in\\mathsf{RType},\\quad r\\in\\mathbb N,\\quad r>o(\\tau),","display":true},{"tex":"x\\in\\mathsf{Var}_\\tau^{RTT},\\quad y\\in\\mathsf{Var}_{\\operatorname{pred}(\\tau,r)}^{RTT},\\quad\nord(A)<r,\\quad y\\notin FV(A).","display":true},{"tex":"Ax_K=\\{A\\to(B\\to A):A,B\\in\\mathsf{Frm}_{RTT}\\},","display":true},{"tex":"Ax_S=\\{(A\\to(B\\to C))\\to((A\\to B)\\to(A\\to C)):A,B,C\\in\\mathsf{Frm}_{RTT}\\},","display":true},{"tex":"Ax_{Cl}=\\{(\\neg A\\to\\neg B)\\to(B\\to A):A,B\\in\\mathsf{Frm}_{RTT}\\},","display":true},{"tex":"Ax_{\\forall E}=\\{(\\forall_\\tau x A)\\to A[x:=t]:\\tau\\in\\mathsf{RType},\\ x\\in\\mathsf{Var}_\\tau^{RTT},\\ t\\in\\mathsf{Term}_\\tau^{RTT},\\ A\\in\\mathsf{Frm}_{RTT}\\},","display":true},{"tex":"Ax_{\\forall D}=\\{(\\forall_\\tau x(A\\to B))\\to(A\\to\\forall_\\tau x B):\\tau\\in\\mathsf{RType},\\ x\\in\\mathsf{Var}_\\tau^{RTT},\\ A,B\\in\\mathsf{Frm}_{RTT},\\ x\\notin FV(A)\\},","display":true},{"tex":"Ax_{EqR}=\\{t\\doteq_\\tau t:\\tau\\in\\mathsf{RType},\\ t\\in\\mathsf{Term}_\\tau^{RTT}\\},","display":true},{"tex":"Ax_{EqSub}=\\{(t\\doteq_\\tau u)\\to(A[x:=t]\\to A[x:=u]):\\tau\\in\\mathsf{RType},\\ x\\in\\mathsf{Var}_\\tau^{RTT},\\ t,u\\in\\mathsf{Term}_\\tau^{RTT},\\ A\\in\\mathsf{Frm}_{RTT}\\}.","display":true},{"tex":"Ax_{Log}=Ax_K\\cup Ax_S\\cup Ax_{Cl}\\cup Ax_{\\forall E}\\cup Ax_{\\forall D}\\cup Ax_{EqR}\\cup Ax_{EqSub}.","display":true},{"tex":"Ax_{Ext}=\\{(\\forall_\\tau z(z\\in_{\\tau,r}x\\leftrightarrow z\\in_{\\tau,r}y))\\to\nx\\doteq_{\\operatorname{pred}(\\tau,r)}y:\n\\tau\\in\\mathsf{RType},\