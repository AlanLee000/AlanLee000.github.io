\overline v(\\operatorname{bot})=\\bot_{K3w},","display":true},{"tex":"\\overline v(\\operatorname{neg}(A))=\\neg_{K3w}\\overline v(A),","display":true},{"tex":"\\overline v(\\operatorname{and}(A,B))=\\overline v(A)\\wedge_{K3w}\\overline v(B),\n\\qquad\n\\overline v(\\operatorname{or}(A,B))=\\overline v(A)\\vee_{K3w}\\overline v(B).","display":true},{"tex":"\\mathsf{Fail}_{K3w}:\\mathcal P(\\mathsf{Fm}_{K3w})\\times\\mathsf{Fm}_{K3w}\n\\to\\mathcal P(\\mathsf{Val}_{K3w}).","display":true},{"tex":"\\mathsf{Fail}_{K3w}(\\Gamma,A)\n=\n\\{v\\in\\mathsf{Val}_{K3w}:\n(\\forall G\\in\\Gamma\\ \\overline v(G)\\in\\mathsf D_{K3w})\n\\text{ 且 }\n\\overline v(A)\\notin\\mathsf D_{K3w}\\}.","display":true},{"tex":"\\Gamma\\Vdash_{K3w}A\n\\quad\\Longleftrightarrow\\quad\n\\mathsf{Fail}_{K3w}(\\Gamma,A)=\\varnothing.","display":true},{"tex":"\\mathsf{Valid}_{K3w}=\\{A\\in\\mathsf{Fm}_{K3w}:\\varnothing\\Vdash_{K3w}A\\}.","display":true},{"tex":"\\mathsf{SubRule}_{K3w}\n=\n\\{((A),\\widehat\\sigma(A)):A\\in\\mathsf{Fm}_{K3w},\\ \\sigma\\in\\mathsf{Subst}_{K3w}\\}.","display":true},{"tex":"\\mathsf{SemCert}_{K3w}:\n\\mathcal P(\\mathsf{Fm}_{K3w})\\times\\mathsf{Fm}_{K3w}\n\\longrightarrow\\mathcal P(\\{\\star\\}).","display":true},{"tex":"\\Gamma\\subseteq\\mathsf{Fm}_{K3w}","display":false},{"tex":"A\\in\\mathsf{Fm}_{K3w}","display":false},{"tex":"\\mathsf{SemCert}_{K3w}(\\Gamma,A)=\n\\begin{cases}\n\\{\\star\\},&\\mathsf{Fail}_{K3w}(\\Gamma,A)=\\varnothing,\\\\\n\\varnothing,&\\mathsf{Fail}_{K3w}(\\Gamma,A)\\ne\\varnothing.\n\\end{cases}","display":true},{"tex":"\\Gamma\\Vdash_{K3w}A\n\\quad\\Longleftrightarrow\\quad\n\\mathsf{SemCert}_{K3w}(\\Gamma,A)\\ne\\varnothing.","display":true},{"tex":"\\mathsf{Valid}_{K3w}","display":false},{"tex":"\\Vdash_{K3w}","display":false},{"tex":"\\mathsf{SemCert}_{K3w}","display":false},{"tex":"\\mathsf{Fail}_{K3w}","display":false},{"tex":"\\mathsf{Rule}^{\\operatorname{proof}}_{K3w}\n\\subseteq\\mathsf{Fm}_{K3w}^{<\\omega}\\times\\mathsf{Fm}_