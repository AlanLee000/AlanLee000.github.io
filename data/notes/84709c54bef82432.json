":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\kappa,\\lambda,\\mu\">\\(\\kappa,\\lambda,\\mu\\)</span> (cardinals) and <span class=\"math-inline\" data-tex=\"n\\in\\omega\\setminus\\{0\\}\">\\(n\\in\\omega\\setminus\\{0\\}\\)</span></p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{Cardinal}_S\">\\(\\mathrm{Cardinal}_S\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Function}\">\\(\\mathrm{Function}\\)</span> (predicates from dependencies)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcCombArrowNotation}_S\">\\(\\mathrm{ZfcCombArrowNotation}_S\\)</span> (predicate defined here)</p>\n</li>\n<li>\n<p><span class=\"math-inline\" data-tex=\"|A|\">\\(|A|\\)</span> 为集合 <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> 的唯一基数，使用 <a class=\"wiki-link\" id=\"ref-6\" data-note=\"2be08d4ee8aa1590\" href=\"?note=2be08d4ee8aa1590\" title=\"../batch15/58-df-cardinality.md\">../batch15/58-df-cardinality.md</a> 的基数函数。 对集合 <span class=\"math-inline\" data-tex=\"A\">\\(A\\)</span> 和序数 <span class=\"math-inline\" data-tex=\"\\lambda\">\\(\\lambda\\)</span>，<span class=\"math-inline\" data-tex=\"[A]^\\lambda\\coloneqq\\{B\\in\\mathcal P(A):|B|=\\lambda\\}\">\\([A]^\\lambda\\coloneqq\\{B\\in\\mathcal P(A):|B|=\\lambda\\}\\)</span>，<span class=\"math-inline\" data-tex=\"[A]^{&lt;\\lambda}\\coloneqq\\{B\\in\\mathcal P(A):|B|&lt;\\lambda\\}\">\\([A]^{&lt;\\lambda}\\coloneqq\\{B\\in\\mathcal P(A):|B|&lt;\\lambda\\}\\)</span>。</p>\n</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}comb\\text{-}arrow\\text{-}notation} \\vdash \\mathrm{ZfcCombArrowNotation}_S(\\kappa,\\lambda,\\mu,n)\\leftrightarrow\\mathrm{Cardinal}_S(\\kappa)\\land\\mathrm{Cardinal}_S(\\lambda)\\land\\mathrm{Cardinal}_S(\\mu)\\land n\\in\\omega\\setminus\\{0\\}\\land\\forall c\\;\\left(\\mathrm{Function}(c,[\\kappa]^n,\\mu)\\to\\exist