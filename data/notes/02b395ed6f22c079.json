{\\mathsf{class}}\\varphi.\n\\end{aligned}","display":true},{"tex":"\\begin{aligned}\n&\\mathrm{thm\\text{-}steel}\\vdash_{\\mathsf{meta}}\n\\mathrm{ZfcInnerDerivedModel}_S\n(\\mathcal D_\\delta,\\delta,\\mathbb P,G,\\mathbb R^*,\\Gamma^*)\\\\\n&\\to\\mathrm{ClassSatisfaction}_S\n(\\mathcal D_\\delta,\\operatorname{ZF}\\cup\\{\\theta_{\\mathrm{AD}^+}\\}).\n\\end{aligned}","display":true},{"tex":"\\mathcal D_\\delta","display":false},{"tex":"\\delta","display":false}],"bytes":2151,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-4439","locations":["正文"],"count":1,"excerpt":"[[../batch01/58-thm-steel.md|58-thm-steel]]（batch01）"}],"outgoing":["74261e48e94a4d06","4cc4baec9297fd1e","ca2a9c9166fa8cce","b00c32fa4e76ff85"]}