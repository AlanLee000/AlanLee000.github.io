"tex":"V","display":false},{"tex":"V","display":false}],"bytes":2813,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-3376","locations":["正文"],"count":1,"excerpt":"[[../batch03/58-df-zfc-set10-bounded-separation-instance.md|58-df-zfc-set10-bounded-separation-instance]]（batch03）"}],"outgoing":["a3348ed9eb6fb4e3","2678ecfefaa83e32","36d7463d215be751","65418b505fc53093","715a32e91161b34f","2403aee408c56d4d","9976e7d9d98187f6"]}