\{\\top,\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcSet9HKappa}_S:V\\rightharpoonup V\">\\(\\mathrm{ZfcSet9HKappa}_S:V\\rightharpoonup V\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}semiproper\\text{-}poset}\\vdash\n\\mathrm{SemiproperPoset}_S(W,\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P})\\leftrightarrow{}\\\\\n&amp;\\mathrm{TransitiveModel}_S(W)\n\\land\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P})\\\\\n&amp;\\land\\forall\\theta\\;\\Bigl(\n\\mathrm{RegularCardinal}_S(\\theta)\\land\\omega_1&lt;\\theta\n\\land\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P},\\theta\\in W\n\\land\\mathbb P\\in\\mathrm{ZfcSet9HKappa}_S(\\theta)\\\\\n&amp;\\hspace{17mm}\\to\\forall M\\;\\Bigl(\nM\\in W\\land\\mathrm{ZfcCard6CountableSet}_S(M)\n\\land\\mathrm{ElementarySubstructure}_S((M,\\in),(\\mathrm{ZfcSet9HKappa}_S(\\theta),\\in),\\{\\in\\})\\\\\n&amp;\\hspace{48mm}\\land\\mathbb P,\\leq_{\\mathbb P}\\in M\n\\to\\forall p\\in M\\cap\\mathbb P\\;\\exists q\\in\\mathbb P\\;\\bigl(\nq\\leq_{\\mathbb P}p\n\\land\\mathrm{ZfcForcing10SemiGenericCondition}_S(q,M,W,\\theta,\\mathbb P,\\leq_{\\mathbb P})\\bigr)\\Bigr)\\Bigr).\n\\end{aligned}\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\begin{aligned}\n&amp;\\mathrm{df\\text{-}zfc\\text{-}semiproper\\text{-}poset}\\vdash\n\\mathrm{SemiproperPoset}_S(W,\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P})\\leftrightarrow{}\\\\\n&amp;\\mathrm{TransitiveModel}_S(W)\n\\land\\mathrm{ZfcForcing2ForcingPoset}_S(\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P})\\\\\n&amp;\\land\\forall\\theta\\;\\Bigl(\n\\mathrm{RegularCardinal}_S(\\theta)\\land\\omega_1&lt;\\theta\n\\land\\mathbb P,\\leq_{\\mathbb P},1_{\\mathbb P},\\theta\\in W\n\\land\\mathbb P\\in\\mathrm{ZfcSet9HKappa}_S(\\theta)\\\\\n&amp;\\hspace{17mm}\\to\\forall M\\;\\Bigl(\nM\\in W\\l