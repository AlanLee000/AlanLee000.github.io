igma\\in V\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Var}_S=\\{v_k:k\\in\\omega\\}\\subseteq V\">\\(\\mathrm{Var}_S=\\{v_k:k\\in\\omega\\}\\subseteq V\\)</span> (see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"65418b505fc53093\" href=\"?note=65418b505fc53093\" title=\"../batch17/58-df-formula.md\">../batch17/58-df-formula.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\Gamma\\subseteq\\mathrm{Fml}_S(\\Sigma),\\quad\\varphi,\\psi,\\chi\\in\\mathrm{Fml}_S(\\Sigma)\">\\(\\Gamma\\subseteq\\mathrm{Fml}_S(\\Sigma),\\quad\\varphi,\\psi,\\chi\\in\\mathrm{Fml}_S(\\Sigma)\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}\\subseteq V^3\">\\(\\mathrm{Function}\\subseteq V^3\\)</span> (see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"../batch16/58-df-function.md\">../batch16/58-df-function.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{AxHilbert}_\\Sigma\\subseteq\\mathrm{Fml}_S(\\Sigma)\">\\(\\mathrm{AxHilbert}_\\Sigma\\subseteq\\mathrm{Fml}_S(\\Sigma)\\)</span>.</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{MP}_\\Sigma\\subseteq\\mathrm{Fml}_S(\\Sigma)^2\\times\\mathrm{Fml}_S(\\Sigma)\">\\(\\mathrm{MP}_\\Sigma\\subseteq\\mathrm{Fml}_S(\\Sigma)^2\\times\\mathrm{Fml}_S(\\Sigma)\\)</span> (see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"752f7efeb30c6175\" href=\"?note=752f7efeb30c6175\" title=\"../batch15/58-ax-modus-ponens.md\">../batch15/58-ax-modus-ponens.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Gen}_{\\Gamma,\\Sigma}\\subseteq\\mathrm{Fml}_S(\\Sigma)^2\\times\\mathrm{Var}_S\">\\(\\mathrm{Gen}_{\\Gamma,\\Sigma}\\subseteq\\mathrm{Fml}_S(\\Sigma)^2\\times\\mathrm{Var}_S\\)</span> (see <a class=\"wiki-link\" id=\"ref-9\" data-note=\"6748c30f3a00f99a\" href=\"?note=6748c30f3a00f99a\" title=\"../batch07/58-ax-generalization.md\">../batch07/58-ax-generalization.md</a>).</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{DerSeq}_{\\Gamma,\\Sigma}\\subseteq V\">\\(\\mathrm{DerSeq}_{\\Gamma,\\Sigma}\\subseteq V\\)</span> and <span class=\"math-inline\" data-tex=\"\\mathrm{Derivable}_S\\subseteq V^3\">\\(\\mathrm{Derivable}_S\\subseteq V^3\\)</span>.</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}derivable} \\vdash\n\\mathrm{DerSeq}_{\\Gamma,\\Sigma}(s)\\leftrightarrow\n\\exists n\\in\\omega\\;\\Bigl(\\mathrm{Function}(s,n+1,\\mathrm{Fml}_S(\\Sigma))\\land\n\\forall i\\leq n\\;\\bigl(\ns(i)\\in\\Gamma\\lor s(i)\\in\\mathrm{AxHilbert}_\\Sigma\n\\lor\\exists j&lt;i\\;\\exists k&lt;i\\;(\\langle\\langle s(j),s(k)\\rangle,s(i)\\rangle\\in\\mathrm{MP}_\\Sigma)\n\\lor\\exists j&lt;i\\;\\exists x\\in\\mathrm{Var}_S\\;\n(\\langle\\langle s(j),s(i)\\rangle,x\\rangle\\in\\mathrm{Gen}_{\\Gamma,\\Sigma})\\bigr)\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}derivable} \\vdash\n\\mathrm{DerSeq}_{\\Gamma,\\Sigma}(s)\\leftrightarrow\n\\exists n\\in\\omega\\;\\Bigl(\\mathrm{Function}(s,n+1,\\mathrm{Fml}_S(\\Sigma))\\land\n\\forall i\\leq n\\;\\bigl(\ns(i)\\in\\Gamma\\lor s(i)\\in\\mathrm{AxHilbert}_\\Sigma\n\\lor\\exists j&lt;i\\;\\exists k&lt;i\\;(\\langle\\langle s(j),s(k)\\rangle,s(i)\\rangle\\in\\mathrm{MP}_\\Sigma)\n\\lor\\exists j&lt;i\\;\\exists x\\in\\mathrm{Var}_S\\;\n(\\langle\\langle s(j),s(i)\\rangle,x\\rangle\\in\\mathrm{Gen}_{\\Gamma,\\Sigma})\\bigr)\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}derivable\\text{-}conclusion} \\vdash\n\\mathrm{Derivable}_S(\\Gamma,\\varphi,\\Sigma)\\leftrightarrow\n\\exists s\\in V\\;\\exists n\\in\\omega\\;\n(\\mathrm{DerSeq}_{\\Gamma,\\Sigma}(s)\\land\\operatorname{dom}(s)=n+1\\land s(n)=\\varphi)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}derivable\\text{-}conclusion} \\vdash\n\\mathrm{Derivable}_S(\\Gamma,\\varphi,\\Sigma)\\leftrightarrow\n\\exists s\\in V\\;\\exists n\\in\\omega\\;\n(\\mathrm{DerSeq}_{\\Gamma,\\Sigma}(s)\\land\\operatorname{dom}(s)=n+1\\land s(n)=\\varphi)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}derivable\\text{-}theorem} \\vdash\n\\vdash_\\Sigma\\varphi\\leftrightarrow\\mathrm{Derivable}_S(\\emptyset,\\varphi,\\Sigma)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}derivable\\text{-}theorem} \\vdash\n\\vdash_\\Sigma\\varphi\\leftrightarrow\\mathrm{Derivable}_S(\\emptyset,\\varphi,\\Sigma)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\Gamma \\vdash \\varphi\">\\(\\Gamma \\vdash \\varphi\\)</span> iff there exists a finite sequence ending with <span class=\"math-inline\" data-tex=\"\\varphi\">\\(\\varphi\\)</span></li>\n<li>Each formula in the sequence is either an assumption, a Hilbert axiom, or derived by MP/Gen</li>\n<li>MP condition: <span class=\"math-inline\" data-tex=\"\\langle\\langle \\psi_j,\\psi_k\\rangle,\\psi_i\\rangle\\in\\mathrm{MP}\">\\(\\langle\\langle \\psi_j,\\psi_k\\rangle,\\psi_i\\rangle\\in\\mathrm{MP}\\)</span> iff <span class=\"math-inline\" data-tex=\"\\psi_k = (\\psi_j \\to \\psi_i)\">\\(\\psi_k = (\\psi_j \\to \\psi_i)\\)</span></li>\n<li>Gen condition: <span class=\"math-inline\" data-tex=\"\\langle \\psi_j, \\psi_i, x \\rangle \\in \\mathrm{Gen}\">\\(\\langle \\psi_j, \\psi_i, x \\rangle \\in \\mathrm{Gen}\\)</span> iff <span class=\"math-inline\" data-tex=\"\\psi_i = \\forall x\\,\\psi_j\">\\(\\psi_i = \\forall x\\,\\psi_j\\)</span> and <span class=\"math-inline\" data-tex=\"x \\notin \\mathrm{free}(\\Gamma)\">\\(x \\notin \\mathrm{free}(\\Gamma)\\)</span></li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch17/58-df-formula.md","status":"resolved","id":"65418b505fc53093","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch17/58-df-formula.md]]","embed":false},{"target":"../batch07/58-df-free-variable.md","status":"resolved","id":"715a32e91161b34f","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-df-free-variable.md]]","embed":false},{"target":"../batch15/58-ax-modus-ponens.md","status":"resolved","id":"752f7efeb30c6175","anchor":"ref-3","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch15/58-ax-modus-ponens.md]]","embed":false},{"target":"../batch07/58-ax-generalization.md","status":"resolved","id":"6748c30f3a00f99a","anchor":"ref-4","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch07/58-ax-generalization.md]]","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-5","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch16/58-df-function.md]]","embed":false},{"target":"../batch17/58-df-formula.md","status":"resolved","id":"65418b505fc53093","anchor":"ref-6","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Var}_S=\\{v_k:k\\in\\omega\\}\\subseteq V$ (see [[../batch17/58-df-formula.md]]).","embed":false},{"target":"../batch16/58-df-function.md","status":"resolved","id":"36d7463d215be751","anchor":"ref-7","targetAnchor":"","location":"正文","heading":"[Hypothesis]","excerpt":"$\\mathrm{Function}\\subseteq V^3$ (see [[../batch16/58-df-function.md]]).","embed":false},{"target":"../batch15/58-ax-modus-ponens.md","status":"resolved","id":"752f7ef