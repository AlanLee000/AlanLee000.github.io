h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"M\">\\(M\\)</span> (transitive ground model)</li>\n<li><span class=\"math-inline\" data-tex=\"F\">\\(F\\)</span> (fixed free filter on <span class=\"math-inline\" data-tex=\"\\omega\">\\(\\omega\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"G\">\\(G\\)</span> (Mathias-generic filter, see <a class=\"wiki-link\" id=\"ref-5\" data-note=\"545853811ce0a4b6\" href=\"?note=545853811ce0a4b6\" title=\"../batch16/58-df-generic.md\">../batch16/58-df-generic.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"x\">\\(x\\)</span> (generic real determined by <span class=\"math-inline\" data-tex=\"G\">\\(G\\)</span>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{MathiasCondition}_S\">\\(\\mathrm{MathiasCondition}_S\\)</span> (condition predicate, see <a class=\"wiki-link\" id=\"ref-6\" data-note=\"0c503b9bc4320741\" href=\"?note=0c503b9bc4320741\" title=\"../batch11/58-df-zfc-mathias-condition.md\">../batch11/58-df-zfc-mathias-condition.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{MathiasExtension}_S\">\\(\\mathrm{MathiasExtension}_S\\)</span> (extension predicate, see <a class=\"wiki-link\" id=\"ref-7\" data-note=\"0138480e8111b6c9\" href=\"?note=0138480e8111b6c9\" title=\"../batch12/58-df-zfc-mathias-extension.md\">../batch12/58-df-zfc-mathias-extension.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Generic}\">\\(\\mathrm{Generic}\\)</span> (generic-filter predicate, see <a class=\"wiki-link\" id=\"ref-8\" data-note=\"545853811ce0a4b6\" href=\"?note=545853811ce0a4b6\" title=\"../batch16/58-df-generic.md\">../batch16/58-df-generic.md</a>)</li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcForcingMathiasGenericReal}_S\\subseteq V^4\">\\(\\mathrm{ZfcForcingMathiasGenericReal}_S\\subseteq V^4\\)</span> (predicate defined here)</li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}forcing\\text{-}mathias\\text{-}generic\\text{-}real} \\vdash \\mathrm{ZfcForcingMathiasGenericReal}_S(x,G,M,F) \\leftrightarrow \\exists P,\\leq_F\\;\\Bigl(P=\\{p\\mid\\exists s,A\\;\\mathrm{MathiasCondition}_S(p,s,A,F)\\}\\land\\leq_F\\subseteq P\\times P\\land\\forall p,q\\in P\\;(p\\leq_F q\\leftrightarrow\\mathrm{MathiasExtension}_S(p,q,F))\\land\\mathrm{Generic}(G,P,\\leq_F,M)\\land x=\\bigcup\\{s\\mid\\exists p\\in G\\;\\exists A\\;\\mathrm{MathiasCondition}_S(p,s,A,F)\\}\\Bigr)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}forcing\\text{-}mathias\\text{-}generic\\text{-}real} \\vdash \\mathrm{ZfcForcingMathiasGenericReal}_S(x,G,M,F) \\leftrightarrow \\exists P,\\leq_F\\;\\Bigl(P=\\{p\\mid\\exists s,A\\;\\mathrm{MathiasCondition}_S(p,s,A,F)\\}\\land\\leq_F\\subseteq P\\times P\\land\\forall p,q\\in P\\;(p\\leq_F q\\leftrightarrow\\mathrm{MathiasExtension}_S(p,q,F))\\land\\mathrm{Generic}(G,P,\\leq_F,M)\\land x=\\bigcup\\{s\\mid\\exists p\\in G\\;\\exists A\\;\\mathrm{MathiasCondition}_S(p,s,A,F)\\}\\Bigr)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>Auxiliary ZFC definition.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"../batch02/58-ax-zfc.md","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch02/58-ax-zfc.md]]","embed":false},{"target":"../batch11/58-df-zfc-mathias-condition.md","status":"resolved","id":"0c503b9bc4320741","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[../batch11/58-df-zfc-mathias-condition.md]]","embed":false},{"target":"../batch12/58-df-zfc-mathias-extension.md","status":"resolved","id":"013848