\n\\mathsf I_7&=\\{B\\to A\\lor B\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Jan}}\\},\\\\\n\\mathsf I_8&=\\{(A\\to C)\\to((B\\to C)\\to(A\\lor B\\to C))\\mid A,B,C\\in\\mathsf{Frm}_{\\mathsf{Jan}}\\},\\\\\n\\mathsf I_9&=\\{\\bot\\to A\\mid A\\in\\mathsf{Frm}_{\\mathsf{Jan}}\\}.\n\\end{aligned}","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{JanWEM}}=\\{\\neg A\\lor\\neg\\neg A\\mid A\\in\\mathsf{Frm}_{\\mathsf{Jan}}\\}.","display":true},{"tex":"\\mathsf{Ax}_{\\mathsf{Jan}}=\\mathsf{Ax}_{\\mathsf I}^{\\mathsf{Jan}}\\cup\\mathsf{Ax}_{\\mathsf{JanWEM}}.","display":true},{"tex":"\\mathsf{MP}_{\\mathsf{Jan}}\\subseteq(\\mathsf{Frm}_{\\mathsf{Jan}}^2\\times\\mathsf{Frm}_{\\mathsf{Jan}}).","display":true},{"tex":"\\mathsf{MP}_{\\mathsf{Jan}}=\\{((A,A\\to B),B)\\mid A,B\\in\\mathsf{Frm}_{\\mathsf{Jan}}\\},","display":true},{"tex":"\\frac{A\\qquad A\\to B}{B}\\;\\mathsf{MP}.","display":true},{"tex":"\\mathsf{Frm}_{\\mathsf{Jan}}","display":false},{"tex":"\\Gamma\\subseteq\\mathsf{Frm}_{\\mathsf{Jan}}","display":false},{"tex":"\\pi=(C_0,\\ldots,C_n)","display":false},{"tex":"i\\le n","display":false},{"tex":"\\mathsf{LineOK}_{\\mathsf{Jan}}(\\Gamma,\\pi,i)\n\\Longleftrightarrow\nC_i\\in\\Gamma\n\\lor C_i\\in\\mathsf{Ax}_{\\mathsf{Jan}}\n\\lor\\exists j,k<i\\,((C_j,C_k),C_i)\\in\\mathsf{MP}_{\\mathsf{Jan}}.","display":true},{"tex":"\\mathsf{Prf}_{\\mathsf{Jan}}(\\Gamma,A)","display":false},{"tex":"\\pi=(C_0,\\ldots,C_n)","display":false},{"tex":"C_0,\\ldots,C_n\\in\\mathsf{Frm}_{\\mathsf{Jan}}","display":false},{"tex":"C_n=A","display":false},{"tex":"i\\le n","display":false},{"tex":"\\mathsf{LineOK}_{\\mathsf{Jan}}(\\Gamma,\\pi,i)","display":false},{"tex":"C_i\\in\\Gamma","display":false},{"tex":"C_i\\in\\mathsf{Ax}_{\\mathsf{Jan}}","display":false},{"tex":"j,k<i","display":false},{"tex":"((C_j,C_k),C_i)\\in\\mathsf{MP}_{\\mathsf{Jan}}","display":false},{"tex":"\\Gamma\\vdash_{\\mathsf{Jan}}A\\quad\\Longleftrightarrow\\quad \\mathsf{Prf}_{\\mathsf{Jan}}(\\Gamma,A)\\ne\\varnothing."