b39\" href=\"?note=30f7fa6c101bbb39\" title=\"58-df-limit-ordinal\">58-df-limit-ordinal</a></span><span><a class=\"wiki-link\" id=\"ref-6\" data-note=\"5582a281f15a33c2\" href=\"?note=5582a281f15a33c2\" title=\"58-df-ordinal\">58-df-ordinal</a></span><span><a class=\"wiki-link\" id=\"ref-7\" data-note=\"36d7463d215be751\" href=\"?note=36d7463d215be751\" title=\"58-df-function\">58-df-function</a></span></div>"}],"html":"\n<h2 id=\"Hypothesis\">[Hypothesis]</h2>\n<ul>\n<li><span class=\"math-inline\" data-tex=\"\\rho,X,\\tau,D,\\alpha,\\beta,\\lambda\\in V\">\\(\\rho,X,\\tau,D,\\alpha,\\beta,\\lambda\\in V\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Ordinal},\\mathrm{Limit}:V\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Ordinal},\\mathrm{Limit}:V\\to\\{\\top,\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{Function}:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop5TopologicalSpace}_S:V^2\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop5TopologicalSpace}_S:V^2\\to\\{\\top,\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTop7CantorBendixsonDerivative}_S:V^4\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTop7CantorBendixsonDerivative}_S:V^4\\to\\{\\top,\\bot\\}\\)</span></li>\n<li><span class=\"math-inline\" data-tex=\"\\mathrm{ZfcTopo8CantorBendixsonRank}_S:V^3\\to\\{\\top,\\bot\\}\">\\(\\mathrm{ZfcTopo8CantorBendixsonRank}_S:V^3\\to\\{\\top,\\bot\\}\\)</span></li>\n</ul>\n<h2 id=\"Assertion\">[Assertion]</h2>\n<figure class=\"equation\" data-tex=\"\\mathrm{df\\text{-}zfc\\text{-}topo8\\text{-}cantor\\text{-}bendixson\\text{-}rank} \\vdash \\mathrm{ZfcTopo8CantorBendixsonRank}_S(\\rho,X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land\\mathrm{Ordinal}(\\rho)\\land\\exists D\\;\\left(\\mathrm{Function}(D,\\rho+2,\\mathcal P(X))\\land D(0)=X\\land\\forall\\beta\\in\\rho+1\\;\\mathrm{ZfcTop7CantorBendixsonDerivative}_S(X,\\tau,D(\\beta),D(\\beta+1))\\land\\forall\\lambda\\in\\rho+1\\;\\left(\\mathrm{Limit}(\\lambda)\\to D(\\lambda)=\\bigcap_{\\beta\\in\\lambda}D(\\beta)\\right)\\land D(\\rho)=D(\\rho+1)\\land\\forall\\beta\\in\\rho\\;(D(\\beta)\\neq D(\\beta+1))\\right)\"><div class=\"math-display\" tabindex=\"0\" role=\"region\" aria-label=\"数学公式\">\\[\\mathrm{df\\text{-}zfc\\text{-}topo8\\text{-}cantor\\text{-}bendixson\\text{-}rank} \\vdash \\mathrm{ZfcTopo8CantorBendixsonRank}_S(\\rho,X,\\tau)\\leftrightarrow \\mathrm{ZfcTop5TopologicalSpace}_S(X,\\tau)\\land\\mathrm{Ordinal}(\\rho)\\land\\exists D\\;\\left(\\mathrm{Function}(D,\\rho+2,\\mathcal P(X))\\land D(0)=X\\land\\forall\\beta\\in\\rho+1\\;\\mathrm{ZfcTop7CantorBendixsonDerivative}_S(X,\\tau,D(\\beta),D(\\beta+1))\\land\\forall\\lambda\\in\\rho+1\\;\\left(\\mathrm{Limit}(\\lambda)\\to D(\\lambda)=\\bigcap_{\\beta\\in\\lambda}D(\\beta)\\right)\\land D(\\rho)=D(\\rho+1)\\land\\forall\\beta\\in\\rho\\;(D(\\beta)\\neq D(\\beta+1))\\right)\\]</div><button class=\"equation-action\" type=\"button\" aria-label=\"展开查看完整公式\">展开公式 ↗</button></figure><h2 id=\"Remark\">[Remark]</h2>\n<ul>\n<li>The rank is the least stage at which the transfinite derived-set sequence stabilizes.</li>\n</ul>\n","headings":[{"id":"Hypothesis","text":"[Hypothesis]","level":2},{"id":"Assertion","text":"[Assertion]","level":2},{"id":"Remark","text":"[Remark]","level":2}],"links":[{"target":"58-ax-zfc","status":"resolved","id":"a3348ed9eb6fb4e3","anchor":"ref-1","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-ax-zfc]]","embed":false},{"target":"58-df-zfc-top7-cantor-bendixson-derivative","status":"resolved","id":"6393f144f5f96f2c","anchor":"ref-2","targetAnchor":"","location":"元数据 · depends_on","heading":"","excerpt":"[[58-df-zfc-top7-cantor-bendixson-derivative]]","embed":false},{"target":"58-df-zfc-top5-topological-space","status":"resolved","id":"74086485fba8d86f","anchor":"ref-3","targetAnchor":""