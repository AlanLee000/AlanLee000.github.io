{\\mathbf N}","display":false},{"tex":"\\operatorname{ev}:B\\times\\mathbf N\\to\\mathbf2","display":false},{"tex":"q:B\\times\\mathbf N\\to B","display":false},{"tex":"\\Sigma_q","display":false},{"tex":"\\Rightarrow_B","display":false},{"tex":"\\bot_B","display":false},{"tex":"P,A","display":false},{"tex":"\\mathrm{MP}_{\\mathbf{Eff}}","display":false},{"tex":"\\begin{aligned}\nP&\\coloneqq\\operatorname{ev}^*[b_0]\\in\\operatorname{Sub}_{\\mathbf{Eff}}(B\\times\\mathbf N),\\\\\nA&\\coloneqq\\Sigma_qP\\in\\operatorname{Sub}_{\\mathbf{Eff}}(B),\\\\\n\\mathrm{MP}_{\\mathbf{Eff}}&\\Longleftrightarrow\n\\bigl((A\\Rightarrow_B\\bot_B)\\Rightarrow_B\\bot_B\\bigr)\\le_B A,\\\\\n&\\mathrm{MP}_{\\mathbf{Eff}}.\n\\end{aligned}","display":true},{"tex":"\\forall f:\\mathbf N\\to\\mathbf2.\\ \\neg\\neg\\exists n.\\,f(n)=0\\Rightarrow\\exists n.\\,f(n)=0","display":false},{"tex":"\\mathbf N^{\\mathbf N}","display":false},{"tex":"B","display":false},{"tex":"\\varphi_e(n)","display":false}],"bytes":2363,"backlinks":[{"id":"1bdcb9b14f83cac1","anchor":"ref-395","locations":["正文"],"count":1,"excerpt":"[[16-prop-markov|prop-markov-eff]]"}],"outgoing":["c7c40f40c78440c0","198e3b21cd4c6cd2","8cc0e0e038ae9b87"]}