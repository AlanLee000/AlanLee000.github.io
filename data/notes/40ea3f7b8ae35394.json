},{"tex":"\\mathrm{df\\text{-}parabolic\\text{-}borel\\text{-}subgroup}\\vdash\n\\mathrm{BorelSubgroup}_S(B,k,G,m,i,e)\\leftrightarrow\n\\mathrm{ConnectedAlgebraicSubgroup}_S(B,k,G,m,i,e)\n\\land\\mathrm{SolvableSubgroup}_S(B,G,m,i,e)\n\\land\\forall H\\subseteq G\\;\\Bigl(\nB\\subseteq H\\land\n\\mathrm{ConnectedAlgebraicSubgroup}_S(H,k,G,m,i,e)\n\\land\\mathrm{SolvableSubgroup}_S(H,G,m,i,e)\\to H=B\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}parabolic\\text{-}subgroup}\\vdash\n\\mathrm{ParabolicSubgroup}_S(P,k,G,m,i,e)\\leftrightarrow\n\\mathrm{AlgGroup}_k(G,m,i,e)\\land\\mathrm{Subgroup}_S(P,G,m)\\land\n\\exists B\\in V\\;\\Bigl(\n\\mathrm{BorelSubgroup}_S(B,k,G,m,i,e)\n\\land\\mathrm{Subgroup}_S(B,P,m\\upharpoonright P^2)\\Bigr)","display":true},{"tex":"\\mathrm{df\\text{-}parabolic\\text{-}subgroup\\text{-}projection}\\vdash\n\\mathrm{Parabolic}_S(P,G)\\leftrightarrow\n\\exists k,m,i,e\\in V\\;\\mathrm{ParabolicSubgroup}_S(P,k,G,m,i,e)","display":true},{"tex":"\\mathrm{Parabolic}_S","display":false}],"bytes":3984,"backlinks":[{"id":"84daad544872cc71","anchor":"ref-938","locations":["正文"],"count":1,"excerpt":"[[../batch14/58-df-parabolic-subgroup.md|58-df-parabolic-subgroup]]（batch14）"}],"outgoing":["07ee726a6e15b274","59685d062adf2748","36d7463d215be751","2b6b1d9eb78a2714"]}